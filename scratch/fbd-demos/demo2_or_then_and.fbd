        </data>
        <data name="http://www.3s-software.com/plcopenxml/outputparamtypes" handleUnknown="implementation">
          <OutputParamTypes xmlns="" />
        </data>
      </addData>
    </block>
    <outVariable localId="10000000006">
      <position x="0" y="0" />
      <connectionPointIn>
        <connection refLocalId="10000000005" formalParameter="Out1" />
      </connectionPointIn>
