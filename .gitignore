.DS_Store
node_modules
.worktrees
.sst
.env*
!.env.example
.idea
.vscode
.codex
*~
playground
tmp
dist
ts-dist
# @volt/web (React Router) builds to build/, and caches generated types in .react-router/
build
.react-router

# @volt/lsp-iec: the content-addressed rustc cache the conformance suite and rate:fixtures share (test/conformance/support/rustc-cache.ts)
packages/volt-lsp-iec/.cache/
**/.serena
.serena/
**/.omo
.omo/

# Local dev files
UPCOMING_CHANGELOG.md
logs/
*.bun-build
tsconfig.tsbuildinfo

# Local junction to shared Claude memory dir (see project-shared-memory-junctions)
/memory

# CODESYS per-user session files, generated when a test .project is opened (headless multi-instance smoke).
# `.~u` is the open-by-<user@host> lock CODESYS writes beside the project and removes on a clean close.
packages/volt-cli/test/*.opt
packages/volt-cli/test/*.~u

# the recorder writes `<vendor>.build.new.json` beside the committed recording as its non-destructive
# output (and its every-25-fixtures checkpoint). It is a working file, byte-for-byte the size of the
# recording itself, and `--write` or a copy is what adopts it — it is never the thing under review.
packages/volt-lsp-iec/test/conformance/recordings/*.new.json

# snapshot F (openspec frontend-conformance, scripts/frontend-snapshot.ts): per-commit aspect hashes, rebuilt on demand.
packages/volt-lsp-iec/test/frontend/.snapshot/
# snapshot S (openspec transpile-restructure, scripts/transpile-snapshot.ts): the baseline and the working tree's, rebuilt on demand.
packages/volt-lsp-iec/test/conformance/.snapshot/
