#!/bin/sh
set -e
# Bun version must match package.json's packageManager field.
bun -e '
import { semver } from "bun";
const pkg = await Bun.file("package.json").json();
const expectedBunVersion = pkg.packageManager?.split("@")[1];
if (!expectedBunVersion) {
  throw new Error("packageManager field not found in root package.json");
}
if (!semver.satisfies(process.versions.bun, `^${expectedBunVersion}`)) {
  throw new Error(`This repo requires bun@^${expectedBunVersion}, but you are using bun@${process.versions.bun}`);
}
'
# Typecheck the workspace + scripts (not a workspace package, so typecheck it directly).
bun run --filter='*' typecheck
bunx tsgo --noEmit -p scripts/tsconfig.json
