#!/bin/sh
set -e
# Check if bun version matches package.json
# keep in sync with packages/script/src/index.ts semver qualifier
bun -e '
import { semver } from "bun";
const pkg = await Bun.file("package.json").json();
const expectedBunVersion = pkg.packageManager?.split("@")[1];
if (!expectedBunVersion) {
  throw new Error("packageManager field not found in root package.json");
}
const expectedBunVersionRange = `^${expectedBunVersion}`;
if (!semver.satisfies(process.versions.bun, expectedBunVersionRange)) {
  throw new Error(`This script requires bun@${expectedBunVersionRange}, but you are using bun@${process.versions.bun}`);
}
if (process.versions.bun !== expectedBunVersion) {
  console.warn(`Warning: Bun version ${process.versions.bun} differs from expected ${expectedBunVersion}`);
}
'
# bun typecheck
  # Scope typecheck to packages we own (Volt SaaS). Upstream opencode
  # packages are left to upstream CI — running them locally on Windows
  # triggers env-specific TS errors that aren't real regressions.
  # When contributing back upstream, run `bun typecheck` manually.
  bun turbo typecheck --filter='@opencode-ai/volt-*'

# Fork invariant: Volt is purely additive — fail the push if we modified
# opencode source outside the allowed integration seams (see CLAUDE.md
# "Fork surface"). Self-test the guard's logic first, then run it.
# It skips gracefully if `upstream/dev` isn't fetched, so it never blocks
# a push spuriously.
  bun run volt-scripts/check-divergence.ts --self-test
  bun run volt-scripts/check-divergence.ts
