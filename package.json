{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "volt",
  "description": "Volt — manage IEC 61131-3 PLC projects (CODESYS / TwinCAT) as version-controllable text",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun run --filter='*' build",
    "build:installer": "bun scripts/build-installer.ts",
    "release": "bun scripts/release.ts",
    "test:install": "bun scripts/test-install.ts",
    "test:ext": "bun scripts/test-extension.ts",
    "check": "bun install && bun scripts/check-wiring.ts",
    "deploy:dev": "bunx sst deploy --stage dev",
    "typecheck": "bun run --filter='*' typecheck",
    "lint": "oxlint",
    "prepare": "husky",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/volt-cli",
      "packages/volt-control",
      "packages/volt-desktop",
      "packages/volt-lsp-iec",
      "packages/volt-vscode",
      "packages/volt-web"
    ],
    "catalog": {
      "@tsconfig/node22": "22.0.2",
      "@types/bun": "1.3.13",
      "@types/node": "24.12.2",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "sst": "4.13.1",
      "typescript": "5.8.2",
      "vite": "7.1.4",
      "zod": "4.1.8"
    }
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "husky": "9.1.7",
    "zod": "catalog:",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.6.2",
    "sst": "catalog:",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/he-man86/volt"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
