{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "volt",
  "description": "Volt — manage IEC 61131-3 PLC projects (CODESYS / TwinCAT) as version-controllable text",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "OPENCODE_CONFIG_DIR=$PWD/volt-config opencode",
    "dev:console": "bun run --cwd packages/console/app dev",
    "build": "bun run --filter='*' build",
    "dist": "bun volt-scripts/dist.ts",
    "release": "bun volt-scripts/release.ts",
    "test:install": "bun volt-scripts/test-install.ts",
    "compat": "bun volt-scripts/sync.ts",
    "secrets:dev": "bun volt-scripts/deploy-secrets.ts --apply dev",
    "deploy:dev": "bunx sst deploy --stage dev",
    "db:dev": "bun run --cwd packages/console/core db-dev",
    "shell:dev": "bun run --cwd packages/console/core shell-dev",
    "typecheck": "bun run --filter='*' typecheck",
    "lint": "oxlint",
    "prepare": "husky",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/volt-bridge",
      "packages/volt-control",
      "packages/volt-desktop",
      "packages/volt-git",
      "packages/volt-lsp-iec",
      "packages/volt-vscode",
      "packages/volt-www",
      "packages/console/*"
    ],
    "catalog": {
      "@cloudflare/workers-types": "4.20251008.0",
      "@kobalte/core": "0.13.11",
      "@openauthjs/openauth": "0.0.0-20250322224806",
      "@solidjs/meta": "0.29.4",
      "@solidjs/router": "0.15.4",
      "@solidjs/start": "https://pkg.pr.new/@solidjs/start@dfb2020",
      "@tsconfig/node22": "22.0.2",
      "@types/bun": "1.3.13",
      "@types/node": "24.12.2",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "ai": "6.0.168",
      "drizzle-kit": "1.0.0-rc.2",
      "drizzle-orm": "1.0.0-rc.2",
      "solid-js": "1.9.10",
      "sst": "4.13.1",
      "typescript": "5.8.2",
      "ulid": "3.0.1",
      "vite": "7.1.4",
      "zod": "4.1.8"
    }
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "husky": "9.1.7",
    "zod": "catalog:",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.6.2",
    "sst": "catalog:",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/he-man86/volt"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
