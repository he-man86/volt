# Volt deploy environment. Copy to `.env` (gitignored) and fill. SST auto-loads `.env`.
#
# This file used to run to sixty lines: Stripe, PlanetScale, an OpenAuth issuer, Upstash, Honeycomb, SES,
# gateway provider keys and thirty catalog secret chunks. All of it belonged to the console and the LLM
# gateway, which are deleted (openspec/changes/sell-cli-subscription). Volt now deploys one static site and
# holds NO secrets — payment, EU VAT, licence keys and the customer portal are Polar's, and Polar is
# configured in Polar, not from here.

# ─────────────────────────────────────────────────────────────
# REQUIRED — the deploy needs exactly this
# ─────────────────────────────────────────────────────────────
# Cloudflare. The token needs Workers + DNS; the account ID is just an identifier.
# In CI this is the only secret deploy.yml passes.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DEFAULT_ACCOUNT_ID=

# ─────────────────────────────────────────────────────────────
# OPTIONAL — build-time settings for packages/volt-web. Unset is a valid state:
# the site builds and deploys without any of them.
# ─────────────────────────────────────────────────────────────
# Cloudflare Web Analytics beacon token. Unset = no beacon (local builds stay clean).
VITE_CF_ANALYTICS_TOKEN=
# Polar checkout link. Until this is set AND COMING_SOON is flipped to false in
# packages/volt-web/app/config.js, the buy button renders "Coming soon" rather than a dead link.
VITE_CHECKOUT_URL=
# Overrides the installer download URL. Defaults to the latest GitHub release asset.
VITE_INSTALLER_URL=
