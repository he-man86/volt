# Volt commercial backend — deploy environment.
# Copy to `.env` (gitignored) and fill values. SST auto-loads `.env`; secrets are set from it
# (`sst secret set …`, or a bulk load). Every key the infra links must be SET — even to "" — or
# `sst deploy` errors on the first unset one. Grouped by when you need it.

# ─────────────────────────────────────────────────────────────
# REQUIRED NOW — the deploy won't come up without these
# ─────────────────────────────────────────────────────────────
# Cloudflare (host provider). Token needs Workers + R2 + KV + DNS. Account ID is an identifier.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DEFAULT_ACCOUNT_ID=
# Stripe — start with TEST keys (sk_test_… / pk_test_…)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# PlanetScale — service token that can CREATE BRANCH + PASSWORD on mheijmans/volt (provider auth)
PLANETSCALE_SERVICE_TOKEN=
PLANETSCALE_SERVICE_TOKEN_ID=
# Login (OpenAuth issuer) — GitHub + Google OAuth apps
GITHUB_CLIENT_ID_CONSOLE=
GITHUB_CLIENT_SECRET_CONSOLE=
GOOGLE_CLIENT_ID=
# Session-cookie encryption. Any random 32+ char string:  openssl rand -hex 32
ZEN_SESSION_SECRET=

# ─────────────────────────────────────────────────────────────
# REQUIRED LATER — before the gateway / monitoring go live (Stage 4b/4c)
# ─────────────────────────────────────────────────────────────
# Gateway upstream provider keys. models.json (committed) references these; `set-models.ts` substitutes them
# and chunks the catalog into the ZEN_MODELS1..30 secrets. Just fill the two keys.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Tier spend allowances — JSON matching Subscription.LimitsSchema (free/black.{20,100,200})
ZEN_LIMITS=
# Upstash Redis — gateway rate-limit + budget state
UpstashRedisRestUrl=
UpstashRedisRestToken=
# Observability — Honeycomb INGEST key (X-Honeycomb-Team; the log-processor sends events with it).
# The deploy-time honeycombio provider needs a different key: a CONFIGURATION key with "Manage Recipients"
# + "Manage Triggers". CI takes the two from separate GitHub environment secrets — HONEYCOMB_API_KEY (ingest)
# and HONEYCOMB_CONFIG_KEY (configuration) — feeding both to the env var HONEYCOMB_API_KEY in different steps.
HONEYCOMB_API_KEY=
DISCORD_INCIDENT_WEBHOOK_URL=
# Support-lookup portal (console/support)
SUPPORT_API_KEY=
# Email (workspace invites via SES-over-HTTP). Only needed when invites matter — NOT for login.
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────
# STUB — opencode integrations Volt does NOT use, but the Console worker links them,
# so they must exist (leave empty). Prune from the infra later if you want.
# ─────────────────────────────────────────────────────────────
EMAILOCTOPUS_API_KEY=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_INSTANCE_URL=

# ─────────────────────────────────────────────────────────────
# LOCAL CONVENIENCE — NOT read by the deploy (SST provisions its own DB branch/password).
# Handy for direct DB access / drizzle studio / testing. Optional.
# ─────────────────────────────────────────────────────────────
DATABASE_HOST=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
