# Volt SaaS — local development environment variables.
#
# Copy this file to .env and fill in the values you need. Bun loads
# .env automatically; no dotenv import required.
#
# `.env` is gitignored. NEVER commit real keys.
#
# For production deploys, secrets live in SST instead of .env:
#   sst secret set ANTHROPIC_API_KEY sk-...
# Then read via Resource.ANTHROPIC_API_KEY at runtime (typed by sst-env.d.ts).

# ───────────────────────────────────────────────────────────
# Stage routing
# ───────────────────────────────────────────────────────────

# Which SST stage to target. Drives URLs in packages/volt-web/config.mjs:
#   "production"  → https://volt.ai
#   anything else → https://<stage>.volt.ai
# Usually set by `sst dev` automatically — only override for testing.
# SST_STAGE=dev

# ───────────────────────────────────────────────────────────
# Volt agent / MCP (packages/volt/agent)
# ───────────────────────────────────────────────────────────

# Port the local bridge daemon listens on (Beckhoff / CODESYS / TIA).
# Both the `volt` CLI and `volt-mcp` server default to this. Only change
# if 8555 conflicts with another service on your dev machine.
# VOLT_BRIDGE_PORT=8555

# Default workspace directory the MCP server binds to when no per-call
# `workspace` arg is passed. Useful when one MCP server serves a single
# project; leave unset for multi-project setups.
# VOLT_WORKSPACE=/abs/path/to/your/plc/workspace

# ───────────────────────────────────────────────────────────
# AI providers (used by volt-agent for autonomous-fix loops)
# ───────────────────────────────────────────────────────────

# Required when running autonomous PLC code-gen / fix loops. Get a key
# at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Optional — alternative model provider.
# OPENAI_API_KEY=sk-...

# Optional — if customers use their own AI subscription via MCP, no
# server-side key is needed.

# ───────────────────────────────────────────────────────────
# volt-web (marketing site)
# ───────────────────────────────────────────────────────────

# Point dev:remote script at a non-local API. Used by the share /
# session-replay components when developing against staging data.
# VITE_API_URL=https://api.volt.ai

# ───────────────────────────────────────────────────────────
# Cloudflare (deploy target — production / staging only)
# ───────────────────────────────────────────────────────────

# Account that owns the Pages project + Workers + KV bindings.
# Find in Cloudflare dashboard → Workers & Pages → Account ID.
# CLOUDFLARE_DEFAULT_ACCOUNT_ID=

# API token with Workers Scripts:Edit + Pages:Edit + KV:Edit perms.
# Create at https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_TOKEN=

# ───────────────────────────────────────────────────────────
# Billing — Stripe (when payment goes live)
# ───────────────────────────────────────────────────────────

# Test mode for dev; live mode for production. Used by sst.config.ts.
# Find at https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_...

# Publishable key for client-side Stripe.js (volt-web checkout).
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret for /api/stripe/webhook. Create the endpoint
# in the Stripe dashboard, copy the signing secret.
# STRIPE_WEBHOOK_SECRET=whsec_...

# ───────────────────────────────────────────────────────────
# Database (when persistence goes live)
# ───────────────────────────────────────────────────────────

# PlanetScale connection (matches opencode's pattern; the sst.config.ts
# already declares planetscale provider).
# DATABASE_URL=mysql://user:pass@host/volt?ssl={"rejectUnauthorized":true}

# ───────────────────────────────────────────────────────────
# Auth (when login goes live)
# ───────────────────────────────────────────────────────────

# Pick one provider — Clerk, Auth0, OpenAuth (anomalyco's), Cognito etc.
# Below assumes Clerk; swap to whichever you choose.
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# ───────────────────────────────────────────────────────────
# Monitoring (optional)
# ───────────────────────────────────────────────────────────

# Honeycomb provider is wired into sst.config.ts. Get key at
# https://ui.honeycomb.io/account
# HONEYCOMB_API_KEY=

# ───────────────────────────────────────────────────────────
# Tests / CI
# ───────────────────────────────────────────────────────────

# Set by GitHub Actions automatically. Used by sst.config.ts to skip
# AWS profile config in CI. Don't set locally.
# GITHUB_ACTIONS=
