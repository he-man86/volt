# SST deploy environment for the Volt commercial backend.
# Copy this to `.env` (gitignored) and fill in the SECRET values. Never commit real tokens.
#   cp .env.example .env

# --- Cloudflare (home provider) ---
# Account ID for volt-ai.dev — an identifier, not a secret.
CLOUDFLARE_DEFAULT_ACCOUNT_ID=5043d1fdde01b8d8aaa51785563dcb4c
# API token (SECRET). Create at: Cloudflare → My Profile → API Tokens → Create Token.
# Permissions needed: Account · Workers Scripts=Edit, Workers KV Storage=Edit, Workers R2 Storage=Edit;
#                     Zone · DNS=Edit, Workers Routes=Edit, Zone=Read  (scope to volt-ai.dev).
CLOUDFLARE_API_TOKEN=

# --- Stripe ---
# Secret key (SECRET). Start with a test key (sk_test_...). Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=
