{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "volt-lsp-codesys": {
      "command": ["node", "./packages/volt-lsp-codesys/dist/bin.js", "--stdio"],
      "extensions": [".st", ".sfc", ".cfc"]
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "volt init*": "ask",
      "volt pull*": "ask",
      "volt push*": "ask",
      "volt merge*": "ask"
    }
  }
}
