{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#FFF9F1",
    "surface": "#F4EDE2",
    "surfaceHi": "#EBE2D4",
    "border": "#E2D8C8",
    "text": "#1A1714",
    "muted": "#6E665B",
    "accent": "#E0651F",
    "accentHi": "#B8521A",
    "green": "#3E9B52",
    "red": "#CC4B37",
    "amber": "#E08A2B",

    "dbg": "#16120E",
    "dsurface": "#201A14",
    "dsurfaceHi": "#2A2219",
    "dborder": "#342B20",
    "dtext": "#F3EAD9",
    "dmuted": "#9A8E7C",
    "daccent": "#F2843C",
    "daccentHi": "#FF9A52",
    "dgreen": "#74C07A",
    "dred": "#E8675C",
    "damber": "#F2B24C",

    "blue": "#2F6F90",
    "dblue": "#6FB0D8",

    "diffAddBg": "#E9F1E3",
    "diffRemBg": "#F6E5E1",
    "ddiffAddBg": "#1E2A1C",
    "ddiffRemBg": "#2E1E1B"
  },
  "theme": {
    "primary": { "dark": "daccent", "light": "accent" },
    "secondary": { "dark": "daccentHi", "light": "accentHi" },
    "accent": { "dark": "daccent", "light": "accent" },
    "error": { "dark": "dred", "light": "red" },
    "warning": { "dark": "damber", "light": "amber" },
    "success": { "dark": "dgreen", "light": "green" },
    "info": { "dark": "dblue", "light": "blue" },
    "text": { "dark": "dtext", "light": "text" },
    "textMuted": { "dark": "dmuted", "light": "muted" },
    "background": { "dark": "dbg", "light": "bg" },
    "backgroundPanel": { "dark": "dsurface", "light": "surface" },
    "backgroundElement": { "dark": "dsurfaceHi", "light": "surfaceHi" },
    "border": { "dark": "dborder", "light": "border" },
    "borderActive": { "dark": "daccent", "light": "accent" },
    "borderSubtle": { "dark": "dborder", "light": "border" },

    "diffAdded": { "dark": "dgreen", "light": "green" },
    "diffRemoved": { "dark": "dred", "light": "red" },
    "diffContext": { "dark": "dmuted", "light": "muted" },
    "diffHunkHeader": { "dark": "dmuted", "light": "muted" },
    "diffHighlightAdded": { "dark": "dgreen", "light": "green" },
    "diffHighlightRemoved": { "dark": "dred", "light": "red" },
    "diffAddedBg": { "dark": "ddiffAddBg", "light": "diffAddBg" },
    "diffRemovedBg": { "dark": "ddiffRemBg", "light": "diffRemBg" },
    "diffContextBg": { "dark": "dsurface", "light": "surface" },
    "diffLineNumber": { "dark": "dmuted", "light": "muted" },
    "diffAddedLineNumberBg": { "dark": "ddiffAddBg", "light": "diffAddBg" },
    "diffRemovedLineNumberBg": { "dark": "ddiffRemBg", "light": "diffRemBg" },

    "markdownText": { "dark": "dtext", "light": "text" },
    "markdownHeading": { "dark": "daccent", "light": "accent" },
    "markdownLink": { "dark": "daccent", "light": "accent" },
    "markdownLinkText": { "dark": "dgreen", "light": "green" },
    "markdownCode": { "dark": "dgreen", "light": "green" },
    "markdownBlockQuote": { "dark": "dmuted", "light": "muted" },
    "markdownEmph": { "dark": "damber", "light": "amber" },
    "markdownStrong": { "dark": "daccent", "light": "accent" },
    "markdownHorizontalRule": { "dark": "dmuted", "light": "muted" },
    "markdownListItem": { "dark": "daccent", "light": "accent" },
    "markdownListEnumeration": { "dark": "damber", "light": "amber" },
    "markdownImage": { "dark": "dgreen", "light": "green" },
    "markdownImageText": { "dark": "dgreen", "light": "green" },
    "markdownCodeBlock": { "dark": "dtext", "light": "text" },

    "syntaxComment": { "dark": "dmuted", "light": "muted" },
    "syntaxKeyword": { "dark": "daccent", "light": "accent" },
    "syntaxFunction": { "dark": "daccentHi", "light": "accentHi" },
    "syntaxVariable": { "dark": "dtext", "light": "text" },
    "syntaxString": { "dark": "dgreen", "light": "green" },
    "syntaxNumber": { "dark": "damber", "light": "amber" },
    "syntaxType": { "dark": "dgreen", "light": "green" },
    "syntaxOperator": { "dark": "daccent", "light": "accent" },
    "syntaxPunctuation": { "dark": "dtext", "light": "text" }
  }
}
