{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "lsp": {
    "volt-lsp-st": {
      "command": ["node", "./packages/volt-lsp-st/dist/bin.js", "--stdio"],
      "extensions": [".st", ".dut", ".pou", ".gvl", ".gdt", ".tmc", ".io", ".xti", ".hmi"]
    }
  },
  "permission": {
    // volt CLI permissions — mirrors opencode's git pattern (gate
    // destructive verbs via bash, leave read-only ones unrestricted).
    // Modifying ops require human approval per call in the opencode UI.
    "bash": {
      "*": "allow",
      "volt init*": "ask",
      "volt pull*": "ask",
      "volt push*": "ask",
    },
  },
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
