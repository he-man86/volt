{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "volt-lsp-iec": {
      "command": ["volt-lsp-iec", "--stdio"],
      "extensions": [".fb", ".prg", ".fun", ".itf", ".dut", ".gvl"]
    }
  },
  "permission": {
    "volt": "ask",
    "bash": {
      "*": "allow",
      "volt init*": "ask",
      "volt pull*": "ask",
      "volt push*": "ask",
      "volt merge*": "ask"
    }
  }
}
