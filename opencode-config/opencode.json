{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "volt-lsp-iec": {
      "command": ["volt-lsp-iec", "--stdio"],
      "extensions": [".fb", ".prg", ".fun", ".itf", ".dut", ".gvl"]
    }
  },
  "provider": {
    "volt": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Volt AI",
      "options": {
        "baseURL": "https://volt-ai.dev/v1"
      },
      "models": {
        "deepseek-chat": {
          "name": "DeepSeek · via Volt",
          "limit": { "context": 128000, "output": 8192 }
        },
        "claude-sonnet-4-5": {
          "name": "Claude Sonnet 4.5 · via Volt",
          "limit": { "context": 200000, "output": 64000 }
        }
      }
    }
  },
  "permission": {
    "volt": "ask",
    "bash": {
      "*": "allow",
      "volt init*": "ask",
      "volt pull*": "ask",
      "volt push*": "ask",
      "volt merge*": "ask"
    }
  }
}
