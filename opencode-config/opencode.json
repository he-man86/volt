{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "volt-lsp-iec": {
      "command": ["volt-lsp-iec", "--stdio"],
      "extensions": [".fb", ".prg", ".fun", ".itf", ".struct", ".enum", ".union", ".alias", ".gvl"]
    }
  },
  "provider": {
    "volt": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Volt AI",
      "options": {
        "baseURL": "https://volt-ai.dev/v1"
      },
      "models": {
        "deepseek-chat": { "name": "DeepSeek (Volt)" },
        "claude-sonnet-4-5": { "name": "Claude (Volt)" }
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "volt init*": "ask",
      "volt pull*": "ask",
      "volt push*": "ask",
      "volt merge*": "ask"
    }
  }
}
