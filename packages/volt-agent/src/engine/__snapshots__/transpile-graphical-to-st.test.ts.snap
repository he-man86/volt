// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`transpile FBD common cases AND with two inVariable inputs → outVariable 1`] = `
"result := TRUE AND FALSE;
"
`;

exports[`transpile FBD common cases inVariable literal → outVariable (pure assignment) 1`] = `
"result := TRUE;
"
`;

exports[`transpile FBD common cases FB instance call (R_TRIG) — emits call statement 1`] = `
"trig(CLK := TRUE);
"
`;

exports[`transpile FBD common cases Unary NOT operator 1`] = `
"result := NOT TRUE;
"
`;

exports[`transpile LD common cases minimal rung: contact → coil 1`] = `
"lamp_a := switch_a;
"
`;

exports[`transpile LD common cases negated contact → coil 1`] = `
"run := NOT stop;
"
`;

exports[`transpile LD common cases set coil with single contact 1`] = `
"IF start_btn THEN running := TRUE; END_IF;
"
`;

exports[`transpile LD common cases series contacts (AND) 1`] = `
"out := a AND b;
"
`;
