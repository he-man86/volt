{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/volt-agent",
  "version": "1.15.11",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/opencode"
  },
  "description": "Volt user-agent — the `volt` CLI (init/pull/push/status/build) that runs on the developer's machine and talks to a vendor bridge (Beckhoff today, CODESYS/TIA next) over loopback HTTP. AI clients drive it via shell, the same way they drive `git`.",
  "type": "module",
  "bin": {
    "volt": "./dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "conformance": "tsc && node dist/cli/conformance.js",
    "conformance:drift": "tsc && node dist/cli/conformance-drift.js",
    "conformance:errors": "tsc && node dist/cli/conformance-errors.js"
  },
  "dependencies": {
    "@opencode-ai/volt-lsp-st": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
