{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022"],
    // TS7 defaults `types` to [] (no auto-discovery of @types) — every package must name what it needs.
    "types": ["node", "vscode"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
