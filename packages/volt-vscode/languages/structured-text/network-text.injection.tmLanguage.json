{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "VG graphical networks",
  "scopeName": "network-text.injection",
  "injectionSelector": "L:source.structured-text -comment -string",
  "patterns": [
    {
      "comment": "A network-text network \u2014 the textual form of an FBD/LD body. Detected by content (the NETWORK header), so it lights up whether it's a whole graphical POU or a graphical body inlined in a POU. The optional header fields are NAMED \u2014 LABEL: is the jump target, TITLE: is free text \u2014 so neither can be mistaken for the other, for the language, or for DISABLED. Mirrors the LSP's parseNetworkText header.",
      "name": "meta.network.vg",
      "begin": "^\\s*(NETWORK)\\b[ \\t]*(\\d+)?[ \\t]*(FBD|LD|CFC|SFC)?\\b(?:[ \\t]*(LABEL:)[ \\t]*(\\w+)|[ \\t]*(TITLE:)[ \\t]*(\"(?:[^\"]|\"\")*\"))*[ \\t]*(DISABLED)?",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.vg"
        },
        "2": {
          "name": "constant.numeric.vg"
        },
        "3": {
          "name": "storage.type.vg"
        },
        "4": {
          "name": "keyword.other.vg"
        },
        "5": {
          "name": "entity.name.label.vg"
        },
        "6": {
          "name": "keyword.other.vg"
        },
        "7": {
          "name": "string.quoted.double.vg"
        },
        "8": {
          "name": "keyword.other.vg"
        }
      },
      "end": "^\\s*(END_NETWORK)\\b",
      "endCaptures": {
        "1": {
          "name": "keyword.control.vg"
        }
      },
      "patterns": [
        {
          "match": "\\b(LET)\\b",
          "name": "keyword.operator.wire.vg"
        },
        {
          "include": "source.structured-text"
        }
      ]
    }
  ]
}
