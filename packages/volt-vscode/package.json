{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "volt-vscode",
  "displayName": "Volt",
  "icon": "icons/volt.png",
  "description": "Language intelligence for PLC code — Structured Text (IEC 61131-3) and VG (Volt Graphical, the textual form of FBD/LD) — plus one-click sync with your live CODESYS/TwinCAT IDE.",
  "version": "0.1.3",
  "publisher": "volt-ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/he-man86/volt"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:structured-text",
    "workspaceContains:**/*.{fb,prg,fun,itf,struct,enum,union,alias,gvl,library,library_manager,task,image_pool,text_list,recipe_manager,visualization,visualization_manager,class_diagram,external_types,tmc}"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "colors": [
      {
        "id": "volt.driftIncomingForeground",
        "description": "Volt: a file the IDE changed (pull to absorb). Distinct from git's colors.",
        "defaults": {
          "dark": "#3794FF",
          "light": "#0066BF",
          "highContrast": "#3794FF",
          "highContrastLight": "#0066BF"
        }
      },
      {
        "id": "volt.driftOutgoingForeground",
        "description": "Volt: a file you changed locally (push to the IDE). Distinct from git's colors.",
        "defaults": {
          "dark": "#C586C0",
          "light": "#8E44AD",
          "highContrast": "#C586C0",
          "highContrastLight": "#8E44AD"
        }
      },
      {
        "id": "volt.driftConflictForeground",
        "description": "Volt: a file that conflicts with the IDE (resolve before pushing).",
        "defaults": {
          "dark": "#E0822D",
          "light": "#B5670B",
          "highContrast": "#E0822D",
          "highContrastLight": "#B5670B"
        }
      }
    ],
    "languages": [
      {
        "id": "structured-text",
        "aliases": [
          "Structured Text",
          "ST",
          "IEC 61131-3"
        ],
        "extensions": [
          ".fb",
          ".prg",
          ".fun",
          ".itf",
          ".struct",
          ".enum",
          ".union",
          ".alias",
          ".gvl"
        ],
        "configuration": "./languages/structured-text/language-configuration.json",
        "icon": {
          "light": "./icons/st.svg",
          "dark": "./icons/st.svg"
        }
      },
      {
        "id": "plc-library",
        "aliases": [
          "PLC Library Reference",
          "LIB"
        ],
        "extensions": [
          ".library"
        ],
        "icon": {
          "light": "./icons/library.svg",
          "dark": "./icons/library.svg"
        }
      },
      {
        "id": "plc-library-manager",
        "aliases": [
          "PLC Library Manager"
        ],
        "extensions": [
          ".library_manager"
        ],
        "icon": {
          "light": "./icons/library.svg",
          "dark": "./icons/library.svg"
        }
      },
      {
        "id": "plc-task",
        "aliases": [
          "PLC Task"
        ],
        "extensions": [
          ".task"
        ],
        "icon": {
          "light": "./icons/task.svg",
          "dark": "./icons/task.svg"
        }
      },
      {
        "id": "plc-image-pool",
        "aliases": [
          "PLC Image Pool",
          "IMG"
        ],
        "extensions": [
          ".image_pool"
        ],
        "icon": {
          "light": "./icons/imagepool.svg",
          "dark": "./icons/imagepool.svg"
        }
      },
      {
        "id": "plc-text-list",
        "aliases": [
          "PLC Text List",
          "TXT"
        ],
        "extensions": [
          ".text_list"
        ],
        "icon": {
          "light": "./icons/textlist.svg",
          "dark": "./icons/textlist.svg"
        }
      },
      {
        "id": "plc-recipe-manager",
        "aliases": [
          "PLC Recipe Manager",
          "RCPE"
        ],
        "extensions": [
          ".recipe_manager"
        ],
        "icon": {
          "light": "./icons/recipes.svg",
          "dark": "./icons/recipes.svg"
        }
      },
      {
        "id": "plc-visualization",
        "aliases": [
          "PLC Visualization Screen",
          "VISU"
        ],
        "extensions": [
          ".visualization"
        ],
        "icon": {
          "light": "./icons/visu.svg",
          "dark": "./icons/visu.svg"
        }
      },
      {
        "id": "plc-visualization-manager",
        "aliases": [
          "PLC Visualization Manager"
        ],
        "extensions": [
          ".visualization_manager"
        ],
        "icon": {
          "light": "./icons/visu.svg",
          "dark": "./icons/visu.svg"
        }
      },
      {
        "id": "plc-class-diagram",
        "aliases": [
          "PLC Class Diagram",
          "UML"
        ],
        "extensions": [
          ".class_diagram"
        ],
        "icon": {
          "light": "./icons/uml.svg",
          "dark": "./icons/uml.svg"
        }
      },
      {
        "id": "plc-external-types",
        "aliases": [
          "PLC External Types"
        ],
        "extensions": [
          ".external_types"
        ],
        "icon": {
          "light": "./icons/generic-file.svg",
          "dark": "./icons/generic-file.svg"
        }
      },
      {
        "id": "plc-tmc",
        "aliases": [
          "TwinCAT Module Class",
          "TMC"
        ],
        "extensions": [
          ".tmc"
        ],
        "icon": {
          "light": "./icons/tmc.svg",
          "dark": "./icons/tmc.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "structured-text",
        "scopeName": "source.structured-text",
        "path": "./languages/structured-text/syntax.tmLanguage.json"
      },
      {
        "scopeName": "vg.injection",
        "path": "./languages/structured-text/vg.injection.tmLanguage.json",
        "injectTo": [
          "source.structured-text"
        ]
      }
    ],
    "iconThemes": [
      {
        "id": "volt-icons",
        "label": "Volt Icons",
        "path": "./icons/volt-icons.json"
      }
    ],
    "configuration": {
      "title": "Volt",
      "properties": {
        "volt.iec.server": {
          "type": "string",
          "default": "",
          "description": "Override the path to the volt-lsp-iec server module. When empty (default), the extension auto-discovers it (packaged bundle, then the installed dep, then the dev workspace)."
        },
        "volt.iec.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "LSP trace level for debugging."
        },
        "volt.iec.vendor": {
          "type": "string",
          "enum": [
            "codesys",
            "twincat",
            "auto"
          ],
          "default": "auto",
          "description": "Which vendor's ST dialect this project targets. `auto` scans the workspace for vendor signals (.TcPOU, Tc-prefix pragmas → twincat; .project, OSCAT → codesys). Affects hover/completion filtering and the wrong-vendor-pragma diagnostic."
        },
        "volt.iec.hover.showSource": {
          "type": "boolean",
          "default": true,
          "description": "Append the CODESYS documentation source URL to hover content."
        },
        "volt.iec.completion.snippetSupport": {
          "type": "boolean",
          "default": true,
          "description": "Use snippet expansions for completion items (e.g., pragmas with placeholder values)."
        },
        "volt.iec.diagnostics.reservedKeyword": {
          "type": "boolean",
          "default": true,
          "description": "Flag identifiers that collide with CODESYS reserved keywords."
        },
        "volt.iec.diagnostics.doubleUnderscore": {
          "type": "boolean",
          "default": true,
          "description": "Flag identifiers starting with __ (reserved for system-generated names)."
        },
        "volt.iec.diagnostics.consecutiveUnderscores": {
          "type": "boolean",
          "default": true,
          "description": "Flag identifiers containing multiple consecutive underscores."
        },
        "volt.iec.diagnostics.duplicateDeclaration": {
          "type": "boolean",
          "default": true,
          "description": "Flag two declarations with the same name in the same scope."
        },
        "volt.iec.diagnostics.unresolvedIdentifier": {
          "type": "boolean",
          "default": true,
          "description": "Warn on identifiers in bodies that don't resolve in any reachable scope. Can false-positive on library-imported symbols."
        },
        "volt.iec.diagnostics.unknownPragma": {
          "type": "boolean",
          "default": true,
          "description": "Warn on pragma names not in either vendor's catalog."
        },
        "volt.iec.diagnostics.wrongVendorPragma": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a pragma is known but belongs to the OTHER vendor (e.g. {attribute 'TcRpcEnable'} in a CODESYS project). Includes equivalent suggestion when available."
        },
        "volt.iec.diagnostics.pragmaMissingCompanion": {
          "type": "boolean",
          "default": true,
          "description": "Error when a pragma is missing its required companion (e.g., instance-path requires reflection)."
        },
        "volt.iec.diagnostics.pragmaConflict": {
          "type": "boolean",
          "default": true,
          "description": "Warn on mutually-exclusive pragmas applied to the same target."
        },
        "volt.iec.diagnostics.fbLifecycleSignature": {
          "type": "boolean",
          "default": true,
          "description": "Validate FB_Init / FB_Reinit / FB_Exit signatures."
        },
        "volt.iec.diagnostics.shadowingDeclaration": {
          "type": "boolean",
          "default": true,
          "description": "Inform when a declaration shadows a same-name symbol in an outer scope."
        },
        "volt.iec.diagnostics.initSlotCollision": {
          "type": "boolean",
          "default": true,
          "description": "Warn when {attribute 'global_init_slot' := 'N'} collides with a CODESYS-reserved slot."
        },
        "volt.iec.diagnostics.conversionSourceMismatch": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a type-conversion function (e.g. INT_TO_DINT) is called with an argument whose declared type doesn't match the function's expected source type. Includes a suggested replacement (e.g. STRING_TO_DINT)."
        },
        "volt.bridge.twincatPort": {
          "type": "number",
          "default": 8555,
          "minimum": 1,
          "maximum": 65535,
          "description": "Port the TwinCAT / Beckhoff bridge listens on. Used by the `Initialize for TwinCAT` welcome-view button. Once a workspace is initialized, the port stored in `.git/volt/config.json` takes precedence for that workspace."
        },
        "volt.bridge.codesysPort": {
          "type": "number",
          "default": 8556,
          "minimum": 1,
          "maximum": 65535,
          "description": "Port the CODESYS bridge listens on. Used by the `Initialize for CODESYS` welcome-view button. Once a workspace is initialized, the port stored in `.git/volt/config.json` takes precedence for that workspace."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "volt",
          "title": "Volt",
          "icon": "icons/volt-activitybar.svg"
        }
      ]
    },
    "views": {
      "volt": [
        {
          "id": "volt.views.sync",
          "name": "IDE Sync",
          "icon": "icons/volt-activitybar.svg",
          "contextualTitle": "Volt — IDE Sync"
        },
        {
          "id": "volt.views.diagnostics",
          "name": "Diagnostics",
          "icon": "$(warning)",
          "contextualTitle": "Volt — Diagnostics"
        },
        {
          "id": "volt.views.bridge",
          "name": "Bridge",
          "icon": "$(plug)",
          "contextualTitle": "Volt — Bridge"
        },
        {
          "id": "volt.views.reference",
          "name": "Reference & Agent",
          "icon": "$(book)",
          "contextualTitle": "Volt — Reference & Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "volt.openProblems",
        "title": "Volt: Open Problems (LSP diagnostics)",
        "category": "Volt",
        "icon": "$(list-flat)"
      },
      {
        "command": "volt.openAgent",
        "title": "Volt: Open Agent",
        "category": "Volt",
        "icon": "icons/volt.svg"
      },
      {
        "command": "volt.newAgentSession",
        "title": "Volt: New Agent Session",
        "category": "Volt",
        "icon": "$(add)"
      },
      {
        "command": "volt.initTwincat",
        "title": "Volt: Initialize for TwinCAT (port 8555)",
        "category": "Volt",
        "enablement": "volt.twincatLive"
      },
      {
        "command": "volt.initCodesys",
        "title": "Volt: Initialize for CODESYS (port 8556)",
        "category": "Volt",
        "enablement": "volt.codesysLive"
      },
      {
        "command": "volt.acceptProjectRename",
        "title": "Volt: Accept Project Rename",
        "category": "Volt"
      },
      {
        "command": "volt.pull",
        "title": "Volt: Pull (bridge → workspace)",
        "category": "Volt",
        "icon": "$(cloud-download)"
      },
      {
        "command": "volt.push",
        "title": "Volt: Push (workspace → bridge)",
        "category": "Volt",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "volt.forcePull",
        "title": "Volt: Pull --force (discard local edits)",
        "category": "Volt"
      },
      {
        "command": "volt.forcePush",
        "title": "Volt: Push --force (overwrite IDE)",
        "category": "Volt"
      },
      {
        "command": "volt.status",
        "title": "Volt: Status",
        "category": "Volt",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "volt.refresh",
        "title": "Volt: Refresh",
        "category": "Volt",
        "icon": "$(refresh)"
      },
      {
        "command": "volt.build",
        "title": "Volt: Build (writes diagnostics to Problems panel)",
        "category": "Volt",
        "icon": "$(tools)"
      },
      {
        "command": "volt.openConfig",
        "title": "Volt: Open Workspace Config",
        "category": "Volt",
        "icon": "$(gear)"
      },
      {
        "command": "volt.openSettings",
        "title": "Volt: Open Settings",
        "category": "Volt",
        "icon": "$(settings-gear)"
      },
      {
        "command": "volt.showOutput",
        "title": "Volt: Show Output",
        "category": "Volt",
        "icon": "$(output)"
      },
      {
        "command": "volt.lsp.restart",
        "title": "Volt: Restart Language Server",
        "category": "Volt"
      },
      {
        "command": "volt.lsp.showOutput",
        "title": "Volt: Show Language Server Output",
        "category": "Volt"
      },
      {
        "command": "volt.openReference",
        "title": "Volt: Open CODESYS Language Reference",
        "category": "Volt"
      }
    ],
    "submenus": [
      {
        "id": "volt.more",
        "label": "More Volt Actions…",
        "icon": "$(ellipsis)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "volt.openAgent",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "volt.acceptProjectRename",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "volt.pull",
          "when": "view == volt.views.sync && volt.workspaceInitialized",
          "group": "navigation@1"
        },
        {
          "command": "volt.push",
          "when": "view == volt.views.sync && volt.workspaceInitialized",
          "group": "navigation@2"
        },
        {
          "command": "volt.build",
          "when": "view == volt.views.sync && volt.workspaceInitialized",
          "group": "navigation@3"
        },
        {
          "command": "volt.refresh",
          "when": "view == volt.views.sync && volt.workspaceInitialized",
          "group": "navigation@4"
        },
        {
          "submenu": "volt.more",
          "when": "view == volt.views.sync",
          "group": "navigation@99"
        },
        {
          "command": "volt.openProblems",
          "when": "view == volt.views.diagnostics",
          "group": "navigation@1"
        },
        {
          "command": "volt.refresh",
          "when": "view == volt.views.bridge",
          "group": "navigation@1"
        }
      ],
      "volt.more": [
        {
          "command": "volt.openSettings",
          "group": "1_init@1"
        },
        {
          "command": "volt.forcePull",
          "when": "volt.workspaceInitialized",
          "group": "2_force@1"
        },
        {
          "command": "volt.forcePush",
          "when": "volt.workspaceInitialized",
          "group": "2_force@2"
        },
        {
          "command": "volt.openConfig",
          "when": "volt.workspaceInitialized",
          "group": "9_diag@1"
        },
        {
          "command": "volt.showOutput",
          "group": "9_diag@2"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "volt.views.sync",
        "contents": "$(check) TwinCAT IDE connected.\n[$(plug) Initialize for TwinCAT](command:volt.initTwincat)",
        "when": "!volt.workspaceInitialized && volt.twincatLive"
      },
      {
        "view": "volt.views.sync",
        "contents": "$(check) CODESYS IDE connected.\n[$(plug) Initialize for CODESYS](command:volt.initCodesys)",
        "when": "!volt.workspaceInitialized && volt.codesysLive"
      },
      {
        "view": "volt.views.sync",
        "contents": "$(plug) No PLC IDE detected yet.\nOpen a project in CODESYS or TwinCAT and start its bridge, then initialize this folder.\n[$(plug) Initialize for CODESYS](command:volt.initCodesys)\n[$(plug) Initialize for TwinCAT](command:volt.initTwincat)\n\n$(info) The bridge ships with the Volt app. Don't have it?\n[$(cloud-download) Download Volt](https://github.com/he-man86/volt/releases/latest/download/Volt-win-Setup.exe)",
        "when": "!volt.workspaceInitialized && !volt.twincatLive && !volt.codesysLive"
      }
    ]
  },
  "scripts": {
    "build": "tsc --noEmit && bun build src/extension.ts --outfile=dist/extension.js --target=node --format=cjs --external=vscode && bun build ../volt-lsp-iec/src/bin.ts --outfile=dist/lsp-server.js --target=node --format=cjs && bun build ../volt-git/src/bin.ts --outfile=dist/cli.js --target=node --format=cjs",
    "dev": "tsc --watch",
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "package": "bun run build && vsce package --no-dependencies",
    "publish:vscode": "bun run build && vsce publish --no-dependencies",
    "publish:openvsx": "bun run package && ovsx publish volt-vscode-$npm_package_version.vsix"
  },
  "dependencies": {
    "@volt/control": "workspace:*",
    "@volt/lsp-iec": "workspace:*",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@types/vscode": "^1.80.0",
    "@typescript/native-preview": "catalog:",
    "@vscode/vsce": "^3.0.0",
    "ovsx": "^1.0.2",
    "typescript": "catalog:"
  }
}
