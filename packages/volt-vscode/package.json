{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "volt-vscode",
  "displayName": "Volt",
  "icon": "icons/volt.png",
  "description": "Language intelligence for PLC code — Structured Text (IEC 61131-3) and network text (the textual form of FBD/LD) — plus one-click sync with your live CODESYS/TwinCAT IDE.",
  "version": "0.1.0",
  "publisher": "volt-ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/he-man86/volt"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:structured-text",
    "workspaceContains:**/*.{fb,prg,fun,itf,dut,gvl,library,library_manager,task,image_pool,text_list,recipe_manager,visualization,visualization_manager,class_diagram,external_types,tmc}"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "colors": [
      {
        "id": "volt.driftIncomingForeground",
        "description": "Volt: a file the IDE changed (pull to absorb). Distinct from git's colors.",
        "defaults": {
          "dark": "#3794FF",
          "light": "#0066BF",
          "highContrast": "#3794FF",
          "highContrastLight": "#0066BF"
        }
      },
      {
        "id": "volt.driftOutgoingForeground",
        "description": "Volt: a file you changed locally (push to the IDE). Distinct from git's colors.",
        "defaults": {
          "dark": "#C586C0",
          "light": "#8E44AD",
          "highContrast": "#C586C0",
          "highContrastLight": "#8E44AD"
        }
      },
      {
        "id": "volt.driftConflictForeground",
        "description": "Volt: a file that conflicts with the IDE (resolve before pushing).",
        "defaults": {
          "dark": "#E0822D",
          "light": "#B5670B",
          "highContrast": "#E0822D",
          "highContrastLight": "#B5670B"
        }
      }
    ],
    "languages": [
      {
        "id": "structured-text",
        "aliases": [
          "Structured Text",
          "ST",
          "IEC 61131-3"
        ],
        "extensions": [
          ".fb",
          ".prg",
          ".fun",
          ".itf",
          ".dut",
          ".gvl"
        ],
        "configuration": "./languages/structured-text/language-configuration.json",
        "icon": {
          "light": "./icons/st.svg",
          "dark": "./icons/st.svg"
        }
      },
      {
        "id": "plc-library",
        "aliases": [
          "PLC Library Reference",
          "LIB"
        ],
        "extensions": [
          ".library"
        ],
        "icon": {
          "light": "./icons/library.svg",
          "dark": "./icons/library.svg"
        }
      },
      {
        "id": "plc-library-manager",
        "aliases": [
          "PLC Library Manager"
        ],
        "extensions": [
          ".library_manager"
        ],
        "icon": {
          "light": "./icons/library.svg",
          "dark": "./icons/library.svg"
        }
      },
      {
        "id": "plc-task",
        "aliases": [
          "PLC Task"
        ],
        "extensions": [
          ".task"
        ],
        "icon": {
          "light": "./icons/task.svg",
          "dark": "./icons/task.svg"
        }
      },
      {
        "id": "plc-image-pool",
        "aliases": [
          "PLC Image Pool",
          "IMG"
        ],
        "extensions": [
          ".image_pool"
        ],
        "icon": {
          "light": "./icons/imagepool.svg",
          "dark": "./icons/imagepool.svg"
        }
      },
      {
        "id": "plc-text-list",
        "aliases": [
          "PLC Text List",
          "TXT"
        ],
        "extensions": [
          ".text_list"
        ],
        "icon": {
          "light": "./icons/textlist.svg",
          "dark": "./icons/textlist.svg"
        }
      },
      {
        "id": "plc-recipe-manager",
        "aliases": [
          "PLC Recipe Manager",
          "RCPE"
        ],
        "extensions": [
          ".recipe_manager"
        ],
        "icon": {
          "light": "./icons/recipes.svg",
          "dark": "./icons/recipes.svg"
        }
      },
      {
        "id": "plc-visualization",
        "aliases": [
          "PLC Visualization Screen",
          "VISU"
        ],
        "extensions": [
          ".visualization"
        ],
        "icon": {
          "light": "./icons/visu.svg",
          "dark": "./icons/visu.svg"
        }
      },
      {
        "id": "plc-visualization-manager",
        "aliases": [
          "PLC Visualization Manager"
        ],
        "extensions": [
          ".visualization_manager"
        ],
        "icon": {
          "light": "./icons/visu.svg",
          "dark": "./icons/visu.svg"
        }
      },
      {
        "id": "plc-class-diagram",
        "aliases": [
          "PLC Class Diagram",
          "UML"
        ],
        "extensions": [
          ".class_diagram"
        ],
        "icon": {
          "light": "./icons/uml.svg",
          "dark": "./icons/uml.svg"
        }
      },
      {
        "id": "plc-external-types",
        "aliases": [
          "PLC External Types"
        ],
        "extensions": [
          ".external_types"
        ],
        "icon": {
          "light": "./icons/generic-file.svg",
          "dark": "./icons/generic-file.svg"
        }
      },
      {
        "id": "plc-tmc",
        "aliases": [
          "TwinCAT Module Class",
          "TMC"
        ],
        "extensions": [
          ".tmc"
        ],
        "icon": {
          "light": "./icons/tmc.svg",
          "dark": "./icons/tmc.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "structured-text",
        "scopeName": "source.structured-text",
        "path": "./languages/structured-text/syntax.tmLanguage.json"
      },
      {
        "scopeName": "network-text.injection",
        "path": "./languages/structured-text/network-text.injection.tmLanguage.json",
        "injectTo": [
          "source.structured-text"
        ]
      }
    ],
    "iconThemes": [
      {
        "id": "volt-icons",
        "label": "Volt Icons",
        "path": "./icons/volt-icons.json"
      }
    ],
    "configuration": {
      "title": "Volt",
      "properties": {
        "volt.iec.server": {
          "type": "string",
          "default": "",
          "description": "Override the path to the volt-lsp-iec server module. When empty (default), the extension auto-discovers it (packaged bundle, then the installed dep, then the dev workspace)."
        },
        "volt.iec.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "LSP trace level for debugging."
        },
        "volt.iec.vendor": {
          "type": "string",
          "enum": [
            "codesys",
            "twincat",
            "auto"
          ],
          "default": "auto",
          "description": "Which vendor's ST dialect this project targets. `auto` scans the workspace for vendor signals (.TcPOU, Tc-prefix pragmas → twincat; .project, OSCAT → codesys). Affects hover/completion filtering and the wrong-vendor-pragma diagnostic."
        },
        "volt.iec.diagnostics.deadCode": {
          "type": "boolean",
          "default": false,
          "description": "Report unreachable (dead) code — units no direct/indirect task-called path reaches. Off by default, matching the compiler, which never checks code it doesn't compile."
        },
        "volt.iec.diagnostics.pointer-not-convertible": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0033 — Type possibly not convertible to the target type. CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.jump-label-unreferenced": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0118 — A label has not been referenced. CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.no-op-statement": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0139 — The code has no effect. CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.sign-change-conversion": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0195/C0196 — Implicit conversion changes the sign. CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.narrowing-conversion": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0197 — Implicit conversion, possible loss of information. CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.string-constant-too-long": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0198 — String constant too long for the destination type. CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.constant-no-initial-value": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0228 — No initial value for a constant variable. CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.loop-exit-constant": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0266 — Loop exit condition is constant FALSE. CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.unknown-attribute": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0351 — Unknown attribute or invalid value. CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.enum-comparison": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0354 — Comparison of one enumeration type with another. CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.adr-on-bit": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0355 — A single bit cannot be referenced (ADR). CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.inout-own-access": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0371 — Access to a VAR_IN_OUT from an external context. CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.message-pragma-warning": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0373 — User-defined warning ({warning} pragma). CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.interface-implements": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0421 — Use keyword EXTENDS for inheritance of interfaces. CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.inout-in-initializer": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0441 — Access to an uninitialized VAR_IN_OUT variable. CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.obsolete-usage": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0357 — Use of a POU marked {attribute 'obsolete'}. CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.input-default-composite": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0525 — The input is only optional when called as a function. CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.default-not-constant": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0526 — Default value is not constant. CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.abstract-output-default": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0533 — The default value for a VAR_OUTPUT is not used. CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.union-inheritance": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0542 — Inheritance is not intended for a UNION. CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        },
        "volt.iec.diagnostics.reserved-keyword": {
          "type": "string",
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "C0543 — The name is a reserved keyword in the IEC 61131-3 standard (CHAR/WCHAR/USING). CODESYS \"Compiler warnings\" 3-state control (off/warning/error); set to match your project."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "volt",
          "title": "Volt",
          "icon": "icons/volt-activitybar.svg"
        }
      ]
    },
    "views": {
      "volt": [
        {
          "id": "volt.views.bridge",
          "name": "IDE Connection",
          "icon": "$(plug)",
          "contextualTitle": "Volt — IDE Connection"
        },
        {
          "id": "volt.views.sync",
          "name": "IDE Sync",
          "icon": "icons/volt-activitybar.svg",
          "contextualTitle": "Volt — IDE Sync"
        },
        {
          "id": "volt.views.diagnostics",
          "name": "Diagnostics",
          "icon": "$(warning)",
          "contextualTitle": "Volt — Diagnostics"
        }
      ]
    },
    "commands": [
      {
        "command": "volt.openProblems",
        "title": "Volt: Open Problems (LSP diagnostics)",
        "category": "Volt",
        "icon": "$(list-flat)"
      },
      {
        "command": "volt.refreshDiagnostics",
        "title": "Volt: Refresh Diagnostics",
        "category": "Volt",
        "icon": "$(refresh)"
      },
      {
        "command": "volt.init",
        "title": "Volt: Set up this folder from a detected project",
        "category": "Volt"
      },
      {
        "command": "volt.pull",
        "title": "Volt: Pull (bridge → workspace)",
        "category": "Volt",
        "icon": "$(cloud-download)"
      },
      {
        "command": "volt.push",
        "title": "Volt: Push (workspace → bridge)",
        "category": "Volt",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "volt.forcePull",
        "title": "Volt: Pull --force (discard local edits)",
        "category": "Volt"
      },
      {
        "command": "volt.forcePush",
        "title": "Volt: Push --force (overwrite IDE)",
        "category": "Volt"
      },
      {
        "command": "volt.finishMerge",
        "title": "Volt: Finish Merge (resolve conflicts → sync baseline)",
        "category": "Volt",
        "icon": "$(check)"
      },
      {
        "command": "volt.abortMerge",
        "title": "Volt: Abort Merge",
        "category": "Volt",
        "icon": "$(discard)"
      },
      {
        "command": "volt.takeIdeVersion",
        "title": "Take the IDE's Version",
        "category": "Volt",
        "icon": "$(cloud-download)"
      },
      {
        "command": "volt.takeMyVersion",
        "title": "Take My Version",
        "category": "Volt",
        "icon": "$(account)"
      },
      {
        "command": "volt.refresh",
        "title": "Volt: Refresh",
        "category": "Volt",
        "icon": "$(refresh)"
      },
      {
        "command": "volt.connect",
        "title": "Volt: Reconnect (re-point the bridge at the bound project)",
        "category": "Volt",
        "icon": "$(plug)"
      },
      {
        "command": "volt.disconnect",
        "title": "Volt: Disconnect (stop syncing; the IDE stays open)",
        "category": "Volt",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "volt.build",
        "title": "Volt: Build (writes diagnostics to Problems panel)",
        "category": "Volt",
        "icon": "$(tools)"
      },
      {
        "command": "volt.openConfig",
        "title": "Volt: Open Workspace Config",
        "category": "Volt",
        "icon": "$(gear)"
      },
      {
        "command": "volt.openSettings",
        "title": "Volt: Open Settings",
        "category": "Volt",
        "icon": "$(settings-gear)"
      },
      {
        "command": "volt.showOutput",
        "title": "Volt: Show Output",
        "category": "Volt",
        "icon": "$(output)"
      },
      {
        "command": "volt.lsp.restart",
        "title": "Volt: Restart Language Server",
        "category": "Volt"
      },
      {
        "command": "volt.lsp.showOutput",
        "title": "Volt: Show Language Server Output",
        "category": "Volt"
      },
      {
        "command": "volt.lsp.showInfo",
        "title": "Volt: Show Language Server Info",
        "category": "Volt"
      },
      {
        "command": "volt.openReference",
        "title": "Volt: Open CODESYS Language Reference",
        "category": "Volt"
      }
    ],
    "submenus": [
      {
        "id": "volt.more",
        "label": "More Volt Actions…",
        "icon": "$(ellipsis)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "volt.takeIdeVersion",
          "when": "false"
        },
        {
          "command": "volt.takeMyVersion",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "volt.takeIdeVersion",
          "when": "view == volt.views.sync && viewItem == volt:conflict",
          "group": "inline@1"
        },
        {
          "command": "volt.takeMyVersion",
          "when": "view == volt.views.sync && viewItem == volt:conflict",
          "group": "inline@2"
        },
        {
          "command": "volt.finishMerge",
          "when": "view == volt.views.sync && viewItem == volt:merge",
          "group": "inline@1"
        },
        {
          "command": "volt.abortMerge",
          "when": "view == volt.views.sync && viewItem == volt:merge",
          "group": "inline@2"
        }
      ],
      "view/title": [
        {
          "command": "volt.pull",
          "when": "view == volt.views.sync && volt.workspaceInitialized && volt.bridgeOnline",
          "group": "navigation@1"
        },
        {
          "command": "volt.push",
          "when": "view == volt.views.sync && volt.workspaceInitialized && volt.bridgeOnline",
          "group": "navigation@2"
        },
        {
          "command": "volt.build",
          "when": "view == volt.views.sync && volt.workspaceInitialized && volt.bridgeOnline",
          "group": "navigation@3"
        },
        {
          "command": "volt.refresh",
          "when": "view == volt.views.sync && volt.workspaceInitialized",
          "group": "navigation@6"
        },
        {
          "submenu": "volt.more",
          "when": "view == volt.views.sync",
          "group": "navigation@99"
        },
        {
          "command": "volt.openProblems",
          "when": "view == volt.views.diagnostics",
          "group": "navigation@1"
        },
        {
          "command": "volt.refreshDiagnostics",
          "when": "view == volt.views.diagnostics",
          "group": "navigation@2"
        }
      ],
      "volt.more": [
        {
          "command": "volt.openSettings",
          "group": "1_init@1"
        },
        {
          "command": "volt.forcePull",
          "when": "volt.workspaceInitialized && volt.bridgeOnline",
          "group": "2_force@1"
        },
        {
          "command": "volt.forcePush",
          "when": "volt.workspaceInitialized && volt.bridgeOnline",
          "group": "2_force@2"
        },
        {
          "command": "volt.openConfig",
          "when": "volt.workspaceInitialized",
          "group": "9_diag@1"
        },
        {
          "command": "volt.showOutput",
          "group": "9_diag@2"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "volt.views.sync",
        "contents": "This folder isn't syncing with an IDE yet.",
        "when": "!volt.workspaceInitialized"
      },
      {
        "view": "volt.views.sync",
        "contents": "Not connected to the IDE, so there's nothing to compare against.",
        "when": "volt.workspaceInitialized && volt.bridgeOffline"
      }
    ]
  },
  "scripts": {
    "build": "tsc --noEmit && bun build src/extension.ts --outfile=dist/extension.js --target=node --format=cjs --external=vscode && bun build ../volt-lsp-iec/src/bin.ts --outfile=dist/lsp-server.js --target=node --format=cjs",
    "dev": "tsc --watch",
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "package": "bun run build && vsce package --no-dependencies --no-update-package-json $(bun ../../scripts/version.ts --vsix)",
    "publish:vscode": "bun run build && vsce publish --no-dependencies",
    "publish:openvsx": "bun run package && ovsx publish volt-vscode-$npm_package_version.vsix"
  },
  "dependencies": {
    "@volt/control": "workspace:*",
    "@volt/lsp-iec": "workspace:*",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@types/vscode": "^1.80.0",
    "@typescript/native-preview": "catalog:",
    "@vscode/vsce": "^3.0.0",
    "ovsx": "^1.0.2",
    "typescript": "catalog:"
  }
}
