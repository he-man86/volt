{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/volt-vscode",
  "displayName": "Volt",
  "description": "Syntax highlighting and language intelligence for PLC languages (currently Structured Text / IEC 61131-3; more vendors and languages to come).",
  "version": "1.15.26",
  "publisher": "volt",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/opencode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:structured-text",
    "onLanguage:plc-interface",
    "onLanguage:plc-gvl",
    "onLanguage:plc-dut",
    "onLanguage:plc-fbd",
    "onLanguage:plc-ld",
    "workspaceContains:**/.volt/config.json",
    "workspaceContains:**/*.{st,gvl,dut,itf,fbd,ld,sfc,cfc,visu,recipes,task,library,libraries,textlist,imagepool,device,trace,cam,alarm,uml,tmc}"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "structured-text",
        "aliases": [
          "Structured Text",
          "ST",
          "IEC 61131-3"
        ],
        "extensions": [
          ".st"
        ],
        "configuration": "./languages/structured-text/language-configuration.json",
        "icon": {
          "light": "./icons/st.svg",
          "dark":  "./icons/st.svg"
        }
      },
      {
        "id": "plc-interface",
        "aliases": ["PLC Interface", "ITF"],
        "extensions": [".itf"],
        "configuration": "./languages/structured-text/language-configuration.json",
        "icon": { "light": "./icons/itf.svg", "dark": "./icons/itf.svg" }
      },
      {
        "id": "plc-gvl",
        "aliases": ["PLC Global Variable List", "GVL"],
        "extensions": [".gvl"],
        "configuration": "./languages/structured-text/language-configuration.json",
        "icon": { "light": "./icons/gvl.svg", "dark": "./icons/gvl.svg" }
      },
      {
        "id": "plc-dut",
        "aliases": ["PLC Data Unit Type", "DUT"],
        "extensions": [".dut"],
        "configuration": "./languages/structured-text/language-configuration.json",
        "icon": { "light": "./icons/dut.svg", "dark": "./icons/dut.svg" }
      },
      {
        "id": "plc-fbd",
        "aliases": [
          "Function Block Diagram",
          "FBD",
          "IEC 61131-3 FBD"
        ],
        "extensions": [
          ".fbd"
        ],
        "configuration": "./languages/structured-text/language-configuration.json",
        "icon": {
          "light": "./icons/fbd.svg",
          "dark":  "./icons/fbd.svg"
        }
      },
      {
        "id": "plc-ld",
        "aliases": [
          "Ladder Diagram",
          "LD",
          "IEC 61131-3 LD"
        ],
        "extensions": [
          ".ld"
        ],
        "configuration": "./languages/structured-text/language-configuration.json",
        "icon": {
          "light": "./icons/ld.svg",
          "dark":  "./icons/ld.svg"
        }
      },
      {
        "id": "plc-visualization",
        "aliases": ["PLC Visualization", "VISU"],
        "extensions": [".visu"],
        "icon": { "light": "./icons/visu.svg", "dark": "./icons/visu.svg" }
      },
      {
        "id": "plc-recipes",
        "aliases": ["PLC Recipe", "RCPE"],
        "extensions": [".recipes"],
        "icon": { "light": "./icons/recipes.svg", "dark": "./icons/recipes.svg" }
      },
      {
        "id": "plc-task",
        "aliases": ["PLC Task"],
        "extensions": [".task"],
        "icon": { "light": "./icons/task.svg", "dark": "./icons/task.svg" }
      },
      {
        "id": "plc-library",
        "aliases": ["PLC Library Reference", "LIB"],
        "extensions": [".library", ".libraries"],
        "icon": { "light": "./icons/library.svg", "dark": "./icons/library.svg" }
      },
      {
        "id": "plc-textlist",
        "aliases": ["PLC Text List", "TXT"],
        "extensions": [".textlist"],
        "icon": { "light": "./icons/textlist.svg", "dark": "./icons/textlist.svg" }
      },
      {
        "id": "plc-imagepool",
        "aliases": ["PLC Image Pool", "IMG"],
        "extensions": [".imagepool"],
        "icon": { "light": "./icons/imagepool.svg", "dark": "./icons/imagepool.svg" }
      },
      {
        "id": "plc-device",
        "aliases": ["PLC Device", "DEV"],
        "extensions": [".device"],
        "icon": { "light": "./icons/device.svg", "dark": "./icons/device.svg" }
      },
      {
        "id": "plc-trace",
        "aliases": ["PLC Trace", "TRC"],
        "extensions": [".trace"],
        "icon": { "light": "./icons/trace.svg", "dark": "./icons/trace.svg" }
      },
      {
        "id": "plc-cam",
        "aliases": ["PLC CAM Profile"],
        "extensions": [".cam"],
        "icon": { "light": "./icons/cam.svg", "dark": "./icons/cam.svg" }
      },
      {
        "id": "plc-alarm",
        "aliases": ["PLC Alarm", "ALM"],
        "extensions": [".alarm"],
        "icon": { "light": "./icons/alarm.svg", "dark": "./icons/alarm.svg" }
      },
      {
        "id": "plc-uml",
        "aliases": ["PLC Class Diagram", "UML"],
        "extensions": [".uml"],
        "icon": { "light": "./icons/uml.svg", "dark": "./icons/uml.svg" }
      },
      {
        "id": "plc-tmc",
        "aliases": ["TwinCAT Module Class", "TMC"],
        "extensions": [".tmc"],
        "icon": { "light": "./icons/tmc.svg", "dark": "./icons/tmc.svg" }
      }
    ],
    "grammars": [
      {
        "language": "structured-text",
        "scopeName": "source.structured-text",
        "path": "./languages/structured-text/syntax.tmLanguage.json"
      },
      {
        "language": "plc-interface",
        "scopeName": "source.structured-text",
        "path": "./languages/structured-text/syntax.tmLanguage.json"
      },
      {
        "language": "plc-gvl",
        "scopeName": "source.structured-text",
        "path": "./languages/structured-text/syntax.tmLanguage.json"
      },
      {
        "language": "plc-dut",
        "scopeName": "source.structured-text",
        "path": "./languages/structured-text/syntax.tmLanguage.json"
      },
      {
        "language": "plc-fbd",
        "scopeName": "source.structured-text",
        "path": "./languages/structured-text/syntax.tmLanguage.json"
      },
      {
        "language": "plc-ld",
        "scopeName": "source.structured-text",
        "path": "./languages/structured-text/syntax.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "volt-icons",
        "label": "Volt Icons",
        "path": "./icons/volt-icons.json"
      }
    ],
    "configuration": {
      "title": "Volt",
      "properties": {
        "volt.structuredText.lspServer": {
          "type": "string",
          "default": "",
          "description": "Override the path to the volt-lsp-st bin. When empty (default), the extension auto-discovers it via Node module resolution from the workspace."
        },
        "volt.structuredText.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "LSP trace level for debugging."
        },
        "volt.structuredText.vendor": {
          "type": "string",
          "enum": ["codesys", "twincat", "auto"],
          "default": "auto",
          "description": "Which vendor's ST dialect this project targets. `auto` scans the workspace for vendor signals (.TcPOU, Tc-prefix pragmas → twincat; .project, OSCAT → codesys). Affects hover/completion filtering and the wrong-vendor-pragma diagnostic."
        },
        "volt.structuredText.hover.showSource": {
          "type": "boolean",
          "default": true,
          "description": "Append the CODESYS documentation source URL to hover content."
        },
        "volt.structuredText.completion.snippetSupport": {
          "type": "boolean",
          "default": true,
          "description": "Use snippet expansions for completion items (e.g., pragmas with placeholder values)."
        },
        "volt.structuredText.diagnostics.reservedKeyword": {
          "type": "boolean",
          "default": true,
          "description": "Flag identifiers that collide with CODESYS reserved keywords."
        },
        "volt.structuredText.diagnostics.doubleUnderscore": {
          "type": "boolean",
          "default": true,
          "description": "Flag identifiers starting with __ (reserved for system-generated names)."
        },
        "volt.structuredText.diagnostics.consecutiveUnderscores": {
          "type": "boolean",
          "default": true,
          "description": "Flag identifiers containing multiple consecutive underscores."
        },
        "volt.structuredText.diagnostics.duplicateDeclaration": {
          "type": "boolean",
          "default": true,
          "description": "Flag two declarations with the same name in the same scope."
        },
        "volt.structuredText.diagnostics.unresolvedIdentifier": {
          "type": "boolean",
          "default": true,
          "description": "Warn on identifiers in bodies that don't resolve in any reachable scope. Can false-positive on library-imported symbols."
        },
        "volt.structuredText.diagnostics.unknownPragma": {
          "type": "boolean",
          "default": true,
          "description": "Warn on pragma names not in either vendor's catalog."
        },
        "volt.structuredText.diagnostics.wrongVendorPragma": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a pragma is known but belongs to the OTHER vendor (e.g. {attribute 'TcRpcEnable'} in a CODESYS project). Includes equivalent suggestion when available."
        },
        "volt.structuredText.diagnostics.pragmaMissingCompanion": {
          "type": "boolean",
          "default": true,
          "description": "Error when a pragma is missing its required companion (e.g., instance-path requires reflection)."
        },
        "volt.structuredText.diagnostics.pragmaConflict": {
          "type": "boolean",
          "default": true,
          "description": "Warn on mutually-exclusive pragmas applied to the same target."
        },
        "volt.structuredText.diagnostics.fbLifecycleSignature": {
          "type": "boolean",
          "default": true,
          "description": "Validate FB_Init / FB_Reinit / FB_Exit signatures."
        },
        "volt.structuredText.diagnostics.shadowingDeclaration": {
          "type": "boolean",
          "default": true,
          "description": "Inform when a declaration shadows a same-name symbol in an outer scope."
        },
        "volt.structuredText.diagnostics.initSlotCollision": {
          "type": "boolean",
          "default": true,
          "description": "Warn when {attribute 'global_init_slot' := 'N'} collides with a CODESYS-reserved slot."
        },
        "volt.structuredText.diagnostics.conversionSourceMismatch": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a type-conversion function (e.g. INT_TO_DINT) is called with an argument whose declared type doesn't match the function's expected source type. Includes a suggested replacement (e.g. STRING_TO_DINT)."
        },
        "volt.cli.path": {
          "type": "string",
          "default": "",
          "description": "Override path to the `volt` CLI binary. When empty (default), the extension assumes `volt` is on PATH (populated by `bun install` via the workspace's node_modules/.bin)."
        }
      }
    },
    "commands": [
      {
        "command": "volt.restart",
        "title": "Volt: Restart Language Server",
        "category": "Volt"
      },
      {
        "command": "volt.structured-text.showOutput",
        "title": "Volt: Show Structured Text Output",
        "category": "Volt"
      },
      {
        "command": "volt.openReference",
        "title": "Volt: Open CODESYS Language Reference",
        "category": "Volt"
      },
      {
        "command": "volt.cli.status",
        "title": "Volt: Status",
        "category": "Volt",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "volt.cli.pull",
        "title": "Volt: Pull (bridge → workspace)",
        "category": "Volt",
        "icon": "$(cloud-download)"
      },
      {
        "command": "volt.cli.push",
        "title": "Volt: Push (workspace → bridge)",
        "category": "Volt",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "volt.cli.build",
        "title": "Volt: Build (writes diagnostics to Problems panel)",
        "category": "Volt",
        "icon": "$(tools)"
      },
      {
        "command": "volt.cli.init",
        "title": "Volt: Init Workspace",
        "category": "Volt",
        "icon": "$(zap)"
      },
      {
        "command": "volt.cli.configureAccess",
        "title": "Volt: Configure Extension Access",
        "category": "Volt",
        "icon": "$(gear)"
      },
      {
        "command": "volt.scm.refresh",
        "title": "Volt: Refresh SCM",
        "category": "Volt",
        "icon": "$(refresh)"
      },
      {
        "command": "volt.scm.showOutput",
        "title": "Volt: Show SCM Output Log",
        "category": "Volt",
        "icon": "$(output)"
      },
      {
        "command": "volt.scm.pull",
        "title": "Volt: Pull (SCM action)",
        "category": "Volt",
        "icon": "$(cloud-download)"
      },
      {
        "command": "volt.scm.push",
        "title": "Volt: Push (SCM action)",
        "category": "Volt",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "volt.scm.forcePull",
        "title": "Volt: Pull --force (discard local edits)",
        "category": "Volt"
      },
      {
        "command": "volt.scm.forcePush",
        "title": "Volt: Push --force (overwrite IDE)",
        "category": "Volt"
      },
      {
        "command": "volt.scm.mergeContinue",
        "title": "Volt: Merge — Continue",
        "category": "Volt",
        "icon": "$(check)"
      },
      {
        "command": "volt.scm.mergeAbort",
        "title": "Volt: Merge — Abort",
        "category": "Volt",
        "icon": "$(discard)"
      },
      {
        "command": "volt.scm.openMergeEditor",
        "title": "Volt: Open in Merge Editor",
        "category": "Volt",
        "icon": "$(diff)"
      },
      {
        "command": "volt.scm.resolveUseMine",
        "title": "Volt: Resolve — Use My Version",
        "category": "Volt",
        "icon": "$(arrow-left)"
      },
      {
        "command": "volt.scm.resolveUseTheirs",
        "title": "Volt: Resolve — Use IDE's Version",
        "category": "Volt",
        "icon": "$(arrow-right)"
      },
      {
        "command": "volt.scm.resolveAllUseMine",
        "title": "Volt: Resolve All — Use My Version",
        "category": "Volt"
      },
      {
        "command": "volt.scm.resolveAllUseTheirs",
        "title": "Volt: Resolve All — Use IDE's Version",
        "category": "Volt"
      },
      {
        "command": "volt.scm.discardOutgoing",
        "title": "Volt: Discard Local Change",
        "category": "Volt",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "volt.scm.pull",
          "when": "view == volt.scm",
          "group": "navigation@1"
        },
        {
          "command": "volt.scm.push",
          "when": "view == volt.scm",
          "group": "navigation@2"
        },
        {
          "command": "volt.scm.refresh",
          "when": "view == volt.scm",
          "group": "navigation@3"
        },
        {
          "command": "volt.scm.mergeContinue",
          "when": "view == volt.scm && volt.merging",
          "group": "1_merge@1"
        },
        {
          "command": "volt.scm.mergeAbort",
          "when": "view == volt.scm && volt.merging",
          "group": "1_merge@2"
        },
        {
          "command": "volt.scm.resolveAllUseMine",
          "when": "view == volt.scm && volt.merging",
          "group": "1_merge@3"
        },
        {
          "command": "volt.scm.resolveAllUseTheirs",
          "when": "view == volt.scm && volt.merging",
          "group": "1_merge@4"
        },
        {
          "command": "volt.scm.forcePull",
          "when": "view == volt.scm",
          "group": "2_force@1"
        },
        {
          "command": "volt.scm.forcePush",
          "when": "view == volt.scm",
          "group": "2_force@2"
        }
      ],
      "view/item/context": [
        {
          "command": "volt.scm.refresh",
          "when": "view == volt.scm && viewItem == volt.health",
          "group": "1_health@1"
        },
        {
          "command": "volt.scm.showOutput",
          "when": "view == volt.scm && viewItem == volt.health",
          "group": "1_health@2"
        },
        {
          "command": "volt.scm.resolveUseMine",
          "when": "view == volt.scm && viewItem == volt.item.merge",
          "group": "inline@1"
        },
        {
          "command": "volt.scm.resolveUseTheirs",
          "when": "view == volt.scm && viewItem == volt.item.merge",
          "group": "inline@2"
        },
        {
          "command": "volt.scm.resolveUseMine",
          "when": "view == volt.scm && viewItem == volt.item.merge",
          "group": "1_resolve@1"
        },
        {
          "command": "volt.scm.resolveUseTheirs",
          "when": "view == volt.scm && viewItem == volt.item.merge",
          "group": "1_resolve@2"
        },
        {
          "command": "volt.scm.openMergeEditor",
          "when": "view == volt.scm && viewItem == volt.item.merge",
          "group": "2_editor@1"
        },
        {
          "command": "volt.scm.discardOutgoing",
          "when": "view == volt.scm && viewItem == volt.item.outgoing",
          "group": "inline@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "volt",
          "title": "Volt",
          "icon": "icons/volt-activitybar.svg"
        }
      ]
    },
    "views": {
      "volt": [
        {
          "id": "volt.scm",
          "name": "Sync with IDE",
          "contextualTitle": "Volt"
        },
        {
          "id": "volt.history",
          "name": "Sync history",
          "contextualTitle": "Volt"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "volt.scm",
        "contents": "No Volt workspace detected here.\n\nVolt syncs your workspace with the running PLC IDE (CODESYS / TwinCAT).\n\n[Initialize Volt](command:volt.cli.init)\n\nIf you already have a `.volt/config.json` somewhere in this workspace, open that folder as the workspace root.",
        "when": "workbenchState != empty"
      },
      {
        "view": "volt.scm",
        "contents": "Open a folder to start using Volt.\n\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      }
    ]
  },
  "scripts": {
    "build": "tsc --noEmit && bun build src/extension.ts --outfile=dist/extension.js --target=node --format=cjs --external=vscode && bun build ../volt-lsp-st/src/bin.ts --outfile=dist/lsp-server.js --target=node --format=cjs",
    "dev": "tsc --watch",
    "typecheck": "tsgo --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@types/vscode": "^1.80.0",
    "@typescript/native-preview": "catalog:",
    "@vscode/vsce": "^3.0.0",
    "typescript": "catalog:"
  }
}
