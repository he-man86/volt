{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "volt-vscode",
  "displayName": "Volt",
  "description": "Syntax highlighting and language intelligence for PLC languages (currently Structured Text / IEC 61131-3; more vendors and languages to come).",
  "version": "1.21.8",
  "publisher": "volt",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/opencode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:structured-text",
    "onLanguage:plc-interface",
    "onLanguage:plc-gvl",
    "onLanguage:plc-dut",
    "workspaceContains:**/*.{st,itf,gvl,struct,union,enum,alias,library,library_manager,task,image_pool,text_list,recipe_manager,visualization,visualization_manager,class_diagram,external_types,tmc}"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "colors": [
      {
        "id": "volt.driftIncomingForeground",
        "description": "Volt: a file the IDE changed (pull to absorb). Distinct from git's colors.",
        "defaults": {
          "dark": "#3794FF",
          "light": "#0066BF",
          "highContrast": "#3794FF",
          "highContrastLight": "#0066BF"
        }
      },
      {
        "id": "volt.driftOutgoingForeground",
        "description": "Volt: a file you changed locally (push to the IDE). Distinct from git's colors.",
        "defaults": {
          "dark": "#C586C0",
          "light": "#8E44AD",
          "highContrast": "#C586C0",
          "highContrastLight": "#8E44AD"
        }
      },
      {
        "id": "volt.driftConflictForeground",
        "description": "Volt: a file that conflicts with the IDE (resolve before pushing).",
        "defaults": {
          "dark": "#E0822D",
          "light": "#B5670B",
          "highContrast": "#E0822D",
          "highContrastLight": "#B5670B"
        }
      }
    ],
    "languages": [
      {
        "id": "structured-text",
        "aliases": [
          "Structured Text",
          "ST",
          "IEC 61131-3"
        ],
        "extensions": [
          ".st",
          ".fbd",
          ".ld",
          ".cfc",
          ".sfc"
        ],
        "configuration": "./languages/structured-text/language-configuration.json",
        "icon": {
          "light": "./icons/st.svg",
          "dark": "./icons/st.svg"
        }
      },
      {
        "id": "plc-interface",
        "aliases": [
          "PLC Interface",
          "ITF"
        ],
        "extensions": [
          ".itf"
        ],
        "configuration": "./languages/structured-text/language-configuration.json",
        "icon": {
          "light": "./icons/itf.svg",
          "dark": "./icons/itf.svg"
        }
      },
      {
        "id": "plc-gvl",
        "aliases": [
          "PLC Global Variable List",
          "GVL"
        ],
        "extensions": [
          ".gvl"
        ],
        "configuration": "./languages/structured-text/language-configuration.json",
        "icon": {
          "light": "./icons/gvl.svg",
          "dark": "./icons/gvl.svg"
        }
      },
      {
        "id": "plc-dut",
        "aliases": [
          "PLC Data Unit Type",
          "DUT",
          "Structure",
          "Enumeration",
          "Union",
          "Alias"
        ],
        "extensions": [
          ".struct",
          ".enum",
          ".union",
          ".alias"
        ],
        "configuration": "./languages/structured-text/language-configuration.json",
        "icon": {
          "light": "./icons/dut.svg",
          "dark": "./icons/dut.svg"
        }
      },
      {
        "id": "plc-library",
        "aliases": [
          "PLC Library Reference",
          "LIB"
        ],
        "extensions": [
          ".library"
        ],
        "icon": {
          "light": "./icons/library.svg",
          "dark": "./icons/library.svg"
        }
      },
      {
        "id": "plc-library-manager",
        "aliases": [
          "PLC Library Manager"
        ],
        "extensions": [
          ".library_manager"
        ],
        "icon": {
          "light": "./icons/library.svg",
          "dark": "./icons/library.svg"
        }
      },
      {
        "id": "plc-task",
        "aliases": [
          "PLC Task"
        ],
        "extensions": [
          ".task"
        ],
        "icon": {
          "light": "./icons/task.svg",
          "dark": "./icons/task.svg"
        }
      },
      {
        "id": "plc-image-pool",
        "aliases": [
          "PLC Image Pool",
          "IMG"
        ],
        "extensions": [
          ".image_pool"
        ],
        "icon": {
          "light": "./icons/imagepool.svg",
          "dark": "./icons/imagepool.svg"
        }
      },
      {
        "id": "plc-text-list",
        "aliases": [
          "PLC Text List",
          "TXT"
        ],
        "extensions": [
          ".text_list"
        ],
        "icon": {
          "light": "./icons/textlist.svg",
          "dark": "./icons/textlist.svg"
        }
      },
      {
        "id": "plc-recipe-manager",
        "aliases": [
          "PLC Recipe Manager",
          "RCPE"
        ],
        "extensions": [
          ".recipe_manager"
        ],
        "icon": {
          "light": "./icons/recipes.svg",
          "dark": "./icons/recipes.svg"
        }
      },
      {
        "id": "plc-visualization",
        "aliases": [
          "PLC Visualization Screen",
          "VISU"
        ],
        "extensions": [
          ".visualization"
        ],
        "icon": {
          "light": "./icons/visu.svg",
          "dark": "./icons/visu.svg"
        }
      },
      {
        "id": "plc-visualization-manager",
        "aliases": [
          "PLC Visualization Manager"
        ],
        "extensions": [
          ".visualization_manager"
        ],
        "icon": {
          "light": "./icons/visu.svg",
          "dark": "./icons/visu.svg"
        }
      },
      {
        "id": "plc-class-diagram",
        "aliases": [
          "PLC Class Diagram",
          "UML"
        ],
        "extensions": [
          ".class_diagram"
        ],
        "icon": {
          "light": "./icons/uml.svg",
          "dark": "./icons/uml.svg"
        }
      },
      {
        "id": "plc-external-types",
        "aliases": [
          "PLC External Types"
        ],
        "extensions": [
          ".external_types"
        ],
        "icon": {
          "light": "./icons/generic-file.svg",
          "dark": "./icons/generic-file.svg"
        }
      },
      {
        "id": "plc-tmc",
        "aliases": [
          "TwinCAT Module Class",
          "TMC"
        ],
        "extensions": [
          ".tmc"
        ],
        "icon": {
          "light": "./icons/tmc.svg",
          "dark": "./icons/tmc.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "structured-text",
        "scopeName": "source.structured-text",
        "path": "./languages/structured-text/syntax.tmLanguage.json"
      },
      {
        "language": "plc-interface",
        "scopeName": "source.structured-text",
        "path": "./languages/structured-text/syntax.tmLanguage.json"
      },
      {
        "language": "plc-gvl",
        "scopeName": "source.structured-text",
        "path": "./languages/structured-text/syntax.tmLanguage.json"
      },
      {
        "language": "plc-dut",
        "scopeName": "source.structured-text",
        "path": "./languages/structured-text/syntax.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "volt-icons",
        "label": "Volt Icons",
        "path": "./icons/volt-icons.json"
      }
    ],
    "configuration": {
      "title": "Volt",
      "properties": {
        "volt.structuredText.lspServer": {
          "type": "string",
          "default": "",
          "description": "Override the path to the volt-lsp-st bin. When empty (default), the extension auto-discovers it via Node module resolution from the workspace."
        },
        "volt.structuredText.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "LSP trace level for debugging."
        },
        "volt.structuredText.vendor": {
          "type": "string",
          "enum": [
            "codesys",
            "twincat",
            "auto"
          ],
          "default": "auto",
          "description": "Which vendor's ST dialect this project targets. `auto` scans the workspace for vendor signals (.TcPOU, Tc-prefix pragmas → twincat; .project, OSCAT → codesys). Affects hover/completion filtering and the wrong-vendor-pragma diagnostic."
        },
        "volt.structuredText.hover.showSource": {
          "type": "boolean",
          "default": true,
          "description": "Append the CODESYS documentation source URL to hover content."
        },
        "volt.structuredText.completion.snippetSupport": {
          "type": "boolean",
          "default": true,
          "description": "Use snippet expansions for completion items (e.g., pragmas with placeholder values)."
        },
        "volt.structuredText.diagnostics.reservedKeyword": {
          "type": "boolean",
          "default": true,
          "description": "Flag identifiers that collide with CODESYS reserved keywords."
        },
        "volt.structuredText.diagnostics.doubleUnderscore": {
          "type": "boolean",
          "default": true,
          "description": "Flag identifiers starting with __ (reserved for system-generated names)."
        },
        "volt.structuredText.diagnostics.consecutiveUnderscores": {
          "type": "boolean",
          "default": true,
          "description": "Flag identifiers containing multiple consecutive underscores."
        },
        "volt.structuredText.diagnostics.duplicateDeclaration": {
          "type": "boolean",
          "default": true,
          "description": "Flag two declarations with the same name in the same scope."
        },
        "volt.structuredText.diagnostics.unresolvedIdentifier": {
          "type": "boolean",
          "default": true,
          "description": "Warn on identifiers in bodies that don't resolve in any reachable scope. Can false-positive on library-imported symbols."
        },
        "volt.structuredText.diagnostics.unknownPragma": {
          "type": "boolean",
          "default": true,
          "description": "Warn on pragma names not in either vendor's catalog."
        },
        "volt.structuredText.diagnostics.wrongVendorPragma": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a pragma is known but belongs to the OTHER vendor (e.g. {attribute 'TcRpcEnable'} in a CODESYS project). Includes equivalent suggestion when available."
        },
        "volt.structuredText.diagnostics.pragmaMissingCompanion": {
          "type": "boolean",
          "default": true,
          "description": "Error when a pragma is missing its required companion (e.g., instance-path requires reflection)."
        },
        "volt.structuredText.diagnostics.pragmaConflict": {
          "type": "boolean",
          "default": true,
          "description": "Warn on mutually-exclusive pragmas applied to the same target."
        },
        "volt.structuredText.diagnostics.fbLifecycleSignature": {
          "type": "boolean",
          "default": true,
          "description": "Validate FB_Init / FB_Reinit / FB_Exit signatures."
        },
        "volt.structuredText.diagnostics.shadowingDeclaration": {
          "type": "boolean",
          "default": true,
          "description": "Inform when a declaration shadows a same-name symbol in an outer scope."
        },
        "volt.structuredText.diagnostics.initSlotCollision": {
          "type": "boolean",
          "default": true,
          "description": "Warn when {attribute 'global_init_slot' := 'N'} collides with a CODESYS-reserved slot."
        },
        "volt.structuredText.diagnostics.conversionSourceMismatch": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a type-conversion function (e.g. INT_TO_DINT) is called with an argument whose declared type doesn't match the function's expected source type. Includes a suggested replacement (e.g. STRING_TO_DINT)."
        },
        "volt.cli.path": {
          "type": "string",
          "default": "",
          "description": "Override path to the `volt` CLI binary. When empty (default), the extension assumes `volt` is on PATH (populated by `bun install` via the workspace's node_modules/.bin)."
        },
        "volt.bridge.twincatPort": {
          "type": "number",
          "default": 8555,
          "minimum": 1,
          "maximum": 65535,
          "description": "Port the TwinCAT / Beckhoff bridge listens on. Used by the `Initialize for TwinCAT` welcome-view button. Once a workspace is initialized, the port stored in `.volt/config.json` takes precedence for that workspace."
        },
        "volt.bridge.codesysPort": {
          "type": "number",
          "default": 8556,
          "minimum": 1,
          "maximum": 65535,
          "description": "Port the CODESYS bridge listens on. Used by the `Initialize for CODESYS` welcome-view button. Once a workspace is initialized, the port stored in `.volt/config.json` takes precedence for that workspace."
        },
        "volt.connector.path": {
          "type": "string",
          "default": "",
          "description": "Full path to VoltConnector.exe. The connector supervises the bridges from the system tray; the extension launches it automatically when needed. Leave empty to use the conventional install location (%LOCALAPPDATA%\\Programs\\Volt\\VoltConnector.exe) or the VOLT_CONNECTOR_EXE environment variable."
        }
      }
    },
    "commands": [
      {
        "command": "volt.setup",
        "title": "Volt: Set Up Workspace (detect IDE)",
        "category": "Volt",
        "icon": "$(rocket)"
      },
      {
        "command": "volt.openCodesysVersion",
        "title": "Volt: Open CODESYS (choose version/fork)",
        "category": "Volt"
      },
      {
        "command": "volt.selectTwincatProject",
        "title": "Volt: Select TwinCAT Project to Connect",
        "category": "Volt"
      },
      {
        "command": "volt.init",
        "title": "Volt: Initialize Workspace",
        "category": "Volt",
        "icon": "$(zap)"
      },
      {
        "command": "volt.initTwincat",
        "title": "Volt: Initialize for TwinCAT (port 8555)",
        "category": "Volt"
      },
      {
        "command": "volt.initCodesys",
        "title": "Volt: Initialize for CODESYS (port 8556)",
        "category": "Volt"
      },
      {
        "command": "volt.acceptProjectRename",
        "title": "Volt: Accept Project Rename",
        "category": "Volt"
      },
      {
        "command": "volt.pull",
        "title": "Volt: Pull (bridge → workspace)",
        "category": "Volt",
        "icon": "$(cloud-download)"
      },
      {
        "command": "volt.push",
        "title": "Volt: Push (workspace → bridge)",
        "category": "Volt",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "volt.forcePull",
        "title": "Volt: Pull --force (discard local edits)",
        "category": "Volt"
      },
      {
        "command": "volt.forcePush",
        "title": "Volt: Push --force (overwrite IDE)",
        "category": "Volt"
      },
      {
        "command": "volt.status",
        "title": "Volt: Status",
        "category": "Volt",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "volt.refresh",
        "title": "Volt: Refresh",
        "category": "Volt",
        "icon": "$(refresh)"
      },
      {
        "command": "volt.startBridge",
        "title": "Volt: Start Bridge",
        "category": "Volt",
        "icon": "$(debug-start)"
      },
      {
        "command": "volt.build",
        "title": "Volt: Build (writes diagnostics to Problems panel)",
        "category": "Volt",
        "icon": "$(tools)"
      },
      {
        "command": "volt.openConfig",
        "title": "Volt: Open .volt/config.json",
        "category": "Volt",
        "icon": "$(gear)"
      },
      {
        "command": "volt.openSettings",
        "title": "Volt: Open Settings",
        "category": "Volt",
        "icon": "$(settings-gear)"
      },
      {
        "command": "volt.showOutput",
        "title": "Volt: Show Output",
        "category": "Volt",
        "icon": "$(output)"
      },
      {
        "command": "volt.lsp.restart",
        "title": "Volt: Restart Language Server",
        "category": "Volt"
      },
      {
        "command": "volt.lsp.showOutput",
        "title": "Volt: Show Language Server Output",
        "category": "Volt"
      },
      {
        "command": "volt.openReference",
        "title": "Volt: Open CODESYS Language Reference",
        "category": "Volt"
      }
    ],
    "submenus": [
      {
        "id": "volt.scm.more",
        "label": "More Volt Actions…",
        "icon": "$(ellipsis)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "volt.initTwincat",
          "when": "false"
        },
        {
          "command": "volt.initCodesys",
          "when": "false"
        },
        {
          "command": "volt.acceptProjectRename",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "volt.pull",
          "when": "view == volt.scm && volt.workspaceInitialized",
          "group": "navigation@1"
        },
        {
          "command": "volt.push",
          "when": "view == volt.scm && volt.workspaceInitialized",
          "group": "navigation@2"
        },
        {
          "command": "volt.refresh",
          "when": "view == volt.scm && volt.workspaceInitialized",
          "group": "navigation@3"
        },
        {
          "submenu": "volt.scm.more",
          "when": "view == volt.scm",
          "group": "navigation@99"
        }
      ],
      "volt.scm.more": [
        {
          "command": "volt.init",
          "when": "!volt.workspaceInitialized",
          "group": "1_init@1"
        },
        {
          "command": "volt.openSettings",
          "group": "1_init@2"
        },
        {
          "command": "volt.forcePull",
          "when": "volt.workspaceInitialized",
          "group": "2_force@1"
        },
        {
          "command": "volt.forcePush",
          "when": "volt.workspaceInitialized",
          "group": "2_force@2"
        },
        {
          "command": "volt.openConfig",
          "when": "volt.workspaceInitialized",
          "group": "9_diag@1"
        },
        {
          "command": "volt.showOutput",
          "group": "9_diag@2"
        }
      ],
      "view/item/context": [
        {
          "command": "volt.startBridge",
          "when": "view == volt.scm && viewItem == volt.health",
          "group": "inline@1"
        },
        {
          "command": "volt.refresh",
          "when": "view == volt.scm && viewItem == volt.health",
          "group": "1_health@1"
        },
        {
          "command": "volt.startBridge",
          "when": "view == volt.scm && viewItem == volt.health",
          "group": "1_health@2"
        },
        {
          "command": "volt.showOutput",
          "when": "view == volt.scm && viewItem == volt.health",
          "group": "1_health@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "volt",
          "title": "Volt",
          "icon": "icons/volt-activitybar.svg"
        }
      ]
    },
    "views": {
      "volt": [
        {
          "id": "volt.scm",
          "name": "Sync with IDE",
          "contextualTitle": "Volt"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "volt.scm",
        "contents": "Open a folder to start using Volt.\n\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "volt.scm",
        "contents": "No Volt workspace here.\n\nVolt syncs your folder with the running PLC IDE so you can read, edit and merge POU files alongside the rest of your code.\n\n[Set Up Volt — detect my IDE](command:volt.setup)\n\nThis finds the project open in your IDE and binds to it automatically. Or pick a target manually:\n\n[Initialize for TwinCAT](command:volt.initTwincat)\n[Initialize for CODESYS](command:volt.initCodesys)\n\nFor a non-standard port, set `volt.bridge.twincatPort` or `volt.bridge.codesysPort` in [Settings](command:volt.openSettings).\n\nIf you already have a `.volt/config.json` somewhere in this workspace, open that folder as the workspace root.",
        "when": "workbenchState != empty && !volt.workspaceInitialized"
      }
    ]
  },
  "scripts": {
    "build": "tsc --noEmit && bun build src/extension.ts --outfile=dist/extension.js --target=node --format=cjs --external=vscode && bun build ../volt-lsp-st/src/bin.ts --outfile=dist/lsp-server.js --target=node --format=cjs && bun build ../volt-git/src/bin.ts --outfile=dist/cli.js --target=node --format=cjs",
    "dev": "tsc --watch",
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "package": "bun run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "@opencode-ai/volt-control": "workspace:*",
    "@opencode-ai/volt-lsp": "workspace:*",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@types/vscode": "^1.80.0",
    "@typescript/native-preview": "catalog:",
    "@vscode/vsce": "^3.0.0",
    "typescript": "catalog:"
  }
}
