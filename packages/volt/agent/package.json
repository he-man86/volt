{
  "name": "@opencode-ai/volt-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Volt agent — `volt` CLI (init/import/export/status/compile) on top of a vendor bridge, plus an MCP server (`volt-mcp`) exposing the same surface to AI clients.",
  "type": "module",
  "bin": {
    "volt": "./dist/cli/bin.js",
    "volt-mcp": "./dist/tools/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "conformance": "tsc -b && node dist/cli/conformance.js",
    "conformance:drift": "tsc -b && node dist/cli/conformance-drift.js",
    "conformance:errors": "tsc -b && node dist/cli/conformance-errors.js",
    "conformance:mcp": "tsc -b && node dist/tools/conformance.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/volt-lsp-st": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "^2.1.0"
  }
}
