# Fixtures must commit with LF endings regardless of host OS — they're
# read verbatim by the test suite, and snapshot output would diverge if
# Windows checkout converted them to CRLF.
*.st text eol=lf
*.gvl text eol=lf
*.dut text eol=lf
*.itf text eol=lf
*.fbd text eol=lf
*.ld text eol=lf
*.sfc text eol=lf
*.cfc text eol=lf
