(* =================================================================================================================================
   Sample enumeration to define the states of a state machine
   =================================================================================================================================
   InfoSys:
   https://infosys.beckhoff.de/content/1033/tc3_plc_intro/9007201784812683.html?id=6182746204999759027
   https://infosys.beckhoff.de/content/1033/tc3_plc_intro/18014401038986379.html?id=8148839119508438674
   ================================================================================================================================= *)
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_StateMachine :
(
	GoToNextState_viaTimer1 := 1,
	GoToNextState_viaRisingEdge,
	GoToNextState_viaTimer2
);
END_TYPE