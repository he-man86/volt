{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "lsp": {
    "volt-lsp-iec": {
      "command": ["volt-lsp-iec", "--stdio"],
      "extensions": [".fb", ".prg", ".fun", ".itf", ".struct", ".enum", ".union", ".alias", ".gvl"]
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "volt init*": "ask",
      "volt pull*": "ask",
      "volt push*": "ask",
      "volt merge*": "ask"
    }
  }
}
