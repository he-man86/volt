{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/volt-git",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Git-native Volt CLI — single-repo pull/push/status for IEC 61131-3 projects (the IDE is a git branch; git does the merge).",
  "type": "module",
  "bin": {
    "volt": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsgo --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@opencode-ai/volt-lsp": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
