{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/volt-lsp-iec",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/opencode"
  },
  "description": "Ground-up rebuild of the IEC 61131-3 Structured Text language server, built layer-by-layer from openspec/specs/st-language-server. Isolated clean-room package; nothing imports it until it subsumes volt-lsp-iec.",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./conformance": {
      "bun": "./test/conformance/index.ts",
      "default": "./dist/test/conformance/index.js"
    }
  },
  "bin": {
    "volt-lsp-iec": "./dist/src/bin.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsgo --noEmit -p tsconfig.test.json && tsgo --noEmit -p scripts/tsconfig.json",
    "lint": "bun run scripts/check-layering.ts",
    "test": "bun test",
    "record:language": "bun run scripts/record-language.ts",
    "harvest:corpus": "bun run scripts/harvest-lsp-corpus.ts",
    "audit:check": "bun run scripts/audit-check.ts"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
