{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@volt/lsp-iec",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/he-man86/volt"
  },
  "description": "TypeScript-native language server for IEC 61131-3 Structured Text (+ the VG graphical sublanguage) — diagnostics, nav, completion, hover, signature help, semantic tokens.",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./conformance": {
      "bun": "./test/conformance/index.ts",
      "default": "./dist/test/conformance/index.js"
    }
  },
  "bin": {
    "volt-lsp-iec": "./dist/src/bin.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsgo --noEmit",
    "lint": "bun run scripts/check-layering.ts",
    "test": "bun test src test/conformance",
    "test:corpus": "bun test test/corpus",
    "record:language": "bun run scripts/record-language.ts",
    "refresh:corpus": "bun run scripts/refresh-corpus.ts",
    "audit:check": "bun run scripts/audit-check.ts"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
