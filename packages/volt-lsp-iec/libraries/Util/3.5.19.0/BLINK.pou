FUNCTION_BLOCK BLINK
VAR_INPUT
	ENABLE : BOOL;
	TIMELOW : TIME;
	TIMEHIGH : TIME;
END_VAR
VAR_OUTPUT
	OUT : BOOL;
END_VAR
VAR
	CLOCK : TP;
END_VAR
(* OUT alternates between a TIMEHIGH phase and a TIMELOW phase for as long as ENABLE holds, HIGH FIRST: OUT is TRUE on
   the very scan ENABLE is. One TP times the running phase; in the scan it runs out — or when none has run yet — OUT
   flips and the TP is re-armed with the other phase's length. With ENABLE FALSE the block does nothing — OUT keeps what
   it was (recorded: lib_util_blink, lib_util_blink_slow). ponytail: what re-enabling resumes is unrecorded *)
IF ENABLE THEN
	IF CLOCK.Q THEN
		CLOCK(IN := TRUE);
	END_IF
	IF NOT CLOCK.Q THEN
		OUT := NOT OUT;
		CLOCK(IN := FALSE);
		CLOCK(IN := TRUE, PT := SEL(OUT, TIMELOW, TIMEHIGH));
	END_IF
END_IF
END_FUNCTION_BLOCK