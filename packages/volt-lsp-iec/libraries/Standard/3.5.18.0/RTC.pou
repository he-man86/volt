FUNCTION_BLOCK RTC
VAR_INPUT
	EN : BOOL;
	PDT : DATE_AND_TIME;
END_VAR
VAR_OUTPUT
	Q : BOOL;
	CDT : DATE_AND_TIME;
END_VAR
VAR
	M : BOOL;
	DIFFTIME : TIME;
	LASTTIME : TIME := TIME#0ms;
	TIMEOFFSET : TIME := TIME#0ms;
	CURTIME : TIME;
END_VAR
(* CDT starts at PDT on EN's rising edge and runs with the clock; TIMEOFFSET carries the milliseconds a DT, which
   counts seconds, cannot hold yet *)
IF EN THEN
	CURTIME := TIME();
	IF NOT M THEN
		CDT := PDT;
		LASTTIME := CURTIME;
		TIMEOFFSET := TIME#0ms;
		M := TRUE;
	END_IF
	DIFFTIME := CURTIME - LASTTIME + TIMEOFFSET;
	CDT := DWORD_TO_DT(DT_TO_DWORD(CDT) + TIME_TO_DWORD(DIFFTIME) / 1000);
	TIMEOFFSET := DWORD_TO_TIME(TIME_TO_DWORD(DIFFTIME) MOD 1000);
	LASTTIME := CURTIME;
	Q := TRUE;
ELSE
	M := FALSE;
	Q := FALSE;
END_IF
END_FUNCTION_BLOCK