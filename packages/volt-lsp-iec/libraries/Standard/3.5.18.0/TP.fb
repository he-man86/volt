FUNCTION_BLOCK TP
VAR_INPUT
	IN : BOOL;
	PT : TIME;
END_VAR
VAR_OUTPUT
	Q : BOOL;
	ET : TIME;
END_VAR
VAR
	STARTTIME : TIME;
END_VAR
(* a pulse of PT on IN's rising edge, which IN falling does not cut short. Once no pulse runs and IN is FALSE,
   ET is 0 — in the very scan the pulse runs out, not the one after (recorded: lib_std_tp) — and ET = 0 is what arms
   the next pulse *)
IF Q THEN
	ET := TIME() - STARTTIME;
	IF ET >= PT THEN
		Q := FALSE;
		ET := PT;
	END_IF
ELSIF IN THEN
	IF ET = TIME#0ms THEN
		STARTTIME := TIME();
		Q := TRUE;
	END_IF
END_IF
IF NOT IN AND NOT Q THEN
	ET := TIME#0ms;
END_IF
END_FUNCTION_BLOCK