FUNCTION HELPSTRCMPENDA : BOOL
VAR_INPUT
	PCOMPLETETEXT : CharBufferPtr;
	PSUBTEXT : CharBufferPtr;
	XIGNORECASE : BOOL;
END_VAR
VAR
	i : DINT;
	n : DINT;
	m : DINT;
END_VAR
(* does PCOMPLETETEXT end with PSUBTEXT (case folded when XIGNORECASE) *)
IF PCOMPLETETEXT = 0 OR PSUBTEXT = 0 THEN
	RETURN;
END_IF
n := STRLENA(PCOMPLETETEXT);
m := STRLENA(PSUBTEXT);
IF m > n THEN
	RETURN;
END_IF
FOR i := 0 TO m - 1 DO
	IF XIGNORECASE THEN
		IF NOT HELPISSAMEIGNORECASE(PCOMPLETETEXT[n - m + i], PSUBTEXT[i]) THEN
			RETURN;
		END_IF
	ELSIF PCOMPLETETEXT[n - m + i] <> PSUBTEXT[i] THEN
		RETURN;
	END_IF
END_FOR
HELPSTRCMPENDA := TRUE;
END_FUNCTION