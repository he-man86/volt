FUNCTION STRREPLACEA
VAR_INPUT
	PSTINPUT : POINTER TO STRING(255);
	UIINPUTBUFFERSIZE : UINT;
	PSTREPLACEWITH : POINTER TO STRING(255);
	ILENGTHINPUT : INT;
	ILENGTHTOREPLACE : INT;
	ILENGTHTOREPLACEWITH : INT;
	IPOSITION : INT;
END_VAR
VAR
	buf : ARRAY[0..255] OF BYTE;
	i : DINT;
	n : DINT;
	p : DINT;
	cnt : DINT;
	src : DINT;
	dst : DINT;
	cap : DINT;
END_VAR
(* NOT REPLACE — a raw in-place move over the input's BUFFER, as CODESYS answers it (recorded: lib_stu_replace,
   lib_stu_replace_past_len). With p = IPOSITION - 1:
   1. the bytes from p + ILENGTHTOREPLACE up to ILENGTHINPUT, its terminator included, move to p + ILENGTHTOREPLACEWITH
      — nothing moves when ILENGTHINPUT does not reach past them, so ILENGTHINPUT is the input's LENGTH and a wrong
      one leaves the tail where it was ('abcdef', 1 at 4, length 1 → 'abcXYZ'); one past the length moves the bytes
      behind the terminator too ('abcdefghijkl' := 'abc', 3 for 1 at 2, length 12 → 'aXYZghijkl');
   2. the WHOLE of PSTREPLACEWITH is copied over p — its length is not ILENGTHTOREPLACEWITH ('Device.App', 1 for 1 at
      7 → 'DeviceXYZp') — at any position inside the buffer, behind the terminator too.
   Both are cut at UIINPUTBUFFERSIZE - 1, with a terminator there when anything moved. The buffer is read and written
   back whole, up to that size, so what lies behind the terminator is moved as CODESYS moves it in place.
   ponytail: a buffer larger than 255 is not modelled
   A UIINPUTBUFFERSIZE larger than the caller's string is not modelled either: CODESYS reads and writes the bytes behind
   the variable (buf[cap] := 0 lands in the neighbour), the model faults at run time on the first unit past the string's
   capacity. niche: accepted loss (0 occurrences in the corpora: the one caller, pro2193 ParseInstanceName, passes 80 for
   a STRING(80)) *)
IF PSTINPUT = 0 OR PSTREPLACEWITH = 0 OR IPOSITION < 1 THEN
	RETURN;
END_IF
cap := MIN(UINT_TO_DINT(UIINPUTBUFFERSIZE) - 1, 255);
FOR i := 0 TO cap DO
	buf[i] := PSTINPUT^[i];
END_FOR
p := IPOSITION - 1;
cnt := ILENGTHINPUT - p - ILENGTHTOREPLACE + 1;
src := p + ILENGTHTOREPLACE;
dst := p + ILENGTHTOREPLACEWITH;
IF cnt > 0 THEN
	cnt := MIN(cnt, MIN(cap - dst, cap - src));
	IF dst > src THEN
		FOR i := cnt - 1 TO 0 BY -1 DO
			buf[dst + i] := buf[src + i];
		END_FOR
	ELSE
		FOR i := 0 TO cnt - 1 DO
			buf[dst + i] := buf[src + i];
		END_FOR
	END_IF
	buf[cap] := 0;
END_IF
i := 0;
WHILE PSTREPLACEWITH^[i] <> 0 AND p + i < cap DO
	buf[p + i] := PSTREPLACEWITH^[i];
	i := i + 1;
END_WHILE
FOR i := 0 TO cap DO
	PSTINPUT^[i] := buf[i];
END_FOR
END_FUNCTION