FUNCTION HELPSTRCMPSTARTA : BOOL
VAR_INPUT
	PCOMPLETETEXT : CharBufferPtr;
	PSUBTEXT : CharBufferPtr;
	XIGNORECASE : BOOL;
END_VAR
VAR
	i : DINT;
END_VAR
(* does PCOMPLETETEXT begin with PSUBTEXT — every byte of it, in order (case folded when XIGNORECASE) *)
IF PCOMPLETETEXT = 0 OR PSUBTEXT = 0 THEN
	RETURN;
END_IF
WHILE PSUBTEXT[i] <> 0 DO
	IF PCOMPLETETEXT[i] = 0 THEN
		RETURN;
	END_IF
	IF XIGNORECASE THEN
		IF NOT HELPISSAMEIGNORECASE(PCOMPLETETEXT[i], PSUBTEXT[i]) THEN
			RETURN;
		END_IF
	ELSIF PCOMPLETETEXT[i] <> PSUBTEXT[i] THEN
		RETURN;
	END_IF
	i := i + 1;
END_WHILE
HELPSTRCMPSTARTA := TRUE;
END_FUNCTION