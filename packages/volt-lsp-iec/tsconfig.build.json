{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "@tsconfig/node22/tsconfig.json",
  "comment": "Build config: compiles src (minus tests) to dist/. Typecheck uses tsconfig.json (src+test+scripts).",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "module": "nodenext",
    "declaration": true,
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "lib": ["es2022"]
  },
  "include": ["src", "test"],
  "exclude": ["dist", "node_modules", "**/*.test.ts"]
}
