{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "@tsconfig/node22/tsconfig.json",
  "comment": "Build config: compiles src (minus tests) to dist/. Typecheck uses tsconfig.json (src+test+scripts).",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "module": "nodenext",
    "declaration": true,
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "lib": ["es2022"],
    // TS7 defaults `types` to [] (no auto-discovery of @types) — every package must name what it needs.
    "types": ["node"]
  },
  // `src` only: the build compiles what ships (the server entry, `src/server/bin.ts`), never test code — the test
  // helpers use Bun-only APIs and cannot type under `types: ["node"]`. `test/package/build.test.ts` runs this build so
  // `bun test` sees it break.
  "include": ["src"],
  "exclude": ["dist", "node_modules", "**/*.test.ts"]
}
