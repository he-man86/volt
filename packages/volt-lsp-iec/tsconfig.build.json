{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "@tsconfig/node22/tsconfig.json",
  "comment": "Build config: compiles src (minus tests) to dist/. Typecheck uses tsconfig.json (src+test+scripts).",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "module": "nodenext",
    "declaration": true,
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "lib": ["es2022"],
    // TS7 defaults `types` to [] (no auto-discovery of @types) — every package must name what it needs.
    "types": ["node"]
  },
  // `src` and the ONE `test/` file the `./conformance` package export names — the build compiles what the package
  // publishes and what that reaches, never a directory of test code. It used to include all of `test/`, so every
  // test-runner helper beside the export was compiled too: `test/frontend/` (2026-09-30) and `test/conformance/support/`
  // (reached through the generated map's row type) use Bun-only APIs (`import.meta.dir`, `Bun.spawnSync`, `bun:test`)
  // and cannot type under `types: ["node"]` — rightly: `default` is the condition for runtimes that are NOT Bun, so
  // adding "bun" here would publish a dist/ that calls `Bun`. Nothing the export reaches may import a runner helper;
  // the map's row type lives beside the map (`fixtures/map-row.ts`) for exactly that. `src/build.test.ts` runs this
  // build so `bun test` sees it break.
  "include": ["src", "test/conformance/index.ts"],
  "exclude": ["dist", "node_modules", "**/*.test.ts"]
}
