{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "@tsconfig/node22/tsconfig.json",
  "comment": "Build config: compiles src (minus tests) to dist/. Typecheck uses tsconfig.json (src+test+scripts).",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "module": "nodenext",
    "declaration": true,
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "lib": ["es2022"],
    // TS7 defaults `types` to [] (no auto-discovery of @types) — every package must name what it needs.
    "types": ["node"]
  },
  "include": ["src", "test"],
  // `test/` is in because the `./conformance` package export compiles out of it. `support/` is NOT: those are
  // test-RUNNER helpers in the same category as a `*.test.ts`, three of them use Bun-only APIs
  // (`import.meta.dir`, `Bun.spawnSync`), and nothing reachable from `test/conformance/index.ts` imports one.
  // Compiling them under `types: ["node"]` is what broke `bun run build` — and adding "bun" to the build's
  // types instead would have emitted a dist/ that calls `Bun` on the one condition (`default`) that exists
  // precisely for runtimes that are not Bun.
  "exclude": ["dist", "node_modules", "**/*.test.ts", "test/conformance/support"]
}
