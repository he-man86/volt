FUNCTION_BLOCK ASYNCBASECLASS
VAR
	ULTYPE : UDINT;
	ULTOUT : UDINT;
	PJOBPARAMS : POINTER TO ASYNCJOB_PARAM;
END_VAR
END_FUNCTION_BLOCK

METHOD ASYNCREMOVEJOB : RTS_IEC_RESULT
VAR_INPUT
	HJOB : RTS_IEC_HANDLE;
END_VAR
END_METHOD

METHOD ASYNCSETJOBPARAMS : RTS_IEC_RESULT
VAR_INPUT
	ULASYNCJOBTYPE : UDINT;
	ULTIMEOUT : UDINT;
	PASYNCJOBPARAMS : POINTER TO ASYNCJOB_PARAM;
END_VAR
END_METHOD