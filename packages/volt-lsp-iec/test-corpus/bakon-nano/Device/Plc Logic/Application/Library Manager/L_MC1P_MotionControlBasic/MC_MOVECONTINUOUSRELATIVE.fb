FUNCTION_BLOCK MC_MOVECONTINUOUSRELATIVE EXTENDS L_MC1P_Template_Move
VAR_INPUT
	EXECUTE : BOOL;
	CONTINUOUSUPDATE : BOOL;
	DISTANCE : LREAL;
	ENDVELOCITY : LREAL;
	VELOCITY : LREAL;
	ACCELERATION : LREAL;
	DECELERATION : LREAL;
	JERK : LREAL;
	BUFFERMODE : MC_BUFFER_MODE;
END_VAR
VAR_OUTPUT
	INENDVELOCITY : BOOL;
	BUSY : BOOL;
	ACTIVE : BOOL;
	COMMANDABORTED : BOOL;
	ERROR : BOOL;
	ERRORID : L_IE1P_Error;
END_VAR
VAR
	FBMB : L_MC1P_MoveBasic := STRUCT(wCalcProfileMode := 1);
	JERKDEC_INT : LREAL;
	_MCCALL : L_UM1P_MCMultipleCall;
	INPUTDATA : ARRAY [1.._MCCall.c_BufferDepthInput] OF L_MC1P_MoveContinuousRelativeInput;
	OUTPUTDATA : ARRAY [1.._MCCall.c_BufferDepthOutput] OF L_MC1P_MoveContinuousRelativeOutput;
	GETMOVEBASICP : POINTER TO L_MC1P_MoveBasic;
	JERKDEC : LREAL;
END_VAR
END_FUNCTION_BLOCK