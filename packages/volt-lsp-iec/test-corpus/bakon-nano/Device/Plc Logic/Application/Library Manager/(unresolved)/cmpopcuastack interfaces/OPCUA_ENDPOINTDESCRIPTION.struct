TYPE OPCUA_ENDPOINTDESCRIPTION :
STRUCT
	ENDPOINTURL : OpcUa_String;
	SERVER : OpcUa_ApplicationDescription;
	SERVERCERTIFICATE : OpcUa_ByteString;
	SECURITYMODE : OpcUa_MessageSecurityMode;
	SECURITYPOLICYURI : OpcUa_String;
	NOOFUSERIDENTITYTOKENS : OpcUa_Int32;
	USERIDENTITYTOKENS : POINTER TO OpcUa_UserTokenPolicy;
	TRANSPORTPROFILEURI : OpcUa_String;
	SECURITYLEVEL : OpcUa_Byte;
END_STRUCT
END_TYPE