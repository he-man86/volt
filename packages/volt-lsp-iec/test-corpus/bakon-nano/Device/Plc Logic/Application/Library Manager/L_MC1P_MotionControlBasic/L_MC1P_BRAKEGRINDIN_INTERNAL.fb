	FBBASE : L_MC1P_Template_ForAxis;
END_VAR
END_METHOD

METHOD CHECKVALIDPOSITIONLIMITS
VAR_IN_OUT
	AXIS : AXIS_REF;
	FBBASE : L_MC1P_Template_ForAxis;
END_VAR
END_METHOD

METHOD COPYINPUTSFROMAXISREF
VAR_IN_OUT
	SCPARBRAKEGRINDIN : L_MC1P_BrakeCmdBrakeGrindInPara;
	INPUT : L_MC1P_BrakeGrindInInput;
END_VAR
END_METHOD

METHOD GETCYCLESOUT : WORD
VAR_INPUT
	WCYCLESOUT : WORD;
END_VAR
VAR_IN_OUT
	AXIS : AXIS_REF;
END_VAR
END_METHOD

METHOD MAIN
VAR_IN_OUT
	AXIS : AXIS_REF;
	FBBASE : L_MC1P_Template_ForAxis;
	INPUT : L_MC1P_BrakeGrindInInput;
	OUTPUT : L_MC1P_BrakeGrindInOutput;
END_VAR
