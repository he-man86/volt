FUNCTION_BLOCK MC_RESET EXTENDS L_MC1P_Template
VAR_INPUT
	EXECUTE : BOOL;
END_VAR
VAR_OUTPUT
	DONE : BOOL;
	BUSY : BOOL;
	ERROR : BOOL;
	ERRORID : L_IE1P_Error;
END_VAR
VAR
	RESET : L_MC1P_Reset_Internal;
	RESETINPUT : L_MC1P_ResetInput;
	RESETOUTPUT : L_MC1P_ResetOutput;
	_MCCALL : L_UM1P_MCMultipleCall := STRUCT(itfMCCall := THIS^);
	INPUTDATA : ARRAY [1.._MCCall.c_BufferDepthInput] OF L_MC1P_ResetInput;
	OUTPUTDATA : ARRAY [1.._MCCall.c_BufferDepthOutput] OF L_MC1P_ResetOutput;
	POUTPUTDATA : POINTER TO L_MC1P_ResetOutput;
END_VAR
END_FUNCTION_BLOCK