FUNCTION_BLOCK L_UBUP_JOB EXTENDS L_UBUP_PoolInstance
VAR
	_EERRORID : L_IE1P_Error;
	_XABORT : BOOL;
	_XDONE : BOOL;
	_ITFSENDER : L_UBUP_ICommand;
	_ITFREPORT : L_UBUP_IJobReport;
	_ITFPREVJOB : L_UBUP_IJob;
	_ITFNEXTJOB : L_UBUP_IJob;
	_DWCALLID : DWORD := L_UBUP_Internal.g_dwCallIDUnassigned;
	_ECMDID : L_UBUP_ClassID;
	_ESTATE : L_UBUP_JobState;
	_CLIENTPROXY : L_UBUP_StateClientProxy;
	_STATESERVER : L_UBUP_StateServer;
	_DWARRIDX : DWORD;
	_DIREFCOUNTER : DINT;
	_SINSTANCESTR : STRING;
	FB_TRANSITION2ERROR : L_UBUP_RequestTransitionEdge;
	FB_TRANSITION2PENDINGFORWORKING : L_UBUP_RequestTransitionEdge;
	FB_TRANSITION2WORKING : L_UBUP_RequestTransitionEdge;
	FB_TRANSITION2PENDINGFORFINISH : L_UBUP_RequestTransitionEdge;
	FB_TRANSITION2READYFORRELEASE : L_UBUP_RequestTransitionEdge;
	FB_TRANSITION2PREPARERELEASE : L_UBUP_RequestTransitionEdge;
	BLOCKNEXT : BOOL;
	CALLID : DWORD;
	CANCELFINISHNEXT : BOOL;
	CLASSID : DINT;
	CMDID : L_UBUP_ClassID;
	ISAPPEND : BOOL;
	ISBLOCKED : BOOL;
	ISLINKED : BOOL;
	ISREADYFORRELEASE : BOOL;
	ITFCATEGORY : L_UBUP_ICategory;
	ITFJOBACTION : L_UBUP_IJobAction;
	ITFMAPSTATE : L_UBUP_IMapState;
	JOBSTATE : L_UBUP_JobState;
	MAPPRIO : INT;
	MAPSTATE : INT;
	NEXT : L_UBUP_IJob;
	PREV : L_UBUP_IJob;
	REJECTIFABORTED : BOOL;
	REJECTIFPENDING : BOOL;
END_VAR
END_FUNCTION_BLOCK

