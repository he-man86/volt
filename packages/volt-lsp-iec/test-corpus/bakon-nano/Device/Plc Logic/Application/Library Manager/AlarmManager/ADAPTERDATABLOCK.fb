FUNCTION_BLOCK ADAPTERDATABLOCK
VAR_INPUT
	M_PARRITFALARMSFROMHISTORY : POINTER TO ARRAY [0..0] OF IAlarm2;
	M_PARRALARMSGRPFORHISTORY : POINTER TO ARRAY [0..10] OF POINTER TO AlarmGroupAdapter;
	M_PARRALARMSCLFORHISTORY : POINTER TO ARRAY [0..10] OF POINTER TO AlarmClassAdapter;
	M_ICOUNTALARMSFROMHISTORY : INT;
	M_PAITFALARMCONFIGURATIONS : POINTER TO ARRAY [0..0] OF IAlarmConfiguration;
