FUNCTION_BLOCK STRINGVECTOR EXTENDS BaseVector
VAR
	_PARRSTRINGS : POINTER TO ARRAY [0..100] OF STRING(VECTOR_STRING_LEN);
END_VAR
END_FUNCTION_BLOCK

METHOD ADDSTRING : UDINT
VAR_INPUT
	STRVAL : STRING(VECTOR_STRING_LEN);
END_VAR
END_METHOD

METHOD GETSTRING : STRING(VECTOR_STRING_LEN)
VAR_INPUT
	UDIINDEX : UDINT;
END_VAR
VAR_OUTPUT
	UDIRESULT : UDINT;
END_VAR
END_METHOD

METHOD REMOVEAT : UDINT
VAR_INPUT
	UDIINDEX : UDINT;
END_VAR
END_METHOD

METHOD ABSTRASSIGN : UDINT
VAR_INPUT
	PBT : POINTER TO BYTE;
	UDIINDEX : UDINT;
END_VAR
END_METHOD

METHOD ABSTRDATAPTRCHANGED : UDINT
END_METHOD

METHOD ABSTRGETELEMENTPTR : UDINT
VAR_INPUT
	UDIINDEX : UDINT;
END_VAR
VAR_OUTPUT
	PENTRY : POINTER TO BYTE;
END_VAR
END_METHOD

METHOD ABSTRSIZEOFELEMENT : UDINT
END_METHOD