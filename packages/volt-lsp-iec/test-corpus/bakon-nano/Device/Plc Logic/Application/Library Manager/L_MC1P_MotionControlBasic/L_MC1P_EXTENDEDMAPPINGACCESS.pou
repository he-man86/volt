FUNCTION_BLOCK L_MC1P_EXTENDEDMAPPINGACCESS
VAR
	XMAPPINGDATASUPPORT : BOOL;
	IMAPPEDINPUTCOUNT : INT;
	IMAPPEDOUTPUTCOUNT : INT;
	AMAPPEDINPUTS : ARRAY [1..maxMappedObjects] OF L_MC1P_MappedObjects;
	AMAPPEDOUTPUTS : ARRAY [1..maxMappedObjects] OF L_MC1P_MappedObjects;
	MAXMAPPEDOBJECTS : INT := 100;
END_VAR
END_FUNCTION_BLOCK

METHOD GETIECADRESS
VAR_INPUT
	AXISCONNECTOR : POINTER TO IoConfigConnector;
END_VAR
END_METHOD

METHOD GETMAPPEDDATA : POINTER TO BYTE
VAR_INPUT
	UIINDEX : WORD;
	USISUBINDEX : USINT;
	USISIZE : USINT;
	XWRITEACCESS : BOOL;
	PADDDATA : POINTER TO BYTE;
	PXWAITFORINITACCESS : POINTER TO BOOL;
END_VAR
VAR_OUTPUT
	EERRORID : L_IE1P_Error;
	XERROR : BOOL;
	USISIZEACT : USINT := 0;
END_VAR
END_METHOD

METHOD GETMAPPEDDATASUPPORT : BOOL
END_METHOD

METHOD RESETOUTPUTMAPPINGOBJECTS : BOOL
END_METHOD

METHOD SEARCHMAPPEDOBJECT : INT
VAR_INPUT
	DWNUMBER : DWORD;
	ICOUNT : INT;
	PDATA : POINTER TO L_MC1P_MappedObjects;
END_VAR
END_METHOD