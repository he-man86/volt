TYPE L_ECC_SCDEVICEINFO :
STRUCT
	UIDEVICEADDRESS : UINT;
	EDEVICETYPE : L_ECC_eDeviceType := L_ECC_eDeviceType.Unknown;
	SDEVICENAME : STRING(255);
	SHARDWAREVERSION : STRING(64);
	SSOFTWAREVERSION : STRING(64);
	USISYSTEMVERSION : USINT;
	DWVENDORID : DWORD;
	DWPRODUCTCODE : DWORD;
	DWREVISION : DWORD;
	DWSERIALNUMBER : DWORD;
END_STRUCT
END_TYPE