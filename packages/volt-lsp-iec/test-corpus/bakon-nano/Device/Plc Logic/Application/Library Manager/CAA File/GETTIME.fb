	DTLASTMODIFICATION : DATE_AND_TIME;
END_VAR
VAR
	HJOB : CAA.HANDLE;
	PGETTIMEPARAMS : POINTER TO FILE_GETTIME_PARAMS;
	STATEJOB : ASM.STATE;
	GETTIMEPARAMS : FILE_GETTIME_PARAMS;
END_VAR
END_FUNCTION_BLOCK