TYPE PLACEHOLDERDESCRIPTION :
STRUCT
	M_EPLACEHOLDER : EDateTimePlaceholder;
	M_PCBSPLACEHOLDER : POINTER TO CharBufferString;
	M_XCONSIDERPLACEHOLDER : BOOL := TRUE;
	M_PRELATEDPLACEHOLDERISSUBSTRINGOF : POINTER TO PlaceholderDescription;
	M_PRELATEDPLACEHOLDERHASSUBSTRING : POINTER TO PlaceholderDescription;
END_STRUCT
END_TYPE