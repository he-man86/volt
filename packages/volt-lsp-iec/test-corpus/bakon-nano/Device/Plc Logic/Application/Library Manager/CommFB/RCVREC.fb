FUNCTION_BLOCK RCVREC
VAR_INPUT
	EN : BOOL;
	MODE : UINT;
	F_ID : DWORD;
	MLEN : UINT;
	CODE1 : BYTE;
	CODE2 : BYTE;
	RECORD : POINTER TO BYTE;
END_VAR
VAR_OUTPUT
	ENO : BOOL;
	NEW : BOOL;
	STATUS : DWORD;
	SLOT : UINT;
	SUBSLOT : UINT;
	INDEX : UINT;
	LEN : UINT;
END_VAR
VAR
	S_INSTANCEHANDLER : InstanceHandler;
	_STATE : RCVREC_State := RCVREC_State.S1_INIT;
	_DEVICE : ICommFBFieldDevice;
	_WRITEIND : Write_Ind;
	EMPTYIND : Write_Ind;
	I : DINT;
END_VAR
END_FUNCTION_BLOCK