FUNCTION_BLOCK DATEFORMATTER EXTENDS AbstractFormatter
VAR
	M_CBSPLACEHOLDER2DIGITDAY : CharBufferString;
	M_CBSPLACEHOLDER1DIGITDAY : CharBufferString;
	M_CBSPLACEHOLDER2DIGITMONTH : CharBufferString;
	M_CBSPLACEHOLDER1DIGITMONTH : CharBufferString;
	M_CBSPLACEHOLDER4DIGITYEAR : CharBufferString;
	M_CBSPLACEHOLDER2DIGITYEAR : CharBufferString;
	M_CBSPLACEHOLDER1DIGITYEAR : CharBufferString;
END_VAR
END_FUNCTION_BLOCK

METHOD FB_EXIT : BOOL
VAR_INPUT
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD FB_INIT : BOOL
VAR_INPUT
	BINITRETAINS : BOOL;
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD FORMAT : STRING
VAR_INPUT
	PDATE : SYSTIMEDATE;
END_VAR
END_METHOD

METHOD SETFORMATSTRING
VAR_INPUT
	SFORMATSTRING : STRING(MAX_FORMAT_STRING_LENGTH);
END_VAR
END_METHOD