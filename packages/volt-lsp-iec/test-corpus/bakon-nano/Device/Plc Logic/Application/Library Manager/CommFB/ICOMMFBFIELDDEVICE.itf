INTERFACE ICOMMFBFIELDDEVICE
END_INTERFACE

METHOD ALARMREQ : DWORD
VAR_INPUT
	ALARMSENDER : ICommFBAlarmSender;
	ID : DWORD;
	ATYPE : UINT;
	ASPEC : UINT;
	LEN : UINT;
	AINFO : POINTER TO BYTE;
END_VAR
END_METHOD

METHOD CHECKREADIND : BOOL
VAR_INPUT
	MODE : UINT;
	F_ID : DWORD;
END_VAR
VAR_OUTPUT
	STATUS : DWORD;
	IND : Read_Ind;
END_VAR
END_METHOD

METHOD CHECKWRITEIND : BOOL
VAR_INPUT
	MODE : UINT;
	F_ID : DWORD;
END_VAR
VAR_OUTPUT
	STATUS : DWORD;
	IND : Write_Ind;
END_VAR
END_METHOD

METHOD READNEGRSP : DWORD
VAR_INPUT
	CODE1 : BYTE;
	CODE2 : BYTE;
END_VAR
VAR_IN_OUT
	IND : Read_Ind;
END_VAR
END_METHOD

METHOD READRSP : DWORD
VAR_INPUT
	LEN : UINT;
	RECORD : POINTER TO BYTE;
END_VAR
VAR_IN_OUT
	IND : Read_Ind;
END_VAR
END_METHOD

METHOD WRITENEGRSP : DWORD
VAR_INPUT
	CODE1 : BYTE;
	CODE2 : BYTE;
END_VAR
VAR_IN_OUT
	IND : Write_Ind;
END_VAR
END_METHOD

METHOD WRITERSP : DWORD
VAR_IN_OUT
	IND : Write_Ind;
END_VAR
END_METHOD