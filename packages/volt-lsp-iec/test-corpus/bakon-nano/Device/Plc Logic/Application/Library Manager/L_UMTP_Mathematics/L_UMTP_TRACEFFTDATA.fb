FUNCTION_BLOCK L_UMTP_TRACEFFTDATA
VAR_INPUT
	ITFFFTDATA : L_UMTP_IFFTData;
	XEXECUTE : BOOL;
	XABORT : BOOL;
END_VAR
VAR_OUTPUT
	XDONE : BOOL;
	XBUSY : BOOL;
	XACTIVE : BOOL;
	XCOMMANDABORTED : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	LRINPUTMAGNITUDE : LREAL;
	LRINPUTPHASE : LREAL;
	LROUTPUTMAGNITUDE : LREAL;
	LROUTPUTPHASE : LREAL;
	DWACTINDEX : DWORD;
	STRFORMATED : STRING(255);
END_VAR
VAR
	_ITFLOCKABLE : L_UBUP_ILockable;
	_MODEL : L_UBUP_BehaviourModel_ETrigA;
END_VAR
END_FUNCTION_BLOCK

METHOD CYCLICACTION
