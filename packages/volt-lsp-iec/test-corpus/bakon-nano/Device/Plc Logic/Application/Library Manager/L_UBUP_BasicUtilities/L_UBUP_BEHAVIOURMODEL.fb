FUNCTION_BLOCK L_UBUP_BEHAVIOURMODEL
VAR_INPUT
	XCONTROL : BOOL;
	XABORT : BOOL;
	UDITIMELIMIT : SYSTIME;
	UDITIMEOUT : SYSTIME;
END_VAR
VAR_OUTPUT
	XDONE : BOOL;
	XBUSY : BOOL;
	XABORTED : BOOL;
	XERROR : BOOL;
	IERRORID : INT;
END_VAR
VAR
	ITFAP : L_UBUP_IActionProvider;
	ITFTC : L_UBUP_ITimingController;
	ITFADR : L_UBUP_IAllocPointAdrProvider;
	ITFMAP : L_UBUP_IMapOutputsProvider;
	_ESTATE : L_UBUP_BehaviourModelState := L_UBUP_BehaviourModelState.DORMANT;
	_IERRORIDPROPOSED : INT;
	_XRESETREQUEST : BOOL;
	BEHAVIOURMODELTYPE : L_UBUP_BehaviourModelType;
END_VAR
END_FUNCTION_BLOCK

