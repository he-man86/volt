FUNCTION_BLOCK L_UBUP_JOBEXECUTER EXTENDS L_UBUP_MemoryProvider
VAR_INPUT
	XFINISH : BOOL;
	XABORT : BOOL;
	XCLEAR : BOOL;
END_VAR
VAR
	C_DWMAXJOBSEXECUTED : DWORD := 200;
	_ALISTNODES : ARRAY [1..c_dwMaxJobsExecuted] OF L_UBUP_ListNode;
	_AJOBS : ARRAY [1..c_dwMaxJobsExecuted] OF L_UBUP_IJob;
	_JOBLISTCONTROL : L_UBUP_DoubleLinkedListControl;
	_DWARRIDX : DWORD;
	_EACTUALSTATE : L_UBUP_JobState;
	_EERRORID : L_IE1P_Error;
	_XFINISH_TRIG : R_Trig;
	_XABORT_TRIG : R_Trig;
	_XCLEAR_TRIG : R_Trig;
	_ITFJOBTEMP : L_UBUP_IJob;
	_XREMOVELAST : BOOL;
	_ITFJOBRECEIVERMONITOR : L_UBUP_IJobReceiverListener;
	ITFITERATOR : L_UBUP_IIterator;
	ITFLISTCONTROL : L_UBUP_IListControl;
	PTR : POINTER TO BYTE;
	SIZE : UDINT;
END_VAR
END_FUNCTION_BLOCK

METHOD GETJOB : BOOL
VAR_INPUT
	DWARRIDX : DWORD;
END_VAR
VAR_OUTPUT
	ITFJOB : L_UBUP_IJob;
END_VAR
END_METHOD

METHOD ANNOUNCELISTENER : BOOL
VAR_INPUT
	ITFLISTENER : L_UBUP_IJobReceiverListener;
END_VAR
END_METHOD

METHOD INSERT : BOOL
VAR_INPUT
	ITFJOB : L_UBUP_IJob;
END_VAR
END_METHOD

METHOD UNPLUGLISTENER : BOOL
VAR_INPUT
	ITFLISTENER : L_UBUP_IJobReceiverListener;
END_VAR
END_METHOD

METHOD REQUESTINTERFACE : BOOL
VAR_INPUT
	ID : DINT;
	PITFUNKNOWN : POINTER TO L_UBUP_IUnknown;
END_VAR
END_METHOD

METHOD FB_INIT : BOOL
VAR_INPUT
	BINITRETAINS : BOOL;
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD