FUNCTION_BLOCK L_MC2P_WRITELMDFILE
VAR
	TEST1 : BOOL;
	TEST2 : BOOL;
	TEST3 : BOOL;
	TEST4 : BOOL;
	SFILE_INT : STRING := '';
	EDATA_INT : L_MC2P_LMData;
	PDATA_INT : POINTER TO BYTE;
	WDATAELEMENTS_INT : WORD;
	XENABLEONLINECHANGE_INT : BOOL;
	XBUSY_INT : BOOL;
	XDONE_INT : BOOL;
	XERROR_INT : BOOL;
	EERRORID_INT : L_IE1P_Error;
	XEXECUTEOLD : BOOL;
	HFILE : SYSFILE.RTS_IEC_HANDLE;
	RES : SYSFILE.RTS_IEC_RESULT;
	ID : L_MC2P_Magic;
	DWLENGTH : DWORD;
	XACTIVECRYPTING : BOOL;
	CRYPT : Crypting;
	CK : ARRAY [0..3] OF ULINT;
	CCYCLES : WORD;
	DICDATAWRITE : DINT;
	DWSTARTCDATA : DWORD;
	ABDATA : ARRAY [0..15] OF BYTE;
	DATAIDX : DWORD;
	AVAILABLEDATA : DWORD;
	XDATAWRITEDONE : BOOL;
	UDIFSIZE : UDINT;
	UDIFBYTESWRITE : UDINT;
	RELOAD : BOOL;
END_VAR
END_FUNCTION_BLOCK