FUNCTION_BLOCK L_IMHP_GETMODULEINFO
VAR_INPUT
	MODULEHANDLER : L_IMHP_IModuleHandler;
END_VAR
VAR_OUTPUT
	SNAME : STRING;
	ELAYER : L_IMHP_Layer := L_IMHP_Layer.Tech_Application;
	ECOMPTYPE : L_IMHP_ComponentType := L_IMHP_ComponentType.GeneralApplicationModule;
	XCOMPACTIVE : BOOL;
	WCHILDCOUNT : WORD;
END_VAR
VAR
	MODULEINFO : L_IMHP_ModuleInfo;
	MODULEHANDLERINT : L_IMHP_IModuleHandler;
END_VAR
END_FUNCTION_BLOCK