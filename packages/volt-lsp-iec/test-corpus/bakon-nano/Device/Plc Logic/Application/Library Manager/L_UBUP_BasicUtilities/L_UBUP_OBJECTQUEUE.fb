FUNCTION_BLOCK L_UBUP_OBJECTQUEUE
VAR
	FBSTART : L_UBUP_Object;
	FBFEND : L_UBUP_Object;
	ITFSTART : L_UBUP_IObject := fbStart;
	ITFEND : L_UBUP_IObject := fbfEnd;
	COUNT : DWORD;
	END : L_UBUP_IObject;
	ISEMPTY : BOOL;
	START : L_UBUP_IObject;
END_VAR
END_FUNCTION_BLOCK

METHOD DEQUEUE : BOOL
END_METHOD

METHOD ENQUEUE : BOOL
VAR_INPUT
	ITFOBJECT : L_UBUP_IObject;
END_VAR
END_METHOD

METHOD REMOVE : BOOL
VAR_INPUT
	ITFOBJECT : L_UBUP_IObject;
END_VAR
END_METHOD

METHOD REQUESTINTERFACE : BOOL
VAR_INPUT
	ID : DINT;
	PITFUNKNOWN : POINTER TO L_UBUP_IUnknown;
END_VAR
END_METHOD

METHOD FB_INIT : BOOL
VAR_INPUT
	BINITRETAINS : BOOL;
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD