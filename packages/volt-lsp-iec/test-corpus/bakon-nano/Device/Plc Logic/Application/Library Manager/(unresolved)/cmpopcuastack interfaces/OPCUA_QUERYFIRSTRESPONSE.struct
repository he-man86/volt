	CONTINUATIONPOINT : OpcUa_ByteString;
	NOOFPARSINGRESULTS : OpcUa_Int32;
	PARSINGRESULTS : POINTER TO OpcUa_ParsingResult;
	NOOFDIAGNOSTICINFOS : OpcUa_Int32;
	DIAGNOSTICINFOS : POINTER TO OpcUa_DiagnosticInfo;
	FILTERRESULT : OpcUa_ContentFilterResult;
END_STRUCT
END_TYPE