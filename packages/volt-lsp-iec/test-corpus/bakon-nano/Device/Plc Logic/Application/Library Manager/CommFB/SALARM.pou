FUNCTION_BLOCK SALARM
VAR_INPUT
	REQ : BOOL;
	ID : DWORD;
	ATYPE : UINT;
	ASPEC : UINT;
	LEN : UINT;
	AINFO : POINTER TO BYTE;
END_VAR
VAR_OUTPUT
	DONE : BOOL;
	BUSY : BOOL;
	ERROR : BOOL;
	STATUS : DWORD;
END_VAR
VAR
	S_INSTANCEHANDLER : InstanceHandler;
	_REQ : BOOL;
	_STATE : SALRM_State := SALRM_State.S1_INIT;
	SEND_RESULT : UDINT;
	_DEVICE : ICommFBFieldDevice;
	_CLIENT : AlarmSenderInternal;
	_ERROR : DWORD;
	_CONTINUE : BOOL;
END_VAR
END_FUNCTION_BLOCK

METHOD ALARMCNF
VAR_INPUT
	ERROR : DWORD;
END_VAR
END_METHOD

METHOD NEG_RESPONSE
VAR_INPUT
	ERROR : DWORD;
END_VAR
END_METHOD

METHOD POS_RESPONSE
END_METHOD