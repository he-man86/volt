FUNCTION_BLOCK L_UBUP_FBPOOLCOLLECTION
VAR
	_AITFFBPOOL : ARRAY [1..c_dwMaxPools] OF L_UBUP_IFBPool;
	C_DWMAXPOOLS : DWORD := 10;
END_VAR
END_FUNCTION_BLOCK

METHOD REGISTERPOOL : BOOL
VAR_INPUT
	ITFFBPOOL : L_UBUP_IFBPool;
END_VAR
END_METHOD

METHOD FREEINSTANCE : BOOL
VAR_INPUT
	ITFINSTANCE : L_UBUP_IPoolInstance;
	XWHANDLE : __XWORD;
END_VAR
END_METHOD

METHOD GETCAPACITY : BOOL
VAR_INPUT
	ECLASSID : DINT;
END_VAR
VAR_OUTPUT
	DWCAPACITY : DWORD;
END_VAR
END_METHOD

METHOD QUERYINSTANCE : BOOL
VAR_INPUT
	ECLASSID : DINT;
END_VAR
VAR_IN_OUT
	ITFINSTANCE : L_UBUP_IPoolInstance;
END_VAR
END_METHOD