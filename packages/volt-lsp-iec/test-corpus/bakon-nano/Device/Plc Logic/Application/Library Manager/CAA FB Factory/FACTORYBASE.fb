FUNCTION_BLOCK FACTORYBASE
VAR
	_HPOOL : CAA.HANDLE;
	_ITFINSTLIST : IInstance;
	_HPOOLSYNC : RTS_IEC_HANDLE := RTS_INVALID_HANDLE;
	_HLISTSYNC : RTS_IEC_HANDLE := RTS_INVALID_HANDLE;
	PRVINSTCOUNT : CAA.COUNT;
	PRVINSTPOOLADR : CAA.PVOID;
	PRVINSTPOOLEXTENDSFACTOR : USINT;
	PRVINSTPOOLSIZE : CAA.SIZE;
	PRVINSTSIZE : CAA.SIZE;
END_VAR
END_FUNCTION_BLOCK

METHOD FB_EXIT : BOOL
VAR_INPUT
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD FB_INIT : BOOL
VAR_INPUT
	BINITRETAINS : BOOL;
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD PRVALLOCINSTMEM : CAA.HANDLE
VAR_OUTPUT
	EERROR : ERROR;
END_VAR
END_METHOD

METHOD PRVFREEINSTMEM : BOOL
VAR_INPUT
	HINST : CAA.HANDLE;
END_VAR
END_METHOD

METHOD PRVGETINSTPOINTER : CAA.PVOID
VAR_INPUT
	HINST : CAA.HANDLE;
END_VAR
END_METHOD

METHOD PRVINSERTINST : BOOL
VAR_INPUT
	ITFINST : IInstance;
END_VAR
END_METHOD

METHOD PRVINSTINIT : BOOL
VAR_INPUT
	ITFINST : IInstance;
	HINST : CAA.HANDLE;
	ITFDATA : IData;
END_VAR
VAR_OUTPUT
