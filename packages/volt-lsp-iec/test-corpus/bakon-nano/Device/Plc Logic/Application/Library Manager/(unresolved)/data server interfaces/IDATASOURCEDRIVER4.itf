	PITEMS : POINTER TO ARRAY [0..100] OF IDataItem;
	IITEMCOUNTTOTAL : UDINT;
	ISTARTOFFSET : UDINT;
	DWLISTID : DWORD;
END_VAR
VAR_OUTPUT
	DWTRANSACTIONID : DWORD;
