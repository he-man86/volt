FUNCTION_BLOCK L_UMTP_NUMERCALJACOBI
VAR_INPUT
	IFUNC : L_UMTP_Func_ND2MD;
	CONTEXT : UDINT;
	UDIXDIM : UDINT;
	UDIYDIM : UDINT;
	ALRAT : ARRAY [1..10] OF LREAL;
END_VAR
VAR
	ALRMAT : ARRAY [1..(10 * 10)] OF LREAL;
	I : UDINT;
	J : UDINT;
	ALRPOS : ARRAY [1..10] OF LREAL;
	ALRYFWD : ARRAY [1..10] OF LREAL;
	ALRYBWD : ARRAY [1..10] OF LREAL;
	H : LREAL := 1E-06;
	COLS : UDINT;
	PTR : POINTER TO LREAL;
	ROWS : UDINT;
END_VAR
END_FUNCTION_BLOCK

METHOD GETVALUE : LREAL
VAR_INPUT
	I : UDINT;
	J : UDINT;
END_VAR
END_METHOD

METHOD SETVALUE
VAR_INPUT
	I : UDINT;
	J : UDINT;
	VALUE : LREAL;
END_VAR
END_METHOD