TYPE OPCUA_CREATESESSIONRESPONSE :
STRUCT
	RESPONSEHEADER : OpcUa_ResponseHeader;
	SESSIONID : OpcUa_NodeId;
	AUTHENTICATIONTOKEN : OpcUa_NodeId;
	REVISEDSESSIONTIMEOUT : OpcUa_Double;
	SERVERNONCE : OpcUa_ByteString;
	SERVERCERTIFICATE : OpcUa_ByteString;
	NOOFSERVERENDPOINTS : OpcUa_Int32;
	SERVERENDPOINTS : POINTER TO OpcUa_EndpointDescription;
	NOOFSERVERSOFTWARECERTIFICATES : OpcUa_Int32;
	SERVERSOFTWARECERTIFICATES : POINTER TO OpcUa_SignedSoftwareCertificate;
	SERVERSIGNATURE : OpcUa_SignatureData;
	MAXREQUESTMESSAGESIZE : OpcUa_UInt32;
END_STRUCT
END_TYPE