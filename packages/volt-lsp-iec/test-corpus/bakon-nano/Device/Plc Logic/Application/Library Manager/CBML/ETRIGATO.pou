FUNCTION_BLOCK ETRIGATO EXTENDS EdgeTriggeredTimingControlledBehaviourModelBase
VAR_INPUT
	XEXECUTE : BOOL;
	XABORT : BOOL;
	UDITIMEOUT : UDINT;
END_VAR
VAR_OUTPUT
	XDONE : BOOL;
	XBUSY : BOOL;
	XERROR : BOOL;
	XABORTED : BOOL;
END_VAR
VAR
	MODELTIMEOUT : UDINT;
END_VAR
END_FUNCTION_BLOCK

METHOD _EXECUTE
VAR_OUTPUT
	EERRORID : ERROR;
END_VAR
END_METHOD

METHOD ABORTMODEL : ERROR
VAR_INPUT
	XCOMMIT : BOOL;
END_VAR
END_METHOD

METHOD GETMODELSTATE
VAR_INPUT
	XCOMMIT : BOOL;
END_VAR
VAR_OUTPUT
	XDONE : BOOL;
	XBUSY : BOOL;
	XERROR : BOOL;
	XABORTED : BOOL;
	IERRORID : INT;
	ESTATE : STATE;
END_VAR
END_METHOD

METHOD RESETMODEL : ERROR
VAR_INPUT
	XCOMMIT : BOOL;
END_VAR
END_METHOD

METHOD STARTMODEL : ERROR
VAR_INPUT
	XCOMMIT : BOOL;
END_VAR
END_METHOD