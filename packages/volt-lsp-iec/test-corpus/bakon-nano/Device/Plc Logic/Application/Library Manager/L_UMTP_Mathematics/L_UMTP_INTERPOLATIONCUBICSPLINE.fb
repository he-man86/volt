FUNCTION_BLOCK L_UMTP_INTERPOLATIONCUBICSPLINE EXTENDS L_UMTP_InterpolationBase
VAR_INPUT
	EINTERPOLATIONTYPE : L_UMTP_InterpolationType := L_UMTP_InterpolationType.CubicSplineHermite;
	LRSLOPE0 : LREAL;
	LRSLOPEN : LREAL;
END_VAR
VAR
	ALRSPLINECOEFFS : ARRAY [0..(L_UMTP_Constants.gc_udiMaxCubSplinePts - 2)] OF ARRAY [1..4] OF LREAL;
	ALRH : ARRAY [0..(L_UMTP_Constants.gc_udiMaxCubSplinePts - 2)] OF LREAL;
	ALRINVH : ARRAY [0..(L_UMTP_Constants.gc_udiMaxCubSplinePts - 2)] OF LREAL;
	ALRX : ARRAY [0..(L_UMTP_Constants.gc_udiMaxCubSplinePts - 1), 1..1] OF LREAL;
	ALRA : ARRAY [0..(L_UMTP_Constants.gc_udiMaxCubSplinePts - 1), 1..3] OF LREAL;
	ALRD : ARRAY [0..(L_UMTP_Constants.gc_udiMaxCubSplinePts - 1), 1..1] OF LREAL;
	EINTERPOLATIONTYPEINT : L_UMTP_InterpolationType;
	INTERPOLATIONTYPE : L_UMTP_InterpolationType;
END_VAR
END_FUNCTION_BLOCK