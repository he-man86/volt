FUNCTION_BLOCK L_UBUP_JOBPOOLQUEUE
VAR
	C_DWCAPACITY : DWORD := 100;
	FBQUEUE : L_UBUP_QueueArrayControl;
	_ALISTENELEMENT : ARRAY [1..c_dwCapacity] OF L_UBUP_IFBPool;
END_VAR
END_FUNCTION_BLOCK

METHOD REGISTERPOOL : BOOL
VAR_INPUT
	ITFJOBPOOL : L_UBUP_IFBPool;
END_VAR
END_METHOD

METHOD GETCAPACITY : BOOL
VAR_INPUT
	ECLASSID : L_UBUP_ClassID;
END_VAR
VAR_OUTPUT
	ITFJOBPOOL : L_UBUP_IFBPool;
	DWCAPACITY : DWORD;
END_VAR
END_METHOD

METHOD QUERYINSTANCE : BOOL
VAR_INPUT
	ECLASSID : DINT;
END_VAR
VAR_OUTPUT
	ITFJOBPOOL : L_UBUP_IFBPool;
END_VAR
VAR_IN_OUT
	ITFINSTANCE : L_UBUP_IPoolInstance;
END_VAR
END_METHOD