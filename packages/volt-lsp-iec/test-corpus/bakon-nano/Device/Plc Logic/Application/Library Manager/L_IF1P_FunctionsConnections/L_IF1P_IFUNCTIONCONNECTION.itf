INTERFACE L_IF1P_IFUNCTIONCONNECTION
END_INTERFACE

METHOD CONNECTDEVICE : UINT
VAR_INPUT
	DEVICEMODULEHANDLER : L_IMHP_IModuleHandler;
	UISUBDEVICE : UINT := 0;
	EDISCONNECTMODE : L_IF1P_DisconnectMode;
	XDISCONNECTEXISTINGCONNECTION : BOOL;
END_VAR
VAR_OUTPUT
	ITFCONNECTIONFBSTATUS : L_IF1P_IStatus;
END_VAR
END_METHOD

METHOD DISCONNECTDEVICE : UINT
VAR_INPUT
	EDISCONNECTMODE : L_IF1P_DisconnectMode;
	XBUSYBEFORE : BOOL;
END_VAR
VAR_OUTPUT
	ITFCONNECTIONFBSTATUS : L_IF1P_IStatus;
END_VAR
END_METHOD

METHOD GEFUNCTIONTINSTANCEPOINTER : POINTER TO BYTE
END_METHOD

METHOD GETCONNECTEDDEVICE : L_IMHP_IModuleHandler
VAR_OUTPUT
	UISUBDEVICE : UINT;
	XVALID : BOOL;
	ITFCONNECTIONFBSTATUS : L_IF1P_IStatus;
END_VAR
END_METHOD

METHOD GETCONNECTIONDIAGNOSTIC
VAR_OUTPUT
	WUSEDBY_COMP : WORD;
	WUSEDBY_SUBCOMP : WORD;
	WACTIVEMODE : WORD;
	WSUBDEVICE : WORD;
	SCONNECTIONSOURE : STRING;
END_VAR
END_METHOD