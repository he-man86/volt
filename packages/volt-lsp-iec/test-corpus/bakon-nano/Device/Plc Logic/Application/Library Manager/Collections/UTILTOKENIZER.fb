FUNCTION_BLOCK UTILTOKENIZER
VAR
	_PSTRTOTOKENIZE : POINTER TO STRING;
	_PSTRTOTOKENIZEASBYTES : POINTER TO BYTE;
	_STRDELIMS : STRING;
	_INUMDELIMS : INT;
	_ICURRENTPOS : INT;
	_ISTRTOTOKENIZELEN : DINT;
	CURRENTPOSITION : INT;
END_VAR
END_FUNCTION_BLOCK

METHOD INITIALIZE : BOOL
VAR_INPUT
	PSTR : POINTER TO STRING;
	STRDELIMS : STRING;
END_VAR
END_METHOD

METHOD NEXTTOKEN : STRING(256)
VAR_OUTPUT
	BEND : BOOL;
	ITOKENSTARTOFFSET : DINT;
	ITOKENENDOFFSET : DINT;
END_VAR
END_METHOD