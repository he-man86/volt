INTERFACE L_TS2P_IFLEXCAM
END_INTERFACE

METHOD CAM
VAR_INPUT
	ITFTECHMODULE : L_TS2P_IFlexCam;
	XENABLE : BOOL;
	XSYNCCAM : BOOL;
	SCCAMTABLE : MC_CAM_REF;
	LRCYCMASTERPOS : LREAL;
	LRCYCMASTERVEL : LREAL;
	LRCYCMASTERACC : LREAL;
	LRSLAVEPOS : LREAL;
	LRSLAVEVEL : LREAL;
	LRSLAVEACC : LREAL;
	EOFFSETMODEMASTER : L_TS2P_OffsetMode := L_TS2P_OffsetMode.x_zero;
	ESCALINGMODEMASTER : L_TS2P_ScalingMode := L_TS2P_ScalingMode.x_zero;
	EOFFSETMODESLAVE : L_TS2P_OffsetMode := L_TS2P_OffsetMode.x_zero;
	ESCALINGMODESLAVE : L_TS2P_ScalingMode := L_TS2P_ScalingMode.x_zero;
	LRSETOFFSETMASTER : LREAL;
	LRSETOFFSETSLAVE : LREAL;
	LRSETSCALINGMASTER : LREAL;
	LRSETSCALINGSLAVE : LREAL;
	LRPROFGENMASTERVEL : LREAL;
	LRPROFGENMASTERACC : LREAL;
	LRPROFGENMASTERDEC : LREAL;
	LRPROFGENMASTERJERK : LREAL;
	LRPROFGENSLAVEVEL : LREAL;
	LRPROFGENSLAVEACC : LREAL;
	LRPROFGENSLAVEDEC : LREAL;
	LRPROFGENSLAVEJERK : LREAL;
	XPERIODIC : BOOL;
	XCAMCHANGEINSTANT : BOOL;
	XMASTERABSOLUTE : BOOL;
	XSLAVEABSOLUTE : BOOL;
END_VAR
VAR_OUTPUT
	XERROR : BOOL;
	EERRORID : L_IE1P.L_IE1P_Error;
	LRSETPOSOUT : LREAL;
	LRSETVELOUT : LREAL;
	LRSETACCOUT : LREAL;
	LRSETXPOSOUT : LREAL;
	LRSETXVELOUT : LREAL;
	LRSETXACCOUT : LREAL;
	LRSETYPOSOUT : LREAL;
	LRSETYVELOUT : LREAL;
	LRSETYACCOUT : LREAL;
	XENDOFPROFILE : BOOL;
	LRSETOFFSETMASTEROUT : LREAL;
	LRSETOFFSETSLAVEOUT : LREAL;
	LRCONVERTMASTERTOXPOS : LREAL;
	LRCAMPROFILERPOSOUT : LREAL;
	LRCONVERTYTOSLAVEPOS : LREAL;
	XDONE : BOOL;
	XBUSY : BOOL;
END_VAR
END_METHOD

METHOD CAMSEQUENCER
VAR_INPUT
	ITFTECHMODULE : L_TS2P_IFlexCam;
	XENABLE : BOOL;
	XCAMSEQUENCER : BOOL;
	XENDOFPROFILEIN : BOOL;
	CAMTABLE1 : MC_CAM_REF;
	CAMTABLE2 : MC_CAM_REF;
	CAMTABLE3 : MC_CAM_REF;
	CAMTABLE4 : MC_CAM_REF;
	XCAMCHANGEINSTANT : BOOL;
	XLOADCAMTABLE : BOOL;
	WSETCAMTABLE : WORD;
	EMODE : L_TS2P_CamSequenceMode := L_TS2P_CamSequenceMode.CyclicCam1;
END_VAR
VAR_OUTPUT
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	CAMTABLEOUT : MC_CAM_REF;
	XCAMTABLEVALID : BOOL;
END_VAR
END_METHOD

METHOD CLUTCH
VAR_INPUT
	ITFTECHMODULE : L_TS2P_IFlexCam;
	XENABLE : BOOL;
	XCLUTCHCLOSE : BOOL;
	ECLUTCHINMODE : L_TS2P_ClutchInMode;
	ECLUTCHOUTMODE : L_TS2P_ClutchOutMode;
	EALLOWEDDIRECTION : L_TB2P_AllowedDirection;
	LRCLUTCHINDIST : LREAL;
	LRCLUTCHOUTDIST : LREAL;
	LRCLUTCHOUTPOSITION : LREAL;
	LRCYCLICMASTERPOS : LREAL;
	LRCYCLICMASTERVEL : LREAL;
	LRCYCLICMASTERACC : LREAL;
	LRCYCLICAXISPOS : LREAL;
	LRCYCLICAXISVEL : LREAL;
	LRCYCLICAXISACC : LREAL;
	ETRAVERSINGRANGE : L_MC1P_TraversingRange;
	LRCYCLELENGTH : LREAL;
END_VAR
VAR_OUTPUT
	XERROR : BOOL;
	EERRORID : L_IE1P.L_IE1P_Error;
	XBUSY : BOOL;
	XDONE : BOOL;
	XSYNCHRONISED : BOOL;
	XACCDECSYNC : BOOL;
	LRSETPOSOUT : LREAL;
	LRSETVELOUT : LREAL;
	LRSETACCOUT : LREAL;
END_VAR
END_METHOD

METHOD HALT : BOOL
VAR_INPUT
	ITFTECHMODULE : L_TS2P_IFlexCam;
	XEXECUTE : BOOL;
	LRDEC : LREAL := 100;
	LRJERK : LREAL := 0;
END_VAR
VAR_OUTPUT
	XBUSY : BOOL;
	XDONE : BOOL;
	XCOMMANDABORTED : BOOL;
END_VAR
VAR_IN_OUT
	AXIS : AXIS_REF;
END_VAR
END_METHOD

METHOD MOVETOPARKPOS : BOOL
VAR_INPUT
	ITFTECHMODULE : L_TS2P_IFlexCam;
	XEXECUTEMOVETOPARKPOS : BOOL;
	EMOVETOPARKPOSMODE : L_TS2P_CamStopMode;
	LRPARKPOSITION : LREAL := 180;
	EPOSITIONINGDIRECTION : L_TS2P_SyncDirection := L_TS2P_SyncDirection.PositiveDirection;
	LRPOSITIONINGVEL : LREAL := 10;
	LRPOSITIONINGACC : LREAL := 100;
	LRPOSITIONINGDEC : LREAL := 100;
	LRJERK : LREAL := 0;
END_VAR
VAR_OUTPUT
	XBUSY : BOOL;
	XDONE : BOOL;
	XCOMMANDABORTED : BOOL;
END_VAR
VAR_IN_OUT
	AXIS : AXIS_REF;
END_VAR
END_METHOD

METHOD POSITIONFOLLOWER
VAR_INPUT
	ITFTECHMODULE : L_TS2P_IFlexCam;
	XENABLE : BOOL;
	LRPOSITION : LREAL;
	LRVELOCITY : LREAL;
	LRACCELERATION : LREAL;
	ESETVALUEMODE : L_MC1P_SetValueMode;
END_VAR
VAR_OUTPUT
	XERROR : BOOL;
	EERRORID : L_IE1P.L_IE1P_Error;
	XBUSY : BOOL;
END_VAR
END_METHOD

METHOD SYNCIN
VAR_INPUT
	ITFTECHMODULE : L_TS2P_IFlexCam;
	XENABLE : BOOL;
	XSYNCIN : BOOL;
	XSYNCPOSRESTORE : BOOL;
	ESYNCMODE : L_TS2P_SyncInMode;
	ESYNCDIRECTION : L_TS2P_SyncDirection;
	LRSYNCVEL : LREAL;
	LRSYNCACC : LREAL;
	LRSYNCDEC : LREAL;
	LRSYNCJERK : LREAL;
	LRPARKPOSITION : LREAL;
	LRCYCLICMASTERPOS : LREAL;
	LRCYCLICMASTERVEL : LREAL;
	LRCYCLICMASTERACC : LREAL;
	LRCYCLICAXISPOS : LREAL;
	LRCYCLICAXISVEL : LREAL;
	LRCYCLICAXISACC : LREAL;
END_VAR
VAR_OUTPUT
	XERROR : BOOL;
