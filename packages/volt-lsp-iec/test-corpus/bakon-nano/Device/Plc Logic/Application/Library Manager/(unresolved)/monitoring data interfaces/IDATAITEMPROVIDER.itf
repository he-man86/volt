INTERFACE IDATAITEMPROVIDER
END_INTERFACE

METHOD GETWRITEITEMS : UDINT
VAR_OUTPUT
	PITEMS : POINTER TO ARRAY [0..100] OF IDataItem;
	IITEMCOUNT : DINT;
END_VAR
END_METHOD

METHOD GETREADITEMS : UDINT
VAR_OUTPUT
	PITEMS : POINTER TO ARRAY [0..100] OF IDataItem;
	IITEMCOUNT : DINT;
END_VAR
END_METHOD