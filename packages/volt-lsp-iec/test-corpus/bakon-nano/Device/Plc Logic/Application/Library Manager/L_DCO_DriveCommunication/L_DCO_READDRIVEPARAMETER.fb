FUNCTION_BLOCK L_DCO_READDRIVEPARAMETER
VAR_INPUT
	XEXECUTE : BOOL;
	WINDEX : WORD;
	BYSUBINDEX : BYTE;
	XUSEINDEXASPARAM : BOOL;
END_VAR
VAR_OUTPUT
	XDONE : BOOL;
	XBUSY : BOOL;
	XERROR : BOOL;
	EERROR : L_DCO_Error;
	DWDATA : DWORD;
	BYNROFBYTE : BYTE;
END_VAR
VAR_IN_OUT
	AXIS : L_DCO_AXIS_REF_BASE;
END_VAR
VAR
	IDX : DWORD;
	XEXECUTEOLD : BOOL;
	SDOREAD : POINTER TO L_DCO_SdoData;
	SDOMAXREADNUM : WORD;
	SAXISNAME : STRING;
	SDOREADINTERNAL : BOOL;
	SDONUMSTART : WORD;
	SDONUMEND : WORD;
	AXISINSTANCE : __XWORD;
	XRESETOUTPUTS : BOOL;
	ABORT : BOOL;
	SDOACCESSAXISREF : BOOL;
END_VAR
END_FUNCTION_BLOCK