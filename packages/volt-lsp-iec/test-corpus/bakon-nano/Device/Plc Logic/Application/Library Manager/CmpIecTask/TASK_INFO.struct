TYPE TASK_INFO :
STRUCT
	DWVERSION : DWORD;
	PSZNAME : POINTER TO STRING;
	NPRIORITY : INT;
	KINDOFTASK : INT;
	BWATCHDOG : BOOL;
	BPROFILING : BOOL;
	DWEVENTFUNCTIONPOINTER : DWORD;
	PSZEXTERNALEVENT : POINTER TO STRING;
	DWTASKENTRYFUNCTIONPOINTER : DWORD;
	DWWATCHDOGSENSITIVITY : DWORD;
	TINTERVAL : TIME;
	TWATCHDOGTIME : TIME;
	TCYCLETIME : TIME;
	TAVERAGECYCLETIME : TIME;
	TMAXCYCLETIME : TIME;
	TMINCYCLETIME : TIME;
	IJITTER : DINT;
	IJITTERMIN : DINT;
	IJITTERMAX : DINT;
	DWCYCLECOUNT : DWORD;
	ISTATE : WORD;
	WNUMOFJITTERDISTRIBUTIONS : WORD;
	PJITTERDISTRIBUTION : POINTER TO Jitter_Distribution;
END_STRUCT
END_TYPE