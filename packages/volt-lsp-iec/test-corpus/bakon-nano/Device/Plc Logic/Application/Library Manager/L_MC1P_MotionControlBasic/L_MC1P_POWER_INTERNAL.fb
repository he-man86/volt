END_VAR
END_METHOD

METHOD RESETACTIVEINSTANCE : WORD
END_METHOD

METHOD SETACTIVEINSTANCE : WORD
END_METHOD

METHOD SUSPENDERRORREACTIONPOWERDISABLE
