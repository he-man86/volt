	XDRIVEENABLELDALLOLD : BOOL := FALSE;
	XDRIVEENABLELDOLD : BOOL := FALSE;
	XENABLEOLD : BOOL := FALSE;
	XENABLEREQUESTOLD : BOOL := FALSE;
