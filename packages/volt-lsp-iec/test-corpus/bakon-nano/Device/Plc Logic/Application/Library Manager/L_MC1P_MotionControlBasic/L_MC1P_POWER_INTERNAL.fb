	XPLNOTVALID : BOOL := FALSE;
	XSUSPENDERRORREACTIONPOWERDISABLE : BOOL;
	XFUNCTIONLOCKED : BOOL;
END_VAR
END_FUNCTION_BLOCK

METHOD DISABLE
VAR_INPUT
