FUNCTION_BLOCK L_UMTP_PATHBSPLINE
VAR_INPUT
	PLRCP : POINTER TO LREAL;
	UDINCP : UDINT;
	UDIDIM : UDINT;
	UDIDEGREE : UDINT;
	XINITUNIFORMKNOTS : BOOL;
END_VAR
VAR_OUTPUT
	XREADY : BOOL;
	XERROR : BOOL;
END_VAR
VAR
	M_UDIDIM : UDINT;
	M_UDIDEGREE : UDINT;
	M_UDINCP : UDINT;
	M_FBCOXDEBOOR : L_UMTP_CoxdeBoorCoefficients;
	COXDEBOOR : REFERENCE TO L_UMTP_CoxdeBoorCoefficients;
	DIM : UDINT;
END_VAR
END_FUNCTION_BLOCK

METHOD GETPATHVALUE : BOOL
VAR_INPUT
	PLRX : POINTER TO LREAL;
	PLRD1 : POINTER TO LREAL;
	PLRD2 : POINTER TO LREAL;
	UDIDIM : UDINT;
	LRU : LREAL;
END_VAR
END_METHOD