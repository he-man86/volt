	XENDOFPROFILE : BOOL;
	LROFFSETPOSX : LREAL;
	LROFFSETPOSY : LREAL;
	WACTIVECAMTABLE : WORD;
	XCAMSEQUENCERACTIVE : BOOL;
END_VAR
VAR_IN_OUT
