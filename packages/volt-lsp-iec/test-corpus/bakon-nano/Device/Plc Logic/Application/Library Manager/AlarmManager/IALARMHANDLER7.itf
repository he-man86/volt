INTERFACE IALARMHANDLER7
END_INTERFACE

METHOD GETINSTANCEALARM : IAlarm8
VAR_INPUT
	PFBINSTANCE : POINTER TO BYTE;
	UITEMPLATEALARMID : ALARM_ID;
END_VAR
VAR_OUTPUT
	USIALARMGROUPID : ALARMGROUP_ID;
	UIALARMID : ALARM_ID;
END_VAR
END_METHOD

METHOD GETINSTANCEALARMBYNAME : IAlarm8
VAR_INPUT
	PFBINSTANCE : POINTER TO BYTE;
	UITEMPLATEALARMID : ALARM_ID;
	STALARMTEMPLATENAME : STRING(255);
END_VAR
VAR_OUTPUT
	USIALARMGROUPID : ALARMGROUP_ID;
	UIALARMID : ALARM_ID;
END_VAR
END_METHOD

METHOD RAISEEVENTALARMINSTANCE : BOOL
VAR_INPUT
	PFBINSTANCE : POINTER TO BYTE;
	UITEMPLATEALARMID : ALARM_ID;
END_VAR
END_METHOD

METHOD RAISEEVENTALARMINSTANCEBYNAME : BOOL
VAR_INPUT
	PFBINSTANCE : POINTER TO BYTE;
	UITEMPLATEALARMID : ALARM_ID;
	STALARMTEMPLATENAME : STRING(255);
END_VAR
END_METHOD