FUNCTION_BLOCK VISU_RECIPECOMMANDS
VAR
	_CMDSELECTRECIPEDEFINITION : Visu_FbSelectRecipeDefinition;
	_CMDSELECTRECIPE : Visu_FbSelectRecipe;
	_CMDREADRECIPE : Visu_FbReadRecipe;
	_CMDWRITERECIPE : Visu_FbWriteRecipe;
	_CMDLOADRECIPE : Visu_FbLoadRecipe;
	_CMDSAVERECIPE : Visu_FbSaveRecipe;
	_CMDCREATERECIPE : Visu_FbCreateRecipe;
	_CMDDELETERECIPE : Visu_FbDeleteRecipe;
	_CMDRECIPELOADFROM : Visu_FbLoadFromRecipe;
	_CMDFILEEXTENSIONANDPATH : Visu_FbFileExtensionAndPath;
	_RECIPEMANAGER : IRecipeManager;
	_MEMORYFORCMDRECIPESAVEAS : POINTER TO BYTE;
END_VAR
END_FUNCTION_BLOCK

METHOD FB_EXIT : BOOL
VAR_INPUT
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD FB_INIT
VAR_INPUT
	BINITRETAINS : BOOL;
	BINCOPYCODE : BOOL;
	RECIPEMANAGER : IRecipeManager;
END_VAR
END_METHOD

METHOD REGISTERCOMMANDS : BOOL
VAR_INPUT
	COMMANDMANAGER : ICommandManager2;
END_VAR
END_METHOD

METHOD SETRECIPEMANAGER : DWORD
VAR_INPUT
	RECIPEMANAGER : IRecipeManager;
END_VAR
END_METHOD