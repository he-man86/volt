TYPE DOWNLOAD_STATE :
(
	DL_NONE,
	DL_INITIALIZE,
	DL_GETBUFFERINDEX,
	DL_BEFORE_DOWNLOAD,
	DL_OPEN_FILE,
	DL_WAIT_FILE_OPEN,
	DL_FILE_OPEN,
	DL_WAIT_FILE_SET_POS,
	DL_WAIT_FILE_READ,
	DL_CLOSE_FILE,
	DL_WAIT_XFER_COMPLETE,
	DL_ERROR,
	DL_READ_ERROR_FILE,
	DF_ANALYZE_ERROR_FILE,
	DL_AFTER_DOWNLOAD,
	DL_DONE
);
END_TYPE