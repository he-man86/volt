	IDTABLE : CAA.IDENT;
END_VAR
VAR_OUTPUT
	ITFTABLE : ITable;
	EERROR : ERROR;
END_VAR
END_METHOD

METHOD TRANSACTIONBEGINASYNC : PROC_STATE
VAR_INPUT
	ECMD : PROC_CMD;
	EMODE : TRANSACTION_MODE;
END_VAR
VAR_OUTPUT
	ITFTRANSACTION : ITransaction;
	EERROR : ERROR;
END_VAR
