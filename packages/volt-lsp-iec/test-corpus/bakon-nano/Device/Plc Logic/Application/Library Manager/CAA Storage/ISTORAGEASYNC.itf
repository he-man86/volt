END_VAR
END_METHOD

METHOD STORAGECLOSEASYNC : PROC_STATE
VAR_INPUT
	ECMD : PROC_CMD;
END_VAR
VAR_OUTPUT
	EERROR : ERROR;
END_VAR
END_METHOD

METHOD STORAGEOPENFILEASYNC : PROC_STATE
VAR_INPUT
	ECMD : PROC_CMD;
	XREADONLY : BOOL := FALSE;
END_VAR
VAR_OUTPUT
	EERROR : ERROR;
END_VAR
VAR_IN_OUT
	SPATH : CAA.FILENAME;
	ITFSTORAGE : IStorage;
END_VAR
END_METHOD

METHOD STORAGEREORGASYNC : PROC_STATE
VAR_INPUT
	ECMD : PROC_CMD;
END_VAR
VAR_OUTPUT
