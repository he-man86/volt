FUNCTION_BLOCK L_MC2P_BOUNDSCAM EXTENDS L_MC2P_TemplateSlaveAxis
VAR_INPUT
	XEXECUTE : BOOL;
	ITFCAMTABLE : MC_CAM_REF;
	LRMAVEL : LREAL;
	LRMAACC : LREAL;
	UDINUMOFPOINTS : UDINT;
	UDIPOINTSPERCYCLE : UDINT;
END_VAR
VAR_OUTPUT
	XDONE : BOOL;
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	LRPOSMAX : LREAL;
	LRPOSMIN : LREAL;
	LRVELMAX : LREAL;
	LRVELMIN : LREAL;
	LRACCDECMAX : LREAL;
	LRACCDECMIN : LREAL;
END_VAR
VAR
	L_MC2P_CAMBASIC1 : L_MC2P_CamBasic;
	SCVIRTUALSLAVE : L_MC2P_AxisProfile;
	I : UDINT;
	LRMASTEP : LREAL;
	LRMAPOS : LREAL;
	XBREAK : BOOL;
	XEXECUTEOLD : BOOL;
	XRESETOUTPUT : BOOL;
	SCVIRTUALMASTER : L_MC2P_AxisProfile;
	LRMAVEL_INT : LREAL;
	LRMAACC_INT : LREAL;
	UDINUMOFPOINTS_INT : UDINT := 2;
	UDIPOINTSPERCYCLE_INT : UDINT;
	PCAMDATA_INT : POINTER TO L_MC2P_CamData;
	SCCAMINFO : L_MC2P_CamInfo;
	LRPOSMAX_INT : LREAL;
	LRPOSMIN_INT : LREAL;
	LRVELMAX_INT : LREAL;
	LRVELMIN_INT : LREAL;
	LRACCDECMAX_INT : LREAL;
	LRACCDECMIN_INT : LREAL;
	_MCCALL : L_UM1P_MCCall;
	_INPUTDATA : ARRAY [1..2] OF L_MC2P_BoundsCamInput;
	_OUTPUTDATA : ARRAY [1..2] OF L_MC2P_BoundsCamOutput;
	_PINPUTDATA : POINTER TO L_MC2P_BoundsCamInput;
	_POUTPUTDATA : POINTER TO L_MC2P_BoundsCamOutput;
END_VAR
END_FUNCTION_BLOCK