FUNCTION_BLOCK RDREC
VAR_INPUT
	REQ : BOOL;
	ID : DWORD;
	INDEX : INT;
	MLEN : INT;
	RECORD : POINTER TO BYTE;
END_VAR
VAR_OUTPUT
	VALID : BOOL;
	BUSY : BOOL;
	ERROR : BOOL;
	STATUS : DWORD;
	LEN : INT;
END_VAR
VAR
	M_FACTORY : ICommFBFactory;
	M_PRDREC : POINTER TO RDRECbase;
	_REQ : BOOL;
	S_INSTANCEHANDLER : InstanceHandler;
END_VAR
END_FUNCTION_BLOCK