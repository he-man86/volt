VAR_GLOBAL
	LT_HIGHSPEED : UDINT := 16#1;
	LT_SAFE : UDINT := 16#2;
	LT_NORMAL : UDINT := 16#4;
	LT_TIMESTAMP_RTC : UDINT := 16#10;
	LT_TIMESTAMP_RTC_HIGHRES : UDINT := 16#2000;
	LT_TIMESTAMP_MS : UDINT := 16#20;
	LT_TIMESTAMP_US : UDINT := 16#40;
	LT_TIMESTAMP_NS : UDINT := 16#80;
	LT_NO_DISABLE : UDINT := 16#100;
	LT_DUMP_ASYNC : UDINT := 16#200;
	LT_DUMP_ALWAYS : UDINT := 16#400;
	LT_DUMP_ON_CLOSE : UDINT := 16#800;
	LT_DUMP_ON_REQUEST : UDINT := 16#1000;
	LT_STD : UDINT := (((LT_NORMAL OR LT_TIMESTAMP_RTC) OR LT_NO_DISABLE) OR LT_DUMP_ASYNC);
END_VAR