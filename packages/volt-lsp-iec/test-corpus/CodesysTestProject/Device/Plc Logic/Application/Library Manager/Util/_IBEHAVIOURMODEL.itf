INTERFACE _IBEHAVIOURMODEL
END_INTERFACE

METHOD ABORTMODEL : ERROR
VAR_INPUT
	XCOMMIT : BOOL;
END_VAR
END_METHOD

METHOD GETMODELSTATE
VAR_INPUT
	XCOMMIT : BOOL;
END_VAR
VAR_OUTPUT
	XDONE : BOOL;
	XBUSY : BOOL;
	XERROR : BOOL;
	XABORTED : BOOL;
	IERRORID : INT;
	ESTATE : _STATE;
END_VAR
END_METHOD

METHOD RESETMODEL : ERROR
VAR_INPUT
	XCOMMIT : BOOL;
END_VAR
END_METHOD

METHOD STARTMODEL : ERROR
VAR_INPUT
	XCOMMIT : BOOL;
END_VAR
END_METHOD