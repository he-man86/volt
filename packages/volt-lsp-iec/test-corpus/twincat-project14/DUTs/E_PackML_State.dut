{attribute 'qualified_only'}
TYPE E_PackML_State :
(
    eCLEARING       := 0,
    eSTOPPED        := 1,
    eSTARTING       := 2,
    eIDLE           := 3,
    eSUSPENDING     := 4,
    eSUSPENDED      := 5,
    eUNSUSPENDING   := 6,
    eHOLDING        := 7,
    eHELD           := 8,
    eUNHOLDING      := 9,
    eRESETTING      := 10,
    eEXECUTE        := 11,
    eCOMPLETING     := 12,
    eCOMPLETE       := 13,
    eABORTING       := 14,
    eABORTED        := 15,
    eSTOPPING       := 16
) USINT;
END_TYPE
