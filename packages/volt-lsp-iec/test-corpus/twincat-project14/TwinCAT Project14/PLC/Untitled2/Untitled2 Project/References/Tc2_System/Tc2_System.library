PARAMETER Tc2_System PARAM.STRING_LENGTH_EXP := 255
PARAMETER Tc2_System PARAM.STRING_LENGTH_ADDRESS := 20
PARAMETER Tc2_System PARAM.STRING_LENGTH_COMMENT := 255
PARAMETER Tc2_System PARAM.STRING_LENGTH_OUTSTRING := 255
PARAMETER Tc2_System PARAM.TABLE_SHOW_VALID_ITEMS := FALSE
MATERIALIZATION 5
