FUNCTION_BLOCK VltFixtureMembers
VAR_INPUT
	bGo : BOOL;
END_VAR
VAR
	nTick : INT;
END_VAR

%LANGUAGE ST
nTick := nTick + 1;

END_FUNCTION_BLOCK

METHOD CfcStep : BOOL
VAR_INPUT
	bIn : BOOL;
END_VAR

%LANGUAGE CFC UNSUPPORTED
END_METHOD

METHOD Visible : BOOL
VAR_INPUT
	bIn : BOOL;
END_VAR

%LANGUAGE ST
Visible := bIn;
END_METHOD

ACTION SfcRun
%LANGUAGE SFC UNSUPPORTED
END_ACTION
