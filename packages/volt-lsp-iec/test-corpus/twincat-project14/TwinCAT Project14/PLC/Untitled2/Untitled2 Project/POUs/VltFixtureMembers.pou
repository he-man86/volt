FUNCTION_BLOCK VltFixtureMembers
VAR_INPUT
	bGo : BOOL;
END_VAR
VAR
	nTick : INT;
END_VAR

IMPLEMENTATION ST
nTick := nTick + 1;

END_FUNCTION_BLOCK

METHOD CfcStep : BOOL
VAR_INPUT
	bIn : BOOL;
END_VAR

IMPLEMENTATION CFC UNSUPPORTED
END_METHOD

METHOD Visible : BOOL
VAR_INPUT
	bIn : BOOL;
END_VAR

IMPLEMENTATION ST
Visible := bIn;
END_METHOD

ACTION SfcRun
IMPLEMENTATION SFC UNSUPPORTED
END_ACTION
