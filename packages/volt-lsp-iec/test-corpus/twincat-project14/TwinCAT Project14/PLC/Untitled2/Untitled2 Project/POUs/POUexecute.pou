PROGRAM POUexecute
VAR
	iCount:INT;
	
	t1: TON;
	output: BOOL;
	e1: TIME;
	in1: BOOL;
	a: BOOL;
	b: BOOL;
	c: BOOL;
	out1: BOOL;
	t2: TON;
	out2: INT;
END_VAR
%LANGUAGE LD
%NETWORK
EXECUTE(EN := TRUE, 'iCount:=icount+1;
');
%NETWORK
ASSIGN(t1(IN := in1, PT := e1), Q => output);
%NETWORK
VAR w1 : ANY; END_VAR
w1 := b;
ASSIGN(AND(OR(a, w1), c), Q => out1);
ASSIGN(w1, Q => out2);
%NETWORK
ASSIGN(t2(PT := e1), Q => output);

END_PROGRAM
