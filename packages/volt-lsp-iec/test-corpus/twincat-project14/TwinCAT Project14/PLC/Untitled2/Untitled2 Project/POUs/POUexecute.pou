PROGRAM POUexecute
VAR
	iCount:INT;
	
	t1: TON;
	output: BOOL;
	e1: TIME;
	in1: BOOL;
	a: BOOL;
	b: BOOL;
	c: BOOL;
	out1: BOOL;
	t2: TON;
	out2: INT;
END_VAR
IMPLEMENTATION LD
NETWORK
  EXECUTE
iCount:=icount+1;

  END_EXECUTE ENO EN TRUE;
END_NETWORK
NETWORK
  output := t1 : TON(IN := in1, PT := e1).Q;
END_NETWORK
NETWORK
  split1 := b;
  out1 := (a OR split1) AND c;
  out2 := split1;
END_NETWORK
NETWORK
  output := t2 : TON(IN := , PT := e1).Q;
END_NETWORK

END_PROGRAM
