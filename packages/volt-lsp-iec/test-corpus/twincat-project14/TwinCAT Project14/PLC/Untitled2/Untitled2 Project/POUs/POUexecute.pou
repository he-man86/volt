PROGRAM POUexecute
VAR
	iCount:INT;
	
	t1: TON;
	output: BOOL;
	e1: TIME;
	in1: BOOL;
	a: BOOL;
	b: BOOL;
	c: BOOL;
	out1: BOOL;
	t2: TON;
	out2: INT;
END_VAR
%LANGUAGE LD
%NETWORK
EXECUTE(EN := TRUE, CODE := 'iCount:=icount+1;
');
%NETWORK
output := t1(IN := in1, PT := e1).Q;
%NETWORK
%WIRES w1
w1 := b;
out1 := AND(OR(a, w1), c);
out2 := w1;
%NETWORK
output := t2(IN := TRUE, PT := e1).Q;

END_PROGRAM
