PROGRAM POUexecute
VAR
	iCount:INT;
	
	t1: TON;
	output: BOOL;
	e1: TIME;
	in1: BOOL;
	a: BOOL;
	b: BOOL;
	c: BOOL;
	out1: BOOL;
	t2: TON;
	out2: INT;
END_VAR
%LANGUAGE LD
%NETWORK
%EXECUTE(EN := TRUE)
iCount:=icount+1;

%END_EXECUTE
%NETWORK
%WIRES w1
t1(IN := in1, PT := e1, Q => w1);
output := w1;
%NETWORK
%WIRES w2
w2 := b;
out1 := AND(OR(a, w2), c);
out2 := w2;
%NETWORK
%WIRES w3
t2(IN := TRUE, PT := e1, Q => w3);
output := w3;

END_PROGRAM
