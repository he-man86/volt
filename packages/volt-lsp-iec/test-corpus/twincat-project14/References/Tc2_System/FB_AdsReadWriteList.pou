FUNCTION_BLOCK FB_AdsReadWriteList
VAR_INPUT
	sNetId : T_AmsNetID;
	nPort : T_AmsPort;
	nIdxGrp : UDINT;
	nIdxOffs : UDINT;
	cbWriteList : UDINT;
	pWriteList : POINTER TO ST_AdsReadWriteListEntry;
	cbReadLen : UDINT;
	pReadBuff : PVOID;
	bExecute : BOOL;
	tTimeout : TIME;
END_VAR
VAR_OUTPUT
	bBusy : BOOL;
	bError : BOOL;
	nErrID : UDINT;
	cbRead : UDINT;
END_VAR
END_FUNCTION_BLOCK