	sNetId : STRING(23);
	nPort : UINT;
	nIdxGrp : UDINT;
	nIdxOffs : UDINT;
	cbWriteLen : UDINT;
	cbReadLen : UDINT;
	pWriteBuff : PVOID;
	pReadBuff : PVOID;
	bExecute : BOOL;
	tTimeout : TIME;
END_VAR
VAR_OUTPUT
