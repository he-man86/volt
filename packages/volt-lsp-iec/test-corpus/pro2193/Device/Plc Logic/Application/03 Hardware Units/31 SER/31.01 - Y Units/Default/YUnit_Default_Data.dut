TYPE YUnit_Default_Data :
STRUCT
	Waiting					: PositionWithProfileType;
	Takeout					: PositionWithProfileType;
	Takeover				: ARRAY[1..YUnits.NumberOfTakeoverPositions] OF PositionWithProfileType;
	LabelTakeover			: PositionWithProfileType;		// In case of separate position where to take the labels

	rMoveToParkingDelay		: REAL;	// If > 0 then the Y axis delays moving towards the mould so a restart is possible. Value is calculated by PLC.
END_STRUCT
END_TYPE
