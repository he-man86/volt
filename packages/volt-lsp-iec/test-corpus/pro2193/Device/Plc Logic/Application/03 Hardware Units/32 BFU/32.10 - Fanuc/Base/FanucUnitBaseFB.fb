{attribute 'symbol' := 'none'}
FUNCTION_BLOCK FanucUnitBaseFB
EXTENDS ModuleResettableFB
IMPLEMENTS IFanucUnitBase_BoxFilling_Commands, IFanucUnitBase_Buffer_Commands, IFanucUnitBase_Pick_Commands, IFanucUnitBase_Reject_Commands
VAR_INPUT
	Fanuc						: FanucFB;

	{attribute 'symbol' := 'readwrite'}	Clamp						: ARRAY[1..2] OF Cylinder_53ValveFB;
	{attribute 'symbol' := 'readwrite'}	ReleaseClamp				: Cylinder_52Valve_TimedFB;

	StackDetection				: DigitalSensorFB(invert := FALSE);
	boxFillAreaIsClear			: BOOL;				// Indicates that the Fanuc can enter the box fill area
	conveyorStandstill			: BOOL;				// Indicates that the Fanuc can pick a stack from the conveyor
END_VAR
VAR_OUTPUT
END_VAR
VAR_IN_OUT
	Data						: FanucUnitBase_Data;
	GripperStatus				: StackStatusType;
END_VAR
VAR
	PickPosX					: UINT; // Pick position on infeed conveyor
	PickPosY					: UINT; // Pick position on infeed conveyor
	PickPosZ					: UINT; // Pick position on infeed conveyor
	BufferPosX					: UINT; // Pick/place position on bufferstation
	BufferPosY					: UINT; // Pick/place position on bufferstation
	BufferPosZ					: UINT; // Pick/place position on bufferstation
	BufferPickRotate			: UINT;	// Value 1 when gripper must be rotated

	PlacePosition				: Fanuc_PositionXYZWPR_UINT_Type;
	PlaceOffset					: Fanuc_PositionXYZ_UINT_Type;
	PlaceToolOffset				: Fanuc_PositionXYZ_UINT_Type;
	PlaceConfig					: Fanuc_HighLowUInt_Type;

	{attribute 'symbol' := 'readwrite'}	StackPositionIndex			: UINT;					// Select stack position to edit
	{attribute 'symbol' := 'readwrite'}	StackPositionInput			: Fanuc_StackPosition;	// Selected stack position

	ClampOpenDelay				: BTON;
	ClampCloseDelay				: BTON;

	fanucInitNeeded				: BOOL := TRUE;
	HomingError					: BOOL;
	_manualControlEnabled		: BOOL;		// Manual control is enabled from outside this module

	alarmCrashDetected			: BOOL;
	alarmStackNotDetected		: BOOL;
	alarmStackDetected			: BOOL;
END_VAR

SUPER^();

END_FUNCTION_BLOCK

METHOD PROTECTED Alarms
VAR_INST
	SetError					: ARRAY[1..3] OF SetErrorFB;
END_VAR
SetError[1](
	moduleHandler	:= ModuleHandler,
	textRefId		:= Fanuc_Errors,
	errorId			:= 10,		// Crash detected in box
	alarmCondition	:= alarmCrashDetected,
	alarmDelay		:= 0.0,
	severity		:= enumErrorSeverity.Fault,
	reaction		:= enumErrorReaction.No_reaction,
	active			=> );

SetError[2](
	moduleHandler	:= ModuleHandler,
	textRefId		:= Fanuc_Errors,
	errorId			:= 11,		// Stack detection sensor not detected. Stack rejected
	alarmCondition	:= alarmStackNotDetected,
	alarmDelay		:= 0.0,
	severity		:= enumErrorSeverity.Fault,
	reaction		:= enumErrorReaction.No_reaction,
	active			=> );

SetError[3](
	moduleHandler	:= ModuleHandler,
	textRefId		:= Fanuc_Errors,
	errorId			:= 12,		// Stack detection sensor high in error. Stack rejected
	alarmCondition	:= alarmStackDetected,
	alarmDelay		:= 0.0,
	severity		:= enumErrorSeverity.Fault,
	reaction		:= enumErrorReaction.No_reaction,
	active			=> );

alarmStackNotDetected	R= SetError[2].active;
alarmStackDetected		R= SetError[3].active;
END_METHOD

METHOD PROTECTED Cyclic
VAR_INST
	JsonTimer					: BTON;
	initStacks					: BOOL;
END_VAR
VAR
	i							: USINT;
END_VAR
Mapping();

Fanuc(
	ModuleHandler	:= ModuleHandler,
	xGateIsClosed	:= BFU.xGatesAreClosed,
	xExternalReset	:= GlobalVars.Reset OR GlobalVars_BFU.Reset,
	SystemState		:= ,
);

Clamp[1].errorId_SensorOut		:= 1;
Clamp[1].errorId_SensorIn		:= 2;
Clamp[2].errorId_SensorOut		:= 3;
Clamp[2].errorId_SensorIn		:= 4;

FOR i := 1 TO 2 DO
	Clamp[i](
		moduleHandler			:= ModuleHandler,
		manualControlEnabled	:= BFU.ManualControlEnabled,
		textRefId				:= Fanuc_Errors,
		alarmEnable				:= BFU.DigIn.xAirPressureOK,
		alarmDelay				:= 5,
		severity				:= enumErrorSeverity.Fault,
		reaction				:= enumErrorReaction.No_reaction,
		inputOut				:= ,
		inputIn					:= ,
		rGiveAirToBothOutputs	:= 0.0,
		xEnableOutputs			:= BFU.MainAirValve.Map());
END_FOR

ClampCloseDelay.Set(	In := Clamp[1].IsOut AND Clamp[2].IsOut,	Data.rClampDelay);
ClampOpenDelay.Set(		In := Clamp[1].IsIn AND Clamp[2].IsIn,		Data.rStackingDelay);

ReleaseClamp(
	manualControlEnabled		:= BFU.ManualControlEnabled,
	rTimeToGoIn					:= ,
	rTimeToGoOut				:= );

IF fanucInitNeeded AND_THEN Fanuc.Init() THEN
	fanucInitNeeded	:= FALSE;
END_IF

HandleStackSelection();

// Always rebuild the json for the visu
IF JsonTimer.Set(NOT JsonBuilder.executeBoxFillingJson, 2) THEN
	JsonBuilder.executeBoxFillingJson := TRUE;
	JsonTimer.Reset();
END_IF

IF initStacks THEN
	InitStackPositions();
	initStacks := FALSE;
END_IF

// Monitor stack detection sensor
IF  Fanuc.I.xSPCFree[1]			// Infeed area
AND Fanuc.I.xSPCFree[3]			// Reject area
AND Fanuc.I.xSPCFree[4]			// Place area
AND Fanuc.I.xSPCFree[5]			// Buffer area
AND NOT GripperStatus.Rejected	// Stack in gripper is already rejected
THEN
	IF GripperStatus.Present THEN
		IF StackDetection.IsInactive THEN
			LogPlc.Error('Fanuc lost a stack');
			alarmStackNotDetected	:= TRUE;
			GripperStatus.Rejected	:= TRUE;
		END_IF
	ELSE
		IF StackDetection.IsActive THEN
			LogPlc.Error('Stack detected in error, reject just in case');
			alarmStackDetected		:= TRUE;
			GripperStatus.Rejected	:= TRUE;
		END_IF
	END_IF
END_IF
END_METHOD

// Command to reset the module (Statemachine to zero state) in case of E-Stop
METHOD PUBLIC EStop : BOOL	// Returns true when drives are in standstill
%FOLDER Commands
Clamp[1].Reset();
Clamp[2].Reset();
ReleaseClamp.Reset();
ClearProducts.Stack(GripperStatus);

fanucInitNeeded		:= TRUE;
alarmCrashDetected	:= FALSE;
EStop				:= SUPER^.EStop();
END_METHOD

METHOD PUBLIC GetRotateSettingForStack : BOOL
VAR_INPUT
	stackNumber	: UINT;
END_VAR
%FOLDER Commands
IF stackNumber >= 1 AND stackNumber <= GVL_Constants_BFU.MaxNumberOfStacksInBox THEN
	GetRotateSettingForStack := Data.StackPosition[stackNumber].Config > 2; // 1 or 2: no rotate(0), 3 or 4 rotate(1);
END_IF
END_METHOD

// Take the product
METHOD PRIVATE GripperClose : BOOL
%FOLDER Private
Clamp[1].GoOut();
Clamp[2].GoOut();
ReleaseClamp.Reset();
GripperClose	:= ClampCloseDelay.Q;
END_METHOD

// Prepare the gripper for receiving the products
METHOD PRIVATE GripperOpen : BOOL
%FOLDER Private
Clamp[1].GoIn();
Clamp[2].GoIn();
ReleaseClamp.Set();
GripperOpen		:= ClampOpenDelay.Q;
END_METHOD

// Release the product
METHOD PRIVATE GripperOpenInBox : BOOL
VAR_INPUT
	rotateGripper	: BOOL;
END_VAR
%FOLDER Private
ReleaseClamp.Set();
IF rotateGripper THEN
	Clamp[2].Reset();
	GripperOpenInBox := Clamp[1].GoIn();
ELSE
	Clamp[1].Reset();
	GripperOpenInBox := Clamp[2].GoIn();
END_IF
END_METHOD

METHOD PRIVATE HandleStackSelection
VAR_INST
	lastSelected : UINT;
END_VAR
%FOLDER Private
IF StackPositionIndex <= 0 THEN RETURN; END_IF;

IF StackPositionIndex <> lastSelected THEN
	lastSelected := StackPositionIndex;
	StackPositionInput := Data.StackPosition[StackPositionIndex];
ELSE
	Data.StackPosition[StackPositionIndex] := StackPositionInput;
END_IF

IF ExternalManualControlEnabled THEN
	SetPlacePosition(Data.StackPosition[StackPositionIndex]);
	BufferPickRotate := TO_UINT(GetRotateSettingForStack(StackPositionIndex));
END_IF
END_METHOD

