METHOD PUBLIC PickStackFromBuffer : BOOL
VAR_INPUT
	rotateGripper				: BOOL;								// True when stack must be picked upside down.
	StackStatus					: REFERENCE TO StackStatusType;		// Stack status of the stack to pick
END_VAR
VAR_INST
	localState					: SINT;
END_VAR
%FOLDER Commands
IF NOT CommandLock.Request(__POUNAME()) THEN
	RETURN;
END_IF

IF CommandLock.FirstCall THEN
	localState					:= 0;
	Fanuc.ComBrinkFanuc			:= 0;
END_IF

CASE localState OF
	0:
		Increment.AnyInt(localState);

	1:
		// Write position and rotation to Fanuc
		BufferPickRotate		:= SEL(rotateGripper, 0, 1);
		BufferPosX				:= 0;
		BufferPosY				:= 0;
		BufferPosZ				:= 0; // Always pick from position 0

		// Open gripper, just to be sure
		IF GripperOpen() AND Fanuc.ProgramRunning <> Fanuc_Programs.Buffer THEN
			Increment.AnyInt(localState);
		END_IF

	2: // Start buffer program
		Fanuc.ProgramSelector	:= Fanuc_Programs.Buffer;
		IF Fanuc.ProgramRunning = Fanuc_Programs.Buffer AND Fanuc.ComFanucBrink <> Fanuc_Buffer_IN.AtPickPlacePos THEN
			Increment.AnyInt(localState);
		END_IF

	3:	// Wait until Fanuc is at buffer position
		Fanuc.ProgramSelector	:= Fanuc_Programs.MainProgram;
		Fanuc.ComBrinkFanuc		:= Fanuc_Buffer_OUT.GoToPick;

		IF Fanuc.ComFanucBrink = Fanuc_Buffer_IN.AtPickPlacePos THEN
			Increment.AnyInt(localState);
		END_IF

	4:	// Clamp stack
		IF GripperClose() THEN
			GripperStatus			:= StackStatus;		// Copy the status from the conveyor
			GripperStatus.Rotated	:= rotateGripper;	// Save rotateGripper state for later check
			ClearProducts.Stack(StackStatus);			// Clear stack in bufferrack
			Increment.AnyInt(localState);
		END_IF

	5: // Wait until Fanuc is retracted
		Fanuc.ComBrinkFanuc		:= Fanuc_Buffer_OUT.RetractFromPick;
		IF Fanuc.ComFanucBrink = Fanuc_Buffer_IN.AtRetractPos THEN
			Increment.AnyInt(localState);
		END_IF

	6: // Wait until Fanuc is finished
		Fanuc.ComBrinkFanuc		:= SEL(GripperStatus.Rejected, Fanuc_Buffer_OUT.StopAtRetract, Fanuc_Buffer_OUT.GoToHomePos);	// Always go home after picking, next is reject or place
		IF Fanuc.ComFanucBrink = Fanuc_Buffer_IN.AtHomePos
		OR Fanuc.ComFanucBrink = Fanuc_Buffer_IN.WaitingAtRetractPos
		THEN
			Fanuc.ComBrinkFanuc := 0;
			PickStackFromBuffer := CommandLock.Release(__POUNAME());
		END_IF
END_CASE
END_METHOD

METHOD PUBLIC PickStackFromConveyor : BOOL
VAR_INPUT
	StackToPickX				: UINT;					// X-position of the stack to pick
	StackToPickY				: UINT;					// Y-position of the stack to pick
	StackStatus					: REFERENCE TO StackStatusType;		// Stack status of the stack to pick
	EndPosition					: Fanuc_Pick_OUT;		// Define where the pick program has to end (retract for buffer or home for reject)
END_VAR
VAR_INST
	localState					: SINT;
END_VAR
%FOLDER Commands
IF NOT CommandLock.Request(__POUNAME()) THEN
	RETURN;
END_IF

IF CommandLock.FirstCall THEN
	localState					:= 0;
	Fanuc.ComBrinkFanuc			:= 0;
END_IF

CASE localState OF
	0:
		Increment.AnyInt(localState);

	1:
		// Write pick position to Fanuc
		PickPosX				:= StackToPickX;
		PickPosY				:= StackToPickY;
		PickPosZ				:= 0;

		// Open gripper
		IF GripperOpen() THEN
			Increment.AnyInt(localState);
		END_IF

	2: // Start pick program
		Fanuc.ProgramSelector	:= Fanuc_Programs.Pick;
		IF Fanuc.ProgramRunning = Fanuc_Programs.Pick THEN
			Increment.AnyInt(localState);
		END_IF

	3:	// Wait until Fanuc is at pick position
		Fanuc.ProgramSelector	:= Fanuc_Programs.MainProgram;
		IF Fanuc.ComFanucBrink = Fanuc_Pick_IN.AtPickPos THEN
			Increment.AnyInt(localState);
		END_IF

	4:	// Clamp stack
		IF GripperClose() THEN
			GripperStatus		:= StackStatus;		// Copy the status from the conveyor
			ClearProducts.Stack(StackStatus);		// Clear stack on conveyor
			IF NOT GripperStatus.Complete THEN
				LogPlc.Error('Stack must be complete');
				GripperStatus.Rejected	:= TRUE;
			END_IF
			Increment.AnyInt(localState);
		END_IF

	5: // Wait until Fanuc is finished
		Fanuc.ComBrinkFanuc		:= EndPosition;
		IF Fanuc.ComFanucBrink = Fanuc_Pick_IN.AtRetractPos
		OR Fanuc.ComFanucBrink = Fanuc_Pick_IN.AtHomePos
		THEN
			Fanuc.ComBrinkFanuc		:= 0;
			PickStackFromConveyor	:= CommandLock.Release(__POUNAME());
		END_IF




(*
	5: // Wait until Fanuc is at shift position
		Fanuc.ComBrinkFanuc		:= Fanuc_Pick_OUT.GoToShift;
		IF Fanuc.ComFanucBrink = Fanuc_Pick_IN.AtShiftPos THEN
			Increment.AnyInt(localState);
		END_IF

	6:	// Release stack
		IF GripperOpen(Delay := Data.rStackingDelay) THEN
			Increment.AnyInt(localState);
		END_IF

	7:	// Wait until Fanuc is at shift Pick position
		Fanuc.ComBrinkFanuc		:= Fanuc_Pick_OUT.GoToShiftPick;
		IF Fanuc.ComFanucBrink = Fanuc_Pick_IN.AtShiftPickPos THEN
			Increment.AnyInt(localState);
		END_IF

	8:	// Clamp stack again
		IF GripperClose(Delay := Data.rClampDelay) THEN
			Increment.AnyInt(localState);
		END_IF
*)
END_CASE
END_METHOD

METHOD PUBLIC PlaceStackInBox : enumResultGeneric		// Returns error when crashed in box
VAR_INPUT
	stackNumber					: UINT;					// Sorting number of the stack in the box
END_VAR
VAR_OUTPUT
	stackReleased				: BOOL;					// True for 1 cycle when stack is released. StackStatus is valid when true.
	StackStatus					: StackStatusType;		// Stack status of the stack that is placed
END_VAR
VAR_INST
	localState					: SINT;
	i							: UINT;
	StackPosition				: REFERENCE TO Fanuc_StackPosition;
END_VAR
%FOLDER Commands
IF NOT CommandLock.Request(__POUNAME()) THEN
	RETURN;
END_IF

IF CommandLock.FirstCall THEN
	localState				:= 0;
	Fanuc.ComBrinkFanuc		:= 0;
END_IF

CASE localState OF
	0:
		Increment.AnyInt(localState);

	1:
		FOR i := 1 TO GVL_Constants_BFU.MaxNumberOfStacksInBox DO
			IF Data.StackPosition[i].StackNumber = stackNumber THEN
				StackPosition REF= Data.StackPosition[i];
				SetPlacePosition(StackPosition);	// Write place position to Fanuc
				Increment.AnyInt(localState);
				EXIT;
			END_IF
		END_FOR

	2:	// Close gripper, just to be sure
		IF GripperClose() THEN
			Increment.AnyInt(localState);
		END_IF

	3: // Start place program
		Fanuc.ProgramSelector	:= Fanuc_Programs.Place;
		IF Fanuc.ProgramRunning = Fanuc_Programs.Place THEN
			Increment.AnyInt(localState);
		END_IF

	4:	// Wait until Fanuc is at place position
		Fanuc.ProgramSelector	:= Fanuc_Programs.MainProgram;
		IF Fanuc.ComFanucBrink = Fanuc_Place_IN.AtPlacePos
		OR (NOT Fanuc.I.xSPCFree[4] AND Fanuc.I.xFault)
		THEN
			Increment.AnyInt(localState);
		END_IF

	5:	// Release stack
		IF Fanuc.I.xFault THEN
			alarmCrashDetected		:= TRUE;
			Fanuc.xExternalReset	:= TRUE;
			Fanuc.Q.xStart			:= TRUE;
		END_IF

		IF GripperOpenInBox(StackPosition.Config = 0) THEN
			stackReleased		:= TRUE;
			StackStatus			:= GripperStatus;
			ClearProducts.Stack(GripperStatus);
			Increment.AnyInt(localState);
		END_IF

	6:
		IF NOT Fanuc.I.xFault THEN
			Fanuc.xExternalReset		:= FALSE;
			Fanuc.Q.xStart				:= FALSE;		// Fanuc starts again on falling edge of start
			Increment.AnyInt(localState);
		END_IF

	7: // Wait until Fanuc is retracted
		IF NOT FanucAboveBoxArea THEN	GripperOpen();	END_IF

		Fanuc.ComBrinkFanuc		:= Fanuc_Place_OUT.GoToPlaceCheckPos;
		IF Fanuc.ComFanucBrink = Fanuc_Place_IN.AtPlaceCheckPos THEN
			Increment.AnyInt(localState);
		ELSIF Fanuc.I.xFault THEN
			Increment.AnyInt(localState, -2);
		END_IF

	8: // Wait until Fanuc is finished
		IF NOT FanucAboveBoxArea THEN	GripperOpen();	END_IF

		Fanuc.ComBrinkFanuc		:= Fanuc_Place_OUT.GoToHomePos;
		IF Fanuc.ComFanucBrink = Fanuc_Place_IN.AtHomePos THEN
			Increment.AnyInt(localState);
		END_IF

	9:
		Fanuc.ComBrinkFanuc	:= 0;
		PlaceStackInBox		:= SEL(alarmCrashDetected, enumResultGeneric.Success, enumResultGeneric.Error);
		alarmCrashDetected	:= FALSE;
		CommandLock.Release(__POUNAME());
END_CASE
END_METHOD

METHOD PUBLIC PlaceStackUponBuffer : BOOL
VAR_INPUT
	bufferPosZindex				: USINT;				// Index (0, or 1, or 2) of how many stacks are on the bufferrack. Fanuc uses it for Z-position
	EndPosition					: Fanuc_Buffer_OUT;		// Define where the buffer program has to end (retract for pick or home for place/reject)
END_VAR
VAR_OUTPUT
	stackReleased				: BOOL;					// True for 1 cycle when stack is released. StackStatus is valid when true.
	StackStatus					: StackStatusType;		// Stack status of the stack that is placed
END_VAR
VAR_INST
	localState					: SINT;
END_VAR
%FOLDER Commands
IF NOT CommandLock.Request(__POUNAME()) THEN
	RETURN;
END_IF

IF CommandLock.FirstCall THEN
	localState					:= 0;
	Fanuc.ComBrinkFanuc			:= 0;
END_IF

CASE localState OF
	0:
		Increment.AnyInt(localState);

	1:
		// Write place position to Fanuc
		BufferPickRotate		:= 0;	// Never rotate while placing
		BufferPosX				:= 0;
		BufferPosY				:= 0;
		BufferPosZ				:= bufferPosZindex;

		// Close gripper, just to be sure
		IF GripperClose() THEN
			Increment.AnyInt(localState);
		END_IF

	2: // Start buffer program
		Fanuc.ProgramSelector	:= Fanuc_Programs.Buffer;
		IF Fanuc.ProgramRunning = Fanuc_Programs.Buffer THEN
			Increment.AnyInt(localState);
		END_IF

	3:	// Wait until Fanuc is at buffer position
		Fanuc.ProgramSelector	:= Fanuc_Programs.MainProgram;
		Fanuc.ComBrinkFanuc		:= Fanuc_Buffer_OUT.GoToPlace;
		IF Fanuc.ComFanucBrink = Fanuc_Buffer_IN.AtPickPlacePos
		THEN
			Increment.AnyInt(localState);
		END_IF

	4:	// Release stack
		IF GripperOpen() THEN
			stackReleased		:= TRUE;
			StackStatus			:= GripperStatus;
			ClearProducts.Stack(GripperStatus);
			Increment.AnyInt(localState);
		END_IF

	5: // Wait until Fanuc is retracted
		Fanuc.ComBrinkFanuc		:= Fanuc_Buffer_OUT.RetractFromPlace;
		IF Fanuc.ComFanucBrink = Fanuc_Buffer_IN.AtRetractPos THEN
			Increment.AnyInt(localState);
		END_IF

	6: // Wait until Fanuc is finished
		Fanuc.ComBrinkFanuc		:= EndPosition;
		IF Fanuc.ComFanucBrink = Fanuc_Buffer_IN.WaitingAtRetractPos
		OR Fanuc.ComFanucBrink = Fanuc_Buffer_IN.AtHomePos
		THEN
			Fanuc.ComBrinkFanuc	:= 0;
			PlaceStackUponBuffer:= CommandLock.Release(__POUNAME());
		END_IF
END_CASE
END_METHOD

// Converts a given LREAL value to two UINT values which can be sent to the Fanuc
METHOD PRIVATE RealToFanucUInt : Fanuc_HighLowUInt_Type
VAR_INPUT
	Value	: LREAL;
END_VAR
VAR
	lrTempValue			: LREAL;
END_VAR
%FOLDER Private
lrTempValue				:= Value * 1000;

RealToFanucUInt.High	:= TO_UINT(TRUNC(ABS(lrTempValue) / 65536));					// High integer with sign bit
RealToFanucUInt.High.15	:= lrTempValue > 0;												// Highest bit of the high integer indicates a positive (true) or negative (false) value
RealToFanucUInt.Low		:= TO_UINT(TO_UDINT(ABS(lrTempValue)) MOD 65536);				// Low integer
END_METHOD

METHOD PUBLIC RejectStack : BOOL
VAR_INPUT
	EndPosition					: Fanuc_Reject_OUT;		// Define where the buffer program has to end (retract or home)
END_VAR
VAR_OUTPUT
	stackReleased				: BOOL;					// True for 1 cycle when stack is released. StackStatus is valid when true.
	StackStatus					: StackStatusType;		// Stack status of the stack that is placed
END_VAR
VAR_INST
	localState					: SINT;
END_VAR
%FOLDER Commands
IF NOT CommandLock.Request(__POUNAME()) THEN
	RETURN;
END_IF

IF CommandLock.FirstCall THEN
	localState					:= 0;
	Fanuc.ComBrinkFanuc			:= 0;
END_IF

CASE localState OF
	0:
		Increment.AnyInt(localState);

	1:
		// Close gripper, just to be sure
		IF GripperClose() THEN
			Increment.AnyInt(localState);
		END_IF

	2: // Start reject program
		Fanuc.ProgramSelector	:= Fanuc_Programs.Reject;
		IF Fanuc.ProgramRunning = Fanuc_Programs.Reject THEN
			Increment.AnyInt(localState);
		END_IF

	3:	// Wait until Fanuc is at reject position
		Fanuc.ProgramSelector	:= Fanuc_Programs.MainProgram;
		IF Fanuc.ComFanucBrink = Fanuc_Reject_IN.AtRejectPos THEN
			Increment.AnyInt(localState);
		END_IF

	4:	// Release stack
		IF GripperOpen() THEN
			stackReleased		:= TRUE;
			StackStatus			:= GripperStatus;
			ClearProducts.Stack(GripperStatus);
			Increment.AnyInt(localState);
		END_IF

	5: // Wait until Fanuc is finished
		Fanuc.ComBrinkFanuc		:= EndPosition;
		IF Fanuc.ComFanucBrink = Fanuc_Reject_IN.AtRetractPos
		OR Fanuc.ComFanucBrink = Fanuc_Reject_IN.AtHomePosition
		THEN
			Fanuc.ComBrinkFanuc := 0;
			RejectStack := CommandLock.Release(__POUNAME());
		END_IF
END_CASE
END_METHOD

// Command to reset the module. Servodrives are homed.
METHOD PUBLIC Reset : BOOL	// Returns true when homing done
VAR_INST
	localState					: SINT;
END_VAR
%FOLDER Commands
IF NOT CommandLock.Request(__POUNAME()) THEN
	RETURN;
END_IF

IF CommandLock.FirstCall THEN
	localState := 0;
END_IF

CASE localState OF
	0:
		Fanuc.ComBrinkFanuc := 0;
		Fanuc.xCheckWriteReg := TRUE;
		IF Fanuc.Init() THEN
			Increment.AnyInt(localState);
		END_IF

	1:
		IF NOT Fanuc.xCheckWriteReg THEN
			Increment.AnyInt(localState);
		END_IF

	2:
		Fanuc.ProgramSelector := Fanuc_Programs.Homing;
		IF Fanuc.StartMainProgram(Fanuc_Programs.MainProgram) THEN
			Increment.AnyInt(localState);
		END_IF

	3:
		IF Fanuc.ProgramRunning = Fanuc_Programs.Homing THEN
			Increment.AnyInt(localState);
		END_IF

	4:
		Fanuc.ProgramSelector := Fanuc_Programs.Standby;
		IF Fanuc.ComFanucBrink = Fanuc_Homing_IN.Finished THEN
			Increment.AnyInt(localState);
		ELSIF Fanuc.ComFanucBrink = Fanuc_Homing_IN.Error THEN
			HomingError := TRUE;
		END_IF

	5:
		Fanuc.ComBrinkFanuc := Fanuc_Homing_OUT.Done;
		IF Fanuc.ComFanucBrink = 0 THEN
			Fanuc.ComBrinkFanuc		:= 0;
			Reset := CommandLock.Release(__POUNAME());
		END_IF
END_CASE
END_METHOD

// Returns status of stack in the Fanuc
METHOD ReturnStack : REFERENCE TO StackStatusType
%FOLDER Commands
ReturnStack		REF= GripperStatus;
END_METHOD

// Write a given stack position to the position structs readable for Fanuc
METHOD PRIVATE SetPlacePosition : BOOL
VAR_INPUT
	StackPosition				: REFERENCE TO Fanuc_StackPosition;				// Stacking position with offsets
END_VAR
VAR
	GripperRotate				: REAL;
END_VAR
%FOLDER Private
PlacePosition._X	:= RealToFanucUInt(StackPosition.PlacePosition.rPosX + Data.Place.Teach.rPosX);
PlacePosition._Y	:= RealToFanucUInt(StackPosition.PlacePosition.rPosY + Data.Place.Teach.rPosY);
PlacePosition._Z	:= RealToFanucUInt(StackPosition.PlacePosition.rPosZ + Data.Place.Teach.rPosZ);
PlacePosition._W	:= RealToFanucUInt(StackPosition.PlacePosition.rPosW + Data.Place.Teach.rPosW);
PlacePosition._P	:= RealToFanucUInt(StackPosition.PlacePosition.rPosP + Data.Place.Teach.rPosP);
PlacePosition._R	:= RealToFanucUInt(StackPosition.PlacePosition.rPosR + Data.Place.Teach.rPosR);

PlaceOffset._X		:= RealToFanucUInt(StackPosition.Offset.rPosX);
PlaceOffset._Y		:= RealToFanucUInt(StackPosition.Offset.rPosY);
PlaceOffset._Z		:= RealToFanucUInt(StackPosition.Offset.rPosZ);

PlaceToolOffset._X	:= RealToFanucUInt(StackPosition.ToolOffset.rPosX);
PlaceToolOffset._Y	:= RealToFanucUInt(StackPosition.ToolOffset.rPosY);
PlaceToolOffset._Z	:= RealToFanucUInt(StackPosition.ToolOffset.rPosZ);

PlaceConfig			:= RealToFanucUInt((StackPosition.Config MOD 2) + 1);	// 1 or 3: FUT, 2 or 4: NUT
END_METHOD

// Command to reset the module (Statemachine to zero state)
METHOD PUBLIC Stop : BOOL	// Returns true when drives are in standstill
%FOLDER Commands
fanucInitNeeded		:= TRUE;
alarmCrashDetected	:= FALSE;
Stop				:= SUPER^.Stop();
END_METHOD

// Manual control of hardware is enabled from external context
{attribute 'monitoring':='call'}
PROPERTY ExternalManualControlEnabled : BOOL
%FOLDER Properties
GET
PROTECTED
VAR
END_VAR
ExternalManualControlEnabled := _manualControlEnabled;
END_GET
SET
_manualControlEnabled := ExternalManualControlEnabled;
END_SET
END_PROPERTY

{attribute 'monitoring':='call'}
// True when Fanuc is blocking the lift
PROPERTY FanucAboveBoxArea : BOOL
%FOLDER Properties
GET
FanucAboveBoxArea	:= NOT Fanuc.I.xSPCFree[6];
END_GET
END_PROPERTY

{attribute 'monitoring':='call'}
// True when Fanuc is in buffer area
PROPERTY FanucInBufferArea : BOOL
%FOLDER Properties
GET
FanucInBufferArea	:= NOT Fanuc.I.xSPCFree[5];
END_GET
END_PROPERTY

PROPERTY PUBLIC StackStatus : REFERENCE TO StackStatusType
%FOLDER Properties
GET
StackStatus		REF= GripperStatus;
END_GET
END_PROPERTY
