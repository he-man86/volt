// Control a stacklight with several colored lamps, and a buzzer
FUNCTION_BLOCK PUBLIC StacklightWithHornFB
EXTENDS StacklightFB
IMPLEMENTS IActuator
VAR_INPUT
	Horn			: LedFB;
END_VAR
(* @volt-implementation *)
// Instantiate the outputs
SUPER^();
Horn();

END_FUNCTION_BLOCK

// Reset all outputs on the stacklight
METHOD Reset
(* @volt-implementation *)
SUPER^.Reset();
Horn.Off();
END_METHOD
