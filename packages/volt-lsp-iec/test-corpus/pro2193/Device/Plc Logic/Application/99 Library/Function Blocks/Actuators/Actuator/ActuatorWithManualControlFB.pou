// Basic actuator with manual control enabled
{attribute 'monitoring_display' := 'Output.output'}
{attribute 'symbol' := 'none'}
FUNCTION_BLOCK PUBLIC ActuatorWithManualControlFB
EXTENDS ActuatorWithManualControl_BaseFB
IMPLEMENTS IActuator
VAR
	{attribute 'symbol' := 'read'}	Output					: ActuatorFB;
END_VAR

%LANGUAGE ST
SUPER^();


END_FUNCTION_BLOCK

METHOD PROTECTED ManualControl
VAR_INPUT
	minButtonPushed			: BOOL;		// Both the software button (on screen) and the hardware button (if attached)
	plusButtonPushed		: BOOL;		// Both the software button (on screen) and the hardware button (if attached)
END_VAR

%LANGUAGE ST
IF plusButtonPushed THEN
	Set();
END_IF

IF minButtonPushed THEN
	Reset();
END_IF

END_METHOD

// Maps the actuator to the physical output
METHOD PUBLIC Map : BOOL

%LANGUAGE ST
Map := Output.Map();

END_METHOD

// Reset the output (=False)
METHOD PUBLIC Reset

%LANGUAGE ST
Output.Reset();

END_METHOD

// Set the output (=True)
METHOD PUBLIC Set : BOOL

%LANGUAGE ST
Output.Set();

END_METHOD

// Set the output True or False
METHOD PUBLIC SetOrReset
VAR_INPUT
	xValue	: BOOL;
END_VAR

%LANGUAGE ST
Output.SetOrReset(xValue);

END_METHOD
