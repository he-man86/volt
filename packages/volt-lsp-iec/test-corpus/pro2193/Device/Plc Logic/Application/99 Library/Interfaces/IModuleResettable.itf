// Commands that are used by all modules / units
INTERFACE IModuleResettable
EXTENDS IAbleToRegister, __SYSTEM.IQueryInterface

// Command to reset the module. Servodrives are homed.
METHOD PUBLIC Reset : BOOL	// Returns true when homing done
END_METHOD

// The order in which the modules are homed.
{attribute 'monitoring':='call'}
PROPERTY PUBLIC ResetCondition1 : IModuleResettable
END_PROPERTY

// The order in which the modules are homed.
{attribute 'monitoring':='call'}
PROPERTY PUBLIC ResetCondition2 : IModuleResettable
END_PROPERTY

END_INTERFACE
