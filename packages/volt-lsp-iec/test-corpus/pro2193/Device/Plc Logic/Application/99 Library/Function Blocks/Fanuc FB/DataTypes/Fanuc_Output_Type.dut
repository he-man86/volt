TYPE Fanuc_Output_Type :
STRUCT
	// User outputs (inputs at Fanuc side)
	xIMSTP				: BOOL;
	xHold				: BOOL;
	xSFSPD				: BOOL;
	xCycleStop			: BOOL;
	xFaultReset			: BOOL;
	xStart				: BOOL;
	xHome				: BOOL;
	xEnable				: BOOL;
	uiRsr_pns			: UINT;
	xPnsStrobe			: BOOL;
	xProdStart			: BOOL;

	// Digital outputs
	xEnableCPC			: ARRAY[1..16] OF BOOL;
	xEnableSPC			: ARRAY[1..10] OF BOOL;
	byRobotOutputs		: BYTE;
	xWriteReg			: BOOL;
	uiRegChangeHigh		: UINT;
	uiRegChangeLow		: UINT;
	uiRegChangeFactor	: UINT;
	uiRegChangeNumber	: UINT;
	arGroupOutputs		: ARRAY[7..40] OF UINT;
END_STRUCT
END_TYPE
