// Control a stacklight with several colored lamps, and a buzzer
FUNCTION_BLOCK PUBLIC StacklightFB
IMPLEMENTS IActuator
VAR_INPUT
	Green			: LedFB;
	Amber			: LedFB;
	Red				: LedFB;
END_VAR
VAR
END_VAR

%LANGUAGE ST
// Instantiate the outputs
Green();
Amber();
Red();


END_FUNCTION_BLOCK

// Maps the actuator to the physical output
{attribute 'hide'}
METHOD PUBLIC Map : BOOL

%LANGUAGE ST
// no implementation
END_METHOD

// Reset all outputs on the stacklight
METHOD Reset

%LANGUAGE ST
Green.Off();
Amber.Off();
Red.Off();

END_METHOD

// Set the output (=True)
{attribute 'hide'}
METHOD Set : BOOL

%LANGUAGE ST
// no implementation
END_METHOD

// Set the output True or False
{attribute 'hide'}
METHOD SetOrReset
VAR_INPUT
	xValue	: BOOL;
END_VAR

%LANGUAGE ST
// no implementation
END_METHOD
