FUNCTION_BLOCK FREQ_MEASURE
VAR_INPUT
	IN : BOOL;
	PERIODS : INT (1..10) := 1;
	RESET : BOOL;
END_VAR
VAR_OUTPUT
	OUT : REAL;
	VALID : BOOL;
END_VAR
VAR
	OLDIN : BOOL;
	_INIT : BOOL;
	OLDT : TIME;
	DIFF : DWORD;
	ADIFF : ARRAY [0..9] OF DWORD;
	V : INT;
	B : INT;
	I : INT;
END_VAR
END_FUNCTION_BLOCK