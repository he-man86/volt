FUNCTION_BLOCK L_IE1P_ERRORHANDLER
VAR_INPUT
	ADDERRORHANDLER1 : L_IE1P_IErrorHandler;
	ADDERRORHANDLER2 : L_IE1P_IErrorHandler;
	ADDERRORHANDLER3 : L_IE1P_IErrorHandler;
	ADDERRORHANDLER4 : L_IE1P_IErrorHandler;
END_VAR
VAR_OUTPUT
	XWARNINGACTIVE : BOOL;
	XWARNINGLOCKACTIVE : BOOL;
	XFAULTQSPAPPLACTIVE : BOOL;
	XFAULTQSPACTIVE : BOOL;
	XFAULTQSPCINHACTIVE : BOOL;
	XFAULTACTIVE : BOOL;
END_VAR
VAR
	ERRORMANAGER : L_IE1P_ErrorManager;
	ADDERRORHANDLERINSTANCEIDS : ARRAY [1..MaxInstanceIDs] OF L_IE1P_InstanceIDs;
	ERRORRESETOCCUREDTIME : SysTime;
	C_STRUNDEFERROR : STRING := 'undefined';
	MAXINSTANCEIDS : WORD := 15;
END_VAR
END_FUNCTION_BLOCK