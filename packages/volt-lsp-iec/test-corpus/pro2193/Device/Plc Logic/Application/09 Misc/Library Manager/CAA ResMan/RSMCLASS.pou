FUNCTION_BLOCK RSMCLASS
VAR
	_HPOOL : CAA.HANDLE;
	_ADWPOOL : ARRAY [0..19] OF __XWORD;
	_PLIST : POINTER TO RSM_HANDLE;
END_VAR
END_FUNCTION_BLOCK

METHOD FB_EXIT : BOOL
VAR_INPUT
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD REGISTER : CAA.HANDLE
VAR_INPUT
	HHANDLE : CAA.HANDLE;
	PEERROR : POINTER TO ERROR;
END_VAR
END_METHOD

METHOD CLOSE : ERROR
VAR_INPUT
	HHANDLE : CAA.HANDLE;
END_VAR
END_METHOD

METHOD SEARCH : CAA.HANDLE
VAR_INPUT
	HHANDLE : CAA.HANDLE;
END_VAR
END_METHOD

METHOD UNREGISTER : ERROR
VAR_INPUT
	HHANDLE : CAA.HANDLE;
END_VAR
END_METHOD

METHOD FB_INIT : BOOL
VAR_INPUT
	BINITRETAINS : BOOL;
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD TRANSLATE : CAA.HANDLE
VAR_INPUT
	HHANDLE : CAA.HANDLE;
END_VAR
VAR_OUTPUT
	EERROR : ERROR;
END_VAR
END_METHOD