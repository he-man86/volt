INTERFACE ICREDENTIALSPROVIDER
END_INTERFACE

METHOD GETCREDENTIALS : UDINT
VAR_INPUT
	UDIREQUESTID : UDINT;
END_VAR
VAR_OUTPUT
	STUSERNAME : STRING;
	STPASSWORD : STRING;
END_VAR
END_METHOD

METHOD ISGETCREDENTIALSFINISHED : UDINT
VAR_INPUT
	UDIREQUESTID : UDINT;
END_VAR
END_METHOD

METHOD LOGINFAILED : UDINT
VAR_INPUT
	UDIREQUESTID : UDINT;
END_VAR
VAR_OUTPUT
	UDIRETRYWAITTIME : UDINT;
END_VAR
END_METHOD

METHOD STARTGETCREDENTIALS : UDINT
VAR_INPUT
	PSTDATASOURCE : POINTER TO STRING;
END_VAR
VAR_OUTPUT
	UDIERRORCODE : UDINT;
END_VAR
END_METHOD