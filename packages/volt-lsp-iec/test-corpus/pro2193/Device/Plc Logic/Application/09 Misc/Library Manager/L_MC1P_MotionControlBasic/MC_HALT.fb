FUNCTION_BLOCK MC_HALT EXTENDS L_MC1P_Template_Move
VAR_INPUT
	EXECUTE : BOOL;
	DECELERATION : LREAL;
	JERK : LREAL;
	BUFFERMODE : MC_BUFFER_MODE;
END_VAR
VAR_OUTPUT
	DONE : BOOL;
	BUSY : BOOL;
	ACTIVE : BOOL;
	COMMANDABORTED : BOOL;
	ERROR : BOOL;
	ERRORID : L_IE1P_Error;
END_VAR
VAR
	HALT : L_MC1P_Halt_Internal;
	XABORTHOMINGALLOWED : BOOL := FALSE;
	ABORTHOMINGALLOWED : BOOL;
	GETMOVEBASICP : POINTER TO L_MC1P_MoveBasic;
END_VAR
END_FUNCTION_BLOCK