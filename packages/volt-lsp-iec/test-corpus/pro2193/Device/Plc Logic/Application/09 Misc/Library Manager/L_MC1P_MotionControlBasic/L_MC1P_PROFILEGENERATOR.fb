FUNCTION_BLOCK L_MC1P_PROFILEGENERATOR
VAR_INPUT
	SCPROFILEPARAMETER : L_MC1P_ProfileParameter;
	XEXECUTE : BOOL;
	XAUXEXECUTE : BOOL;
	XABORT : BOOL;
	XVELMODE : BOOL;
	LRSTARTPOS : LREAL;
	LRSTARTVEL : LREAL;
	LRSTARTACC : LREAL;
END_VAR
VAR_OUTPUT
	XDONE : BOOL;
	XBUSY : BOOL;
	XABORTED : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	LRSETPOSOUT : LREAL;
	LRSETVELOUT : LREAL;
	LRSETACCOUT : LREAL;
END_VAR
VAR
	L_MC1P_POSPROFILER1 : L_MC1P_PosProfiler;
	LRTASKCYCLE : LREAL;
	LRINVTASKCYCLE : LREAL;
	XERROROLD : BOOL;
	ALRDUMMY : ARRAY [0..8] OF LREAL;
	PROFILEPHASESTIME : ARRAY [0..8] OF LREAL;
	PROFILETIME : TIME;
	REMAININGTIMEOFPROFILE : LREAL;
	REMAININGTIMEOFPROFILEAVAILABLE : BOOL;
END_VAR
END_FUNCTION_BLOCK