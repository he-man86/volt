TYPE SOCK_ADAPTER_INFORMATION3 :
STRUCT
	UDISTRUCTSIZE : UDINT;
	UDIVERSION : UDINT;
	UDIINDEX : UDINT;
	UDIRESERVED : UDINT;
	WSNAME : WSTRING(ADAPTER_INFO_NAME_LEN);
	WSDESCRIPTION : WSTRING(ADAPTER_INFO_DESC_LEN);
	ABYMAC : ARRAY [0..(ADAPTER_INFO_MAC_ADDR_LENGTH - 1)] OF BYTE;
	WTYPE : WORD;
	DWFLAGS : DWORD;
	IPADDR : INADDR;
	NETMASK : INADDR;
	DEFAULTGATEWAY : INADDR;
	PRIMARYNAMESERVER : INADDR;
	SECONDARYNAMESERVER : INADDR;
	WSDNSSUFFIX : WSTRING(ADAPTER_INFO_DNSSUFFIX_LEN);
	DHCPSERVER : INADDR;
	UDIOSINDEX : UDINT;
END_STRUCT
END_TYPE