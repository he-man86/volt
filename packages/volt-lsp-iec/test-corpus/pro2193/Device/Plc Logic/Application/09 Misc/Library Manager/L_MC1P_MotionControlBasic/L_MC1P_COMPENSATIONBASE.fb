FUNCTION_BLOCK L_MC1P_COMPENSATIONBASE EXTENDS L_MC1P_ManipulationBase
END_FUNCTION_BLOCK

METHOD CONNECTTOAXIS
VAR_IN_OUT
	AXIS : Axis_Ref;
END_VAR
END_METHOD

METHOD DISCONNECTFROMAXIS
VAR_IN_OUT
	AXIS : Axis_Ref;
END_VAR
END_METHOD

METHOD FILTERSTARTCONDITION
VAR_INPUT
	LRSETPOS : LREAL;
	LRSETVEL : LREAL;
	LRSETACC : LREAL;
END_VAR
VAR_IN_OUT
	AXIS : Axis_Ref;
END_VAR
END_METHOD

METHOD GETOFFSETVALUES
VAR_OUTPUT
	LROFFSETPOS : LREAL;
	LROFFSETVEL : LREAL;
	LROFFSETACC : LREAL;
END_VAR
END_METHOD