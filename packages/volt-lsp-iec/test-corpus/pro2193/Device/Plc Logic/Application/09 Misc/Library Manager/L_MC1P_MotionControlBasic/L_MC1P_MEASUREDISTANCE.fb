FUNCTION_BLOCK L_MC1P_MEASUREDISTANCE EXTENDS L_MC1P_Template
VAR_INPUT
	XENABLE : BOOL;
	EMC_SOURCE : MC_SOURCE;
END_VAR
VAR_OUTPUT
	XVALID : BOOL;
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	LRDISTANCE : LREAL;
END_VAR
VAR
	EMC_SOURCE_INT : MC_SOURCE;
	XENABLEOLD : BOOL := FALSE;
	XINITDONE : BOOL := FALSE;
	LRSTARTPOS : LREAL;
	LRPOSNEW : LREAL;
	LRPOSOLD : LREAL;
	LRROUNDS : LREAL;
	LRDIFF : LREAL;
END_VAR
END_FUNCTION_BLOCK