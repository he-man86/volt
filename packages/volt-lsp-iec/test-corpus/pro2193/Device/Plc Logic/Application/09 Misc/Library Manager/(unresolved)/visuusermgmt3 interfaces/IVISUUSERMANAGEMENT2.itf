INTERFACE IVISUUSERMANAGEMENT2
END_INTERFACE

METHOD LOGINTOUSERGROUP : BOOL
VAR_INPUT
	PCLIENT : POINTER TO BYTE;
	DWGROUPID : DWORD;
	WSTUSERNAME : WSTRING(79);
	WSTFULLNAME : WSTRING(79);
END_VAR
END_METHOD

METHOD LOGINTOUSERGROUPS : BOOL
VAR_INPUT
	PCLIENT : POINTER TO BYTE;
	PADWUSERGROUPIDS : POINTER TO ARRAY [0..0] OF DWORD;
	DWUSERGROUPCOUNT : DWORD;
	WSTUSERNAME : WSTRING(79);
	WSTFULLNAME : WSTRING(79);
END_VAR
END_METHOD