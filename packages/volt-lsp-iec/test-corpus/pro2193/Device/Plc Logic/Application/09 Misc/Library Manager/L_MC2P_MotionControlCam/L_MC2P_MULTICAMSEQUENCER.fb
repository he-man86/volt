FUNCTION_BLOCK L_MC2P_MULTICAMSEQUENCER
VAR_INPUT
	XENABLE : BOOL;
	XCAMSEQUENCER : BOOL;
	EMODE : L_MC2P_CamSequenceMode;
	XCAMCHANGEINSTANT : BOOL;
	ESETCAMTABLE : L_MC2P_CamTable;
	XENDOFPROFILEIN : BOOL;
	CAMTABLE1 : MC_CAM_REF;
	CAMTABLE2 : MC_CAM_REF;
	CAMTABLE3 : MC_CAM_REF;
	CAMTABLE4 : MC_CAM_REF;
END_VAR
VAR_OUTPUT
	XDONE : BOOL;
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	ESETCAMTABLEOUT : L_MC2P_CamTable;
	CAMTABLEOUT : MC_CAM_REF;
END_VAR
VAR
	EFMSTATE : L_MC2P_States := L_MC2P_States.INIT;
	XINITSTATE : BOOL;
	XENABLE_OLD : BOOL;
	XLOADCAMTABLE_OLD : BOOL;
	XENDOFPROFILEIN_OLD : BOOL;
	XCAMSEQUENCER_OLD : BOOL;
	XCAMCHANGEINSTANT_OLD : BOOL;
	XCAMSEQUENCERACTIVE : BOOL;
END_VAR
END_FUNCTION_BLOCK