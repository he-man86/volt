FUNCTION_BLOCK L_MC4P_GROUPMANUALMODE EXTENDS L_MC4P_Template_AG_KIN
VAR_INPUT
	ALRSETPOSDIST : ARRAY [1..12] OF LREAL;
	SCPAR : L_MC4P_GroupManualMode_Parameter;
	ECOORDSYSTEM : L_MC4P_CoordSystem;
	AXJOGPOS : ARRAY [1..12] OF BOOL;
	AXJOGNEG : ARRAY [1..12] OF BOOL;
	AXMOVEABSEXECUTE : ARRAY [1..12] OF BOOL;
	AXMOVERELEXECUTE : ARRAY [1..12] OF BOOL;
END_VAR
VAR_OUTPUT
	XINTERNALCONTROLACTIVE : BOOL;
	XBUSY : BOOL;
	XDONE : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	EMANUALMODE : L_MC4P_ManualMode := L_MC4P_ManualMode.Standby;
END_VAR
VAR
