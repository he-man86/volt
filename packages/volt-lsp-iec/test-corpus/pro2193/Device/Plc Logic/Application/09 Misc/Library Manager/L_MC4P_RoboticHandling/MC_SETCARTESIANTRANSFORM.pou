FUNCTION_BLOCK MC_SETCARTESIANTRANSFORM EXTENDS L_MC4P_Template_AG_KIN
VAR_INPUT
	EXECUTE : BOOL;
	COORDSYSTEM : L_MC4P_CoordSystem;
	TRANSX : LREAL;
	TRANSY : LREAL;
	TRANSZ : LREAL;
	ROTANGLE1 : LREAL;
	ROTANGLE2 : LREAL;
	ROTANGLE3 : LREAL;
END_VAR
VAR_OUTPUT
	DONE : BOOL;
	BUSY : BOOL;
	ACTIVE : BOOL;
	COMMANDABORTED : BOOL;
	ERROR : BOOL;
	ERRORID : L_IE1P_Error;
END_VAR
VAR
	PCOORDTRAFO : POINTER TO L_MC4P_CoordTrafo;
	XEXECUTEOLD : BOOL;
	XRESETOUTPUT : BOOL;
	ISTATE : INT;
	BSTATEMACHINE : BOOL;
	PTRACKINGPARAM : POINTER TO L_MC4P_PCSTrackParam;
	ALRPARAMFREEZE : ARRAY [1..6] OF LREAL;
	AXPARACCESSIBLE : ARRAY [1..7] OF BOOL;
	IDX : DINT;
	XINTERNALTESTMODE : BOOL := FALSE;
	INTERNALTESTMODE : BOOL;
END_VAR
END_FUNCTION_BLOCK