TYPE OPCUA_REGISTEREDSERVER :
STRUCT
	SERVERURI : OpcUa_String;
	PRODUCTURI : OpcUa_String;
	NOOFSERVERNAMES : OpcUa_Int32;
	SERVERNAMES : POINTER TO OpcUa_LocalizedText;
	SERVERTYPE : OpcUa_ApplicationType;
	GATEWAYSERVERURI : OpcUa_String;
	NOOFDISCOVERYURLS : OpcUa_Int32;
	DISCOVERYURLS : POINTER TO OpcUa_String;
	SEMAPHOREFILEPATH : OpcUa_String;
	ISONLINE : OpcUa_Boolean;
END_STRUCT
END_TYPE