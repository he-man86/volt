FUNCTION_BLOCK TCPCONNECTION EXTENDS Element
VAR
	TCPSTREAM : TCP.Stream;
	HSOCKET : SysTypes.RTS_IEC_HANDLE := SysTypes.RTS_INVALID_HANDLE;
	ESTATE : CONNECTION_STATE := CONNECTION_STATE.LISTEN;
	_PUSHBACK1READBYTE_DATA : BYTE;
	_PUSHBACK1READBYTE_CALLED : BOOL;
	PRVSOCKETHANDLE : RTS_IEC_HANDLE;
	PRVSTATE : CONNECTION_STATE;
	PRVSTREAM : POINTER TO TCP.Stream;
END_VAR
END_FUNCTION_BLOCK

METHOD FB_EXIT : BOOL
VAR_INPUT
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD SETPUSHBACK1READBYTE
VAR_INPUT
	DATA : BYTE;
	CALLED : BOOL;
END_VAR
END_METHOD

METHOD PRVCLOSE : ERROR
VAR_INPUT
	XDUMMY : BOOL;
END_VAR
END_METHOD

METHOD PRVESTABLISH : ERROR
END_METHOD