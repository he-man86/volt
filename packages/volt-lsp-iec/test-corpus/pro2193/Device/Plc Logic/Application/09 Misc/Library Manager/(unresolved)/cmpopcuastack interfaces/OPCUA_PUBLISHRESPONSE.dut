	AVAILABLESEQUENCENUMBERS : POINTER TO OpcUa_UInt32;
	MORENOTIFICATIONS : OpcUa_Boolean;
	NOTIFICATIONMESSAGE : OpcUa_NotificationMessage;
	NOOFRESULTS : OpcUa_Int32;
	RESULTS : POINTER TO OpcUa_StatusCode;
	NOOFDIAGNOSTICINFOS : OpcUa_Int32;
