FUNCTION_BLOCK MONITORBOOLEAN EXTENDS MonitorBase
VAR
	REFINPUT : REFERENCE TO BOOL;
	OLDVALUE : BOOL;
END_VAR
END_FUNCTION_BLOCK

METHOD INITIALIZE
VAR_INPUT
	PLCDATATYPE : PlcDataType;
	REFINPUT : REFERENCE TO BOOL;
	SENDONEDGEPCCONNECT : BOOL := FALSE;
	SENDONINTERVAL : TIME := TIME#0ms;
END_VAR
END_METHOD