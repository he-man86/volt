FUNCTION_BLOCK EDGEPCCLIENT
VAR_INPUT
	SERSERIALNO : STRING(10);
	IPV4ADDRESS : STRING(15);
	PORT : UINT;
	CONNECT : BOOL;
	LOGCACHE : REFERENCE TO LogCache;
	STRINGLOGCACHE : REFERENCE TO StringLogCache;
	CONNSPEED : ConnectionSpeed;
	CYCLEMS : BYTE;
END_VAR
VAR
	LOGCACHEREFVALID : BOOL;
	STRINGLOGCACHEREFVALID : BOOL;
	TCPCLIENT : NBS.TCP_Client;
	IPADDRESS : NBS.IP_ADDR;
	TCPCLIENTACTIVE : BOOL;
	TCPWRITE : NBS.TCP_Write;
	TCPREAD : NBS.TCP_Read;
	TCPREADBUFFER : ARRAY [1..256] OF BYTE;
	TCPREADBUFFERSIZE : __UXINT;
	STATE : TcpClientState;
	CURRENTTIME : ULINT;
	RECONNECTTIMER : TON;
	RECONNECTDELAY : TIME;
	CONNECTTIMER : TON;
	DEBUGMODE : BOOL;
	DEBUGLOGS : ARRAY [1..DashboardParameters.NumberOfDebugLogRecords] OF DebugLogInfo;
	DEBUGLOGINDEX : USINT;
	STATISTICS : ClientStatistics;
	KEEPALIVETIMER : TOF;
	AUTOCLOSETIMER : TOF;
	AUTOCLOSETIMERACTIVE : BOOL;
	LONGDISCONNECTTIMER : TON;
	DISCONNECTEDSTATE : BOOL;
	I : INT;
	SENDARR : ARRAY [1..GVL_Dashboard.TCPSendArrayLength] OF BYTE;
	SENDARRLOCK : DWORD;
	WRITESPERCYCLE : BYTE;
	MAXWRITESPERCYCLE : BYTE;
	NOTALLDATAWRITTEN : BOOL;
	TOTALSTART : ULINT;
	TOTALEND : ULINT;
	TOTALTIME : ULINT;
	MAXWRITETIME : ULINT;
	KEEPALIVEINTERVAL : TIME;
	AUTOCLOSEINTERVAL : TIME;
	MINRECONNECTINTERVAL : TIME;
	BOOLDATATYPE : DataType;
	LINTDATATYPE : DataType;
	ULINTDATATYPE : DataType;
	LREALDATATYPE : DataType;
	BUSY : BOOL;
	CONNECTED : BOOL;
	CURRENTTIMEMS : ULINT;
	LONGDISCONNECTED : BOOL;
END_VAR
END_FUNCTION_BLOCK