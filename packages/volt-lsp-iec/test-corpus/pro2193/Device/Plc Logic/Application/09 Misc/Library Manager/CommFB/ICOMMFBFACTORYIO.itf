INTERFACE ICOMMFBFACTORYIO
END_INTERFACE

METHOD CHECKOWNER : BOOL
VAR_INPUT
	ID : UDINT;
END_VAR
END_METHOD

METHOD GETINPUTDATA : DWORD
VAR_INPUT
	ID : DWORD;
	OFFSET : UINT;
	LEN : UINT;
	INPUTS : POINTER TO BYTE;
END_VAR
VAR_OUTPUT
	IO_LEN : UINT;
	CONSISTENCY : BOOL;
END_VAR
END_METHOD

METHOD PUTOUTPUTDATA : DWORD
VAR_INPUT
	ID : DWORD;
	OFFSET : UINT;
	LEN : UINT;
	OUTPUTS : POINTER TO BYTE;
END_VAR
VAR_OUTPUT
	IO_LEN : UINT;
	CONSISTENCY : BOOL;
END_VAR
END_METHOD