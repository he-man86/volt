FUNCTION_BLOCK L_TB2A_PROFILEMANAGER
VAR_INPUT
	XEXECUTE : BOOL;
	XABORT : BOOL;
	WSTARTNUMBER : WORD;
	XNEXTPROFILE : BOOL;
END_VAR
VAR_OUTPUT
	XBUSY : BOOL;
	XDONE : BOOL;
	XABORTED : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	XPROFILEERROR : BOOL;
	EPROFILEERRORID : L_IE1P_Error;
	WACTPROFILE : WORD;
	PACTPROFILE : POINTER TO L_TF2P_scPositionProfile;
	XHASNEXT : BOOL;
	XRTRIG : BOOL;
	EPROFILETYPE : L_MC1P_TypeFunction;
	XMOVEABS : BOOL;
	XMOVEREL : BOOL;
	XMOVEVEL : BOOL;
	XMOVECONTABS : BOOL;
	XMOVECONTREL : BOOL;
	XTPINSIDEWINDOW : BOOL;
	XTPOUTSIDEWINDOW : BOOL;
	XTPMISSED : BOOL;
	EDIRECTION : MC_DIRECTION;
END_VAR
VAR_IN_OUT
	ASCPROFILES : ARRAY [1..15] OF L_TF2P_scPositionProfile;
	SCTPRECDATA : L_MC1P_TpReceiveData;
	AXIS : AXIS_REF;
END_VAR
VAR
	_MODEL : L_UBUP_BehaviourModel_ETrigA;
