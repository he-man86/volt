FUNCTION_BLOCK MEASUREFREQUENCE
VAR_INPUT
	XENABLE : BOOL;
	XINPUT : BOOL;
	USIPERIODS : USINT (1..10) := 1;
END_VAR
VAR_OUTPUT
	LRFREQUENCY : LREAL;
	XVALID : BOOL;
END_VAR
VAR
	TIMOLD : TIME;
	T2 : TIME;
	UDIDIFF : UDINT;
	AUDIDIFF : ARRAY [0..9] OF UDINT;
	IV : INT;
	IB : INT;
	I : INT;
	XOLDENABLE : BOOL;
	XOLDINPUT : BOOL;
	USIOLDPERIODS : USINT;
END_VAR
END_FUNCTION_BLOCK