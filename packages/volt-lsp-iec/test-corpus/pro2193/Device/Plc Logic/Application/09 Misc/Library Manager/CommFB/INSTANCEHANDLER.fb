FUNCTION_BLOCK INSTANCEHANDLER
VAR
	S_INSTANCECOUNT : UINT;
	S_FACTORIES : ARRAY [0..(MAX_INSTANCES - 1)] OF ICommFBFactory;
	S_FACTORIESEXT : ARRAY [0..(MAX_INSTANCES - 1)] OF ICommFBFactoryExt;
	S_FACTORIESIO : ARRAY [0..(MAX_INSTANCES - 1)] OF ICommFBFactoryIO;
	S_FACTORIESCONNECTIONS : ARRAY [0..(MAX_INSTANCES - 1)] OF ICommFBConnectionManagerFactory;
	S_FIELDDEVICES : ARRAY [0..(MAX_INSTANCES - 1)] OF ICommFBFieldDevice;
	S_GENERICIDFACTORIES : ARRAY [0..(MAX_INSTANCES - 1)] OF IGenericIDFactory;
	S_IDS : UDINT := (MAX_INSTANCES - 1);
	S_DIAGPROVIDERS : ARRAY [0..(MAX_INSTANCES - 1)] OF ICommFBDiagProvider;
	MAX_INSTANCES : UINT := 8;
END_VAR
END_FUNCTION_BLOCK

METHOD CREATEID : UDINT
END_METHOD

METHOD GETCONNECTIONMANAGERFACTORY : UDINT
VAR_OUTPUT
	FACTORY : ICommFBConnectionManagerFactory;
END_VAR
VAR_IN_OUT
	D_ADDR : ADDR_TYPE;
END_VAR
END_METHOD

METHOD GETDIAGFACTORY : UDINT
VAR_INPUT
	ID : UDINT;
END_VAR
VAR_OUTPUT
	DIAGPROVIDER : ICommFBDiagProvider;
END_VAR
END_METHOD

METHOD GETFACTORY : ICommFBFactory
VAR_INPUT
	ID : UDINT;
END_VAR
END_METHOD

METHOD GETFIELDDEVICE : DWORD
VAR_INPUT
	ID : UDINT;
END_VAR
VAR_OUTPUT
	FIELDDEVICE : ICommFBFieldDevice;
END_VAR
END_METHOD

METHOD GETIOFACTORY : UDINT
VAR_INPUT
	ID : UDINT;
END_VAR
VAR_OUTPUT
	FACTORY : ICommFBFactoryIO;
END_VAR
END_METHOD

METHOD REGISTER : UINT
VAR_INPUT
	FACTORY : ICommFBFactory;
END_VAR
END_METHOD

METHOD REGISTERDIAG : UINT
VAR_INPUT
	FACTORY : ICommFBFactory;
	DIAGPROVIDER : ICommFBDiagProvider;
END_VAR
END_METHOD

METHOD REGISTEREXT : UINT
VAR_INPUT
	FACTORY : ICommFBFactory;
	DIAGPROVIDER : ICommFBDiagProvider;
	FACTORYEXT : ICommFBFactoryExt;
END_VAR
END_METHOD

METHOD REGISTEREXTIO : UINT
VAR_INPUT
	FACTORY : ICommFBFactory;
	DIAGPROVIDER : ICommFBDiagProvider;
	FACTORYEXT : ICommFBFactoryExt;
	UPDATEIO : ICommFBFactoryIO;
END_VAR
END_METHOD

METHOD REGISTERFIELDDEVICE : UINT
VAR_INPUT
	FACTORY : ICommFBFactory;
	FACTORYEXT : ICommFBFactoryExt;
	DEVICE : ICommFBFieldDevice;
END_VAR
END_METHOD

METHOD REGISTERINTERFACES : UINT
VAR_INPUT
	FACTORY : ICommFBFactory;
	DIAGPROVIDER : ICommFBDiagProvider;
	FACTORYEXT : ICommFBFactoryExt;
	UPDATEIO : ICommFBFactoryIO;
	CNCT : ICommFBConnectionManagerFactory;
END_VAR
END_METHOD