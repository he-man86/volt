INTERFACE L_MC1P_IPOSPROFILECALCULATION
END_INTERFACE

METHOD CALCPROFILEDATA
VAR_INPUT
	PPOSPROFILERDATA : POINTER TO L_MC1P_PosProfiler;
	LRSTARTACC : LREAL;
	LRSTARTVEL : LREAL;
	LRSTARTPOS : LREAL;
	XVELMODE : BOOL;
END_VAR
VAR_OUTPUT
	XERROR : BOOL;
	DWSTATE : DWORD;
	DWPROFILETYPE : DWORD;
END_VAR
VAR_IN_OUT
	SCPROFILEDATA : L_MC1P_ProfileData;
	SCPROFILEPARAMETER : L_MC1P_ProfileParameter;
END_VAR
END_METHOD

METHOD PROFILEINTERPOLATOR : BOOL
VAR_INPUT
	PPOSPROFILERDATA : POINTER TO L_MC1P_PosProfiler;
	LREVALTIME : LREAL;
END_VAR
VAR_OUTPUT
	DWSTATE : DWORD;
	LRSETPOS : LREAL;
	LRSETVEL : LREAL;
	LRSETACC : LREAL;
END_VAR
VAR_IN_OUT
	SCPROFILEDATA : L_MC1P_ProfileData;
END_VAR
END_METHOD

METHOD STRETCHPROFILE
VAR_INPUT
	PPOSPROFILERDATA : POINTER TO L_MC1P_PosProfiler;
	LRTIMEBASE : LREAL;
END_VAR
VAR_IN_OUT
	SCPROFILEDATA : L_MC1P_ProfileData;
END_VAR
END_METHOD