INTERFACE L_MC4P_ICLUTCH
END_INTERFACE

METHOD CYCLECLUTCH : L_MC4P_TrackKinematicsStates
VAR_INPUT
	SCMASTER : L_MC4P_AxisProfile;
END_VAR
VAR_OUTPUT
	EERRORID : L_IE1P.L_IE1P_Error;
END_VAR
END_METHOD

METHOD GETACTUALMASTER
VAR_OUTPUT
	SCACTUALMASTER : L_MC4P_AxisProfile;
	EERRORID : L_IE1P.L_IE1P_Error;
END_VAR
END_METHOD

METHOD GETACTUALSLAVE
VAR_OUTPUT
	PACTUALSLAVE : POINTER TO L_MC4P_AxisProfile;
	DWSLAVECOUNT : DWORD;
	EERRORID : L_IE1P.L_IE1P_Error;
END_VAR
END_METHOD

METHOD STARTCLUTCH
VAR_INPUT
	LRMASTERSTART : LREAL;
	LRCYCLELENGTH : LREAL;
	LRSLAVEFINAL : LREAL;
	LRGEARRATIO : LREAL;
	LRCLUTCHDISTANCE : LREAL;
	ECLUTCHDIR : MC_DIRECTION;
	PSLAVESTART : POINTER TO L_MC4P_AxisProfile;
	DWSLAVECOUNT : DWORD;
END_VAR
VAR_OUTPUT
	EERRORID : L_IE1P.L_IE1P_Error;
END_VAR
END_METHOD

METHOD STOPCLUTCH
VAR_INPUT
	LRDECLUTCHDISTANCE : LREAL;
END_VAR
END_METHOD