	ORIGIN_X1_PTP : ARRAY [1..6] OF LREAL;
	X0 : ARRAY [1..6] OF LREAL;
	X1 : ARRAY [1..6] OF LREAL;
	X0_PTP : ARRAY [1..6] OF LREAL;
	X1_PTP : ARRAY [1..6] OF LREAL;
