FUNCTION_BLOCK MD5
VAR_INPUT
	XEXECUTE : BOOL;
	PMEMORYBLOCK : POINTER TO BYTE;
	UDINUMBEROFBYTES : UDINT;
END_VAR
VAR_OUTPUT
	XDONE : BOOL;
	XBUSY : BOOL;
	ABYDIGEST : ARRAY [0..15] OF BYTE;
END_VAR
VAR
	UDINUMBEROFBYTEPERSEGMENT : UDINT := 64;
	XEXECUTEOLD : BOOL;
	UISTEP : UINT;
	UDINUMBEROFBYTESTOTAL : UDINT;
	UILOOP : UINT;
	UDINUMBEROFBYTESUPDATED : UDINT;
	UINUMBEROFSEGMENTS : UINT;
	ADWSTATE : ARRAY [0..3] OF DWORD;
	ADWCOUNT : ARRAY [0..1] OF DWORD;
	ABYBUFFER : ARRAY [0..63] OF BYTE;
	PINPUT : POINTER TO BYTE;
	UDILENGTH : UDINT;
	UDIINDEX : UDINT;
	UDIPARTLEN : UDINT;
	UDIINPUTOFFSET : UDINT;
	INDEX : UDINT;
	PADLEN : UDINT;
	ABYBITS : ARRAY [0..7] OF BYTE;
	ABYPADDING : ARRAY [0..63] OF BYTE := [1(BYTE#16#80)];
END_VAR
END_FUNCTION_BLOCK