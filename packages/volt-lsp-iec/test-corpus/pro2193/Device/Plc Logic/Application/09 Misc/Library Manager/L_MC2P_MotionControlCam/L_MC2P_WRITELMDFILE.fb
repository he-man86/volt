	XDONE_INT : BOOL;
	XERROR_INT : BOOL;
	EERRORID_INT : L_IE1P_Error;
	XEXECUTEOLD : BOOL;
	HFILE : SYSFILE.RTS_IEC_HANDLE;
	RES : SYSFILE.RTS_IEC_RESULT;
	ID : L_MC2P_Magic;
	DWLENGTH : DWORD;
	XACTIVECRYPTING : BOOL;
	CRYPT : Crypting;
	CK : ARRAY [0..3] OF ULINT;
	CCYCLES : WORD;
	DICDATAWRITE : DINT;
	DWSTARTCDATA : DWORD;
	ABDATA : ARRAY [0..15] OF BYTE;
	DATAIDX : DWORD;
	AVAILABLEDATA : DWORD;
	XDATAWRITEDONE : BOOL;
	UDIFSIZE : UDINT;
	UDIFBYTESWRITE : UDINT;
	RELOAD : BOOL;
END_VAR
END_FUNCTION_BLOCK

