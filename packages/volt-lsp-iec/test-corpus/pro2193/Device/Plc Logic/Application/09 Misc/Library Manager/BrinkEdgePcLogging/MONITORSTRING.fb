FUNCTION_BLOCK MONITORSTRING EXTENDS MonitorBase
VAR
	REFINPUT : Stu.CharBufferPtr;
	REFINPUTLENGTH : DINT;
	CURRENTVALUE : STRING(255);
	OLDVALUE : STRING(255);
	COMPARERESULT : INT;
END_VAR
END_FUNCTION_BLOCK

METHOD INITIALIZE
VAR_INPUT
	PLCDATATYPE : PlcDataType;
	REFINPUT : Stu.CharBufferPtr;
	SENDONEDGEPCCONNECT : BOOL := FALSE;
	SENDONINTERVAL : TIME := TIME#0ms;
END_VAR
END_METHOD