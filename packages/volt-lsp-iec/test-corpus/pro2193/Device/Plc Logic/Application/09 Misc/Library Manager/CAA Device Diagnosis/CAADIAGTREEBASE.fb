FUNCTION_BLOCK CAADIAGTREEBASE
VAR
	M_PARENT : POINTER TO INode := CAA.gc_pNULL;
	M_CHILDREN : POINTER TO INode := CAA.gc_pNULL;
	M_UDICHILDCOUNT : UDINT;
	M_UDICHILDINDEX : UDINT;
	M_NCOUNT : DINT;
	M_PCONNECTOR : POINTER TO IoConfigConnector;
	CHILDNODECOUNT : CAA.Count;
	CONNECTOR : POINTER TO IoConfigConnector;
	ENABLE : BOOL;
	FIRSTCHILDNODE : INode;
	INDEX : UDINT;
	ISROOTNODE : BOOL;
	NEXTSIBLINGNODE : INode;
	PARENTNODE : INode;
	SIBLINGNODECOUNT : CAA.Count;
END_VAR
END_FUNCTION_BLOCK

METHOD GETCHILD : INode
VAR_INPUT
	UDIINDEX : UDINT;
END_VAR
END_METHOD

METHOD INITIALIZE_DIAG : UDINT
VAR_INPUT
	PCONNECTOR : POINTER TO IoConfigConnector;
	NCONNECTORCOUNT : DINT;
	PARENT : POINTER TO INode;
	CHILDREN : POINTER TO INode;
	UDICHILDCOUNT : UDINT;
END_VAR
END_METHOD