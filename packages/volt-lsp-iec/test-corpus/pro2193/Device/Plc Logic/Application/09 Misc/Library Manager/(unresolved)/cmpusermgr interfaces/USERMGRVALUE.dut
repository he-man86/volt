TYPE USERMGRVALUE :
UNION
	I8VALUE : SINT;
	I16VALUE : INT;
	I32VALUE : DINT;
	UI8VALUE : USINT;
	UI16VALUE : UINT;
	UI32VALUE : UDINT;
	REAL32VALUE : REAL;
	REAL64VALUE : LREAL;
	HANDLEVALUE : RTS_IEC_HANDLE;
	RESULTVALUE : RTS_IEC_RESULT;
	SIZEVALUE : __XWORD;
	BOOLVALUE : BOOL;
	UI64VALUE : ULINT;
	I64VALUE : LINT;
	STRINGVALUE : POINTER TO STRING;
	WSTRINGVALUE : POINTER TO WSTRING;
END_UNION
END_TYPE