TYPE STATE :
(
	STOPPED := 16#1,
	RESETTING := 16#2,
	IDLE := 16#4,
	STARTING := 16#8,
	EXECUTE := 16#10,
	HOLDING := 16#20,
	HELD := 16#40,
	UNHOLDING := 16#80,
	SUSPENDING := 16#100,
	SUSPENDED := 16#200,
	UNSUSPENDING := 16#400,
	COMPLETING := 16#800,
	COMPLETE := 16#1000,
	STOPPING := 16#2000,
	ABORTING := 16#4000,
	ABORTED := 16#8000,
	CLEARING := 16#10000,
	NO := 0,
	ALL := 16#1FFFF,
	INVALID := 16#80000000
);
END_TYPE