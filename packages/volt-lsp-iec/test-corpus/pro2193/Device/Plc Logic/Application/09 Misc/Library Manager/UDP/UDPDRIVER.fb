FUNCTION_BLOCK UDPDRIVER
VAR
	_SOCKETFDSET : SysSocket.SOCKET_FD_SET;
END_VAR
END_FUNCTION_BLOCK

METHOD BINDPORT : UDINT
VAR_INPUT
	PPORT : POINTER TO Port;
	UDILOCALIPADDRESS : UDINT;
END_VAR
VAR_OUTPUT
	ELOGCODE : ErrorCode;
END_VAR
END_METHOD

METHOD CLOSEPORT : SysTypes.RTS_IEC_RESULT
VAR_INPUT
	PPORT : POINTER TO Port;
END_VAR
VAR_OUTPUT
	ELOGCODE : ErrorCode;
END_VAR
END_METHOD

METHOD CREATEPORT : SysTypes.RTS_IEC_RESULT
VAR_INPUT
	PPORT : POINTER TO Port;
END_VAR
VAR_OUTPUT
	ELOGCODE : ErrorCode;
END_VAR
END_METHOD

METHOD CYCLICACTION : SysTypes.RTS_IEC_RESULT
END_METHOD

METHOD SELECT : SysTypes.RTS_IEC_RESULT
VAR_INPUT
	ITIMEOUT : INT;
END_VAR
VAR_OUTPUT
	DIREADY : DINT;
	ELOGCODE : ErrorCode;
END_VAR
VAR_IN_OUT
	STRRECVSET : SysSocket.SOCKET_FD_SET;
	STRSENDSET : SysSocket.SOCKET_FD_SET;
	STRERRORSET : SysSocket.SOCKET_FD_SET;
END_VAR
END_METHOD