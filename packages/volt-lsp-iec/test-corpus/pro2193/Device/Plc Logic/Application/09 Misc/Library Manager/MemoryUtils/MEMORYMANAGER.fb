FUNCTION_BLOCK MEMORYMANAGER
VAR
	_HXCHG : CAA.HANDLE;
	_UDIINITSIZE : UDINT;
	_UDIACTSIZE : UDINT;
	_UDIMSGLEFT : CAA.COUNT;
	_UDIBLOCKSIZE : UDINT;
	_XAUTOEXTEND : BOOL := TRUE;
	ACTSIZE : UDINT;
	AUTOEXTEND : BOOL;
	EXCHANGE : CAA.HANDLE;
	INITSIZE : UDINT;
	MESSAGESLEFT : CAA.COUNT;
END_VAR
END_FUNCTION_BLOCK

METHOD EXTEND : BOOL
VAR_INPUT
	UDINUMMSGS : UDINT;
END_VAR
END_METHOD

METHOD FB_EXIT
VAR_INPUT
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD CREATE
VAR_INPUT
	UDIINITSIZE : UDINT;
	UDIBLOCKSIZE : UDINT;
END_VAR
END_METHOD

METHOD DELETE
END_METHOD

METHOD FREE
VAR_INPUT
	PMSG : POINTER TO BYTE;
END_VAR
END_METHOD

METHOD MALLOC : POINTER TO BYTE
VAR_OUTPUT
	EERROR : ERROR;
END_VAR
END_METHOD