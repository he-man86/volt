	LRDEVIATIONCONSTRAINTA : LREAL;
	LRDEVIATIONCONSTRAINTB : LREAL;
	LRGAINFACTORDISTURBANCECONTROL : LREAL;
	LRFILTERTIMEFACTORDISTURBANCECONTROL : LREAL;
