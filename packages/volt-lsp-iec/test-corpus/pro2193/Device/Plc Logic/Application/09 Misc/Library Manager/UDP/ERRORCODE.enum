TYPE ERRORCODE :
(
	NO_ERROR,
	SOCKET_NONE_OPEN,
	SOCKET_NOTHING_RECEIVED,
	SOCKET_TIMEOUT,
	SOCKET_SELECT_FAILED,
	SOCKET_CREATE_FAILED,
	SOCKET_CLOSE_FAILED,
	INVALID_HANDLE,
	NO_DATA_AVAILABLE,
	WRONG_PARAMETER,
	IOCTL_FAILED,
	FD_SET_INIT_FAILED,
	SET_OPTION_BROADCAST_FAILED,
	SET_OPTION_MULTICAST_FAILED,
	SET_OPTION_ADD_MEMBERSHIP_FAILED,
	SET_OPTION_DROP_MEMBERSHIP_FAILED,
	BIND_FAILED,
	NOT_IMPLEMENTED
);
END_TYPE