FUNCTION_BLOCK MC_MOVEABSOLUTE EXTENDS L_MC1P_Template_Move
VAR_INPUT
	EXECUTE : BOOL;
	CONTINUOUSUPDATE : BOOL;
	POSITION : LREAL;
	VELOCITY : LREAL;
	ACCELERATION : LREAL;
	DECELERATION : LREAL;
	JERK : LREAL;
	DIRECTION : MC_DIRECTION;
	BUFFERMODE : MC_BUFFER_MODE;
END_VAR
VAR_OUTPUT
	DONE : BOOL;
	BUSY : BOOL;
	ACTIVE : BOOL;
	COMMANDABORTED : BOOL;
	ERROR : BOOL;
	ERRORID : L_IE1P_Error;
END_VAR
VAR
	MOVEABS : L_MC1P_MoveAbsolute_Inernal;
	JERKDEC_INT : LREAL;
	GETMOVEBASICP : POINTER TO L_MC1P_MoveBasic;
	JERKDEC : LREAL;
END_VAR
END_FUNCTION_BLOCK