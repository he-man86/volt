FUNCTION_BLOCK PRVREC
VAR_INPUT
	EN : BOOL;
	MODE : UINT;
	F_ID : DWORD;
	CODE1 : BYTE;
	CODE2 : BYTE;
	LEN : UINT;
	RECORD : POINTER TO BYTE;
END_VAR
VAR_OUTPUT
	ENO : BOOL;
	NEW : BOOL;
	STATUS : DWORD;
	SLOT : UINT;
	SUBSLOT : UINT;
	INDEX : UINT;
	RLEN : UINT;
END_VAR
VAR
	S_INSTANCEHANDLER : InstanceHandler;
	_STATE : PRVREC_State := PRVREC_State.S1_INIT;
	_DEVICE : ICommFBFieldDevice;
	_READIND : Read_Ind;
	EMPTYIND : Read_Ind;
END_VAR
END_FUNCTION_BLOCK