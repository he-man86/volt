FUNCTION_BLOCK SERVICEREQUESTBASE
VAR
	_PHEADER : POINTER TO ServiceHeader;
	_PDU : ProtocolDataUnit;
	_BPDUVALID : BOOL;
	_BO : IDatasources.ByteOrder;
	_BSWAP : BOOL;
	_UDIMAXCONTENTSIZE : UDINT;
	HEADERSIZE : UDINT := SIZEOF(_pHeader^);
	CONTENTPTR : POINTER TO BYTE;
	DATA : ProtocolDataUnit;
	DATAVALID : BOOL;
	HAVETOSWAP : BOOL;
	HEADER : ServiceHeader;
END_VAR
END_FUNCTION_BLOCK

METHOD CREATE : UDINT
VAR_INPUT
	TARGETBYTEORDER : IDatasources.ByteOrder;
	UISERVICEGROUP : UINT;
	UISERVICE : UINT;
	UDIDEVSESSID : UDINT;
	PBUFFER : POINTER TO BYTE;
	UDIBUFFERSIZE : UDINT;
END_VAR
END_METHOD

METHOD FB_EXIT : BOOL
VAR_INPUT
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD FINISH : UDINT
VAR_INPUT
	BDESTROYONLY : BOOL;
END_VAR
END_METHOD

METHOD DOFINISH : UDINT
VAR_INPUT
	XDESTROYONLY : BOOL;
END_VAR
VAR_OUTPUT
	PDUCONTENT : ProtocolDataUnit;
END_VAR
END_METHOD

METHOD PRVSWAPHEADER : UDINT
END_METHOD