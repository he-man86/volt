FUNCTION_BLOCK CHARBUFFERSTRING
VAR_INPUT
	M_UIBUFFERSIZE : UINT;
	M_CBPBUFFER : CharBufferPtr;
	M_TYPE : __SYSTEM.TYPE_CLASS;
	M_ASSTRING : POINTER TO STRING(255);
	M_ASWSTRING : POINTER TO WSTRING(255);
	M_BALLOCATED : BOOL;
END_VAR
VAR
	CAPACITY : UINT;
	CHARACTERS : CharBufferPtr;
	LENGTH : DINT;
	STRINGTYPE : __SYSTEM.TYPE_CLASS;
END_VAR
END_FUNCTION_BLOCK