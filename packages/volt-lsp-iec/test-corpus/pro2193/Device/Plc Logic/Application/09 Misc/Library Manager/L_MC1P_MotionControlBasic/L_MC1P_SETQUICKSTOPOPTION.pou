FUNCTION_BLOCK L_MC1P_SETQUICKSTOPOPTION EXTENDS L_MC1P_Template
VAR_INPUT
	XEXECUTE : BOOL;
	EQUICKSTOPOPTION : L_MC1P_QuickStopOption := L_MC1P_QuickStopOption.StayInQSP;
END_VAR
VAR_OUTPUT
	XDONE : BOOL;
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
END_VAR
VAR
	XEXECUTEOLD : BOOL;
	XRESETOUTPUT : BOOL;
	ISTATE : INT;
	WRITEPARAMETER : L_DCO_WriteDriveParameter;
	PAXISREAL : POINTER TO _AXIS_REF_REAL;
	PWDUMMY : POINTER TO WORD;
END_VAR
END_FUNCTION_BLOCK