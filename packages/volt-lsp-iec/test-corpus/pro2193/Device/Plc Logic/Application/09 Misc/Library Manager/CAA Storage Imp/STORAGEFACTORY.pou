FUNCTION_BLOCK STORAGEFACTORY
VAR
	_FACCURSOR : CursorImpFactory;
	_FACROW : RowImpFactory;
	_FACROWPLANCHET : RowPlanchetImpFactory;
	_FACSAVEPOINT : SavepointImpFactory;
	_FACTABLE : TableImpFactory;
	_FACTRANSACTION : TransactionImpFactory;
END_VAR
END_FUNCTION_BLOCK

METHOD CREATECURSOR : STO.ICursor
VAR_INPUT
	HCURSOR : CAA.HANDLE;
	ITFTABLE : STO.ITable;
END_VAR
VAR_OUTPUT
	EERROR : STO.ERROR;
END_VAR
END_METHOD

METHOD CREATEROW : STO.IRow
VAR_INPUT
	HROW : CAA.HANDLE;
	ITFTABLE : STO.ITable;
END_VAR
VAR_OUTPUT
	EERROR : STO.ERROR;
END_VAR
END_METHOD

METHOD CREATEROWPLANCHET : STO.IRowPlanchet
VAR_INPUT
	HROWPLANCHET : CAA.HANDLE;
	ITFTABLE : STO.ITable;
END_VAR
VAR_OUTPUT
	EERROR : STO.ERROR;
END_VAR
END_METHOD

METHOD CREATESAVEPOINT : STO.ISavepoint
VAR_INPUT
	HSAVEPOINT : CAA.HANDLE;
	ITFTRANSACTION : STO.ITransaction;
END_VAR
VAR_OUTPUT
	EERROR : STO.ERROR;
END_VAR
END_METHOD

METHOD CREATETABLE : STO.ITable
VAR_INPUT
	HTABLE : CAA.HANDLE;
	ITFSTORAGE : STO.IStorage;
END_VAR
VAR_OUTPUT
	EERROR : STO.ERROR;
END_VAR
END_METHOD

METHOD CREATETRANSACTION : STO.ITransaction
VAR_INPUT
	HTRANSACTION : TRANSACTION;
	ITFSTORAGE : STO.IStorage;
END_VAR
VAR_OUTPUT
	EERROR : STO.ERROR;
END_VAR
END_METHOD