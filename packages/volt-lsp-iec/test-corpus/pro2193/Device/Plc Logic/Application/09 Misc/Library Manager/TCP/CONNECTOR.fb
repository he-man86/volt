FUNCTION_BLOCK CONNECTOR
VAR
	_HSOCKET : SysTypes.RTS_IEC_HANDLE := SysTypes.RTS_INVALID_HANDLE;
	_UDICLIENTIPADDRESS : UDINT;
	_STREAM : Stream;
	_UDIIPADDRESS : UDINT;
	_UIPORT : UINT;
	_XINITIALIZED : BOOL;
	_XCONNECTED : BOOL;
	_XOPEN : BOOL;
	IPADDRESS : STRING;
	PORT : UINT;
END_VAR
END_FUNCTION_BLOCK

METHOD CONNECT : ERROR
VAR_INPUT
	SIPADDRESS : STRING;
	UIPORT : UINT;
END_VAR
VAR_OUTPUT
	PSTREAM : POINTER TO Stream;
END_VAR
END_METHOD

METHOD DISCONNECT : ERROR
END_METHOD

METHOD FB_EXIT : BOOL
VAR_INPUT
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD INITIALIZESOCKET : ERROR
VAR_INPUT
	SIPADDRESS : STRING;
	UIPORT : UINT;
END_VAR
END_METHOD

METHOD RESET
END_METHOD

METHOD RESOLVEHOSTNAME : ERROR
VAR_INPUT
	SHOSTNAME : STRING;
END_VAR
VAR_OUTPUT
	SIPADDRESS : STRING;
END_VAR
END_METHOD

METHOD SETADAPTER : ERROR
VAR_INPUT
	SIPADDRESS : STRING;
END_VAR
END_METHOD