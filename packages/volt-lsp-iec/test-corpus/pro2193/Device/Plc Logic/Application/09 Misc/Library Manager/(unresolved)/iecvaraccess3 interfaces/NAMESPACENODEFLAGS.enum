TYPE NAMESPACENODEFLAGS :
(
	NONE := 0,
	NODETYPEMASK := 16#FF,
	NODETYPEBRANCHNODE := 16#1,
	NODETYPELEAFNODE := 16#2,
	BRANCHNODEINFOMASK := 16#FF00,
	BRANCHNODEIMPLICITROOTNODE := 16#100,
	BRANCHNODEAPPLICATIONNAME := 16#200,
	BRANCHNODELIBRARYNAMESPACE := 16#400,
	BRANCHNODEEXPLICITNAMESPACE := 16#800,
	BRANCHNODEMEMBERACCESS := 16#1000,
	SIGTYPENODEMASK := LWORD#4294901760,
	SIGTYPEGVL := 16#10000,
	SIGTYPEPROGRAM := 16#20000,
	SIGTYPEFB := 16#40000,
	SIGTYPESTRUCT := 16#80000,
	SIGTYPEMETHOD := 16#100000,
	SIGTYPEACTION := 16#200000,
	SIGTYPEPROPERTY := 16#400000,
	SIGTYPETRANSITION := 16#800000,
	SIGTYPEFUNCTION := 16#1000000,
	EXPORTEDVARIABLETYPEMASK := 16#FF00000000,
	EXPORTEDVARIABLEFLAG := 16#100000000,
	EXPORTEDSTATICVARIABLEFLAG := 16#200000000,
	EXPORTEDPROPERTYVARIABLEFLAG := 16#400000000,
	EXPORTEDVARIABLE := (ExportedVariableFlag + NodeTypeLeafNode),
	EXPORTEDSTATICVARIABLE := (ExportedStaticVariableFlag + NodeTypeLeafNode),
	EXPORTEDPROPERTYVARIABLE := (ExportedPropertyVariableFlag + NodeTypeLeafNode),
	NODEFLAGSMASK := 16#FF0000000000,
	NODEFLAGHIDDEN := 16#100000000000
);
END_TYPE