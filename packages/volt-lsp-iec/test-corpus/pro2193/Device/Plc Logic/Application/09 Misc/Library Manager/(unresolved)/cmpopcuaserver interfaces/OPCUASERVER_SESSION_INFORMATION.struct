TYPE OPCUASERVER_SESSION_INFORMATION :
STRUCT
	DWSESSIONID : DWORD;
	CLIENTADDRESS : INADDR;
	PWSSESSIONNAME : WSTRING(255);
	PWSAPPLICATIONNAME : WSTRING(255);
	PWSAPPLICATIONURI : WSTRING(255);
	PWSPRODUCTURI : WSTRING(255);
	PWSSECURITYPOLICY : WSTRING(255);
	SECURITYMODE : OpcUaServer_MessageSecurityMode;
	HCLIENTCERTIFICATE : RTS_IEC_HANDLE;
	HUSER : RTS_IEC_HANDLE;
END_STRUCT
END_TYPE