	ALRPTPJERK : ARRAY [1..6] OF LREAL;
	ALRPTPACC : ARRAY [1..6] OF LREAL;
	ALRPTPVEL : ARRAY [1..6] OF LREAL;
	ALRPTPJERK_ORIGIN : ARRAY [1..6] OF LREAL;
	ALRPTPACC_ORIGIN : ARRAY [1..6] OF LREAL;
	ALRPTPVEL_ORIGIN : ARRAY [1..6] OF LREAL;
	LRPTP_MAXTIME : LREAL;
	PTPTYPE : ARRAY [1..6] OF L_MC4P_PTPTypes;
	VMAX_IN_PTP : ARRAY [1..6] OF LREAL;
	VMAX_OUT_PTP : ARRAY [1..6] OF LREAL;
END_STRUCT
END_TYPE