	UDIINDEX : UDINT;
END_VAR
END_METHOD

METHOD ABSTRCOMPARE : INT
VAR_INPUT
	PKEY1 : POINTER TO BYTE;
	PKEY2 : POINTER TO BYTE;
END_VAR
END_METHOD

METHOD ABSTRDATAPTRCHANGED : UDINT
END_METHOD

METHOD ABSTRKEYPTRFROMINDEX : POINTER TO BYTE
VAR_INPUT
	UDIINDEX : UDINT;
END_VAR
END_METHOD

METHOD ABSTRSIZEOFELEMENT : UDINT
END_METHOD

METHOD ABSTRSWAP : UDINT
VAR_INPUT
	INDEX1 : UDINT;
	INDEX2 : UDINT;
END_VAR
