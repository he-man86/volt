FUNCTION_BLOCK STRINGTOSTRINGMAP EXTENDS BaseMap
VAR
	_PITEMS : POINTER TO ARRAY [0..100] OF Pair_StringString;
	_BCASESENSITIVE : BOOL := TRUE;
	CASESENSITIVE : BOOL;
END_VAR
END_FUNCTION_BLOCK

METHOD ADDSTRINGSTRINGPAIR : UDINT
VAR_INPUT
	STRKEY : STRING;
	STRVALUE : STRING;
END_VAR
END_METHOD

METHOD GETVALUE : STRING
VAR_INPUT
