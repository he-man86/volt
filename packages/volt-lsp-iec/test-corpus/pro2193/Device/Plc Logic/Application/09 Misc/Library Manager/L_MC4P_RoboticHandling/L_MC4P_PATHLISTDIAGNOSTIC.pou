	XREADERRORFILEEXECUTE_INTERN : BOOL;
	XREADERRORFILEEXECUTE_OLD : BOOL;
	DITIMESTAMP : DINT;
	ILISTHISTORYENDLENGTH : INT;
	SCLISTELEMENTEMPTY : L_MC4P_ListElement;
	IDX2 : INT;
	IDX3 : INT;
	ILISTELEMACTIVE : INT;
	IDATANO : INT;
	XAGERORR : BOOL;
	ASCAGEERRORINFO : ARRAY [0..7] OF L_IE1P_ErrorInformation;
	XSAVEAGERROR : BOOL;
	WLOOKAHEADHORIZON : WORD;
	DWTASKYCLE_US : DWORD;
	EACTIVEERRORID : L_IE1P_Error;
