	OPEN2 : FILE.Open;
	CLOSE2 : FILE.Close;
	READ1 : FILE.Read;
	ASHEADLINE : ARRAY [1..10] OF STRING(255) := ['Hinweise zur ListenElementen:  Segmentnummer +2000:  Element aus Ipo,  Segmentnummer +1000:  diSegmentNoCopiedFrom $N', 'Hinweise zur Exeltabelle: oben ist der älteste und unten ist der akttuelste Stand der Liste  $N', 'Zeile1:AnzahlDurchläufe $TxPathStopExecute $TdiActFunID $TdiBusyFunID $TdiFunID $TlrOverride $T $TSegmente  $N', 'Zeile2: AbsZähler $TxPathStopExecute $TdiActFunID $TdiBusyFunID $TdiFunID, $TlrOverride $T $TMaske $T $N', '$N '];
	STABULATOR : STRING(2) := '$T';
	SLINEFEED : STRING(2) := '$N';
	SZEILE : STRING(255);
	SZEILE2 : STRING(255);
	IDATAIDX1 : INT;
	SEXELFILENAME : STRING;
	SLISTELEMENTFILENAME : STRING;
	SLISTELEMENTFILENAMEBASE : STRING;
