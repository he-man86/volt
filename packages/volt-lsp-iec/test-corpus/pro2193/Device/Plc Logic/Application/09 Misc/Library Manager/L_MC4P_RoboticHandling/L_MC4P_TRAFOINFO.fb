FUNCTION_BLOCK L_MC4P_TRAFOINFO
VAR_INPUT
	ALITURNS : ARRAY [1..6] OF LINT;
	AIQUADRANT : ARRAY [1..6] OF INT;
	AICONFIG : ARRAY [1..6] OF INT;
	XCHECKQUADRANT : BOOL;
	ALRNEIGHBOUR : ARRAY [1..6] OF LREAL;
	ICHECKNEIGHBOURHOOD : INT;
	ETOOLSYSTEM : L_MC4P_ToolSystem;
END_VAR
VAR
	TYPEID : L_MC4P_KinematicType;
END_VAR
END_FUNCTION_BLOCK

METHOD COPYFROM : L_IE1P_Error
VAR_INPUT
	SCSOURCE : REFERENCE TO L_MC4P_TrafoInfo;
END_VAR
END_METHOD

METHOD FB_INIT : BOOL
VAR_INPUT
	BINITRETAINS : BOOL;
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD RESET
END_METHOD