TYPE SCCTRL_ABC :
STRUCT
	XRESETERROR : BOOL;
	XREGULATORON : BOOL;
	XENABLEPOSITIVE : BOOL := TRUE;
	XENABLENEGATIVE : BOOL := TRUE;
	XJOGGINGPOS : BOOL;
	XJOGGINGNEG : BOOL;
	LRJOGGINGSETVEL : LREAL := 100;
	LRJOGGINGSETACC : LREAL := 100;
	LRJOGGINGSETDEC : LREAL := 100;
	LRJOGGINGSETJERK : LREAL := 0;
	XCONTINUOUSUPDATE : BOOL;
	XSTOP : BOOL;
	XHALT : BOOL;
	XMOVEVELEXECUTE : BOOL;
	XMOVEABSEXECUTE : BOOL;
	XMOVERELEXECUTE : BOOL;
	LRSETPOS_DIST : LREAL := 0;
	LRSETVEL : LREAL := 100;
	LRSETACC : LREAL := 100;
	LRSETDEC : LREAL := 100;
	LRSETJERK : LREAL := 0;
	ESETDIRECTION : MC_DIRECTION := MC_DIRECTION.mcPositiveDirection;
	XHOMEEXECUTE : BOOL;
	LRHOMEPOSITION : LREAL := 0;
	XUSEHOMEEXTPARAMETER : BOOL;
	SCHOMEEXTPARAMETER : L_MC1P_HomeParameter;
	SCHOMEEXTTP : MC_TRIGGER_REF;
	XHOMEABSSWITCH : BOOL;
	LROVERRIDEJERK : LREAL := 1;
	LROVERRIDEACC : LREAL := 1;
	LROVERRIDE : LREAL := 1;
END_STRUCT
END_TYPE