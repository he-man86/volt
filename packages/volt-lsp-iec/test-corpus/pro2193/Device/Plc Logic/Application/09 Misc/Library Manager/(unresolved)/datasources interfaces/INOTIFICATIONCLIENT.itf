INTERFACE INOTIFICATIONCLIENT
END_INTERFACE

METHOD LISTOPERATIONDONE
VAR_INPUT
	XWRITING : BOOL;
	DATASOURCENAME : ItemName;
	RESULT : SysTypes.RTS_IEC_RESULT;
END_VAR
END_METHOD

METHOD LISTOPERATIONSTART
VAR_INPUT
	XWRITING : BOOL;
	DATASOURCENAME : ItemName;
END_VAR
END_METHOD

METHOD LISTVALUEREAD
VAR_INPUT
	REMOTENAME : ItemName;
	PREADVALUE : POINTER TO BYTE;
	VALUETYPE : IBaseLibrary.TypeClass;
	VALUESIZE : __UXINT;
END_VAR
END_METHOD

METHOD LISTVALUEWRITE
VAR_INPUT
	REMOTENAME : ItemName;
	PWRITEVALUE : POINTER TO BYTE;
	VALUETYPE : IBaseLibrary.TypeClass;
	VALUESIZE : __UXINT;
END_VAR
END_METHOD

METHOD READREQUESTDONE
VAR_INPUT
	DATASOURCENAME : ItemName;
	RESULT : SysTypes.RTS_IEC_RESULT;
END_VAR
END_METHOD

METHOD READREQUESTSTART
VAR_INPUT
	DATASOURCENAME : ItemName;
END_VAR
END_METHOD

METHOD SINGLEVALUEREAD
VAR_INPUT
	REMOTENAME : ItemName;
	PREADVALUE : POINTER TO BYTE;
	VALUETYPE : IBaseLibrary.TypeClass;
	VALUESIZE : __UXINT;
END_VAR
END_METHOD

METHOD SINGLEVALUEWRITE
VAR_INPUT
	REMOTENAME : ItemName;
	POLDVALUE : POINTER TO BYTE;
	PNEWVALUE : POINTER TO BYTE;
	VALUETYPE : IBaseLibrary.TypeClass;
	VALUESIZE : __UXINT;
END_VAR
END_METHOD

METHOD WRITEREQUESTDONE
VAR_INPUT
	DATASOURCENAME : ItemName;
	RESULT : SysTypes.RTS_IEC_RESULT;
END_VAR
END_METHOD

METHOD WRITEREQUESTSTART
VAR_INPUT
	DATASOURCENAME : ItemName;
END_VAR
END_METHOD