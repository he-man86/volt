	EXECUTE : BOOL;
	CONTINUOUSUPDATE : BOOL;
	DISTANCE : LREAL;
	VELOCITY : LREAL;
	ACCELERATION : LREAL;
	DECELERATION : LREAL;
	JERK : LREAL;
	JERKDEC : LREAL;
	BUFFERMODE : MC_BUFFER_MODE;
	XUSEEXTERNPROFILECALCULATION : BOOL;
	ITFPOSPROFILECALCULATION : L_MC1P_IPosProfileCalculation;
END_VAR
VAR_OUTPUT
