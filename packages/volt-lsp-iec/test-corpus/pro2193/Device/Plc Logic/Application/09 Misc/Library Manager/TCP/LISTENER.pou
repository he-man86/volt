FUNCTION_BLOCK LISTENER
VAR
	_HLISTENSOCKET : SysTypes.RTS_IEC_HANDLE := SysTypes.RTS_INVALID_HANDLE;
	_LISTENFD_SET : SysSocket.SOCKET_FD_SET;
	_UIPORT : UINT;
	_UDIIPADDRESS : UDINT;
	_XSTARTED : BOOL;
	_XLISTENING : BOOL;
	IPADDRESS : STRING;
	PORT : UINT;
	SOCKET : RTS_IEC_HANDLE;
END_VAR
END_FUNCTION_BLOCK

METHOD ACCEPT : ERROR
VAR_INPUT
	PSTREAM : POINTER TO Stream;
END_VAR
END_METHOD

METHOD FB_EXIT : BOOL
VAR_INPUT
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD LISTEN : ERROR
END_METHOD

METHOD START : ERROR
VAR_INPUT
	SIPADDRESS : STRING;
	UIPORT : UINT;
END_VAR
END_METHOD

METHOD STOP : ERROR
END_METHOD