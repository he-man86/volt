FUNCTION_BLOCK MESSAGECOMPARER EXTENDS TSLastComparer
VAR
	M_STRINGTYPE : __SYSTEM.TYPE_CLASS;
	M_IWHICHMESSAGE : INT;
	M_ICOUNTLATCHVARIABLES : INT;
	M_CBSMESSAGE1 : CharBufferString;
	M_CBSMESSAGE2 : CharBufferString;
	M_CBSMESSAGE1REPLACED : CharBufferString;
	M_CBSMESSAGE2REPLACED : CharBufferString;
	M_ABYBUFFERMESSAGE1REPLACED : ARRAY [0..(BUFFER_LENGTH - 1)] OF BYTE;
	M_ABYBUFFERMESSAGE2REPLACED : ARRAY [0..(BUFFER_LENGTH - 1)] OF BYTE;
	M_TIMESTAMPANDVALUESCONTAINER : TimestampAndValuesContainer;
	BUFFER_LENGTH : INT := (2 * (255 + 1));
END_VAR
END_FUNCTION_BLOCK

METHOD BEFORECOMPARE
VAR_INPUT
	STRINGTYPE : __SYSTEM.TYPE_CLASS;
	IWHICHMESSAGE : INT;
	ICOUNTLATCHVARIABLES : INT;
END_VAR
END_METHOD

METHOD COMPARE : INT
VAR_INPUT
	DIINDEXALARM1 : DINT;
	DIINDEXALARM2 : DINT;
END_VAR
END_METHOD

METHOD PRVGETALARMMESSAGE : CharBufferPtr
VAR_INPUT
	UDIALARMGROUPID : UDINT;
	UDIALARMID : UDINT;
	SDEVICENAME : STRING;
END_VAR
VAR_OUTPUT
	SALARMID : STRING;
END_VAR
END_METHOD

METHOD PRVREPLACEPLACEHOLDERS : BOOL
VAR_INPUT
	DIINDEXALARM : DINT;
	CBPMESSAGE : CharBufferPtr;
	RCBSMESSAGE : REFERENCE TO CharBufferString;
	RCBSMESSAGEREPLACED : REFERENCE TO CharBufferString;
END_VAR
END_METHOD