TYPE L_MB1P_CHANNELELEMENT :
STRUCT
	ITFCOMID : ITF_DataBus;
	XVALID : BOOL;
	DWMASK : DWORD;
	IELEMENTNO : INT := 1;
	ILEFT : INT := 1;
	IRIGHT : INT := 1;
	PLEFT : POINTER TO L_MB1P_ChannelElement;
	PRIGHT : POINTER TO L_MB1P_ChannelElement;
	PDATA : POINTER TO L_MB1P_ChannelData;
	PHEAD : POINTER TO L_MB1P_ChannelHeadData;
END_STRUCT
END_TYPE