INTERFACE ITREEWALKER
END_INTERFACE

METHOD ASBASETREENODE : IBaseTreeNode
END_METHOD

METHOD FINDCHILD : ITreeWalker
VAR_INPUT
	SZCHILDNAME : POINTER TO BYTE;
	NAMELEN : __XWORD;
	SYMBOLSSETS : DWORD;
	VARINFO : REFERENCE TO VariableInformation;
	PRESULT : POINTER TO RTS_IEC_RESULT;
END_VAR
VAR_IN_OUT
	TYPESYSTEMREACHED : BOOL;
END_VAR
END_METHOD

METHOD GETCHILDBYINDEX : ITreeWalker
VAR_INPUT
	IINDEX : DINT;
	USERACCESSRIGHTS : BYTE;
	SYMBOLSSETS : DWORD;
END_VAR
VAR_OUTPUT
	XOUTOFRANGE : BOOL;
END_VAR
END_METHOD

METHOD GETFIRSTCHILD : ITreeWalker
VAR_INPUT
	USERACCESSRIGHTS : BYTE;
	SYMBOLSSETS : DWORD;
END_VAR
END_METHOD

METHOD GETFULLPATH : DINT
VAR_INPUT
	PBUFFER : POINTER TO STRING;
	DIBUFFERSIZE : DINT;
END_VAR
VAR_OUTPUT
	BROOT_NODE : BOOL;
	BEMPTYNAMESPACENODE : BOOL;
END_VAR
END_METHOD

METHOD GETPARENT : ITreeWalker
VAR_INPUT
	USERACCESSRIGHTS : BYTE;
	SYMBOLSSETS : DWORD;
END_VAR
END_METHOD

METHOD GETSIBLING : ITreeWalker
VAR_INPUT
	USERACCESSRIGHTS : BYTE;
	SYMBOLSSETS : DWORD;
END_VAR
END_METHOD

METHOD ISVISIBLE : BOOL
VAR_INPUT
	USERACCESSRIGHTS : BYTE;
	SYMBOLSSETS : DWORD;
END_VAR
END_METHOD

METHOD GETCHILDBYBROWSENAME : ITreeWalker
VAR_INPUT
	PBROWSENAME : POINTER TO OpcUa_QualifiedName;
	VARINFO : REFERENCE TO VariableInformation;
END_VAR
END_METHOD

METHOD GETNEXTBYBROWSENAME : ITreeWalker
VAR_INPUT
	PBROWSENAME : POINTER TO OpcUa_QualifiedName;
	VARINFO : REFERENCE TO VariableInformation;
END_VAR
END_METHOD