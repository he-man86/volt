FUNCTION_BLOCK L_UBUP_MONITORSTATESERVER
VAR_OUTPUT
	ASCREQUESTPREV : ARRAY [0..c_iMax] OF L_UBUP_MonitorRequest;
	ASCREQUESTPOST : ARRAY [0..c_iMax] OF L_UBUP_MonitorRequest;
	SCREQUESTANNOUNCEDPREV : L_UBUP_MonitorRequest;
	SCREQUESTANNOUNCEDPOST : L_UBUP_MonitorRequest;
	SCREQUESTALTERNATIVEANNOUNCEDPREV : L_UBUP_MonitorRequest;
	SCREQUESTALTERNATIVEANNOUNCEDPOST : L_UBUP_MonitorRequest;
	SCREQUESTACTIVEPREV : L_UBUP_MonitorRequest;
	SCREQUESTACTIVEPOST : L_UBUP_MonitorRequest;
	ISTATE : INT;
END_VAR
VAR
	C_IMAX : INT := 20;
	_ECASE : L_UBUP_StateHandleCase := L_UBUP_StateHandleCase.STATE_POST;
	_IDX1 : INT;
	_IDX2 : INT;
END_VAR
END_FUNCTION_BLOCK