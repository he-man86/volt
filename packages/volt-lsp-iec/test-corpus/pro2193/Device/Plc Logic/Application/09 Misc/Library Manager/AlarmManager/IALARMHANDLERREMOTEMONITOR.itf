INTERFACE IALARMHANDLERREMOTEMONITOR
END_INTERFACE

METHOD GETPROXYALARMCLASSESDESCRIPTION : BOOL
VAR_INPUT
	SNAME : STRING;
	PCLDESC : POINTER TO ARRAY [0..0] OF ProxyStructMonitorAlarmClassDesc;
	ISIZE : INT;
END_VAR
VAR_OUTPUT
	ICLCNT : INT;
END_VAR
END_METHOD

METHOD GETPROXYALARMGROUPSDESCRIPTION : BOOL
VAR_INPUT
	SNAME : STRING;
	PGRPDESC : POINTER TO ARRAY [0..0] OF ProxyStructMonitorAlarmGroupDesc;
	ISIZE : INT;
END_VAR
VAR_OUTPUT
	IGRPCNT : INT;
END_VAR
END_METHOD

METHOD GETPROXYALARMSDESCRIPTION : BOOL
VAR_INPUT
	SNAME : STRING;
	PALMDESC : POINTER TO ARRAY [0..0] OF ProxyStructMonitorAlarmDesc;
	DISIZE : DINT;
END_VAR
VAR_OUTPUT
	DIALMCNT : DINT;
END_VAR
END_METHOD

METHOD GETPROXYSTATISTICS : BOOL
VAR_INPUT
	SNAME : STRING;
END_VAR
VAR_OUTPUT
	STRUCTMONITOR : ProxyStructMonitor;
END_VAR
END_METHOD

METHOD GETPROXYSTATISTICSSINGLEACTIVITY : BOOL
VAR_INPUT
	SNAME : STRING;
	ITASKID : INT;
END_VAR
VAR_OUTPUT
	STRUCTMONITOR : ProxyStructMonitorRequest;
