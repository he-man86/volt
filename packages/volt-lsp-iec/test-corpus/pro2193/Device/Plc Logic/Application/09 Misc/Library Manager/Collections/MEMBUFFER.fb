FUNCTION_BLOCK MEMBUFFER
VAR
	_MEMBUF : StaticMemBuffer;
	_BDYNAMIC : BOOL;
	_UDIALLOCATEDSIZE : UDINT;
	_PALLOCATEDDATA : POINTER TO BYTE;
END_VAR
END_FUNCTION_BLOCK

METHOD ALLOC : POINTER TO BYTE
VAR_INPUT
	UDISIZE : UDINT;
END_VAR
VAR_OUTPUT
	UDIRESULT : UDINT;
END_VAR
END_METHOD

METHOD CANRESIZE : BOOL
VAR_INPUT
	UDINEWSIZE : UDINT;
END_VAR
END_METHOD

METHOD FB_EXIT : UDINT
VAR_INPUT
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD INITSTATIC : UDINT
VAR_INPUT
	BUFFER : StaticMemBuffer;
END_VAR
END_METHOD

METHOD RESIZE : POINTER TO BYTE
VAR_INPUT
	UDINEWSIZE : UDINT;
END_VAR
VAR_OUTPUT
	UDIRESULT : UDINT;
END_VAR
END_METHOD