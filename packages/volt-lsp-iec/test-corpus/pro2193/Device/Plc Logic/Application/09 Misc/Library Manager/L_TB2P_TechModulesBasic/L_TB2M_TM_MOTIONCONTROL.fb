	FB_CONDCOLLECTOPERATIONENABLEDLIMITERHOMED : L_UBUP_ConditionCollection := STRUCT(aitfCondition := [fb_CondCollectOperationEnabledLimiter, fb_ConditionAxisHomed, fb_ConditionAxisNotStopping]);
	FB_CONDCOLLECTJOGGING : L_UBUP_ConditionCollection := STRUCT(aitfCondition := [fb_ConditionSTO, fb_ConditionOperationEnabled, fb_ConditionLimiter, fb_ConditionJoggingAllowedDirection, fb_ConditionAxisNotStopping]);
	FB_CONDCOLLECTHOMING : L_UBUP_ConditionCollection := STRUCT(aitfCondition := [fb_ConditionSTO, fb_ConditionOperationEnabled, fb_ConditionLimiter, fb_ConditionAxisStandstill]);
