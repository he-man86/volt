	XHOMEEXECUTE_OLD : BOOL;
	XINTERRUPTHOMINGBYHALT : BOOL;
	ABC : L_MC1P_AxisBasicControlV2;
	HWLIMITSWITCHINTERFACE : L_MC1P_HWLimitSwitchInterface;
