FUNCTION_BLOCK L_TF1P_SYNCDRIVEPOSHIGH EXTENDS L_TF1P_SyncDrivePosState
VAR_INPUT
	XSYNCINSTANT : BOOL;
	XSYNCPOSRESTORE : BOOL;
	XLOADOFFSET : BOOL;
	EOFFSETDIRECTION : L_TF1P_Direction;
	EOFFSETPROFILETYPE : L_TF1P_ProfileType := 0;
	LROFFSETVELPOS : LREAL := 100.0;
	LROFFSETVELNEG : LREAL := 100.0;
	LROFFSETACCDEC : LREAL := 1000.0;
	ESYNCDIRECTION : L_TF1P_SyncDirection := L_TF1P_SyncDirection.mcShortestWay;
	ESYNCMODE : L_TF1P_SyncMode := L_TF1P_SyncMode.ramp_dist;
	LRSYNCINTIME : LREAL := 5;
	LRSYNCOUTTIME : LREAL := 5;
	LRSYNCVEL : LREAL := 100;
	LRSYNCACC : LREAL := 1000.0;
	LRSYNCDEC : LREAL := 1000.0;
	LRSYNCJERK : LREAL := 10000000000.0;
	XLOADCLUTCHOFFSET : BOOL := FALSE;
	LRLOADCLUTCHOFFSET : LREAL := 0;
END_VAR
VAR_OUTPUT
	XSETOFFSETBUSY : BOOL;
	XSETOFFSETDONE : BOOL;
	LROFFSETSYNCPOS : LREAL;
END_VAR
VAR
	LRLOADOFFSET_INT : LREAL := 0;
	XSYNCINSTANT_OLD : BOOL;
	FB_SIMPLEPOSSETOFFSETSLAVE : L_MB1P_SimplePosSetOffset;
	FB_SIMPLEPOSSETOFFSETSYNC : L_MB1P_SimplePosSetOffset;
	LRSYNCOFFSET : LREAL;
END_VAR
END_FUNCTION_BLOCK