FUNCTION_BLOCK L_IF1P_DEVICECONNECTIONHANDLER
VAR_INPUT
	XEXECUTE : BOOL;
	ASCCONNECTIONDATA : POINTER TO L_IF1P_ConnectDeviceData;
	XDISCONNECTEXISTINGCONNECTION : BOOL := TRUE;
END_VAR
VAR_OUTPUT
	XBUSY : BOOL;
	XDONE : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
END_VAR
VAR
	UITYPE : UINT;
	XEXECUTEOLD : BOOL;
	UIIDX : DINT;
	FB_CONNECTDEVICE : L_IF1P_ConnectDevice;
	FB_DISCONNECTDEVICE : L_IF1P_DisconnectDevice;
	XBUSYINTERNAL : BOOL;
	XERRORINTERNAL : BOOL;
	XDONEINTERNAL : BOOL;
	EERRORIDINTERNAL : L_IE1P_Error;
	XCOLLECTINGERROR : BOOL;
	EERRORIDTMP : L_IE1P_Error;
END_VAR
END_FUNCTION_BLOCK

METHOD GETCONNECTIONSTATE : L_IF1P_ConnectionState
VAR_OUTPUT
	EERRORID : L_IE1P_Error;
END_VAR
END_METHOD

METHOD RESET
END_METHOD