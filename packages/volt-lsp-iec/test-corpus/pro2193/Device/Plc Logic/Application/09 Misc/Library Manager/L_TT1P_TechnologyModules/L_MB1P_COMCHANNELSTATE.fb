FUNCTION_BLOCK L_MB1P_COMCHANNELSTATE EXTENDS L_MB1P_ComChannelBase
VAR_OUTPUT
	XBUSY : BOOL;
	INUMOFELEMENTS : INT;
	IELEMENTNO : INT;
	IELEMENTID : INT;
	WCONNENCTIONTYPE : WORD;
END_VAR
VAR
	IELEMENTNO_LOCK : INT;
	ICALLNUM_LOCK : INT;
	PELEMENT_INT : POINTER TO L_MB1P_ChannelElement;
	XELEMENTVALID : BOOL;
	IIDNO : INT := 1;
	XCOMTOMASTERFAILED : BOOL;
	IDX : INT;
	PELEMENTLEFT : POINTER TO L_MB1P_ChannelElement;
	PELEMENTMASTER : POINTER TO L_MB1P_ChannelElement;
	PELEMENT : POINTER TO L_MB1P_ChannelElement;
END_VAR
END_FUNCTION_BLOCK