TYPE OPCUA_CREATESESSIONREQUEST :
STRUCT
	REQUESTHEADER : OpcUa_RequestHeader;
	CLIENTDESCRIPTION : OpcUa_ApplicationDescription;
	SERVERURI : OpcUa_String;
	ENDPOINTURL : OpcUa_String;
	SESSIONNAME : OpcUa_String;
	CLIENTNONCE : OpcUa_ByteString;
	CLIENTCERTIFICATE : OpcUa_ByteString;
	REQUESTEDSESSIONTIMEOUT : OpcUa_Double;
	MAXRESPONSEMESSAGESIZE : OpcUa_UInt32;
END_STRUCT
END_TYPE