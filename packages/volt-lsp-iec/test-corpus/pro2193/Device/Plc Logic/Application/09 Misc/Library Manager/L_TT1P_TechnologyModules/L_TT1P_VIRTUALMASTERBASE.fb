FUNCTION_BLOCK L_TT1P_VIRTUALMASTERBASE
VAR_INPUT
	XENABLEINTERNALCONTROL : BOOL;
	XENABLE : BOOL;
	SCCTRLABC : scCtrl_ABC;
	XRESETERROR : BOOL;
	XREGULATORON : BOOL;
	XSTOP : BOOL;
	XHALT : BOOL;
	SCPAR : L_TT1P_scPar_VirtualMasterBase;
	XCONTINUOUS : BOOL;
	XCYCLE : BOOL;
	XLOADSTARTPOS : BOOL;
	XJOGPOS : BOOL;
	XJOGNEG : BOOL;
	LRSETVEL : LREAL := 10;
	LRSTARTPOS : LREAL;
	LRTARGETPOS : LREAL;
END_VAR
VAR_OUTPUT
	XINTERNALCONTROLACTIVE : BOOL;
	ETMSTATE : L_TT1P_States := L_TT1P_States.INIT;
	SCSTATUSABC : scStatus_ABC;
	XERROR : BOOL;
	XWARNING : BOOL;
	EERRORID : L_IE1P_Error;
	SCERRORINFO : L_TT1P_scErrorInfo;
	XAXISENABLED : BOOL;
	XBUSY : BOOL;
	XINTARGET : BOOL;
	LRACTPOS : LREAL;
	LRACTVEL : LREAL;
	LRSETPOSOUT : LREAL;
	LRSETVELOUT : LREAL;
END_VAR
VAR_IN_OUT
