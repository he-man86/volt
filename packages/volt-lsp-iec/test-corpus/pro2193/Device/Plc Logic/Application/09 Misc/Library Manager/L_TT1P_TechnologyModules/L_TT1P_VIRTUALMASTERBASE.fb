END_VAR
VAR
	TM_INT : _TM_VirtualMasterBase;
	PPAR : POINTER TO L_TT1P_scPar_VirtualMasterBase;
	PPAR_INT : POINTER TO L_TT1P_scPar_VirtualMasterBase;
	XDONE : BOOL;
	XHOMEEXECUTE : BOOL;
	XHOMEABSSWITCH : BOOL;
	XISHOMED : BOOL;
	SCACCESSPOINTS : _scAP_TM_MotionControl;
	SCSIGNALFLOW : _scSF_TM_MotionControl;
END_VAR
END_FUNCTION_BLOCK