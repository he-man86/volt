FUNCTION_BLOCK UNITMODEMANAGER
VAR
	APUM : ARRAY [1..gc_usiMaxModes] OF IUnitMode;
	USINUMBEROFUMS : USINT := 0;
	USIACTUALUM : USINT;
	ACTIVEUNITMODE : IUnitMode;
	ACTIVEUNITMODENUMBER : USINT;
END_VAR
END_FUNCTION_BLOCK

METHOD ALLOWSSWITCHINGTO : BOOL
VAR_INPUT
	USI : USINT;
END_VAR
END_METHOD

METHOD FINDMODE : USINT
VAR_INPUT
	SNAME : STRING;
END_VAR
END_METHOD

METHOD REGISTER : BOOL
VAR_INPUT
	PUM : IUnitMode;
END_VAR
END_METHOD

METHOD SWITCHUNITMODE : BOOL
VAR_INPUT
	SNEWMODENAME : STRING;
END_VAR
END_METHOD