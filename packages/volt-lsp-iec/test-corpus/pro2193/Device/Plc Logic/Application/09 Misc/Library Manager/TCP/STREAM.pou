END_VAR
END_METHOD

METHOD SETOPTION : ERROR
VAR_INPUT
	DIOPTION : DINT;
	DIVALUE : DINT;
END_VAR
END_METHOD

METHOD GETPUSHBACK1READBYTE
VAR_OUTPUT
	DATA : BYTE;
	CALLED : BOOL;
END_VAR
END_METHOD

METHOD SETPUSHBACK1READBYTE
VAR_INPUT
	DATA : BYTE;
