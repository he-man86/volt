FUNCTION_BLOCK STREAM
VAR
	_HSOCKET : SysTypes.RTS_IEC_HANDLE := SysTypes.RTS_INVALID_HANDLE;
	_ESTATE : STREAM_STATE;
	_TCPSELECT : Select;
	_IPADDR : SysSocket.INADDR;
	_PUSHBACK1READBYTE_DATA : BYTE;
	_PUSHBACK1READBYTE_CALLED : BOOL;
	IPADDRESS : SysSocket.INADDR;
	SOCKET : SysTypes.RTS_IEC_HANDLE;
	STATE : STREAM_STATE;
END_VAR
END_FUNCTION_BLOCK

METHOD CHECKCONNECTIVITY : BOOL
END_METHOD

METHOD CHECKRECEIVE : BOOL
END_METHOD

METHOD CHECKSEND : BOOL
END_METHOD

METHOD CLOSE : ERROR
END_METHOD

METHOD CREATE : ERROR
VAR_INPUT
	HSOCKET : SysTypes.RTS_IEC_HANDLE;
END_VAR
END_METHOD

METHOD FB_EXIT : BOOL
VAR_INPUT
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD FDISSET : BOOL
VAR_INPUT
	SOCKETFD_SET : SysSocket.SOCKET_FD_SET;
END_VAR
END_METHOD

METHOD FDSET
VAR_IN_OUT
	SOCKETFD_SET : SysSocket.SOCKET_FD_SET;
END_VAR
END_METHOD

METHOD GETOPTION : ERROR
VAR_INPUT
