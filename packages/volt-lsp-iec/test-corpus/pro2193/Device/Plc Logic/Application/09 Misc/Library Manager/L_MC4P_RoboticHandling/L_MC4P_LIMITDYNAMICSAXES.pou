FUNCTION_BLOCK L_MC4P_LIMITDYNAMICSAXES EXTENDS L_MC4P_Template_AG_KIN
VAR
	XENABLEOLD : BOOL;
	IDX : WORD;
END_VAR
END_FUNCTION_BLOCK

METHOD MAIN
VAR_INPUT
	XENABLE : BOOL;
	ALRMAXAXESVEL : ARRAY [1..6] OF LREAL;
	ALRMAXAXESACC : ARRAY [1..6] OF LREAL;
	ALRMAXAXESJERK : ARRAY [1..6] OF LREAL;
	AXESOFFSET : WORD;
END_VAR
VAR_OUTPUT
	XVALID : BOOL;
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error := L_IE1P_Error.NoError;
END_VAR
VAR_IN_OUT
