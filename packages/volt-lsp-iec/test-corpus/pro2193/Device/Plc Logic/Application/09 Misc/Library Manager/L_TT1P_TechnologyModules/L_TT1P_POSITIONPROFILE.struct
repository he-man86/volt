TYPE L_TT1P_POSITIONPROFILE :
STRUCT
	EPOSITIONINGMODE : L_TT1P_PositioningMode := L_TT1P_PositioningMode.relative;
	LRPOSITION : LREAL := 0;
	LRVELOCITY : LREAL := 0;
	LRACCELERATION : LREAL := 0;
	LRDECELERATION : LREAL := 0;
	LRJERK : LREAL := 0;
	LRFINALVELOCITY : LREAL := 0;
	LRTPWINDOWNEG : LREAL := 0;
	LRTPWINDOWPOS : LREAL := 0;
	ETPPROFILE : L_TT1P_ProfileNumber := L_TT1P_ProfileNumber.No_Profile;
	ESEQUENCEPROFILE : L_TT1P_ProfileNumber := L_TT1P_ProfileNumber.No_Profile;
END_STRUCT
END_TYPE