	LRSETPOSOUT : LREAL;
	LRSETVELOUT : LREAL;
	LRSETACCOUT : LREAL;
	LRSETTORQUEOUT : LREAL;
END_VAR
VAR
	XENABLEOLD : BOOL;
	XFUNENABLEOLD : BOOL;
	XFUNRESETOLD : BOOL;
	XLOADPOSOFFSETOLD : BOOL;
	XWAITFORDISABLED : BOOL;
	EEXECUTIONINDEXINT : WORD;
	XERRORWRITEITF : BOOL;
	XERRORREADINPUTS : BOOL;
	LRSETPOSIN : LREAL;
	LRSETVELIN : LREAL;
	LRSETACCIN : LREAL;
	LRSETTORQUEIN : LREAL;
	LRPOSOUT : LREAL;
	LRVELOUT : LREAL;
	LRACCOUT : LREAL;
	LRTORQUEOUT : LREAL;
	XFIRSTSTANDSTILL : BOOL;
	XFIRSTSTANDSTILLOLD : BOOL;
