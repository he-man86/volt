	LRSETVELIN : LREAL;
	LRSETACCIN : LREAL;
	LRSETTORQUEIN : LREAL;
	LRPOSOUT : LREAL;
	LRVELOUT : LREAL;
	LRACCOUT : LREAL;
	LRTORQUEOUT : LREAL;
	XFIRSTSTANDSTILL : BOOL;
	XFIRSTSTANDSTILLOLD : BOOL;
