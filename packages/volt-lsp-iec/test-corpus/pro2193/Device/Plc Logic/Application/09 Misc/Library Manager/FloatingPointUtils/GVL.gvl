VAR_GLOBAL
	EXP_MASK_REAL : UDINT := 16#7F800000;
	EXP_OFFSET_REAL : INT := 23;
	MANT_MASK_REAL : UDINT := 16#7FFFFF;
	RES_EXP_REAL : UINT := 16#FF;
	EXP_BIAS_REAL : INT := 127;
	NORM_MANT_REAL : UDINT := 16#800000;
	MAX_MANT_REAL : UDINT := 16#FFFFFF;
	MIN_EXP_REAL : INT := (INT#1 - (EXP_BIAS_REAL + EXP_OFFSET_REAL));
	MAX_EXP_REAL : INT := (UINT_TO_INT(RES_EXP_REAL) - ((INT#1 + EXP_BIAS_REAL) + EXP_OFFSET_REAL));
	EXP_MASK_LREAL : ULINT := 16#7FF0000000000000;
	EXP_OFFSET_LREAL : INT := 52;
	MANT_MASK_LREAL : ULINT := 16#FFFFFFFFFFFFF;
	RES_EXP_LREAL : UINT := 16#7FF;
	EXP_BIAS_LREAL : INT := 1023;
	NORM_MANT_LREAL : ULINT := 16#10000000000000;
	MAX_MANT_LREAL : ULINT := 16#1FFFFFFFFFFFFF;
	MIN_EXP_LREAL : INT := (INT#1 - (EXP_BIAS_LREAL + EXP_OFFSET_LREAL));
	MAX_EXP_LREAL : INT := (UINT_TO_INT(RES_EXP_LREAL) - ((INT#1 + EXP_BIAS_LREAL) + EXP_OFFSET_LREAL));
	STR_NAN : STRING(16) := 'NaN';
	STR_PINF : STRING(16) := '+Inf';
	STR_NINF : STRING(16) := '-Inf';
	LINT_MAX : LINT := 16#7FFFFFFFFFFFFFFF;
	INT_MAX : INT := 16#7FFF;
	INT_MIN : INT := -16#8000;
	DINT_MIN : DINT := -16#8000000;
	DINT_MAX : DINT := 16#7FFFFFFF;
END_VAR