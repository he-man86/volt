TYPE SCALARTYPE :
UNION
	COMPBYTE : BYTE;
	COMPWORD : WORD;
	COMPDWORD : DWORD;
	COMPLWORD : LWORD;
	COMPSINT : SINT;
	COMPUSINT : USINT;
	COMPINT : INT;
	COMPUINT : UINT;
	COMPDINT : DINT;
	COMPUDINT : UDINT;
	COMPLINT : LINT;
	COMPULINT : ULINT;
	COMPBOOL : BOOL;
	COMPREAL : REAL;
	COMPLREAL : LREAL;
END_UNION
END_TYPE