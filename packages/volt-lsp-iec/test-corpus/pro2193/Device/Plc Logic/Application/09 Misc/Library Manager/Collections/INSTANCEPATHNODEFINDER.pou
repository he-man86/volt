FUNCTION_BLOCK INSTANCEPATHNODEFINDER
VAR
	_ROOTNODES : POINTER TO ARRAY [0..0] OF IBaseTreeNode;
	_ROOTNODECOUNT : DINT;
	PROROOTNODECOUNT : DINT;
	PROROOTNODES : POINTER TO ARRAY [0..100] OF IBaseTreeNode;
	PROTCALLNODEFOUNDFORROOTNODE : BOOL;
	PROTCALLNODENOTFOUNDFORROOTNODE : BOOL;
END_VAR
END_FUNCTION_BLOCK

METHOD FIND : IInstancePathBuildingNode
VAR_INPUT
	STPATH : STRING(255);
END_VAR
END_METHOD

METHOD FINDLONG : IInstancePathBuildingNode
VAR_INPUT
	PSTPATH : POINTER TO STRING;
END_VAR
END_METHOD

METHOD FINDLONGWITHDATA : IInstancePathBuildingNode
VAR_INPUT
	PSTPATH : POINTER TO STRING;
	PDATA : POINTER TO BYTE;
END_VAR
VAR_OUTPUT
	BEND : BOOL;
	PRT : POINTER TO IInstancePathBuildingNode;
END_VAR
END_METHOD

METHOD FINDWITHDATA : IInstancePathBuildingNode
VAR_INPUT
	STPATH : STRING(255);
	PDATA : POINTER TO BYTE;
END_VAR
VAR_OUTPUT
	BEND : BOOL;
	PRT : POINTER TO InstancePathBuildingNode;
END_VAR
END_METHOD

METHOD INITIALIZE : BOOL
VAR_INPUT
	PROOTNODES : POINTER TO ARRAY [0..100] OF IBaseTreeNode;
	INODECOUNT : DINT;
END_VAR
END_METHOD

METHOD ABSTRIGNOREROOTNODE : BOOL
VAR_INPUT
	PNODE : IInstancePathBuildingNode;
	PDATA : POINTER TO BYTE;
END_VAR
END_METHOD

METHOD ABSTRNODEFOUND : IInstancePathBuildingNode
VAR_INPUT
	PNODE : IInstancePathBuildingNode;
	PDATA : POINTER TO BYTE;
	BDIRECTCHILDFOUND : BOOL;
END_VAR
END_METHOD

METHOD ABSTRNODENOTFOUND : IInstancePathBuildingNode
VAR_INPUT
	PPARENT : IInstancePathBuildingNode;
	PDATA : POINTER TO BYTE;
	PSTPATH : POINTER TO STRING;
END_VAR
VAR_IN_OUT
	IOFFSETINPATH : DINT;
END_VAR
END_METHOD

METHOD ABSTRNOTFOUND : IInstancePathBuildingNode
VAR_INPUT
	PSTPATH : POINTER TO STRING;
END_VAR
END_METHOD