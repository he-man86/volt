FUNCTION_BLOCK L_IE1P_READACTUALERRORCODE
VAR_INPUT
	XENABLE : BOOL;
	MODULEHANDLER : L_IMHP_IModuleHandler;
	ERRORHANDLER : L_IE1P_IErrorHandler;
END_VAR
VAR_OUTPUT
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	XERRORACTIVE : BOOL;
	XWARNINGACTIVE : BOOL;
	DWERRORCODE : DWORD;
	ESEVERITY : L_IE1P_SeverityLevel;
END_VAR
VAR
	SEVTMP : WORD;
	XACTUALERRORFROMMODULESUPPORTED : BOOL := FALSE;
	MYMODULETMP : L_IMHP_IModuleHandler;
END_VAR
END_FUNCTION_BLOCK