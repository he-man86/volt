FUNCTION_BLOCK MC_SETCOORDINATETRANSFORM EXTENDS L_MC4P_Template_AG_KIN
VAR_INPUT
	EXECUTE : BOOL;
	COORDTRANSFORM : MC_COORD_REF;
	COORDSYSTEM : L_MC4P_CoordSystem;
END_VAR
VAR_OUTPUT
	DONE : BOOL;
	BUSY : BOOL;
	ACTIVE : BOOL;
	COMMANDABORTED : BOOL;
	ERROR : BOOL;
	ERRORID : L_IE1P_Error;
END_VAR
VAR
	PCOORDTRAFO : POINTER TO L_MC4P_CoordTrafo;
	XEXECUTEOLD : BOOL;
	XRESETOUTPUT : BOOL;
	ISTATE : INT;
	BSTATEMACHINE : BOOL;
	PTRACKINGPARAM : POINTER TO L_MC4P_PCSTrackParam;
	COORDTRANSFFREEZE : MC_COORD_REF;
	AXPARACCESSIBLE : ARRAY [1..7] OF BOOL;
	IDX : DINT;
	XINTERNALTESTMODE : BOOL := FALSE;
	INTERNALTESTMODE : BOOL;
END_VAR
END_FUNCTION_BLOCK