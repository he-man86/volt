	APARAMDATA : ARRAY [1..c_MaxSimData] OF L_MC1P_ParameterDataSim;
	APRMIGNOREDATA : ARRAY [1..c_MaxPrmIgnoreData] OF L_MC1P_ParameterDataSim;
