	ASCPDO_P2D : ARRAY [0..(ciPDO_BufferSize - 1)] OF L_MC1P_AxisSimulationPDOdataToDrive;
	ASCPDO_D2P : ARRAY [0..(ciPDO_BufferSize - 1)] OF L_MC1P_AxisSimulationPDOdataFromDrive;
