	ITFMECHANICMODELDEFAULT : L_MC1P_IMechanicSimulation := MechanicSimulation;
	ITFMECHANICMODELACT : L_MC1P_IMechanicSimulation := itfMechanicModelDefault;
	TRANSMITDATASCALED : L_MC1P_AxisSimulationPDOdataToDriveScaled;
	RECIEVEDATASCALED : L_MC1P_AxisSimulationPDOdataFromDriveScaled;
