FUNCTION_BLOCK L_MC4P_TOOLCONTROL
VAR_INPUT
	XENABLE : BOOL;
	ETOOLSYSTEM : L_MC4P_ToolSystem;
END_VAR
VAR_OUTPUT
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	XPULSEON : BOOL;
	XPULSEOFF : BOOL;
	LRTIMETOPULSE : LREAL;
END_VAR
VAR_IN_OUT
	AXESGROUP : AXES_GROUP_KIN;
END_VAR
VAR
	_ON_TRIG : R_Trig;
	_OFF_TRIG : R_Trig;
	_ITFTOOL : L_MC4P_IToolInfo;
	_NSTATE : DWORD := 10;
	_ETOOLSYSTEMFREEZE : L_MC4P_ToolSystem;
	_PTOOL : POINTER TO L_MC4P_ToolTrafo;
	_ETOOLREQU : L_MC4P_ToolRequest;
	_LRSWITCHTIME : LREAL;
	_MODEL : L_UBUP_BehaviourModel_LCon;
END_VAR
END_FUNCTION_BLOCK