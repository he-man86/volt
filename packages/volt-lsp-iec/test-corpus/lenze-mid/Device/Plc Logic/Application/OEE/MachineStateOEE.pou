PROGRAM MachineStateOEE
VAR
END_VAR

%LANGUAGE LD
%NETWORK "DONE NETWORK 49: State of the machine"
VAR w1 : ANY; w2 : ANY; END_VAR
w1 := TRUE;
MOVE(EN := w1 AND (Mach1.GenFlags.MajorAlarm OR Mach1.GenFlags.MinorAlarm), eStates.Aborted, OUT => GVL_OEE_Var.eStatus_States);
w2 := w1 AND INVERT(Mach1.GenFlags.MajorAlarm) AND INVERT(Mach1.GenFlags.MinorAlarm);
MOVE(EN := w2 AND INVERT(Mach1.GenFlags.RunMan) AND INVERT(Mach1.GenFlags.RunAuto), eStates.Stopped, OUT => GVL_OEE_Var.eStatus_States);
MOVE(EN := w2 AND (Mach1.GenFlags.RunMan OR Mach1.GenFlags.RunAuto), eStates.Execute, OUT => GVL_OEE_Var.eStatus_States);

END_PROGRAM
