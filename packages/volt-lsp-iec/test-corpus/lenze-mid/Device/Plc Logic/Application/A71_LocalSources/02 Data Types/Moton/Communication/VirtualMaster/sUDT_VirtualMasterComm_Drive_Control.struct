TYPE sUDT_VirtualMasterComm_Drive_Control :
STRUCT

	Enable 				: BOOL;
	ResetError 			: BOOL;
	ReleaseBrake 		: BOOL;
	SetHomePos 			: BOOL;
	StartMovement	 	: BOOL;
	ResetHomePos 		: BOOL;

	PosUnit 				: LREAL; //0.1 unit
	VelUnit 				: LREAL;
	AccUnit 				: LREAL:=200;
	DecUnit 				: LREAL:=200;
	TorqueMode_SetTorque	: LREAL:=0.1;// unit
	TorqueLimit				: LREAL:=1;
	
END_STRUCT
END_TYPE
