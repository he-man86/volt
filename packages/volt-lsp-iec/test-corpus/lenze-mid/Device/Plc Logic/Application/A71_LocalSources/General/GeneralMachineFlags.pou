FUNCTION_BLOCK GeneralMachineFlags
VAR_INPUT
	iStartResetSeparate:BOOL;
	iServiceButtonHasResetFunction:BOOL;
	iFirstCycle:BOOL;
	iSignalPulse:BOOL;
	iAirPressureDoorsSeparate:BOOL;
	iEmergencyUnitOK:BOOL;
	iDoorUnitOK:BOOL;
	iSTO_Enabled:BOOL;
	iAirPressureOK:BOOL;
	iSwitchService:BOOL;
	iButtonService:BOOL;
	iStart1:BOOL;
	iStop1:BOOL;
	iReset1:BOOL;
	iAutoManual1:BOOL;
	iStart2:BOOL;
	iStop2:BOOL;
	iReset2:BOOL;
	iAutoManual2:BOOL;
	iStart3:BOOL;
	iStop3:BOOL;
	iReset3:BOOL;
	iAutoManual3:BOOL;
	iPreDelayAfterEmergStop: TIME;
	iPreStartDelayAuxDrives: TIME;
	iPreStopDelayAuxDrives: TIME;
	iPreDelayAfterSTOEnabled: TIME;

END_VAR
VAR_OUTPUT
	oResetEmergencyUnit:BOOL;
	oResetDoorUnit:BOOL;
	oStart1:BOOL;
	oStop1:BOOL;
	oReset1:BOOL;
	oCrossingDoorCircuit1:BOOL;
	oStart2:BOOL;
	oStop2:BOOL;
	oReset2:BOOL;
	oCrossingDoorCircuit2:BOOL;
	oStart3:BOOL;
	oStop3:BOOL;
	oReset3:BOOL;
	oCrossingDoorCircuit3:BOOL;
	oAlarm:BOOL;

END_VAR
VAR_IN_OUT
	GenFlags	: UDT_GeneralFlags;
END_VAR
VAR
	OneShotStart1: R_TRIG;
	OneShotStart2: R_TRIG;
	OneShotReset1: R_TRIG;
	OneShotReset2: BOOL;
	DnStartDelayAuxDrives: BOOL;
	DnStopDelayAuxDrives: BOOL;
	DnManualStopAuxDrives: BOOL;
	
	OffDelayPneumPressurised: TOF;
	OffDelayPneumSafetyGuard: TOF;
	OffDelayPneumEStop: TOF;
	
	OnDelayAfterEmergencyStop: TON;
	OnDelayStopAuxDrives: TON;
	OnDelayAfterSTOEnabled: TON;
	OnDelayManStopAuxDrives: TON;
	OnDelayStartAuxDrives: TON;

	RunAuto: SR;

END_VAR

IMPLEMENTATION LD
NETWORK TITLE: "NETWORK 2: Startup delay after emergency stop"
  GenFlags.DelayAfterEmergStop := OnDelayAfterEmergencyStop(IN := NOT iFirstCycle AND iEmergencyUnitOK, PT := iPreDelayAfterEmergStop);
END_NETWORK
NETWORK TITLE: "NETWORK 3: Startup delay after STO has been enabled"
  GenFlags.DelayAfterSTO := OnDelayAfterSTOEnabled(IN := GenFlags.DelayAfterEmergStop AND iSTO_Enabled, PT := iPreDelayAfterSTOEnabled);
END_NETWORK
NETWORK TITLE: "NETWORK 4: Stop delay auxiliary drives"
  split28 := GenFlags.EnableAuxDrive AND NOT GenFlags.StartFlag AND DnStartDelayAuxDrives AND NOT GenFlags.DriveIsRunning AND NOT GenFlags.Rotflag;
  DnStopDelayAuxDrives := OnDelayStopAuxDrives(IN := split28, PT := iPreStopDelayAuxDrives);
  DnStopDelayAuxDrives := split28 BRANCH ((iPreStopDelayAuxDrives EQ T#0MS EN),
                                          DnStopDelayAuxDrives) SHORTCIRCUIT;
END_NETWORK
NETWORK TITLE: "NETWORK 5: Manual stop auxiliary drives"
  DnManualStopAuxDrives := OnDelayManStopAuxDrives(IN := GenFlags.EnableAuxDrive AND (NOT iStop1 OR NOT iStop2 OR NOT iStop3), PT := T#2S);
END_NETWORK
NETWORK TITLE: "NETWORK 6: Startup delay auxiliary drives"
  split47 := True;
  split48 := split47 AND GenFlags.EnableAuxDrive AND NOT GenFlags.AuxDrivesStarted;
  DnStartDelayAuxDrives := OnDelayStartAuxDrives(IN := split48, PT := iPreStartDelayAuxDrives);
  DnStartDelayAuxDrives := split48 BRANCH ((iPreStartDelayAuxDrives EQ T#0MS EN),
                                           DnStartDelayAuxDrives) SHORTCIRCUIT;
  GenFlags.AuxDrivesStarted R= split47;
END_NETWORK
NETWORK TITLE: "NETWORK 7: Enable markers"
  split190 := GenFlags.DelayAfterEmergStop AND NOT GenFlags.MajorAlarm;
  split191 := split190 AND iDoorUnitOK;
  GenFlags.EnableControl := split191 AND NOT GenFlags.DisableControl;
  GenFlags.EnableMainDrive := split191 AND GenFlags.EnableAuxDrive AND NOT GenFlags.AuxDrivesStarted AND DnStartDelayAuxDrives;
  GenFlags.EnableAuxDrive := split190 AND (GenFlags.StartFlag OR (GenFlags.RunAuto AND GenFlags.RestartAuxDrives) OR (GenFlags.EnableAuxDrive AND NOT DnStopDelayAuxDrives AND NOT DnManualStopAuxDrives));
END_NETWORK
NETWORK TITLE: "NETWORK 8: Pneumatic markers"
  split118 := iEmergencyUnitOK;
  GenFlags.EnablePneumEStop := OffDelayPneumEStop(IN := split118, PT := T#1S);
  split119 := split118 AND (iSTO_Enabled OR NOT iAirPressureDoorsSeparate);
  GenFlags.EnablePneumSafetyGuard := OffDelayPneumSafetyGuard(IN := split119, PT := T#1S);
  GenFlags.EnablePneumPressurised := OffDelayPneumPressurised(IN := split119 AND iAirPressureOK, PT := T#1S);
END_NETWORK
NETWORK TITLE: "NETWORK 9: Active control panel"
  split159 := True;
  GenFlags.ControlService := split159 AND iSwitchService;
  split160 := split159 AND NOT iSwitchService;
  GenFlags.ControlMan1 := split160 AND iAutoManual1 AND NOT iAutoManual2 AND NOT iAutoManual3;
  split161 := split160 AND NOT iAutoManual1;
  GenFlags.ControlMan2 := split161 AND iAutoManual2 AND NOT iAutoManual3;
  split162 := split161 AND NOT iAutoManual2;
  GenFlags.ControlMan3 := split162 AND iAutoManual3;
  GenFlags.ControlAuto := split162 AND NOT iAutoManual3;
END_NETWORK
NETWORK TITLE: "NETWORK 10: Control manual"
  GenFlags.RunMan := GenFlags.EnableControl AND ((GenFlags.ControlService AND iButtonService) OR (GenFlags.ControlMan1 AND iStart1) OR (GenFlags.ControlMan2 AND iStart2) OR (GenFlags.ControlMan3 AND iStart3)) AND iStop1 AND iStop2 AND iStop3;
END_NETWORK
NETWORK TITLE: "NETWORK 11: Control automatic"
  GenFlags.RunAuto := RunAuto(SET1 := GenFlags.EnableControl AND GenFlags.ControlAuto AND (iStart1 OR iStart2 OR iStart3) AND iStop1 AND iStop2 AND iStop3, RESET := GenFlags.RunAuto AND (NOT GenFlags.EnableControl OR NOT GenFlags.ControlAuto OR NOT iStop1 OR NOT iStop2 OR NOT iStop3 OR (NOT GenFlags.DriveIsRunning AND (GenFlags.MinorAlarm OR GenFlags.MajorAlarm))));
END_NETWORK
NETWORK TITLE: "DONE NETWORK 12: Start pulse"
  GenFlags.StartFlag := (OneShotStart1(CLK := (GenFlags.ControlService AND iButtonService) OR (GenFlags.ControlMan1 AND iStart1) OR (GenFlags.ControlMan2 AND iStart2) OR (GenFlags.ControlMan3 AND iStart3) OR (GenFlags.ControlAuto AND (iStart1 OR iStart2 OR iStart3)) OR OneShotStart2.Q) AND iStop1 AND iStop2 AND iStop3) OR OneShotStart2(CLK := GenFlags.RunMan OR GenFlags.RunAuto);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 13: Reset pulse"
  GenFlags.ResetFlag := (OneShotReset1(CLK := (GenFlags.ControlService AND ((iServiceButtonHasResetFunction AND iButtonService) OR iReset1 OR iReset2 OR iReset3)) OR ((GenFlags.ControlMan1 OR GenFlags.ControlMan2 OR GenFlags.ControlMan3 OR GenFlags.ControlAuto) AND (iReset1 OR iReset2 OR iReset3))) AND iStop1 AND iStop2 AND iStop3) OR (NOT iStartResetSeparate AND GenFlags.StartFlag);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 14: Stop flag"
  GenFlags.StopFlag := NOT iStop1 OR NOT iStop2 OR NOT iStop3 OR (GenFlags.StopFlag AND NOT GenFlags.StartFlag);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 15: Reset safety unit"
  oResetEmergencyUnit := (NOT iEmergencyUnitOK OR (iEmergencyUnitOK AND NOT iDoorUnitOK)) AND ((iStartResetSeparate AND (((GenFlags.ControlMan1 OR GenFlags.ControlMan2 OR GenFlags.ControlMan3 OR GenFlags.ControlAuto) AND (iReset1 OR iReset2 OR iReset3)) OR (GenFlags.ControlService AND ((iServiceButtonHasResetFunction AND iButtonService) OR iReset1 OR iReset2 OR iReset3)))) OR (NOT iStartResetSeparate AND (((GenFlags.ControlMan1 OR GenFlags.ControlAuto) AND iStart1) OR ((GenFlags.ControlMan2 OR GenFlags.ControlAuto) AND iStart2) OR ((GenFlags.ControlMan3 OR GenFlags.ControlAuto) AND iStart3) OR (GenFlags.ControlService AND iButtonService)) AND iStop1 AND iStop2 AND iStop3));
END_NETWORK
NETWORK TITLE: "DONE NETWORK 16: Reset door unit"
  oResetDoorUnit := iEmergencyUnitOK AND NOT iDoorUnitOK AND ((iStartResetSeparate AND (((GenFlags.ControlMan1 OR GenFlags.ControlMan2 OR GenFlags.ControlMan3 OR GenFlags.ControlAuto) AND (iReset1 OR iReset2 OR iReset3)) OR (GenFlags.ControlService AND ((iServiceButtonHasResetFunction AND iButtonService) OR iReset1 OR iReset2 OR iReset3)))) OR (NOT iStartResetSeparate AND (((GenFlags.ControlMan1 OR GenFlags.ControlAuto) AND iStart1) OR ((GenFlags.ControlMan2 OR GenFlags.ControlAuto) AND iStart2) OR ((GenFlags.ControlMan3 OR GenFlags.ControlAuto) AND iStart3) OR (GenFlags.ControlService AND iButtonService)) AND iStop1 AND iStop2 AND iStop3));
END_NETWORK
NETWORK TITLE: "DONE NETWORK 17: Crossing doorcircuit control panel 1"
  oCrossingDoorCircuit1 := GenFlags.ControlMan1;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 18: Crossing doorcircuit control panel 2"
  oCrossingDoorCircuit2 := GenFlags.ControlMan2;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 19: Crossing doorcircuit control panel 3"
  oCrossingDoorCircuit3 := GenFlags.ControlMan3;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 20: Signal lamps control panel 1 "
  split187 := True;
  oStart1 := split187 AND (GenFlags.ControlMan1 OR GenFlags.ControlAuto) AND (((GenFlags.RunMan OR GenFlags.RunAuto) AND NOT GenFlags.MinorAlarm AND NOT GenFlags.MajorAlarm) OR ((GenFlags.EnableControl OR (NOT iStartResetSeparate AND (GenFlags.MinorAlarm OR GenFlags.MajorAlarm))) AND iSignalPulse AND ((NOT GenFlags.MinorAlarm AND NOT GenFlags.MajorAlarm) OR NOT iStartResetSeparate)));
  oStop1 := split187 AND iEmergencyUnitOK AND (NOT GenFlags.RunMan OR NOT GenFlags.ControlMan1) AND NOT GenFlags.RunAuto;
  oReset1 := split187 AND (GenFlags.ControlMan1 OR GenFlags.ControlMan2 OR GenFlags.ControlMan3 OR GenFlags.ControlAuto OR GenFlags.ControlService) AND (GenFlags.MinorAlarm OR GenFlags.MajorAlarm OR NOT iDoorUnitOK) AND iSignalPulse;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 21: Signal lamps control panel 2"
  split186 := True;
  oStart2 := split186 AND (GenFlags.ControlMan2 OR GenFlags.ControlAuto) AND (((GenFlags.RunMan OR GenFlags.RunAuto) AND NOT GenFlags.MinorAlarm AND NOT GenFlags.MajorAlarm) OR ((GenFlags.EnableControl OR (NOT iStartResetSeparate AND (GenFlags.MinorAlarm OR GenFlags.MajorAlarm))) AND iSignalPulse AND ((NOT GenFlags.MinorAlarm AND NOT GenFlags.MajorAlarm) OR NOT iStartResetSeparate)));
  oStop2 := split186 AND iEmergencyUnitOK AND (NOT GenFlags.RunMan OR NOT GenFlags.ControlMan1) AND NOT GenFlags.RunAuto;
  oReset2 := split186 AND (GenFlags.ControlMan1 OR GenFlags.ControlMan2 OR GenFlags.ControlMan3 OR GenFlags.ControlAuto OR GenFlags.ControlService) AND (GenFlags.MinorAlarm OR GenFlags.MajorAlarm OR NOT iDoorUnitOK) AND iSignalPulse;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 22: Signal lamps control panel 3"
  split0 := True;
  oStart3 := split0 AND (GenFlags.ControlMan3 OR GenFlags.ControlAuto) AND (((GenFlags.RunMan OR GenFlags.RunAuto) AND NOT GenFlags.MinorAlarm AND NOT GenFlags.MajorAlarm) OR ((GenFlags.EnableControl OR (NOT iStartResetSeparate AND (GenFlags.MinorAlarm OR GenFlags.MajorAlarm))) AND iSignalPulse AND ((NOT GenFlags.MinorAlarm AND NOT GenFlags.MajorAlarm) OR NOT iStartResetSeparate)));
  oStop3 := split0 AND iEmergencyUnitOK AND (NOT GenFlags.RunMan OR NOT GenFlags.ControlMan1) AND NOT GenFlags.RunAuto;
  oReset3 := split0 AND (GenFlags.ControlMan1 OR GenFlags.ControlMan2 OR GenFlags.ControlMan3 OR GenFlags.ControlAuto OR GenFlags.ControlService) AND (GenFlags.MinorAlarm OR GenFlags.MajorAlarm OR NOT iDoorUnitOK) AND iSignalPulse;
END_NETWORK
NETWORK TITLE: "TODO NETWORK 23: Signal lamp alarm"
  oAlarm := (GenFlags.Warning OR GenFlags.MinorAlarm OR GenFlags.MajorAlarm) AND iSignalPulse;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 24: Only when during a complete CPU cycle there is no alarm, the $"Active$"-alarm signals are reset"
  split185 := True;
  GenFlags.WarningActive := split185 AND GenFlags.Warning;
  GenFlags.MinorAlarmActive := split185 AND GenFlags.MinorAlarm;
  GenFlags.MajorAlarmActive := split185 AND GenFlags.MajorAlarm;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 25: Reset alarm actions"
  GenFlags.Warning R= GenFlags.MinorAlarm R= GenFlags.MajorAlarm R= GenFlags.DummyWarning R= GenFlags.DisableControl R= True;
END_NETWORK
NETWORK TITLE: "TODO NETWORK 26: SAVE"
END_NETWORK

END_FUNCTION_BLOCK
