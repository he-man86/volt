FUNCTION_BLOCK VirtualMasterControl
VAR_INPUT
	iAcc: REAL:=1800;
	iDec: REAL:=1800;
	
END_VAR
VAR_OUTPUT
END_VAR
VAR
END_VAR
VAR_IN_OUT
	ioVirtualMaster: UDT_VirtualMaster;
	ioVirtualMasterCom: sUDT_VirtualMasterComm_Drive;
	
END_VAR

%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
w1 := TRUE;
ASSIGN(w1 AND ioVirtualMaster.Control.SetDriveEnable, Q => ioVirtualMasterCom.Control.Enable);
ASSIGN(w1 AND ioVirtualMaster.Control.ResetError, Q => ioVirtualMasterCom.Control.ResetError);
%NETWORK
VAR w2 : ANY; END_VAR
w2 := ioVirtualMaster.Control.StartMovement;
ASSIGN(w2, Q => ioVirtualMasterCom.Control.StartMovement);
MOVE(EN := w2, Mach1_Data.Drives.MainDrive_VM.Control.DriveMasterSpeed, OUT => ioVirtualMasterCom.Control.VelUnit);
MOVE(EN := w2, iDec, OUT => ioVirtualMasterCom.Control.DecUnit);
MOVE(EN := w2, iAcc, OUT => ioVirtualMasterCom.Control.AccUnit);
%NETWORK
DIV(EN := DIV(EN := TRUE, OPERAND('LREAL_TO_INT(ioVirtualMasterCom.Status.ActSpeed)'), 6, OUT => ioVirtualMaster.Status.ActSpeed), OPERAND('LREAL_TO_INT(ioVirtualMasterCom.Status.ActPos)'), 1, OUT => ioVirtualMaster.Status.ActXPos);
%NETWORK
ASSIGN(ioVirtualMasterCom.Status.ReadyForMotion, Q => ioVirtualMaster.Status.DriveIsReady);
%NETWORK

END_FUNCTION_BLOCK
