FUNCTION_BLOCK VirtualMasterControl
VAR_INPUT
	iAcc: REAL:=1800;
	iDec: REAL:=1800;
	
END_VAR
VAR_OUTPUT
END_VAR
VAR
END_VAR
VAR_IN_OUT
	ioVirtualMaster: UDT_VirtualMaster;
	ioVirtualMasterCom: sUDT_VirtualMasterComm_Drive;
	
END_VAR

%LANGUAGE LD
%NETWORK
%WIRES w1
w1 := TRUE;
ioVirtualMasterCom.Control.Enable := w1 AND ioVirtualMaster.Control.SetDriveEnable;
ioVirtualMasterCom.Control.ResetError := w1 AND ioVirtualMaster.Control.ResetError;
%NETWORK
%WIRES w2
w2 := ioVirtualMaster.Control.StartMovement;
ioVirtualMasterCom.Control.StartMovement := w2;
MOVE_EN(EN := w2, Mach1_Data.Drives.MainDrive_VM.Control.DriveMasterSpeed, OUT => ioVirtualMasterCom.Control.VelUnit);
MOVE_EN(EN := w2, iDec, OUT => ioVirtualMasterCom.Control.DecUnit);
MOVE_EN(EN := w2, iAcc, OUT => ioVirtualMasterCom.Control.AccUnit);
%NETWORK
DIV_EN(EN := DIV_EN(EN := TRUE, LREAL_TO_INT(ioVirtualMasterCom.Status.ActSpeed), 6, OUT => ioVirtualMaster.Status.ActSpeed), LREAL_TO_INT(ioVirtualMasterCom.Status.ActPos), 1, OUT => ioVirtualMaster.Status.ActXPos);
%NETWORK
ioVirtualMaster.Status.DriveIsReady := ioVirtualMasterCom.Status.ReadyForMotion;
%NETWORK

END_FUNCTION_BLOCK
