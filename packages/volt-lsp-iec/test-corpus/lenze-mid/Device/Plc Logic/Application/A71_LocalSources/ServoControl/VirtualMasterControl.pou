FUNCTION_BLOCK VirtualMasterControl
VAR_INPUT
	iAcc: REAL:=1800;
	iDec: REAL:=1800;
	
END_VAR
VAR_OUTPUT
END_VAR
VAR
END_VAR
VAR_IN_OUT
	ioVirtualMaster: UDT_VirtualMaster;
	ioVirtualMasterCom: sUDT_VirtualMasterComm_Drive;
	
END_VAR

%LANGUAGE LD
NETWORK
  split3 := TRUE;
  ioVirtualMasterCom.Control.Enable := split3 AND ioVirtualMaster.Control.SetDriveEnable;
  ioVirtualMasterCom.Control.ResetError := split3 AND ioVirtualMaster.Control.ResetError;
END_NETWORK
NETWORK
  split0 := ioVirtualMaster.Control.StartMovement;
  ioVirtualMasterCom.Control.StartMovement := split0;
  MOVE Mach1_Data.Drives.MainDrive_VM.Control.DriveMasterSpeed => ioVirtualMasterCom.Control.VelUnit ENO EN split0;
  MOVE iDec => ioVirtualMasterCom.Control.DecUnit ENO EN split0;
  MOVE iAcc => ioVirtualMasterCom.Control.AccUnit ENO EN split0;
END_NETWORK
NETWORK
  `LREAL_TO_INT(ioVirtualMasterCom.Status.ActPos)` DIV 1 => ioVirtualMaster.Status.ActXPos ENO EN
    `LREAL_TO_INT(ioVirtualMasterCom.Status.ActSpeed)` DIV 6 => ioVirtualMaster.Status.ActSpeed ENO EN TRUE;
END_NETWORK
NETWORK
  ioVirtualMaster.Status.DriveIsReady := ioVirtualMasterCom.Status.ReadyForMotion;
END_NETWORK
NETWORK
END_NETWORK

END_FUNCTION_BLOCK
