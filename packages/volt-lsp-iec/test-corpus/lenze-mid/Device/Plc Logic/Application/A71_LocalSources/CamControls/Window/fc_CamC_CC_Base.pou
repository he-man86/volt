FUNCTION fc_CamC_CC_Base 
VAR_INPUT
	i_xEnable				: BOOL; 
	i_intStartCam			: INT; 
	i_intStopCam			: INT; 
	i_lrMachinePosition 	: LREAL; 
END_VAR
VAR_OUTPUT
	o_xCamControl			: BOOL; 
END_VAR
VAR
END_VAR

%LANGUAGE LD
%NETWORK
%WIRES w1, w2, w3, w4, w5, w6
LT_EN(EN := TRUE, i_intStartCam, i_intStopCam, OUT => w3);
GE_EN(EN := w3, i_lrMachinePosition, i_intStartCam, OUT => w2);
LE_EN(EN := w2, i_lrMachinePosition, i_intStopCam, OUT => w1);
GT_EN(EN := TRUE, i_intStartCam, i_intStopCam, OUT => w4);
GE_EN(EN := TRUE, i_lrMachinePosition, i_intStartCam, OUT => w5);
LE_EN(EN := TRUE, i_lrMachinePosition, i_intStopCam, OUT => w6);
o_xCamControl := i_xEnable AND (w1 OR w4 AND (w5 OR w6));

END_FUNCTION
