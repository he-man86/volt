FUNCTION fc_CamC_CC_Base 
VAR_INPUT
	i_xEnable				: BOOL; 
	i_intStartCam			: INT; 
	i_intStopCam			: INT; 
	i_lrMachinePosition 	: LREAL; 
END_VAR
VAR_OUTPUT
	o_xCamControl			: BOOL; 
END_VAR
VAR
END_VAR

%LANGUAGE LD
%NETWORK
ASSIGN(BRANCH_SHORTCIRCUIT(FEED := i_xEnable, LE(EN := GE(EN := LT(EN := RAIL(), i_intStartCam, i_intStopCam).OUT, i_lrMachinePosition, i_intStartCam).OUT, i_lrMachinePosition, i_intStopCam).OUT, BRANCH_SHORTCIRCUIT(FEED := GT(EN := RAIL(), i_intStartCam, i_intStopCam).OUT, GE(EN := RAIL(), i_lrMachinePosition, i_intStartCam).OUT, LE(EN := RAIL(), i_lrMachinePosition, i_intStopCam).OUT)), Q => o_xCamControl);

END_FUNCTION
