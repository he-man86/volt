FUNCTION fc_CamC_CC_Base 
VAR_INPUT
	i_xEnable				: BOOL; 
	i_intStartCam			: INT; 
	i_intStopCam			: INT; 
	i_lrMachinePosition 	: LREAL; 
END_VAR
VAR_OUTPUT
	o_xCamControl			: BOOL; 
END_VAR
VAR
END_VAR

%LANGUAGE LD
%NETWORK
o_xCamControl := BRANCH_SHORTCIRCUIT(FEED := i_xEnable, LE(EN := GE(EN := LT(EN := TRUE, i_intStartCam, i_intStopCam), i_lrMachinePosition, i_intStartCam), i_lrMachinePosition, i_intStopCam), BRANCH_SHORTCIRCUIT(FEED := GT(EN := TRUE, i_intStartCam, i_intStopCam), GE(EN := TRUE, i_lrMachinePosition, i_intStartCam), LE(EN := TRUE, i_lrMachinePosition, i_intStopCam)));

END_FUNCTION
