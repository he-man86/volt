FUNCTION fc_CamC_CC_Base 
VAR_INPUT
	i_xEnable				: BOOL; 
	i_intStartCam			: INT; 
	i_intStopCam			: INT; 
	i_lrMachinePosition 	: LREAL; 
END_VAR
VAR_OUTPUT
	o_xCamControl			: BOOL; 
END_VAR
VAR
END_VAR

%LANGUAGE LD
NETWORK
  o_xCamControl := i_xEnable BRANCH (i_lrMachinePosition LE i_intStopCam EN
                                       i_lrMachinePosition GE i_intStartCam EN
                                         i_intStartCam LT i_intStopCam EN,
                                     (i_intStartCam GT i_intStopCam EN) BRANCH (i_lrMachinePosition GE i_intStartCam EN, i_lrMachinePosition LE i_intStopCam EN) SHORTCIRCUIT) SHORTCIRCUIT;
END_NETWORK

END_FUNCTION
