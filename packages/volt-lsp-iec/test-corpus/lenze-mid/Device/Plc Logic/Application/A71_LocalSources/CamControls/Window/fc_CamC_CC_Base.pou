FUNCTION fc_CamC_CC_Base 
VAR_INPUT
	i_xEnable				: BOOL; 
	i_intStartCam			: INT; 
	i_intStopCam			: INT; 
	i_lrMachinePosition 	: LREAL; 
END_VAR
VAR_OUTPUT
	o_xCamControl			: BOOL; 
END_VAR
VAR
END_VAR

%LANGUAGE LD
%NETWORK
o_xCamControl := BRANCH_SHORTCIRCUIT(FEED := i_xEnable, LE_ENONLY(EN := GE_ENONLY(EN := LT_ENONLY(EN := TRUE, i_intStartCam, i_intStopCam), i_lrMachinePosition, i_intStartCam), i_lrMachinePosition, i_intStopCam), BRANCH_SHORTCIRCUIT(FEED := GT_ENONLY(EN := TRUE, i_intStartCam, i_intStopCam), GE_ENONLY(EN := TRUE, i_lrMachinePosition, i_intStartCam), LE_ENONLY(EN := TRUE, i_lrMachinePosition, i_intStopCam)));

END_FUNCTION
