FUNCTION_BLOCK ServoControl
VAR_INPUT
	iServoStatus 	: sUDT_ServoComm_Drive_Status;
	iEnableHomeMovement : BOOL;
	iEnablePower 		: BOOL;
	iFF100ms 			: BOOL;


END_VAR
VAR_OUTPUT
	oServoControl 		: sUDT_ServoComm_Drive_Control;

END_VAR
VAR

	intYScale: 	INT;

	Man_SetHomePos: BOOL;
	OSP_SetHomnePos: R_TRIG;
	HomingDoneDelay: TON;
END_VAR
VAR_IN_OUT
	ioUDT_ServoDrive			: UDT_ServoDrive;
END_VAR
VAR RETAIN PERSISTENT
	STATE_Prehoming: BOOL;
	STATE_HomePosNOK: BOOL;
	STATE_HomePOSOK: BOOL;
	STATE_WaitingForEnable: BOOL;
	STATE_Synchronising: BOOL;
END_VAR
VAR CONSTANT
	ctCurveIs0ToMax: INT := 0;
	ctCurveIs0To0: INT := 1;
	ctCurveIsSpeed: INT := 2;
END_VAR
IMPLEMENTATION LD
NETWORK TITLE: "Network 2 : Initialise with STATE HomePosNotOK"
  split8 := NOT STATE_Prehoming AND NOT STATE_HomePosNOK AND NOT STATE_HomePOSOK AND NOT STATE_WaitingForEnable AND NOT STATE_Synchronising;
  STATE_Prehoming R= split8;
  STATE_HomePosNOK R= split8;
  STATE_HomePOSOK R= split8;
  STATE_WaitingForEnable R= split8;
  STATE_Synchronising R= split8;
  STATE_HomePosNOK S= split8;
END_NETWORK
NETWORK TITLE: "Network 3 : STATE: Prehoming "
  STATE_Prehoming S= STATE_HomePOSOK R= STATE_WaitingForEnable R= STATE_Synchronising R= (STATE_WaitingForEnable OR STATE_Synchronising) AND iServoStatus.DriveCommAlive AND Man_SetHomePos AND iServoStatus.HomingPosOK;
END_NETWORK
NETWORK TITLE: "STATE: HomePos not OK"
  STATE_HomePosNOK S= STATE_Prehoming R= STATE_HomePOSOK R= STATE_WaitingForEnable R= STATE_Synchronising R= (STATE_Prehoming OR STATE_HomePOSOK OR STATE_WaitingForEnable OR STATE_Synchronising) AND iServoStatus.DriveCommAlive AND NOT iServoStatus.HomingPosOK;
END_NETWORK
NETWORK TITLE: "Network 5: STATE: HomePos OK"
  STATE_HomePOSOK S= STATE_HomePosNOK R= Man_SetHomePos R= STATE_HomePosNOK AND iServoStatus.DriveCommAlive AND iServoStatus.HomingPosOK;
END_NETWORK
NETWORK TITLE: "Network 6 : STATE: WaitingForEnable"
  STATE_WaitingForEnable S= STATE_HomePOSOK R= STATE_Synchronising R= STATE_HomePOSOK OR (STATE_Synchronising AND NOT ioUDT_ServoDrive.Control.SetDriveEnable);
END_NETWORK
NETWORK TITLE: "DONE Network 7: STATE: Synchronising"
  STATE_Synchronising S= STATE_WaitingForEnable R= STATE_WaitingForEnable AND ioUDT_ServoDrive.Control.SetDriveEnable;
END_NETWORK
NETWORK TITLE: "DONE Network 8: Activate set HomePos Cycle"
  split22 := OSP_SetHomnePos(CLK := ioUDT_ServoDrive.Control.StartSetHomePos AND ioUDT_ServoDrive.Status.DriveIsReady);
  Man_SetHomePos S= split22;
  ioUDT_ServoDrive.Control.StartSetHomePos R= split22;
END_NETWORK
NETWORK TITLE: "DONE Network 9: Output: Activate Synchronise drive"
  oServoControl.ActivateCamming := STATE_Synchronising AND ioUDT_ServoDrive.Control.SetInSync;
END_NETWORK
NETWORK TITLE: "DONE Network 10: Reset HomePos in Servo drive"
  oServoControl.ResetHomePos := STATE_Prehoming AND Man_SetHomePos;
END_NETWORK
NETWORK TITLE: "DONE Network 11: Set HomePos in Servo drive"
  oServoControl.SetHomePos := STATE_HomePosNOK AND Man_SetHomePos AND iEnableHomeMovement AND ioUDT_ServoDrive.Status.DriveIsReady;
END_NETWORK
NETWORK TITLE: "DONE Network 11: Set HomePos in Servo drive"
  oServoControl.ReleaseBrake := ioUDT_ServoDrive.Control.SetBrakeRelease;
END_NETWORK
NETWORK TITLE: "TODO Network 16: Enable drive from software"
  oServoControl.Enable := ioUDT_ServoDrive.Control.SetDriveEnable AND iEnablePower;
END_NETWORK
NETWORK TITLE: "DONE Network 17: Reset error"
  oServoControl.ResetError := ioUDT_ServoDrive.Control.ResetError AND iFF100ms;
END_NETWORK
NETWORK TITLE: "DONE Network 18: SelectBypassCAM"
  oServoControl.SelectBypassCAM := ioUDT_ServoDrive.Control.SelectBypassCAM;
END_NETWORK
NETWORK TITLE: "DONE Network 19: Output: X-offset"
  EXECUTE EN
ioUDT_ServoDrive.CAM.X_Offset_ToSlave := ioUDT_ServoDrive.CAM.X_Offset_FromMaster + ioUDT_ServoDrive.CAM.X_Offset_Recipe;
oServoControl.XOffset := INT_TO_WORD(ioUDT_ServoDrive.CAM.X_Offset_Base + ioUDT_ServoDrive.CAM.X_Offset_ToSlave);
  END_EXECUTE;
END_NETWORK
NETWORK TITLE: "DONE Network 20: Scaling of the Y value"
  split21 := True;
  MOVE 1000 => oServoControl.YScale EN (ioUDT_ServoDrive.CAM.CamType GE ctCurveIs0ToMax EN split21);
  ioUDT_ServoDrive.CAM.Y_Scale_Base ADD ioUDT_ServoDrive.CAM.Y_Scale_Recipe => oServoControl.YScale EN (ioUDT_ServoDrive.CAM.CamType GE ctCurveIs0To0 EN split21) OR (ioUDT_ServoDrive.CAM.CamType GE ctCurveIsSpeed EN);
END_NETWORK
NETWORK TITLE: "DONE Network 21: Y-offset"
  EXECUTE EN
oServoControl.YOffset := INT_TO_WORD(ioUDT_ServoDrive.CAM.Y_Offset_Base + ioUDT_ServoDrive.CAM.Y_Offset_Recipe);
  END_EXECUTE;
END_NETWORK
NETWORK TITLE: "TODO Network 22: Status inputs from drive"
END_NETWORK
NETWORK TITLE: "TODO Network 23: SetOuput bits to drive"
END_NETWORK
NETWORK TITLE: "DONE Network 24: Output to Program"
  split18 := True;
  ioUDT_ServoDrive.Status.DriveIsReady := split18 AND iServoStatus.ReadyForMotion;
  ioUDT_ServoDrive.Status.InSync := split18 AND iServoStatus.InSync;
  ioUDT_ServoDrive.Status.DriveTorqueError := split18 AND iServoStatus.TorqueLimit;
  ioUDT_ServoDrive.Status.DriveIsHomed := HomingDoneDelay(IN := split18 AND NOT STATE_Prehoming AND NOT STATE_HomePosNOK, PT := T#2S);
END_NETWORK
NETWORK TITLE: "DONE Network 25: ActualXPos/Ypos"
  MOVE `LREAL_TO_INT(iServoStatus.ActPos)` => ioUDT_ServoDrive.CAM.ActualYPos EN;
END_NETWORK
NETWORK TITLE: "DONE Network 26: ActualSpeed"
  MOVE `LREAL_TO_INT(iServoStatus.ActSpeed)` => ioUDT_ServoDrive.CAM.ActualYSpeed EN;
END_NETWORK
NETWORK
  MOVE ioUDT_ServoDrive.Control.TorqueLimit => oServoControl.TorqueLimit EN;
END_NETWORK
NETWORK TITLE: "DONE Network 27: Reset ResetError in UDT"
  ioUDT_ServoDrive.Control.ResetError R= True AND ioUDT_ServoDrive.Status.DriveIsReady;
END_NETWORK

END_FUNCTION_BLOCK
