FUNCTION_BLOCK ServoControl
VAR_INPUT
	iServoStatus 	: sUDT_ServoComm_Drive_Status;
	iEnableHomeMovement : BOOL;
	iEnablePower 		: BOOL;
	iFF100ms 			: BOOL;


END_VAR
VAR_OUTPUT
	oServoControl 		: sUDT_ServoComm_Drive_Control;

END_VAR
VAR

	intYScale: 	INT;

	Man_SetHomePos: BOOL;
	OSP_SetHomnePos: R_TRIG;
	HomingDoneDelay: TON;
END_VAR
VAR_IN_OUT
	ioUDT_ServoDrive			: UDT_ServoDrive;
END_VAR
VAR RETAIN PERSISTENT
	STATE_Prehoming: BOOL;
	STATE_HomePosNOK: BOOL;
	STATE_HomePOSOK: BOOL;
	STATE_WaitingForEnable: BOOL;
	STATE_Synchronising: BOOL;
END_VAR
VAR CONSTANT
	ctCurveIs0ToMax: INT := 0;
	ctCurveIs0To0: INT := 1;
	ctCurveIsSpeed: INT := 2;
END_VAR
%LANGUAGE LD
%NETWORK "Network 2 : Initialise with STATE HomePosNotOK"
VAR_TEMP w1 : ANY; END_VAR
w1 := NOT STATE_Prehoming AND NOT STATE_HomePosNOK AND NOT STATE_HomePOSOK AND NOT STATE_WaitingForEnable AND NOT STATE_Synchronising;
STATE_Prehoming R= w1;
STATE_HomePosNOK R= w1;
STATE_HomePOSOK R= w1;
STATE_WaitingForEnable R= w1;
STATE_Synchronising R= w1;
STATE_HomePosNOK S= w1;
%NETWORK "Network 3 : STATE: Prehoming "
STATE_Prehoming S= STATE_HomePOSOK R= STATE_WaitingForEnable R= STATE_Synchronising R= (STATE_WaitingForEnable OR STATE_Synchronising) AND iServoStatus.DriveCommAlive AND Man_SetHomePos AND iServoStatus.HomingPosOK;
%NETWORK "STATE: HomePos not OK"
STATE_HomePosNOK S= STATE_Prehoming R= STATE_HomePOSOK R= STATE_WaitingForEnable R= STATE_Synchronising R= (STATE_Prehoming OR STATE_HomePOSOK OR STATE_WaitingForEnable OR STATE_Synchronising) AND iServoStatus.DriveCommAlive AND NOT iServoStatus.HomingPosOK;
%NETWORK "Network 5: STATE: HomePos OK"
STATE_HomePOSOK S= STATE_HomePosNOK R= Man_SetHomePos R= STATE_HomePosNOK AND iServoStatus.DriveCommAlive AND iServoStatus.HomingPosOK;
%NETWORK "Network 6 : STATE: WaitingForEnable"
STATE_WaitingForEnable S= STATE_HomePOSOK R= STATE_Synchronising R= STATE_HomePOSOK OR STATE_Synchronising AND NOT ioUDT_ServoDrive.Control.SetDriveEnable;
%NETWORK "DONE Network 7: STATE: Synchronising"
STATE_Synchronising S= STATE_WaitingForEnable R= STATE_WaitingForEnable AND ioUDT_ServoDrive.Control.SetDriveEnable;
%NETWORK "DONE Network 8: Activate set HomePos Cycle"
VAR_TEMP w2 : ANY; END_VAR
w2 := OSP_SetHomnePos(CLK := ioUDT_ServoDrive.Control.StartSetHomePos AND ioUDT_ServoDrive.Status.DriveIsReady);
Man_SetHomePos S= w2;
ioUDT_ServoDrive.Control.StartSetHomePos R= w2;
%NETWORK "DONE Network 9: Output: Activate Synchronise drive"
oServoControl.ActivateCamming := STATE_Synchronising AND ioUDT_ServoDrive.Control.SetInSync;
%NETWORK "DONE Network 10: Reset HomePos in Servo drive"
oServoControl.ResetHomePos := STATE_Prehoming AND Man_SetHomePos;
%NETWORK "DONE Network 11: Set HomePos in Servo drive"
oServoControl.SetHomePos := STATE_HomePosNOK AND Man_SetHomePos AND iEnableHomeMovement AND ioUDT_ServoDrive.Status.DriveIsReady;
%NETWORK "DONE Network 11: Set HomePos in Servo drive"
oServoControl.ReleaseBrake := ioUDT_ServoDrive.Control.SetBrakeRelease;
%NETWORK "TODO Network 16: Enable drive from software"
oServoControl.Enable := ioUDT_ServoDrive.Control.SetDriveEnable AND iEnablePower;
%NETWORK "DONE Network 17: Reset error"
oServoControl.ResetError := ioUDT_ServoDrive.Control.ResetError AND iFF100ms;
%NETWORK "DONE Network 18: SelectBypassCAM"
oServoControl.SelectBypassCAM := ioUDT_ServoDrive.Control.SelectBypassCAM;
%NETWORK "DONE Network 19: Output: X-offset"
EXECUTE(EN := RAIL(), 'ioUDT_ServoDrive.CAM.X_Offset_ToSlave := ioUDT_ServoDrive.CAM.X_Offset_FromMaster + ioUDT_ServoDrive.CAM.X_Offset_Recipe;
oServoControl.XOffset := INT_TO_WORD(ioUDT_ServoDrive.CAM.X_Offset_Base + ioUDT_ServoDrive.CAM.X_Offset_ToSlave);');
%NETWORK "DONE Network 20: Scaling of the Y value"
VAR_TEMP w3 : ANY; END_VAR
w3 := True;
MOVE(EN := GE(EN := w3, ioUDT_ServoDrive.CAM.CamType, ctCurveIs0ToMax), 1000, OUT => oServoControl.YScale).ENO;
ADD(EN := OR(GE(EN := w3, ioUDT_ServoDrive.CAM.CamType, ctCurveIs0To0), GE(EN := RAIL(), ioUDT_ServoDrive.CAM.CamType, ctCurveIsSpeed)), ioUDT_ServoDrive.CAM.Y_Scale_Base, ioUDT_ServoDrive.CAM.Y_Scale_Recipe, OUT => oServoControl.YScale).ENO;
%NETWORK "DONE Network 21: Y-offset"
EXECUTE(EN := RAIL(), 'oServoControl.YOffset := INT_TO_WORD(ioUDT_ServoDrive.CAM.Y_Offset_Base + ioUDT_ServoDrive.CAM.Y_Offset_Recipe);');
%NETWORK "TODO Network 22: Status inputs from drive"
%NETWORK "TODO Network 23: SetOuput bits to drive"
%NETWORK "DONE Network 24: Output to Program"
VAR_TEMP w4 : ANY; END_VAR
w4 := True;
ioUDT_ServoDrive.Status.DriveIsReady := w4 AND iServoStatus.ReadyForMotion;
ioUDT_ServoDrive.Status.InSync := w4 AND iServoStatus.InSync;
ioUDT_ServoDrive.Status.DriveTorqueError := w4 AND iServoStatus.TorqueLimit;
ioUDT_ServoDrive.Status.DriveIsHomed := HomingDoneDelay(IN := w4 AND NOT STATE_Prehoming AND NOT STATE_HomePosNOK, PT := T#2S).Q;
%NETWORK "DONE Network 25: ActualXPos/Ypos"
MOVE(EN := RAIL(), LREAL_TO_INT(iServoStatus.ActPos), OUT => ioUDT_ServoDrive.CAM.ActualYPos).ENO;
%NETWORK "DONE Network 26: ActualSpeed"
MOVE(EN := RAIL(), LREAL_TO_INT(iServoStatus.ActSpeed), OUT => ioUDT_ServoDrive.CAM.ActualYSpeed).ENO;
%NETWORK
MOVE(EN := RAIL(), ioUDT_ServoDrive.Control.TorqueLimit, OUT => oServoControl.TorqueLimit).ENO;
%NETWORK "DONE Network 27: Reset ResetError in UDT"
ioUDT_ServoDrive.Control.ResetError R= True AND ioUDT_ServoDrive.Status.DriveIsReady;

END_FUNCTION_BLOCK
