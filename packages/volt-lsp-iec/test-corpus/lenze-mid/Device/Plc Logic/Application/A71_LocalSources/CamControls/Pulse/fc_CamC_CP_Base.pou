FUNCTION fc_CamC_CP_Base : BOOL
VAR_INPUT
	iEN					: BOOL;
	iStartCam			: INT; 
	iMachinePosition 	: INT; 
	iResetFlag			: BOOL;
END_VAR
VAR_OUTPUT

END_VAR
VAR
	tBool: BOOL;
	
	

END_VAR
VAR_IN_OUT
	ioAuxOneShot: BOOL;
END_VAR

%LANGUAGE LD
%NETWORK
ASSIGN(GE(EN := RAIL(), iMachinePosition, iStartCam).OUT AND INVERT(iResetFlag) AND iEN, Q => tBool);
%NETWORK
ASSIGN(tbool AND INVERT(ioAuxOneShot), Q => fc_CamC_CP_Base);
%NETWORK
ASSIGN(tbool, Q => ioAuxOneShot);

END_FUNCTION
