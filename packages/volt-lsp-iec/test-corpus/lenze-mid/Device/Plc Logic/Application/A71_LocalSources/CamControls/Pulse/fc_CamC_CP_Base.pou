FUNCTION fc_CamC_CP_Base : BOOL
VAR_INPUT
	iEN					: BOOL;
	iStartCam			: INT; 
	iMachinePosition 	: INT; 
	iResetFlag			: BOOL;
END_VAR
VAR_OUTPUT

END_VAR
VAR
	tBool: BOOL;
	
	

END_VAR
VAR_IN_OUT
	ioAuxOneShot: BOOL;
END_VAR

%LANGUAGE LD
%NETWORK
tBool := GE(EN := TRUE, iMachinePosition, iStartCam) AND NOT iResetFlag AND iEN;
%NETWORK
fc_CamC_CP_Base := tbool AND NOT ioAuxOneShot;
%NETWORK
ioAuxOneShot := tbool;

END_FUNCTION
