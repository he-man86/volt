FUNCTION_BLOCK FB_Lenze_i550
VAR_INPUT
	iStatusWord : sUDT_FQIComm_Drive_Status;
	iGearRatioNumerator : REAL;
	iGearRatioDenominator : REAL;
	iNominalMotorSpeedwoSlipComp_RPM : REAL;
	iNominalMotorFrequency_Hz : REAL;
	iAxisJogSpeed_RPM : REAL;

END_VAR
VAR_OUTPUT
	oControlWord : sUDT_FQIComm_Drive_Control;
	oRefSpeed : WORD;

END_VAR
VAR
END_VAR
VAR_IN_OUT
	ioUDT			: UDT_FQI_Drive;
END_VAR
%LANGUAGE LD
%NETWORK
MOVE(EN := RAIL(), UINT_TO_WORD(ioUDT.Control.AutoSpeed), OUT => oRefSpeed).ENO;
%NETWORK
VAR w1 : ANY; END_VAR
w1 := TRUE;
ioUDT.Status.Error := w1 AND iStatusWord.Bit3_Fault;
ioUDT.Status.DriveReady := w1 AND NOT iStatusWord.Bit3_Fault AND iStatusWord.Bit0_ReadyForOperation;
%NETWORK
VAR w2 : ANY; w3 : ANY; END_VAR
w2 := TRUE;
oControlWord.Bit4_RunForward := w2 AND ioUDT.Control.Enable AND ioUDT.Control.StartAuto;
w3 := w2 AND ioUDT.Control.ResetError;
oControlWord.Bit7_ResetFault := w3;
ioUDT.Control.ResetError R= w3;
oControlWord.Bit12_ReverseDirection := w2 AND ioUDT.Control.Reverse;

END_FUNCTION_BLOCK
