FUNCTION_BLOCK FB_Lenze_i550
VAR_INPUT
	iStatusWord : sUDT_FQIComm_Drive_Status;
	iGearRatioNumerator : REAL;
	iGearRatioDenominator : REAL;
	iNominalMotorSpeedwoSlipComp_RPM : REAL;
	iNominalMotorFrequency_Hz : REAL;
	iAxisJogSpeed_RPM : REAL;

END_VAR
VAR_OUTPUT
	oControlWord : sUDT_FQIComm_Drive_Control;
	oRefSpeed : WORD;

END_VAR
VAR
END_VAR
VAR_IN_OUT
	ioUDT			: UDT_FQI_Drive;
END_VAR
%LANGUAGE LD
%NETWORK
MOVE(EN := RAIL(), OPERAND('UINT_TO_WORD(ioUDT.Control.AutoSpeed)'), OUT => oRefSpeed);
%NETWORK
VAR w1 : ANY; END_VAR
w1 := TRUE;
ASSIGN(w1 AND iStatusWord.Bit3_Fault, Q => ioUDT.Status.Error);
ASSIGN(w1 AND INVERT(iStatusWord.Bit3_Fault) AND iStatusWord.Bit0_ReadyForOperation, Q => ioUDT.Status.DriveReady);
%NETWORK
VAR w2 : ANY; w3 : ANY; END_VAR
w2 := TRUE;
ASSIGN(w2 AND ioUDT.Control.Enable AND ioUDT.Control.StartAuto, Q => oControlWord.Bit4_RunForward);
w3 := w2 AND ioUDT.Control.ResetError;
ASSIGN(w3, Q => oControlWord.Bit7_ResetFault);
ASSIGN(w3, Q_RESET => ioUDT.Control.ResetError);
ASSIGN(w2 AND ioUDT.Control.Reverse, Q => oControlWord.Bit12_ReverseDirection);

END_FUNCTION_BLOCK
