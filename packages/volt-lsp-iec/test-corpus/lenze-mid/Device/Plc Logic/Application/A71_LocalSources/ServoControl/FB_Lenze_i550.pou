FUNCTION_BLOCK FB_Lenze_i550
VAR_INPUT
	iStatusWord : sUDT_FQIComm_Drive_Status;
	iGearRatioNumerator : REAL;
	iGearRatioDenominator : REAL;
	iNominalMotorSpeedwoSlipComp_RPM : REAL;
	iNominalMotorFrequency_Hz : REAL;
	iAxisJogSpeed_RPM : REAL;

END_VAR
VAR_OUTPUT
	oControlWord : sUDT_FQIComm_Drive_Control;
	oRefSpeed : WORD;

END_VAR
VAR
END_VAR
VAR_IN_OUT
	ioUDT			: UDT_FQI_Drive;
END_VAR
IMPLEMENTATION LD
NETWORK
  MOVE `UINT_TO_WORD(ioUDT.Control.AutoSpeed)` => oRefSpeed ENO EN;
END_NETWORK
NETWORK
  split6 := TRUE;
  ioUDT.Status.Error := split6 AND iStatusWord.Bit3_Fault;
  ioUDT.Status.DriveReady := split6 AND NOT iStatusWord.Bit3_Fault AND iStatusWord.Bit0_ReadyForOperation;
END_NETWORK
NETWORK
  split17 := TRUE;
  oControlWord.Bit4_RunForward := split17 AND ioUDT.Control.Enable AND ioUDT.Control.StartAuto;
  split18 := split17 AND ioUDT.Control.ResetError;
  oControlWord.Bit7_ResetFault := split18;
  ioUDT.Control.ResetError R= split18;
  oControlWord.Bit12_ReverseDirection := split17 AND ioUDT.Control.Reverse;
END_NETWORK

END_FUNCTION_BLOCK
