PROGRAM GeneralProgramFlags
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	AlwaysOff: BOOL;
	AlwaysOn: BOOL;
	OS: BOOL;
	first: BOOL;
	flag: BOOL;
	OSfirstflagcycle: BOOL;
	FirstCycle: BOOL;
	dummyWord: INT;
	tmr_FF500ms: TON;
	tmr_FF500ms_not: TON;
	tmr_FF100ms: TON;
	tmr_FF100ms_not: TON;
	tmr_FF50ms: TON;
	tmr_FF50ms_not: TON;
	tmr_FF1s: TON;
	tmr_FF1s_not: TON;
	PLC_StartUp_Delay: TON;
END_VAR

%LANGUAGE LD
%NETWORK
// Always Off
ASSIGN(AlwaysOff, Q_RESET => AlwaysOff);
%NETWORK
// Always ON
ASSIGN(INVERT(AlwaysOn), Q_SET => AlwaysOn);
%NETWORK
ASSIGN(AlwaysOn AND OSfirstflagcycle, Q_RESET => FirstCycle);
%NETWORK
MOVE(EN := AlwaysOn, 0, OUT => dummyWord);
%NETWORK
VAR w1 : ANY; END_VAR
w1 := RAIL();
ASSIGN(tmr_FF50ms(IN := w1 AND INVERT(tmr_FF50ms_not.Q), PT := T#100MS), Q => FF50ms);
ASSIGN(tmr_FF50ms_not(IN := w1 AND FF50ms, PT := T#100MS), Q => LST_General.Imp100ms);
%NETWORK
VAR w2 : ANY; END_VAR
w2 := RAIL();
ASSIGN(tmr_FF100ms(IN := w2 AND INVERT(tmr_FF100ms_not.Q), PT := T#500MS), Q => FF100ms);
ASSIGN(tmr_FF100ms_not(IN := w2 AND FF100ms, PT := T#500MS), Q => LST_General.Imp200ms);
%NETWORK
VAR w3 : ANY; END_VAR
w3 := RAIL();
ASSIGN(tmr_FF500ms(IN := w3 AND INVERT(tmr_FF500ms_not.Q), PT := T#500MS), Q => FF500ms);
ASSIGN(tmr_FF500ms_not(IN := w3 AND FF500ms, PT := T#500MS), Q => LST_General.Imp1s);
%NETWORK
VAR w4 : ANY; END_VAR
w4 := RAIL();
ASSIGN(tmr_FF1s(IN := w4 AND INVERT(tmr_FF1s_not.Q), PT := T#1S), Q => FF1s);
tmr_FF1s_not(IN := w4 AND FF1s, PT := T#1S);
%NETWORK
ASSIGN(PLC_StartUp_Delay(IN := AlwaysOn, PT := T#60S), Q => LST_General.StartUpDelayPLC);

END_PROGRAM
