FUNCTION_BLOCK Servo_LimitJog
VAR_INPUT
	iServoStatus 	: sUDT_ServoComm_Drive_Status;
	iServoControl 		: sUDT_ServoComm_Drive_Control;
END_VAR
VAR_OUTPUT
	oServoControl 		: sUDT_ServoComm_Drive_Control;
END_VAR
VAR
END_VAR
VAR_IN_OUT
	ioUDT_ServoDrive			: UDT_ServoDrive;
	ioUDT_JogLimitFree			: UDT_ServoJogLimitFree;
END_VAR


%LANGUAGE LD
%NETWORK "NETWORK 3 (p1): Check for limit switch"
ASSIGN(iServoStatus.Spare1, Q => ioUDT_JogLimitFree.Status.Limit_Left_OK);
%NETWORK "NETWORK 3 (p2): Check for limit switch"
ASSIGN(iServoStatus.Spare2, Q => ioUDT_JogLimitFree.Status.Limit_Right_OK);
%NETWORK "COPY previous control word to current controlword"
EXECUTE(EN := RAIL(), 'oServoControl:=iServoControl;');
%NETWORK "NETWORK 4 (p1): ControlToFreeLimitSwitches"
ASSIGN(ioUDT_JogLimitFree.Status.Limit_Left_OK AND ioUDT_JogLimitFree.Control.Jog_LimitToLeft, Q => oServoControl.Spare1);
%NETWORK "NETWORK 4 (p2): ControlToFreeLimitSwitches"
ASSIGN(ioUDT_JogLimitFree.Status.Limit_Right_OK AND ioUDT_JogLimitFree.Control.Jog_LimitToRight, Q => oServoControl.Spare2);

END_FUNCTION_BLOCK
