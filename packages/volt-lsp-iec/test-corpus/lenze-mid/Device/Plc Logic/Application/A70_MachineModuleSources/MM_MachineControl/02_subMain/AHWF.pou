PROGRAM AHWF
VAR
	tFaultWaitingForWrapper : BOOL;
	tFaultNoWrapper: BOOL;
	tFaultPhotocellWrapper: BOOL;
	tStartFastWinding: BOOL;
	tSupplyWrapper: BOOL;
	tSprayingValve: BOOL;
	ttest: BOOL;
	R_TrigStartPos: R_TRIG;
END_VAR

VAR 
	IDB_WSM: WSM;
END_VAR
%LANGUAGE LD
%NETWORK "Network 1: Detection of wrapper (set and reset)"
VAR w1 : ANY; END_VAR
w1 := True;
ASSIGN(w1 AND LST_InputsOutputs.I101_0_Wrapper_present, Q_SET => Mach1_AuxData.MemWrapperPassedUnderTheSensor);
ASSIGN(w1 AND INVERT(LST_InputsOutputs.I101_0_Wrapper_present) AND Mach1_AuxData.MemWrapperPassedUnderTheSensor, Q_SET => Mach1_AuxData.MemWrapperPresentForLeafCarrier, Q_SET => Mach1_AuxData.MemWrapperDetected_ResetLimitedSpeed);
ASSIGN(fc_CamC_CP_UDT(iEN := MOVE(EN := w1, Mach1_Data.CamControls.TakeOverCycle_C.Stop, OUT => Mach1_AuxData.CamControls.TakeOverCycleStopPulse_CP.Start), iMachinePosition := HMI_Var.Mach1.Position, iResetFlag := Mach1.GenFlags.Rotflag, ioPulse := Mach1_AuxData.CamControls.TakeOverCycleStopPulse_CP), Q_RESET => Mach1_AuxData.MemWrapperPresentForLeafCarrier, Q_RESET => Mach1_AuxData.MemWrapperPassedUnderTheSensor);
%NETWORK
ASSIGN(R_TrigStartPos(CLK := HMI_Var.HMI_AHWF_StartPos), Q_RESET => Mach1_AuxData.MemWrapperPresentForLeafCarrier, Q_RESET => Mach1_AuxData.MemWrapperPassedUnderTheSensor);
%NETWORK "Network 2: FB for DTA"
ASSIGN(IDB_WSM(EN := RAIL(), iGenflags := Mach1.GenFlags, iInit := LST_General.FirstCycle, iTest_Prod := HMI_Var.Test_Prod, iCleaning := HMI_Var.Btn_Cleaning, iBunchPresent := Mach1_AuxData.ShiftRegister.SR_bunch_present_position_1_JL, iWrapperPresentForLeafCarrier := Mach1_AuxData.MemWrapperPresentForLeafCarrier AND INVERT(HMI_Var.HMI_AHWF_fast_winding), iPhotocellWrapper := LST_InputsOutputs.I101_0_Wrapper_present AND INVERT(HMI_Var.HMI_AHWF_fast_winding), iWaterLevelSensor := LST_InputsOutputs.I101_3_Water_level_control, iTakeOverCycle := fc_CamC_CC_UDT(iEnable := True, iMachinePosition := HMI_Var.Mach1.Position, ioCamControl := Mach1_Data.CamControls.TakeOverCycle_C), iTimeOutSupplyWrapper := OPERAND('fc_dinttotime(Mach1_Data.Timers.TimeOutSupplyWrapper,2)'), iSprayTime := OPERAND('fc_dinttotime(Mach1_Data.Timers.SprayPulseWidth,2)'), iDelayContSpraying := OPERAND('fc_dinttotime(Mach1_Data.Timers.DelayContSpraying,2)'), iScreenForOperatorSettingsActivated := Mach1_AuxData.ScreenForOperatorSettingsActivated, iManualSprayCycleReset := HMI_Var.Mach1.SprayReset, iManualSprayCycleStart := HMI_Var.Mach1.SprayStart, iManualSprayCycleStop := HMI_Var.Mach1.SprayStop, iMaxNumberOfSprayPulses := Mach1_Data.Settings.Ints.MaxNumberOfSprayPulses, ioEnableSpraying := HMI_Var.Btn_Spraying, ioManualSprayCycleActualCount := Mach1_Data.Settings.Ints.ActualNumberOfSprayPulses, ioManualStartSupply := HMI_Var.HMI_AHWF_StartPos, oPositionMotor => tSupplyWrapper, oSprayingValve => tSprayingValve, oWaterLevelValve => LST_InputsOutputs.Q101_1_PNV_Waterlevel_control, oFaultWaitingForWrapper => tFaultWaitingForWrapper, oFaultNoWrapper => tFaultNoWrapper, oFaultPhotocellWrapper => tFaultPhotocellWrapper) AND Mach1.GenFlags.EnablePneumPressurised AND Mach1_Safety.Status.AllDoorsActuallyClosed AND tSprayingValve AND INVERT(Mach1_Alarms.Alm011), Q => PneumValveTerminalSMC.Pos1B);
%NETWORK "Network 3: Wrapper faults"
ASSIGN(Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1.GenFlags.DelayAfterEmergStop AND HMI_Var.Test_Prod AND INVERT(HMI_Var.Btn_Cleaning) AND tFaultWaitingForWrapper AND Mach1_AuxData.AllDrivesHomed, iReset := True, iAlm := Mach1_Alarms.Alm076, ioAction := Mach1.GenFlags.Warning) OR Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1.GenFlags.DelayAfterEmergStop AND HMI_Var.Test_Prod AND INVERT(HMI_Var.Btn_Cleaning) AND tFaultNoWrapper AND Mach1_AuxData.AllDrivesHomed, iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm043, ioAction := Mach1.GenFlags.MinorAlarm) OR Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1.GenFlags.DelayAfterEmergStop AND HMI_Var.Test_Prod AND INVERT(HMI_Var.Btn_Cleaning) AND INVERT(Mach1_Alarms.Alm045) AND tFaultPhotocellWrapper AND Mach1_AuxData.AllDrivesHomed, iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm045, ioAction := Mach1.GenFlags.MinorAlarm), Q_SET => Mach1.GenFlags.StopDriveDirect);
%NETWORK
%NETWORK "TODO Network 4: "
VAR w2 : ANY; w3 : ANY; w4 : ANY; END_VAR
w2 := True;
w3 := w2 AND True;
MOVE(EN := MOVE(EN := MOVE(EN := MOVE(EN := w3 AND TRUE, 175, OUT => Data_Exchange_Motion.FeedForwardWrapper.Control.VelUnit), 2000, OUT => Data_Exchange_Motion.FeedForwardWrapper.Control.DecUnit), 750, OUT => Data_Exchange_Motion.FeedForwardWrapper.Control.AccUnit), 100, OUT => Data_Exchange_Motion.FeedForwardWrapper.Control.TorqueLimit);
w4 := w3 AND HMI_Var.HMI_AHWF_fast_winding;
ASSIGN(Mach1_AuxData.IEC_TIMERS.TON_StartFastWinding(IN := w4, PT := T#200MS), Q => tStartFastWinding);
MOVE(EN := w4, 500, OUT => Data_Exchange_Motion.FeedForwardWrapper.Control.VelUnit);
MOVE(EN := w2, OPERAND('DINT_TO_LREAL(Mach1_Data.Settings.Dints.WrapperStopPosition)/10'), OUT => Data_Exchange_Motion.FeedForwardWrapper.Control.PosUnit);
ASSIGN(w2 AND INVERT(HMI_Var.HMI_AHWF_positioningType) AND INVERT(Mach1_Alarms.Alm056) AND mach1.Genflags.EnableAuxDrive AND (tSupplyWrapper OR tStartFastWinding OR Data_Exchange_Motion.FeedForwardWrapper.Control.StartTouchprobePos AND INVERT(Data_Exchange_Motion.FeedForwardWrapper.Status.InPosition)), Q => Data_Exchange_Motion.FeedForwardWrapper.Control.StartTouchprobePos);
ASSIGN(Mach1_AuxData.Edge.OSP_StopFlag(CLK := w2 AND (INVERT(Mach1_MIDS.FB_Mach1.iStop1) OR INVERT(Mach1_MIDS.FB_Mach1.iStop2) OR INVERT(Mach1_MIDS.FB_Mach1.iStop3) OR INVERT(Mach1_Safety.Status.AllDoorsActuallyClosed) OR LST_InputsOutputs.I101_0_Wrapper_present)), Q_RESET => HMI_Var.HMI_AHWF_fast_winding);
%NETWORK "Network 5: Side correction"
SideCorrection(EN := RAIL(), OUT => ???);
%NETWORK "Network 6: DTA-alarm: side limit reached"
ASSIGN(Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.Edge.OSP_LimitDTA_Reached(CLK := Mach1_AuxData.MIDS_Active AND Mach1.GenFlags.DelayAfterEmergStop AND (INVERT(Mach1_Data.Drives.SideCorrection_FreeLimit.Status.Limit_Left_OK) OR INVERT(Mach1_Data.Drives.SideCorrection_FreeLimit.Status.Limit_Right_OK))) AND Mach1_AuxData.AllDrivesHomed, iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm057, ioAction := Mach1.GenFlags.MinorAlarm) OR LST_General.AlwaysOff AND Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.MIDS_Active AND Mach1.GenFlags.DelayAfterEmergStop AND (INVERT(Mach1_Data.Drives.SideCorrection_FreeLimit.Status.Limit_Left_OK) OR INVERT(Mach1_Data.Drives.SideCorrection_FreeLimit.Status.Limit_Right_OK)) AND Mach1_AuxData.AllDrivesHomed, iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm074, ioAction := Mach1.GenFlags.Warning), Q_SET => Mach1.GenFlags.StopDriveDirect);
%NETWORK "Network 7: Alarm: Water receptacle full"
ASSIGN(Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.IEC_TIMERS.WaterReceptacleFull(IN := Mach1_AuxData.MIDS_Active AND LST_InputsOutputs.I101_3_Water_level_control AND INVERT(Mach1_Alarms.Alm055), PT := T#5M) AND HMI_Var.Test_Prod AND HMI_Var.Btn_Spraying AND Mach1_AuxData.AllDrivesHomed, iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm055, ioAction := Mach1.GenFlags.MinorAlarm), Q_SET => Mach1.GenFlags.StopDriveDirect);

END_PROGRAM
