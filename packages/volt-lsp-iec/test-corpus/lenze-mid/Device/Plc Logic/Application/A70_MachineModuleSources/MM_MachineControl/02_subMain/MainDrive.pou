PROGRAM MainDrive 
VAR_INPUT
END_VAR
VAR
	tInt: INT;
	tMainDriveRun: BOOL;
	tMainDriveJog: BOOL;
END_VAR

VAR_OUTPUT
	oMainDriveRun: BOOL;
	oMainDriveJog: BOOL;
END_VAR
%LANGUAGE LD
%NETWORK "DONE NETWORK 1: Delay after doors closed"
%WIRES w1
Mach1_AuxData.IEC_TIMERS.TON_DelayAfterDoorsClosed(IN := Mach1.GenFlags.DelayAfterEmergStop AND Mach1_Safety.Status.AllDoorsActuallyClosed AND Mach1_Safety.Status.DoorsOK, PT := T#150MS, Q => w1);
Mach1_AuxData.DelayAfterDoorsActuallyClosed := w1;
%NETWORK "DONE NETWORK 2: Activating main drive"
%WIRES w2, w3, w4, w5
w2 := TRUE;
MOVE_EN(EN := w2, 0, OUT => tInt);
Mach1_AuxData.MemLowerSpeedBecauseOfNoWrapper R= w2 AND NOT HMI_Var.Test_Prod;
w3 := w2 AND Mach1.GenFlags.EnableMainDrive AND Mach1.GenFlags.ConditionsReadyForOperation AND NOT Mach1.GenFlags.StopDriveDirect AND Mach1_AuxData.AllDrivesInLock;
w4 := w3 AND Mach1.GenFlags.RunAuto;
tMainDriveRun := oMainDriveRun := Mach1_Safety.Control.RequestAutoSpeed := w4;
MOVE_EN(EN := BRANCH(FEED := w4, NOT Mach1_AuxData.MemLowerSpeedBecauseOfNoWrapper, LE_ENONLY(EN := Mach1_AuxData.MemLowerSpeedBecauseOfNoWrapper, Mach1_Data.AUTOSPEED, 40)) AND NOT HMI_Var.Btn_Cleaning, Mach1_Data.AUTOSPEED, OUT => tInt);
MOVE_EN(EN := GT_ENONLY(EN := w4 AND Mach1_AuxData.MemLowerSpeedBecauseOfNoWrapper, Mach1_Data.AUTOSPEED, 40) AND NOT HMI_Var.Btn_Cleaning, 30, OUT => tInt);
MOVE_EN(EN := w4 AND HMI_Var.Btn_Cleaning, 6, OUT => tInt);
w5 := w3 AND Mach1.GenFlags.RunMan;
tMainDriveJog := oMainDriveJog := Mach1_Safety.Control.RequestManSpeed := w5;
MOVE_EN(EN := w5, Mach1_Data.MANUALSPEED, OUT => tInt);
RPM_To_DriveSpeed(iEN := w2, iRPM := tInt, oDriveSpeed => Mach1_Data.Drives.MainDrive_VM.Control.DriveMasterSpeed);
%NETWORK "DONE NETWORK 3 : DriveIsRunning flag"
%WIRES w6, w7, w8
w6 := TRUE;
Mach1.GenFlags.StopDriveDirect R= w6;
Mach1.GenFlags.DriveIsRunning := w6 AND (tMainDriveRun OR tMainDriveJog);
Mach1_AuxData.IEC_TIMERS.TON_MainDriveAtProductionSpeed(IN := w6 AND tMainDriveRun, PT := T#200MS, Q => w8);
Mach1_AuxData.IEC_TIMERS.TOFF_MainDriveAtProductionSpeed(IN := w8, PT := T#60MS, Q => w7);
Mach1.GenFlags.DriveAtSpeed := w7;
%NETWORK "DONE NETWORK 4: Alarm: Main drive blocked"
%WIRES w9
Mach1_AuxData.IEC_TIMERS.TON_MainDriveBlocked(IN := oMainDriveRun, PT := T#12S, Q => w9);
Mach1.GenFlags.StopDriveDirect S= Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := LT_ENONLY(EN := w9, HMI_Var.Mach1.ActualSpeed, 5), iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm040, ioAction := Mach1.GenFlags.MinorAlarm) AND Mach1_Alarms.Alm040;
%NETWORK "DONE NETWORK 5: Manual brakerelease"
%DISABLED
%WIRES w10
w10 := TRUE;
LST_InputsOutputs.Q101_0_REL_release_brake := w10 AND Mach1_Alarms.Alm001 AND HMI_Var.ReleaseBrake;
HMI_Var.ReleaseBrake R= w10 AND (NOT Mach1_Alarms.Alm001 OR Mach1_Alarms.Alm001 AND NOT Mach1.GenFlags.StartFlag);

END_PROGRAM
