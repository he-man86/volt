FUNCTION_BLOCK WSM
VAR_INPUT
	EN: BOOL;
	iGenflags : UDT_GeneralFlags;	
	iInit: BOOL;
	iTest_Prod: BOOL;
	iCleaning: BOOL;
	iBunchPresent: BOOL;
	iWrapperPresentForLeafCarrier: BOOL;
	iPhotocellWrapper: BOOL;
	iWaterLevelSensor: BOOL;	
	iTakeOverCycle: BOOL;
	iTimeOutSupplyWrapper: TIME;
	iSprayTime: TIME;
	iDelayContSpraying: TIME;
	iScreenForOperatorSettingsActivated: BOOL;
	iManualSprayCycleReset: BOOL;
	iManualSprayCycleStart: BOOL;
	iManualSprayCycleStop: BOOL;
	iMaxNumberOfSprayPulses: INT;

END_VAR
VAR_OUTPUT
	ENO: BOOL;
	oVentilationMotor: BOOL;	
	oPositionMotor: BOOL;
	oWindingMotor: BOOL;	
	oSprayingValve: BOOL;	
	oWaterLevelValve: BOOL;	
	oFaultWaitingForWrapper: BOOL;
	oFaultNoWrapper: BOOL;
	oFaultPhotocellWrapper : BOOL;
END_VAR
VAR
	stOSN_TakeOverCycle: F_TRIG;
	TMR_TimeOutSupply: TON;
	TMR_TimeOutPhotocell: TON;
	stRePositionMotor: R_TRIG;
	stSprayCycleActive: BOOL;
	TMR_DelayContinuousSpraying: TON;
	TMR_SprayTime: TON;
	stManualSprayCycleStarted: BOOL;
	
	TMR_ManualSprayCycleIdle: TON;

END_VAR

VAR_IN_OUT
	ioEnableSpraying: BOOL;
	ioManualSprayCycleActualCount: INT;
	ioManualStartSupply: BOOL;
END_VAR
VAR RETAIN PERSISTENT
	stRestposition: BOOL;
	stSupplyWrapper: BOOL;
	stWrapperPresent: BOOL;
	stNoWrapper: BOOL;
	stPhotocellWrapperFault: BOOL;
	stFeedForward: BOOL;
END_VAR
%LANGUAGE LD
%NETWORK "DONE Network 2: State: Initialise"
VAR w1 : ANY; END_VAR
w1 := iInit OR INVERT(iTest_Prod) OR iCleaning OR ioManualStartSupply;
ASSIGN(w1, Q_SET => stRestposition);
ASSIGN(w1, Q_RESET => stSupplyWrapper, Q_RESET => stWrapperPresent, Q_RESET => stNoWrapper, Q_RESET => stPhotocellWrapperFault);
%NETWORK "DONE Network 3: State: Restposition"
ASSIGN(stOSN_TakeOverCycle(CLK := iTakeOverCycle) AND stWrapperPresent, Q_SET => stRestposition, Q_RESET => stWrapperPresent);
%NETWORK "DONE Network 4: State: Supply wrapper"
ASSIGN(stRestposition AND (iTest_Prod AND INVERT(iCleaning) AND iBunchPresent AND INVERT(iTakeOverCycle) AND (iGenFlags.RunMan OR iGenFlags.RunAuto) OR ioManualStartSupply) OR stNoWrapper AND iGenFlags.StartFlag OR stPhotocellWrapperFault AND iGenFlags.StartFlag, Q_SET => stSupplyWrapper, Q_RESET => stRestposition, Q_RESET => stNoWrapper, Q_RESET => stPhotocellWrapperFault, Q_RESET => ioManualStartSupply);
%NETWORK "DONE Network 5: State: Wrapper Present"
VAR w2 : ANY; END_VAR
w2 := iWrapperPresentForLeafCarrier AND stSupplyWrapper;
ASSIGN(w2, Q_SET => stWrapperPresent);
ADD(EN := w2, 1, HMI_Var.Mach1.PRDWrapCurrentCntr, OUT => HMI_Var.Mach1.PRDWrapCurrentCntr);
ADD(EN := w2, 1, HMI_Var.Mach1.PRDWrapDayCounter, OUT => HMI_Var.Mach1.PRDWrapDayCounter);
ASSIGN(w2, Q_RESET => stSupplyWrapper);
%NETWORK "DONE Network 6: State: No Wrapper"
ASSIGN(TMR_TimeOutSupply(IN := stSupplyWrapper AND stFeedForward, PT := iTimeOutSupplyWrapper), Q_SET => stNoWrapper, Q_RESET => stSupplyWrapper);
%NETWORK "DONE Network 7: State: Photocell wrapper fault"
ASSIGN(TMR_TimeOutPhotocell(IN := stSupplyWrapper AND stFeedForward AND iPhotocellWrapper, PT := T#10S), Q_SET => stPhotocellWrapperFault, Q_RESET => stSupplyWrapper);
%NETWORK "DONE Network 8: Faults"
VAR w3 : ANY; END_VAR
w3 := True;
ASSIGN(w3 AND stSupplyWrapper AND iTakeOverCycle, Q => oFaultWaitingForWrapper);
ASSIGN(w3 AND stNoWrapper, Q => oFaultNoWrapper);
ASSIGN(w3 AND stPhotocellWrapperFault, Q => oFaultPhotocellWrapper);
%NETWORK "DONE Network 9: Ventilation motor"
ASSIGN(iGenFlags.EnableAuxDrive AND iTest_Prod AND INVERT(iCleaning), Q => oVentilationMotor);
%NETWORK "DONE Network 10:"
VAR w4 : ANY; END_VAR
w4 := iGenFlags.EnableAuxDrive AND stSupplyWrapper AND INVERT(iGenFlags.StopFlag);
ASSIGN(w4, Q => stFeedForward);
ASSIGN(w4, Q => oPositionMotor);
%NETWORK "DONE Network 11: Winding motor"
ASSIGN(iGenFlags.EnableAuxDrive AND INVERT(iGenFlags.StopFlag) AND iTest_Prod AND INVERT(iCleaning), Q => oWindingMotor);
%NETWORK "DONE Network 12: Start spray cycle"
VAR w5 : ANY; END_VAR
w5 := stFeedForward;
ASSIGN(stRePositionMotor(CLK := w5), Q_SET => stSprayCycleActive);
ASSIGN(TMR_DelayContinuousSpraying(IN := w5, PT := iDelayContSpraying), Q_SET => stSprayCycleActive);
%NETWORK "DONE Network 13: Timing spray cycle"
ASSIGN(TMR_SprayTime(IN := stSprayCycleActive, PT := iSprayTime) AND INVERT(TMR_DelayContinuousSpraying.Q), Q_RESET => stSprayCycleActive);
%NETWORK "DONE Network 14: Spraying valve"
ASSIGN(ioEnableSpraying AND stSprayCycleActive, Q => oSprayingValve);
%NETWORK "DONE Network 15: Automatic trigger of water"
ASSIGN(FALSE AND iGenFlags.EnablePneumEStop AND iWrapperPresentForLeafCarrier AND iTest_Prod AND INVERT(iCleaning), Q_SET => ioEnableSpraying);
%NETWORK "DONE Network 16: Water level control"
ASSIGN(ioEnableSpraying AND iWaterLevelSensor, Q => oWaterLevelValve);
%NETWORK "DONE Network 17: Manual spray cycle"
VAR w6 : ANY; END_VAR
w6 := iScreenForOperatorSettingsActivated;
MOVE(EN := w6 AND iManualSprayCycleReset, 0, OUT => ioManualSprayCycleActualCount);
ASSIGN(LT(EN := w6 AND iGenFlags.EnablePneumEStop AND (iManualSprayCycleStart OR stManualSprayCycleStarted) AND INVERT(iManualSprayCycleStop) AND INVERT(iManualSprayCycleReset), ioManualSprayCycleActualCount, iMaxNumberOfSprayPulses).OUT, Q => stManualSprayCycleStarted);
ASSIGN(ADD(EN := TMR_ManualSprayCycleIdle(IN := w6 AND stManualSprayCycleStarted AND INVERT(stSprayCycleActive), PT := T#300MS), ioManualSprayCycleActualCount, 1, OUT => ioManualSprayCycleActualCount), Q_SET => stSprayCycleActive);
%NETWORK "DONE Network 18: SAVE RLO"
ASSIGN(EN, Q => ENO);

END_FUNCTION_BLOCK
