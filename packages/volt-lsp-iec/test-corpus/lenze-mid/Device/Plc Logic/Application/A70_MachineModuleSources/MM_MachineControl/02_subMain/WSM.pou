FUNCTION_BLOCK WSM
VAR_INPUT
	EN: BOOL;
	iGenflags : UDT_GeneralFlags;	
	iInit: BOOL;
	iTest_Prod: BOOL;
	iCleaning: BOOL;
	iBunchPresent: BOOL;
	iWrapperPresentForLeafCarrier: BOOL;
	iPhotocellWrapper: BOOL;
	iWaterLevelSensor: BOOL;	
	iTakeOverCycle: BOOL;
	iTimeOutSupplyWrapper: TIME;
	iSprayTime: TIME;
	iDelayContSpraying: TIME;
	iScreenForOperatorSettingsActivated: BOOL;
	iManualSprayCycleReset: BOOL;
	iManualSprayCycleStart: BOOL;
	iManualSprayCycleStop: BOOL;
	iMaxNumberOfSprayPulses: INT;

END_VAR
VAR_OUTPUT
	ENO: BOOL;
	oVentilationMotor: BOOL;	
	oPositionMotor: BOOL;
	oWindingMotor: BOOL;	
	oSprayingValve: BOOL;	
	oWaterLevelValve: BOOL;	
	oFaultWaitingForWrapper: BOOL;
	oFaultNoWrapper: BOOL;
	oFaultPhotocellWrapper : BOOL;
END_VAR
VAR
	stOSN_TakeOverCycle: F_TRIG;
	TMR_TimeOutSupply: TON;
	TMR_TimeOutPhotocell: TON;
	stRePositionMotor: R_TRIG;
	stSprayCycleActive: BOOL;
	TMR_DelayContinuousSpraying: TON;
	TMR_SprayTime: TON;
	stManualSprayCycleStarted: BOOL;
	
	TMR_ManualSprayCycleIdle: TON;

END_VAR

VAR_IN_OUT
	ioEnableSpraying: BOOL;
	ioManualSprayCycleActualCount: INT;
	ioManualStartSupply: BOOL;
END_VAR
VAR RETAIN PERSISTENT
	stRestposition: BOOL;
	stSupplyWrapper: BOOL;
	stWrapperPresent: BOOL;
	stNoWrapper: BOOL;
	stPhotocellWrapperFault: BOOL;
	stFeedForward: BOOL;
END_VAR
%LANGUAGE LD
%NETWORK "DONE Network 2: State: Initialise"
%WIRES w1
w1 := iInit OR NOT iTest_Prod OR iCleaning OR ioManualStartSupply;
stRestposition S= w1;
stSupplyWrapper R= stWrapperPresent R= stNoWrapper R= stPhotocellWrapperFault R= w1;
%NETWORK "DONE Network 3: State: Restposition"
stRestposition S= stWrapperPresent R= stOSN_TakeOverCycle(CLK := iTakeOverCycle) AND stWrapperPresent;
%NETWORK "DONE Network 4: State: Supply wrapper"
stSupplyWrapper S= stRestposition R= stNoWrapper R= stPhotocellWrapperFault R= ioManualStartSupply R= stRestposition AND (iTest_Prod AND NOT iCleaning AND iBunchPresent AND NOT iTakeOverCycle AND (iGenFlags.RunMan OR iGenFlags.RunAuto) OR ioManualStartSupply) OR stNoWrapper AND iGenFlags.StartFlag OR stPhotocellWrapperFault AND iGenFlags.StartFlag;
%NETWORK "DONE Network 5: State: Wrapper Present"
%WIRES w2
w2 := iWrapperPresentForLeafCarrier AND stSupplyWrapper;
stWrapperPresent S= w2;
ADD(EN := w2, 1, HMI_Var.Mach1.PRDWrapCurrentCntr, OUT => HMI_Var.Mach1.PRDWrapCurrentCntr).ENO;
ADD(EN := w2, 1, HMI_Var.Mach1.PRDWrapDayCounter, OUT => HMI_Var.Mach1.PRDWrapDayCounter).ENO;
stSupplyWrapper R= w2;
%NETWORK "DONE Network 6: State: No Wrapper"
stNoWrapper S= stSupplyWrapper R= TMR_TimeOutSupply(IN := stSupplyWrapper AND stFeedForward, PT := iTimeOutSupplyWrapper).Q;
%NETWORK "DONE Network 7: State: Photocell wrapper fault"
stPhotocellWrapperFault S= stSupplyWrapper R= TMR_TimeOutPhotocell(IN := stSupplyWrapper AND stFeedForward AND iPhotocellWrapper, PT := T#10S).Q;
%NETWORK "DONE Network 8: Faults"
%WIRES w3
w3 := True;
oFaultWaitingForWrapper := w3 AND stSupplyWrapper AND iTakeOverCycle;
oFaultNoWrapper := w3 AND stNoWrapper;
oFaultPhotocellWrapper := w3 AND stPhotocellWrapperFault;
%NETWORK "DONE Network 9: Ventilation motor"
oVentilationMotor := iGenFlags.EnableAuxDrive AND iTest_Prod AND NOT iCleaning;
%NETWORK "DONE Network 10:"
%WIRES w4
w4 := iGenFlags.EnableAuxDrive AND stSupplyWrapper AND NOT iGenFlags.StopFlag;
stFeedForward := w4;
oPositionMotor := w4;
%NETWORK "DONE Network 11: Winding motor"
oWindingMotor := iGenFlags.EnableAuxDrive AND NOT iGenFlags.StopFlag AND iTest_Prod AND NOT iCleaning;
%NETWORK "DONE Network 12: Start spray cycle"
%WIRES w5
w5 := stFeedForward;
stSprayCycleActive S= stRePositionMotor(CLK := w5);
stSprayCycleActive S= TMR_DelayContinuousSpraying(IN := w5, PT := iDelayContSpraying).Q;
%NETWORK "DONE Network 13: Timing spray cycle"
stSprayCycleActive R= TMR_SprayTime(IN := stSprayCycleActive, PT := iSprayTime).Q AND NOT TMR_DelayContinuousSpraying.Q;
%NETWORK "DONE Network 14: Spraying valve"
oSprayingValve := ioEnableSpraying AND stSprayCycleActive;
%NETWORK "DONE Network 15: Automatic trigger of water"
ioEnableSpraying S= FALSE AND iGenFlags.EnablePneumEStop AND iWrapperPresentForLeafCarrier AND iTest_Prod AND NOT iCleaning;
%NETWORK "DONE Network 16: Water level control"
oWaterLevelValve := ioEnableSpraying AND iWaterLevelSensor;
%NETWORK "DONE Network 17: Manual spray cycle"
%WIRES w6
w6 := iScreenForOperatorSettingsActivated;
MOVE(EN := w6 AND iManualSprayCycleReset, 0, OUT => ioManualSprayCycleActualCount).ENO;
stManualSprayCycleStarted := LT(EN := w6 AND iGenFlags.EnablePneumEStop AND (iManualSprayCycleStart OR stManualSprayCycleStarted) AND NOT iManualSprayCycleStop AND NOT iManualSprayCycleReset, ioManualSprayCycleActualCount, iMaxNumberOfSprayPulses);
stSprayCycleActive S= ADD(EN := TMR_ManualSprayCycleIdle(IN := w6 AND stManualSprayCycleStarted AND NOT stSprayCycleActive, PT := T#300MS).Q, ioManualSprayCycleActualCount, 1, OUT => ioManualSprayCycleActualCount).ENO;
%NETWORK "DONE Network 18: SAVE RLO"
ENO := EN;

END_FUNCTION_BLOCK
