PROGRAM General
VAR
	WordConvertor: SafetyPLC_WordsToUDT;
	WordConvertor_v2: SafetyPLC_WordsToUDT_v2;
	test_IW132: Bools_To_Byte;
	Qtest: BYTE;
	ib26: INT;
	tbool: BOOL;
	TON_0: TON;
	TON_1: TON;
	BLINK_0: BLINK;
	restart1: BOOL;
END_VAR

%LANGUAGE LD
%NETWORK
GeneralProgramFlags_EN(EN := TRUE);
%NETWORK
fc_Information_EN(EN := TRUE);
%NETWORK
WordConvertor_v2(ioSafetyStatusUDT := Mach1_Safety.Status, ioSafetyControlUDT := Mach1_Safety.Control);
%NETWORK
%WIRES w1
w1 := NOT HMI_Var.ForceOutputs;
Mach1_MIDS_EN(EN := w1);
fc_Visualisation_HMI_EN(EN := w1);
SMC_BitsToBytes_EN(EN := w1);
%NETWORK
Status_ForceOutputs_EN(EN := TRUE);
%NETWORK
LST_General.FirstCycle R= TRUE;
%NETWORK
%WIRES w2
BLINK_0(ENABLE := TRUE, TIMELOW := T#1S, TIMEHIGH := T#1S, OUT => w2);
Bugs.checkconnection := w2;
%NETWORK
TON_0(IN := NOT Bugs.reportConnectionAlive, PT := T#2S);
%NETWORK
TON_1(IN := Bugs.reportConnectionAlive, PT := T#2S);
%NETWORK
Bugs.restart := TON_0.Q OR TON_1.Q;

END_PROGRAM
