PROGRAM General
VAR
	WordConvertor: SafetyPLC_WordsToUDT;
	WordConvertor_v2: SafetyPLC_WordsToUDT_v2;
	test_IW132: Bools_To_Byte;
	Qtest: BYTE;
	ib26: INT;
	tbool: BOOL;
	TON_0: TON;
	TON_1: TON;
	BLINK_0: BLINK;
	restart1: BOOL;
END_VAR

%LANGUAGE LD
%NETWORK
GeneralProgramFlags(EN := TRUE).ENO;
%NETWORK
fc_Information(EN := TRUE).ENO;
%NETWORK
WordConvertor_v2(ioSafetyStatusUDT := Mach1_Safety.Status, ioSafetyControlUDT := Mach1_Safety.Control);
%NETWORK
%WIRES w1
w1 := NOT HMI_Var.ForceOutputs;
Mach1_MIDS(EN := w1).ENO;
fc_Visualisation_HMI(EN := w1).ENO;
SMC_BitsToBytes(EN := w1).ENO;
%NETWORK
Status_ForceOutputs(EN := TRUE).ENO;
%NETWORK
LST_General.FirstCycle R= TRUE;
%NETWORK
Bugs.checkconnection := BLINK_0(ENABLE := TRUE, TIMELOW := T#1S, TIMEHIGH := T#1S);
%NETWORK
TON_0(IN := NOT Bugs.reportConnectionAlive, PT := T#2S);
%NETWORK
TON_1(IN := Bugs.reportConnectionAlive, PT := T#2S);
%NETWORK
Bugs.restart := TON_0.Q OR TON_1.Q;

END_PROGRAM
