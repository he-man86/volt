PROGRAM General
VAR
	WordConvertor: SafetyPLC_WordsToUDT;
	WordConvertor_v2: SafetyPLC_WordsToUDT_v2;
	test_IW132: Bools_To_Byte;
	Qtest: BYTE;
	ib26: INT;
	tbool: BOOL;
	TON_0: TON;
	TON_1: TON;
	BLINK_0: BLINK;
	restart1: BOOL;
END_VAR

%LANGUAGE LD
%NETWORK
GeneralProgramFlags(EN := TRUE);
%NETWORK
fc_Information(EN := TRUE);
%NETWORK
WordConvertor_v2(ioSafetyStatusUDT := Mach1_Safety.Status, ioSafetyControlUDT := Mach1_Safety.Control);
%NETWORK
VAR w1 : ANY; END_VAR
w1 := INVERT(HMI_Var.ForceOutputs);
Mach1_MIDS(EN := w1);
fc_Visualisation_HMI(EN := w1);
SMC_BitsToBytes(EN := w1);
%NETWORK
Status_ForceOutputs(EN := TRUE);
%NETWORK
ASSIGN(RAIL(), Q_RESET => LST_General.FirstCycle);
%NETWORK
ASSIGN(BLINK_0(ENABLE := TRUE, TIMELOW := T#1S, TIMEHIGH := T#1S), Q => Bugs.checkconnection);
%NETWORK
TON_0(IN := INVERT(Bugs.reportConnectionAlive), PT := T#2S);
%NETWORK
TON_1(IN := Bugs.reportConnectionAlive, PT := T#2S);
%NETWORK
ASSIGN(TON_0.Q OR TON_1.Q, Q => Bugs.restart);

END_PROGRAM
