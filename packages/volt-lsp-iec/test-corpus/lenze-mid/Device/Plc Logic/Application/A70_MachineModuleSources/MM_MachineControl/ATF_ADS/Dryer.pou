FUNCTION_BLOCK Dryer
VAR_INPUT
	iGenFlags : UDT_GeneralFlags;
iMachineStarted : Bool;
iSwitchDryer : Bool;
iDryerClosed : Bool;
iStartFeedForward : Bool;
iStopFeedForward : Bool;
iPermissionDownstream : Bool;
iSetPowerHeater1 : Int;
iSetPowerHeater2 : Int;
iSetPowerHeater3 : Int;
iPowerOrAnalog : Bool;
iSpeedForEmptying : INT;


END_VAR
VAR_OUTPUT
	ENO: BOOL;
	oFeedForward : BOOL;
oEnableHeaters : Bool;
oPowerHeater1 : Word;
oPowerHeater2 : Word;
oPowerHeater3 : Word;
oFaultDryerOpened : Bool;


END_VAR
VAR
	tEmptyingCycleInterval : DINT;
	
	stAuxFeedForward: rs;
	tConditionHeaterTimeOut: BOOL;
	tEnableHeaters: BOOL;
	stActPowerHeater1: INT;
	stActPowerHeater2: INT;
	stActPowerHeater3: INT;
	TMR_DryerOpened: TON;
END_VAR

VAR RETAIN PERSISTENT
	stReFeedForward: R_TRIG;
	TMR_IntervalTimerEmptying: TON;
	stFaultDryerOpened: sr;
	stReStopFeedForward: R_TRIG;
	TMR_HeaterTimeOut: TON;
END_VAR
%LANGUAGE LD
%NETWORK "DONE Network 1: Convert speed to cycle time"
// tEmtyingCycle : (1/(MachineSpeed/60))*1000 gives time in [ms]
EXECUTE(EN := RAIL(), 'tEmptyingCycleInterval:=(60*1000)/TO_DINT(iSpeedForEmptying);
').ENO;
%NETWORK "DONE Network 2: Feed forward dryer"
oFeedForward := stAuxFeedForward(SET := iStartFeedForward OR TMR_IntervalTimerEmptying(IN := (tConditionHeaterTimeOut := NOT(stReFeedForward(CLK := stAuxFeedForward.Q1))), PT := OPERAND('DINT_TO_TIME(tEmptyingCycleInterval)')).Q AND iMachineStarted AND NOT stFaultDryerOpened.Q1 AND Mach1.GenFlags.DelayAfterSTO AND NOT iGenFlags.DriveIsRunning AND iPermissionDownstream, RESET1 := stReStopFeedForward(CLK := iStopFeedForward));
%NETWORK "DONE Network 3: Enable heaters"
VAR w1 : ANY; w2 : ANY; END_VAR
w1 := TRUE;
TMR_HeaterTimeOut(IN := w1 AND NOT LST_InputsOutputs.I133_1_PROX_zero_position_transport_ADS, PT := T#7S);
w2 := w1 AND iGenFlags.EnableAuxDrive AND iPermissionDownstream AND NOT TMR_HeaterTimeOut.Q AND iSwitchDryer;
oEnableHeaters := w2;
tEnableHeaters := w2;
%NETWORK "DONE Network 4: Output power heater 1"
VAR w3 : ANY; w4 : ANY; END_VAR
w3 := True;
MOVE(EN := w3 AND NOT tEnableHeaters, 0, OUT => stActPowerHeater1).ENO;
w4 := w3 AND tEnableHeaters;
ADD(EN := w4 AND LST_General.Imp100ms, stActPowerHeater1, 10, OUT => stActPowerHeater1).ENO;
MOVE(EN := GT(EN := w4, stActPowerHeater1, iSetPowerHeater1), iSetPowerHeater1, OUT => stActPowerHeater1).ENO;
EXECUTE(EN := w3 AND NOT iPowerOrAnalog, 'oPowerHeater1:=INT_TO_WORD(stActPowerHeater1*27648/1000);

').ENO;
MOVE(EN := w3 AND iPowerOrAnalog, OPERAND('INT_TO_WORD(stActPowerHeater1)'), OUT => oPowerHeater1).ENO;
%NETWORK "DONE Network 5: Output power heater 2"
VAR w5 : ANY; w6 : ANY; END_VAR
w5 := True;
MOVE(EN := w5 AND NOT tEnableHeaters, 0, OUT => stActPowerHeater2).ENO;
w6 := w5 AND tEnableHeaters;
ADD(EN := w6 AND LST_General.Imp100ms, stActPowerHeater2, 10, OUT => stActPowerHeater2).ENO;
MOVE(EN := GT(EN := w6, stActPowerHeater2, iSetPowerHeater2), iSetPowerHeater2, OUT => stActPowerHeater2).ENO;
EXECUTE(EN := w5 AND NOT iPowerOrAnalog, 'oPowerHeater2:=INT_TO_WORD(stActPowerHeater2*27648/1000);

').ENO;
MOVE(EN := w5 AND iPowerOrAnalog, OPERAND('INT_TO_WORD(stActPowerHeater2)'), OUT => oPowerHeater2).ENO;
%NETWORK "DONE Network 6: Output power heater 3"
VAR w7 : ANY; w8 : ANY; END_VAR
w7 := True;
MOVE(EN := w7 AND NOT tEnableHeaters, 0, OUT => stActPowerHeater3).ENO;
w8 := w7 AND tEnableHeaters;
ADD(EN := w8 AND LST_General.Imp100ms, stActPowerHeater3, 10, OUT => stActPowerHeater3).ENO;
MOVE(EN := GT(EN := w8, stActPowerHeater3, iSetPowerHeater3), iSetPowerHeater3, OUT => stActPowerHeater3).ENO;
EXECUTE(EN := w7 AND NOT iPowerOrAnalog, 'oPowerHeater3:=INT_TO_WORD(stActPowerHeater3*27648/1000);

').ENO;
MOVE(EN := w7 AND iPowerOrAnalog, OPERAND('INT_TO_WORD(stActPowerHeater3)'), OUT => oPowerHeater3).ENO;
%NETWORK "DONE Network 37: Fault: dryer opened"
oFaultDryerOpened := stFaultDryerOpened(SET1 := TMR_DryerOpened(IN := iMachineStarted AND iSwitchDryer AND NOT iDryerClosed AND NOT stFaultDryerOpened.Q1, PT := T#5S).Q, RESET := iGenFlags.StartFlag);
%NETWORK
ENO := RAIL();

END_FUNCTION_BLOCK
