FUNCTION_BLOCK Dryer
VAR_INPUT
	iGenFlags : UDT_GeneralFlags;
iMachineStarted : Bool;
iSwitchDryer : Bool;
iDryerClosed : Bool;
iStartFeedForward : Bool;
iStopFeedForward : Bool;
iPermissionDownstream : Bool;
iSetPowerHeater1 : Int;
iSetPowerHeater2 : Int;
iSetPowerHeater3 : Int;
iPowerOrAnalog : Bool;
iSpeedForEmptying : INT;


END_VAR
VAR_OUTPUT
	ENO: BOOL;
	oFeedForward : BOOL;
oEnableHeaters : Bool;
oPowerHeater1 : Word;
oPowerHeater2 : Word;
oPowerHeater3 : Word;
oFaultDryerOpened : Bool;


END_VAR
VAR
	tEmptyingCycleInterval : DINT;
	
	stAuxFeedForward: rs;
	tConditionHeaterTimeOut: BOOL;
	tEnableHeaters: BOOL;
	stActPowerHeater1: INT;
	stActPowerHeater2: INT;
	stActPowerHeater3: INT;
	TMR_DryerOpened: TON;
END_VAR

VAR RETAIN PERSISTENT
	stReFeedForward: R_TRIG;
	TMR_IntervalTimerEmptying: TON;
	stFaultDryerOpened: sr;
	stReStopFeedForward: R_TRIG;
	TMR_HeaterTimeOut: TON;
END_VAR
%LANGUAGE LD
%NETWORK "DONE Network 1: Convert speed to cycle time"
// tEmtyingCycle : (1/(MachineSpeed/60))*1000 gives time in [ms]
%EXECUTE(EN := TRUE)
tEmptyingCycleInterval:=(60*1000)/TO_DINT(iSpeedForEmptying);

%END_EXECUTE
%NETWORK "DONE Network 2: Feed forward dryer"
%WIRES w1, w2, w3, w4
stReFeedForward(CLK := stAuxFeedForward.Q1, Q => w3);
TMR_IntervalTimerEmptying(IN := (tConditionHeaterTimeOut := NOT(w3)), PT := DINT_TO_TIME(tEmptyingCycleInterval), Q => w2);
stReStopFeedForward(CLK := iStopFeedForward, Q => w4);
stAuxFeedForward(SET := iStartFeedForward OR w2 AND iMachineStarted AND NOT stFaultDryerOpened.Q1 AND Mach1.GenFlags.DelayAfterSTO AND NOT iGenFlags.DriveIsRunning AND iPermissionDownstream, RESET1 := w4, Q1 => w1);
oFeedForward := w1;
%NETWORK "DONE Network 3: Enable heaters"
%WIRES w5, w6
w5 := TRUE;
TMR_HeaterTimeOut(IN := w5 AND NOT LST_InputsOutputs.I133_1_PROX_zero_position_transport_ADS, PT := T#7S);
w6 := w5 AND iGenFlags.EnableAuxDrive AND iPermissionDownstream AND NOT TMR_HeaterTimeOut.Q AND iSwitchDryer;
oEnableHeaters := w6;
tEnableHeaters := w6;
%NETWORK "DONE Network 4: Output power heater 1"
%WIRES w7, w8
w7 := True;
MOVE_EN(EN := w7 AND NOT tEnableHeaters, 0, OUT => stActPowerHeater1);
w8 := w7 AND tEnableHeaters;
ADD_EN(EN := w8 AND LST_General.Imp100ms, stActPowerHeater1, 10, OUT => stActPowerHeater1);
MOVE_EN(EN := GT_ENONLY(EN := w8, stActPowerHeater1, iSetPowerHeater1), iSetPowerHeater1, OUT => stActPowerHeater1);
%EXECUTE(EN := w7 AND NOT iPowerOrAnalog)
oPowerHeater1:=INT_TO_WORD(stActPowerHeater1*27648/1000);


%END_EXECUTE
MOVE_EN(EN := w7 AND iPowerOrAnalog, INT_TO_WORD(stActPowerHeater1), OUT => oPowerHeater1);
%NETWORK "DONE Network 5: Output power heater 2"
%WIRES w9, w10
w9 := True;
MOVE_EN(EN := w9 AND NOT tEnableHeaters, 0, OUT => stActPowerHeater2);
w10 := w9 AND tEnableHeaters;
ADD_EN(EN := w10 AND LST_General.Imp100ms, stActPowerHeater2, 10, OUT => stActPowerHeater2);
MOVE_EN(EN := GT_ENONLY(EN := w10, stActPowerHeater2, iSetPowerHeater2), iSetPowerHeater2, OUT => stActPowerHeater2);
%EXECUTE(EN := w9 AND NOT iPowerOrAnalog)
oPowerHeater2:=INT_TO_WORD(stActPowerHeater2*27648/1000);


%END_EXECUTE
MOVE_EN(EN := w9 AND iPowerOrAnalog, INT_TO_WORD(stActPowerHeater2), OUT => oPowerHeater2);
%NETWORK "DONE Network 6: Output power heater 3"
%WIRES w11, w12
w11 := True;
MOVE_EN(EN := w11 AND NOT tEnableHeaters, 0, OUT => stActPowerHeater3);
w12 := w11 AND tEnableHeaters;
ADD_EN(EN := w12 AND LST_General.Imp100ms, stActPowerHeater3, 10, OUT => stActPowerHeater3);
MOVE_EN(EN := GT_ENONLY(EN := w12, stActPowerHeater3, iSetPowerHeater3), iSetPowerHeater3, OUT => stActPowerHeater3);
%EXECUTE(EN := w11 AND NOT iPowerOrAnalog)
oPowerHeater3:=INT_TO_WORD(stActPowerHeater3*27648/1000);


%END_EXECUTE
MOVE_EN(EN := w11 AND iPowerOrAnalog, INT_TO_WORD(stActPowerHeater3), OUT => oPowerHeater3);
%NETWORK "DONE Network 37: Fault: dryer opened"
%WIRES w13, w14
TMR_DryerOpened(IN := iMachineStarted AND iSwitchDryer AND NOT iDryerClosed AND NOT stFaultDryerOpened.Q1, PT := T#5S, Q => w14);
stFaultDryerOpened(SET1 := w14, RESET := iGenFlags.StartFlag, Q1 => w13);
oFaultDryerOpened := w13;
%NETWORK
ENO := TRUE;

END_FUNCTION_BLOCK
