PROGRAM Mach1_MIDS
VAR
	FB_Mach1					: GeneralMachineFlags;
	//Mach1.GenFlags				: UDT_GeneralFlags;
	tStopPositionCleaning	: BOOL;
	
	tDoorUnitOk				: BOOL;
	tCrossDoorcircuit1 		: BOOL;
	tCrossDoorcircuit2 		: BOOL;
	tAlarmlamp				: BOOL;
	tBool					: BOOL;
	tCond					: BOOL;
	
	tStopPositionLeafCarrier: BOOL;
	tReset: BOOL;
	a:INT;
//TODO
	//test5: CTD;
	//HMI_Var_Mach1_MuteNoBunchAlarm: SR;
	RepetitionNoBunch: CTD;
	tCampulseCigarPresent: BOOL;
	RepetitionNoCigar: CTD;
	PhotocellCigarHasBeenOff: SR;
	tTime1: TIME;
	tLowLevel: BOOL;
	tErrorRuntimeGreasingSystem: BOOL;
	tAlarmSL: BOOL;
	tWarningSL: BOOL;
	tStandbySL: BOOL;
	tRunningSL: BOOL;
	tHeater1Word: WORD;
	tHeater2Word: WORD;
	tHeater3Word: WORD;
	test3: BOOL;
	test4: BOOL;
	qw105: WORD;
	DRYER_SCALING_Heater1: LIN_TRAFO;
	
	DRYER_Scaling_Speed: LIN_TRAFO;
	lrDryer_ScaledSpeed: REAL;
	lrHeater1_ScaledPower:REAL; //% of max power of 1500
	
	lrHeater1_Analog: REAL;
	DRYER_SCALING_Heater2: LIN_TRAFO;
	lrHeater2_ScaledPower: REAL;
	DRYER_SCALING_Heater1_Analog: LIN_TRAFO;
	DRYER_SCALING_Heater2_Analog: LIN_TRAFO;
	lrHeater2_Analog: REAL;
	lrHeater3_ScaledPower: REAL;
	DRYER_SCALING_Heater3: LIN_TRAFO;
	lrHeater3_Analog: REAL;
	tspeed: REAL;
	TMR_ResetSafety: TON;
	tResetSafetyGuard: BOOL;
	TMR_StartupFan: TON;
	tElevatorUp: BOOL;
	tElevatorDown:BOOL;
	TMR_DelaySafetyModuleError: TON;
	Comm_OK: BOOL;
	TON_DelayAfterNetworkError: TON;
	REQ_RestartComm: BOOL;
	ReInitAllNodes: L_MC1P_ReinitAllNodes;
END_VAR
VAR 
	Mach1_Drives_DB: Mach1_Drives;
	IDB_Dryer: Dryer;
	IDB_TrayFiller: TrayFiller;
END_VAR
IMPLEMENTATION LD
NETWORK TITLE: "DONE Network 1: Activating/deactivating MID-S/Trayfiller"
  split0 := TRUE;
  split1 := split0 AND NOT Mach1_Safety.Status.Custom_ATF_Disabled;
  Mach1_AuxData.TrayfillerActive := split1;
  HMI_Var.TrayfillerActive := split1;
  Mach1_AuxData.MIDS_Active := split0 AND TRUE;
END_NETWORK
NETWORK TITLE: "DONE Network 2: Main Block FB100 TODO"
  tResetSafetyGuard := FB_Mach1(iStartResetSeparate := LST_General.AlwaysOff, iServiceButtonHasResetFunction := LST_General.AlwaysOff, iFirstCycle := LST_General.FirstCycle, iSignalPulse := LST_General.FF500ms, iAirPressureDoorsSeparate := LST_General.AlwaysOff, iEmergencyUnitOK := (Mach1_AuxData.MIDS_Active AND Mach1_Safety.Status.EmergencyStopOK) OR NOT Mach1_AuxData.MIDS_Active, iDoorUnitOK := (Mach1_AuxData.MIDS_Active AND Mach1_Safety.Status.DoorsOK) OR NOT Mach1_AuxData.MIDS_Active, iSTO_Enabled := Mach1_Safety.Status.STO_OK, iAirPressureOK := (Mach1_AuxData.MIDS_Active AND LST_InputsOutputs.I100_0_AirpressureOK) OR NOT Mach1_AuxData.MIDS_Active, iSwitchService := Mach1_Safety.Status.ServiceMode, iButtonService := Mach1_Safety.Status.Service_ButtonAB, iStart1 := LST_InputsOutputs.I100_1_Pushbutton_start_OP0a, iStop1 := (Mach1_AuxData.MIDS_Active AND LST_InputsOutputs.I100_2_Pushbutton_stop_OP0a) OR NOT Mach1_AuxData.MIDS_Active, iReset1 := LST_General.AlwaysOff, iAutoManual1 := LST_InputsOutputs.I100_3_Selector_switch_auto_manual_OP0a, iStart2 := Mach1_AuxData.TrayfillerActive AND LST_InputsOutputs.I132_1_PB_Start_OP2a, iStop2 := LST_InputsOutputs.I132_2_PB_Stop_OP2a OR NOT Mach1_AuxData.TrayfillerActive, iReset2 := LST_General.AlwaysOff, iAutoManual2 := LST_InputsOutputs.I132_3_SW_Auto_Man, iStart3 := LST_General.AlwaysOff, iStop3 := TRUE, iReset3 := LST_General.AlwaysOff, iAutoManual3 := LST_General.AlwaysOff, iPreDelayAfterEmergStop := T#4S, iPreStartDelayAuxDrives := `fc_dinttotime(Mach1_Data.Timers.StartDelayAuxDrives,2)`, iPreStopDelayAuxDrives := `fc_dinttotime(Mach1_Data.Timers.StopDelayAuxDrives,2)`, iPreDelayAfterSTOEnabled := T#2S, GenFlags := Mach1.GenFlags, oStart1 => LST_InputsOutputs.Q100_5_Signal_lamp_Start, oStop1 => LST_InputsOutputs.Q100_6_Signal_lamp_Stop, oCrossingDoorCircuit1 => tCrossDoorcircuit1, oStart2 => LST_InputsOutputs.Q132_0_SL_Start_OP2a, oStop2 => LST_InputsOutputs.Q132_1_SL_Stop_OP2a, oCrossingDoorCircuit2 => tCrossDoorcircuit2, oAlarm => tAlarmlamp);
END_NETWORK
NETWORK
  split54 := TRUE;
  Mach1_Safety.Control.ResetSafetyGuard S= split54 AND (mach1.Genflags.StartFlag OR tResetSafetyGuard);
  Mach1_Safety.Control.ResetSafetyGuard R= TMR_ResetSafety(IN := split54 AND Mach1_Safety.Control.ResetSafetyGuard, PT := T#1S);
END_NETWORK
NETWORK TITLE: "DONE Network 3 :Muting zones "
  split2 := TRUE AND Mach1_AuxData.MainDriveHomed AND Mach1_AuxData.RollingDeviceHomed;
  Mach1_Safety.Control.Muting_zone1 := split2 AND tCrossDoorcircuit1;
  Mach1_Safety.Control.Muting_zone2 := split2 AND tCrossDoorcircuit1;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 4 (p1)Major alarms (start-up conditions)"
  Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.MIDS_Active AND NOT Mach1_Safety.Status.EmergencyStopOK, iReset := TRUE, iAlm := Mach1_Alarms.Alm001, ioAction := Mach1.GenFlags.MajorAlarm);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 4 (p2)Major alarms (start-up conditions)"
  Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.MIDS_Active AND Mach1_Safety.Status.EmergencyStopOK AND (NOT Mach1_Safety.Status.DoorsOK OR (Mach1_Safety.Status.ServiceMode AND NOT Mach1_AuxData.AllDrivesHomed AND NOT Mach1_Safety.Status.AllDoorsActuallyClosed)), iReset := TRUE, iAlm := Mach1_Alarms.Alm002, ioAction := Mach1.GenFlags.MinorAlarm);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 4 (p3)Major alarms (start-up conditions)"
  Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.MIDS_Active AND Mach1.Genflags.DelayAfterEmergStop AND NOT LST_InputsOutputs.I100_0_AirpressureOK, iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm004, ioAction := Mach1.GenFlags.MajorAlarm);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 4 (p4)Major alarms (start-up conditions)"
  Mach1_Safety.Control.ExternalRequestResetSafetyModule := (Mach1.Genflags.StopDriveDirect S= Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := TMR_DelaySafetyModuleError(IN := Mach1_AuxData.MIDS_Active AND (Mach1_Safety.Status.ErrorInInputModule OR Mach1_Safety.Status.ErrorInOutputModule), PT := T#1S), iReset := TRUE, iAlm := Mach1_Alarms.Alm009, ioAction := Mach1.GenFlags.MinorAlarm)) AND (FB_Mach1.iStart1 OR FB_Mach1.iStart2 OR FB_Mach1.iStart3);
END_NETWORK
NETWORK
  Comm_OK := Axis_MainDrive.xCommunicationOK AND Axis_SideCorrection.xCommunicationOK AND Axis_FeedFowardWrapper.xCommunicationOK AND Axis_OverrollingDevice.xCommunicationOK AND Axis_Bobbin.xCommunicationOK AND Axis_Fan.xCommunicationOK AND Axis_FeedForwardADS.xCommunicationOK AND Axis_FeedForwardATF.xCommunicationOK AND Axis_Elevator.xCommunicationOK;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 4 (p3)Major alarms (start-up conditions)"
  Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := LST_General.StartUpDelayPLC AND NOT Comm_OK, iReset := Mach1.GenFlags.StartFlag OR NOT LST_General.StartUpDelayPLC OR Comm_OK, iAlm := Mach1_Alarms.Alm011, ioAction := Mach1.GenFlags.Warning);
END_NETWORK
NETWORK
  EtherCAT_Master.xRestart := REQ_RestartComm S= TON_DelayAfterNetworkError(IN := Mach1_Alarms.Alm011 AND NOT Mach1_Alarms.Alm011, PT := T#10000S);
END_NETWORK
NETWORK
  ReInitAllNodes(xExecute := REQ_RestartComm, xInitCommunication := TRUE);
END_NETWORK
NETWORK
  REQ_RestartComm R= REQ_RestartComm AND Comm_OK;
END_NETWORK
NETWORK TITLE: "TODO NETWORK 6"
  MainDrive() EN TRUE
  HMI_Var.Mach1.HourCounterRunning S= ENO AND Mach1.GenFlags.DriveIsRunning;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 6: Drives"
  Mach1_Drives_DB() EN;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 7: Positioned stop leaf carrier"
  split3 := TRUE;
  Mach1_AuxData.MemStopLeafCarrier := split3 AND HMI_Var.Btn_StopLeafCarrier AND ((Mach1.GenFlags.RunAuto AND Mach1.GenFlags.DriveIsRunning) OR Mach1_AuxData.MemStopLeafCarrier);
  tStopPositionLeafCarrier := fc_CamC_CP_UDT(iEN := split3, iMachinePosition := HMI_Var.Mach1.Position, iResetFlag := Mach1.GenFlags.Rotflag, ioPulse := Mach1_Data.CamControls.StopPostionLeafCarrier_CP) AND Mach1_Data.CamControls.StopPostionLeafCarrier_CP.Active AND Mach1_AuxData.MemStopLeafCarrier;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 8: Alarm Positioned stop leaf carrier"
  Mach1.GenFlags.StopDriveDirect S= Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := tStopPositionLeafCarrier, iReset := NOT Mach1_AuxData.MemStopLeafCarrier, iAlm := Mach1_Alarms.Alm054, ioAction := Mach1.GenFlags.MinorAlarm);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 9: Positioned stop cleaning "
  split4 := TRUE;
  Mach1_AuxData.MemStopCleaning := split4 AND HMI_Var.Btn_Cleaning AND ((Mach1.GenFlags.RunAuto AND Mach1.GenFlags.DriveIsRunning) OR Mach1_AuxData.MemStopCleaning);
  tStopPositionCleaning := fc_CamC_CP_UDT(iEN := split4, iMachinePosition := HMI_Var.Mach1.Position, iResetFlag := Mach1.GenFlags.Rotflag, ioPulse := Mach1_Data.CamControls.StopPostionCleaning_CP) AND Mach1_AuxData.MemStopCleaning;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 10: Alarm Positioned stop cleaning "
  Mach1.GenFlags.StopDriveDirect S= Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := tStopPositionCleaning, iReset := NOT Mach1_AuxData.MemStopCleaning, iAlm := Mach1_Alarms.Alm037, ioAction := Mach1.GenFlags.MinorAlarm);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 11 (p1): Level bunch magazine alarms"
  Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.IEC_TIMERS.TON_BunchLevelWarning(IN := Mach1_AuxData.MIDS_Active AND Mach1.GenFlags.DelayAfterEmergStop AND NOT LST_InputsOutputs.I101_4_Level_bunch_magazine AND HMI_Var.Test_Prod AND NOT HMI_Var.Btn_Cleaning AND HMI_Var.Mach1.MuteNoBunchAlarm AND Mach1_Alarms.Alm036, PT := T#5S), iReset := LST_InputsOutputs.I101_4_Level_bunch_magazine OR HMI_Var.Test_Prod OR HMI_Var.Btn_Cleaning OR HMI_Var.Mach1.MuteNoBunchAlarm OR Mach1_Alarms.Alm036, iAlm := Mach1_Alarms.Alm073, ioAction := Mach1.GenFlags.Warning, => ???) EN;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 11 (p2): Level bunch magazine alarms"
  Mach1.GenFlags.StopDriveDirect S= Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.IEC_TIMERS.TON_BunchLevelAlarm(IN := Mach1_AuxData.MIDS_Active AND Mach1.GenFlags.DelayAfterEmergStop AND NOT Mach1_Alarms.Alm036 AND NOT LST_InputsOutputs.I101_4_Level_bunch_magazine AND HMI_Var.Test_Prod AND NOT HMI_Var.Btn_Cleaning AND NOT HMI_Var.Mach1.MuteNoBunchAlarm, PT := `fc_dinttotime(Mach1_Data.Timers.BunchMagazineEmptyTime,0)`), iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm036, ioAction := Mach1.GenFlags.MinorAlarm);
END_NETWORK
NETWORK TITLE: "TODO NETWORK 12: SR Bunches (JL / rolling device / outfeed)"
  split119 := fc_camc_cp_udt(iEN := , iMachinePosition := HMI_Var.Mach1.Position, iResetFlag := Mach1.GenFlags.Rotflag, ioPulse := Mach1_Data.CamControls.BunchDetection_CP);
  Mach1_AuxData.ShiftRegister.SR_bunch_present_position_3_outfeed R= split119 AND Mach1_AuxData.ShiftRegister.SR_bunch_present_position_3_outfeed;
  split120 := split119 AND Mach1_AuxData.ShiftRegister.SR_bunch_present_position_2_wrapping_device;
  Mach1_AuxData.ShiftRegister.SR_bunch_present_position_3_outfeed S= split120;
  Mach1_AuxData.ShiftRegister.SR_bunch_present_position_2_wrapping_device R= split120;
  split121 := split119 AND Mach1_AuxData.ShiftRegister.SR_bunch_present_position_1_JL;
  Mach1_AuxData.ShiftRegister.SR_bunch_present_position_2_wrapping_device S= split121;
  Mach1_AuxData.ShiftRegister.SR_bunch_present_position_1_JL R= split121;
  Mach1_AuxData.ShiftRegister.SR_bunch_present_position_1_JL S= split119 AND LST_InputsOutputs.I101_1_FC_Bunch_present;
  tBool := split119;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 13: Stop bunch infeed when cleaning is activated "
  HMI_Var.Btn_BunchSupply R= Mach1_AuxData.Edge.OSP_Emptying_Cleaning(CLK := HMI_Var.Btn_Cleaning);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 14: PNV Block bunch infeed"
  split5 := TRUE;
  split6 := split5 AND TRUE;
  split7 := fc_CamC_CP_UDT(iEN := split6, iMachinePosition := HMI_Var.Mach1.Position, iResetFlag := LST_General.AlwaysOff, ioPulse := Mach1_Data.CamControls.BlockBunchInfeed_CP) AND TRUE;
  Mach1_AuxData.BlockBunchInfeed S= split7 AND NOT HMI_Var.Btn_BunchSupply;
  Mach1_AuxData.BlockBunchInfeed R= split7 AND HMI_Var.Btn_BunchSupply;
  Mach1_AuxData.BlockBunchInfeed S= split6 AND NOT Mach1.GenFlags.DelayAfterEmergStop;
  PneumValveTerminalSMC.Pos2A := split5 AND Mach1.GenFlags.EnablePneumEStop AND Mach1_AuxData.BlockBunchInfeed AND NOT Mach1_Alarms.Alm011;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 15: Muting of alarm $"No bunch$""
  Mach1_AuxData.NumberOfMutingCyclesReached := Mach1_AuxData.COUNTERS.RepetitionMuteNuBunch(CD := ATD_SR(iSet := Mach1_Alarms.Alm041, iReset := tBool AND (NOT HMI_Var.Test_Prod OR HMI_Var.Btn_Cleaning OR Mach1_AuxData.ShiftRegister.SR_bunch_present_position_1_JL OR NOT HMI_Var.Btn_BunchSupply OR Mach1_AuxData.NumberOfMutingCyclesReached), ioSR_value := hmi_var.mach1.MuteNoBunchAlarm) AND tBool AND HMI_Var.Test_Prod AND NOT HMI_Var.Btn_Cleaning AND NOT Mach1_AuxData.ShiftRegister.SR_bunch_present_position_1_JL, LOAD := Mach1_Alarms.Alm041, PV := `INT_TO_WORD(Mach1_Data.Counters.BunchesFillBunchFeeder.SetValue)`);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 16 (p1): Alarms Bunch"
  Mach1.GenFlags.StopDriveDirect S= Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := (Mach1_AuxData.COUNTERS.RepetitionNoBunch(CD := tBool AND HMI_Var.Test_Prod AND NOT HMI_Var.Btn_Cleaning AND NOT HMI_Var.Mach1.MuteNoBunchAlarm AND NOT Mach1_AuxData.ShiftRegister.SR_bunch_present_position_1_JL, LOAD := (tBool AND (NOT HMI_Var.Test_Prod OR HMI_Var.Btn_Cleaning OR Mach1_AuxData.ShiftRegister.SR_bunch_present_position_1_JL OR NOT HMI_Var.Btn_BunchSupply OR hmi_var.mach1.MuteNoBunchAlarm)) OR (Mach1.GenFlags.StartFlag AND Mach1_Alarms.Alm041), PV := `INT_TO_WORD(Mach1_Data.Counters.MaxRepetitionNoBunch.SetValue)`) AND Mach1_AuxData.AllDrivesHomed) AND NOT HMI_Var.Mach1.MuteNoBunchAlarm, iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm041, ioAction := Mach1.GenFlags.MinorAlarm);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 16 (p2): Alarms Bunch"
  Mach1.GenFlags.StopDriveDirect S= Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := tBool AND NOT Mach1_AuxData.PhotocellBunchHasBeenOff AND HMI_Var.Btn_BunchSupply AND Mach1_AuxData.AllDrivesHomed, iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm042, ioAction := Mach1.GenFlags.MinorAlarm);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 16 (p3): Alarms Bunch"
  ATD_SR(iSet := NOT LST_InputsOutputs.I101_1_FC_Bunch_present, iReset := tBool, ioSR_value := Mach1_AuxData.PhotocellBunchHasBeenOff);
END_NETWORK
NETWORK
END_NETWORK
NETWORK TITLE: "DONE NETWORK 17 (p1): Alarms: Cigar fault"
  Mach1.GenFlags.StopDriveDirect S= Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.COUNTERS.RepetitionNoCigar(CD := (tBool := tCampulseCigarPresent := fc_CamC_CP_UDT(iEN := , iMachinePosition := HMI_Var.Mach1.Position, iResetFlag := Mach1.GenFlags.Rotflag, ioPulse := Mach1_Data.CamControls.CigarDetection_CP)) AND HMI_Var.Test_Prod AND NOT HMI_Var.Btn_Cleaning AND Mach1_AuxData.ShiftRegister.SR_bunch_present_position_3_outfeed AND NOT LST_InputsOutputs.I101_2_Cigar_present, LOAD := (tBool AND (NOT HMI_Var.Test_Prod OR HMI_Var.Btn_Cleaning OR (Mach1_AuxData.ShiftRegister.SR_bunch_present_position_3_outfeed AND LST_InputsOutputs.I101_2_Cigar_present))) OR (Mach1.GenFlags.StartFlag AND Mach1_Alarms.Alm046), PV := `INT_TO_WORD(Mach1_Data.Counters.MaxRepetitionNoCigars.SetValue)`) AND Mach1_AuxData.AllDrivesHomed, iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm046, ioAction := Mach1.GenFlags.MinorAlarm);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 17 (p2): Alarms: Cigar fault"
  Mach1.GenFlags.StopDriveDirect S= Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := tbool AND NOT Mach1_AuxData.PhotocellCigarHasBeenOff AND Mach1_AuxData.AllDrivesHomed, iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm047, ioAction := Mach1.GenFlags.MinorAlarm);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 17 (p3): Alarms: Cigar fault"
  ATD_SR(iSet := NOT LST_InputsOutputs.I101_2_Cigar_present, iReset := tbool, ioSR_value := Mach1_AuxData.PhotocellCigarHasBeenOff);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 18: Production counter"
  HMI_Var.Mach1.PRDCounterIncr S= tBool AND Mach1_AuxData.ShiftRegister.SR_bunch_present_position_3_outfeed AND LST_InputsOutputs.I101_2_Cigar_present;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 19 (p1): Set cigar present in checkRegister"
  split124 := TRUE;
  `db_CheckRegister.Positie[1].Infeed.Cigar_present_infeed` S= split124 AND tCampulseCigarPresent AND LST_InputsOutputs.I101_2_Cigar_present;
  Mach1_AuxData.MemCigarAtCrossOver S= split124 AND LST_InputsOutputs.I133_2_Cigar_detected_at_cross_over;
  split125 := Mach1_AuxData.Edge.OSP_DryerZeroPoint(CLK := split124 AND LST_InputsOutputs.I133_1_PROX_zero_position_transport_ADS);
  split126 := split125 AND Mach1_AuxData.MemCigarAtCrossOver;
  `db_CheckRegister.Positie[CTE.posCigarPresentOutfeed].Outfeed.Cigar_present_outfeed` S= split126;
  Mach1_AuxData.MemCigarAtCrossOver R= split126;
  Mach1_AuxData.PreviousCycleHasOutfeedError R= split125;
  Mach1_AuxData.PreviousCycleHasOutfeedError S= split125 AND Mach1_AuxData.CurrentCycleHasOutfeedError;
  fc_CheckRegister() EN split125;
  Mach1_AuxData.CurrentCycleHasOutfeedError R= split125;
  Mach1_AuxData.CurrentCycleHasOutfeedError S= split125 AND db_CheckRegister.CheckRegisterError;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 20: Start Fan"
  split109 := Mach1.GenFlags.EnableAuxDrive AND HMI_Var.Test_Prod AND NOT HMI_Var.Btn_Cleaning;
  Mach1_Data.Drives.Fan.Control.StartAuto := split109;
  TMR_StartupFan(IN := split109, PT := T#5S);
END_NETWORK
NETWORK
  mach1.Genflags.StopDriveDirect S= Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := NOT HMI_Var.Btn_Cleaning AND Mach1.GenFlags.EnableAuxDrive AND HMI_Var.Test_Prod AND NOT TMR_StartupFan.Q, iReset := TRUE, iAlm := Mach1_Alarms.Alm034, ioAction := mach1.Genflags.MinorAlarm);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 21: Blocking glue rod"
  split12 := Mach1.GenFlags.EnablePneumEStop AND Mach1_Safety.Status.DoorsOK;
  PneumValveTerminalSMC.Pos3A := split12 AND (NOT Mach1_AuxData.ShiftRegister.SR_bunch_present_position_2_wrapping_device OR NOT HMI_Var.Test_Prod OR HMI_Var.Btn_Cleaning) AND Mach1_AuxData.AllDrivesHomed AND NOT Mach1_Alarms.Alm011;
  PneumValveTerminalSMC.Pos3B := split12 AND NOT PneumValveTerminalSMC.Pos3A;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 22 (p1): Insert needle "
  PneumValveTerminalSMC.Pos4A := fc_CamC_LS_UDT(iEnable := Mach1_Safety.Status.DoorsOK AND Mach1.GenFlags.EnablePneumEStop, iActualSpeed := HMI_Var.Mach1.ActualSpeed, iActualPos := HMI_Var.Mach1.Position, iRotflag := Mach1.GenFlags.Rotflag, ioUDTCamControlLS := Mach1_Data.CamControls.InserNeedle_CLS) AND Mach1_AuxData.AllDrivesHomed AND NOT Mach1_Alarms.Alm011;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 22 (p2): Insert needle "
  PneumValveTerminalSMC.Pos4B := Mach1_Safety.Status.DoorsOK AND Mach1.GenFlags.EnablePneumEStop AND NOT PneumValveTerminalSMC.Pos4A;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 23 (p1): Bunch positioner"
  PneumValveTerminalSMC.Pos5A := fc_CamC_LS_UDT(iEnable := Mach1_Safety.Status.DoorsOK AND Mach1.GenFlags.EnablePneumEStop, iActualSpeed := HMI_Var.Mach1.ActualSpeed, iActualPos := HMI_Var.Mach1.Position, iRotflag := Mach1.GenFlags.Rotflag, ioUDTCamControlLS := Mach1_Data.CamControls.BunchPositioner_CLS) AND Mach1_AuxData.AllDrivesHomed AND NOT Mach1_Alarms.Alm011;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 23 (p2): Bunch positioner"
  PneumValveTerminalSMC.Pos5B := Mach1_Safety.Status.DoorsOK AND Mach1.GenFlags.EnablePneumEStop AND NOT PneumValveTerminalSMC.Pos5A;
END_NETWORK
NETWORK TITLE: "DONE NETWORK 24: Manual glue pumping"
  split103 := Mach1_AuxData.EnableGlueSprayCalibration;
  split104 := split103 AND TRUE AND (HMI_Var.Mach1.GlueStart OR HMI_Var.Mach1.GlueStop OR HMI_Var.Mach1.GlueReset OR HMI_Var.Mach1.SprayStart OR HMI_Var.Mach1.SprayStop OR HMI_Var.Mach1.SprayReset OR Mach1_AuxData.ScreenForOperatorSettingsActivated);
  Mach1_AuxData.ScreenForOperatorSettingsActivated := split104;
