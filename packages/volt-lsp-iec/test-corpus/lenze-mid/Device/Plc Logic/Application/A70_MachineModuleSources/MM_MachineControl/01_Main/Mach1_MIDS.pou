PROGRAM Mach1_MIDS
VAR
	FB_Mach1					: GeneralMachineFlags;
	//Mach1.GenFlags				: UDT_GeneralFlags;
	tStopPositionCleaning	: BOOL;
	
	tDoorUnitOk				: BOOL;
	tCrossDoorcircuit1 		: BOOL;
	tCrossDoorcircuit2 		: BOOL;
	tAlarmlamp				: BOOL;
	tBool					: BOOL;
	tCond					: BOOL;
	
	tStopPositionLeafCarrier: BOOL;
	tReset: BOOL;
	a:INT;
//TODO
	//test5: CTD;
	//HMI_Var_Mach1_MuteNoBunchAlarm: SR;
	RepetitionNoBunch: CTD;
	tCampulseCigarPresent: BOOL;
	RepetitionNoCigar: CTD;
	PhotocellCigarHasBeenOff: SR;
	tTime1: TIME;
	tLowLevel: BOOL;
	tErrorRuntimeGreasingSystem: BOOL;
	tAlarmSL: BOOL;
	tWarningSL: BOOL;
	tStandbySL: BOOL;
	tRunningSL: BOOL;
	tHeater1Word: WORD;
	tHeater2Word: WORD;
	tHeater3Word: WORD;
	test3: BOOL;
	test4: BOOL;
	qw105: WORD;
	DRYER_SCALING_Heater1: LIN_TRAFO;
	
	DRYER_Scaling_Speed: LIN_TRAFO;
	lrDryer_ScaledSpeed: REAL;
	lrHeater1_ScaledPower:REAL; //% of max power of 1500
	
	lrHeater1_Analog: REAL;
	DRYER_SCALING_Heater2: LIN_TRAFO;
	lrHeater2_ScaledPower: REAL;
	DRYER_SCALING_Heater1_Analog: LIN_TRAFO;
	DRYER_SCALING_Heater2_Analog: LIN_TRAFO;
	lrHeater2_Analog: REAL;
	lrHeater3_ScaledPower: REAL;
	DRYER_SCALING_Heater3: LIN_TRAFO;
	lrHeater3_Analog: REAL;
	tspeed: REAL;
	TMR_ResetSafety: TON;
	tResetSafetyGuard: BOOL;
	TMR_StartupFan: TON;
	tElevatorUp: BOOL;
	tElevatorDown:BOOL;
	TMR_DelaySafetyModuleError: TON;
	Comm_OK: BOOL;
	TON_DelayAfterNetworkError: TON;
	REQ_RestartComm: BOOL;
	ReInitAllNodes: L_MC1P_ReinitAllNodes;
END_VAR
VAR 
	Mach1_Drives_DB: Mach1_Drives;
	IDB_Dryer: Dryer;
	IDB_TrayFiller: TrayFiller;
END_VAR
%LANGUAGE LD
%NETWORK "DONE Network 1: Activating/deactivating MID-S/Trayfiller"
VAR w1 : ANY; w2 : ANY; END_VAR
w1 := TRUE;
w2 := w1 AND INVERT(Mach1_Safety.Status.Custom_ATF_Disabled);
ASSIGN(w2, Q => Mach1_AuxData.TrayfillerActive);
ASSIGN(w2, Q => HMI_Var.TrayfillerActive);
ASSIGN(w1 AND TRUE, Q => Mach1_AuxData.MIDS_Active);
%NETWORK "DONE Network 2: Main Block FB100 TODO"
ASSIGN(FB_Mach1(iStartResetSeparate := LST_General.AlwaysOff, iServiceButtonHasResetFunction := LST_General.AlwaysOff, iFirstCycle := LST_General.FirstCycle, iSignalPulse := LST_General.FF500ms, iAirPressureDoorsSeparate := LST_General.AlwaysOff, iEmergencyUnitOK := Mach1_AuxData.MIDS_Active AND Mach1_Safety.Status.EmergencyStopOK OR INVERT(Mach1_AuxData.MIDS_Active), iDoorUnitOK := Mach1_AuxData.MIDS_Active AND Mach1_Safety.Status.DoorsOK OR INVERT(Mach1_AuxData.MIDS_Active), iSTO_Enabled := Mach1_Safety.Status.STO_OK, iAirPressureOK := Mach1_AuxData.MIDS_Active AND LST_InputsOutputs.I100_0_AirpressureOK OR INVERT(Mach1_AuxData.MIDS_Active), iSwitchService := Mach1_Safety.Status.ServiceMode, iButtonService := Mach1_Safety.Status.Service_ButtonAB, iStart1 := LST_InputsOutputs.I100_1_Pushbutton_start_OP0a, iStop1 := Mach1_AuxData.MIDS_Active AND LST_InputsOutputs.I100_2_Pushbutton_stop_OP0a OR INVERT(Mach1_AuxData.MIDS_Active), iReset1 := LST_General.AlwaysOff, iAutoManual1 := LST_InputsOutputs.I100_3_Selector_switch_auto_manual_OP0a, iStart2 := Mach1_AuxData.TrayfillerActive AND LST_InputsOutputs.I132_1_PB_Start_OP2a, iStop2 := LST_InputsOutputs.I132_2_PB_Stop_OP2a OR INVERT(Mach1_AuxData.TrayfillerActive), iReset2 := LST_General.AlwaysOff, iAutoManual2 := LST_InputsOutputs.I132_3_SW_Auto_Man, iStart3 := LST_General.AlwaysOff, iStop3 := TRUE, iReset3 := LST_General.AlwaysOff, iAutoManual3 := LST_General.AlwaysOff, iPreDelayAfterEmergStop := T#4S, iPreStartDelayAuxDrives := OPERAND('fc_dinttotime(Mach1_Data.Timers.StartDelayAuxDrives,2)'), iPreStopDelayAuxDrives := OPERAND('fc_dinttotime(Mach1_Data.Timers.StopDelayAuxDrives,2)'), iPreDelayAfterSTOEnabled := T#2S, GenFlags := Mach1.GenFlags, oStart1 => LST_InputsOutputs.Q100_5_Signal_lamp_Start, oStop1 => LST_InputsOutputs.Q100_6_Signal_lamp_Stop, oCrossingDoorCircuit1 => tCrossDoorcircuit1, oStart2 => LST_InputsOutputs.Q132_0_SL_Start_OP2a, oStop2 => LST_InputsOutputs.Q132_1_SL_Stop_OP2a, oCrossingDoorCircuit2 => tCrossDoorcircuit2, oAlarm => tAlarmlamp), Q => tResetSafetyGuard);
%NETWORK
VAR w3 : ANY; END_VAR
w3 := TRUE;
ASSIGN(w3 AND (mach1.Genflags.StartFlag OR tResetSafetyGuard), Q_SET => Mach1_Safety.Control.ResetSafetyGuard);
ASSIGN(TMR_ResetSafety(IN := w3 AND Mach1_Safety.Control.ResetSafetyGuard, PT := T#1S), Q_RESET => Mach1_Safety.Control.ResetSafetyGuard);
%NETWORK "DONE Network 3 :Muting zones "
VAR w4 : ANY; END_VAR
w4 := TRUE AND Mach1_AuxData.MainDriveHomed AND Mach1_AuxData.RollingDeviceHomed;
ASSIGN(w4 AND tCrossDoorcircuit1, Q => Mach1_Safety.Control.Muting_zone1);
ASSIGN(w4 AND tCrossDoorcircuit1, Q => Mach1_Safety.Control.Muting_zone2);
%NETWORK "DONE NETWORK 4 (p1)Major alarms (start-up conditions)"
Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.MIDS_Active AND INVERT(Mach1_Safety.Status.EmergencyStopOK), iReset := TRUE, iAlm := Mach1_Alarms.Alm001, ioAction := Mach1.GenFlags.MajorAlarm);
%NETWORK "DONE NETWORK 4 (p2)Major alarms (start-up conditions)"
Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.MIDS_Active AND Mach1_Safety.Status.EmergencyStopOK AND (INVERT(Mach1_Safety.Status.DoorsOK) OR Mach1_Safety.Status.ServiceMode AND INVERT(Mach1_AuxData.AllDrivesHomed) AND INVERT(Mach1_Safety.Status.AllDoorsActuallyClosed)), iReset := TRUE, iAlm := Mach1_Alarms.Alm002, ioAction := Mach1.GenFlags.MinorAlarm);
%NETWORK "DONE NETWORK 4 (p3)Major alarms (start-up conditions)"
Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.MIDS_Active AND Mach1.Genflags.DelayAfterEmergStop AND INVERT(LST_InputsOutputs.I100_0_AirpressureOK), iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm004, ioAction := Mach1.GenFlags.MajorAlarm);
%NETWORK "DONE NETWORK 4 (p4)Major alarms (start-up conditions)"
ASSIGN(ASSIGN(Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := TMR_DelaySafetyModuleError(IN := Mach1_AuxData.MIDS_Active AND (Mach1_Safety.Status.ErrorInInputModule OR Mach1_Safety.Status.ErrorInOutputModule), PT := T#1S), iReset := TRUE, iAlm := Mach1_Alarms.Alm009, ioAction := Mach1.GenFlags.MinorAlarm), Q_SET => Mach1.Genflags.StopDriveDirect) AND (FB_Mach1.iStart1 OR FB_Mach1.iStart2 OR FB_Mach1.iStart3), Q => Mach1_Safety.Control.ExternalRequestResetSafetyModule);
%NETWORK
ASSIGN(Axis_MainDrive.xCommunicationOK AND Axis_SideCorrection.xCommunicationOK AND Axis_FeedFowardWrapper.xCommunicationOK AND Axis_OverrollingDevice.xCommunicationOK AND Axis_Bobbin.xCommunicationOK AND Axis_Fan.xCommunicationOK AND Axis_FeedForwardADS.xCommunicationOK AND Axis_FeedForwardATF.xCommunicationOK AND Axis_Elevator.xCommunicationOK, Q => Comm_OK);
%NETWORK "DONE NETWORK 4 (p3)Major alarms (start-up conditions)"
Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := LST_General.StartUpDelayPLC AND INVERT(Comm_OK), iReset := Mach1.GenFlags.StartFlag OR INVERT(LST_General.StartUpDelayPLC) OR Comm_OK, iAlm := Mach1_Alarms.Alm011, ioAction := Mach1.GenFlags.Warning);
%NETWORK
ASSIGN(TON_DelayAfterNetworkError(IN := Mach1_Alarms.Alm011 AND INVERT(Mach1_Alarms.Alm011), PT := T#10000S), Q => EtherCAT_Master.xRestart, Q_SET => REQ_RestartComm);
%NETWORK
ReInitAllNodes(xExecute := REQ_RestartComm, xInitCommunication := TRUE);
%NETWORK
ASSIGN(REQ_RestartComm AND Comm_OK, Q_RESET => REQ_RestartComm);
%NETWORK "TODO NETWORK 6"
ASSIGN(MainDrive(EN := TRUE) AND Mach1.GenFlags.DriveIsRunning, Q_SET => HMI_Var.Mach1.HourCounterRunning);
%NETWORK "DONE NETWORK 6: Drives"
Mach1_Drives_DB(EN := RAIL());
%NETWORK "DONE NETWORK 7: Positioned stop leaf carrier"
VAR w5 : ANY; END_VAR
w5 := TRUE;
ASSIGN(w5 AND HMI_Var.Btn_StopLeafCarrier AND (Mach1.GenFlags.RunAuto AND Mach1.GenFlags.DriveIsRunning OR Mach1_AuxData.MemStopLeafCarrier), Q => Mach1_AuxData.MemStopLeafCarrier);
ASSIGN(fc_CamC_CP_UDT(iEN := w5, iMachinePosition := HMI_Var.Mach1.Position, iResetFlag := Mach1.GenFlags.Rotflag, ioPulse := Mach1_Data.CamControls.StopPostionLeafCarrier_CP) AND Mach1_Data.CamControls.StopPostionLeafCarrier_CP.Active AND Mach1_AuxData.MemStopLeafCarrier, Q => tStopPositionLeafCarrier);
%NETWORK "DONE NETWORK 8: Alarm Positioned stop leaf carrier"
ASSIGN(Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := tStopPositionLeafCarrier, iReset := INVERT(Mach1_AuxData.MemStopLeafCarrier), iAlm := Mach1_Alarms.Alm054, ioAction := Mach1.GenFlags.MinorAlarm), Q_SET => Mach1.GenFlags.StopDriveDirect);
%NETWORK "DONE NETWORK 9: Positioned stop cleaning "
VAR w6 : ANY; END_VAR
w6 := TRUE;
ASSIGN(w6 AND HMI_Var.Btn_Cleaning AND (Mach1.GenFlags.RunAuto AND Mach1.GenFlags.DriveIsRunning OR Mach1_AuxData.MemStopCleaning), Q => Mach1_AuxData.MemStopCleaning);
ASSIGN(fc_CamC_CP_UDT(iEN := w6, iMachinePosition := HMI_Var.Mach1.Position, iResetFlag := Mach1.GenFlags.Rotflag, ioPulse := Mach1_Data.CamControls.StopPostionCleaning_CP) AND Mach1_AuxData.MemStopCleaning, Q => tStopPositionCleaning);
%NETWORK "DONE NETWORK 10: Alarm Positioned stop cleaning "
ASSIGN(Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := tStopPositionCleaning, iReset := INVERT(Mach1_AuxData.MemStopCleaning), iAlm := Mach1_Alarms.Alm037, ioAction := Mach1.GenFlags.MinorAlarm), Q_SET => Mach1.GenFlags.StopDriveDirect);
%NETWORK "DONE NETWORK 11 (p1): Level bunch magazine alarms"
Alarms_V5_1_100(EN := RAIL(), AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.IEC_TIMERS.TON_BunchLevelWarning(IN := Mach1_AuxData.MIDS_Active AND Mach1.GenFlags.DelayAfterEmergStop AND INVERT(LST_InputsOutputs.I101_4_Level_bunch_magazine) AND HMI_Var.Test_Prod AND INVERT(HMI_Var.Btn_Cleaning) AND HMI_Var.Mach1.MuteNoBunchAlarm AND Mach1_Alarms.Alm036, PT := T#5S), iReset := LST_InputsOutputs.I101_4_Level_bunch_magazine OR HMI_Var.Test_Prod OR HMI_Var.Btn_Cleaning OR HMI_Var.Mach1.MuteNoBunchAlarm OR Mach1_Alarms.Alm036, iAlm := Mach1_Alarms.Alm073, ioAction := Mach1.GenFlags.Warning);
%NETWORK "DONE NETWORK 11 (p2): Level bunch magazine alarms"
ASSIGN(Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.IEC_TIMERS.TON_BunchLevelAlarm(IN := Mach1_AuxData.MIDS_Active AND Mach1.GenFlags.DelayAfterEmergStop AND INVERT(Mach1_Alarms.Alm036) AND INVERT(LST_InputsOutputs.I101_4_Level_bunch_magazine) AND HMI_Var.Test_Prod AND INVERT(HMI_Var.Btn_Cleaning) AND INVERT(HMI_Var.Mach1.MuteNoBunchAlarm), PT := OPERAND('fc_dinttotime(Mach1_Data.Timers.BunchMagazineEmptyTime,0)')), iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm036, ioAction := Mach1.GenFlags.MinorAlarm), Q_SET => Mach1.GenFlags.StopDriveDirect);
%NETWORK "TODO NETWORK 12: SR Bunches (JL / rolling device / outfeed)"
VAR w7 : ANY; w8 : ANY; w9 : ANY; END_VAR
w7 := fc_camc_cp_udt(iEN := RAIL(), iMachinePosition := HMI_Var.Mach1.Position, iResetFlag := Mach1.GenFlags.Rotflag, ioPulse := Mach1_Data.CamControls.BunchDetection_CP);
ASSIGN(w7 AND Mach1_AuxData.ShiftRegister.SR_bunch_present_position_3_outfeed, Q_RESET => Mach1_AuxData.ShiftRegister.SR_bunch_present_position_3_outfeed);
w8 := w7 AND Mach1_AuxData.ShiftRegister.SR_bunch_present_position_2_wrapping_device;
ASSIGN(w8, Q_SET => Mach1_AuxData.ShiftRegister.SR_bunch_present_position_3_outfeed);
ASSIGN(w8, Q_RESET => Mach1_AuxData.ShiftRegister.SR_bunch_present_position_2_wrapping_device);
w9 := w7 AND Mach1_AuxData.ShiftRegister.SR_bunch_present_position_1_JL;
ASSIGN(w9, Q_SET => Mach1_AuxData.ShiftRegister.SR_bunch_present_position_2_wrapping_device);
ASSIGN(w9, Q_RESET => Mach1_AuxData.ShiftRegister.SR_bunch_present_position_1_JL);
ASSIGN(w7 AND LST_InputsOutputs.I101_1_FC_Bunch_present, Q_SET => Mach1_AuxData.ShiftRegister.SR_bunch_present_position_1_JL);
ASSIGN(w7, Q => tBool);
%NETWORK "DONE NETWORK 13: Stop bunch infeed when cleaning is activated "
ASSIGN(Mach1_AuxData.Edge.OSP_Emptying_Cleaning(CLK := HMI_Var.Btn_Cleaning), Q_RESET => HMI_Var.Btn_BunchSupply);
%NETWORK "DONE NETWORK 14: PNV Block bunch infeed"
VAR w10 : ANY; w11 : ANY; w12 : ANY; END_VAR
w10 := TRUE;
w11 := w10 AND TRUE;
w12 := fc_CamC_CP_UDT(iEN := w11, iMachinePosition := HMI_Var.Mach1.Position, iResetFlag := LST_General.AlwaysOff, ioPulse := Mach1_Data.CamControls.BlockBunchInfeed_CP) AND TRUE;
ASSIGN(w12 AND INVERT(HMI_Var.Btn_BunchSupply), Q_SET => Mach1_AuxData.BlockBunchInfeed);
ASSIGN(w12 AND HMI_Var.Btn_BunchSupply, Q_RESET => Mach1_AuxData.BlockBunchInfeed);
ASSIGN(w11 AND INVERT(Mach1.GenFlags.DelayAfterEmergStop), Q_SET => Mach1_AuxData.BlockBunchInfeed);
ASSIGN(w10 AND Mach1.GenFlags.EnablePneumEStop AND Mach1_AuxData.BlockBunchInfeed AND INVERT(Mach1_Alarms.Alm011), Q => PneumValveTerminalSMC.Pos2A);
%NETWORK "DONE NETWORK 15: Muting of alarm $"No bunch$""
ASSIGN(Mach1_AuxData.COUNTERS.RepetitionMuteNuBunch(CD := ATD_SR(iSet := Mach1_Alarms.Alm041, iReset := tBool AND (INVERT(HMI_Var.Test_Prod) OR HMI_Var.Btn_Cleaning OR Mach1_AuxData.ShiftRegister.SR_bunch_present_position_1_JL OR INVERT(HMI_Var.Btn_BunchSupply) OR Mach1_AuxData.NumberOfMutingCyclesReached), ioSR_value := hmi_var.mach1.MuteNoBunchAlarm) AND tBool AND HMI_Var.Test_Prod AND INVERT(HMI_Var.Btn_Cleaning) AND INVERT(Mach1_AuxData.ShiftRegister.SR_bunch_present_position_1_JL), LOAD := Mach1_Alarms.Alm041, PV := OPERAND('INT_TO_WORD(Mach1_Data.Counters.BunchesFillBunchFeeder.SetValue)')), Q => Mach1_AuxData.NumberOfMutingCyclesReached);
%NETWORK "DONE NETWORK 16 (p1): Alarms Bunch"
ASSIGN(Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := (Mach1_AuxData.COUNTERS.RepetitionNoBunch(CD := tBool AND HMI_Var.Test_Prod AND INVERT(HMI_Var.Btn_Cleaning) AND INVERT(HMI_Var.Mach1.MuteNoBunchAlarm) AND INVERT(Mach1_AuxData.ShiftRegister.SR_bunch_present_position_1_JL), LOAD := tBool AND (INVERT(HMI_Var.Test_Prod) OR HMI_Var.Btn_Cleaning OR Mach1_AuxData.ShiftRegister.SR_bunch_present_position_1_JL OR INVERT(HMI_Var.Btn_BunchSupply) OR hmi_var.mach1.MuteNoBunchAlarm) OR Mach1.GenFlags.StartFlag AND Mach1_Alarms.Alm041, PV := OPERAND('INT_TO_WORD(Mach1_Data.Counters.MaxRepetitionNoBunch.SetValue)')) AND Mach1_AuxData.AllDrivesHomed) AND INVERT(HMI_Var.Mach1.MuteNoBunchAlarm), iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm041, ioAction := Mach1.GenFlags.MinorAlarm), Q_SET => Mach1.GenFlags.StopDriveDirect);
%NETWORK "DONE NETWORK 16 (p2): Alarms Bunch"
ASSIGN(Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := tBool AND INVERT(Mach1_AuxData.PhotocellBunchHasBeenOff) AND HMI_Var.Btn_BunchSupply AND Mach1_AuxData.AllDrivesHomed, iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm042, ioAction := Mach1.GenFlags.MinorAlarm), Q_SET => Mach1.GenFlags.StopDriveDirect);
%NETWORK "DONE NETWORK 16 (p3): Alarms Bunch"
ATD_SR(iSet := INVERT(LST_InputsOutputs.I101_1_FC_Bunch_present), iReset := tBool, ioSR_value := Mach1_AuxData.PhotocellBunchHasBeenOff);
%NETWORK
%NETWORK "DONE NETWORK 17 (p1): Alarms: Cigar fault"
ASSIGN(Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.COUNTERS.RepetitionNoCigar(CD := ASSIGN(fc_CamC_CP_UDT(iEN := RAIL(), iMachinePosition := HMI_Var.Mach1.Position, iResetFlag := Mach1.GenFlags.Rotflag, ioPulse := Mach1_Data.CamControls.CigarDetection_CP), Q => tBool, Q => tCampulseCigarPresent) AND HMI_Var.Test_Prod AND INVERT(HMI_Var.Btn_Cleaning) AND Mach1_AuxData.ShiftRegister.SR_bunch_present_position_3_outfeed AND INVERT(LST_InputsOutputs.I101_2_Cigar_present), LOAD := tBool AND (INVERT(HMI_Var.Test_Prod) OR HMI_Var.Btn_Cleaning OR Mach1_AuxData.ShiftRegister.SR_bunch_present_position_3_outfeed AND LST_InputsOutputs.I101_2_Cigar_present) OR Mach1.GenFlags.StartFlag AND Mach1_Alarms.Alm046, PV := OPERAND('INT_TO_WORD(Mach1_Data.Counters.MaxRepetitionNoCigars.SetValue)')) AND Mach1_AuxData.AllDrivesHomed, iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm046, ioAction := Mach1.GenFlags.MinorAlarm), Q_SET => Mach1.GenFlags.StopDriveDirect);
%NETWORK "DONE NETWORK 17 (p2): Alarms: Cigar fault"
ASSIGN(Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := tbool AND INVERT(Mach1_AuxData.PhotocellCigarHasBeenOff) AND Mach1_AuxData.AllDrivesHomed, iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm047, ioAction := Mach1.GenFlags.MinorAlarm), Q_SET => Mach1.GenFlags.StopDriveDirect);
%NETWORK "DONE NETWORK 17 (p3): Alarms: Cigar fault"
ATD_SR(iSet := INVERT(LST_InputsOutputs.I101_2_Cigar_present), iReset := tbool, ioSR_value := Mach1_AuxData.PhotocellCigarHasBeenOff);
%NETWORK "DONE NETWORK 18: Production counter"
ASSIGN(tBool AND Mach1_AuxData.ShiftRegister.SR_bunch_present_position_3_outfeed AND LST_InputsOutputs.I101_2_Cigar_present, Q_SET => HMI_Var.Mach1.PRDCounterIncr);
%NETWORK "DONE NETWORK 19 (p1): Set cigar present in checkRegister"
VAR w13 : ANY; w14 : ANY; w15 : ANY; END_VAR
w13 := TRUE;
ASSIGN(w13 AND tCampulseCigarPresent AND LST_InputsOutputs.I101_2_Cigar_present, Q_SET => db_CheckRegister.Positie[1].Infeed.Cigar_present_infeed);
ASSIGN(w13 AND LST_InputsOutputs.I133_2_Cigar_detected_at_cross_over, Q_SET => Mach1_AuxData.MemCigarAtCrossOver);
w14 := Mach1_AuxData.Edge.OSP_DryerZeroPoint(CLK := w13 AND LST_InputsOutputs.I133_1_PROX_zero_position_transport_ADS);
w15 := w14 AND Mach1_AuxData.MemCigarAtCrossOver;
ASSIGN(w15, Q_SET => db_CheckRegister.Positie[CTE.posCigarPresentOutfeed].Outfeed.Cigar_present_outfeed);
ASSIGN(w15, Q_RESET => Mach1_AuxData.MemCigarAtCrossOver);
ASSIGN(w14, Q_RESET => Mach1_AuxData.PreviousCycleHasOutfeedError);
ASSIGN(w14 AND Mach1_AuxData.CurrentCycleHasOutfeedError, Q_SET => Mach1_AuxData.PreviousCycleHasOutfeedError);
fc_CheckRegister(EN := w14);
ASSIGN(w14, Q_RESET => Mach1_AuxData.CurrentCycleHasOutfeedError);
ASSIGN(w14 AND db_CheckRegister.CheckRegisterError, Q_SET => Mach1_AuxData.CurrentCycleHasOutfeedError);
%NETWORK "DONE NETWORK 20: Start Fan"
VAR w16 : ANY; END_VAR
w16 := Mach1.GenFlags.EnableAuxDrive AND HMI_Var.Test_Prod AND INVERT(HMI_Var.Btn_Cleaning);
ASSIGN(w16, Q => Mach1_Data.Drives.Fan.Control.StartAuto);
TMR_StartupFan(IN := w16, PT := T#5S);
%NETWORK
ASSIGN(Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := INVERT(HMI_Var.Btn_Cleaning) AND Mach1.GenFlags.EnableAuxDrive AND HMI_Var.Test_Prod AND INVERT(TMR_StartupFan.Q), iReset := TRUE, iAlm := Mach1_Alarms.Alm034, ioAction := mach1.Genflags.MinorAlarm), Q_SET => mach1.Genflags.StopDriveDirect);
%NETWORK "DONE NETWORK 21: Blocking glue rod"
VAR w17 : ANY; END_VAR
w17 := Mach1.GenFlags.EnablePneumEStop AND Mach1_Safety.Status.DoorsOK;
ASSIGN(w17 AND (INVERT(Mach1_AuxData.ShiftRegister.SR_bunch_present_position_2_wrapping_device) OR INVERT(HMI_Var.Test_Prod) OR HMI_Var.Btn_Cleaning) AND Mach1_AuxData.AllDrivesHomed AND INVERT(Mach1_Alarms.Alm011), Q => PneumValveTerminalSMC.Pos3A);
ASSIGN(w17 AND INVERT(PneumValveTerminalSMC.Pos3A), Q => PneumValveTerminalSMC.Pos3B);
%NETWORK "DONE NETWORK 22 (p1): Insert needle "
ASSIGN(fc_CamC_LS_UDT(iEnable := Mach1_Safety.Status.DoorsOK AND Mach1.GenFlags.EnablePneumEStop, iActualSpeed := HMI_Var.Mach1.ActualSpeed, iActualPos := HMI_Var.Mach1.Position, iRotflag := Mach1.GenFlags.Rotflag, ioUDTCamControlLS := Mach1_Data.CamControls.InserNeedle_CLS) AND Mach1_AuxData.AllDrivesHomed AND INVERT(Mach1_Alarms.Alm011), Q => PneumValveTerminalSMC.Pos4A);
%NETWORK "DONE NETWORK 22 (p2): Insert needle "
ASSIGN(Mach1_Safety.Status.DoorsOK AND Mach1.GenFlags.EnablePneumEStop AND INVERT(PneumValveTerminalSMC.Pos4A), Q => PneumValveTerminalSMC.Pos4B);
%NETWORK "DONE NETWORK 23 (p1): Bunch positioner"
ASSIGN(fc_CamC_LS_UDT(iEnable := Mach1_Safety.Status.DoorsOK AND Mach1.GenFlags.EnablePneumEStop, iActualSpeed := HMI_Var.Mach1.ActualSpeed, iActualPos := HMI_Var.Mach1.Position, iRotflag := Mach1.GenFlags.Rotflag, ioUDTCamControlLS := Mach1_Data.CamControls.BunchPositioner_CLS) AND Mach1_AuxData.AllDrivesHomed AND INVERT(Mach1_Alarms.Alm011), Q => PneumValveTerminalSMC.Pos5A);
%NETWORK "DONE NETWORK 23 (p2): Bunch positioner"
