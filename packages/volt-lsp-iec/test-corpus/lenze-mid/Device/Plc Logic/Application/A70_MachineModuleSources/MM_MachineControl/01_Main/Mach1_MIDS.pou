Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.TrayfillerActive AND Trayfiller_Data.Alarms.AlmOutfeeding AND (Mach1_AuxData.AllDrivesHomed OR NOT Mach1_AuxData.MIDS_Active), iReset := TRUE, iAlm := Mach1_Alarms.Alm063, ioAction := Mach1.GenFlags.MinorAlarm);
%NETWORK "DONE NETWORK 46 (p8): Alarms trayfiller"
Mach1.GenFlags.StopDriveDirect S= Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.TrayfillerActive AND Trayfiller_Data.Alarms.AlmLightCurtainElevator AND (Mach1_AuxData.AllDrivesHomed OR NOT Mach1_AuxData.MIDS_Active), iReset := TRUE, iAlm := Mach1_Alarms.Alm064, ioAction := Mach1.GenFlags.MinorAlarm);
%NETWORK "DONE NETWORK 46 (p9): Alarms trayfiller"
Mach1.GenFlags.StopDriveDirect S= Mach1_AuxData.AllDrivesHomed AND Mach1_AuxData.TrayfillerActive AND NOT Trayfiller_Data.commInterface.Permission;
%NETWORK "TODO NETWORK 47 (p1):Greasing system"
%NETWORK "DONE NETWORK 47 (p2): Greasing system"
Mach1.GenFlags.StopDriveDirect S= Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1.GenFlags.DelayAfterEmergStop AND tLowLevel, iReset := TRUE, iAlm := Mach1_Alarms.Alm078, ioAction := Mach1.GenFlags.Warning);
%NETWORK "DONE NETWORK 48: Alarm: Greasing system"
Mach1.GenFlags.StopDriveDirect S= Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1.GenFlags.DelayAfterEmergStop AND tErrorRuntimeGreasingSystem, iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm067, ioAction := Mach1.GenFlags.MinorAlarm);
%NETWORK "DONE NETWORK 49: State of the machine"
VAR w27 : ANY; w28 : ANY; w29 : ANY; END_VAR
w27 := TRUE;
tAlarmSL := MOVE(EN := w27 AND (Mach1.GenFlags.MajorAlarm OR Mach1.GenFlags.MinorAlarm), 0, OUT => HMI_Var.Mach1.Status).ENO;
w28 := w27 AND NOT Mach1.GenFlags.MajorAlarm AND NOT Mach1.GenFlags.MinorAlarm;
tWarningSL := MOVE(EN := w28 AND Mach1.GenFlags.Warning, 1, OUT => HMI_Var.Mach1.Status).ENO;
w29 := w28 AND NOT Mach1.GenFlags.Warning;
tStandbySL := MOVE(EN := w29 AND NOT Mach1.GenFlags.RunMan AND NOT Mach1.GenFlags.RunAuto, 2, OUT => HMI_Var.Mach1.Status).ENO;
tRunningSL := MOVE(EN := w29 AND (Mach1.GenFlags.RunMan OR Mach1.GenFlags.RunAuto), 3, OUT => HMI_Var.Mach1.Status).ENO;
%NETWORK "TODO NETWORK 50: SL Alarmlamp"
VAR w30 : ANY; END_VAR
w30 := TRUE;
LST_InputsOutputs.Q100_2_Pilot_light_Alarm_red_ := w30 AND tAlarmlamp AND tAlarmSL;
LST_InputsOutputs.Q100_1_Pilot_light_Alarm_orange_ := w30 AND tAlarmlamp AND tWarningSL;
LST_InputsOutputs.Q100_0_Pilot_light_Alarm_green_ := BRANCH_SHORTCIRCUIT(FEED := w30, tAlarmlamp AND tStandbySL, tRunningSL);
%NETWORK "TODO NETWORK 51: SL Alarmlamp Buzzer"

END_PROGRAM
