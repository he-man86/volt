  DRYER_Scaling_Speed(IN := `DINT_TO_REAL(HMI_Var.Mach1.ActualSpeedDryer)`, IN_MIN := 0, IN_MAX := 1000, OUT_MIN := 0, OUT_MAX := 1, OUT => lrDryer_ScaledSpeed) EN split40;
  DRYER_SCALING_Heater1(IN := tHeater1Word, IN_MIN := 0, IN_MAX := 1500, OUT_MIN := 0, OUT_MAX := 1, OUT => lrHeater1_ScaledPower) EN split40
  MOVE `REAL_TO_INT(lrHeater1_ScaledPower*lrDryer_ScaledSpeed*1500)` => HMI_Var.Mach1.ActHeater1 EN ENO
  DRYER_SCALING_Heater1_Analog(IN := `lrDryer_ScaledSpeed*lrHeater1_ScaledPower*1500`, IN_MIN := 0, IN_MAX := 1500, OUT_MIN := 0, OUT_MAX := 16384, OUT => lrHeater1_Analog) EN ENO
  MOVE `REAL_TO_WORD(lrHeater1_Analog)` => %QW105 EN ENO;
  DRYER_SCALING_Heater2(IN := tHeater2Word, IN_MIN := 0, IN_MAX := 1500, OUT_MIN := 0, OUT_MAX := 1, OUT => lrHeater2_ScaledPower) EN split40
  MOVE `REAL_TO_INT(lrHeater2_ScaledPower*lrDryer_ScaledSpeed*1500)` => HMI_Var.Mach1.ActHeater2 EN ENO
  DRYER_SCALING_Heater2_Analog(IN := `lrDryer_ScaledSpeed*lrHeater2_ScaledPower*1500`, IN_MIN := 0, IN_MAX := 1500, OUT_MIN := 0, OUT_MAX := 16384, OUT => lrHeater2_Analog) EN ENO
  MOVE `REAL_TO_WORD(lrHeater2_Analog)` => %QW106 EN ENO;
  DRYER_SCALING_Heater3(IN := tHeater3Word, IN_MIN := 0, IN_MAX := 1500, OUT_MIN := 0, OUT_MAX := 1, OUT => lrHeater3_ScaledPower) EN split40
  MOVE `REAL_TO_INT(lrHeater3_ScaledPower*lrDryer_ScaledSpeed*1500)` => HMI_Var.Mach1.ActHeater3 EN ENO
  DRYER_SCALING_Heater2_Analog(IN := `lrDryer_ScaledSpeed*lrHeater3_ScaledPower*1500`, IN_MIN := 0, IN_MAX := 1500, OUT_MIN := 0, OUT_MAX := 16384, OUT => lrHeater3_Analog) EN ENO
