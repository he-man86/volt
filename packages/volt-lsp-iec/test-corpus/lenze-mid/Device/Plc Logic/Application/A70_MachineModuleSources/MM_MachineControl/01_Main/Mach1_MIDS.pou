  Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.TrayfillerActive AND Trayfiller_Data.Alarms.WrnChangeTray AND (Mach1_AuxData.AllDrivesHomed OR NOT Mach1_AuxData.MIDS_Active), iReset := TRUE, iAlm := Mach1_Alarms.Alm075, ioAction := Mach1.GenFlags.Warning);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 46 (p6): Alarms trayfiller"
  Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.TrayfillerActive AND Trayfiller_Data.Alarms.AlmOutfeedFull AND (Mach1_AuxData.AllDrivesHomed OR NOT Mach1_AuxData.MIDS_Active), iReset := TRUE, iAlm := Mach1_Alarms.Alm062, ioAction := Mach1.GenFlags.MinorAlarm);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 46 (p7): Alarms trayfiller"
  Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.TrayfillerActive AND Trayfiller_Data.Alarms.AlmOutfeeding AND (Mach1_AuxData.AllDrivesHomed OR NOT Mach1_AuxData.MIDS_Active), iReset := TRUE, iAlm := Mach1_Alarms.Alm063, ioAction := Mach1.GenFlags.MinorAlarm);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 46 (p8): Alarms trayfiller"
  Mach1.GenFlags.StopDriveDirect S= Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.TrayfillerActive AND Trayfiller_Data.Alarms.AlmLightCurtainElevator AND (Mach1_AuxData.AllDrivesHomed OR NOT Mach1_AuxData.MIDS_Active), iReset := TRUE, iAlm := Mach1_Alarms.Alm064, ioAction := Mach1.GenFlags.MinorAlarm);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 46 (p9): Alarms trayfiller"
  Mach1.GenFlags.StopDriveDirect S= Mach1_AuxData.AllDrivesHomed AND Mach1_AuxData.TrayfillerActive AND NOT Trayfiller_Data.commInterface.Permission;
END_NETWORK
NETWORK TITLE: "TODO NETWORK 47 (p1):Greasing system"
END_NETWORK
NETWORK TITLE: "DONE NETWORK 47 (p2): Greasing system"
  Mach1.GenFlags.StopDriveDirect S= Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1.GenFlags.DelayAfterEmergStop AND tLowLevel, iReset := TRUE, iAlm := Mach1_Alarms.Alm078, ioAction := Mach1.GenFlags.Warning);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 48: Alarm: Greasing system"
  Mach1.GenFlags.StopDriveDirect S= Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1.GenFlags.DelayAfterEmergStop AND tErrorRuntimeGreasingSystem, iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm067, ioAction := Mach1.GenFlags.MinorAlarm);
END_NETWORK
NETWORK TITLE: "DONE NETWORK 49: State of the machine"
  split22 := TRUE;
  MOVE 0 => HMI_Var.Mach1.Status EN split22 AND (Mach1.GenFlags.MajorAlarm OR Mach1.GenFlags.MinorAlarm)
  tAlarmSL := ENO;
  split23 := split22 AND NOT Mach1.GenFlags.MajorAlarm AND NOT Mach1.GenFlags.MinorAlarm;
  MOVE 1 => HMI_Var.Mach1.Status EN split23 AND Mach1.GenFlags.Warning
  tWarningSL := ENO;
  split24 := split23 AND NOT Mach1.GenFlags.Warning;
  MOVE 2 => HMI_Var.Mach1.Status EN split24 AND NOT Mach1.GenFlags.RunMan AND NOT Mach1.GenFlags.RunAuto
  tStandbySL := ENO;
  MOVE 3 => HMI_Var.Mach1.Status EN split24 AND (Mach1.GenFlags.RunMan OR Mach1.GenFlags.RunAuto)
  tRunningSL := ENO;
END_NETWORK
NETWORK TITLE: "TODO NETWORK 50: SL Alarmlamp"
  split25 := TRUE;
  LST_InputsOutputs.Q100_2_Pilot_light_Alarm_red_ := split25 AND tAlarmlamp AND tAlarmSL;
  LST_InputsOutputs.Q100_1_Pilot_light_Alarm_orange_ := split25 AND tAlarmlamp AND tWarningSL;
  LST_InputsOutputs.Q100_0_Pilot_light_Alarm_green_ := split25 BRANCH (tAlarmlamp AND tStandbySL,
                                                                       tRunningSL) SHORTCIRCUIT;
END_NETWORK
NETWORK TITLE: "TODO NETWORK 51: SL Alarmlamp Buzzer"
END_NETWORK

END_PROGRAM
