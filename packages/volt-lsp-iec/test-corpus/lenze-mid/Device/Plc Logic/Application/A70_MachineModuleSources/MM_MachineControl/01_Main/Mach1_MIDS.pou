ASSIGN(Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.TrayfillerActive AND Trayfiller_Data.Alarms.AlmInpusherBlocked AND (Mach1_AuxData.AllDrivesHomed OR INVERT(Mach1_AuxData.MIDS_Active)), iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm059, ioAction := Mach1.GenFlags.MinorAlarm), Q_SET => Mach1.GenFlags.StopDriveDirect);
%NETWORK "DONE NETWORK 46 (p3): Alarms trayfiller"
ASSIGN(Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.TrayfillerActive AND (Trayfiller_Data.Alarms.AlmTrayPosition OR Trayfiller_Data.Alarms.AlmTrayInfeeding) AND Mach1_AuxData.AllDrivesHomed, iReset := TRUE, iAlm := Mach1_Alarms.Alm060, ioAction := Mach1.GenFlags.MinorAlarm), Q_SET => Mach1.GenFlags.StopDriveDirect);
%NETWORK "DONE NETWORK 46 (p4): Alarms trayfiller"
ASSIGN(Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.TrayfillerActive AND Trayfiller_Data.Alarms.AlmLightCurtainInpusher AND (Mach1_AuxData.AllDrivesHomed OR INVERT(Mach1_AuxData.MIDS_Active)), iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm061, ioAction := Mach1.GenFlags.MinorAlarm), Q_SET => Mach1.GenFlags.StopDriveDirect);
%NETWORK "DONE NETWORK 46 (p5): Alarms trayfiller"
Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.TrayfillerActive AND Trayfiller_Data.Alarms.WrnChangeTray AND (Mach1_AuxData.AllDrivesHomed OR INVERT(Mach1_AuxData.MIDS_Active)), iReset := TRUE, iAlm := Mach1_Alarms.Alm075, ioAction := Mach1.GenFlags.Warning);
%NETWORK "DONE NETWORK 46 (p6): Alarms trayfiller"
Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.TrayfillerActive AND Trayfiller_Data.Alarms.AlmOutfeedFull AND (Mach1_AuxData.AllDrivesHomed OR INVERT(Mach1_AuxData.MIDS_Active)), iReset := TRUE, iAlm := Mach1_Alarms.Alm062, ioAction := Mach1.GenFlags.MinorAlarm);
%NETWORK "DONE NETWORK 46 (p7): Alarms trayfiller"
Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.TrayfillerActive AND Trayfiller_Data.Alarms.AlmOutfeeding AND (Mach1_AuxData.AllDrivesHomed OR INVERT(Mach1_AuxData.MIDS_Active)), iReset := TRUE, iAlm := Mach1_Alarms.Alm063, ioAction := Mach1.GenFlags.MinorAlarm);
%NETWORK "DONE NETWORK 46 (p8): Alarms trayfiller"
ASSIGN(Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1_AuxData.TrayfillerActive AND Trayfiller_Data.Alarms.AlmLightCurtainElevator AND (Mach1_AuxData.AllDrivesHomed OR INVERT(Mach1_AuxData.MIDS_Active)), iReset := TRUE, iAlm := Mach1_Alarms.Alm064, ioAction := Mach1.GenFlags.MinorAlarm), Q_SET => Mach1.GenFlags.StopDriveDirect);
%NETWORK "DONE NETWORK 46 (p9): Alarms trayfiller"
ASSIGN(Mach1_AuxData.AllDrivesHomed AND Mach1_AuxData.TrayfillerActive AND INVERT(Trayfiller_Data.commInterface.Permission), Q_SET => Mach1.GenFlags.StopDriveDirect);
%NETWORK "TODO NETWORK 47 (p1):Greasing system"
%NETWORK "DONE NETWORK 47 (p2): Greasing system"
ASSIGN(Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1.GenFlags.DelayAfterEmergStop AND tLowLevel, iReset := TRUE, iAlm := Mach1_Alarms.Alm078, ioAction := Mach1.GenFlags.Warning), Q_SET => Mach1.GenFlags.StopDriveDirect);
%NETWORK "DONE NETWORK 48: Alarm: Greasing system"
ASSIGN(Alarms_V5_1_100(AlarmDB := Mach1_Alarms, iCond := Mach1.GenFlags.DelayAfterEmergStop AND tErrorRuntimeGreasingSystem, iReset := Mach1.GenFlags.StartFlag, iAlm := Mach1_Alarms.Alm067, ioAction := Mach1.GenFlags.MinorAlarm), Q_SET => Mach1.GenFlags.StopDriveDirect);
%NETWORK "DONE NETWORK 49: State of the machine"
VAR w27 : ANY; w28 : ANY; w29 : ANY; END_VAR
w27 := TRUE;
ASSIGN(MOVE(EN := w27 AND (Mach1.GenFlags.MajorAlarm OR Mach1.GenFlags.MinorAlarm), 0, OUT => HMI_Var.Mach1.Status), Q => tAlarmSL);
w28 := w27 AND INVERT(Mach1.GenFlags.MajorAlarm) AND INVERT(Mach1.GenFlags.MinorAlarm);
ASSIGN(MOVE(EN := w28 AND Mach1.GenFlags.Warning, 1, OUT => HMI_Var.Mach1.Status), Q => tWarningSL);
w29 := w28 AND INVERT(Mach1.GenFlags.Warning);
ASSIGN(MOVE(EN := w29 AND INVERT(Mach1.GenFlags.RunMan) AND INVERT(Mach1.GenFlags.RunAuto), 2, OUT => HMI_Var.Mach1.Status), Q => tStandbySL);
ASSIGN(MOVE(EN := w29 AND (Mach1.GenFlags.RunMan OR Mach1.GenFlags.RunAuto), 3, OUT => HMI_Var.Mach1.Status), Q => tRunningSL);
%NETWORK "TODO NETWORK 50: SL Alarmlamp"
VAR w30 : ANY; END_VAR
w30 := TRUE;
ASSIGN(w30 AND tAlarmlamp AND tAlarmSL, Q => LST_InputsOutputs.Q100_2_Pilot_light_Alarm_red_);
ASSIGN(w30 AND tAlarmlamp AND tWarningSL, Q => LST_InputsOutputs.Q100_1_Pilot_light_Alarm_orange_);
ASSIGN(BRANCH_SHORTCIRCUIT(FEED := w30, tAlarmlamp AND tStandbySL, tRunningSL), Q => LST_InputsOutputs.Q100_0_Pilot_light_Alarm_green_);
%NETWORK "TODO NETWORK 51: SL Alarmlamp Buzzer"

END_PROGRAM
