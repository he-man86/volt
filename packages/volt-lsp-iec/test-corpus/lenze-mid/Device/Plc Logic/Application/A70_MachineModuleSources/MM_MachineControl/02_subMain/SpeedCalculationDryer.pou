PROGRAM SpeedCalculationDryer
VAR_INPUT
END_VAR
VAR
	TempI: INT;
	cor_DenumI: INT:=1;
	cor_NumI: INT:=1;
	cor_DenumDI: DINT:=1;
	cor_NumDI: DINT:=1;
	Speed01rpm: INT;
	tSetHighSpeedCycles : BOOL;
	cor_Const: INT;
	R_TRIG_0: R_TRIG;
	MainDrive_AutoSpeed01rpm: INT;
	Mach_ActSpeed_Rpm01:INT;
	devAngle: INT;
	
	
END_VAR

%LANGUAGE LD
%NETWORK "NETWORK 1 : Speed control transport system dryer"
VAR_TEMP w1 : ANY; w2 : ANY; w3 : ANY; w4 : ANY; END_VAR
w1 := True;
MOVE(EN := w1, 0, OUT => TempI).ENO;
MUL(EN := w1, Mach1_Data.AUTOSPEED, 10, OUT => MainDrive_AutoSpeed01rpm).ENO;
MOVE(EN := w1, MainDrive_AutoSpeed01rpm, OUT => Droger_Data.Cor_denumerator).ENO;
w2 := w1 AND True;
MOVE(EN := MOVE(EN := Mach1_AuxData.IEC_TIMERS.TON_DelayIdling(IN := w2 AND NOT Mach1.GenFlags.DriveIsRunning, PT := T#500MS).Q AND NOT Mach1_Alarms.Alm049, MainDrive_AutoSpeed01rpm, OUT => Mach_ActSpeed_Rpm01).ENO, MainDrive_AutoSpeed01rpm, OUT => Droger_Data.Cor_numerator).ENO;
MOVE(EN := w2 AND (Mach1.GenFlags.DriveIsRunning OR NOT Mach1_AuxData.IEC_TIMERS.TON_DelayIdling.Q), MUL(HMI_Var.Mach1.ActualSpeed, 10), OUT => Mach_ActSpeed_Rpm01).ENO;
w3 := w2 AND True;
w4 := w3 AND Trayfiller_Data.commInterface.HoldFeedFwd;
MOVE(EN := (Mach1_AuxData.ADS_StopOnZeroPulse := w4 AND (LST_InputsOutputs.I133_1_PROX_zero_position_transport_ADS OR Mach1_AuxData.ADS_StopOnZeroPulse)), 750, OUT => Droger_Data.Cor_numerator).ENO;
MOVE(EN := Mach1_AuxData.Edge.Osr_SetCounter(CLK := w4 AND Trayfiller_Data.commInterface.Permission), 5, OUT => Mach1_AuxData.CounterHighSpeedATF_ADS).ENO;
MUL(EN := NE(EN := w3 AND Trayfiller_Data.commInterface.Permission, Mach1_AuxData.CounterHighSpeedATF_ADS, 0), Mach1_Data.AUTOSPEED, 13, OUT => Droger_Data.Cor_numerator).ENO;
EXECUTE(EN := w2, CODE := 'cor_NumDI:=Droger_Data.Cor_numerator;
cor_DenumDI:=Droger_Data.Cor_denumerator;
//cor_NumDI:=1;
//cor_DenumDI:=1;
HMI_Var.Mach1.ActualSpeedDryer:=(Mach_ActSpeed_Rpm01*cor_numDI)/cor_denumdi;
Mach1_Data.Drives.FeedForwardADS.Control.AutoSpeed:=REAL_TO_INT(0.9*dint_to_real(HMI_Var.Mach1.ActualSpeedDryer)*6/10);

');
%NETWORK "NETWORK 2: Deviation calculation of sync point, transport system trayfiller"
VAR_TEMP w5 : ANY; END_VAR
// Principle: It's better to accelerate the drive then to decelerate, because otherwise cigars could be missed. 
// So that is why the deceleration should be kept short, by trial and error the optimum point is 60degrees (difference between setpoint and actual point).
// dev: [0-60]: dec.
// dev: ]60-360]: acc.
//
// Numerator = (Act_syncpos -/- Gew_syncpos) + Cte
// Cte=little bit slower then the value for the set speed. (If the mid-s rotates 100rpm (value=1000), then this value should be a little less (e.g 99,8rpm).
//         This way, the system lags a little bit, and therefor needs to accelerate (which is beter). If the system leads, then it needs to decel. (which is not ideal)
//
// Uit metingen is gebleken dat de optimale synchronisatiepositie op 60 graden 
// ligt.
//
// correctie  -60     0     60     120    180    240    300
//             |------|------|------|------|------|------|--
// encoder     0     60     120    180    240    300    360
//
// Om de ingestelde synchronisatiepositie te verschuiven naar het optimale window 
// van -60..300 wordt de correctiefactor gecorrigeerd:
//  - indien correctie < -60 dan 360 erbij optellen
//  - indien correctie > 300 dan 360 eraf tellen
w5 := ADD(EN := SUB(EN := SUB(EN := Mach1.GenFlags.DriveIsRunning, Droger_Data.Act_sync_pos, Droger_Data.set_sync_pos, OUT => devAngle).ENO, MainDrive_AutoSpeed01rpm, 2, OUT => cor_Const).ENO, devAngle, cor_Const, OUT => Droger_Data.Cor_numerator).ENO;
ADD(EN := LT(EN := w5, devAngle, -60), Droger_Data.Cor_numerator, 360, OUT => Droger_Data.Cor_numerator).ENO;
SUB(EN := GT(EN := w5, devAngle, 300), Droger_Data.Cor_numerator, 360, OUT => Droger_Data.Cor_numerator).ENO;
%NETWORK
VAR_TEMP w6 : ANY; END_VAR
w6 := R_TRIG_0(CLK := LST_InputsOutputs.I133_1_PROX_zero_position_transport_ADS);
MOVE(EN := w6, HMI_Var.Mach1.Position, OUT => Droger_Data.Act_sync_pos).ENO;
MOVE(EN := w6, Mach1_Data.CamControls.FeedforwardDryer_CP.Start, OUT => Droger_Data.set_sync_pos).ENO;
SUB(EN := GT(EN := w6, Mach1_AuxData.CounterHighSpeedATF_ADS, 0), Mach1_AuxData.CounterHighSpeedATF_ADS, 1, OUT => Mach1_AuxData.CounterHighSpeedATF_ADS).ENO;

END_PROGRAM
