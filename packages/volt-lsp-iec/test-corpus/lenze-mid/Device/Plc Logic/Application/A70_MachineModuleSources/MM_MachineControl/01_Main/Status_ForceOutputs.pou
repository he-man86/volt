PROGRAM Status_ForceOutputs
VAR
END_VAR

IMPLEMENTATION LD
NETWORK
  split9 := TRUE;
  MOVE %IB26 => LST_InputsOutputs.Serv_IB100 EN split9;
  MOVE %IB27 => LST_InputsOutputs.Serv_IB101 EN split9;
END_NETWORK
NETWORK
  split13 := TRUE;
  MOVE %IB370 => LST_InputsOutputs.Serv_IB132 EN split13;
  MOVE %IB371 => LST_InputsOutputs.Serv_IB133 EN split13;
  MOVE %IB372 => LST_InputsOutputs.Serv_IB136 EN split13;
  MOVE %IB373 => LST_InputsOutputs.Serv_IB137 EN split13;
END_NETWORK
NETWORK
  ForceOutput() EN HMI_Var.ForceOutputs;
END_NETWORK
NETWORK
  ForceOutput_1() EN NOT HMI_Var.ForceOutputs;
END_NETWORK
NETWORK
END_NETWORK

END_PROGRAM
