PROGRAM Status_ForceOutputs
VAR
END_VAR

%LANGUAGE LD
%NETWORK
%WIRES w1
w1 := TRUE;
MOVE(EN := w1, %IB26, OUT => LST_InputsOutputs.Serv_IB100).ENO;
MOVE(EN := w1, %IB27, OUT => LST_InputsOutputs.Serv_IB101).ENO;
%NETWORK
%WIRES w2
w2 := TRUE;
MOVE(EN := w2, %IB370, OUT => LST_InputsOutputs.Serv_IB132).ENO;
MOVE(EN := w2, %IB371, OUT => LST_InputsOutputs.Serv_IB133).ENO;
MOVE(EN := w2, %IB372, OUT => LST_InputsOutputs.Serv_IB136).ENO;
MOVE(EN := w2, %IB373, OUT => LST_InputsOutputs.Serv_IB137).ENO;
%NETWORK
ForceOutput(EN := HMI_Var.ForceOutputs).ENO;
%NETWORK
ForceOutput_1(EN := NOT HMI_Var.ForceOutputs).ENO;
%NETWORK

END_PROGRAM
