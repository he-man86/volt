PROGRAM Status_ForceOutputs
VAR
END_VAR

%LANGUAGE LD
%NETWORK
%WIRES w1
w1 := TRUE;
MOVE_EN(EN := w1, %IB26, OUT => LST_InputsOutputs.Serv_IB100);
MOVE_EN(EN := w1, %IB27, OUT => LST_InputsOutputs.Serv_IB101);
%NETWORK
%WIRES w2
w2 := TRUE;
MOVE_EN(EN := w2, %IB370, OUT => LST_InputsOutputs.Serv_IB132);
MOVE_EN(EN := w2, %IB371, OUT => LST_InputsOutputs.Serv_IB133);
MOVE_EN(EN := w2, %IB372, OUT => LST_InputsOutputs.Serv_IB136);
MOVE_EN(EN := w2, %IB373, OUT => LST_InputsOutputs.Serv_IB137);
%NETWORK
ForceOutput_EN(EN := HMI_Var.ForceOutputs);
%NETWORK
ForceOutput_1_EN(EN := NOT HMI_Var.ForceOutputs);
%NETWORK

END_PROGRAM
