PROGRAM Status_ForceOutputs
VAR
END_VAR

IMPLEMENTATION LD
NETWORK
  split9 := TRUE;
  MOVE %IB26 => LST_InputsOutputs.Serv_IB100 ENO EN split9;
  MOVE %IB27 => LST_InputsOutputs.Serv_IB101 ENO EN split9;
END_NETWORK
NETWORK
  split13 := TRUE;
  MOVE %IB370 => LST_InputsOutputs.Serv_IB132 ENO EN split13;
  MOVE %IB371 => LST_InputsOutputs.Serv_IB133 ENO EN split13;
  MOVE %IB372 => LST_InputsOutputs.Serv_IB136 ENO EN split13;
  MOVE %IB373 => LST_InputsOutputs.Serv_IB137 ENO EN split13;
END_NETWORK
NETWORK
  ForceOutput() ENO EN HMI_Var.ForceOutputs;
END_NETWORK
NETWORK
  ForceOutput_1() ENO EN NOT HMI_Var.ForceOutputs;
END_NETWORK
NETWORK
END_NETWORK

END_PROGRAM
