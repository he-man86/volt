PROGRAM Status_ForceOutputs
VAR
END_VAR

%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
w1 := TRUE;
MOVE(EN := w1, %IB26, OUT => LST_InputsOutputs.Serv_IB100);
MOVE(EN := w1, %IB27, OUT => LST_InputsOutputs.Serv_IB101);
%NETWORK
VAR w2 : ANY; END_VAR
w2 := TRUE;
MOVE(EN := w2, %IB370, OUT => LST_InputsOutputs.Serv_IB132);
MOVE(EN := w2, %IB371, OUT => LST_InputsOutputs.Serv_IB133);
MOVE(EN := w2, %IB372, OUT => LST_InputsOutputs.Serv_IB136);
MOVE(EN := w2, %IB373, OUT => LST_InputsOutputs.Serv_IB137);
%NETWORK
ForceOutput(EN := HMI_Var.ForceOutputs);
%NETWORK
ForceOutput_1(EN := INVERT(HMI_Var.ForceOutputs));
%NETWORK

END_PROGRAM
