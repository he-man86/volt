PROGRAM SideCorrection
VAR_INPUT
END_VAR
VAR
	tCorrectionScale			: DINT;
	tCorrectionScaleReal		: REAL;
	tReal						: REAL;
	tDint						: DINT;
	tInt						: INT;

	tbool: BOOL;
END_VAR

%LANGUAGE LD
%NETWORK "Network 1: Averaging of sensorsignal"
fc_MeanValue(EN := RAIL(), iLength := 20, iAcquireNewValue := True, iNewValue := OPERAND('TO_INT(LST_InputsOutputs.IW340_LeafCoverageSensor)'), ioValues := db_MeanValuesSideCorrectionSensor.MeasurementValues, oMeanValue => DB_Kantcorrectie.MeasuredValue);
%NETWORK
VAR w1 : ANY; END_VAR
w1 := TRUE;
ASSIGN(MOVE(EN := w1 AND DB_Kantcorrectie.CopyMeasuredToDark, DB_Kantcorrectie.MeasuredValue, OUT => DB_Kantcorrectie.DarkValue), Q_RESET => DB_Kantcorrectie.CopyMeasuredToDark);
ASSIGN(MOVE(EN := w1 AND DB_Kantcorrectie.CopyMeasuredToLight, DB_Kantcorrectie.MeasuredValue, OUT => DB_Kantcorrectie.LightValue), Q_RESET => DB_Kantcorrectie.CopyMeasuredToLight);
%NETWORK "Network 2: Read out inputvalue and calculate correctionvalue"
MOVE(EN := SidecorrectionCalculation(EN := MOVE(EN := TRUE, Mach1_Data.Settings.Ints.SideCorrectionScaleFactor, OUT => tCorrectionScale), iAnalogInputValue := DB_Kantcorrectie.MeasuredValue, iSetpoint := DB_Kantcorrectie.Setpoint, iCorrectionScale := -1, iLightValue := DB_Kantcorrectie.LightValue, iDarkValue := DB_Kantcorrectie.DarkValue, iNoWrapperOffsetPercentage01Perc := DB_Kantcorrectie.NoWrapperPercentage, oIntPercentage => DB_Kantcorrectie.Percentage10, oCorrectionValue => DB_Kantcorrectie.MeasuredValueReal, oDeviationNoWrapper => tReal), OPERAND('REAL_TO_INT(tReal)'), OUT => DB_Kantcorrectie.DeviationNoWrapper);
%NETWORK "Network 3: Determine side-correction value"
VAR w2 : ANY; w3 : ANY; END_VAR
w2 := fc_CamC_CP_UDT(iEN := RAIL(), iMachinePosition := HMI_Var.Mach1.Position, iResetFlag := Mach1.GenFlags.Rotflag, ioPulse := Mach1_Data.CamControls.MeasurementForSidecorrection_CP);
MOVE(EN := MOVE(EN := w2 AND Mach1_Data.Drives.SideCorrection_FreeLimit.Status.Limit_Left_OK AND Mach1_Data.Drives.SideCorrection_FreeLimit.Status.Limit_right_OK, DB_Kantcorrectie.MeasuredValueReal, OUT => DB_Kantcorrectie.CopiedValueReal), DB_Kantcorrectie.Percentage10, OUT => DB_Kantcorrectie.CopiedValueInt);
w3 := w2 AND Mach1_AuxData.MemWrapperDetected_ResetLimitedSpeed;
ASSIGN(w3, Q_RESET => Mach1_AuxData.MemLowerSpeedBecauseOfNoWrapper);
ASSIGN(w3, Q_RESET => Mach1_AuxData.MemWrapperDetected_ResetLimitedSpeed);
ASSIGN(GT(EN := SUB(EN := w2, DB_Kantcorrectie.LightValue, DB_Kantcorrectie.DeviationNoWrapper, OUT => DB_Kantcorrectie.NoWrapperValue), LST_InputsOutputs.IW340_LeafCoverageSensor, DB_Kantcorrectie.NoWrapperValue).OUT AND HMI_Var.Test_Prod, Q_SET => Mach1_AuxData.MemLowerSpeedBecauseOfNoWrapper);
%NETWORK "DONE Network 4: In case a limit switch is reached: overwrite values"
VAR w4 : ANY; END_VAR
w4 := True;
MOVE(EN := w4 AND INVERT(Mach1_Data.Drives.SideCorrection_FreeLimit.Status.Limit_Left_OK) AND Mach1_Data.Drives.SideCorrection_FreeLimit.Status.Limit_Right_OK, -100.0, OUT => DB_Kantcorrectie.CopiedValueReal);
MOVE(EN := MOVE(EN := w4 AND INVERT(Mach1_Data.Drives.SideCorrection_FreeLimit.Status.Limit_Right_OK) AND Mach1_Data.Drives.SideCorrection_FreeLimit.Status.Limit_Left_OK, 100.0, OUT => DB_Kantcorrectie.CopiedValueReal), -1, OUT => tCorrectionScale);
MOVE(EN := MOVE(EN := w4 AND (INVERT(Mach1_Data.Drives.SideCorrection_FreeLimit.Status.Limit_Left_OK) AND INVERT(Mach1_Data.Drives.SideCorrection_FreeLimit.Status.Limit_Right_OK) OR INVERT(HMI_Var.Test_Prod) OR Mach1_AuxData.MemLowerSpeedBecauseOfNoWrapper), 0.0, OUT => DB_Kantcorrectie.CopiedValueReal), 1, OUT => tCorrectionScale);
%NETWORK "DONE Network 5: Write side-correction values to the servo drive"
EXECUTE(EN := RAIL(), 'tReal:=DB_Kantcorrectie.CopiedValueReal*DINT_TO_REAL(tCorrectionScale);
Mach1_Data.Drives.SideCorrection.CAM.Y_Scale_Recipe:=REAL_TO_INT(tReal/(-1000));
');
%NETWORK "DONE Network 6 : Manual adjustment of the sidecorrection"
VAR w5 : ANY; END_VAR
w5 := True;
ASSIGN(w5 AND Mach1_Data.Drives.SideCorrection_FreeLimit.Status.Limit_Left_OK AND HMI_Var.Mach1.DTA_PositioningLeft, Q => Mach1_Data.Drives.SideCorrection_FreeLimit.Control.Jog_LimitToLeft);
ASSIGN(w5 AND Mach1_Data.Drives.SideCorrection_FreeLimit.Status.Limit_Right_OK AND HMI_Var.Mach1.DTA_PositioningRight, Q => Mach1_Data.Drives.SideCorrection_FreeLimit.Control.Jog_LimitToRight);

END_PROGRAM
