INTERFACE IPROXYMONITOR
END_INTERFACE

METHOD GETALARMCLASSESDESCRIPTION
VAR_INPUT
	PCLDESC : POINTER TO ARRAY [0..0] OF ProxyStructMonitorAlarmClassDesc;
	ISIZE : INT;
END_VAR
VAR_OUTPUT
	ICLCNT : INT;
END_VAR
END_METHOD

METHOD GETALARMGROUPSDESCRIPTION
VAR_INPUT
	PGRPDESC : POINTER TO ARRAY [0..0] OF ProxyStructMonitorAlarmGroupDesc;
	ISIZE : INT;
END_VAR
VAR_OUTPUT
	IGRPCNT : INT;
END_VAR
END_METHOD

METHOD GETALARMSDESCRIPTION
VAR_INPUT
	PALMDESC : POINTER TO ARRAY [0..0] OF ProxyStructMonitorAlarmDesc;
	DISIZE : DINT;
END_VAR
VAR_OUTPUT
	DIALMCNT : DINT;
END_VAR
END_METHOD

METHOD GETSTATISTICS : ProxyStructMonitor
VAR_INPUT
	IRECORD : INT;
END_VAR
END_METHOD

METHOD GETSTATISTICSSINGLEREQ : ProxyStructMonitorRequest
VAR_INPUT
	ITASKID : INT;
END_VAR
END_METHOD