FUNCTION_BLOCK L_MC1P_PARSIMWRITE EXTENDS L_MC1P_ParSim
VAR_INPUT
	XEXECUTE : BOOL;
	WINDEX : WORD;
	BYSUBINDEX : BYTE;
	PBUFFER : POINTER TO BYTE;
	SZSIZE : CAA_SIZE;
	UDITIMEOUT : UDINT;
	PPARAMDATA : POINTER TO L_MC1P_ParameterDataSim;
	WPARAMCOUNT : WORD;
	XSLOTB : BOOL;
	LRDELAY : LREAL := 0.01;
	LRTASKCYCLE : LREAL;
END_VAR
VAR_OUTPUT
	XBUSY : BOOL;
	XDONE : BOOL;
	XERROR : BOOL;
	EERRORCODE : WORD;
END_VAR
VAR
	XEXECUTEOLD : BOOL;
	XRESETOUTPUT : BOOL;
	IDX : WORD;
	XFOUND : BOOL;
	LRWAITCOUNTER : LREAL;
	PTEMPVALUE : POINTER TO L_UBUP_VarValue;
	TEMPVALUEDEST : L_UBUP_VarValue;
	WSEARCHINDEX : WORD := 0;
END_VAR
END_FUNCTION_BLOCK

METHOD SETVALUE : L_UBUP_VarValue
VAR_INPUT
	PSRCVALUE : POINTER TO L_UBUP_VarValue;
	PDESTVALUE : POINTER TO L_UBUP_VarValue;
	EFIXTOLREAL : L_MC1P_ScaleFixToLREAL;
	BYNROFBYTE : BYTE;
END_VAR
VAR_OUTPUT
	EERRORCODE : WORD;
END_VAR
END_METHOD