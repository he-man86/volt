	SZSIZE : FILE.CAA.SIZE;
	XDONEREADFILE : BOOL;
	XBUSYREADFILE : BOOL;
	XERRORREADFILE : BOOL;
	EREADFILEERROR : FILE.ERROR;
	XDONECLOSEFILE : BOOL;
	XBUSYCLOSEFILE : BOOL;
	XERRORCLOSEFILE : BOOL;
	ECLOSEFILEERROR : FILE.ERROR;
	XDONEFINDERROR : BOOL;
	XBUSYFINDERROR : BOOL;
