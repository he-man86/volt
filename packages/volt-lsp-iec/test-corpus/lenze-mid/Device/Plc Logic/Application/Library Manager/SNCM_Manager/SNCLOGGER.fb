FUNCTION_BLOCK SNCLOGGER
VAR_INPUT
	_SZCMPNAME : STRING;
	_UDICMPID : UDINT;
	_UDICMPVERSION : UDINT;
END_VAR
VAR
	_HCMP : RTS_IEC_HANDLE;
	_HLOGGER : RTS_IEC_HANDLE := RTS_INVALID_HANDLE;
	_RTSRESULT : RTS_IEC_RESULT;
	_XWASINITIALIZED : BOOL := FALSE;
	WASINITIALIZED : BOOL;
END_VAR
END_FUNCTION_BLOCK

METHOD ADDLOGENTRY : BOOL
VAR_INPUT
	UDICLASSID : UDINT;
	UDIERRORID : UDINT;
	UDIINFOID : UDINT;
	SZTEXT : STRING;
END_VAR
END_METHOD

METHOD ADDLOGENTRYWITHADDRESS : BOOL
VAR_INPUT
	UDICLASSID : UDINT;
	UDIERRORID : UDINT;
	UDIINFOID : UDINT;
	EFSPSBUSID : FSPSBUSDRV;
	SZFSPSDEVADDRESS : STRING;
	SZTEXT : STRING;
END_VAR
END_METHOD

METHOD ADDLOGENTRYWITHBUSID
VAR_INPUT
	UDICLASSID : UDINT;
	UDIERRORID : UDINT;
	UDIINFOID : UDINT;
	EFSPSBUSID : FSPSBUSDRV;
	SZTEXT : STRING;
END_VAR
VAR_OUTPUT
	ADDLOGENTRYWITHADDRESS : BOOL;
END_VAR
END_METHOD

METHOD FB_EXIT : BOOL
VAR_INPUT
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD FB_INIT : BOOL
VAR_INPUT
	BINITRETAINS : BOOL;
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD