	XEXECUTE : BOOL;
	DTDATEANDTIME : DATE_AND_TIME;
END_VAR
VAR_OUTPUT
	XDONE : BOOL;
	XBUSY : BOOL;
	XERROR : BOOL;
	EERROR : ERROR;
END_VAR
VAR
	XPREVIOUSEXECUTE : BOOL;
	XPREVIOUSABORTINPROGRESS : BOOL;
	XABORTINPROGRESS : BOOL;
	IERROR : INT;
	HJOB : CAA.HANDLE;
	PSETDATEANDTIMEPARAMS : POINTER TO RTCLK_SETDATEANDTIME_PARAMS;
	STATEJOB : ASM.STATE;
	DWETRIGCLASS : __XWORD;
END_VAR
END_FUNCTION_BLOCK