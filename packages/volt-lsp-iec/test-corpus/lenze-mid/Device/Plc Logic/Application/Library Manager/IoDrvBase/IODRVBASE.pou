FUNCTION_BLOCK IODRVBASE
VAR
	M_ICOUNT : DINT;
	M_HINTERFACE : RTS_IEC_HANDLE;
	M_IBASEITF : IBase;
	M_INFO : IoDrvInfo;
	M_WMODULETYPE : UINT;
	M_DWINSTANCE : UDINT;
	M_PCONNECTOR : POINTER TO IoConfigConnector;
	FB_INIT_COUNT : DINT;
	INITIALIZE_COUNT : DINT;
	FB_EXIT_COUNT : DINT;
	FB_REINIT_COUNT : DINT;
	ADDREF_COUNT : DINT;
	RELEASE_COUNT : DINT;
	QUERYINTERFACE_COUNT : DINT;
	IODRVIDENTIFY_COUNT : DINT;
	IODRVGETINFO_COUNT : DINT;
	IODRVGETMODULEDIAGNOSIS_COUNT : DINT;
	IODRVREADINPUTS_COUNT : DINT;
	IODRVSCANMODULES_COUNT : DINT;
	IODRVSTARTBUSCYCLE_COUNT : DINT;
	IODRVUPDATECONFIGURATION_COUNT : DINT;
	IODRVUPDATEMAPPING_COUNT : DINT;
	IODRVWRITEOUTPUTS_COUNT : DINT;
	IODRVWATCHDOGTRIGGER_COUNT : DINT;
END_VAR
END_FUNCTION_BLOCK

METHOD INITIALIZE : UDINT
VAR_INPUT
	WMODULETYPE : UINT;
	DWINSTANCE : UDINT;
	PCONNECTOR : POINTER TO IoConfigConnector;
END_VAR
END_METHOD

METHOD FB_EXIT : BOOL
VAR_INPUT
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD RELEASE : DINT
END_METHOD

METHOD FB_REINIT : BOOL
END_METHOD

METHOD ADDREF : DINT
END_METHOD

METHOD QUERYINTERFACE : POINTER TO POINTER TO BYTE
VAR_INPUT
	IID : DWORD;
	PRESULT : POINTER TO UDINT;
END_VAR
END_METHOD

METHOD FB_INIT : BOOL
VAR_INPUT
	BINITRETAINS : BOOL;
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD STRLEN : DINT
VAR_INPUT
	PSTRING : POINTER TO STRING;
END_VAR
END_METHOD

METHOD MEMCPY : DWORD
VAR_INPUT
	PBYDEST : POINTER TO BYTE;
	PBYSRC : POINTER TO BYTE;
	DWSIZE : DWORD;
END_VAR
END_METHOD

METHOD IODRVGETMODULEDIAGNOSIS : UDINT
VAR_INPUT
	PCONNECTOR : POINTER TO IoConfigConnector;
END_VAR
END_METHOD

METHOD IODRVSTARTBUSCYCLE : UDINT
VAR_INPUT
	PCONNECTOR : POINTER TO IoConfigConnector;
END_VAR
END_METHOD

METHOD IODRVUPDATECONFIGURATION : UDINT
VAR_INPUT
	PCONNECTORLIST : POINTER TO IoConfigConnector;
	NCOUNT : DINT;
END_VAR
END_METHOD

METHOD IODRVGETINFO : UDINT
VAR_INPUT
	PPINFO : POINTER TO POINTER TO IoDrvInfo;
END_VAR
END_METHOD

METHOD IODRVIDENTIFY : UDINT
VAR_INPUT
	PCONNECTOR : POINTER TO IoConfigConnector;
END_VAR
END_METHOD

METHOD IODRVSCANMODULES : UDINT
VAR_INPUT
	PCONNECTOR : POINTER TO IoConfigConnector;
	PPCONNECTORLIST : POINTER TO POINTER TO IoConfigConnector;
	PNCOUNT : POINTER TO DINT;
END_VAR
END_METHOD

METHOD IODRVREADINPUTS : UDINT
VAR_INPUT
	PCONNECTORMAPLIST : POINTER TO IoConfigConnectorMap;
	NCOUNT : DINT;
END_VAR
END_METHOD

METHOD IODRVUPDATEMAPPING : UDINT
VAR_INPUT
	PTASKMAPLIST : POINTER TO IoConfigTaskMap;
	NCOUNT : DINT;
END_VAR
END_METHOD

METHOD IODRVWRITEOUTPUTS : UDINT
VAR_INPUT
	PCONNECTORMAPLIST : POINTER TO IoConfigConnectorMap;
	NCOUNT : DINT;
END_VAR
END_METHOD

METHOD IODRVWATCHDOGTRIGGER : UDINT
VAR_INPUT
	PCONNECTOR : POINTER TO IoConfigConnector;
END_VAR
END_METHOD