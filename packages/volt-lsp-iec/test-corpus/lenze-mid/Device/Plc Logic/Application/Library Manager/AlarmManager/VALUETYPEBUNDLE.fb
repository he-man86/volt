	M_ISTRINGSIZE : INT;
	M_PSSTRING : POINTER TO STRING(255);
	M_PWSSTRING : POINTER TO WSTRING(255);
END_VAR
END_FUNCTION_BLOCK

METHOD GETSIZE : INT
END_METHOD

METHOD GETTYPE : __SYSTEM.TYPE_CLASS
END_METHOD

METHOD GETVALUE : POINTER TO BYTE
END_METHOD

METHOD SETRAWVALUE
