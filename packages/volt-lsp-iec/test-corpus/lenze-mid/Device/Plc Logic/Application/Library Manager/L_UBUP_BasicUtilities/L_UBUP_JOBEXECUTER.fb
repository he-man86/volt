FUNCTION_BLOCK L_UBUP_JOBEXECUTER EXTENDS L_UBUP_MemoryProvider
VAR_INPUT
	XFINISH : BOOL;
	XABORT : BOOL;
	XCLEAR : BOOL;
END_VAR
VAR
	_ALISTNODES : ARRAY [1..20] OF L_UBUP_ListNode;
	_AJOBS : ARRAY [1..20] OF L_UBUP_IJob;
	_JOBLISTCONTROL : L_UBUP_DoubleLinkedListControl;
	_DWARRIDX : DWORD;
	_EACTUALSTATE : L_UBUP_JobState;
	_EERRORID : L_IE1P_Error;
	_XFINISH_TRIG : R_Trig;
	_XABORT_TRIG : R_Trig;
	_XCLEAR_TRIG : R_Trig;
	ITFERRORHANDLER : __SYSTEM.IQueryInterface;
	ITFITERATOR : L_UBUP_IIterator;
	ITFLISTCONTROL : L_UBUP_IListControl;
	ITFLISTITEMS : L_UBUP_IListItems;
	ITFUSERDEFINED : __SYSTEM.IQueryInterface;
	PTR : POINTER TO BYTE;
	SIZE : UDINT;
END_VAR
END_FUNCTION_BLOCK

METHOD GETJOB : BOOL
VAR_INPUT
	DWARRIDX : DWORD;
END_VAR
VAR_OUTPUT
	ITFJOB : L_UBUP_IJob;
END_VAR
END_METHOD

METHOD APPEND : BOOL
VAR_INPUT
	ITFJOB : L_UBUP_IJob;
END_VAR
END_METHOD

METHOD FB_INIT : BOOL
VAR_INPUT
	BINITRETAINS : BOOL;
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD