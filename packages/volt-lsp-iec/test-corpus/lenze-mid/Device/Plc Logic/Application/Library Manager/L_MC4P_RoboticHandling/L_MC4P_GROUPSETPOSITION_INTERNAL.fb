FUNCTION_BLOCK L_MC4P_GROUPSETPOSITION_INTERNAL EXTENDS L_UBUP_Instance
VAR_INPUT
	EXECUTE : BOOL;
	RELATIVE : BOOL := FALSE;
END_VAR
VAR_OUTPUT
	DONE : BOOL;
	BUSY : BOOL;
	ACTIVE : BOOL;
	ERROR : BOOL;
	ERRORID : L_IE1P_Error;
END_VAR
VAR
	COORDSYSTEM : L_MC4P_CoordSystem := L_MC4P_CoordSystem.ACS;
	XRESETOUTPUT : BOOL;
	AMC_SETPOSITION : ARRAY [1..12] OF L_MC1P.MC_SetPosition;
	IDX : WORD;
	XEXECUTEOLD : BOOL;
	CLASSID : L_UBUP_ClassID;
END_VAR
END_FUNCTION_BLOCK

METHOD MAIN
VAR_IN_OUT
	AXESGROUP : AXES_GROUP_KIN;
	FBBASE : L_MC4P_Template_AG_KIN;
	POSITION : ARRAY [1..12] OF LREAL;
END_VAR
END_METHOD