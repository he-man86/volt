FUNCTION_BLOCK SNCSERVICEPROVIDERBASE
VAR
	_XWASINITIALIZED : BOOL := FALSE;
	_SNCSRVHANDLER : SncServiceHandler;
	_FIRST : ISncDeviceDriver;
	_LAST : ISncDeviceDriver;
	WASINITIALIZED : BOOL;
END_VAR
END_FUNCTION_BLOCK

METHOD GETDEVICEDRIVER : ISncDeviceDriver
VAR_INPUT
	EFSPSBUSID : FSPSBUSDRV;
	SZFSPSDEVADDRESS : STRING;
END_VAR
END_METHOD

METHOD GETDEVICESPECIFICDATAHANDLER : IBusSpecificDataHandler
VAR_INPUT
	EFSPSBUSID : FSPSBUSDRV;
	SZFSPSDEVADDRESS : STRING;
END_VAR
END_METHOD

METHOD INITIALIZE : ERROR
END_METHOD

METHOD REGISTER : ERROR
VAR_INPUT
	SNCFSPSDEVDRIVER : ISncDeviceDriver;
END_VAR
END_METHOD

METHOD UNREGISTER : ERROR
VAR_INPUT
	SNCFSPSDEVDRIVER : ISncDeviceDriver;
END_VAR
END_METHOD