	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
END_VAR
VAR
	XEXECUTEOLD : BOOL;
	XRESETOUTPUT : BOOL;
	ISTATE : INT;
	WRITEPARAMETER : L_DCO_WriteDriveParameter;
	PAXISREAL : POINTER TO _AXIS_REF_REAL;
	PWDUMMY : POINTER TO WORD;
	_MCCALL : L_UM1P_MCMultipleCall;
	INPUTDATA : ARRAY [1.._MCCall.c_BufferDepthInput] OF L_MC1P_SetQuickStopOptionInput;
	OUTPUTDATA : ARRAY [1.._MCCall.c_BufferDepthOutput] OF L_MC1P_SetQuickStopOptionOutput;
END_VAR
END_FUNCTION_BLOCK

