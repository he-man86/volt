	ASCHOMEEXTTP : ARRAY [1..12] OF MC_TRIGGER_REF;
	AXJOGPOS : ARRAY [1..12] OF BOOL;
	AXJOGNEG : ARRAY [1..12] OF BOOL;
	AXMOVEABS : ARRAY [1..12] OF BOOL;
	AXMOVEREL : ARRAY [1..12] OF BOOL;
	ASCCTRLABC : ARRAY [1..18] OF L_MC1P_CtrlABC;
