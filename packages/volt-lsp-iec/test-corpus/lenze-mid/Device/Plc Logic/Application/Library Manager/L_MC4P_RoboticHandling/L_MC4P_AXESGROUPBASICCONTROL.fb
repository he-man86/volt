FUNCTION_BLOCK L_MC4P_AXESGROUPBASICCONTROL EXTENDS L_MC4P_Template_AG_KIN_Licence
VAR_INPUT
	XENABLEINTERNALCONTROL : BOOL;
	XRESETAXESGROUP : BOOL;
	XREGULATORONALL : BOOL;
	XENABLEAXESGROUP : BOOL;
	LROVERRIDE : LREAL := 1;
	XSTOPALL : BOOL;
	SCPAR : L_MC4P_AGBC_Parameter;
