FUNCTION_BLOCK L_UBUP_INSTANCE
VAR
	_ITFOWNER : L_UBUP_IFBPool;
	_XWHANDLE : __XWORD;
	_XOCCUPIED : BOOL;
	CLASSID : L_UBUP_ClassID;
	INSTANCEPTR : POINTER TO BYTE;
	OCCUPIED : BOOL;
END_VAR
END_FUNCTION_BLOCK

METHOD FREE : BOOL
END_METHOD

METHOD OCCUPY : BOOL
