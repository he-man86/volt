INTERFACE IDATASOURCEDRIVER
END_INTERFACE

METHOD CONNECTING : UDINT
END_METHOD

METHOD GETREQUESTRESULT : DataSourceTransactionResult
VAR_INPUT
	DWTRANSACTIONID : DWORD;
END_VAR
END_METHOD

METHOD GETSETTING : DWORD
VAR_INPUT
	DWSETTINGTAG : DWORD;
END_VAR
VAR_OUTPUT
	BUSEDEFAULT : BOOL;
END_VAR
END_METHOD

METHOD INITIALIZE : UDINT
VAR_INPUT
	STDATASOURCE : STRING;
	PINITINFO : POINTER TO DriverInitInfo;
	PINITDATA : POINTER TO BYTE;
END_VAR
END_METHOD

METHOD READREQUEST : UDINT
VAR_INPUT
	PITEMS : POINTER TO ARRAY [0..100] OF IDataItem;
	IITEMCOUNT : UDINT;
	DWLISTID : DWORD;
END_VAR
VAR_OUTPUT
	DWTRANSACTIONID : DWORD;
END_VAR
END_METHOD

METHOD RESET : UDINT
END_METHOD

METHOD SHUTTINGDOWN : UDINT
END_METHOD

METHOD STARTCONNECT : UDINT
END_METHOD

METHOD STARTSHUTDOWN : UDINT
END_METHOD

METHOD UPDATEREQUEST : UDINT
VAR_INPUT
	PITEMS : POINTER TO ARRAY [0..100] OF IDataItem;
	IITEMCOUNT : UDINT;
	DWLISTID : DWORD;
	DWTRANSACTIONID : DWORD;
END_VAR
END_METHOD

METHOD WRITEREQUEST : UDINT
VAR_INPUT
	PITEMS : POINTER TO ARRAY [0..100] OF IDataItem;
	IITEMCOUNT : UDINT;
	DWLISTID : DWORD;
END_VAR
VAR_OUTPUT
	DWTRANSACTIONID : DWORD;
END_VAR
END_METHOD