TYPE SCSTATUS_AGBC :
STRUCT
	XINTERNALCONTROLACTIVE : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	XFUNBUSY : BOOL;
	XFUNDONE : BOOL;
	XFUNCOMMANDABORTED : BOOL;
	EFUNSTATEACT : L_MC4P_AGBC_State := L_MC4P_AGBC_State.Standby;
	XAXESGROUPHOMED : BOOL;
	XHWLIMITSWITCHANY : BOOL;
	XSWLIMITENABLEDALL : BOOL;
	XSWLIMITSWITCHANY : BOOL;
	EKINEMATICTYPE : L_MC4P_KinematicType;
	EAXESGROUPSTATE : L_MC4P_AxesGroup_State;
	XAXESGROUPENABLED : BOOL;
	XREALAXESREADYALL : BOOL;
	XREALAXESENABLEDALL : BOOL;
	XINPOSITION : BOOL;
	XAXESGROUPWARNING : BOOL;
	XAXESGROUPERROR : BOOL;
	EAXESGROUPERRORID : L_IE1P_Error;
	ALRACTPOS : ARRAY [1..12] OF LREAL;
	ALRACTVEL : ARRAY [1..12] OF LREAL;
	ALRSETPOSOUT : ARRAY [1..12] OF LREAL;
	ALRSETVELOUT : ARRAY [1..12] OF LREAL;
	ALRACTFOLLOWINGERROR : ARRAY [1..12] OF LREAL;
	LRSETPATHVELOUT : LREAL;
	LRSETPATHACCOUT : LREAL;
	LRSETTCPACCOUT : LREAL := 0;
	LRSETROTVELOUT : LREAL := 0;
	LRSETROTACCOUT : LREAL := 0;
	ASCSTATUSABC : ARRAY [1..18] OF L_MC1P_StatusABC;
END_STRUCT
END_TYPE