FUNCTION_BLOCK L_MC1P_CYCLICPARAMETERACCESSREAD EXTENDS L_MC1P_Template
VAR_INPUT
	XENABLE : BOOL;
	WINDEX : WORD;
	USISUBINDEX : USINT;
	USISIZE : USINT;
	XSIGNED : BOOL := FALSE;
	LRSCALEFACTOR : LREAL := 1;
END_VAR
VAR_OUTPUT
	XVALID : BOOL;
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	LRDATA : LREAL;
END_VAR
VAR
	XENABLEOLD : BOOL;
	XWAITINITVARACCESS : BOOL;
	PDATA : POINTER TO BYTE;
	PADDDATA : POINTER TO BYTE;
	PSIDUMMY : POINTER TO SINT;
	PIDUMMY : POINTER TO INT;
	PDIDUMMY : POINTER TO DINT;
	PLIDUMMY : POINTER TO LINT;
	PUSIDUMMY : POINTER TO USINT;
	PUIDUMMY : POINTER TO UINT;
	PUDIDUMMY : POINTER TO UDINT;
	PULIDUMMY : POINTER TO ULINT;
	PAXIS : POINTER TO _AXIS_REF_REAL;
	WINDEXOLD : WORD;
	USISUBINDEXOLD : USINT;
	XSUPPORTBYAXIS : BOOL;
	USISIZEINT : USINT;
END_VAR
END_FUNCTION_BLOCK