	XENABLE : BOOL;
	LRSETOFFSET : LREAL;
	XLOADOFFSET : BOOL;
	XTRIMVELOCITY : BOOL;
	XTRIMPOS : BOOL;
	XTRIMNEG : BOOL;
	XRESETTRIMOFFSET : BOOL;
