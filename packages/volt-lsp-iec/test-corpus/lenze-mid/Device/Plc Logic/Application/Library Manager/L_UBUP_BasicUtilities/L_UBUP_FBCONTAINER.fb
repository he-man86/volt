FUNCTION_BLOCK L_UBUP_FBCONTAINER EXTENDS InstanceBase
VAR
	_ITFOWNER : L_UBUP_IFBPool;
	_XWHANDLE : __XWORD;
	_XOCCUPIED : BOOL;
	CLASSID : DINT;
	INSTANCEPTR : POINTER TO BYTE;
	OBJECTID : DWORD;
	OCCUPIED : BOOL;
	PRVINSTFACTORY : FBF.IFactory;
	PRVNEXTINST : FBF.IInstance;
	PRVPREVINST : FBF.IInstance;
END_VAR
END_FUNCTION_BLOCK

METHOD DISPOSE : BOOL
END_METHOD

METHOD PRVINSTINIT : FBF.ERROR
VAR_INPUT
	ITFDATA : FBF.IData;
END_VAR
END_METHOD

METHOD PRVINSTRELEASE : BOOL
END_METHOD

METHOD PRVINSTRETAIN : BOOL
END_METHOD

METHOD FREE : BOOL
END_METHOD

METHOD OCCUPY : BOOL
VAR_INPUT
	ITFOWNER : L_UBUP_IFBPool;
	XWHANDLE : __XWORD;
END_VAR
END_METHOD

METHOD REQUESTINTERFACE : BOOL
VAR_INPUT
	ID : DINT;
	PITFUNKNOWN : POINTER TO L_UBUP_IUnknown;
END_VAR
END_METHOD