FUNCTION_BLOCK STRINGBUILDER
VAR
	_MEMORY : MemBuffer;
	_UDICURRENTSIZE : UDINT;
	_UDICURRENTALLOCSIZE : UDINT;
	_PDATA : POINTER TO BYTE;
	CAPACITY : UDINT;
	LENGTH : UDINT;
END_VAR
END_FUNCTION_BLOCK

METHOD APPENDCHAR : UDINT
VAR_INPUT
	C : BYTE;
END_VAR
END_METHOD

METHOD APPENDPSTRING : UDINT
VAR_INPUT
	PST : POINTER TO BYTE;
END_VAR
END_METHOD

METHOD APPENDSTRING : UDINT
VAR_INPUT
	STR : STRING;
END_VAR
END_METHOD

METHOD CLEAR
END_METHOD

METHOD GETPSTRINGRESULT : POINTER TO BYTE
END_METHOD

METHOD INITMEMORY : UDINT
VAR_INPUT
	BUFFER : StaticMemBuffer;
END_VAR
END_METHOD

METHOD RESERVESPACE : UDINT
VAR_INPUT
	UDINEWSIZE : UDINT;
END_VAR
END_METHOD

METHOD PRVALLOC : UDINT
VAR_INPUT
	UDINEWSIZE : UDINT;
END_VAR
END_METHOD

METHOD PRVAPPEND : UDINT
VAR_INPUT
	PST : POINTER TO BYTE;
	ILEN : DINT;
END_VAR
END_METHOD

METHOD PRVASSUREADDITIONALSIZE : UDINT
VAR_INPUT
	UDIADDSIZE : UDINT;
END_VAR
END_METHOD