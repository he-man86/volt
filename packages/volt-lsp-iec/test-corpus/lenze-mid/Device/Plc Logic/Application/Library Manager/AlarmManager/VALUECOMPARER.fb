FUNCTION_BLOCK VALUECOMPARER EXTENDS TSLastComparer
VAR
	M_IWHICHVALUE : INT;
END_VAR
END_FUNCTION_BLOCK

METHOD BEFORECOMPARE
VAR_INPUT
	IWHICHVALUE : INT;
END_VAR
END_METHOD

METHOD COMPARE : INT
VAR_INPUT
	DIINDEXALARM1 : DINT;
	DIINDEXALARM2 : DINT;
END_VAR
END_METHOD

METHOD PRVCOMPARETYPE : INT
VAR_INPUT
	BYTYPE1 : BYTE;
	BYTYPE2 : BYTE;
END_VAR
VAR_OUTPUT
	ECOMPARABLETYPEBOTH : EComparableType;
	ENUMERIKCOMPARISON : ENumericComparison;
END_VAR
END_METHOD

METHOD PRVCOMPAREVALUE : INT
VAR_INPUT
	LIVALUE1 : LINT;
	BYTYPE1 : BYTE;
	LIVALUE2 : LINT;
	BYTYPE2 : BYTE;
	ECOMPARABLETYPEBOTH : EComparableType;
	ENUMERIKCOMPARISON : ENumericComparison;
END_VAR
END_METHOD

METHOD PRVCONVERTVALUETOLINT : LINT
VAR_INPUT
	LIVALUE : LINT;
	ITYPE : TypeClass;
END_VAR
END_METHOD

METHOD PRVGETCOMPARABLETYPE : EComparableType
VAR_INPUT
	BYTYPE : BYTE;
END_VAR
VAR_OUTPUT
	XISINT : BOOL;
	XISREAL : BOOL;
	XISLREAL : BOOL;
END_VAR
END_METHOD

METHOD PRVGETTYPE : BOOL
VAR_INPUT
	DIINDEXALARM : DINT;
END_VAR
VAR_OUTPUT
	BYTYPE : BYTE;
END_VAR
END_METHOD

METHOD PRVGETVALUE : BOOL
VAR_INPUT
	DIINDEXALARM : DINT;
END_VAR
VAR_OUTPUT
	LIVALUE : LINT;
END_VAR
END_METHOD