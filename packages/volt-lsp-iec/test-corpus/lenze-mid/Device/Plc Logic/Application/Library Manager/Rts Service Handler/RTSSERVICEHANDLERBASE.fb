FUNCTION_BLOCK RTSSERVICEHANDLERBASE
VAR
	M_SGSERVICEGROUP : ServiceGroup;
	M_HEVENTHANDLER : CAA.HANDLE := CAA.gc_hINVALID;
	M_HCALLBACK : CAA.HANDLE := CAA.gc_hINVALID;
	RESULT : UDINT;
END_VAR
END_FUNCTION_BLOCK

METHOD EVENTCALLBACK : UDINT
VAR_INPUT
	PEVENTPARAM : POINTER TO EventParam;
END_VAR
END_METHOD

METHOD FB_EXIT : ERROR
VAR_INPUT
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD GETSERVICEGROUP : ServiceGroup
END_METHOD

METHOD HANDLESERVICE : ERROR
VAR_INPUT
	PPARAMETERS : POINTER TO SERVICEHANDLER_PARAMETER;
END_VAR
END_METHOD

METHOD STARTSERVICE : ERROR
VAR_INPUT
	SGSERVICEGROUP : ServiceGroup;
END_VAR
END_METHOD

METHOD STOPSERVICE : ERROR
END_METHOD