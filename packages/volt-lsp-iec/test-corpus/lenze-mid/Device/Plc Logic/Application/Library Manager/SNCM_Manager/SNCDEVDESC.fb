FUNCTION_BLOCK SNCDEVDESC
VAR
	_XWASINITIALIZED : BOOL := FALSE;
	_UDIVENDORID : UDINT;
	_UDIFSPSADDRESS : UDINT;
	_UIMASTERIDX : UINT;
	_SZFSPSADDRESS : STRING;
	_SZBUSADDRESS : STRING;
	_SZNODENAME : STRING;
	_SZDEVNAME : STRING;
	_SZVENDORNAME : STRING;
	_UDITARGETID : UDINT;
	_UDITARGETTYPE : UDINT;
	_UDITARGETVERSION : UDINT;
	FSPSADDRESS : UDINT;
	FSPSDEVADDRESS : STRING;
	FSPSMASTERIDX : UINT;
	FSPSVENDORID : UDINT;
END_VAR
END_FUNCTION_BLOCK

METHOD INITIALIZE : ERROR
VAR_INPUT
	UDIVENDORID : UDINT;
	UDIFSPSADDRESS : UDINT;
	UIMASTERIDX : UINT;
	SZNODENAME : STRING;
	SZDEVNAME : STRING;
	SZVENDORNAME : STRING;
	UDITARGETID : UDINT;
	UDITARGETTYPE : UDINT;
	UDITARGETVERSION : UDINT;
END_VAR
END_METHOD