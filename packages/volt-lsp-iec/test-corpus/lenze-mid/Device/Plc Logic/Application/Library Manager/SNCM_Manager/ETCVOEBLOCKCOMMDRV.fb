FUNCTION_BLOCK ETCVOEBLOCKCOMMDRV EXTENDS EtcVoECommDrvBase
VAR
	_ABYCOMMBUFFER : ARRAY [0..(ETC_GCL.VoE_COMMBUFFERSIZE_DEFAULT - 1)] OF BYTE;
	_PBYCOMMBUFFER : POINTER TO BYTE;
END_VAR
END_FUNCTION_BLOCK

METHOD INITIALIZE : RTS_IEC_RESULT
VAR_INPUT
	UDIVENDORID : UDINT;
	UDIDEVICE : UDINT;
	UIMASTERIDX : UINT;
END_VAR
END_METHOD

METHOD READ : RTS_IEC_RESULT
VAR_INPUT
	PBYHEADER : POINTER TO BYTE;
	UIHEADERSIZE : UINT;
	PPBYDATA : POINTER TO POINTER TO BYTE;
	PUIREADSIZE : POINTER TO UINT;
END_VAR
END_METHOD

METHOD RELEASEETCFORREAD : RTS_IEC_RESULT
END_METHOD

METHOD WRITE : RTS_IEC_RESULT
VAR_INPUT
	PBYHEADER : POINTER TO BYTE;
	UIHEADERSIZE : UINT;
	PBYDATA : POINTER TO BYTE;
	UIDATASIZE : UINT;
END_VAR
END_METHOD

METHOD WRITETIMEDOUT : RTS_IEC_RESULT
VAR_INPUT
	PBYHEADER : POINTER TO BYTE;
	UIHEADERSIZE : UINT;
	PBYDATA : POINTER TO BYTE;
	UIDATASIZE : UINT;
	UDITIMEOUTMS : UDINT;
END_VAR
END_METHOD

METHOD READTIMEDOUT : RTS_IEC_RESULT
VAR_INPUT
	PBYHEADER : POINTER TO BYTE;
	UIHEADERSIZE : UINT;
	PPBYDATA : POINTER TO POINTER TO BYTE;
	PUIREADSIZE : POINTER TO UINT;
	UDITIMEOUTMS : UDINT;
END_VAR
END_METHOD