INTERFACE IVISUUSERMGMT3
END_INTERFACE

METHOD CHANGEUSER3 : BOOL
VAR_INPUT
	PCLIENTDATA : POINTER TO VisuElems.VisuStructClientData;
	DWUSERDB : DWORD;
	PVUMUSERNEW : POINTER TO VUM_User;
	PVUMUSEROLD : POINTER TO VUM_User;
	UDIINDEX : UDINT;
	EEDITTYPE : VUM_EditType;
END_VAR
END_METHOD

METHOD CHANGEUSERPASSWORD3 : UDINT
VAR_INPUT
	PCLIENTDATA : POINTER TO VisuElems.VisuStructClientData;
	DWUSERDB : DWORD;
	WSTUSERNAME : WSTRING;
	WSTNEWPASSWORD : WSTRING;
	WSTOLDPASSWORD : WSTRING;
END_VAR
END_METHOD

METHOD CHECKADMINRIGHTS : VUM_UserAdminAccess
VAR_INPUT
	PCLIENTDATA : POINTER TO VisuElems.VisuStructClientData;
END_VAR
END_METHOD

METHOD CHECKGROUPS : BOOL
VAR_INPUT
	PCLIENTDATA : POINTER TO VisuElems.VisuStructClientData;
END_VAR
END_METHOD

METHOD GETUSERCOUNT3 : UDINT
VAR_INPUT
	PCLIENTDATA : POINTER TO VisuElems.VisuStructClientData;
	DWUSERDB : DWORD;
END_VAR
VAR_OUTPUT
	RESULT : RTS_IEC_RESULT;
END_VAR
END_METHOD

METHOD GETUSERS3 : DWORD
VAR_INPUT
	PCLIENTDATA : POINTER TO VisuElems.VisuStructClientData;
	DWUSERDB : DWORD;
	UDISTARTINDEX : UDINT;
	UDIENDINDEX : UDINT;
	PARR : POINTER TO ARRAY [0..0] OF VUM_User;
	UDIARRSIZE : UDINT;
END_VAR
END_METHOD

METHOD LOGINRTS : UDINT
VAR_INPUT
	WSTUSERNAME : WSTRING;
	WSTPASSWORD : WSTRING;
	PCLIENTDATA : POINTER TO VisuElems.VisuStructClientData;
	PUSER : POINTER TO VUM_User;
END_VAR
VAR_OUTPUT
	WSTFULLNAME : WSTRING;
	DWUSERGROUPID : DWORD;
END_VAR
END_METHOD