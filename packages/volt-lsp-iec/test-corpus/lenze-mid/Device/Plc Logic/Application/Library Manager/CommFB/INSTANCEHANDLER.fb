FUNCTION_BLOCK INSTANCEHANDLER
VAR
	S_INSTANCECOUNT : UINT;
	S_FACTORIES : ARRAY [0..(MAX_INSTANCES - 1)] OF ICommFBFactory;
	S_FACTORIESEXT : ARRAY [0..(MAX_INSTANCES - 1)] OF ICommFBFactoryExt;
	S_FACTORIESIO : ARRAY [0..(MAX_INSTANCES - 1)] OF ICommFBFactoryIO;
	S_FACTORIESCONNECTIONS : ARRAY [0..(MAX_INSTANCES - 1)] OF ICommFBConnectionManagerFactory;
	S_FIELDDEVICES : ARRAY [0..(MAX_INSTANCES - 1)] OF ICommFBFieldDevice;
	S_GENERICIDFACTORIES : ARRAY [0..(MAX_INSTANCES - 1)] OF IGenericIDFactory;
	S_IDS : UDINT := (MAX_INSTANCES - 1);
	S_DIAGPROVIDERS : ARRAY [0..(MAX_INSTANCES - 1)] OF ICommFBDiagProvider;
	MAX_INSTANCES : UINT := 8;
END_VAR
END_FUNCTION_BLOCK