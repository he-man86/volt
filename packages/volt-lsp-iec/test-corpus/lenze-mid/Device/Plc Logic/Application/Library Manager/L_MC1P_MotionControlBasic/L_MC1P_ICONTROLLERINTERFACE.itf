INTERFACE L_MC1P_ICONTROLLERINTERFACE
END_INTERFACE

METHOD CALCCONTROLLER
VAR_INPUT
	LRSETPOSITION : LREAL;
	LRSETVELOCITY : LREAL;
	LRSETACCELERATION : LREAL;
	LRSETTORQUE : LREAL;
	LRSETJERK : LREAL;
	LRACTPOSITIONIN : LREAL;
	LRACTVELOCITYIN : LREAL;
	LRACTACCELERATIONIN : LREAL;
	LRACTTORQUEIN : LREAL;
END_VAR
VAR_OUTPUT
	LRSETPOSITIONOUT : LREAL;
	LRSETVELOCITYOUT : LREAL;
	LRSETACCELERATIONOUT : LREAL;
	LRSETTORQUEOUT : LREAL;
END_VAR
VAR_IN_OUT
	AXIS : _AXIS_REF_REAL;
END_VAR
END_METHOD