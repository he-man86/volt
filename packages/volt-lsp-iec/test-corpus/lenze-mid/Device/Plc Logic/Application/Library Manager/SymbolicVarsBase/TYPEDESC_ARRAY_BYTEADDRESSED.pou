FUNCTION_BLOCK TYPEDESC_ARRAY_BYTEADDRESSED EXTENDS TypeDesc_Array
END_FUNCTION_BLOCK

METHOD GET_INTERNAL : __XWORD
VAR_INPUT
	PDEST : POINTER TO BYTE;
	PSRC : POINTER TO BYTE;
	VARINFO : REFERENCE TO VariableInformation;
	DWSIZE : __XWORD;
	PRESULT : POINTER TO UDINT;
END_VAR
END_METHOD

METHOD SET_INTERNAL : __XWORD
VAR_INPUT
	PSRC : POINTER TO BYTE;
	PDEST : POINTER TO BYTE;
	VARINFO : REFERENCE TO VariableInformation;
	DWSIZE : __XWORD;
	PRESULT : POINTER TO UDINT;
END_VAR
END_METHOD

METHOD INCREMENTOFFSET
VAR_INPUT
	VARINFO : REFERENCE TO VariableInformation;
	ENTRIESCOUNT : DINT;
END_VAR
END_METHOD