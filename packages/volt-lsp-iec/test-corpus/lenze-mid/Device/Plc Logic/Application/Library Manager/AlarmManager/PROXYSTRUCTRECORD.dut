TYPE PROXYSTRUCTRECORD :
STRUCT
	IRECORDID : INT;
	IALARMCLASSNUM : INT;
	DIALARMNUM : DINT;
	ILATCHVARSNUM : INT;
	PAALARMGROUPS : POINTER TO ARRAY [0..9] OF STRING;
	IALARMGROUPSNUM : INT;
	PACLASSREMAP : POINTER TO ARRAY [0..9] OF ProxyStructClassReMap;
	ICLASSREMAPNUM : INT;
	PAACTIVEALARMOBJSTUBS : POINTER TO ARRAY [0..100] OF POINTER TO ProxyFbAlarmMetaObjectStub;
	DIALMOBJSTUBSALLOC : DINT;
	PAACTIVEALARMCONTAINER : POINTER TO ARRAY [0..100] OF POINTER TO AlarmContainer;
	DIALMCONTAINERALLOC : DINT;
	DIACTIVEALARMS : DINT;
	PASTRUCTALARMDESCRIPTION : POINTER TO ARRAY [0..100] OF POINTER TO ProxyStructAlarm;
	DIALARMDESCALLOC : DINT;
	PASTRUCTALARMGROUPDESCRIPTION : POINTER TO ARRAY [0..100] OF POINTER TO ProxyStructAlarmGroup;
	IALARMGROUPDESCALLOC : INT;
	PASTRUCTALARMCLASSDESCRIPTION : POINTER TO ARRAY [0..100] OF POINTER TO ProxyStructAlarmClass;
	IALARMCLASSDESCALLOC : INT;
END_STRUCT
END_TYPE