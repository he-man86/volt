FUNCTION_BLOCK L_MC1P_MOVEVELOCITY_INTERNAL EXTENDS L_MC1P_Template_IntFB
VAR
	FBMB : L_MC1P_MoveBasic := STRUCT(wCalcProfileMode := 1);
	PINPUT : POINTER TO L_MC1P_MoveVelocityInput;
	LRVEL : LREAL;
	ABORTEDBYLIMIT : BOOL;
END_VAR
END_FUNCTION_BLOCK

METHOD MAIN
VAR_IN_OUT
	AXIS : AXIS_REF;
	FBBASE : L_MC1P_Template_ForAxis;
	INPUT : L_MC1P_MoveVelocityInput;
	OUTPUT : L_MC1P_MoveVelocityOutput;
END_VAR
END_METHOD

METHOD MODVELOCITY : LREAL
VAR_IN_OUT
	AXIS : AXIS_REF;
END_VAR
END_METHOD