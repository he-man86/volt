FUNCTION_BLOCK MC_READPARAMETER EXTENDS L_MC1P_Template_NoAxis
VAR_INPUT
	AXIS : L_MC1P_IMCParameterAccess;
	ENABLE : BOOL;
	PARAMETERNUMBER : DINT;
END_VAR
VAR_OUTPUT
	VALID : BOOL;
	BUSY : BOOL;
	ERROR : BOOL;
	ERRORID : L_IE1P_Error;
	VALUE : LREAL;
END_VAR
VAR
	READ : L_MC1P_ReadParameter_Internal;
	TCYCLETIME : TIME;
	_MCCALL : L_UM1P_MCMultipleCall;
	INPUTDATA : ARRAY [1.._MCCall.c_BufferDepthInput] OF L_MC1P_ReadParameterInput;
	OUTPUTDATA : ARRAY [1.._MCCall.c_BufferDepthOutput] OF L_MC1P_ReadParameterOutput;
	PINPUTDATA : POINTER TO L_MC1P_ReadParameterInput;
	ITFSETPOINTINFO : L_UM1P_ISetpointInfo;
	XAXISTASKIDXVALID : BOOL;
	IAXISTASKIDX : INT;
	READCYCLE : TIME;
END_VAR
END_FUNCTION_BLOCK