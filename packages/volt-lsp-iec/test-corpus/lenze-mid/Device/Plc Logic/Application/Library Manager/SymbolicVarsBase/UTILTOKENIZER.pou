FUNCTION_BLOCK UTILTOKENIZER
VAR
	_PSTRTOTOKENIZE : POINTER TO STRING;
	_PSTRTOTOKENIZEASBYTES : POINTER TO BYTE;
	_STRDELIMS : STRING;
	_INUMDELIMS : INT;
	_ICURRENTPOS : __XWORD;
	_ISTRTOTOKENIZELEN : __XWORD;
	CURRENTPOSITION : __XWORD;
	ENDOFSTRREACHED : BOOL;
END_VAR
END_FUNCTION_BLOCK

METHOD INITIALIZE : BOOL
VAR_INPUT
	PSTR : POINTER TO STRING;
	STRDELIMS : STRING;
END_VAR
END_METHOD

METHOD NEXTTOKEN : BOOL
VAR_OUTPUT
	BEND : BOOL;
	ITOKENSTARTOFFSET : __XWORD;
	ITOKENLEN : __XWORD;
END_VAR
END_METHOD