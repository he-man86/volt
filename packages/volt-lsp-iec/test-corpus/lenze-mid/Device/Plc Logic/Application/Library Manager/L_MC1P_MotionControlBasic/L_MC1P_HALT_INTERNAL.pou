FUNCTION_BLOCK L_MC1P_HALT_INTERNAL EXTENDS L_MC1P_Template_IntFB
VAR
	FBMB : L_MC1P_MoveBasic := STRUCT(wCalcProfileMode := 1);
END_VAR
END_FUNCTION_BLOCK

METHOD MAIN
VAR_IN_OUT
	AXIS : AXIS_REF;
	FBBASE : L_MC1P_Template_ForAxis;
	INPUT : L_MC1P_HaltInput;
	OUTPUT : L_MC1P_HaltOutput;
END_VAR
END_METHOD

METHOD RESET
VAR_IN_OUT
	FBBASE : L_MC1P_Template_ForAxis;
	OUTPUT : L_MC1P_HaltOutput;
END_VAR
END_METHOD