INTERFACE IEXTERNALUSERDATABASEPROVIDER
END_INTERFACE

METHOD CHANGEUSERPASSWORD : VUM_ReturnValues
VAR_INPUT
	WSTUSERNAME : WSTRING;
	WSTNEWPASSWORD : WSTRING;
	WSTOLDPASSWORD : WSTRING;
END_VAR
END_METHOD

METHOD CHECKLOGIN : VUM_ReturnValues
VAR_INPUT
	WSTUSERNAME : WSTRING;
	WSTPASSWORD : WSTRING;
END_VAR
VAR_OUTPUT
	WSTFULLNAME : WSTRING;
	DWUSERGROUPID : DWORD;
END_VAR
END_METHOD

METHOD CHECKLOGINWITHGROUPID : VUM_ReturnValues
VAR_INPUT
	WSTUSERNAME : WSTRING;
	WSTPASSWORD : WSTRING;
	DWUSERGROUPID : DWORD;
END_VAR
VAR_OUTPUT
	WSTFULLNAME : WSTRING;
END_VAR
END_METHOD

METHOD CHANGEUSER : VUM_ReturnValues
VAR_INPUT
	PVUMUSER : POINTER TO VUM_User;
	UDIINDEX : UDINT;
	EEDITTYPE : VUM_EditType;
END_VAR
END_METHOD

METHOD GETUSERCOUNT : UDINT
END_METHOD

METHOD GETUSERS : VUM_ReturnValues
VAR_INPUT
	UDISTARTINDEX : UDINT;
	UDIENDINDEX : UDINT;
	PARR : POINTER TO ARRAY [0..0] OF VUM_User;
	UDIARRSIZE : UDINT;
END_VAR
END_METHOD