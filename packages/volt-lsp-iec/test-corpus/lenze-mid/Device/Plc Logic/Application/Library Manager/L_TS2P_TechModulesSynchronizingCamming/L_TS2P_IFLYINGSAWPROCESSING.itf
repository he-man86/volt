INTERFACE L_TS2P_IFLYINGSAWPROCESSING
END_INTERFACE

METHOD CLUTCH
VAR_INPUT
	ITFTECHMODULE : L_TS2P_IFlyingSawProcessing;
	XENABLE : BOOL;
	XSYNCVEL : BOOL := FALSE;
	XSYNCPOS : BOOL;
	XSYNCOUTINSTANT : BOOL;
	LRSYNCVEL : LREAL := 10;
	LRSYNCACC : LREAL := 100;
	LRSYNCDEC : LREAL := 100;
	LRSYNCJERK : LREAL := 10000;
	LRCYCMASTERPOS : LREAL;
	LRCYCMASTERVEL : LREAL;
	LRCYCMASTERACC : LREAL;
	LRSETSLAVEPOS : LREAL;
	LRSETSLAVEVEL : LREAL;
	LRSETSLAVEACC : LREAL;
END_VAR
VAR_OUTPUT
	EERRORID : L_IE1P_Error;
	XERROR : BOOL;
	XBUSY : BOOL;
	XDONE : BOOL;
	XACCDECSYNC : BOOL;
	XVELSYNCHRONISED : BOOL;
	XPOSSYNCHRONISED : BOOL;
	LRSETSLAVEPOSOUT : LREAL;
	LRSETSLAVEVELOUT : LREAL;
	LRSETSLAVEACCOUT : LREAL;
	XPROFILERESETTIMEVALID : BOOL;
	LRPROFILERESETTIME : LREAL;
END_VAR
END_METHOD

METHOD EXECUTEGAP
VAR_INPUT
	ITFTECHMODULE : L_TS2P_IFlyingSawProcessing;
	XENABLE : BOOL;
	LRSYNCVEL : LREAL := 10;
	LRSYNCACC : LREAL := 100;
	LRSYNCDEC : LREAL := 100;
	LRSYNCJERK : LREAL := 10000;
	XEXECUTEGAP : BOOL;
	XAUXEXECUTEGAP : BOOL := FALSE;
	LRCYCMASTERPOS : LREAL;
	LRCYCMASTERVEL : LREAL;
	LRCYCMASTERACC : LREAL;
	LRSETSLAVEPOS : LREAL;
	LRSETSLAVEVEL : LREAL;
	LRSETSLAVEACC : LREAL;
END_VAR
VAR_OUTPUT
	EERRORID : L_IE1P_Error;
	XERROR : BOOL;
	XBUSY : BOOL;
	XDONE : BOOL;
	XACCDECSYNC : BOOL;
	XVELSYNCHRONISED : BOOL;
	XPOSSYNCHRONISED : BOOL;
	LRSETSLAVEPOSOUT : LREAL;
	LRSETSLAVEVELOUT : LREAL;
	LRSETSLAVEACCOUT : LREAL;
	XPROFILERESETTIMEVALID : BOOL;
	LRPROFILERESETTIME : LREAL;
END_VAR
END_METHOD

METHOD MARKSTACK_GETMARK
VAR_INPUT
	ITFTECHMODULE : L_TS2P_IFlyingSawProcessing;
	XENABLE : BOOL;
	XGETMARK : BOOL;
	XRESETGETMARK : BOOL;
	XRESETMARKSTACK : BOOL;
	LRCYCSETPOS : LREAL;
	LRCYCSETVEL : LREAL;
END_VAR
VAR_OUTPUT
	XMARKSTACKFULL : BOOL;
	XMARKSTACKEMPTY : BOOL;
	WMARKSINSTACK : WORD;
	XMARKVALID : BOOL;
	LRMARKPOSOUT : LREAL;
END_VAR
END_METHOD

METHOD MARKSTACK_SETMARK
VAR_INPUT
	ITFTECHMODULE : L_TS2P_IFlyingSawProcessing;
	XENABLE : BOOL;
	XSETMARK : BOOL;
	LRMARKPOS : LREAL;
	XRESETMARKSTACK : BOOL;
	LRCYCSETPOS : LREAL;
	LRCYCSETVEL : LREAL;
END_VAR
VAR_OUTPUT
	XMARKSTACKFULL : BOOL;
	XMARKSTACKEMPTY : BOOL;
	WMARKSINSTACK : WORD;
	XNEWMARKRECEIVED : BOOL;
END_VAR
END_METHOD

METHOD POSITIONING
VAR_INPUT
	ITFTECHMODULE : L_TS2P_IFlyingSawProcessing;
	XENABLE : BOOL;
	XMOVETOTARGETPOS : BOOL;
	LRTARGETPOS : LREAL;
	LRPOSITIONINGVEL : LREAL;
	LRPOSITIONINGACC : LREAL;
	LRPOSITIONINGDEC : LREAL;
	LRPOSITIONINGJERK : LREAL;
	LRSETSLAVEPOS : LREAL;
	LRSETSLAVEVEL : LREAL;
	LRSETSLAVEACC : LREAL;
	LRCORRECTTIMEBASE : LREAL := 0;
	LROVERRIDE : LREAL := 1.0;
END_VAR
VAR_OUTPUT
	EERRORID : L_IE1P_Error;
	XERROR : BOOL;
	XBUSY : BOOL;
	XDONE : BOOL;
	XPOSITIONING : BOOL;
	XINPOSITION : BOOL;
	LRSETSLAVEPOSOUT : LREAL;
	LRSETSLAVEVELOUT : LREAL;
	LRSETSLAVEACCOUT : LREAL;
	XPROFILERESETTIMEVALID : BOOL;
	LRPROFILERESETTIME : LREAL;
END_VAR
END_METHOD