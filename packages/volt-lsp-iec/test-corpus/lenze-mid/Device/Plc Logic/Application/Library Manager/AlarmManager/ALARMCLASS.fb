	M_ICOUNTNOTIFIABLES : INT;
	M_SNAME : STRING;
	M_PAPDISPLAYOPTIONS : POINTER TO ARRAY [AlarmState.Normal..AlarmState.ActiveAcknowledged] OF POINTER TO DisplayOptions;
	M_TREALARMTIME : TIME;
	REALARMTIME : TIME;
END_VAR
END_FUNCTION_BLOCK

