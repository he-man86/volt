FUNCTION_BLOCK ALARMCLASS
VAR
	M_UDIID : UDINT;
	M_USIPRIORITY : USINT;
	M_XARCHIVING : BOOL;
	M_EACKNOWLEDGEMETHOD : AcknowledgeMethod;
	M_XACKNOWLEDGESEPARATELY : BOOL;
	M_XAUTORESETDIGITALALARMS : BOOL;
	M_XACKINSTEADOFCONFIRM : BOOL;
	M_PAITFALARMNOTIFIABLES : POINTER TO ARRAY [0..0] OF IAlarmNotifiable;
	M_ICOUNTNOTIFIABLES : INT;
	M_SNAME : STRING;
	M_PAPDISPLAYOPTIONS : POINTER TO ARRAY [AlarmState.Normal..AlarmState.ActiveAcknowledged] OF POINTER TO DisplayOptions;
	M_TREALARMTIME : TIME;
	REALARMTIME : TIME;
END_VAR
END_FUNCTION_BLOCK