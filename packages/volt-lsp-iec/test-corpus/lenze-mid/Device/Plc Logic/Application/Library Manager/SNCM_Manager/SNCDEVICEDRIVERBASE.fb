FUNCTION_BLOCK SNCDEVICEDRIVERBASE
VAR
	_XWASINITIALIZED : BOOL := FALSE;
	_SNCSERVICEPROVIDER : ISncServiceProvider;
	_NEXT : ISncDeviceDriver;
	_PREVIOUS : ISncDeviceDriver;
	_FSPSBUSHANDLER : SncBusHandler;
	_FSPSDEVDESC : SncDevDesc;
	_UDISTDRTSWRITERSIZE : UDINT := 0;
	_WIOMODULETYPE : UINT;
	_DWIOINSTANCE : UDINT;
	_PIOCONNECTOR : POINTER TO IoConfigConnector;
	_EDBGLOGSTATE : LOGDBGSTATE;
	_HCALLBACK : RTS_IEC_HANDLE;
	FSPSBUSID : FSPSBUSDRV;
	FSPSDEVICEADDRESS : STRING;
	NEXT : ISncDeviceDriver;
	PREVIOUS : ISncDeviceDriver;
	SYNCDWRITERSIZE : UDINT;
	WASINITIALIZED : BOOL;
END_VAR
END_FUNCTION_BLOCK

