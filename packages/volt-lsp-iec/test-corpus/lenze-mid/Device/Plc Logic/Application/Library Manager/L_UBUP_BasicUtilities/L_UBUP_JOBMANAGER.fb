FUNCTION_BLOCK L_UBUP_JOBMANAGER
VAR_INPUT
	XENABLE : BOOL;
	DWJOBNO : DWORD := 1;
	ITFJOBS : L_UBUP_IList;
END_VAR
VAR_OUTPUT
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	DWJOBCOUNT : DWORD;
	DWCALLID : DWORD := g_dwCallIDUnassigned;
	ECOMMANDTYPE : L_UBUP_CommandType;
	EACTUALSTATE : L_UBUP_JobState;
	ITFJOB : L_UBUP_IJob;
END_VAR
VAR
	_ITFJOBCOLLECTION : L_UBUP_IJobCollection;
	_ITFLISTCONTROL : L_UBUP_IListControl;
	_MODEL : L_UBUP_BehaviourModel_LConC;
END_VAR
END_FUNCTION_BLOCK

METHOD CYCLICACTION
VAR_INPUT
	ITFTIMINGCONTROLLER : L_UBUP_ITimingController;
END_VAR
VAR_OUTPUT
	XCOMPLETE : BOOL;
	XABORT : BOOL;
	IERRORID : INT;
END_VAR
END_METHOD

METHOD FINALIZEACTION
VAR_INPUT
	XABORTPROPOSED : BOOL;
	IERRORIDPROPOSED : INT;
END_VAR
VAR_OUTPUT
	XCOMPLETE : BOOL;
	XABORT : BOOL;
	IERRORID : INT;
END_VAR
END_METHOD

METHOD RESETACTION
VAR_OUTPUT
	XCOMPLETE : BOOL;
END_VAR
END_METHOD

METHOD STARTACTION
VAR_OUTPUT
	XCOMPLETE : BOOL;
	IERRORID : INT;
END_VAR
END_METHOD