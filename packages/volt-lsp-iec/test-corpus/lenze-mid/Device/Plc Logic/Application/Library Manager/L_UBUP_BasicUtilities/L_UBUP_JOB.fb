	FB_TRANSITION2READYFORRELEASE : L_UBUP_RequestTransitionEdge;
	FB_TRANSITION2PREPARERELEASE : L_UBUP_RequestTransitionEdge;
	BLOCKNEXT : BOOL;
	CALLID : DWORD;
	CLASSID : L_UBUP_ClassID;
	COMMANDTYPE : L_UBUP_CommandType;
	ISBLOCKED : BOOL;
	ISREADYFORRELEASE : BOOL;
	JOBSTATE : L_UBUP_JobState;
	PRIORITY : DWORD;
	REJECTIFABORTED : BOOL;
	REJECTIFPENDING : BOOL;
END_VAR
END_FUNCTION_BLOCK

