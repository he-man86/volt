TYPE L_MC4P_PATHDATA :
STRUCT
	RESERVED : ARRAY [1..SIZEOF(L_MC4P_AuxAxesData)] OF BYTE;
	VMAX_IN : LREAL;
	VMAX_OUT : LREAL;
	LRACC_IN : LREAL;
	LRACC_OUT : LREAL;
	LRDEC_IN : LREAL;
	LRDEC_OUT : LREAL;
	VMAX : LREAL;
	AMAX : LREAL;
	DMAX : LREAL;
	AMAX_ORIG : LREAL := L_UMTP_Math.L_UMTP_ValueInitial;
	DMAX_ORIG : LREAL := L_UMTP_Math.L_UMTP_ValueInitial;
	LRJERK : LREAL;
	ALRVMAXROT : ARRAY [1..3] OF LREAL;
	ALRAMAXROT : ARRAY [1..3] OF LREAL;
	ALRJERKROT : ARRAY [1..3] OF LREAL;
	VEL_IN_ROT : ARRAY [1..3] OF LREAL;
	VEL_OUT_ROT : ARRAY [1..3] OF LREAL;
	SCBLENDINGDATA : L_MC4P_BlendingData;
END_STRUCT
END_TYPE