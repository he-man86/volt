TYPE _SCPAR_TM_FLEXCAMBASE :
STRUCT
	ESYNCMODE : L_TT1P_SyncMode := L_TT1P_SyncMode.absolute;
	ESYNCDIRECTION : L_TT1P_SyncDirection := L_TT1P_SyncDirection.mcCurrentDirection;
	LRMASTERSYNCINDIST : LREAL := 100;
	LRMASTERSYNCINPOS : LREAL := 0;
	LRMASTERSYNCOUTDIST : LREAL := 100;
	LRSLAVESYNCOUTPOS : LREAL := 0;
	LRSYNCINTIME : LREAL := 5;
	LRSYNCOUTTIME : LREAL := 5;
	LRSYNCOUTINSTANTDEC : LREAL := 10000;
	LRSYNCVEL : LREAL := 100;
	LRSYNCACC : LREAL := 1000.0;
	LRSYNCDEC : LREAL := 1000.0;
	LRSYNCJERK : LREAL := 1000000.0;
	XCAMCYCLIC : BOOL := TRUE;
	XMASTERABSOLUTE : BOOL := TRUE;
	XSLAVEABSOLUTE : BOOL := TRUE;
	EOFFSETMODEMASTER : L_TT1P_OffsetMode := ANY_TO_WORD(L_TT1P_OffsetMode.x_zero);
	EOFFSETMODESLAVE : L_TT1P_OffsetModeSlave := ANY_TO_WORD(L_TT1P_OffsetMode.x_zero);
	LROFFSETSCALINGMASTERVEL : LREAL := 100.0;
	LROFFSETSCALINGMASTERACC : LREAL := 1000.0;
	LROFFSETSCALINGMASTERDEC : LREAL := 1000.0;
	ESCALINGMODEMASTER : L_TT1P_ScalingMode := L_TT1P_ScalingMode.x_zero;
	ESCALINGMODESLAVE : L_TT1P_ScalingMode := L_TT1P_ScalingMode.x_zero;
	LROFFSETSCALINGSLAVEVEL : LREAL := 100.0;
	LROFFSETSCALINGSLAVEACC : LREAL := 1000.0;
	LROFFSETSCALINGSLAVEDEC : LREAL := 1000.0;
	XCALCCAMBOUNDS : BOOL;
	LRMASTERMAXVEL : LREAL := 100;
	LRMASTERMAXACC : LREAL := 1000;
END_STRUCT
END_TYPE