	SCTOP3DOWNTIME : scVisuTop3Downtime;
	SCTOP3PRODUCTIONMODE : scVisuTop3ProductionMode;
	SCTOP3PERFORMANCELOSSES : scVisuTop3ProductionMode;
END_STRUCT
END_TYPE