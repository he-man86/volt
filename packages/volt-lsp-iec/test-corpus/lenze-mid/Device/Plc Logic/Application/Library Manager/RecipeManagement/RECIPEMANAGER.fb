FUNCTION_BLOCK RECIPEMANAGER
VAR
	_ARRDEFINITIONS : POINTER TO ARRAY [0..1000] OF IRecipeDefinition;
	_IDEFINITIONCOUNT : INT;
	_INEXTTOINSERTINDEX : INT;
	_ICURRENTINDEX : INT := -1;
	_IRECIPEMANAGER : IRecipeManager;
	_UDILASTERROR : UDINT;
	_ELASTINFO : InfoValues;
	CURRENT : IRecipeDefinition;
	DEFINITIONCOUNT : INT;
	LASTERROR : UDINT;
	LASTINFO : InfoValues;
END_VAR
END_FUNCTION_BLOCK

METHOD ADDRECIPEDEFINITION : BOOL
VAR_INPUT
	DEF : IRecipeDefinition;
END_VAR
END_METHOD

METHOD FB_INIT : BOOL
VAR_INPUT
	BINITRETAINS : BOOL;
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD GETINTERFACE : POINTER TO BYTE
VAR_INPUT
	DWITFID : DWORD;
END_VAR
END_METHOD

METHOD GETRECIPEDEFINITION : IRecipeDefinition
VAR_INPUT
	IINDEX : INT;
END_VAR
END_METHOD

METHOD GETRECIPEDEFINITIONBYNAME : IRecipeDefinition
VAR_INPUT
	STDEFINITIONNAME : STRING;
END_VAR
END_METHOD

METHOD GETRECIPEDEFINITIONINDEXBYNAME : INT
VAR_INPUT
	STDEFINITIONNAME : STRING;
END_VAR
END_METHOD

METHOD INITIALIZE : BOOL
VAR_INPUT
	PDATA : POINTER TO ARRAY [0..1000] OF IRecipeDefinition;
	ICOUNT : INT;
END_VAR
END_METHOD

METHOD SELECTRECIPEDEFINITION : BOOL
VAR_INPUT
	IINDEX : INT;
END_VAR
END_METHOD