TYPE PROXYSTRUCTMONITORREQUEST :
STRUCT
	ITASKID : INT := ProxyConstants.REQ_ID_NONE;
	AFIFOERRORS : ARRAY [1..ProxyConstants.FIFO_ERROR_SIZE] OF ProxyStructError;
	UDIERRCOUNT : UDINT;
	LTELAPTIME : LTIME;
	TREQDURATIONLAST : TIME;
	TREQDURATIONAVG : TIME;
	TREQDURATIONMIN : TIME;
	TREQDURATIONMAX : TIME;
	UDIREQDURATIONBUILDREQ : UDINT;
	UDIREQDURATIONWAITANS : UDINT;
	UDIREQDURATIONELABANS : UDINT;
	UDIREQCOUNT : UDINT;
	UDIREQCOUNTCLOSED : UDINT;
END_STRUCT
END_TYPE