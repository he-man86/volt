FUNCTION_BLOCK L_IE1P_READACTUALSEVERITY
VAR_INPUT
	XENABLE : BOOL;
	MODULEHANDLER : L_IMHP_IModuleHandler;
	XDISABLESUBMODULES : BOOL;
	XINCLUDEOWNMODULE : BOOL := TRUE;
END_VAR
VAR_OUTPUT
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	ESEVERITY : L_IE1P_SeverityLevel;
	EREACTION : L_IE1P_Reaction;
	SAFFECTEDMODULENAME : STRING;
	AFFECTEDMODULEHANDLER : L_IMHP_IModuleHandler;
	XERRORACTIVE : BOOL;
	XWARNINGACTIVE : BOOL;
	SEVERITYSTATUS : L_IE1P_SeverityStatus;
	REACTIONSTATUS : L_IE1P_ReactionStatus;
END_VAR
VAR
	XENABLEOLD : BOOL;
	AFFECTEDMODULEHANDLEROLD : L_IMHP_IModuleHandler;
END_VAR
END_FUNCTION_BLOCK

METHOD READCHILDSEVERITY : BOOL
VAR_INPUT
	WCHILD : WORD;
END_VAR
VAR_OUTPUT
	ESEVERITY : L_IE1P_SeverityLevel;
	EREACTION : L_IE1P_Reaction;
	SCHILDNAME : STRING;
	CHILDMODULEHANDER : L_IMHP_IModuleHandler;
END_VAR
END_METHOD