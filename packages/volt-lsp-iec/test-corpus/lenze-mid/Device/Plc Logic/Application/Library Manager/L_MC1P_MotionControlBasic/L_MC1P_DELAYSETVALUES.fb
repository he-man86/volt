FUNCTION_BLOCK L_MC1P_DELAYSETVALUES EXTENDS L_MC1P_SetSetValueManipulator
VAR_INPUT
	LRDELAYTIME : LREAL := 0.1;
END_VAR
VAR_OUTPUT
	XINEQOUT : BOOL;
END_VAR
VAR
	LRDELAYTIMEINT : LREAL;
	DIBUFFERINDEX : DINT;
	DIVALIDCOUNTER : DINT;
	ALRPOS : ARRAY [1..wBufferSize] OF LREAL;
	DIDELAY : DINT;
	LRPOSOUTSAVE : LREAL;
	LRPOSOUTOLD : LREAL;
	LRVELOUTOLD : LREAL;
	WBUFFERSIZE : WORD := 1000;
	_CUSTOMINPUTDATA : ARRAY [1..2] OF L_MC1P_DelaySetValuesInput;
	_CUSTOMOUTPUTDATA : ARRAY [1..2] OF L_MC1P_DelaySetValuesOutput;
	_PCUSTOMINPUTDATA : POINTER TO L_MC1P_DelaySetValuesInput;
	_PCUSTOMOUTPUTDATA : POINTER TO L_MC1P_DelaySetValuesOutput;
END_VAR
END_FUNCTION_BLOCK