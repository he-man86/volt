	LROVERRIDEACC : LREAL := 1.0;
	LROVERRIDEJERK : LREAL := 1.0;
	XSTOP : BOOL;
	LRSTOPDEC : LREAL := 360000;
	LRSTOPJERK : LREAL := 0;
	XJOGGINGPOS : BOOL;
	XJOGGINGNEG : BOOL;
	XCONTINUOUSUPDATE : BOOL;
	XMOVEVELEXECUTE : BOOL;
	XMOVEABSEXECUTE : BOOL;
	XMOVERELEXECUTE : BOOL;
	XHALT : BOOL;
	LRSETPOS_DIST : LREAL;
	ESETDIRECTION : MC_DIRECTION := MC_DIRECTION.mcPositiveDirection;
	XHOMEEXECUTE : BOOL;
	LRHOMEPOSITION : LREAL;
	XUSEHOMEEXTPARAMETER : BOOL;
	SCHOMEEXTPARAMETER : L_MC1P_HomeParameter;
	SCHOMEEXTTP : MC_TRIGGER_REF;
	XHOMEABSSWITCH : BOOL;
