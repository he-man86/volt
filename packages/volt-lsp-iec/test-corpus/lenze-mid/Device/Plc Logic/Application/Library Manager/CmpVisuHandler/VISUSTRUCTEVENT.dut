TYPE VISUSTRUCTEVENT :
STRUCT
	ISTRUCTSIZE : INT := SIZEOF(THIS^);
	EVENTTAG : DWORD := VISU_ET_MONITORING;
	DWPARAM1 : DWORD := 0;
	DWPARAM2 : DWORD := 0;
	CLIENTID : DWORD := 16#FFFFFFFF;
	DWADDDATASIZE : DWORD := 0;
	PADDITIONALDATA : POINTER TO BYTE;
	BIMPORTANTINPUT : BOOL;
	ROPTINVALIDRECT : VisuStructSimpleRectangle;
END_STRUCT
END_TYPE