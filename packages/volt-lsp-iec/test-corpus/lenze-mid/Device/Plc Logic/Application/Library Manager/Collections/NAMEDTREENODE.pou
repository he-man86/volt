FUNCTION_BLOCK NAMEDTREENODE EXTENDS AbstrTreeNode
VAR
	_PSTNAME : POINTER TO STRING;
	_INAMEDTREENODE : INamedTreeNode;
	CASESENSITIVECOMPARISON : BOOL;
	NAME : POINTER TO STRING;
END_VAR
END_FUNCTION_BLOCK

METHOD FB_INIT : BOOL
VAR_INPUT
	BINITRETAINS : BOOL;
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD FINDCHILDBYNAME : INamedTreeNode
VAR_INPUT
	STNAME : STRING(256);
END_VAR
END_METHOD

METHOD ABSTRCOMPARETO : INT
VAR_INPUT
	PSEARCHDATA : POINTER TO BYTE;
END_VAR
END_METHOD

METHOD QUERYINTERFACE : POINTER TO POINTER TO BYTE
VAR_INPUT
