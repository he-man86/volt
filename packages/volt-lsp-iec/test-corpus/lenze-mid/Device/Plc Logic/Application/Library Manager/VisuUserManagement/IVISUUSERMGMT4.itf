INTERFACE IVISUUSERMGMT4
END_INTERFACE

METHOD CHANGEUSER4 : BOOL
VAR_INPUT
	PCLIENTDATA : POINTER TO VisuElems.VisuStructClientData;
	DWUSERDB : DWORD;
	PVUMUSERNEW : POINTER TO VUM_UserInternal;
	PVUMUSEROLD : POINTER TO VUM_UserInternal;
	UDIINDEX : UDINT;
	EEDITTYPE : VUM_EditType;
END_VAR
END_METHOD

METHOD GETUSERS4 : DWORD
VAR_INPUT
	PCLIENTDATA : POINTER TO VisuElems.VisuStructClientData;
	DWUSERDB : DWORD;
	UDISTARTINDEX : UDINT;
	UDIENDINDEX : UDINT;
	PARR : POINTER TO ARRAY [0..0] OF VUM_UserInternal;
	UDIARRSIZE : UDINT;
END_VAR
END_METHOD

METHOD LOGOUTRTS
VAR_INPUT
	PCLIENTDATA : POINTER TO VisuElems.VisuStructClientData;
END_VAR
END_METHOD