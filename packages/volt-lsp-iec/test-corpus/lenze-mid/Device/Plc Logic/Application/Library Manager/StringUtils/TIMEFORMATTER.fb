	UIMIRCOSECONDS : UINT;
END_VAR
END_METHOD

METHOD SETFORMATSTRING
VAR_INPUT
	SFORMATSTRING : STRING(MAX_FORMAT_STRING_LENGTH);
END_VAR
END_METHOD