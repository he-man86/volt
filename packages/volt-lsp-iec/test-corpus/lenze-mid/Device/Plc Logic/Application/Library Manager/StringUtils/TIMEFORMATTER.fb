	M_CBSPLACEHOLDER1DIGITHOUR24HOURCLOCK : CharBufferString;
	M_CBSPLACEHOLDER2DIGITHOUR12HOURCLOCK : CharBufferString;
	M_CBSPLACEHOLDER1DIGITHOUR12HOURCLOCK : CharBufferString;
	M_CBSPLACEHOLDER2DIGITMINUTE : CharBufferString;
	M_CBSPLACEHOLDER1DIGITMINUTE : CharBufferString;
	M_CBSPLACEHOLDER2DIGITSECOND : CharBufferString;
	M_CBSPLACEHOLDER1DIGITSECOND : CharBufferString;
	M_CBSPLACEHOLDER3DIGITMILLISECOND : CharBufferString;
	M_CBSPLACEHOLDER3DIGITMICROSECOND : CharBufferString;
	M_CBSPLACEHOLDERAMPMDESIGNATOR : CharBufferString;
