INTERFACE L_TS2P_ISYNCIN
END_INTERFACE

METHOD SYNCIN : BOOL
VAR_INPUT
	XENABLE : BOOL;
	XSYNCIN : BOOL;
	LRCYCMASTERPOS : LREAL;
	LRCYCMASTERVEL : LREAL;
	LRCYCMASTERACC : LREAL;
	LRCYCSLAVEPOS : LREAL;
	LRCYCSLAVEVEL : LREAL;
	LRCYCSLAVEACC : LREAL;
	LRVEL : LREAL := 100;
	LRACC : LREAL := 1000.0;
	LRDEC : LREAL := 1000.0;
	LRJERK : LREAL := 1000000.0;
END_VAR
VAR_OUTPUT
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	XBUSY : BOOL;
	XDONE : BOOL;
	XSYNCHRONISED : BOOL;
	XACCDECSYNC : BOOL;
	LRSETSLAVEPOSOUT : LREAL;
	LRSETSLAVEVELOUT : LREAL;
	LRSETSLAVEACCOUT : LREAL;
END_VAR
END_METHOD