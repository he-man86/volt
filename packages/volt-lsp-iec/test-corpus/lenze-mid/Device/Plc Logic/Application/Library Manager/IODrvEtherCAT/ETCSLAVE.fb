FUNCTION_BLOCK ETCSLAVE
VAR_INPUT
	XSETOPERATIONAL : BOOL;
END_VAR
VAR_OUTPUT
	XDONE : BOOL;
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORCODE : L_ETC_ERRORCODE;
	WSTATE : WORD;
END_VAR
VAR
	M_PIOCONFIGCONNECTOR : POINTER TO IoConfigConnector;
	M_SZPATH : STRING;
	M_SZNAME : STRING;
	M_DWVENDORID : DWORD;
	M_DWPRODUCTID : DWORD;
	M_DWREVISIONID : DWORD;
	M_UIPHYSSLAVEADDR : UINT;
	M_XDCENABLE : BOOL;
	M_XSETOPERATIONALLAST : BOOL;
	M_WSLAVESTATEACT : WORD;
	FBSLAVE2 : ETCSlave2;
	MODULEHANDLERBASE : L_IMHP_ModuleHandler;
	M_SCOMMPATH : STRING(199);
	SLAVEADDRESS : UINT;
	M_ITFEVENTCALLBACK : CmpEventMgr.ICmpEventCallback;
	M_HEVENTUPDATECONFIGURATIONDONE : RTS_IEC_HANDLE;
	M_HINTERFACEUPDATECONFIGURATIONDONE : RTS_IEC_HANDLE;
	DCENABLE : BOOL;
	IODRVETHERCAT : POINTER TO L_IODrvEtherCAT;
	ISMANDATORY : BOOL;
	ISPRESENT : BOOL;
	MODULEHANDLER : L_IMHP_IModuleHandler;
	NAME : STRING;
	PHYSSLAVEADDR : UINT;
	WCSTATE : BOOL;
END_VAR
END_FUNCTION_BLOCK

METHOD INITIALIZE : UDINT
VAR_INPUT
