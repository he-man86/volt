END_VAR
VAR
	M_UDICONNECTORSPERCYCLE : UDINT;
	M_XLASTENABLE : BOOL := FALSE;
	M_BYSTATE : BYTE;
	M_BYSLAVEOFFSET : BYTE;
	M_SIMODULEOFFSET : SINT;
	M_PCONNECTORLIST : POINTER TO IoConfigConnector;
	M_UDICONNECTORLISTCOUNT : UDINT;
	M_PPARAMETERLIST : POINTER TO IoStandard.IoConfigParameter;
	M_UDIPARAMETERCOUNT : UDINT;
END_VAR
END_FUNCTION_BLOCK

