	BYSCANCTXCOUNT : BYTE;
	UDICONNECTORSPERCYCLE : UDINT;
	XINCLUDEDEVICETYPE : BOOL;
END_VAR
VAR_OUTPUT
	ERESULT : SysTypes.RTS_IEC_RESULT;
