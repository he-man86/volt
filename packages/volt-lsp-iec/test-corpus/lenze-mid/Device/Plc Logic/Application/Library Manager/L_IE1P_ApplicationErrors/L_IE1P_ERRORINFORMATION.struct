TYPE L_IE1P_ERRORINFORMATION :
STRUCT
	EERRORID : L_IE1P_Error;
	WCOMPID : WORD;
	ESEVERITY : L_IE1P_SeverityLevel;
	PSINSTANCENAME : POINTER TO STRING;
	INSTANCEID : DWORD := 0;
	TTIMESTAMP : TIME;
	TRESETTIMESTAMP : TIME;
	XCYCLIC : BOOL;
	DWEXTENDEDERRORINFO : DWORD;
	XEXTERNALERROR : BOOL;
	XCLEARERRORNEEDED : BOOL;
END_STRUCT
END_TYPE