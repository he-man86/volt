INTERFACE ICOMMFBDIAGPROVIDER
END_INTERFACE

METHOD CHECKOWNER : BOOL
VAR_INPUT
	ID : UDINT;
END_VAR
END_METHOD

METHOD GETALARM : DWORD
VAR_INPUT
	MODE : INT;
	F_ID : DWORD;
END_VAR
VAR_OUTPUT
	NEW : BOOL;
	ID : DWORD;
	LEN : INT;
END_VAR
VAR_IN_OUT
	AINFO : AINFO_TYPE;
	CURRENTALARMID : UDINT;
END_VAR
END_METHOD

METHOD GETDIAG : DWORD
VAR_INPUT
	ID : DWORD;
END_VAR
VAR_OUTPUT
	BUSY : BOOL;
	LEN : INT;
END_VAR
VAR_IN_OUT
	DINFO : DP_DIAG;
END_VAR
END_METHOD