TYPE OPCUA_CALLMETHODRESULT :
STRUCT
	STATUSCODE : OpcUa_StatusCode;
	NOOFINPUTARGUMENTRESULTS : OpcUa_Int32;
	INPUTARGUMENTRESULTS : POINTER TO OpcUa_StatusCode;
	NOOFINPUTARGUMENTDIAGNOSTICINFOS : OpcUa_Int32;
	INPUTARGUMENTDIAGNOSTICINFOS : POINTER TO OpcUa_DiagnosticInfo;
	NOOFOUTPUTARGUMENTS : OpcUa_Int32;
	OUTPUTARGUMENTS : POINTER TO OpcUa_Variant;
END_STRUCT
END_TYPE