FUNCTION_BLOCK MC_GROUPREADERROR EXTENDS L_MC4P_Template_AG_REF
VAR_INPUT
	ENABLE : BOOL;
END_VAR
VAR_OUTPUT
	VALID : BOOL;
	BUSY : BOOL;
	ERROR : BOOL;
	ERRORID : L_IE1P_Error;
	GROUPWARNING : BOOL;
	GROUPERROR : BOOL;
	GROUPERRORID : L_IE1P_Error;
	PINSTANCENAME : POINTER TO STRING := ADR(NoError);
	TIMESTAMP : TIME;
END_VAR
VAR
	XENABLEOLD : BOOL;
	NOERROR : STRING := '';
END_VAR
END_FUNCTION_BLOCK