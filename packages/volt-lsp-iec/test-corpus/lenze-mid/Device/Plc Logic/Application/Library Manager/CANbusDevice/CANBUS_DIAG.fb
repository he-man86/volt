END_VAR
END_METHOD

METHOD GETBUSDIAGNOSISINFO : DED.ERROR
VAR_INPUT
	PDATA : CAA.PVOID;
	SZSIZE : CAA.SIZE;
END_VAR
VAR_OUTPUT
	SZCOUNT : CAA.SIZE;
END_VAR
END_METHOD

METHOD GETBUSERRORASYNC : DED.PROC_STATE
VAR_INPUT
	ECMD : DED.PROC_CMD;
END_VAR
VAR_OUTPUT
	EERROR : DED.ERROR;
END_VAR
VAR_IN_OUT
	ERIBUSERROR : DED.ERROR_INFO;
END_VAR
END_METHOD

METHOD GETBUSINFO : DED.ERROR
VAR_IN_OUT
	BUIINFO : DED.BUS_INFO;
END_VAR
END_METHOD

METHOD GETBUSSTATE : DED.BUS_STATE
VAR_OUTPUT
	XDIAGNOSISINFOAVAILABLE : BOOL;
	EERROR : DED.ERROR;
END_VAR
END_METHOD

METHOD GETQOS : DED.ERROR
VAR_IN_OUT
	QUALITYINFO : DED.QOS_INFO;
END_VAR
END_METHOD

METHOD GETSPECIFICBUSSTATE : DED.ERROR
VAR_INPUT
	PDATA : CAA.PVOID;
	SZSIZE : CAA.SIZE;
END_VAR
VAR_OUTPUT
