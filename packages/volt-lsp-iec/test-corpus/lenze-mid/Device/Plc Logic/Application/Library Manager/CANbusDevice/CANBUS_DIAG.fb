END_VAR
END_METHOD

METHOD INITIALIZE_DIAG : UDINT
VAR_INPUT
	PCONNECTOR : POINTER TO IoStandard.IoConfigConnector;
	NCONNECTORCOUNT : DINT;
	PARENT : POINTER TO DED.INode;
	CHILDREN : POINTER TO DED.INode;
	UDICHILDCOUNT : UDINT;
END_VAR
END_METHOD

METHOD RECONFIGUREASYNC : PROC_STATE
VAR_INPUT
	ECMD : PROC_CMD;
	ITFSENDER : INode;
END_VAR
