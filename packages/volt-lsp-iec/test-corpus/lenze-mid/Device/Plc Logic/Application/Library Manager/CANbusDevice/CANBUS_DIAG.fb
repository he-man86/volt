FUNCTION_BLOCK CANBUS_DIAG EXTENDS CANbus
VAR
	_DIAG : DED.CAADiagnosisBase;
	_TREE : DED.CAADiagTreeBase;
	_RECONFIGURE : DED.CAAReconfigureBase;
	_BYRECONFIGURESTATE : BYTE;
	_XRECONFIGUREACTIVE : BOOL;
	_WPREPAREDBAUDRATE : WORD;
	_DWPREPAREDNETID : DWORD;
	CHILDNODECOUNT : CAA.COUNT;
	CONNECTOR : POINTER TO IoStandard.IoConfigConnector;
	ENABLE : BOOL;
	FIRSTCHILDNODE : DED.INode;
	INDEX : UDINT;
	ISROOTNODE : BOOL;
	NEXTSIBLINGNODE : DED.INode;
	PARENTNODE : DED.INode;
	RECONFIGUREACTIVE : BOOL;
	SIBLINGIRP : IReconfigureProvider;
	SIBLINGNODECOUNT : CAA.COUNT;
END_VAR
END_FUNCTION_BLOCK

METHOD INITIALIZE : UDINT
VAR_INPUT
	WMODULETYPE : UINT;
	DWINSTANCE : UDINT;
	PCONNECTOR : POINTER TO IoConfigConnector;
END_VAR
END_METHOD

METHOD SETBAUDRATE
VAR_INPUT
