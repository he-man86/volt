FUNCTION_BLOCK ALARMSERVICEHANDLERBUFFERPROVIDER
VAR
	M_PAUDIALARMGROUPS : POINTER TO ARRAY [0..0] OF UDINT;
	M_PAUDIALARMCLASSES : POINTER TO ARRAY [0..0] OF UDINT;
	M_PALATCHVARIABLES : POINTER TO ARRAY [0..0] OF LatchVariable;
	M_PAALARMSTOACKBUFFER : POINTER TO ARRAY [0..0] OF AlarmToAcknowledge;
	M_ICOUNTALARMGROUPS : INT;
	M_ICOUNTALARMCLASSES : INT;
	M_ICOUNTLATCHVARIABLES : INT;
	M_ICOUNTALARMSTOACK : INT;
	COMPONENT : STRING := 'AlarmFilterCriteriaBufferProvider';
END_VAR
END_FUNCTION_BLOCK

METHOD ALLOCATEALARMCLASSFILTERBUFFER : POINTER TO ARRAY [0..0] OF UDINT
VAR_INPUT
	IREQUIREDMINIMUMSIZE : INT;
END_VAR
END_METHOD

METHOD ALLOCATEALARMGROUPFILTERBUFFER : POINTER TO ARRAY [0..0] OF UDINT
VAR_INPUT
	IREQUIREDMINIMUMSIZE : INT;
END_VAR
END_METHOD

METHOD ALLOCATEALARMSTOACKBUFFER : POINTER TO ARRAY [0..0] OF AlarmToAcknowledge
VAR_INPUT
	IREQUIREDMINIMUMSIZE : INT;
END_VAR
END_METHOD

METHOD ALLOCATELATCHVARIABLESBUFFER : POINTER TO ARRAY [0..0] OF LatchVariable
VAR_INPUT
	IREQUIREDMINIMUMSIZE : INT;
END_VAR
END_METHOD

METHOD FB_EXIT : BOOL
VAR_INPUT
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD FREEBUFFERS
VAR_INPUT
	XFREEALARMGROUPSBUFFER : BOOL;
	XFREEALARMCLASSESBUFFER : BOOL;
	XFREELATCHVARIABLES : BOOL;
	XFREEALARMSTOACKBUFFER : BOOL;
END_VAR
END_METHOD