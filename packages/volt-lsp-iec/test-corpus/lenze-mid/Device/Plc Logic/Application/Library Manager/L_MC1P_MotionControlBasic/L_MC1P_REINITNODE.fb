FUNCTION_BLOCK L_MC1P_REINITNODE EXTENDS L_MC1P_Template
VAR_INPUT
	XEXECUTE : BOOL;
END_VAR
VAR_OUTPUT
	XDONE : BOOL;
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
END_VAR
VAR
	XEXECUTEOLD : BOOL;
	XRESETOUTPUT : BOOL;
	PWDUMMY : POINTER TO WORD;
	RESET : MC_Reset;
	XRESET : BOOL;
	_MCCALL : L_UM1P_MCMultipleCall;
	INPUTDATA : ARRAY [1.._MCCall.c_BufferDepthInput] OF L_MC1P_ReinitNodeInput;
	OUTPUTDATA : ARRAY [1.._MCCall.c_BufferDepthOutput] OF L_MC1P_ReinitNodeOutput;
END_VAR
END_FUNCTION_BLOCK