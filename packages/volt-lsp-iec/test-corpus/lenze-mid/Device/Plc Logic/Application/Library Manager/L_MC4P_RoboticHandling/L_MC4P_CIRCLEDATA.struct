TYPE L_MC4P_CIRCLEDATA :
STRUCT
	RESERVED : ARRAY [1..SIZEOF(L_MC4P_PathData)] OF BYTE;
	ALRCENTERPOINT : ARRAY [1..3] OF LREAL;
	LAMBDA_MAX : LREAL;
	ORIGIN_LAMBDA_MAX : LREAL;
	R_S : ARRAY [1..3, 1..3] OF LREAL;
	ORIGIN_R_S : ARRAY [1..3, 1..3] OF LREAL;
	PATHCHOICE : MC_CIRC_PATHCHOICE;
	ALR_RN_CIRC : ARRAY [1..3] OF LREAL;
	RADIUS : LREAL;
END_STRUCT
END_TYPE