FUNCTION_BLOCK MC_GEARIN EXTENDS L_MC2P_MasterSlaveSync
VAR_INPUT
	EXECUTE : BOOL;
	CONTINUOUSUPDATE : BOOL := FALSE;
	RATIONUMERATOR : INT := 1;
	RATIODENOMINATOR : UINT := 1;
	MASTERVALUESOURCE : MC_SOURCE := MC_SOURCE.mcSetValue;
	ACCELERATION : LREAL := 3600.0;
	DECELERATION : LREAL := 3600.0;
	JERK : LREAL := 0.0;
	BUFFERMODE : MC_BUFFER_MODE := MC_Buffer_Mode.mcAborting;
END_VAR
VAR_OUTPUT
	INGEAR : BOOL;
	BUSY : BOOL;
	ACTIVE : BOOL;
	COMMANDABORTED : BOOL;
	ERROR : BOOL;
	ERRORID : L_IE1P_Error;
END_VAR
VAR
	L_MC2P_CLUTCHBASIC1 : L_MC2P_ClutchBasic;
	L_MC2P_MODIFYAXIS1 : L_MC2P_ModifyAxis;
	L_MC2P_AXISCONVERTER1 : L_MC2P_AxisConverterBase;
	SCINPUTMASTERSOURCE : L_MC2P_AxisProfile;
	SCINPUTMASTERSCALED : L_MC2P_AxisProfile;
	SCACTSLAVE : L_MC2P_AxisProfile;
	SCOUTPUTSLAVE : L_MC2P_AxisProfile;
	LRPOSDIFF : LREAL;
	LRSETSCALING : LREAL;
	IRATIONUMERATOR_INT : INT;
	UIRATIODENOMINATOR_INT : UINT := 1;
	EMASTERVALUESOURCE_INT : MC_SOURCE;
	LRACCELERATION_INT : LREAL;
	LRDECELERATION_INT : LREAL;
	LRJERK_INT : LREAL;
	LROFFSET : LREAL;
	_L_MC2P_MASTERCONVERTERTOSLAVELEGTH : L_MC2P_AxisConverterBase;
	_SCINPUTMASTERCONVERTERTED : L_MC2P_AxisProfile;
	_XAXISCONVERTERCONVERTERTED : BOOL;
	LRMASTERACCOLD : LREAL;
	LRJERKFACDEFAULT : LREAL := 1;
	_MCCALL : L_UM1P_MCCall;
	_INPUTDATA : ARRAY [1..2] OF L_MC2P_GearInInput;
	_OUTPUTDATA : ARRAY [1..2] OF L_MC2P_GearInOutput;
	_PINPUTDATA2 : POINTER TO L_MC2P_GearInInput;
	_POUTPUTDATA2 : POINTER TO L_MC2P_GearInOutput;
END_VAR
END_FUNCTION_BLOCK