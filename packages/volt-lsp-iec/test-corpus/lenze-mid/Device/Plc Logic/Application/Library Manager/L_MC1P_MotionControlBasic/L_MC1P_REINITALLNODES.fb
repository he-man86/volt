FUNCTION_BLOCK L_MC1P_REINITALLNODES
VAR_INPUT
	XEXECUTE : BOOL;
	XINITCOMMUNICATION : BOOL := TRUE;
END_VAR
VAR_OUTPUT
	XDONE : BOOL;
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
END_VAR
VAR
	PAXIS : POINTER TO AXIS_REF;
	DIIDX : DINT;
	ISTEP : INT;
	PWDUMMY : POINTER TO WORD;
	XERROR_INT : BOOL;
	XDONE_INT : BOOL;
	XRESETOUTPUT : BOOL;
	XEXECUTEOLD : BOOL;
	XREALAXISAVAILABLE : BOOL;
	DIFIRSTREALAXISINIT : DINT;
END_VAR
END_FUNCTION_BLOCK