FUNCTION_BLOCK L_MC4P_MOVECIRCULARRELATIVE_INTERNAL EXTENDS L_MC4P_MoveContPath
VAR_INPUT
	EXECUTE : BOOL;
	CIRCMODE : L_MC4P_CircMode;
	AUXPOINT : ARRAY [1..12] OF LREAL;
	ENDPOINT : ARRAY [1..12] OF LREAL;
	PATHCHOICE : MC_CIRC_PATHCHOICE;
	VELOCITY : LREAL;
	ACCELERATION : LREAL;
	DECELERATION : LREAL;
	JERK : LREAL;
	COORDSYSTEM : L_MC4P_CoordSystem;
	BUFFERMODE : MC_BUFFER_MODE;
	TRANSITIONMODE : MC_TRANSITION_MODE;
	TRANSITIONPARAMETER : ARRAY [1..12] OF LREAL := [12(0)];
	AEAUXMODE : ARRAY [1..6] OF L_MC4P_AuxMode;
	ORIENTATIONMODE : L_MC4P_Orientation_Mode := L_MC4P_Orientation_Mode.ShortestSpacialWay;
	DIRECTION : ARRAY [4..6] OF MC_DIRECTION := [3(MC_DIRECTION.mcShortestWay)];
END_VAR
VAR_OUTPUT
	DONE : BOOL;
	BUSY : BOOL;
	ACTIVE : BOOL;
	COMMANDABORTED : BOOL;
	ERROR : BOOL;
	ERRORID : L_IE1P_Error;
END_VAR
VAR
	CLASSID : L_UBUP_ClassID;
END_VAR
END_FUNCTION_BLOCK

METHOD HOMINGREQUIRED : BOOL
END_METHOD

