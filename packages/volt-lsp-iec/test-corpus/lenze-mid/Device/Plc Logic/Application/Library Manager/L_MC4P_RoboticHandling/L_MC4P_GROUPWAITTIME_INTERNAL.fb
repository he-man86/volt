FUNCTION_BLOCK L_MC4P_GROUPWAITTIME_INTERNAL EXTENDS L_MC4P_MoveContPath
VAR_INPUT
	XEXECUTE : BOOL;
	LRTIME : LREAL;
END_VAR
VAR_OUTPUT
	XDONE : BOOL;
	XBUSY : BOOL;
	XACTIVE : BOOL;
	XCOMMANDABORTED : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
END_VAR
VAR
	LRTIME_INPUT : LREAL;
	AEAUXMODE : ARRAY [1..6] OF L_MC4P_AuxMode := [6(L_MC4P_AuxMode.Inactive)];
	TRANSITIONPARAMETER : ARRAY [1..12] OF LREAL := [12(0)];
	COORDSYSTEM : L_MC4P_CoordSystem;
	BUFFERMODE : MC_BUFFER_MODE;
	TRANSITIONMODE : MC_TRANSITION_MODE;
	CLASSID : DINT;
END_VAR
END_FUNCTION_BLOCK