INTERFACE IVISUUSERMANAGEMENT3
END_INTERFACE

METHOD CHANGEPASSWORD : VUM_ReturnValues
VAR_INPUT
	PCLIENT : POINTER TO BYTE;
	WSTUSERNAME : WSTRING(79);
	WSTNEWPASSWORD : WSTRING(79);
	WSTOLDPASSWORD : WSTRING(79);
END_VAR
END_METHOD

METHOD LOGIN : VUM_ReturnValues
VAR_INPUT
	PCLIENT : POINTER TO BYTE;
	WSTUSERNAME : WSTRING(79);
	WSTPASSWORD : WSTRING(79);
END_VAR
VAR_OUTPUT
	WSTFULLNAMEIFAVAILABLE : WSTRING;
	DWUSERGROUPID : DWORD;
	ADWUSERGROUPIDS : ARRAY [0..VUM_Constants.VISU_VUM_MAX_GROUPS_PER_USER] OF DWORD;
	DWUSERGROUPCOUNT : DWORD;
	BDEACTIVATED : BOOL;
END_VAR
END_METHOD

METHOD LOGOUT : VUM_ReturnValues
VAR_INPUT
	PCLIENT : POINTER TO BYTE;
END_VAR
END_METHOD

METHOD USERCOUNT : UDINT
VAR_INPUT
	PCLIENT : POINTER TO BYTE;
END_VAR
VAR_OUTPUT
	RESULT : VUM_ReturnValues;
END_VAR
END_METHOD

METHOD USERS : VUM_ReturnValues
VAR_INPUT
	PCLIENT : POINTER TO BYTE;
	UDISTARTINDEX : UDINT;
	UDIENDINDEX : UDINT;
	PARR : POINTER TO ARRAY [0..0] OF VUM_User2;
	UDIARRSIZE : UDINT;
END_VAR
END_METHOD