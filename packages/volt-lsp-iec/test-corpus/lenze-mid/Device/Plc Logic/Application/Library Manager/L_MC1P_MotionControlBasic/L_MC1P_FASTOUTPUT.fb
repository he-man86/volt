FUNCTION_BLOCK L_MC1P_FASTOUTPUT EXTENDS L_MC1P_Template
VAR_INPUT
	XEXECUTE : BOOL;
	XABORT : BOOL;
	BYDIGITALOUTPUTSEL : BYTE := 1;
