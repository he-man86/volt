	SNPOSDIFFCALCCOUNTER : SINT;
	RES : INT;
	WRINGBUFFERINDEX : WORD;
	LRVELRINGBUFFER : ARRAY [0..wEncFilterCycles] OF LREAL;
	LRVELFILTERBUFFERSUM : LREAL;
	LRPOSDIFFINFILT : LREAL;
	XFLAGBUFFERFULL : BOOL;
	LRAXISPOSITION : LREAL;
	LRAXISVELOCITY : LREAL;
	LRAXISACCELERATION : LREAL;
	FOUTPUTTIMERTICKTRIGGEREVENT : LREAL;
	LRDELAYCOMPENSATION : LREAL := 0;
	XDONTSWITCH : BOOL;
	XBUSYINTERN : BOOL := FALSE;
	BYDIGITALOUTPUTSEL_INT : BYTE := 1;
	XOUTPUTSTATE_INT : BOOL;
	LRSWITCHPOSITION_INT : LREAL;
	WEXTERNALDELAYCOMPENSATION_INT : WORD;
	LRDYNVELPOSOFFSET_INT : LREAL;
	XDISABLEACCCALC_INT : BOOL := FALSE;
	EVALUESOURCE_INT : MC_SOURCE;
	BYMAXOUTPCOUNT : BYTE;
	LRDELAYFACTOR : LREAL;
	WENCFILTERCYCLES : WORD := 10;
END_VAR
END_FUNCTION_BLOCK

