END_VAR
VAR
	BEXCECUTEOLD : BOOL;
	BABORTEDOLD : BOOL;
	BRESETOLD : BOOL;
	PFREEENCODERAXIS : POINTER TO _Axis_Ref_Enc_BPB;
	FOUTPUTTIMERTICK : LREAL;
