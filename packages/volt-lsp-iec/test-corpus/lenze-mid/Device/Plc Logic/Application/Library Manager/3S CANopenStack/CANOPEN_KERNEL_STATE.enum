TYPE CANOPEN_KERNEL_STATE :
(
	NO_ERROR := ANYNUM_TO_WORD(CS.CANOPEN_KERNEL_ERROR.CANOPEN_KERNEL_NO_ERROR),
	DATA_OVERFLOW := ANYNUM_TO_WORD(CS.CANOPEN_KERNEL_ERROR.CANOPEN_KERNEL_DATA_OVERFLOW),
	CANBUS_OFF := ANYNUM_TO_WORD(CS.CANOPEN_KERNEL_ERROR.CANOPEN_KERNEL_CANBUS_OFF),
	CAN_ERROR_PASSIVE := ANYNUM_TO_WORD(CS.CANOPEN_KERNEL_ERROR.CANOPEN_KERNEL_CAN_ERROR_PASSIVE),
	NO_MORE_MEMORY := ANYNUM_TO_WORD(CS.CANOPEN_KERNEL_ERROR.CANOPEN_NO_MORE_MEMORY),
	NO_DRIVER := ANYNUM_TO_WORD(CS.CANOPEN_KERNEL_ERROR.CANOPEN_NO_DRIVER),
	CONFIGURATION_ERROR := ANYNUM_TO_WORD(CS.CANOPEN_KERNEL_ERROR.CANOPEN_CONFIGURATION_ERROR),
	GUARDING_ERROR := ANYNUM_TO_WORD(CS.CANOPEN_KERNEL_ERROR.CANOPEN_GUARDING_ERROR)
);
END_TYPE