	TONWAITTIME : TON;
	TONREADTIME : TON;
	XFIRSTINIT : BOOL;
	TONEXECUTETIME : TON;
	XSTARTEXECUTETIMER : BOOL;
	I : INT;
	RTRIGXEXECUTE : R_TRIG;
END_VAR
END_FUNCTION_BLOCK