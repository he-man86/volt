FUNCTION_BLOCK L_READERRORFROMFILE
VAR_INPUT
	XENABLE : BOOL;
	XEXECUTE : BOOL;
	XSTOREALLERRORTEXT : BOOL;
	XSTORETEXREFIDERRORTEXT : BOOL;
	XSTOREALLAPPTEXREFIDERRORTEXT : BOOL;
	XSTOPIFERRORFOUND : BOOL;
	XCONTINUOUSREAD : BOOL;
	XREPEAT : BOOL;
	XINIT : BOOL;
	XCLEARERRORARRAYS : BOOL;
	SCIN : scReadErrorFromFileIN;
END_VAR
VAR_OUTPUT
	XFINDERROR : BOOL;
	XERROR : BOOL;
	XBUSY : BOOL;
	XDONE : BOOL;
	SCOUT : scReadErrorfromFileOUT;
END_VAR
VAR_IN_OUT
	ASERRORTEXT : ARRAY [0..GVL_ReadErrorFromFile.imaxErrorTextArraySize] OF STRING(255);
	ADWERRORID : ARRAY [0..GVL_ReadErrorFromFile.imaxErrorTextArraySize] OF DWORD;
END_VAR
VAR
	OPENFILE : FILE.Open;
	XEXEOPENFILE : BOOL;
	EFILEMODE : FILE.MODE;
	GETSIZEFILE : FILE.GetSize;
	XEXEGETSIZEFILE : BOOL;
	READFILE : FILE.Read;
	XEXEREADFILE : BOOL;
