	SZSIZEREADFILE : FILE.CAA.SIZE;
	AREADBUFFERARRAY : ARRAY [0..GVL_ReadErrorFromFile.imaxReadSize] OF BYTE;
	CLOSEFILE : FILE.Close;
	XEXECLOSEFILE : BOOL;
	FBFINDERRORINFILE : L_FindErrorInFile;
	XEXEFINDERROR : BOOL;
	SERRORLINE : STRING(255);
	XSTARTWAITTIME : BOOL;
