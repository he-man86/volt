INTERFACE L_TS2P_ISYNCPOSBASE
END_INTERFACE

METHOD ADDOFFSET
VAR_INPUT
	ITFTECHMODULE : L_TS2P_ISyncPosBase;
	LRSETPOS : LREAL;
	LRSETVEL : LREAL;
	LRSETOFFSET : LREAL;
	LRSETOFFSETVEL : LREAL;
	ETRAVERSINGRANGE : L_MC1P.L_MC1P_TraversingRange;
	LRCYCLELENGTH : LREAL;
END_VAR
VAR_OUTPUT
	XERROR : BOOL;
	EERRORID : L_IE1P.L_IE1P_Error;
	LRSETPOSOUT : LREAL;
	LRSETVELOUT : LREAL;
END_VAR
END_METHOD

METHOD CLUTCH
VAR_INPUT
	ITFTECHMODULE : L_TS2P_ISyncPosBase;
	XENABLE : BOOL;
	XSYNCIN : BOOL;
	LRSETBASEVELOCITY : LREAL;
	ESYNCMODE : L_TB2P_SyncMode;
	EALLOWEDDIRECTION : L_TB2P_AllowedDirection;
