	LRSYNCACC : LREAL;
	LRSYNCDEC : LREAL;
	LRSYNCJERK : LREAL;
	LRSYNCINDIST : LREAL;
	LRSYNCOUTDIST : LREAL;
	LRSYNCOUTPOS : LREAL;
	XLOADCLUTCHOFFSET : BOOL;
	LRLOADCLUTCHOFFSET : LREAL;
	LRCYCLICMASTERPOS : LREAL;
	LRCYCLICMASTERVEL : LREAL;
	ETRAVERSINGRANGEMASTER : L_MC1P_TraversingRange;
	LRCYCLELENGTHMASTER : LREAL;
	LRCYCLICAXISPOS : LREAL;
	LRCYCLICAXISVEL : LREAL;
	LRCYCLICAXISACC : LREAL;
