	IPARDATASZ : INT;
	IPARRECSZ : INT;
	PIOBUFFER : POINTER TO BYTE;
	AWIOBUFFER : ARRAY [0..((((SIZEOF(PAR_FILE_HDR) + SIZEOF(PAR_DATA_HDR)) - 1) / SIZEOF(WORD)) + 1)] OF WORD;
