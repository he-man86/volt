	BFIRSTDOWNLOADBYMANAGERDONE : BOOL;
	BEXECUTENEWDOWNLOADWITHOUTDOWNLAODMANAGER : BOOL;
	XEXISTALLFILES : BOOL;
	XCONTROL_DEBUG : BOOL;
