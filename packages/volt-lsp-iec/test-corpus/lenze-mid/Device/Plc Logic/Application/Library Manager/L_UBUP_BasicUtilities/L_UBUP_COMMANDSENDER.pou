	XBUSY : BOOL;
	XACTIVE : BOOL;
	XCOMMANDABORTED : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	DWCALLID : DWORD := L_UBUP_Internal.g_dwCallIDUnassigned;
	ITFJOB : L_UBUP_IJob;
END_VAR
VAR
	_ECOMMANDTYPE : L_UBUP_CommandType;
	_PREPORT : POINTER TO L_UBUP_ReportData;
	_XREPORTVALID : BOOL;
	_XCYCLICSLAVE : BOOL;
	_ITFJOBPOOL : L_UBUP_IFBPool;
	_ITFJOBRECEIVER : L_UBUP_IJobReceiver;
	_ITFACTUALJOB : L_UBUP_IJob;
	_MODEL : L_UBUP_BehaviourModel_ETrigA;
	JOBCLASSID : DINT;
END_VAR
END_FUNCTION_BLOCK

