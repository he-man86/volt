INTERFACE IBUS
END_INTERFACE

METHOD GETBUSDIAGNOSISINFO : ERROR
VAR_INPUT
	PDATA : CAA.PVOID;
	SZSIZE : CAA.SIZE;
END_VAR
VAR_OUTPUT
	SZCOUNT : CAA.SIZE;
END_VAR
END_METHOD

METHOD GETBUSERRORASYNC : PROC_STATE
VAR_INPUT
	ECMD : PROC_CMD;
END_VAR
VAR_OUTPUT
	EERROR : ERROR;
END_VAR
VAR_IN_OUT
	ERIBUSERROR : ERROR_INFO;
END_VAR
END_METHOD

METHOD GETBUSINFO : ERROR
VAR_IN_OUT
	BUIINFO : BUS_INFO;
END_VAR
END_METHOD

METHOD GETBUSSTATE : BUS_STATE
VAR_OUTPUT
	XDIAGNOSISINFOAVAILABLE : BOOL;
	EERROR : ERROR;
END_VAR
END_METHOD

METHOD GETQOS : ERROR
VAR_IN_OUT
	QUALITYINFO : QOS_INFO;
END_VAR
END_METHOD

METHOD GETSPECIFICBUSSTATE : ERROR
VAR_INPUT
	PDATA : CAA.PVOID;
	SZSIZE : CAA.SIZE;
END_VAR
VAR_OUTPUT
	SZCOUNT : CAA.SIZE;
END_VAR
END_METHOD