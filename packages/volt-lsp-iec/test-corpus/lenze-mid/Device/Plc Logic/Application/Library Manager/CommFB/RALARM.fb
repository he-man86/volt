FUNCTION_BLOCK RALARM
VAR_INPUT
	EN : BOOL;
	MODE : INT;
	F_ID : DWORD;
END_VAR
VAR_OUTPUT
	ENO : BOOL;
	NEW : BOOL;
	STATUS : DWORD;
	ID : DWORD;
	LEN : INT;
END_VAR
VAR_IN_OUT
	AINFO : AINFO_TYPE;
END_VAR
VAR
	S_INSTANCEHANDLER : InstanceHandler;
	M_EN : BOOL;
	M_MODE : INT;
	M_F_ID : DWORD;
	M_FACTORY : ICommFBDiagProvider;
	M_CURRENTALARMID : UDINT := Constants.INVALID_ID;
END_VAR
END_FUNCTION_BLOCK