INTERFACE IRTSSERVICEHANDLER
END_INTERFACE

METHOD EVENTCALLBACK : UDINT
VAR_INPUT
	PEVENTPARAM : POINTER TO EventParam;
END_VAR
END_METHOD

METHOD GETSERVICEGROUP : ServiceGroup
END_METHOD

METHOD HANDLESERVICE : ERROR
VAR_INPUT
	PPARAMETERS : POINTER TO SERVICEHANDLER_PARAMETER;
END_VAR
END_METHOD

METHOD STARTSERVICE : ERROR
VAR_INPUT
	SGSERVICEGROUP : ServiceGroup;
END_VAR
END_METHOD

METHOD STOPSERVICE : ERROR
END_METHOD