	XPHASE1COMPLETED : BOOL := FALSE;
	XPHASE2COMPLETED : BOOL := FALSE;
	XPROCEEDWITHPHASE2B : BOOL := FALSE;
	DNPROFILETASKCYCLECOUNT : DINT := 0;
	PAXISREAL : POINTER TO _Axis_Ref_Real;
	PBRAKE : POINTER TO L_MC1P_BrakeControlBase;
	XBRAKEAPPLIED : BOOL := FALSE;
	XBRAKERELEASED : BOOL := FALSE;
	DWSIZE : INT;
	XALLOCMEMORY : INT;
	XFREEMEMORY : INT;
	XINITSTEP : INT;
	XIGNOREQUALITY : BOOL := FALSE;
	WWAITAFTERINSTABILITY : WORD;
	WIDENTSTEPTMP : WORD;
	WINSTABILITYSTEPS : WORD;
	DWNEXTSTEP : DWORD;
	XINSTABILITYDETECTED : BOOL := FALSE;
	LRINSTABILITYFACTOR : LREAL := 0.45;
	LRSTEPFACTOR_PCT : LREAL := 100;
	XOPTIMIZETNN : BOOL := FALSE;
	XMAXPARAMVALUESETTED : BOOL := FALSE;
	XMINPARAMVALUESETTED : BOOL := FALSE;
	WMAXVALUECOUNTER : WORD;
	WMINVALUECOUNTER : WORD;
	XWAITTIMERON : BOOL;
	XWAITTIMERONOLD : BOOL;
	DWWAITTIMECNTR : WORD;
	XWAITTIMEREACHED : BOOL;
	XQUALITYCRITERIAENABLEOLD : BOOL;
	LRWAITINGTIME : LREAL;
	WWAITAFTERINSTABILITYINACTIVE : WORD;
END_VAR
END_FUNCTION_BLOCK

