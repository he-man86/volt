FUNCTION_BLOCK L_CT1P_CA_PERFORMAUTOTUNING
VAR_INPUT
	XEXECAUTOTUNEVPN : BOOL := FALSE;
	XEXECAUTOTUNETNN : BOOL := FALSE;
	XEXECAUTOTUNEVPP : BOOL := FALSE;
	XSTOP : BOOL := FALSE;
	RSCCOREDATA : REFERENCE TO L_CT1P_CA_CoreData;
	RDEVICEPARAMMANAGER : REFERENCE TO L_CT1P_CA_DeviceParamManager;
	RPROFILEGENERATOR : REFERENCE TO L_CT1P_CA_ProfileGenerator;
	RMONITORING : REFERENCE TO L_CT1P_CA_Monitoring;
	RQUALITYCRITERIA : REFERENCE TO L_CT1P_CA_QualityCriteria;
	LRSTEPFACTOR : LREAL;
END_VAR
VAR_OUTPUT
	XBUSY : BOOL := FALSE;
	XDONE : BOOL := FALSE;
	XERROR : BOOL := FALSE;
	EERRORID : L_IE1P_Error := L_IE1P_Error.NoError;
END_VAR
VAR_IN_OUT
