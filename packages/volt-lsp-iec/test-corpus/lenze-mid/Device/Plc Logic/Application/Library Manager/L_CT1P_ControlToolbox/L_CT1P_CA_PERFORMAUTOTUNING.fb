	RTEXECAUTOTUNETNN : R_TRIG;
	RTEXECAUTOTUNEVPP : R_TRIG;
	XSTOPSEEN : BOOL := FALSE;
	RSCACTPARAM : REFERENCE TO L_CT1P_CA_DeviceParam;
