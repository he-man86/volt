END_VAR
END_METHOD

METHOD STARTACTION
VAR_OUTPUT
	XCOMPLETE : BOOL := TRUE;
	IERRORID : INT := 0;
END_VAR
END_METHOD

METHOD ABORTMODEL : ERROR
VAR_INPUT
