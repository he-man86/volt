	XABORT : BOOL := xAbortProposed;
	IERRORID : INT := iErrorIDProposed;
END_VAR
END_METHOD

METHOD CYCLICACTION
VAR_INPUT
	ITFTIMINGCONTROLLER : _ITimingController;
END_VAR
VAR_OUTPUT
