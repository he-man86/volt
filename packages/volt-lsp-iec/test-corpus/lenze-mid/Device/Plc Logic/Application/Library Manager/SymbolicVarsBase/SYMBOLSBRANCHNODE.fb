FUNCTION_BLOCK SYMBOLSBRANCHNODE EXTENDS SymbolsBaseNode
VAR
	_PCHILDREN : POINTER TO ARRAY [0..0] OF POINTER TO SymbolsBaseNode;
	_PCHILDRENBYBROWSENAME : POINTER TO POINTER TO SymbolsBaseNode;
	_ICHILDCOUNT : DINT;
	INSTANCEPATHNODETYPE : InstancePathBuildingNodeType;
	MEMBERINDEX : DINT;
	NUMCHILDS : DINT;
END_VAR
END_FUNCTION_BLOCK

METHOD FINDCHILD : ITreeWalker
VAR_INPUT
	SZCHILDNAME : POINTER TO BYTE;
	NAMELEN : __XWORD;
	SYMBOLSSETS : DWORD;
	VARINFO : REFERENCE TO VariableInformation;
	PRESULT : POINTER TO RTS_IEC_RESULT;
END_VAR
VAR_IN_OUT
	TYPESYSTEMREACHED : BOOL;
END_VAR
END_METHOD

METHOD GETBYBROWSENAMEINDEX : ITreeWalker
VAR_INPUT
	PBROWSENAME : POINTER TO OpcUa_QualifiedName;
	VARINFO : REFERENCE TO VariableInformation;
END_VAR
VAR_OUTPUT
	RESULT : RTS_IEC_RESULT;
END_VAR
END_METHOD

METHOD GETCHILDBYBROWSENAME : ITreeWalker
VAR_INPUT
	PBROWSENAME : POINTER TO OpcUa_QualifiedName;
	VARINFO : REFERENCE TO VariableInformation;
END_VAR
END_METHOD

METHOD GETCHILDBYINDEX : ITreeWalker
VAR_INPUT
	IINDEX : DINT;
	USERACCESSRIGHTS : BYTE;
	SYMBOLSSETS : DWORD;
END_VAR
VAR_OUTPUT
	XOUTOFRANGE : BOOL;
END_VAR
END_METHOD

METHOD GETFIRSTCHILD : ITreeWalker
VAR_INPUT
	USERACCESSRIGHTS : BYTE;
	SYMBOLSSETS : DWORD;
END_VAR
