VAR_GLOBAL
	COMPONENT_NAME : STRING(6) := 'CANbus';
	COMPONENTID_CANBUSDEVICE : DWORD := 16#101F;
	DIAG_PARAM_ID : UDINT := 16#50100;
	OPEN_TAG_LENGTH : BYTE := 4;
	CLOSE_TAG_LENGTH : BYTE := (OPEN_TAG_LENGTH + 1);
	MAXIMUM_UDINT_LENGTH : BYTE := 10;
	MAXIMUM_ULINT_LENGTH : BYTE := 20;
	MAXIMUM_PARAM_LENGTH : BYTE := ((OPEN_TAG_LENGTH + MAXIMUM_UDINT_LENGTH) + CLOSE_TAG_LENGTH);
END_VAR