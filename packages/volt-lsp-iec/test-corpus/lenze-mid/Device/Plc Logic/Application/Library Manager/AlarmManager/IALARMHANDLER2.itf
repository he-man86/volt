INTERFACE IALARMHANDLER2
END_INTERFACE

METHOD GETACTIVEALARMS : UDINT
VAR_INPUT
	ITFALARMMANAGERCLIENT : IAlarmManagerClient;
END_VAR
VAR_OUTPUT
	PARRITFACTIVEALARMS : POINTER TO ARRAY [0..0] OF IAlarm;
	ICOUNTACTIVEALARMS : INT;
END_VAR
END_METHOD

METHOD GETALARMSFROMSTORAGE : UDINT
VAR_INPUT
	ITFALARMMANAGERCLIENT : IAlarmManagerClient;
	ISKIPROWS : INT;
END_VAR
VAR_OUTPUT
	ICOUNTROWS : INT;
END_VAR
VAR_IN_OUT
	BROWIDVALID : BOOL;
	DIROWID : DINT;
END_VAR
END_METHOD

METHOD GETCOUNTALARMSFROMSTORAGE : DINT
VAR_INPUT
	ITFALARMMANAGERCLIENT : IAlarmManagerClient;
END_VAR
VAR_OUTPUT
	UDIRESULT : UDINT;
END_VAR
END_METHOD

METHOD REGISTERCLIENT : UDINT
VAR_INPUT
	ITFALARMMANAGERCLIENT : IAlarmManagerClient;
	PARRITFALARMSFROMHISTORY : POINTER TO ARRAY [0..0] OF IAlarm2;
	ICOUNTALARMSFROMHISTORY : INT;
END_VAR
END_METHOD

METHOD UNREGISTERCLIENT : UDINT
VAR_INPUT
	ITFALARMMANAGERCLIENT : IAlarmManagerClient;
END_VAR
END_METHOD