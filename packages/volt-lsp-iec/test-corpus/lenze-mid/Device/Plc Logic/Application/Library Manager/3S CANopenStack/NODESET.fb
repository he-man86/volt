FUNCTION_BLOCK NODESET
VAR
	AUINODES : ARRAY [0..7] OF UINT;
	XTHREADSAFE : BOOL;
	DWSEMA : SysTypes.RTS_IEC_HANDLE;
	USIMAXACTIVE : USINT;
	USICURRENTACTIVE : USINT;
	UINOLIMITATIONNODEID : UINT;
END_VAR
END_FUNCTION_BLOCK

METHOD ACTIVATE : BOOL
VAR_INPUT
	USINODEID : USINT;
END_VAR
END_METHOD

METHOD DEACTIVATE : BOOL
VAR_INPUT
	USINODEID : USINT;
END_VAR
END_METHOD

METHOD FB_EXIT : BOOL
VAR_INPUT
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD FB_INIT : BOOL
VAR_INPUT
	BINITRETAINS : BOOL;
	BINCOPYCODE : BOOL;
	XTHREADSAFE : BOOL := TRUE;
END_VAR
END_METHOD

METHOD FB_REINIT : BOOL
END_METHOD

METHOD ISACTIVE : BOOL
VAR_INPUT
	USINODEID : USINT;
END_VAR
END_METHOD