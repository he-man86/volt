FUNCTION_BLOCK MC_WRITEPARAMETER EXTENDS L_MC1P_Template_NoAxis
VAR_INPUT
	AXIS : L_MC1P_IMCParameterAccess;
	EXECUTE : BOOL;
	PARAMETERNUMBER : DINT;
	VALUE : LREAL;
	EXECUTIONMODE : MC_EXECUTION_MODE;
END_VAR
VAR_OUTPUT
	DONE : BOOL;
	BUSY : BOOL;
	ERROR : BOOL;
	ERRORID : L_IE1P_Error;
END_VAR
VAR
	XEXECUTEOLD : BOOL := FALSE;
	XRESETOUTPUT : BOOL := FALSE;
	AXISOLD : L_MC1P_IMCParameterAccess;
	L_DCO_WRITEDRIVEPARAMETER1 : L_DCO_WriteDriveParameter;
	DWPARAMETERNUMBERINT : DWORD;
	WERRORID_INT : WORD;
	PAXISREF : POINTER TO AXIS_REF;
	PINSTANCE : POINTER TO BYTE;
	EAXISTYPE : L_MC1P_AxisType;
	_MCCALL : L_UM1P_MCMultipleCall;
	INPUTDATA : ARRAY [1.._MCCall.c_BufferDepthInput] OF L_MC1P_WriteParameterInput;
	OUTPUTDATA : ARRAY [1.._MCCall.c_BufferDepthOutput] OF L_MC1P_WriteParameterOutput;
	POUTPUTDATA : POINTER TO L_MC1P_WriteParameterOutput;
	ITFSETPOINTINFO : L_UM1P_ISetpointInfo;
	XAXISTASKIDXVALID : BOOL;
	IAXISTASKIDX : INT;
END_VAR
END_FUNCTION_BLOCK