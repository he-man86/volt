	XERRORY_INT : BOOL;
	EERRORIDY_INT : L_IE1P_Error;
	XBUSYX_INT : BOOL;
	XBUSYY_INT : BOOL;
	XACTIVEX_INT : BOOL;
	XACTIVEY_INT : BOOL;
	XWAITSTARTX : BOOL;
	XWAITSTARTY : BOOL;
	XEXECUTEXOLD : BOOL;
	XEXECUTEYOLD : BOOL;
	XEXECUTEY_INT : BOOL;
	XEXECUTEX_INT : BOOL;
	XENABLECALCULATION : BOOL;
	XWAITPROFILEGENERATIONX : BOOL;
	XWAITPROFILEGENERATIONY : BOOL;
	XSTARTMANIPULATION : BOOL;
	XRESETOUTPUTX : BOOL := TRUE;
	XRESETOUTPUTY : BOOL := TRUE;
