	LRTIMECOUNTER : LREAL;
	LRCORRECTTIMEBASEX : LREAL;
	LRCORRECTTIMEBASEY : LREAL;
	SCACTBUFFERDATA : L_MC1P_BufferData;
	XACHSE : WORD := 1;
	YACHSE : WORD := 2;
	C_NOTCOORDINATED : WORD := 0;
	C_SYNCSTARTSTOP : WORD := 1;
	C_ASYNCSTARTSYNCSTOP : WORD := 2;
