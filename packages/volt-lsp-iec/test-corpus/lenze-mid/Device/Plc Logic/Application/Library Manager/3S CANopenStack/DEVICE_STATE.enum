TYPE DEVICE_STATE :
(
	INIT := ANYNUM_TO_INT(CS.DEVICE_STATE.INIT),
	RESET_COMM := ANYNUM_TO_INT(CS.DEVICE_STATE.RESET_COMM),
	RESET_APP := ANYNUM_TO_INT(CS.DEVICE_STATE.RESET_APP),
	PRE_OPERATIONAL := ANYNUM_TO_INT(CS.DEVICE_STATE.PRE_OPERATIONAL),
	STOPPED := ANYNUM_TO_INT(CS.DEVICE_STATE.STOPPED),
	OPERATIONAL := ANYNUM_TO_INT(CS.DEVICE_STATE.OPERATIONAL),
	UNKNOWN := ANYNUM_TO_INT(CS.DEVICE_STATE.UNKNOWN),
	NOT_AVAIL := ANYNUM_TO_INT(CS.DEVICE_STATE.NOT_AVAIL)
);
END_TYPE