FUNCTION_BLOCK SHMCOMMDRV
VAR
	_XWASINITIALIZED : BOOL := FALSE;
	_PBYSHM : POINTER TO BYTE := 0;
	_PBYSHMREADINFO : POINTER TO BYTE := 0;
	_PBYSHMWRITEINFO : POINTER TO BYTE := 0;
	_PBYSHMDATA : POINTER TO BYTE := 0;
	_SHMDRV : ShmDrv;
	_SZCOMMDRVADR : STRING := 'init';
	_UDISHMTIMEOUT : UDINT := SHM_GCL.TIMEOUT_DEFAULT;
	_UISHMCOMMBUFFERSIZE : UINT := SHM_GCL.COMMBUFFERSIZE_DEFAULT;
	COMMBUFFERSIZE : UINT;
	COMMDEVADDRESS : STRING;
	COMMDRVID : FSPSBUSDRV;
	COMMTIMEOUT : UDINT;
END_VAR
END_FUNCTION_BLOCK

METHOD GETSHMREADSIZE : UINT
END_METHOD

