METHOD RELEASESHMFORREAD : RTS_IEC_RESULT
END_METHOD

METHOD RELEASESHMFORWRITE : RTS_IEC_RESULT
END_METHOD

METHOD RESERVESHMFORWRITE : RTS_IEC_RESULT
