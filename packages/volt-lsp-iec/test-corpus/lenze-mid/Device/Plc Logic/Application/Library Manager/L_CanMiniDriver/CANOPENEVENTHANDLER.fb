	PCANOPENMANAGER : POINTER TO L_CANOpenManager;
END_VAR
VAR
	ABYLOCKFLAGS : ARRAY [0..127] OF BYTE;
	ABYPARTRANSFERSTARTFLAGS : ARRAY [0..127] OF BYTE;
END_VAR
END_FUNCTION_BLOCK

METHOD EVENTCALLBACK : BOOL
VAR_INPUT
	EEVENT : _3SCOS.CANopenEvent;
	USINODEID : USINT;
END_VAR
END_METHOD

METHOD PARAXFERREADYFORTRANSFER : BOOL
VAR_INPUT
	WNODEID : WORD;
END_VAR
END_METHOD

METHOD PARAXFERLOCKHANDLER : BOOL
VAR_INPUT
	BLOCK : BOOL;
	WNODEID : WORD;
END_VAR
VAR_OUTPUT
