INTERFACE IRECIPEDEFINITION
END_INTERFACE

METHOD CREATERECIPE : BOOL
VAR_INPUT
	STNAME : STRING;
	BREADCURRENT : BOOL;
	BSAVE : BOOL;
END_VAR
END_METHOD

METHOD FREERECIPE : BOOL
VAR_INPUT
	RECIPE : IRecipe;
END_VAR
END_METHOD

METHOD GETPERSISTENCYHELPER : POINTER TO IPersistentRecipeHelper
END_METHOD

METHOD GETRECIPE : RecipeDescription
VAR_INPUT
	IINDEX : INT;
END_VAR
END_METHOD

METHOD GETRECIPEINDEXBYNAME : INT
VAR_INPUT
	STNAME : STRING;
END_VAR
END_METHOD

METHOD GETRECIPENAME : STRING
VAR_INPUT
	IINDEX : INT;
END_VAR
END_METHOD

METHOD GETRECIPENAMES : DWORD
VAR_INPUT
	PSTRINGS : POINTER TO ARRAY [0..0] OF STRING;
	ISIZE : INT;
	ISTARTINDEX : INT;
END_VAR
END_METHOD

METHOD GETRECIPEVALUES : DWORD
VAR_INPUT
	PSTRINGS : POINTER TO ARRAY [0..0] OF STRING;
	ISIZE : INT;
	ISTARTINDEX : INT;
	ISTRINGLENGTH : INT;
END_VAR
END_METHOD

METHOD GETRECIPEVARIABLENAMES : DWORD
VAR_INPUT
	PSTRINGS : POINTER TO ARRAY [0..0] OF STRING;
	ISIZE : INT;
	ISTARTINDEX : INT;
END_VAR
END_METHOD

METHOD LOADALL : BOOL
VAR_INPUT
	BCLEAR : BOOL;
END_VAR
END_METHOD

METHOD REGISTEREVENTHANDLER : BOOL
VAR_INPUT
	HANDLER : IRecipeDefinitionEventHandler;
END_VAR
END_METHOD

METHOD RELOAD : DWORD
END_METHOD

METHOD SAVEALL : BOOL
END_METHOD

METHOD SELECTRECIPE : BOOL
VAR_INPUT
	IINDEX : INT;
END_VAR
END_METHOD

METHOD SETRECIPEVALUES : DWORD
VAR_INPUT
	PSTRINGS : POINTER TO ARRAY [0..0] OF STRING;
	ISIZE : INT;
	ISTARTINDEX : INT;
END_VAR
END_METHOD

METHOD UNREGISTEREVENTHANDLER : BOOL
VAR_INPUT
	HANDLER : IRecipeDefinitionEventHandler;
END_VAR
END_METHOD