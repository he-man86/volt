	ITFALARM : IAlarm;
	ESTATEOLD : AlarmState;
	ESTATENEW : AlarmState;
	ESTATETRANSITION : AlarmStateTransition;
END_VAR
END_METHOD

METHOD DEACTIVATIONSTATECHANGED : BOOL
VAR_INPUT
