TYPE APPLICATION :
STRUCT
	PAPPPARENT : POINTER TO APPLICATION;
	IID : UDINT;
	CODEGUID : ARRAY [0..15] OF BYTE;
	DATAGUID : ARRAY [0..15] OF BYTE;
	UDISTATE : UDINT;
	UDIOPSTATE : UDINT;
	HBOOTPROJECT : RTS_IEC_HANDLE;
	HDEBUGTASK : RTS_IEC_HANDLE;
	PFGLOBALINIT : POINTER TO BYTE;
	PFGLOBALEXIT : POINTER TO BYTE;
	HSESSIONIDPOOL : RTS_IEC_HANDLE;
	HFORCEPOOL : RTS_IEC_HANDLE;
	HBPPOOL : RTS_IEC_HANDLE;
	BPERSISTENTFORCE : DINT;
	SZNAME : STRING(MAX_LEN_APPLNAME);
	UDIPSVERSION : UDINT;
	UDITARGETSETTINGVERSION : UDINT;
END_STRUCT
END_TYPE