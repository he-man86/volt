	AFBPARWRITE : ARRAY [1..c_SdoMaxNum] OF L_MC1P_ParSimWrite;
	XRESTARTOLD : BOOL;
	ERRORREAD : L_MC1P_ParameterDataSim;
	ERRORWRITE : L_MC1P_ParameterDataSim;
	C_SDOMAXNUM : WORD := 10;
END_VAR
END_FUNCTION_BLOCK

