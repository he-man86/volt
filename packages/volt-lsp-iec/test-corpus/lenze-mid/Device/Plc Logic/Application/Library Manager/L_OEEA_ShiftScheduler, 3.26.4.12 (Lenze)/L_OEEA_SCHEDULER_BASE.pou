	PEERROR : POINTER TO DTU.ERROR;
	XFIRSTPLCCYCLE : BOOL;
	XPOWERONCYCLEDETETCED : BOOL;
	XSHIFTDAYCHANGEDETECTED : BOOL;
	XSHIFTDAYSTARTDETECTED : BOOL;
	XSHIFTDAYSTARTWAITINGTIME : BOOL;
	XSHIFTDAYENDDETECTED : BOOL;
	XALLSHIFTDATAPROLONGED : BOOL;
	TONPROLONGTIMER : ARRAY [1..6] OF TON;
