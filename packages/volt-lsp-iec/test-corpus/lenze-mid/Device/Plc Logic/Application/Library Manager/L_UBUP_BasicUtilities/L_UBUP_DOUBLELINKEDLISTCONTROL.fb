	_DWNODESCOUNT : DWORD;
	_DWELMCOUNT : DWORD;
	_DWFIRST : DWORD;
	_DWLAST : DWORD;
	_XLISTISEMPTY : BOOL := TRUE;
	_XLISTISFULL : BOOL := FALSE;
	_DWCURRENT : DWORD;
	COUNT : DWORD;
	CURRENT : DWORD;
	HASNEXT : BOOL;
	HASPREV : BOOL;
	ISEMPTY : BOOL;
	ISFULL : BOOL;
END_VAR
END_FUNCTION_BLOCK

