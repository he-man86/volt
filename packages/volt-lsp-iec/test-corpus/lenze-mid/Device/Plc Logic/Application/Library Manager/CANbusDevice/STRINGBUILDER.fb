FUNCTION_BLOCK STRINGBUILDER
VAR
	_PBYSTRING : POINTER TO BYTE;
	_PBYENDPOS : POINTER TO BYTE;
	_PBYPOS : POINTER TO BYTE;
	_BYPARAMS : BYTE;
	OPENTAG : STRING(GlobalConstants.OPEN_TAG_LENGTH) := '<p >';
	CLOSETAG : STRING((GlobalConstants.OPEN_TAG_LENGTH + 1)) := '</p >';
END_VAR
END_FUNCTION_BLOCK

METHOD ADDPARAMETER : BOOL
VAR_INPUT
	UDIPARAMVALUE : UDINT;
END_VAR
END_METHOD

METHOD ADDSTRINGPARAMETER : BOOL
VAR_INPUT
	PTEXT : POINTER TO STRING;
END_VAR
END_METHOD

METHOD ADDULINTPARAMETER : BOOL
VAR_INPUT
	ULIPARAMVALUE : ULINT;
END_VAR
END_METHOD

METHOD APPEND : BOOL
VAR_INPUT
	PTEXT : POINTER TO STRING;
END_VAR
END_METHOD

METHOD APPENDBYTEARRAYPARAMETER : BOOL
VAR_INPUT
	PBYDATA : POINTER TO BYTE;
	UDIDATASIZE : UDINT;
END_VAR
END_METHOD

METHOD INIT
VAR_INPUT
	PBYSTRING : POINTER TO BYTE;
	UDILENGTH : UDINT;
END_VAR
END_METHOD

METHOD RESET
END_METHOD