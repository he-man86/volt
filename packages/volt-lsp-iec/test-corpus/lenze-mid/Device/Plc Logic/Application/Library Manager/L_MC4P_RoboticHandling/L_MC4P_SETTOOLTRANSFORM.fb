FUNCTION_BLOCK L_MC4P_SETTOOLTRANSFORM EXTENDS L_MC4P_Template_AG_KIN
VAR_INPUT
	XEXECUTE : BOOL;
	SCTOOLPARAMETER : L_MC4P_TOOL_REF;
	ETOOLSYSTEM : L_MC4P_ToolSystem;
END_VAR
VAR_OUTPUT
	XDONE : BOOL;
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error := L_IE1P_Error.NoError;
END_VAR
VAR
	PTOOL : POINTER TO L_MC4P_ToolTrafo;
	XEXECUTEOLD : BOOL;
	XRESETOUTPUT : BOOL;
	AXPARACCESSIBLE : ARRAY [1..7] OF BOOL;
	IDX : DINT;
	XINTERNALTESTMODE : BOOL := FALSE;
	INTERNALTESTMODE : BOOL;
END_VAR
END_FUNCTION_BLOCK