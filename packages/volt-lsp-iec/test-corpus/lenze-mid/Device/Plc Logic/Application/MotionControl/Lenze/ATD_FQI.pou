FUNCTION_BLOCK ATD_FQI
VAR_INPUT
	lrAcc: LREAL:=1600;
	lrDec: LREAL:=1600;
	
END_VAR
VAR_OUTPUT
END_VAR
VAR
	BasicSpeed: L_MC1P_BasicActuatingSpeed;
	OffDelay: TOF;
END_VAR
VAR_IN_OUT
	ioAxis: AXIS_REF;
	DataIO: sUDT_FQIComm_Drive;;
END_VAR
%LANGUAGE LD
%NETWORK "Return when virtual axis"
RETURN(ioAxis.xVirtual);
%NETWORK
%WIRES w1
OffDelay(IN := DataIO.Controlword.Bit4_RunForward, PT := T#1S, Q => w1);
BasicSpeed(Axis := ioAxis, xEnableInternalControl := TRUE, xRegulatorOn := w1, xResetError := DataIO.Controlword.Bit7_ResetFault, xSetDriveQsp := DataIO.Controlword.Bit2_QuickStop, xEnableSetVel := DataIO.Controlword.Bit4_RunForward, xInvertDirection := DataIO.Controlword.Bit12_ReverseDirection, lrSetVel := DataIO.RefSpeed, lrSetAcc := lrAcc, lrSetDec := lrDec, xAxisReady => DataIO.Status.Bit0_ReadyForOperation, xDriveError => DataIO.Status.Bit3_Fault);

END_FUNCTION_BLOCK
