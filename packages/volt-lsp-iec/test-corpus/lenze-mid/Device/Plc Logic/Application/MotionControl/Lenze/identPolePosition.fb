	xDone=> , 
	xBusy=> , 
	xError=> , 
	eErrorCode=> , 
	udiSdoAbort=> , 
	abyData=> , 
	szDataRead=> );
	
L_ETC_CoE_SdoWrite4(
	xExecute:= , 
	xAbort:= , 
	usiCom:= , 
	uiDevice:=uiDevice , 
	wIndex:= , 
	bySubindex:= , 
	udiTimeOut:=100 , 
