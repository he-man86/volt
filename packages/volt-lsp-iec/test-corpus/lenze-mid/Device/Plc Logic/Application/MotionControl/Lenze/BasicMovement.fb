METHOD BrakeLogic 
VAR_INPUT
	
END_VAR
VAR_INST
	BrakeInterface			: L_MC1P_BrakeInterface; 
END_VAR

VAR

END_VAR
BrakeInterface(
	Axis:= ioSlaveAxis, 
	xEnable:= NOT ioSlaveAxis.xVirtual , 
	xReleaseBrake:= Control_Local.ReleaseBrake, 
	lrTorqueAdd:= , 
	xBrakeModeActivate:= , 
	eBrakeMode:= , 
	xValid=> , 
	xBusy=> , 
	xError=> , 
	eErrorID=> , 
	xBrakeReleaseOut=> , 
	xBrakeReleased=> , 
	lrActTorque=> , 
	lrStartingTorqueSaved=> , 
	lrStartingTorqueEffective=> , 
	eBrakeModeActive=> );
END_METHOD

METHOD ReadInputs 
VAR_INPUT
END_VAR
//activate internal control
IF NOT internalControl THEN
	Control_Local	:= ioDataExchange.Control;
END_IF
END_METHOD

METHOD SetTorqueLimits 
VAR_INPUT
	
END_VAR
VAR_INST
	TorqueLimit						: L_MC1P_SetTorqueLimit;
	lrRefTorqueAxis					: LREAL;
	lrActTorqueProcent				: LREAL;
	ResetError						: L_IE1P_ResetError;
END_VAR

VAR

END_VAR
//Max torque on the axis. If the machine doesn't stop due to a programming error, this part ensures that the torque never gets too high. 
TorqueLimit(											
	Axis:= ioSlaveAxis, 
	xEnable:= NOT ioSlaveAxis.xVirtual ,  
	xSetTorqueLimitPos:= TRUE, 
	lrTorqueLimitPos:= (Control_Local.TorqueLimit/100)*1.1, 				//The max torque allowed on the axis is 10% higher then the alarm value. 
	xSetTorqueLimitNeg:= TRUE, 
	lrTorqueLimitNeg:= (Control_Local.TorqueLimit/100)*1.1, 				//The max torque allowed on the axis is 10% higher then the alarm value. 
	xTorqueInputAsPercent:= TRUE,
	xBusy=> , 
	xError=> , 
	eErrorID=> );

lrRefTorqueAxis := L_MC1P_GetRatedTorqueAxis(Axis:=ioSlaveAxis); 
//Torque limit error 
IF lrRefTorqueAxis > 0 THEN 
	lrActTorqueProcent := ABS(ioSlaveAxis.lrActTorque/lrRefTorqueAxis); 
END_IF

SetTorqueError(
	ModuleHandler:= , 
	ErrorHandler:=ioSlaveAxis , 
	xSetError:=lrActTorqueProcent > (Control_Local.TorqueLimit/100) , 
	eSeverity:=L_IE1P_SeverityLevel.Fault_QspAppl , 
	wTextRefId:= ATD_Errorlist, 
	wErrorId:= 1, 
	eReaction:= , 
	eGroup:= , 
	xError=> , 
	eErrorID=> , 
	scErrorInformation=> );
	
ResetError(
	ModuleHandler:= , 
	ErrorHandler:=ioSlaveAxis , 
	xResetError:=AxisControl.xResetError , 
	xError=> , 
	eErrorID=> , 
	xErrorResetActive=> , 
	xResetActive=> );
END_METHOD

METHOD WriteOutputs
VAR_INPUT
END_VAR
VAR_INST

END_VAR
ioDataExchange.Status.DriveCommAlive				:= ioSlaveAxis.xCommunicationOK;
ioDataExchange.Status.ReadyForOperation				:= AxisControl.xReadyForOperation;
ioDataExchange.Status.ReadyForMotion				:= AxisControl.xReadyForMotion;
ioDataExchange.Status.HomingPosOK					:= AxisControl.xIsHomed;
ioDataExchange.Status.InPosition					;//writen in statemachine
ioDataExchange.Status.VelocitySetpointReached		;//writen in statemachine
ioDataExchange.Status.ActSpeed						:= AxisControl.lrActVel;
ioDataExchange.Status.ActPos						:= AxisControl.lrActPos;
END_METHOD
