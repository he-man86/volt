FUNCTION_BLOCK BasicMovement
//Dataexchange CONTROL ===========
VAR_IN_OUT
	ioDataExchange					:  sUDT_BasicMovementComm_Drive;
END_VAR
VAR_INPUT
	TouchProbeSensor				: BOOL;
	i_lrWindowStandstill			: LREAL;	
	i_lrJogVel						: LREAL;
END_VAR
VAR_OUTPUT
END_VAR
VAR
	//ControlWord
	internalControl					:	BOOL;
	Control_Local			 		:	sUDT_BasicMovementComm_Drive_Control;			//output to plc
	
	//StatusWord 

	//instance 
	AxisControl						: L_TB2P_BasicMotionBase;	
	SetTorqueError					: L_IE1P_SetErrorSingle;		
END_VAR
VAR_IN_OUT
	ioSlaveAxis						: AXIS_REF; 
END_VAR

ReadInputs();
BasicMotionParameters();
BasicMotion();
SetTorqueLimits();
BrakeLogic();
WriteOutputs();

END_FUNCTION_BLOCK

METHOD BasicMotion
VAR_INPUT
END_VAR
VAR_INST
	intPositioningState		: INT;
	R_TRIG_TP				: R_TRIG;
	SetIntQspRamp			: L_SetIntQspRamp;
	lrDecErrorStopOld		: LREAL;
END_VAR
VAR
	
END_VAR
R_TRIG_TP(CLK:=TouchProbeSensor , Q=> );

CASE intPositioningState OF
	0:	(* Wait for synchronisation *)
		AxisControl.scCtrlBasicMotion.xMoveAbsExecute := FALSE;
		AxisControl.scCtrlBasicMotion.xMoveRelExecute := FALSE;
		AxisControl.scCtrlBasicMotion.xMoveVelExecute := FALSE;
		AxisControl.scCtrlBasicMotion.xHalt := FALSE;
		
		IF Control_Local.StartAbsPos THEN
			intPositioningState:=10;
		ELSIF Control_Local.StartRelPos THEN
			intPositioningState:=20;
		ELSIF Control_Local.StartVelocity THEN
			intPositioningState:=30;
		ELSIF Control_Local.StartTouchprobePos THEN
			intPositioningState:=40;
		ELSIF Control_Local.StartTorqueMode THEN
			intPositioningState:=50;
		END_IF
		
///////////////////////////////////////////////////////////////////////////
///////////////////////////////Move absolute///////////////////////////////
///////////////////////////////////////////////////////////////////////////

	10:	(*Move absolute to position*)
		AxisControl.scPar.lrAcc := Control_Local.AccUnit;
		AxisControl.scPar.lrDec := Control_Local.DecUnit;
		AxisControl.scPar.lrVel  := Control_Local.VelUnit;
		AxisControl.scCtrlBasicMotion.lrPos_Dist := Control_Local.PosUnit;	
	
		AxisControl.scCtrlBasicMotion.xMoveAbsExecute := TRUE;
		
		IF AxisControl.scStatusBasicMotion.xFunDone THEN
			ioDataExchange.Status.InPosition:=TRUE;
			intPositioningState:=15;
		ELSIF NOT Control_Local.StartAbsPos THEN
			intPositioningState:=100;
		END_IF
		
	15:	IF NOT Control_Local.StartAbsPos THEN
			ioDataExchange.Status.InPosition:=FALSE;
			intPositioningState:=0;
		END_IF
	
///////////////////////////////////////////////////////////////////////////
/////////////////////////////Move Touchprobe///////////////////////////////
///////////////////////////////////////////////////////////////////////////
	40:	(*Move Touchprobe*)
		AxisControl.scPar.lrAcc := Control_Local.AccUnit;
		AxisControl.scPar.lrDec := Control_Local.DecUnit;
		AxisControl.scPar.lrVel := Control_Local.VelUnit;
	
		AxisControl.scCtrlBasicMotion.xMoveVelExecute := TRUE;
		
		IF R_TRIG_TP.Q THEN
			AxisControl.scCtrlBasicMotion.lrPos_Dist := Control_Local.PosUnit;			
			AxisControl.scCtrlBasicMotion.xMoveRelExecute := TRUE;
			intPositioningState:=41;
		ELSIF NOT Control_Local.StartTouchprobePos THEN
			intPositioningState:=100;
		END_IF
		
	41://wait for positioning done
		IF AxisControl.scStatusBasicMotion.xFunDone THEN
			ioDataExchange.Status.InPosition:=TRUE;
			intPositioningState:=45;
		ELSIF NOT Control_Local.StartTouchprobePos THEN
			intPositioningState:=100;			
		END_IF	
	
	45:	IF NOT Control_Local.StartTouchprobePos THEN
			ioDataExchange.Status.InPosition:=FALSE;
			intPositioningState:=0;
		END_IF
	
///////////////////////////////////////////////////////////////////////////
///////////////////////////////Stop movement///////////////////////////////
///////////////////////////////////////////////////////////////////////////
	100:(*Stop absolute movement*)
		AxisControl.scCtrlBasicMotion.xHalt := TRUE;
		
		IF AxisControl.scStatusBasicMotion.xStandstillSetVelocity THEN
			intPositioningState:=0;
		END_IF
	
END_CASE; 


//R_TRIG_TP(CLK:=TouchProbeSensor , Q=> );

AxisControl.scCtrlBasicMotion.xResetHomePosition:=Control_Local.ResetHomePos;

AxisControl(
	xEnable:= TRUE, 
	xEnableOperation:=Control_Local.Enable , 
	xResetError:=Control_Local.ResetError , 
	xQSPApplication:= , 
	xAbort:= , 
	xJogPos:= , 
	xJogNeg:= , 
	xHomeExecute:= Control_Local.ActivateHoming, 
	lrOverride:= , 
	scCtrlBasicMotion:= , 
	scPar:= , 
	Axis:=ioSlaveAxis , 
	xReadyForOperation=> , 
	xOperationEnabled=> , 
	xReadyForMotion=> , 
	xError=> , 
	xWarning=> , 
	eErrorID=> , 
	xSTOActive=> , 
	xQSPActive=> , 
	xAbortBusy=> , 
	xAbortDone=> , 
	xJoggingBusy=> , 
	xHomingBusy=> , 
	xHomingDone=> , 
	xIsHomed=> , 
	eTMState=> , 
	scStatusBasicMotion=> , 
	lrActVel=> , 
	lrSetVelOut=> , 
	lrActPos=> , 
	lrSetPosOut=> , 
	lrActFollowingError=> );
	
SetIntQspRamp(
	Axis:=ioSlaveAxis , 
	xExecute:=ioSlaveAxis.xAxisAvailable AND NOT ioSlaveAxis.xVirtual AND (lrDecErrorStopOld=ioSlaveAxis.lrDecErrorStop) , 
	lrQspRamp:=ioSlaveAxis.lrDecErrorStop , 
	lrQspTime:= , 
	xUseQspTime:= , 
	xBusy=> , 
	xDone=> , 
	xError=> , 
	eErrorID=> );
lrDecErrorStopOld:=ioSlaveAxis.lrDecErrorStop;
END_METHOD

METHOD BasicMotionParameters
VAR_INPUT
END_VAR
