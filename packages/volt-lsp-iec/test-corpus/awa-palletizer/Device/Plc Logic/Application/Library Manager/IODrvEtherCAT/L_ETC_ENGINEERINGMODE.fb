FUNCTION_BLOCK L_ETC_ENGINEERINGMODE
VAR_INPUT
	USICOM : USINT := 1;
	XENABLE : BOOL;
END_VAR
VAR_OUTPUT
	XBUSY : BOOL;
	XACTIVE : BOOL;
	XERROR : BOOL;
	EERRORCODE : L_ETC_ERRORCODE;
	ESTATE : L_ETC_ENGMODE_STATE;
END_VAR
VAR
	USTEP : UINT := 0;
	XENABLEPRE : BOOL;
	CMD : L_ETC_CMD_T;
	RESULT : DWORD;
	SMSTATE : UDINT;
	FBMASTER : POINTER TO L_IODrvEtherCAT;
END_VAR
END_FUNCTION_BLOCK