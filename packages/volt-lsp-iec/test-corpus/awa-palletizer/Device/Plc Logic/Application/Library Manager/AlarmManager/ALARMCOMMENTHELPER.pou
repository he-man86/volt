FUNCTION_BLOCK ALARMCOMMENTHELPER
END_FUNCTION_BLOCK

METHOD COPYWSTRINGTOALARMCOMMENT : BOOL
VAR_INPUT
	PWSCOMMENT : POINTER TO WSTRING;
	PWSUSERID : POINTER TO WSTRING;
END_VAR
VAR_IN_OUT
	ALARMCOMMENT : AlarmComment;
END_VAR
END_METHOD

METHOD FREEALARMCOMMENT : BOOL
VAR_IN_OUT
	ALARMCOMMENT : AlarmComment;
END_VAR
END_METHOD