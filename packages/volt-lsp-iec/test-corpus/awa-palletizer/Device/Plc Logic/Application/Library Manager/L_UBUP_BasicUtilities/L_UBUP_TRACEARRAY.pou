FUNCTION_BLOCK L_UBUP_TRACEARRAY
VAR_INPUT
	ALRDATA : POINTER TO LREAL;
	XEXECUTE : BOOL;
	XABORT : BOOL;
END_VAR
VAR_OUTPUT
	XDONE : BOOL;
	XBUSY : BOOL;
	XACTIVE : BOOL;
	XCOMMANDABORTED : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	LRACTUALVALUE : LREAL;
END_VAR
VAR
	_DWMININDEX : DWORD;
	_DWMAXINDEX : DWORD;
	_DWACTINDEX : DWORD;
	_MODEL : L_UBUP_BehaviourModel_ETrigA;
END_VAR
END_FUNCTION_BLOCK

METHOD CYCLICACTION
VAR_INPUT
	ITFTIMINGCONTROLLER : L_UBUP_ITimingController;
END_VAR
VAR_OUTPUT
	XCOMPLETE : BOOL;
	XABORT : BOOL;
	IERRORID : INT;
END_VAR
END_METHOD

METHOD FINALIZEACTION
VAR_INPUT
	XABORTPROPOSED : BOOL;
	IERRORIDPROPOSED : INT;
END_VAR
VAR_OUTPUT
	XCOMPLETE : BOOL;
	XABORT : BOOL;
	IERRORID : INT;
END_VAR
END_METHOD

METHOD RESETACTION
VAR_OUTPUT
	XCOMPLETE : BOOL;
END_VAR
END_METHOD

METHOD STARTACTION
VAR_OUTPUT
	XCOMPLETE : BOOL;
	IERRORID : INT;
END_VAR
END_METHOD