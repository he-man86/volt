FUNCTION_BLOCK TYPEDESC_SUBRANGE EXTENDS TypeDesc_Simple
VAR
	_PSZNAME : POINTER TO STRING;
	_IBASETYPEDESC : REFERENCE TO TypeDesc;
	_LWLOWERBORDER : LWORD;
	_LWUPPERBORDER : LWORD;
END_VAR
END_FUNCTION_BLOCK

METHOD GETBASETYPE_INTERNAL : REFERENCE TO TypeDesc
END_METHOD

METHOD GETNAME_INTERNAL : POINTER TO STRING
VAR_INPUT
	PRESULT : POINTER TO SysTypes.RTS_IEC_RESULT;
END_VAR
END_METHOD

METHOD GETRANGE_INTERNAL : BOOL
VAR_INPUT
	PLOWER : POINTER TO LWORD;
	PUPPER : POINTER TO LWORD;
END_VAR
END_METHOD

METHOD GETTYPECLASS2_INTERNAL : TypeClass
VAR_INPUT
	DWFLAGS : DWORD;
END_VAR
END_METHOD

METHOD GET_INTERNAL : __XWORD
VAR_INPUT
	PDEST : POINTER TO BYTE;
	PSRC : POINTER TO BYTE;
	VARINFO : REFERENCE TO VariableInformation;
	DWSIZE : __XWORD;
	PRESULT : POINTER TO UDINT;
END_VAR
END_METHOD

METHOD SET_INTERNAL : __XWORD
VAR_INPUT
	PSRC : POINTER TO BYTE;
	PDEST : POINTER TO BYTE;
	VARINFO : REFERENCE TO VariableInformation;
	DWSIZE : __XWORD;
	PRESULT : POINTER TO UDINT;
END_VAR
END_METHOD