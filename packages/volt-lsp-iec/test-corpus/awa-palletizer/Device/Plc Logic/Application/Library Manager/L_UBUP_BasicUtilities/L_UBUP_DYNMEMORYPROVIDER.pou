FUNCTION_BLOCK L_UBUP_DYNMEMORYPROVIDER EXTENDS L_UBUP_MemoryProvider
VAR
	_PMEM : POINTER TO ARRAY [1..16#FFFF] OF BYTE;
	_DWMEMSIZE : DWORD;
	PTR : POINTER TO BYTE;
	SIZE : UDINT;
END_VAR
END_FUNCTION_BLOCK

METHOD FB_EXIT : BOOL
VAR_INPUT
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD FB_INIT : BOOL
VAR_INPUT
	BINITRETAINS : BOOL;
	BINCOPYCODE : BOOL;
	DWMEMSIZE : DWORD;
END_VAR
END_METHOD