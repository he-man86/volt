FUNCTION_BLOCK L_UBUP_POOLINSTANCE EXTENDS L_UBUP_Instance
VAR
	_ITFOWNER : L_UBUP_IFBPool;
	_XWHANDLE : __XWORD;
	_XOCCUPIED : BOOL;
	INSTANCEPTR : POINTER TO BYTE;
	OCCUPIED : BOOL;
END_VAR
END_FUNCTION_BLOCK

METHOD FREE : BOOL
END_METHOD

METHOD OCCUPY : BOOL
