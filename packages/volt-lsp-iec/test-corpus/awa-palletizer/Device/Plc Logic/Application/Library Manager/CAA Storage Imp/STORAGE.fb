FUNCTION_BLOCK STORAGE
VAR
	_HHANDLE : CAA.HANDLE;
	STORAGEENCODING : STO.ENCODING;
	STORAGEISREADONLY : BOOL;
	STORAGELOCKINGSTATE : STO.LOCKING_STATE;
	STORAGENUMOFTABLES : CAA.COUNT;
	STORAGESCHEMAVERSION : DINT;
	STORAGEUSERVERSION : DINT;
	STORAGEVERSION : DINT;
END_VAR
END_FUNCTION_BLOCK

METHOD STORAGECLEAR : STO.ERROR
END_METHOD

METHOD STORAGECLOSE : STO.ERROR
END_METHOD

METHOD STORAGEGETMETRICS : STO.ERROR
VAR_IN_OUT
	MMETRICS : STO.METRICS;
END_VAR
END_METHOD

METHOD STORAGEGETPATH : STO.ERROR
VAR_IN_OUT
	SPATH : CAA.FILENAME;
END_VAR
END_METHOD

METHOD STORAGEOPENFILE : STO.ERROR
VAR_INPUT
	XREADONLY : BOOL := FALSE;
END_VAR
VAR_IN_OUT
	SPATH : CAA.FILENAME;
END_VAR
END_METHOD

METHOD STORAGEREORG : STO.ERROR
END_METHOD

METHOD TABLEOPEN : STO.ITable
VAR_INPUT
	IDTABLE : CAA.IDENT;
END_VAR
VAR_OUTPUT
	EERROR : STO.ERROR;
END_VAR
END_METHOD

METHOD TRANSACTIONBEGIN : STO.ITransaction
VAR_INPUT
	EMODE : STO.TRANSACTION_MODE;
END_VAR
VAR_OUTPUT
	EERROR : STO.ERROR;
END_VAR
END_METHOD

METHOD UTILITYGETCURRENTDATEANDTIME : STO.INT64
VAR_OUTPUT
	EERROR : STO.ERROR;
END_VAR
END_METHOD

METHOD UTILITYRANDOMNESS : STO.ERROR
VAR_INPUT
	SZSIZE : CAA.SIZE;
	PDATA : CAA.PVOID;
END_VAR
END_METHOD

METHOD STORAGEEXECUTESTATEMENT : STO.ERROR
VAR_IN_OUT
	SSTATEMENT : STO.SQLSTATEMENT;
END_VAR
END_METHOD

METHOD STORAGEGETINDEXID : STO.ERROR
VAR_OUTPUT
	IDINDEX : CAA.IDENT;
END_VAR
VAR_IN_OUT
	SINDEX : STRING;
	STABLE : STRING;
END_VAR
END_METHOD

METHOD STORAGEGETTABLEID : STO.ERROR
VAR_OUTPUT
	IDTABLE : CAA.IDENT;
END_VAR
VAR_IN_OUT
	STABLE : STRING;
END_VAR
END_METHOD