FUNCTION_BLOCK L_IE1P_SETERRORSINGLESTRING EXTENDS L_IE1P_SetErrorSingleBase
VAR_INPUT
	MODULEHANDLER : L_IMHP_IModuleHandler;
	ERRORHANDLER : L_IE1P_IErrorHandler;
	XSETERROR : BOOL;
	ESEVERITY : L_IE1P_SeverityLevel;
	WTEXTREFID : WORD;
	WERRORID : WORD;
	EREACTION : L_IE1P_Reaction := L_IE1P_Reaction.No_Reaction;
	EGROUP : L_IE1P_Group := L_IE1P_Group.ManufacturerGroup;
	STEXTPLACEHOLDER : STRING(50);
	ATTRIBUTES : L_IE1P_IAttributes;
END_VAR
VAR_OUTPUT
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	SCERRORINFORMATION : L_IE1P_ErrorInfo;
END_VAR
VAR
	GETCONNECTEDMODULEHANDLER : L_IMHP_IModuleHandler;
	NBROFELEMENTS : WORD;
END_VAR
END_FUNCTION_BLOCK