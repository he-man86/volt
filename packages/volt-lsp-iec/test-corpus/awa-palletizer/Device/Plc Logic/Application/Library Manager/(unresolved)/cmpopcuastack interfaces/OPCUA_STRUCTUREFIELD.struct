TYPE OPCUA_STRUCTUREFIELD :
STRUCT
	NAME : OpcUa_String;
	DESCRIPTION : OpcUa_LocalizedText;
	DATATYPE : OpcUa_NodeId;
	VALUERANK : OpcUa_Int32;
	NOOFARRAYDIMENSIONS : OpcUa_Int32;
	ARRAYDIMENSIONS : POINTER TO OpcUa_UInt32;
	MAXSTRINGLENGTH : OpcUa_UInt32;
	ISOPTIONAL : OpcUa_Boolean;
END_STRUCT
END_TYPE