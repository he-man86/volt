FUNCTION_BLOCK MC_MOVERELATIVE EXTENDS L_MC1P_Template_Move
VAR_INPUT
	EXECUTE : BOOL;
	CONTINUOUSUPDATE : BOOL;
	DISTANCE : LREAL;
	VELOCITY : LREAL;
	ACCELERATION : LREAL;
	DECELERATION : LREAL;
	JERK : LREAL;
	BUFFERMODE : MC_BUFFER_MODE;
END_VAR
VAR_OUTPUT
	DONE : BOOL;
	BUSY : BOOL;
	ACTIVE : BOOL;
	COMMANDABORTED : BOOL;
	ERROR : BOOL;
	ERRORID : L_IE1P_Error;
END_VAR
VAR
	MOVEREL : L_MC1P_MoveRelative_Internal;
	JERKDEC_INT : LREAL;
	_MCCALL : L_UM1P_MCMultipleCall;
	INPUTDATA : ARRAY [1.._MCCall.c_BufferDepthInput] OF L_MC1P_MoveRelativeInput;
	OUTPUTDATA : ARRAY [1.._MCCall.c_BufferDepthOutput] OF L_MC1P_MoveRelativeOutput;
	GETMOVEBASICP : POINTER TO L_MC1P_MoveBasic;
	JERKDEC : LREAL;
END_VAR
END_FUNCTION_BLOCK