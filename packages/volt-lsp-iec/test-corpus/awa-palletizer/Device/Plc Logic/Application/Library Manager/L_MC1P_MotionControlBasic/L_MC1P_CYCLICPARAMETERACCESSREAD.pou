	_MCCALL : L_UM1P_MCMultipleCall;
	INPUTDATA : ARRAY [1.._MCCall.c_BufferDepthInput] OF L_MC1P_CyclicParameterAccessReadInput;
	OUTPUTDATA : ARRAY [1.._MCCall.c_BufferDepthOutput] OF L_MC1P_CyclicParameterAccessReadOutput;
END_VAR
END_FUNCTION_BLOCK

