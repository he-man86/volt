FUNCTION_BLOCK PERSISTANTRECIPELIST
VAR_INPUT
	_IPERSISTENTRECIPEHELPER : IPersistentRecipeHelper;
END_VAR
VAR
	_RECIPESVECTOR : Collections.StringVector;
	_TOKENIZER : RecipeManTokenizer;
	_STATICMEM : ARRAY [0..(STATIC_RECIPE_NAMES_SIZE / 4)] OF DWORD;
	STATIC_RECIPE_NAMES_SIZE : DWORD := 2000;
	RECIPECOUNT : INT;
END_VAR
END_FUNCTION_BLOCK

METHOD ADDRECIPE : BOOL
VAR_INPUT
	STNAME : REFERENCE TO STRING;
END_VAR
END_METHOD

METHOD FB_EXIT : BOOL
VAR_INPUT
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD FB_INIT : BOOL
VAR_INPUT
	BINITRETAINS : BOOL;
	BINCOPYCODE : BOOL;
END_VAR
END_METHOD

METHOD FREERECIPE : BOOL
VAR_INPUT
	RECIPE : IRecipe;
END_VAR
END_METHOD

METHOD GETRECIPENAME : STRING
VAR_INPUT
	IINDEX : INT;
END_VAR
END_METHOD

METHOD GETRECIPENAMES : DWORD
VAR_INPUT
	PSTRINGS : POINTER TO ARRAY [0..0] OF STRING;
	ISIZE : INT;
	ISTARTINDEX : INT;
END_VAR
END_METHOD

METHOD RELOAD : DWORD
END_METHOD

METHOD PRVADD : BOOL
VAR_INPUT
	STRECIPEFILE : REFERENCE TO STRING;
END_VAR
END_METHOD

METHOD PRVCLEAR : BOOL
END_METHOD