FUNCTION_BLOCK L_MC1P_SETSPEEDCTRLLOADVALUE EXTENDS L_MC1P_Template
VAR_INPUT
	XENABLE : BOOL;
	LRSPEEDCTRLLOADVALUE : LREAL := 1.0;
END_VAR
VAR_OUTPUT
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
END_VAR
VAR
	XENABLEOLD : BOOL;
	PAXIS : POINTER TO _AXIS_REF_REAL;
	_MCCALL : L_UM1P_MCMultipleCall;
	INPUTDATA : ARRAY [1.._MCCall.c_BufferDepthInput] OF L_MC1P_SetSpeedCtrlLoadValueInput;
	OUTPUTDATA : ARRAY [1.._MCCall.c_BufferDepthOutput] OF L_MC1P_SetSpeedCtrlLoadValueOutput;
END_VAR
END_FUNCTION_BLOCK