FUNCTION_BLOCK DIRCOPY EXTENDS ETrig
VAR_INPUT
	SDIRNAMEDEST : CAA.FILENAME;
	SDIRNAMESOURCE : CAA.FILENAME;
	XRECURSIVE : BOOL;
	XOVERWRITE : BOOL;
END_VAR
VAR_OUTPUT
	EERROR : ERROR;
END_VAR
VAR
	HJOB : CAA.HANDLE;
	PDIRCOPYPARAMS : POINTER TO FILE_DIRCOPY_PARAMS;
	STATEJOB : ASM.STATE;
	DIRCOPYPARAMS : FILE_DIRCOPY_PARAMS;
END_VAR
END_FUNCTION_BLOCK