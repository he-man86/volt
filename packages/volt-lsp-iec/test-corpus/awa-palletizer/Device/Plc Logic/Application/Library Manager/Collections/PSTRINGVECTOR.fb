FUNCTION_BLOCK PSTRINGVECTOR EXTENDS BaseVector
VAR
	_PARRPSTRINGS : POINTER TO ARRAY [0..100] OF POINTER TO STRING;
END_VAR
END_FUNCTION_BLOCK

METHOD ADDSTRING : UDINT
VAR_INPUT
	PSTRING : POINTER TO STRING;
END_VAR
END_METHOD

METHOD GETSTRING : POINTER TO STRING
VAR_INPUT
	UDIINDEX : UDINT;
END_VAR
VAR_OUTPUT
	UDIRESULT : UDINT;
END_VAR
END_METHOD

METHOD ABSTRASSIGN : UDINT
VAR_INPUT
	PBT : POINTER TO BYTE;
	UDIINDEX : UDINT;
END_VAR
END_METHOD

METHOD ABSTRDATAPTRCHANGED : UDINT
END_METHOD

METHOD ABSTRSIZEOFELEMENT : UDINT
END_METHOD