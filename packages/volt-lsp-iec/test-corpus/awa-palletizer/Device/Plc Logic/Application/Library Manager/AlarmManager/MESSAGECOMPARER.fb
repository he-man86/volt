FUNCTION_BLOCK MESSAGECOMPARER EXTENDS TSLastComparer
VAR
	M_STRINGTYPE : __SYSTEM.TYPE_CLASS;
	M_IWHICHMESSAGE : INT;
	M_ICOUNTLATCHVARIABLES : INT;
	M_CBSMESSAGE1 : CharBufferString;
	M_CBSMESSAGE2 : CharBufferString;
	M_CBSMESSAGE1REPLACED : CharBufferString;
	M_CBSMESSAGE2REPLACED : CharBufferString;
	M_ABYBUFFERMESSAGE1REPLACED : ARRAY [0..(BUFFER_LENGTH - 1)] OF BYTE;
	M_ABYBUFFERMESSAGE2REPLACED : ARRAY [0..(BUFFER_LENGTH - 1)] OF BYTE;
	M_TIMESTAMPANDVALUESCONTAINER : TimestampAndValuesContainer;
	BUFFER_LENGTH : INT := (2 * (255 + 1));
END_VAR
END_FUNCTION_BLOCK