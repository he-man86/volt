TYPE L_UBUP_VARVALUE :
UNION
	XVALUE : BOOL;
	BVALUE : BIT;
	BYVALUE : BYTE;
	WVALUE : WORD;
	DWVALUE : DWORD;
	LWVALUE : LWORD;
	SIVALUE : SINT;
	IVALUE : INT;
	DIVALUE : DINT;
	LIVALUE : LINT;
	USIVALUE : USINT;
	UIVALUE : UINT;
	UDIVALUE : UDINT;
	ULIVALUE : ULINT;
	RVALUE : REAL;
	LRVALUE : LREAL;
	TVALUE : TIME;
	DATVALUE : DATE;
	DTVALUE : DATE_AND_TIME;
	TODVALUE : TIME_OF_DAY;
	LTVALUE : LTIME;
	PPOINTER : POINTER TO BYTE;
	RREFERENCE : REFERENCE TO BYTE;
END_UNION
END_TYPE