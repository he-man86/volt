FUNCTION_BLOCK L_MC1P_PARSIMREAD EXTENDS L_MC1P_ParSim
VAR_INPUT
	XEXECUTE : BOOL;
	WINDEX : WORD;
	BYSUBINDEX : BYTE;
	PBUFFER : POINTER TO BYTE;
	SZSIZE : CAA_SIZE;
	UDITIMEOUT : UDINT;
	PPARAMDATA : POINTER TO L_MC1P_ParameterDataSim;
	WPARAMCOUNT : WORD;
	XSLOTB : BOOL;
	LRDELAY : LREAL := 0.01;
	LRTASKCYCLE : LREAL;
END_VAR
VAR_OUTPUT
	XBUSY : BOOL;
	XDONE : BOOL;
	XERROR : BOOL;
	EERRORCODE : WORD;
	SZDATAREAD : CAA_SIZE;
END_VAR
VAR
	XEXECUTEOLD : BOOL;
	XRESETOUTPUT : BOOL;
	IDX : WORD;
	XFOUND : BOOL;
	LRWAITCOUNTER : LREAL;
	WSEARCHINDEX : WORD := 0;
END_VAR
END_FUNCTION_BLOCK