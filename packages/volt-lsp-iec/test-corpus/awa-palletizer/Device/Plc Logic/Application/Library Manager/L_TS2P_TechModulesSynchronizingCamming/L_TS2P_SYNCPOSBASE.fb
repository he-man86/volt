END_VAR
VAR
	XINTERNALCONTROLACTIVE_OLD : BOOL;
	ITFCONNECTORSYNCPOS : L_TS2P_IConnectorSyncPos;
	_XCONNECTORVALID : BOOL;
	TM_INT : L_TS2P_TM_SyncPosBase;
	SCPAR_INT : L_TS2P_scPar_SyncPosBase;
	SCDATA_INT : L_TS2P_scData_TM_SyncPosBase;
	XUSEORIGINAL_OLD : BOOL;
	_UICALLMFUNIDXINPUT : UINT := 1;
	_UICALLMFUNIDXOUTPUT : UINT := 1;
	_MCCALL : L_UM1P_MCCall := STRUCT(itfMCCall := THIS^);
	_ASCINPUT : ARRAY [1.._MCCall.c_BufferDepthInput] OF L_TS2P_SyncPosBaseIn;
	_ASCOUTPUT : ARRAY [1.._MCCall.c_BufferDepthOutput] OF L_TS2P_SyncPosBaseOut;
	_ASCPARCORE : ARRAY [1.._MCCall.c_BufferDepthInput] OF L_TS2P_scPar_SyncPosBase;
	_ASCACCESSPOINTSCORE : ARRAY [1.._MCCall.c_BufferDepthInput] OF L_TS2P_scAP_SyncPosBase;
	_ASCSIGNALFLOWCORE : ARRAY [1.._MCCall.c_BufferDepthOutput] OF L_TS2P_scSF_SyncPosBase;
	_SCINPUTVISU : L_TS2P_SyncPosBaseIn;
	_PSCINPUTVISU : POINTER TO L_TS2P_SyncPosBaseIn := ADR(_scInputVisu);
	_PSCOUTPUTVISU : POINTER TO L_TS2P_SyncPosBaseOut := ADR(_ascOutput[1]);
	_PSCDATAVISU : POINTER TO L_TS2P_scData_TM_SyncPosBase := ADR(scData_int);
	_PSCPARVISU : POINTER TO L_TS2P_scPar_SyncPosBase := ADR(scPar_int);
	_PSCAPVISU : POINTER TO L_TS2P_scAP_SyncPosBase;
	_PSCSFVISU : POINTER TO L_TS2P_scSF_SyncPosBase;
	ITFBASICMOTIONBASE : L_TB2P.L_TB2P_IBasicMotionBase;
	ITFITECHMODULEINTERNAL : L_TB2P_ITechModuleInternal;
	ITFSYNCPOSEXTENSION : L_TS2P_ISyncPosBase;
	LRJERKDEC : LREAL;
	LRJOGGINGJERKDEC : LREAL;
	REMAININGTIMEOFPROFILE : LREAL;
	REMAININGTIMEOFPROFILEAVAILABLE : BOOL;
END_VAR
END_FUNCTION_BLOCK