FUNCTION_BLOCK MC_READSTATUS EXTENDS L_MC1P_Template
VAR_INPUT
	ENABLE : BOOL;
END_VAR
VAR_OUTPUT
	VALID : BOOL;
	BUSY : BOOL;
	ERROR : BOOL;
	ERRORID : L_IE1P_Error;
	ERRORSTOP : BOOL;
	DISABLED : BOOL;
	STOPPING : BOOL;
	HOMING : BOOL;
	STANDSTILL : BOOL;
	DISCRETEMOTION : BOOL;
	CONTINUOUSMOTION : BOOL;
	SYNCHRONIZEDMOTION : BOOL;
	CONSTANTVELOCITY : BOOL;
	ACCELERATING : BOOL;
	DECELERATING : BOOL;
	INPOSITION : BOOL;
END_VAR
VAR
	XENABLEOLD : BOOL := FALSE;
	_MCCALL : L_UM1P_MCMultipleCall;
	INPUTDATA : ARRAY [1.._MCCall.c_BufferDepthInput] OF L_MC1P_ReadStatusInput;
	OUTPUTDATA : ARRAY [1.._MCCall.c_BufferDepthOutput] OF L_MC1P_ReadStatusOutput;
	POUTPUTDATA : POINTER TO L_MC1P_ReadStatusOutput;
END_VAR
END_FUNCTION_BLOCK