FUNCTION_BLOCK MC_WRITEBOOLPARAMETER EXTENDS L_MC1P_Template_NoAxis
VAR_INPUT
	AXIS : L_MC1P_IMCParameterAccess;
	EXECUTE : BOOL;
	PARAMETERNUMBER : DINT;
	VALUE : BOOL;
	EXECUTIONMODE : MC_EXECUTION_MODE;
END_VAR
VAR_OUTPUT
	DONE : BOOL;
	BUSY : BOOL;
	ERROR : BOOL;
	ERRORID : L_IE1P_Error;
END_VAR
VAR
	XEXECUTEOLD : BOOL := FALSE;
	XRESETOUTPUT : BOOL := FALSE;
	L_DCO_WRITEDRIVEPARAMETER1 : L_DCO_WriteDriveParameter;
	WERRORID_INT : WORD;
	AXISOLD : L_MC1P_IMCParameterAccess;
	PAXISREF : POINTER TO AXIS_REF;
	XWRITEPARAMETER : BOOL;
	PINSTANCE : POINTER TO BYTE;
	EAXISTYPE : L_MC1P_AxisType;
	_MCCALL : L_UM1P_MCMultipleCall;
	INPUTDATA : ARRAY [1.._MCCall.c_BufferDepthInput] OF L_MC1P_WriteBoolParameterInput;
	OUTPUTDATA : ARRAY [1.._MCCall.c_BufferDepthOutput] OF L_MC1P_WriteBoolParameterOutput;
	POUTPUTDATA : POINTER TO L_MC1P_WriteBoolParameterOutput;
	ITFSETPOINTINFO : L_UM1P_ISetpointInfo;
	XAXISTASKIDXVALID : BOOL;
	IAXISTASKIDX : INT;
END_VAR
END_FUNCTION_BLOCK