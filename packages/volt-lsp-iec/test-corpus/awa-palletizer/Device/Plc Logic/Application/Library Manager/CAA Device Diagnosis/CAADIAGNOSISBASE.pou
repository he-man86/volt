FUNCTION_BLOCK CAADIAGNOSISBASE
VAR
	M_NCOUNT : DINT;
	M_PCONNECTOR : POINTER TO IoConfigConnector;
	BUSLOGGER : Logger;
END_VAR
END_FUNCTION_BLOCK

METHOD CALCIPADRUDINT : UDINT
VAR_INPUT
	PABY : POINTER TO ARRAY [0..3] OF BYTE;
END_VAR
END_METHOD

METHOD GETBUSINFO : ERROR
VAR_IN_OUT
	BUIINFO : BUS_INFO;
END_VAR
END_METHOD

METHOD GETBUSSCANASYNC : PROC_STATE
VAR_INPUT
	ECMD : PROC_CMD;
END_VAR
VAR_OUTPUT
	ITFFIRSTDEVICE : INode;
	EERROR : ERROR;
END_VAR
END_METHOD

METHOD GETBUSSTATE : BUS_STATE
VAR_OUTPUT
	XDIAGNOSISINFOAVAILABLE : BOOL;
	EERROR : ERROR;
END_VAR
END_METHOD

METHOD GETDEVICEINFO : ERROR
VAR_IN_OUT
	DEIINFO : DEVICE_INFO;
END_VAR
END_METHOD

METHOD GETERRORASYNC : PROC_STATE
VAR_INPUT
	ECMD : PROC_CMD;
END_VAR
VAR_OUTPUT
	EERROR : ERROR;
END_VAR
VAR_IN_OUT
	ERIERROR : ERROR_INFO;
END_VAR
END_METHOD

METHOD GETSPECIFICDEVICEERRORASYNC : PROC_STATE
VAR_INPUT
	ECMD : PROC_CMD;
	PDATA : CAA.PVOID;
	SZSIZE : CAA.SIZE;
END_VAR
VAR_OUTPUT
	SZCOUNT : CAA.SIZE;
	EERROR : ERROR;
END_VAR
END_METHOD

METHOD GETSTATE : DEVICE_STATE
VAR_OUTPUT
	XDIAGNOSISINFOAVAILABLE : BOOL;
	EERROR : ERROR;
END_VAR
END_METHOD

METHOD INITIALIZE_DIAG : UDINT
VAR_INPUT
	PCONNECTOR : POINTER TO IoConfigConnector;
	NCOUNT : DINT;
END_VAR
END_METHOD