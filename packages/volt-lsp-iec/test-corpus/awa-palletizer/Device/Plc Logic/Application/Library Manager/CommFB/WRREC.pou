FUNCTION_BLOCK WRREC
VAR_INPUT
	REQ : BOOL;
	ID : DWORD;
	INDEX : INT;
	LEN : INT;
	RECORD : POINTER TO BYTE;
END_VAR
VAR_OUTPUT
	DONE : BOOL;
	BUSY : BOOL;
	ERROR : BOOL;
	STATUS : DWORD;
END_VAR
VAR
	M_FACTORY : ICommFBFactory;
	M_PWRREC : POINTER TO WRRECbase;
	_REQ : BOOL;
	S_INSTANCEHANDLER : InstanceHandler;
END_VAR
END_FUNCTION_BLOCK