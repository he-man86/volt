END_VAR
END_METHOD

METHOD GETCONTENTSIZE : UDINT
VAR_OUTPUT
	CONTENTSIZE : UDINT;
END_VAR
END_METHOD

METHOD GETUNREADCONTENT : UDINT
VAR_OUTPUT
	PDATA : POINTER TO BYTE;
END_VAR
END_METHOD

METHOD GETUNREADCONTENTSIZE : UDINT
VAR_OUTPUT
	CONTENTSIZE : UDINT;
END_VAR
END_METHOD

METHOD IGNOREBYTES : UDINT
VAR_INPUT
	UDICOUNT : UDINT;
END_VAR
END_METHOD

METHOD MOVEDOWN : UDINT
END_METHOD

METHOD MOVENEXT : UDINT
END_METHOD

METHOD MOVENEXTCONDITIONAL : UDINT
VAR_INPUT
	BDOMOVE : BOOL;
END_VAR
END_METHOD

METHOD MOVEUP : UDINT
END_METHOD

METHOD READBYTE : UDINT
VAR_OUTPUT
	BT : BYTE;
END_VAR
END_METHOD

METHOD READBYTES : UDINT
VAR_INPUT
	PBUFFER : POINTER TO BYTE;
	UDICOUNT : UDINT;
END_VAR
END_METHOD

METHOD READBYTESSWAPPED : UDINT
VAR_INPUT
	PBUFFER : POINTER TO BYTE;
	UDICOUNT : UDINT;
