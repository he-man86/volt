	XENABLE : BOOL;
	TPRECDATA : L_MC1P_TpReceiveData;
	LRVALUE : LREAL;
	LRTIMEDELAY : LREAL;
	LRCYCLELENGTH : LREAL;
END_VAR
VAR_OUTPUT
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	XTPRECEIVED : BOOL;
	LRTPVALUE : LREAL;
END_VAR
VAR
	ALRRINGBUFFER : ARRAY [0..(wRingBufferDepth - 1)] OF LREAL;
	XINITDONE : BOOL;
	WINITCYCLES : WORD;
	DITIMESTAMPDIFF : DINT;
	LRTASKCYCLE_NS : LREAL;
	LRTASKCYCLETIME : LREAL;
	DWTIMESTAMPOLD : DWORD;
	WVALUEIDX : WORD;
	LRINTERVAL : LREAL;
	UDIINTERVAL : UDINT;
	LRFACTOR : LREAL;
	LRBASE : LREAL;
	LRDIFF : LREAL;
	DIVALUEBASE : DINT;
	DWTMP : DWORD;
	LRTMP : LREAL;
	WRINGBUFFERDEPTH : WORD := 21;
END_VAR
END_FUNCTION_BLOCK