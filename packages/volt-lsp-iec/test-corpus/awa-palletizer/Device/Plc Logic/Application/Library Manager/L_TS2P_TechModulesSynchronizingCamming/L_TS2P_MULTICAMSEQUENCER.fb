FUNCTION_BLOCK L_TS2P_MULTICAMSEQUENCER
VAR_INPUT
	XENABLE : BOOL;
	XCAMSEQUENCER : BOOL;
	EMODE : L_TS2P_CamSequenceMode;
	XCAMCHANGEINSTANT : BOOL;
	XLOADCAMTABLE : BOOL;
	WSETCAMTABLE : WORD;
	XENDOFPROFILEIN : BOOL;
	CAMTABLE1 : MC_CAM_REF;
	CAMTABLE2 : MC_CAM_REF;
	CAMTABLE3 : MC_CAM_REF;
	CAMTABLE4 : MC_CAM_REF;
END_VAR
VAR_OUTPUT
	XDONE : BOOL;
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	WACTIVECAMTABLE : WORD;
	CAMTABLEOUT : MC_CAM_REF;
	XCAMTABLEVALID : BOOL;
END_VAR
VAR
	WFMSTATE : WORD := 0;
	XINITSTATE : BOOL;
	XENABLE_OLD : BOOL;
	XLOADCAMTABLE_OLD : BOOL;
	XENDOFPROFILEIN_OLD : BOOL;
	XCAMSEQUENCER_OLD : BOOL;
	XCAMCHANGEINSTANT_OLD : BOOL;
	XCAMSEQUENCERACTIVE : BOOL;
END_VAR
END_FUNCTION_BLOCK