FUNCTION_BLOCK L_MC1P_STOP_INTERNAL EXTENDS L_MC1P_Template_IntFB
VAR
	XSTART : BOOL;
	EXECUTEOLD : BOOL;
	PG : REFERENCE TO L_MC1P_PosProfiler;
	SCPARAM : L_MC1P_ProfileParameter;
	WFUNID : WORD;
	XRESETOUTPUT : BOOL;
	EACTSTATE : L_MC1P_AXIS_STATE;
	XSUPERIMPOSED : BOOL;
	XDONEOLD : BOOL;
	XWARNING : BOOL;
	EWARNINGID : L_IE1P_Error;
	XWARNINGOLD : BOOL;
	EWARNINGIDOLD : L_IE1P_Error;
	LRDECINT : LREAL;
	LRJERKINT : LREAL;
	XUSED : BOOL;
	XPOSPROFILERINUSE : BOOL;
	XSTOPSLAVEAXISIMMEDIATELY : BOOL;
	POUTPUT : POINTER TO L_MC1P_StopOutput;
	POSPROFILERINUSE : BOOL;
	REMAININGTIMEOFPROFILE : LREAL;
	REMAININGTIMEOFPROFILEAVAILABLE : BOOL;
END_VAR
END_FUNCTION_BLOCK

METHOD MAIN
VAR_IN_OUT
	AXIS : AXIS_REF;
	FBBASE : L_MC1P_Template_ForAxis;
	INPUT : L_MC1P_StopInput;
	OUTPUT : L_MC1P_StopOutput;
END_VAR
END_METHOD

METHOD RESET
VAR_IN_OUT
	FBBASE : L_MC1P_Template_ForAxis;
END_VAR
END_METHOD