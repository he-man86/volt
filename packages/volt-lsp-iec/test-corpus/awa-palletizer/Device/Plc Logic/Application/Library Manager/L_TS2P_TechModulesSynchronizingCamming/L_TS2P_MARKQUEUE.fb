FUNCTION_BLOCK L_TS2P_MARKQUEUE
VAR_INPUT
	XENABLE : BOOL;
	XLOADMARKPOS : BOOL;
	LRMARKPOS : LREAL;
	XGETNEXTMARK : BOOL;
	XRESETGETNEXTMARK : BOOL;
	XRESETMARKQUEUE : BOOL;
	LRCYCSETPOS : LREAL;
	LRCYCSETVEL : LREAL;
END_VAR
VAR_OUTPUT
	XQUEUEISFULL : BOOL;
	XQUEUEISEMPTY : BOOL;
	XNEWMARKRECEIVED : BOOL;
	WMARKSINQUEUE : WORD;
	XMARKVALID : BOOL;
	LRMARKPOSOUT : LREAL;
END_VAR
VAR
	FB_MB1P_STACK : L_MB1P_Stack;
	XTRACKMARK : BOOL;
	XENABLE_OLD : BOOL;
	XRESETMARKQUEUE_OLD : BOOL;
	XGETNEXTMARK_OLD : BOOL;
	XRESETGETNEXTMARK_OLD : BOOL;
	C_LRMATERIALCOUNTERCYCLELENGTH : LREAL := (16#4FFFFFFFFFFFFFFF * 1E-08);
END_VAR
END_FUNCTION_BLOCK