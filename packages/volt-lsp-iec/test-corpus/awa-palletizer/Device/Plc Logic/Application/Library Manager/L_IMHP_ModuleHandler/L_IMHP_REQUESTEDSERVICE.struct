TYPE L_IMHP_REQUESTEDSERVICE :
STRUCT
	VERSION : UDINT := 1;
	SIZE : UDINT := SIZEOF(L_IMHP_RequestedService);
	SERVICEID : L_IMHP_ServiceID;
	SIZEOFREGISTRATIONDATA : UDINT;
	PREGISTRATIONDATA : POINTER TO BYTE;
	SERVICEAVAILABLE : UDINT;
	SERVICEVERSION : UDINT;
	REGISTRATIONSTATUS : UDINT;
	SIZEOFRESULTDATA : UDINT;
	PRESULTDATA : POINTER TO BYTE;
END_STRUCT
END_TYPE