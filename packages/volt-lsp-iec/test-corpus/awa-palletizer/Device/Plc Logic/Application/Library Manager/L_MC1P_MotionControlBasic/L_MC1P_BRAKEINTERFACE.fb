FUNCTION_BLOCK L_MC1P_BRAKEINTERFACE EXTENDS L_MC1P_Template
VAR_INPUT
	XENABLE : BOOL;
	XRELEASEBRAKE : BOOL;
	LRTORQUEADD : LREAL;
	XBRAKEMODEACTIVATE : BOOL;
	EBRAKEMODE : L_MC1P_BrakeMode;
END_VAR
VAR_OUTPUT
	XVALID : BOOL;
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	XBRAKERELEASEOUT : BOOL;
	XBRAKERELEASED : BOOL;
	LRACTTORQUE : LREAL;
	LRSTARTINGTORQUESAVED : LREAL;
	LRSTARTINGTORQUEEFFECTIVE : LREAL;
	EBRAKEMODEACTIVE : L_MC1P_BrakeMode;
END_VAR
VAR
	PAXIS : POINTER TO _AXIS_REF_REAL;
	PBRAKEBASE : POINTER TO L_MC1P_BrakeControlBase;
	PBRAKEADV : POINTER TO L_MC1P_BrakeControl;
	XENABLEOLD : BOOL;
	XSETBRAKEMODEOLD : BOOL;
	EBRAKEMODEOLD : L_MC1P_BrakeMode;
	_MCCALL : L_UM1P_MCMultipleCall;
	INPUTDATA : ARRAY [1.._MCCall.c_BufferDepthInput] OF L_MC1P_BrakeInterfaceInput;
	OUTPUTDATA : ARRAY [1.._MCCall.c_BufferDepthOutput] OF L_MC1P_BrakeInterfaceOutput;
END_VAR
END_FUNCTION_BLOCK