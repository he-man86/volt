INTERFACE ISTORAGE
END_INTERFACE

METHOD STORAGECLEAR : ERROR
END_METHOD

METHOD STORAGECLOSE : ERROR
END_METHOD

METHOD STORAGEGETMETRICS : ERROR
VAR_IN_OUT
	MMETRICS : METRICS;
END_VAR
END_METHOD

METHOD STORAGEGETPATH : ERROR
VAR_IN_OUT
	SPATH : CAA.FILENAME;
END_VAR
END_METHOD

METHOD STORAGEOPENFILE : ERROR
VAR_INPUT
	XREADONLY : BOOL;
END_VAR
VAR_IN_OUT
	SPATH : CAA.FILENAME;
END_VAR
END_METHOD

METHOD STORAGEREORG : ERROR
END_METHOD

METHOD TABLEOPEN : ITable
VAR_INPUT
	IDTABLE : CAA.IDENT;
END_VAR
VAR_OUTPUT
	EERROR : ERROR;
END_VAR
END_METHOD

METHOD TRANSACTIONBEGIN : ITransaction
VAR_INPUT
	EMODE : TRANSACTION_MODE;
END_VAR
VAR_OUTPUT
	EERROR : ERROR;
END_VAR
END_METHOD

METHOD UTILITYGETCURRENTDATEANDTIME : INT64
VAR_OUTPUT
	EERROR : ERROR;
END_VAR
END_METHOD

METHOD UTILITYRANDOMNESS : ERROR
VAR_INPUT
	SZSIZE : CAA.SIZE;
	PDATA : CAA.PVOID;
END_VAR
END_METHOD