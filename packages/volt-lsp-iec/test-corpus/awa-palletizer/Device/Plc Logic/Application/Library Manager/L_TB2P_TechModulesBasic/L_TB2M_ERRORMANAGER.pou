FUNCTION_BLOCK L_TB2M_ERRORMANAGER EXTENDS L_TB2M_ErrorManagerBase
VAR_INPUT
	ERRORHANDLER : L_IE1P_IErrorHandler;
END_VAR
VAR
	_MODULEHANDLER : L_IMHP_IModuleHandler;
	FB_SETERROR : L_IE1P_SetError;
	FB_RESETERROR : L_IE1P_ResetError;
END_VAR
END_FUNCTION_BLOCK

METHOD INITIALIZE : BOOL
VAR_INPUT
	MODULEHANDLER : L_IMHP_IModuleHandler;
	ITFERRORMANAGERCALLBACK : L_TB2M_IErrorManagerCallback;
END_VAR
END_METHOD

METHOD DETECTERRORRESET : BOOL
VAR_INPUT
	XRESETERROR : BOOL;
END_VAR
END_METHOD

METHOD FORWARDERROR
VAR_INPUT
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
	ESEVERITY : L_IE1P_SeverityLevel;
END_VAR
END_METHOD

METHOD FORWARDWARNING
VAR_INPUT
	XWARNING : BOOL;
	EWARNINGID : L_IE1P_Error;
END_VAR
END_METHOD