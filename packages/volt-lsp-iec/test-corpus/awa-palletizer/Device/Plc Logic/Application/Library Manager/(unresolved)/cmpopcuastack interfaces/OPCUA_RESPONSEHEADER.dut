TYPE OPCUA_RESPONSEHEADER :
STRUCT
	TIMESTAMP : OpcUa_DateTime;
	REQUESTHANDLE : OpcUa_UInt32;
	SERVICERESULT : OpcUa_StatusCode;
	SERVICEDIAGNOSTICS : OpcUa_DiagnosticInfo;
	NOOFSTRINGTABLE : OpcUa_Int32;
	STRINGTABLE : POINTER TO OpcUa_String;
	ADDITIONALHEADER : OpcUa_ExtensionObject;
END_STRUCT
END_TYPE