TYPE OPCUA_ACTIVATESESSIONREQUEST :
STRUCT
	REQUESTHEADER : OpcUa_RequestHeader;
	CLIENTSIGNATURE : OpcUa_SignatureData;
	NOOFCLIENTSOFTWARECERTIFICATES : OpcUa_Int32;
	CLIENTSOFTWARECERTIFICATES : POINTER TO OpcUa_SignedSoftwareCertificate;
	NOOFLOCALEIDS : OpcUa_Int32;
	LOCALEIDS : POINTER TO OpcUa_String;
	USERIDENTITYTOKEN : OpcUa_ExtensionObject;
	USERTOKENSIGNATURE : OpcUa_SignatureData;
END_STRUCT
END_TYPE