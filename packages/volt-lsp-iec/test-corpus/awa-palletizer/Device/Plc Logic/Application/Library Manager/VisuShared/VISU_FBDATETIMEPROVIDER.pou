	EERRORID : ERROR;
	IUTCOFFSET : INT;
END_VAR
END_METHOD

METHOD GETCURRENTUTCTIME : SYSTIME
VAR_OUTPUT
	EERRORID : ERROR;
END_VAR
END_METHOD