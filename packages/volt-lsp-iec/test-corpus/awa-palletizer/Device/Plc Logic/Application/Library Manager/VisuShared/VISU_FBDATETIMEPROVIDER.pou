END_VAR
END_METHOD

METHOD CONVERTUTCTOLOCALTIME : SYSTIME
VAR_INPUT
	UTCTIME : SYSTIME;
END_VAR
VAR_OUTPUT
	EERRORID : ERROR;
	IUTCOFFSET : INT;
END_VAR
END_METHOD

METHOD GETCURRENTLOCALTIME : SYSTIME
