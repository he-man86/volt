FUNCTION_BLOCK L_MC1P_SETTORQUEOFFSET EXTENDS L_MC1P_Template
VAR_INPUT
	XENABLE : BOOL;
	LRTORQUE : LREAL;
	EPRECONTROLMODE : L_MC1P_PreControlMode := L_MC1P_PreControlMode.AdditiveOffsetTorque;
END_VAR
VAR_OUTPUT
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
END_VAR
VAR
	XENABLEOLD : BOOL;
	_MCCALL : L_UM1P_MCMultipleCall;
	INPUTDATA : ARRAY [1.._MCCall.c_BufferDepthInput] OF L_MC1P_SetTorqueOffsetInput;
	OUTPUTDATA : ARRAY [1.._MCCall.c_BufferDepthOutput] OF L_MC1P_SetTorqueOffsetOutput;
END_VAR
END_FUNCTION_BLOCK