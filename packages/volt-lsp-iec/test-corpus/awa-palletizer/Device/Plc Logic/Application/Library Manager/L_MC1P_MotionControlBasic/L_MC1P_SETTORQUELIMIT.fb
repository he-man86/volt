FUNCTION_BLOCK L_MC1P_SETTORQUELIMIT EXTENDS L_MC1P_Template
VAR_INPUT
	XENABLE : BOOL;
	XSETTORQUELIMITPOS : BOOL;
	LRTORQUELIMITPOS : LREAL;
	XSETTORQUELIMITNEG : BOOL;
	LRTORQUELIMITNEG : LREAL;
	XTORQUEINPUTASPERCENT : BOOL;
END_VAR
VAR_OUTPUT
	XBUSY : BOOL;
	XERROR : BOOL;
	EERRORID : L_IE1P_Error;
END_VAR
VAR
	XENABLEOLD : BOOL;
	PAXIS : POINTER TO _AXIS_REF_REAL;
	PXDUMMY : POINTER TO BOOL;
	LRTMP : LREAL;
	_MCCALL : L_UM1P_MCMultipleCall;
	INPUTDATA : ARRAY [1.._MCCall.c_BufferDepthInput] OF L_MC1P_SetTorqueLimitInput;
	OUTPUTDATA : ARRAY [1.._MCCall.c_BufferDepthOutput] OF L_MC1P_SetTorqueLimitOutput;
	POUTPUT : POINTER TO L_MC1P_SetTorqueLimitOutput;
END_VAR
END_FUNCTION_BLOCK