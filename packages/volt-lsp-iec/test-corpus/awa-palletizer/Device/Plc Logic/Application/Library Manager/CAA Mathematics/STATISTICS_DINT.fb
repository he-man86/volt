FUNCTION_BLOCK STATISTICS_DINT
VAR_INPUT
	XENABLE : BOOL;
	DIINPUT : DINT;
END_VAR
VAR_OUTPUT
	DIMIN : DINT := 16#7FFFFFFF;
	DIMAX : DINT := DWORD_TO_DINT(16#80000000);
	DIAVERAGE : DINT;
	XOVERRUN : BOOL;
END_VAR
VAR
	DISUM : DINT;
	UDICOUNTER : UDINT;
	XOLDENABLE : BOOL;
END_VAR
END_FUNCTION_BLOCK