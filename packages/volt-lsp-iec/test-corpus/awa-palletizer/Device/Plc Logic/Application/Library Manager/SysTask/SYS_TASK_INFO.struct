TYPE SYS_TASK_INFO :
STRUCT
	UIOSHANDLE : RTS_IEC_HANDLE;
	ISTATE : DINT;
	IOLDSTATE : DINT;
	TP : SYS_TASK_PARAM;
	ULCYCLETIME : UDINT;
	ULCYCLESTART : UDINT;
	ULPRIORITY : UDINT;
	ULOSPRIORITY : UDINT;
	ULINTERVAL : UDINT;
	ULSTACKSIZE : UDINT;
	PFUNCTION : PFSYS_TASK_FUNCTION;
	SZNAME : STRING(SYSTASK_MAX_NAME_LEN);
	PEXCEPTIONHANDLER : PFSYS_TASK_EXCEPTIONHANDLER;
	CONTEXT : RegContext;
	PCPPINSTANCE : POINTER TO BYTE;
	POSSPECIFIC : POINTER TO BYTE;
	ULFEATURE : DWORD;
END_STRUCT
END_TYPE