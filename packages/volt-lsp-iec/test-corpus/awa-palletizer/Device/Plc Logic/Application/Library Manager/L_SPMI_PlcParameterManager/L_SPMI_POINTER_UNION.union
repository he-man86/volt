TYPE L_SPMI_POINTER_UNION :
UNION
	PVALUE_VOID : POINTER TO BYTE;
	PVALUE_BOOL : POINTER TO BOOL;
	PVALUE_SINT : POINTER TO SINT;
	PVALUE_USINT : POINTER TO USINT;
	PVALUE_INT : POINTER TO INT;
	PVALUE_UINT : POINTER TO UINT;
	PVALUE_DINT : POINTER TO DINT;
	PVALUE_UDINT : POINTER TO UDINT;
	PVALUE_LINT : POINTER TO LINT;
	PVALUE_ULINT : POINTER TO ULINT;
	PVALUE_REAL : POINTER TO REAL;
	PVALUE_LREAL : POINTER TO LREAL;
	PVALUE_STRING : POINTER TO STRING;
	PVALUE_STR255 : POINTER TO STRING(255);
END_UNION
END_TYPE