FUNCTION_BLOCK MC_READACTUALVELOCITY EXTENDS L_MC1P_Template
VAR_INPUT
	ENABLE : BOOL;
END_VAR
VAR_OUTPUT
	VALID : BOOL;
	BUSY : BOOL;
	ERROR : BOOL;
	ERRORID : L_IE1P_Error;
	VELOCITY : LREAL;
END_VAR
VAR
	XENABLEOLD : BOOL := FALSE;
	POUTPUTDATA : POINTER TO L_MC1P_ReadActualVelocityOutput;
	_MCCALL : L_UM1P_MCMultipleCall;
	INPUTDATA : ARRAY [1.._MCCall.c_BufferDepthInput] OF L_MC1P_ReadActualVelocityInput;
	OUTPUTDATA : ARRAY [1.._MCCall.c_BufferDepthOutput] OF L_MC1P_ReadActualVelocityOutput;
END_VAR
END_FUNCTION_BLOCK