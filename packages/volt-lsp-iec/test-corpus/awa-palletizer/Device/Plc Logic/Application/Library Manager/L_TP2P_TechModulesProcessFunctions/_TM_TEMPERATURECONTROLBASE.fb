	FB_PWM : L_TP2P_TC_PWM;
	FB_DIFFCTRL : L_TP2P_TC_DiffCtrl;
	FB_PARAMETERIDENTIFICATION : L_TP2P_TC_ParameterIdentification;
	SCIDENTDIAG : _sc_TM_TC_IdentDiagInfo;
END_VAR
END_FUNCTION_BLOCK