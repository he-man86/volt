	PINPUT : POINTER TO L_TP2P_TemperatureControlBaseIn;
	POUTPUT : POINTER TO L_TP2P_TemperatureControlBaseOut;
	_PSCPARVISU : POINTER TO _scPar_TM_TemperatureControlBase;
	SCPD_ACT : REFERENCE TO L_TP2P_scPD_TemperatureControlBase;
