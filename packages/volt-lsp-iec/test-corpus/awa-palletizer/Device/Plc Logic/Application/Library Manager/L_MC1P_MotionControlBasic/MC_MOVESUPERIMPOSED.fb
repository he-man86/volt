FUNCTION_BLOCK MC_MOVESUPERIMPOSED EXTENDS L_MC1P_Template_Move
VAR_INPUT
	EXECUTE : BOOL;
	CONTINUOUSUPDATE : BOOL;
	DISTANCE : LREAL;
	VELOCITYDIFF : LREAL;
	ACCELERATION : LREAL;
	DECELERATION : LREAL;
	JERK : LREAL;
END_VAR
VAR_OUTPUT
	DONE : BOOL;
	BUSY : BOOL;
	ACTIVE : BOOL;
	COMMANDABORTED : BOOL;
	ERROR : BOOL;
	ERRORID : L_IE1P_Error;
	COVEREDDISTANCE : LREAL;
END_VAR
VAR
	FBMB : L_MC1P_MoveBasic := STRUCT(wCalcProfileMode := 1);
	JERKDEC_INT : LREAL;
	_MCCALL : L_UM1P_MCMultipleCall;
	INPUTDATA : ARRAY [1.._MCCall.c_BufferDepthInput] OF L_MC1P_MoveSuperImposedInput;
	OUTPUTDATA : ARRAY [1.._MCCall.c_BufferDepthOutput] OF L_MC1P_MoveSuperImposedOutput;
	GETMOVEBASICP : POINTER TO L_MC1P_MoveBasic;
	JERKDEC : LREAL;
END_VAR
END_FUNCTION_BLOCK