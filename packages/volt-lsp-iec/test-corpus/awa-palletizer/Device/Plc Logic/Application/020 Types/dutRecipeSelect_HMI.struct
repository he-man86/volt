	sSelectedRecipeName		:STRING;
	sActiveRecipe			:STRING;
	sRecipeNames			:STRING(GLOBAL_CONSTANTS.iSizeRecipesNames);	//Combined recipe names	
	

	xBtnLoad : BOOL := FALSE;
	xBtnCancel : BOOL := FALSE;;
	
END_STRUCT
END_TYPE
