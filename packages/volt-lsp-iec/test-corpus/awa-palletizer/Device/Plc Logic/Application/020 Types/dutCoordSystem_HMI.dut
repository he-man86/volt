TYPE dutCoordSystem_HMI :
STRUCT
	iCoordSystemId : INT;		// Id.

	strName : STRING[30];
	
	lrX : LREAL;				// Position.
	lrY : LREAL;
	lrZ : LREAL;
	lrR : LREAL;
	
	lrXOffset : LREAL;			// Operator offset.
	lrYOffset : LREAL;
	lrZOffset : LREAL;
	lrROffset : LREAL;
	
	BtnCancel : BOOL := FALSE;
	BtnSave : BOOL := FALSE;
END_STRUCT
END_TYPE
