{
  "name": "@opencode-ai/volt-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Volt desktop shell — wraps the installed opencode's served GUI + the IDE panel (desktop sibling of volt-vscode).",
  "main": "main.mjs",
  "scripts": {
    "build": "bun build src/main.ts --target=node --format=esm --outfile=main.mjs --external electron",
    "start": "bun run build && electron ."
  },
  "dependencies": {
    "@opencode-ai/volt-control": "workspace:*"
  },
  "devDependencies": {
    "electron": "42.3.3"
  }
}
