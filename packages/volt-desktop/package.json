{
  "name": "@volt/desktop",
  "productName": "Volt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Volt desktop app — connection, sync and diagnostics for a PLC workspace (desktop sibling of volt-vscode).",
  "main": "main.mjs",
  "scripts": {
    "build": "bun build src/main.ts --target=node --format=esm --outfile=main.mjs --external electron",
    "dev": "bun build src/main.ts --target=node --format=esm --outfile=main.mjs --external electron --watch",
    "start": "bun run build && electron .",
    "typecheck": "tsgo --noEmit",
    "test": "bun test src",
    "test:e2e": "bun run build && bun test test/e2e"
  },
  "dependencies": {
    "@volt/control": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "electron": "42.3.3",
    "electron-builder": "^25.1.8",
    "typescript": "catalog:"
  }
}
