{
  "name": "@volt/desktop",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "Volt desktop shell — wraps the installed opencode's served GUI + the IDE panel (desktop sibling of volt-vscode).",
  "main": "main.mjs",
  "scripts": {
    "build": "bun build src/main.ts --target=node --format=esm --outfile=main.mjs --external electron",
    "dev": "bun build src/main.ts --target=node --format=esm --outfile=main.mjs --external electron --watch",
    "start": "bun run build && electron .",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@volt/control": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "electron": "42.3.3",
    "electron-builder": "^25.1.8",
    "typescript": "catalog:"
  }
}
