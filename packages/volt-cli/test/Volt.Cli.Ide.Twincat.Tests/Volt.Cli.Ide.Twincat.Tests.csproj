<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net8.0-WINDOWS, matching the driver under test. The other three test projects are plain net8.0 because
         what they cover is portable; this one references an exe that talks late-bound COM, so it inherits the TFM.
         Nothing here needs a live TwinCAT: TcItemArchive's collaborators are `dynamic`, so a plain C# double with
         the right method names binds, and the vendor calls never happen. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Volt.Cli.Ide.Twincat\Volt.Cli.Ide.Twincat.csproj" />
  </ItemGroup>
</Project>
