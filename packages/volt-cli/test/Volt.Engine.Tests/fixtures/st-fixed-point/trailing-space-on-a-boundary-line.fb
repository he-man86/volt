FUNCTION_BLOCK VirtualMaster
VAR
	MaxTorque	: REAL;
END_VAR
(* @volt-implementation *)
//Max torque on the axis. If the machine does not stop, this keeps the torque sane. 
MaxTorque := 100.0;

END_FUNCTION_BLOCK

METHOD PUBLIC Selection
//Selection of the cam. 
(* @volt-implementation *)
MaxTorque := 0;
END_METHOD
