          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="AddItem">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <inputVars>
                  <variable name="item">
                    <type>
                      <derived name="enumBoxItem" />
                    </type>
                  </variable>
                  <addData>
                    <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
                      <InterfaceAsPlainText>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD PUBLIC AddItem : BOOL
VAR_INPUT
	item		: enumBoxItem;
END_VAR
</xhtml>
                      </InterfaceAsPlainText>
                    </data>
                  </addData>
                </inputVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">CASE item OF
	enumBoxItem.None:
		AddItem						:= FALSE;

	enumBoxItem.ProductLayer:
		IF State &lt;&gt; enumBoxState.ProductsNeeded THEN
			AddItem					:= FALSE;
		ELSE
			ActualNumberOfLayers	:= ActualNumberOfLayers + 1;	// Add stack to box

			IF ActualNumberOfLayers &gt;= MaxNumberOfLayers THEN		// Check if box is full
				State				:= enumBoxState.ChangeNeeded;
//			ELSIF HardwareUnits.Data.BoxCenterUnit.EnableSheets THEN
//				State				:= BoxState.SheetNeeded;
			ELSE
				State				:= enumBoxState.ProductsNeeded;
			END_IF
			AddItem					:= TRUE;
		END_IF

	enumBoxItem.Sheet:
		IF State &lt;&gt; enumBoxState.SheetNeeded THEN
			AddItem					:= FALSE;
		ELSE
			State					:= enumBoxState.ProductsNeeded;
			AddItem					:= TRUE;
		END_IF
END_CASE
</xhtml>
                </ST>
              </body>
              <InterfaceAsPlainText>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">METHOD PUBLIC AddItem : BOOL
VAR_INPUT
	item		: enumBoxItem;
END_VAR
</xhtml>
              </InterfaceAsPlainText>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="SetToChangeNeeded">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">CASE State OF
	enumBoxState.ProductsNeeded, enumBoxState.SheetNeeded:
		State						:= enumBoxState.ChangeNeeded;
		SetToChangeNeeded			:= TRUE;
	ELSE
		SetToChangeNeeded			:= FALSE;
END_CASE
</xhtml>
