<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Volt.Engine.Host\Volt.Engine.Host.csproj" />
    <ProjectReference Include="..\..\src\Volt.Contracts\Volt.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Volt.Engine\Volt.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The one shared in-memory IDE fake, compiled into each test assembly (see test/shared/FakeIde.cs). -->
    <Compile Include="..\shared\FakeIde.cs" Link="FakeIde.cs" />
    <Compile Include="..\shared\ReadOnlyNetworkPush.cs" Link="ReadOnlyNetworkPush.cs" />
    <!-- The network text v2 model oracle, shared with the TwinCAT suite (its archives take the same check). -->
    <Compile Include="..\shared\NetworkModelOracle.cs" Link="NetworkModelOracle.cs" />
    <Compile Include="..\shared\NetworkTextFacts.cs" Link="NetworkTextFacts.cs" />
    <Compile Include="..\shared\NetworkModelEquality.cs" Link="NetworkModelEquality.cs" />
    <!-- The plain-ST round-trip oracle (openspec network-text-st 2.2). -->
    <Compile Include="..\shared\StNetworkOracle.cs" Link="StNetworkOracle.cs" />
    <!-- The shared network-text case set (test/fixtures/network-text), read by this suite and the LSP's alike. -->
    <Compile Include="..\shared\NetworkModelDump.cs" Link="NetworkModelDump.cs" />
    <Compile Include="..\shared\NetworkTextCases.cs" Link="NetworkTextCases.cs" />
    <Compile Include="..\shared\Scopes.cs" Link="Scopes.cs" />
    <!-- The LSP corpus as projects: the scope a corpus body is read against (shared with the NWL completeness oracle). -->
    <Compile Include="..\shared\CorpusProjects.cs" Link="CorpusProjects.cs" />
    <!-- The red-first mark (openspec bridge-one-to-one 2): a test that must fail until its task lands. -->
    <Compile Include="..\shared\ExpectRed.cs" Link="ExpectRed.cs" />
    <Using Include="Volt.Tests.Shared" />   <!-- so every file sees the shared double, as before -->
  </ItemGroup>
  <ItemGroup>
    <None Include="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
