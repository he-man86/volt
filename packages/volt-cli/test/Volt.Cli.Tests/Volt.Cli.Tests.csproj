<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Volt.Engine.Host\Volt.Engine.Host.csproj" />
    <ProjectReference Include="..\..\src\Volt.Contracts\Volt.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Volt.Engine\Volt.Engine.csproj" />
    <ProjectReference Include="..\..\src\Volt.Wire\Volt.Wire.csproj" />
    <!-- The `volt` exe now holds the Sync/ client logic these tests exercise; referencing it also builds the exe
         the black-box test spawns. Top-level Program is internal, so no entry-point clash. -->
    <ProjectReference Include="..\..\src\Volt.Cli\Volt.Cli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The one shared in-memory IDE fake, compiled into each test assembly (see test/shared/FakeIde.cs). -->
    <Compile Include="..\shared\FakeIde.cs" Link="FakeIde.cs" />
    <!-- The red-first mark (openspec bridge-one-to-one 2): GitEnvironmentTests is red until environment-dependency-audit 2.1. -->
    <Compile Include="..\shared\ExpectRed.cs" Link="ExpectRed.cs" />
    <!-- Who a bridge pipe admits (environment-dependency-audit 2.2): net10 here, net48 in the CODESYS suite. -->
    <Compile Include="..\shared\PipeAccessTests.cs" Link="PipeAccessTests.cs" />
    <Using Include="Volt.Tests.Shared" />   <!-- so every file sees the shared double, as before -->
  </ItemGroup>
</Project>
