<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net8.0-WINDOWS, matching the driver under test. The other three test projects are plain net8.0 because
         what they cover is portable; this one references an exe that talks late-bound COM, so it inherits the TFM.
         Nothing here needs a live TwinCAT: TcItemArchive's collaborators are `dynamic`, so a plain C# double with
         the right method names binds, and the vendor calls never happen. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Volt.Ide.Twincat\Volt.Ide.Twincat.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The network text v2 model oracle, shared with the engine suite (test/shared/NetworkModelOracle.cs). -->
    <Compile Include="..\shared\NetworkModelOracle.cs" Link="NetworkModelOracle.cs" />
    <Compile Include="..\shared\NetworkTextFacts.cs" Link="NetworkTextFacts.cs" />
    <Compile Include="..\shared\NetworkModelEquality.cs" Link="NetworkModelEquality.cs" />
    <Compile Include="..\shared\Scopes.cs" Link="Scopes.cs" />
    <!-- The NWL completeness oracle (openspec ld-fbd-coverage 1b.3): the archive model, the member table and the
         comparison, shared by both drivers' halves; the corpus projects give each body its scope. -->
    <Compile Include="..\shared\NwlArchive.cs" Link="NwlArchive.cs" />
    <Compile Include="..\shared\NwlCompleteness.cs" Link="NwlCompleteness.cs" />
    <Compile Include="..\shared\CorpusProjects.cs" Link="CorpusProjects.cs" />
    <!-- The red-first mark (openspec bridge-one-to-one 2) and the wire-parity constants both drivers' doubles assert. -->
    <Compile Include="..\shared\ExpectRed.cs" Link="ExpectRed.cs" />
    <Compile Include="..\shared\WireParityCases.cs" Link="WireParityCases.cs" />
    <Compile Include="..\shared\ProjectSettingsFacts.cs" Link="ProjectSettingsFacts.cs" />
    <!-- One tree node, at most one unreadableNodes entry: the gate every offline walk passes through. -->
    <Compile Include="..\shared\OneEntryPerNode.cs" Link="OneEntryPerNode.cs" />
    <!-- The one in-memory driver double, for the fetch tests that feed it this vendor's REAL parsed signatures
         (TcDirectedLibraryReadTests). -->
    <Compile Include="..\shared\FakeIde.cs" Link="FakeIde.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The suite's own vendor fixtures, beside the test binary. Without this the loader cannot find them. -->
    <None Include="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
