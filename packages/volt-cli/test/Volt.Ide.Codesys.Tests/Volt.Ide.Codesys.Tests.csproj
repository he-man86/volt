<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net48, matching the driver under test — Volt.Ide.Codesys is the IN-PROC bridge, loaded by CODESYS's own
         .NET Framework host, so it cannot be anything else and neither can a project that references it.

         Nothing here needs a live CODESYS. `NwlInterop` reaches every vendor member by REFLECTION
         (`Type.GetProperty` / `InvokeMember`) and `CodesysNetworkReader` dispatches on `GetType().Name`, so a
         plain C# class NAMED `BoxTreeBox` with the right properties IS a box as far as the reader can tell.
         That is what makes the object model testable at all without the IDE, and it is why the shape that took a
         whole POU out of a user's workspace (DIALECT C7) now has a gate. -->
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="IronPython" />
    <PackageReference Include="IronPython.StdLib" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Volt.Ide.Codesys\Volt.Ide.Codesys.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The scope a model's text is read back against, and the model equality the oracles share. -->
    <Compile Include="..\shared\NetworkModelScopes.cs" Link="NetworkModelScopes.cs" />
    <Compile Include="..\shared\NetworkTextFacts.cs" Link="NetworkTextFacts.cs" />
    <Compile Include="..\shared\NetworkModelEquality.cs" Link="NetworkModelEquality.cs" />
    <!-- The plain-ST round-trip oracle (openspec network-text-st 2.2). -->
    <Compile Include="..\shared\StNetworkOracle.cs" Link="StNetworkOracle.cs" />
    <Compile Include="..\shared\CorpusNetworkText.cs" Link="CorpusNetworkText.cs" />
    <Compile Include="..\shared\Scopes.cs" Link="Scopes.cs" />
    <!-- The NWL completeness oracle (openspec ld-fbd-coverage 1b.3): the archive model, the member table and the
         comparison, shared by both drivers' halves; the corpus projects give each body its scope. -->
    <Compile Include="..\shared\NwlArchive.cs" Link="NwlArchive.cs" />
    <Compile Include="..\shared\NwlCompleteness.cs" Link="NwlCompleteness.cs" />
    <Compile Include="..\shared\CorpusProjects.cs" Link="CorpusProjects.cs" />
    <!-- The red-first mark (openspec bridge-one-to-one 2) and the wire-parity constants both drivers' doubles assert. -->
    <Compile Include="..\shared\ExpectRed.cs" Link="ExpectRed.cs" />
    <Compile Include="..\shared\WireParityCases.cs" Link="WireParityCases.cs" />
    <Compile Include="..\shared\ProjectSettingsFacts.cs" Link="ProjectSettingsFacts.cs" />
    <!-- One tree node, at most one unreadableNodes entry: the gate every offline walk passes through. -->
    <Compile Include="..\shared\OneEntryPerNode.cs" Link="OneEntryPerNode.cs" />
    <!-- Who a bridge pipe admits (environment-dependency-audit 2.2): net10 here, net48 in the CODESYS suite. -->
    <Compile Include="..\shared\PipeAccessTests.cs" Link="PipeAccessTests.cs" />
    <Compile Include="..\shared\UnelevatedFact.cs" Link="UnelevatedFact.cs" />
    <!-- The relay tunnel on .NET Framework's socket stack, the one the CODESYS in-proc bridge dials with (openspec
         relay-chunked-results §5): the same real-socket tests the net10 relay suite runs. -->
    <Compile Include="..\shared\RelayRealSocketTests.cs" Link="RelayRealSocketTests.cs" />
    <Compile Include="..\shared\RelayChunkCheck.cs" Link="RelayChunkCheck.cs" />
  </ItemGroup>

  <!-- The SHIPPED bundle (the bridge's merged single assembly, Volt.Ide.Codesys.csproj's VoltBundle target), copied in
       as codesys-bundle\ for StartScriptLoadTests. Everything else here tests the unmerged build this project
       references: the merge internalizes Volt.*, so the doubles could not reach the internals they test through it. -->
  <Target Name="CopyCodesysBundle" AfterTargets="Build">
    <MSBuild Projects="..\..\src\Volt.Ide.Codesys\Volt.Ide.Codesys.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_CodesysBridge" />
    </MSBuild>
    <ItemGroup>
      <_CodesysBundle Include="%(_CodesysBridge.RootDir)%(_CodesysBridge.Directory)bundle\*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)codesys-bundle" />
    <Copy SourceFiles="@(_CodesysBundle)" DestinationFolder="$(OutDir)codesys-bundle" />
  </Target>
</Project>
