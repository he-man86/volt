# TwinCAT build artifacts — regenerated on open/build, so only the SOURCE of the fixture
# solutions (TwinCAT Project13/14) is committed. Keeps ~140M of compile cache out of the repo.
_CompileInfo/
_Boot/
_Config/
_Libraries/
*.tsproj.bak
*.tsproj.tmp
*.project.~u
*.tmcRefac
.vs/
*.suo
*.user

# CODESYS regenerates this on open (and it is 130 KB of derived state).
*.precompilecache

# CODESYS per-user / per-machine IDE state. Derived on open, and `CodesysTestProject-AllUsers.opt` was tracked
# by accident — no rule covered `*.opt`, so it rode along with the project it sits beside.
*.opt
*.~u
