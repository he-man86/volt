#### branch-fed — B8: `feed BRANCH (a, b, …)`, the branches in stored order, one per line (P2: the writer's layout); the editor's Sequential mode written as nothing
=== text
IMPLEMENTATION LD
NETWORK
  lamp := start BRANCH (a,
                        b AND (speed LE 40),
                        c);
END_NETWORK
=== model
NETWORK
  (:= lamp (par seq start a (AND b (LE speed 40 conn:0 main:0 eno:0)) c))

#### branch-one-line — P2: inside brackets line breaks are layout — one line reads to the same tree
=== text
IMPLEMENTATION LD
NETWORK
  lamp := start BRANCH (a, b, c) SHORTCIRCUIT;
END_NETWORK
=== model
NETWORK
  (:= lamp (par sc start a b c))
=== canonical
IMPLEMENTATION LD
NETWORK
  lamp := start BRANCH (a,
                        b,
                        c) SHORTCIRCUIT;
END_NETWORK

#### branch-unfed — B8: an unfed parallel is `BRANCH (a, b)`, nothing before BRANCH (5 of 17)
=== text
IMPLEMENTATION LD
NETWORK
  lamp := BRANCH (a,
                  b);
END_NETWORK
=== model
NETWORK
  (:= lamp (par seq - a b))

#### branch-shortcircuit — B8: the old short-circuit mode says so after the list (Lenze: 16 of 17)
=== text
IMPLEMENTATION LD
NETWORK
  lamp := start BRANCH (a,
                        b) SHORTCIRCUIT;
END_NETWORK
=== model
NETWORK
  (:= lamp (par sc start a b))

#### branch-nested — B8: a parallel inside a branch is the same form, written inline (a branch is a slot, P4)
=== text
IMPLEMENTATION LD
NETWORK
  lamp7 := start BRANCH (a,
                         c BRANCH (b, go));
END_NETWORK
=== model
NETWORK
  (:= lamp7 (par seq start a (par seq c b go)))

#### branch-inside-a-word — B8/P4: a parallel as a word's operand stands in brackets (MainDrive N2)
=== text
IMPLEMENTATION LD
NETWORK
  MOVE speed => tInt EN (run BRANCH (NOT memLower,
                                     (speed LE 40 EN memLower))) AND NOT cleaning;
END_NETWORK
=== model
NETWORK
  (MOVE speed =>1:tInt en:(AND (par seq run not:memLower (LE speed 40 en:memLower conn:0 main:0 eno:0)) not:cleaning) eno:1)

#### branch-word-feed — B5/P4: BRANCH is a word, so a feed that is a box word is bracketed
=== text
IMPLEMENTATION LD
NETWORK
  x := (s AND sync) BRANCH (a,
                            b);
END_NETWORK
=== model
NETWORK
  (:= x (par seq (AND s sync) a b))

#### branch-negated-feed — P6: `NOT s BRANCH (a, b)` negates the feed
=== text
IMPLEMENTATION LD
NETWORK
  x := NOT s BRANCH (a,
                     b);
END_NETWORK
=== model
NETWORK
  (:= x (par seq not:s a b))

#### branch-as-en-tail — P4: an EN tail is a slot — a parallel there takes no brackets
=== text
IMPLEMENTATION LD
NETWORK
  MOVE 1 => x EN go BRANCH (a,
                            b);
END_NETWORK
=== model
NETWORK
  (MOVE 1 =>1:x en:(par seq go a b) eno:1)

#### branch-camc — B8: Lenze `fc_CamC_CC_Base`, enabled comparisons as branches, a nested short-circuit parallel
=== text
IMPLEMENTATION LD
NETWORK
  o_xCamControl := i_xEnable BRANCH ((Pos LE Stop EN (Pos GE Start EN (Start LT Stop EN))),
                                     (Start GT Stop EN) BRANCH ((Pos GE Start EN), (Pos LE Stop EN)) SHORTCIRCUIT) SHORTCIRCUIT;
END_NETWORK
=== model
NETWORK
  (:= o_xCamControl (par sc i_xEnable (LE Pos Stop en:(GE Pos Start en:(LT Start Stop en:_ conn:0 main:0 eno:0) conn:0 main:0 eno:0) conn:0 main:0 eno:0) (par sc (GT Start Stop en:_ conn:0 main:0 eno:0) (GE Pos Start en:_ conn:0 main:0 eno:0) (LE Pos Stop en:_ conn:0 main:0 eno:0))))
