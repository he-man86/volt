#### jump-coil — a jump is a coil the rung drives, `JMP Done := a AND b;`
=== text
IMPLEMENTATION LD
NETWORK
  JMP Done := a AND b;
END_NETWORK
NETWORK LABEL: Done
  x := TRUE;
END_NETWORK
=== model
NETWORK
  (jmp Done (AND a b))
NETWORK label:Done
  (:= x TRUE)

#### jump-rail — a jump nothing drives: its value is the empty slot, `JMP Done := ;` (C11)
=== text
IMPLEMENTATION LD
NETWORK
  JMP Done := ;
END_NETWORK
NETWORK LABEL: Done
  x := TRUE;
END_NETWORK
=== model
NETWORK
  (jmp Done _)
NETWORK label:Done
  (:= x TRUE)

#### return-coil — a conditional return, `RETURN := NOT xReady;`
=== text
IMPLEMENTATION LD
NETWORK
  RETURN := NOT xReady;
END_NETWORK
=== model
NETWORK
  (ret not:xReady)

#### return-rail — `RETURN := ;`
=== text
IMPLEMENTATION LD
NETWORK
  RETURN := ;
END_NETWORK
=== model
NETWORK
  (ret _)

#### coil-and-jump — a coil and a jump on one rung, in stored order
=== text
IMPLEMENTATION LD
NETWORK
  x1 := JMP Done := c;
  x2 := RETURN := c;
END_NETWORK
NETWORK LABEL: Done
  x := TRUE;
END_NETWORK
=== model
NETWORK
  (:= x1 jmp:Done c)
  (:= x2 ret c)
NETWORK label:Done
  (:= x TRUE)

#### two-jumps — two jumps on one rung, in stored order
=== text
IMPLEMENTATION LD
NETWORK
  JMP L1 := JMP L2 := c;
END_NETWORK
NETWORK LABEL: L1
  x := TRUE;
END_NETWORK
NETWORK LABEL: L2
  y := TRUE;
END_NETWORK
=== model
NETWORK
  (:= jmp:L1 jmp:L2 c)
NETWORK label:L1
  (:= x TRUE)
NETWORK label:L2
  (:= y TRUE)

#### jump-set — a jump and a return take S=
=== text
IMPLEMENTATION LD
NETWORK
  JMP Done S= c;
  RETURN S= c;
END_NETWORK
NETWORK LABEL: Done
  x := TRUE;
END_NETWORK
=== model
NETWORK
  (:= S=jmp:Done c)
  (:= S=ret c)
NETWORK label:Done
  (:= x TRUE)

#### nested-jump — a jump nests like any coil
=== text
IMPLEMENTATION LD
NETWORK
  y := (JMP Done := c);
END_NETWORK
NETWORK LABEL: Done
  x := TRUE;
END_NETWORK
=== model
NETWORK
  (:= y (jmp Done c))
NETWORK label:Done
  (:= x TRUE)

#### nested-assign — a nested assignment is bracketed: `y := (x := a);` is one coil fed by another
=== text
IMPLEMENTATION LD
NETWORK
  y := (x := a AND b);
END_NETWORK
=== model
NETWORK
  (:= y (:= x (AND a b)))

#### multi-coil — `y := x := a;` is ONE assignment with two coils, in stored order
=== text
IMPLEMENTATION LD
NETWORK
  y := x := a;
END_NETWORK
=== model
NETWORK
  (:= y x a)

#### set-reset-chain — S= and R= are coils; on one variable the last stored wins (11)
=== text
IMPLEMENTATION LD
NETWORK
  a := b S= c R= value;
  lamp S= lamp R= c;
  lamp R= lamp S= c;
END_NETWORK
=== model
NETWORK
  (:= a S=b R=c value)
  (:= S=lamp R=lamp c)
  (:= R=lamp S=lamp c)

#### coil-on-rail — a coil nothing drives, `x R= ;`
=== text
IMPLEMENTATION LD
NETWORK
  FirstCycle R= ;
END_NETWORK
=== model
NETWORK
  (:= R=FirstCycle _)

#### negated-coil — a coil's negation stands before it, `NOT xn := c;`
=== text
IMPLEMENTATION LD
NETWORK
  NOT xn := c;
END_NETWORK
=== model
NETWORK
  (:= not:xn c)

#### edge-coils — an edge stands before the coil, before its NOT
=== text
IMPLEMENTATION LD
NETWORK
  R_EDGE xe := c;
  F_EDGE xf := c;
  F_EDGE NOT xg := c;
END_NETWORK
=== model
NETWORK
  (:= rise:xe c)
  (:= fall:xf c)
  (:= fall:not:xg c)

#### negated-empty-value — a negation on the empty slot, `x := NOT;` (it writes TRUE)
=== text
IMPLEMENTATION LD
NETWORK
  x := NOT;
END_NETWORK
=== model
NETWORK
  (:= x not:_)

#### split-defined-and-read — a split is its VarId, defined once, read anywhere in its network
=== text
IMPLEMENTATION LD
NETWORK
  split175 := TRUE;
  split176 := split175 AND RunAuto;
  a := split176;
  b := split176 AND c;
END_NETWORK
=== model
NETWORK
  (split 175 TRUE)
  (split 176 (AND #175 RunAuto))
  (:= a #176)
  (:= b (AND #176 c))

#### split-of-a-box — a split's type is its feeder's: nothing written
=== text
IMPLEMENTATION FBD
NETWORK
  split12 := a ADD b;
  x := split12;
END_NETWORK
=== model
NETWORK
  (split 12 (ADD a b conn:0))
  (:= x #12)

#### split-in-en — a split read by an EN
=== text
IMPLEMENTATION LD
NETWORK
  split174 := TRUE;
  MOVE 0 => t ENO EN split174;
END_NETWORK
=== model
NETWORK
  (split 174 TRUE)
  (MOVE 0 =>1:t en:#174 eno:1)

#### split-variable-backticked — a variable named like a split is backticked; the bare word is the split
=== scope
name split1
=== text
IMPLEMENTATION LD
NETWORK
  split1 := a;
  x := split1;
  `split1` := split1;
END_NETWORK
=== model
NETWORK
  (split 1 a)
  (:= x #1)
  (:= split1 #1)

#### split-before-definition — a split read above its definition, in the stored order (it reads the previous scan)
=== text
IMPLEMENTATION LD
NETWORK
  x := split1;
  split1 := a AND b;
  y := split1 AND c;
END_NETWORK
=== model
NETWORK
  (:= x #1)
  (split 1 (AND a b))
  (:= y (AND #1 c))

#### split-nested-definition — a split defined below the top level, bracketed
=== text
IMPLEMENTATION LD
NETWORK
  x := (split1 := a AND b);
  y := split1 AND c;
END_NETWORK
=== model
NETWORK
  (:= x (split 1 (AND a b)))
  (:= y (AND #1 c))
