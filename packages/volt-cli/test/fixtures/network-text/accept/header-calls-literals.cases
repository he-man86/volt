#### header-order — `NETWORK [LABEL: x] [DISABLED] [TITLE: "…"]`, in that order
=== text
%LANGUAGE LD
NETWORK LABEL: Start DISABLED TITLE: "Calc"
  x := a;
END_NETWORK
=== model
NETWORK label:Start disabled title:"Calc"
  (:= x a)

#### title-escapes — a title exactly as stored, with IEC's escapes: `$$` `$"` `$L` `$R`
=== text
%LANGUAGE LD
NETWORK TITLE: "Calc $"A$" $$5 $R$L"
  x := a;
END_NETWORK
=== model
NETWORK title:"Calc \"A\" $5 \r\n"
  (:= x a)

#### title-other-escapes — `$N` is the IDE's line end, `$T` a tab, `$'` a quote: read, and written back verbatim
=== text
%LANGUAGE LD
NETWORK TITLE: "a$Nb$Tc$'d"
  x := a;
END_NETWORK
=== model
NETWORK title:"a\r\nb\tc'd"
  (:= x a)
=== canonical
%LANGUAGE LD
NETWORK TITLE: "a$R$Lb	c'd"
  x := a;
END_NETWORK

#### comment-lines — one `//` line per stored CR LF line; `// ` and one space are syntax
=== text
%LANGUAGE LD
NETWORK
  // first line
  //   indented
  //
  // last
  x := a;
END_NETWORK
=== model
NETWORK comment:"first line\r\n  indented\r\n\r\nlast"
  (:= x a)

#### comment-trailing-line — a trailing CR LF in the stored comment is a final bare `//` line
=== text
%LANGUAGE LD
NETWORK
  // only
  //
  x := a;
END_NETWORK
=== model
NETWORK comment:"only\r\n"
  (:= x a)

#### comment-escapes — a `$` in a comment is `$$`; a bare LF `$L`, a bare CR `$R`
=== text
%LANGUAGE LD
NETWORK
  // cost $$5$Lnext$Rend
  x := a;
END_NETWORK
=== model
NETWORK comment:"cost $5\nnext\rend"
  (:= x a)

#### empty-network — a network with no item
=== text
%LANGUAGE LD
NETWORK
END_NETWORK
=== model
NETWORK

#### empty-item — `;` alone is the empty item
=== text
%LANGUAGE LD
NETWORK
  ;
END_NETWORK
=== model
NETWORK
  _

#### unsupported-line — a network the text cannot spell: its one line, the shape and the network's hash
=== text
%LANGUAGE LD
NETWORK TITLE: "kept"
  UNSUPPORTED "a flag on a box input pin" #3f9a01c2;
END_NETWORK
=== model
NETWORK title:"kept" unsupported:"a flag on a box input pin" hash:3f9a01c2

#### fb-call-empty-pin — a named input left empty: `IN := ,`
=== scope
instance t2 TON
=== text
%LANGUAGE LD
NETWORK
  output := t2 : TON(IN := , PT := e1).Q;
END_NETWORK
=== model
NETWORK
  (:= output (TON@t2 IN=_ PT=e1 name:Q))

#### unnamed-instance — `??? : TYPE(…)`, the vendor's unnamed instance
=== scope
fb Axis
=== text
%LANGUAGE FBD
NETWORK
  ??? : Axis(xEnable := go);
END_NETWORK
=== model
NETWORK
  (Axis@??? xEnable=go)

#### undeclared-instance — an instance the declarations do not name: the call names its type, which the build judges
=== text
%LANGUAGE FBD
NETWORK
  t9 : TON(IN := go);
END_NETWORK
=== model
NETWORK
  (TON@t9 IN=go)

#### array-element-instance — an element of an array of FBs is the instance, backticked
=== scope
instance fbs[] CTU
=== text
%LANGUAGE LD
NETWORK
  `fbs[1]` : CTU(CU := go, PV := 10, CV => n);
END_NETWORK
=== model
NETWORK
  (CTU@`fbs[1]` CU=go PV=10 =>CV:n)

#### method-call — a method of an instance is a call, `inst.m(…)`
=== scope
instance fbm FB_M
=== text
%LANGUAGE FBD
NETWORK
  x := fbm.Visible(on := go);
END_NETWORK
=== model
NETWORK
  (:= x (fbm.Visible on=go conn:0))

#### positional-pins — a pin stored with no name is positional, in slot order
=== text
%LANGUAGE FBD
NETWORK
  y := LIMIT(0, v, 100);
END_NETWORK
=== model
NETWORK
  (:= y (LIMIT 0 v 100 conn:0))

#### pin-vs-contact — `f(NOT IN := v)` negates the pin, `f(IN := NOT v)` the contact feeding it
=== scope
instance t1 TON
instance t2 TON
=== text
%LANGUAGE FBD
NETWORK
  q := t1 : TON(NOT IN := v, PT := T#1S).Q;
  p := t2 : TON(IN := NOT v, PT := T#1S).Q;
END_NETWORK
=== model
NETWORK
  (:= q (TON@t1 !IN=v PT=T#1S name:Q))
  (:= p (TON@t2 IN=not:v PT=T#1S name:Q))

#### negated-contact — `NOT x` is the negated contact, a flag
=== text
%LANGUAGE LD
NETWORK
  x := a AND NOT b;
END_NETWORK
=== model
NETWORK
  (:= x (AND a not:b))

#### edges — `R_EDGE x`, `F_EDGE x`, `R_EDGE NOT x`: prefixes; the IDE negates before the edge (N17)
=== text
%LANGUAGE LD
NETWORK
  a := R_EDGE x;
  b := F_EDGE x;
  c := R_EDGE NOT x;
END_NETWORK
=== model
NETWORK
  (:= a rise:x)
  (:= b fall:x)
  (:= c rise:not:x)

#### negated-call — a modifier on a call with no EN or ENO needs no bracket
=== text
%LANGUAGE FBD
NETWORK
  x := NOT f(IN := a);
END_NETWORK
=== model
NETWORK
  (:= x not:(f IN=a conn:0))

#### literals — a literal is bare
=== text
%LANGUAGE LD
NETWORK
  sName := 'Recipes';
  n := -1;
  re := -1.5;
  t := T#1S;
  w := 16#FF;
END_NETWORK
=== model
NETWORK
  (:= sName 'Recipes')
  (:= n -1)
  (:= re -1.5)
  (:= t T#1S)
  (:= w 16#FF)

#### expression-operand — an operand that is no one token is written between backticks
=== text
%LANGUAGE LD
NETWORK
  MOVE `DINT_TO_LREAL(pos)/10` => target ENO EN go;
END_NETWORK
=== model
NETWORK
  (MOVE `DINT_TO_LREAL(pos)/10` =>1:target en:go eno:1)

#### backtick-escapes — inside backticks a backtick is doubled and a `$` is `$$`
=== text
%LANGUAGE LD
NETWORK
  x := `a``b`;
  y := `CONCAT('$$N', s)`;
END_NETWORK
=== model
NETWORK
  (:= x `a`b`)
  (:= y `CONCAT('$N', s)`)

#### empty-text-operand — the empty backtick pair is the empty-text operand
=== scope
instance ton1 TON
=== text
%LANGUAGE LD
NETWORK
  q := ton1 : TON(IN := TRUE, PT := ``).Q;
END_NETWORK
=== model
NETWORK
  (:= q (TON@ton1 IN=TRUE PT=`` name:Q))

#### reserved-backticked — a name spelled like a word of the text is backticked
=== text
%LANGUAGE LD
NETWORK
  y := `ENO`;
  `EN` := c;
  z := `Branch` AND `ShortCircuit`;
END_NETWORK
=== model
NETWORK
  (:= y ENO)
  (:= EN c)
  (:= z (AND Branch ShortCircuit))

#### non-words-are-names — IF, THEN, LET, VAR_TEMP, PARALLEL and INTO are no words of the text
=== text
%LANGUAGE LD
NETWORK
  Parallel := Feed AND Then AND Into AND Let;
END_NETWORK
=== model
NETWORK
  (:= Parallel (AND Feed Then Into Let))

#### reserved-pin-and-head-backticked — a pin, a callee or an output named like a word is backticked
=== text
%LANGUAGE LD
NETWORK
  `Execute`(`branch` := b, `en` => x);
END_NETWORK
=== model
NETWORK
  (Execute branch=b =>en:x)

#### header-disabled-title — `NETWORK DISABLED TITLE: "x"`
=== text
%LANGUAGE FBD
NETWORK DISABLED TITLE: "x"
  y := a;
END_NETWORK
=== model
NETWORK disabled title:"x"
  (:= y a)
