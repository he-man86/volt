#### r5-coil-and-jump — 2R.5 (#9): a jump is a coil, so one rung drives a coil and a jump, `x1 := JMP Done := c;`
=== text
IMPLEMENTATION LD
NETWORK
  x1 := JMP Done := c;
END_NETWORK
NETWORK LABEL: Done
  x := TRUE;
END_NETWORK
=== model
NETWORK
  (:= x1 jmp:Done c)
NETWORK label:Done
  (:= x TRUE)

#### r5-coil-and-return — 2R.5 (#10): a coil and a return on one rung, `x1 := RETURN := c;`
=== text
IMPLEMENTATION LD
NETWORK
  x1 := RETURN := c;
END_NETWORK
=== model
NETWORK
  (:= x1 ret c)

#### r5-two-jumps — 2R.5 (#11): two jumps on one rung, in stored order (the first taken wins)
=== text
IMPLEMENTATION LD
NETWORK
  JMP L1 := JMP L2 := c;
END_NETWORK
NETWORK LABEL: L1
  x := TRUE;
END_NETWORK
NETWORK LABEL: L2
  y := TRUE;
END_NETWORK
=== model
NETWORK
  (:= jmp:L1 jmp:L2 c)
NETWORK label:L1
  (:= x TRUE)
NETWORK label:L2
  (:= y TRUE)

#### r5-jump-set — 2R.5 (#12): a jump is a coil, and a coil takes S=
=== text
IMPLEMENTATION LD
NETWORK
  JMP Done S= c;
END_NETWORK
NETWORK LABEL: Done
  x := TRUE;
END_NETWORK
=== model
NETWORK
  (:= S=jmp:Done c)
NETWORK label:Done
  (:= x TRUE)

#### r5-return-set — 2R.5: a return is a coil, and a coil takes S=
=== text
IMPLEMENTATION LD
NETWORK
  RETURN S= c;
END_NETWORK
=== model
NETWORK
  (:= S=ret c)

#### r5-nested-jump — 2R.5: a jump is a coil, and a coil nests (P4 (3))
=== text
IMPLEMENTATION LD
NETWORK
  y := (JMP Done := c);
END_NETWORK
NETWORK LABEL: Done
  x := TRUE;
END_NETWORK
=== model
NETWORK
  (:= y (jmp Done c))
NETWORK label:Done
  (:= x TRUE)

#### r5-negated-coil — 2R.5 (#13): a coil's modifier stands before its target, `NOT xn := c;`
=== text
IMPLEMENTATION LD
NETWORK
  NOT xn := c;
END_NETWORK
=== model
NETWORK
  (:= not:xn c)

#### r5-rising-coil — 2R.5 (#14): a rising-edge coil, `R_EDGE xe := c;`
=== text
IMPLEMENTATION LD
NETWORK
  R_EDGE xe := c;
END_NETWORK
=== model
NETWORK
  (:= rise:xe c)

#### r5-falling-coil — 2R.5: a falling-edge coil, `F_EDGE xf := c;`
=== text
IMPLEMENTATION LD
NETWORK
  F_EDGE xf := c;
END_NETWORK
=== model
NETWORK
  (:= fall:xf c)

#### r5-rising-pin — 2R.5 (#15): an edge on a box's input pin, written on its formal like a negation (P5)
=== text
IMPLEMENTATION LD
NETWORK
  x := AND(R_EDGE IN1 := c, one);
END_NETWORK
=== model
NETWORK
  (:= x (AND /c one))

#### r5-falling-pin — 2R.5: a falling edge on a call's named pin
=== scope
instance t1 TON
=== text
IMPLEMENTATION LD
NETWORK
  t1(F_EDGE IN := go, PT := T#1S);
END_NETWORK
=== model
NETWORK
  (TON@t1 \IN=go PT=T#1S)

#### r5-negated-en — 2R.5 (#16): a negated EN pin, the modifier before the word, `NOT EN c`
=== text
IMPLEMENTATION LD
NETWORK
  MOVE 5 => y NOT EN c;
END_NETWORK
=== model
NETWORK
  (MOVE 5 =>1:y !en:c eno:1)

#### r5-negated-en-call — 2R.5: a negated EN pin on a call
=== scope
instance t1 TON
=== text
IMPLEMENTATION LD
NETWORK
  t1(IN := go, PT := T#1S) NOT EN c;
END_NETWORK
=== model
NETWORK
  (TON@t1 IN=go PT=T#1S !en:c)

#### r5-negated-empty-value — 2R.5 (#6a): a negation on an empty slot, `x := NOT ;`
=== text
IMPLEMENTATION LD
NETWORK
  x := NOT ;
END_NETWORK
=== model
NETWORK
  (:= x not:_)

#### r5-array-element-instance — 2R.5 (#17): a call head is any variable reference — an element of an array of FBs, backticked like every operand that is not one token
=== scope
instance fbs[] CTU
=== text
IMPLEMENTATION LD
NETWORK
  `fbs[1]`(CU := go, PV := 10, CV => n);
END_NETWORK
=== model
NETWORK
  (CTU@`fbs[1]` CU=go PV=10 =>CV:n)

#### r5-split-before-definition — 2R.5 (#19): a split referenced above its definition, in the stored order (it reads the previous scan)
=== text
IMPLEMENTATION LD
NETWORK
  x := split1;
  split1 := a AND b;
  y := split1 AND c;
END_NETWORK
=== model
NETWORK
  (:= x #1)
  (split 1 (AND a b))
  (:= y (AND #1 c))

#### r5-split-nested-definition — 2R.5 (#20): a split defined below the top level, bracketed as a nested assignment (P4 (3))
=== text
IMPLEMENTATION LD
NETWORK
  x := (split1 := a AND b);
  y := split1 AND c;
END_NETWORK
=== model
NETWORK
  (:= x (split 1 (AND a b)))
  (:= y (AND #1 c))

#### r5-comparison-eno — 2R.5 (#22): a comparison is a box like any other — enabled on an open line, its ENO read below
=== text
IMPLEMENTATION LD
NETWORK
  a GT 5 => x EN c
  lamp := ENO;
END_NETWORK
=== model
NETWORK
  (:= lamp (GT a 5 =>1:x en:c conn:0 eno:1))

#### r5-named-eno-pin-and-output — 2R.5 (#23): the named ENO pin beside a data output (P5)
=== text
IMPLEMENTATION LD
NETWORK
  MOVE(7, ENO => lamp, => x) EN c;
END_NETWORK
=== model
NETWORK
  (MOVE 7 =>ENO:lamp =>1:x en:c eno:1)

#### r5-empty-branch — 2R.5 (readability Open c): an empty branch stores, builds and runs (a shorted branch) — `(a, , b)`
=== text
IMPLEMENTATION LD
NETWORK
  x := s BRANCH (a,
                 ,
                 b);
END_NETWORK
=== model
NETWORK
  (:= x (par seq s a _ b))

#### r5-trailing-empty-branch — 2R.5: the empty branch last, `(a, )`
=== text
IMPLEMENTATION LD
NETWORK
  x := s BRANCH (a,
                 );
END_NETWORK
=== model
NETWORK
  (:= x (par seq s a _))
