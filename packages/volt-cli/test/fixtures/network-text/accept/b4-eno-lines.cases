#### eno-to-coil — B4: a line without `;` is open; the next line reads its box's ENO as ENO
=== text
IMPLEMENTATION LD
NETWORK
  MOVE 860 => AutoSpeed EN go
  StartAuto := ENO;
END_NETWORK
=== model
NETWORK
  (:= StartAuto (MOVE 860 =>1:AutoSpeed en:go conn:0 eno:1))

#### eno-chain — B4: four MOVEs in a chain, each enabled by the ENO of the line above (Lenze AHWF)
=== text
IMPLEMENTATION LD
NETWORK
  MOVE 175 => VelUnit EN go AND TRUE
  MOVE 2000 => DecUnit EN ENO
  MOVE 750 => AccUnit EN ENO
  MOVE 100 => TorqueLimit EN ENO;
END_NETWORK
=== model
NETWORK
  (MOVE 100 =>1:TorqueLimit en:(MOVE 750 =>1:AccUnit en:(MOVE 2000 =>1:DecUnit en:(MOVE 175 =>1:VelUnit en:(AND go TRUE) conn:0 eno:1) conn:0 eno:1) conn:0 eno:1) eno:1)

#### eno-with-contacts — B4: ENO mixed with contacts (Lenze AHWF N2)
=== scope
instance IDB_WSM FB_WSM
=== text
IMPLEMENTATION LD
NETWORK
  IDB_WSM(iInit := first, oSprayingValve => tSpray) EN
  Pos1B := ENO AND Pressurised AND tSpray;
END_NETWORK
=== model
NETWORK
  (:= Pos1B (AND (FB_WSM@IDB_WSM iInit=first =>oSprayingValve:tSpray en:_ conn:0 eno:1) Pressurised tSpray))

#### eno-plus-logic — B4: ENO plus extra logic on the next EN
=== text
IMPLEMENTATION LD
NETWORK
  MOVE 1 => A EN c
  MOVE 2 => B EN ENO AND x;
END_NETWORK
=== model
NETWORK
  (MOVE 2 =>1:B en:(AND (MOVE 1 =>1:A en:c conn:0 eno:1) x) eno:1)

#### eno-into-split — B4: ENO read twice is a split CODESYS stores there
=== text
IMPLEMENTATION LD
NETWORK
  MOVE 860 => AutoSpeed EN go
  split21 := ENO;
  a := split21;
  b := split21;
END_NETWORK
=== model
NETWORK
  (split 21 (MOVE 860 =>1:AutoSpeed en:go conn:0 eno:1))
  (:= a #21)
  (:= b #21)

#### eno-jump — B4: a jump at the end of a chain
=== text
IMPLEMENTATION LD
NETWORK
  MOVE 1 => x EN c
  JMP Done := ENO;
END_NETWORK
=== model
NETWORK
  (jmp Done (MOVE 1 =>1:x en:c conn:0 eno:1))

#### two-items — B4: one `;` is one item: the box on its own, then B read by StartAuto
=== text
IMPLEMENTATION LD
NETWORK
  MOVE 1 => A EN c;
  MOVE 2 => B EN d
  StartAuto := ENO;
END_NETWORK
=== model
NETWORK
  (MOVE 1 =>1:A en:c eno:1)
  (:= StartAuto (MOVE 2 =>1:B en:d conn:0 eno:1))

#### negated-eno — P3: a consumed box carries no modifier; its NOT is written at the ENO token
=== text
IMPLEMENTATION LD
NETWORK
  MOVE 1 => A EN c
  x := NOT ENO;
END_NETWORK
=== model
NETWORK
  (:= x not:(MOVE 1 =>1:A en:c conn:0 eno:1))

#### call-without-en-read-by-eno — P3: a call with an ENO and no EN (Lenze `Dryer`) hands its ENO on
=== scope
instance dryer FB_Dryer
=== text
IMPLEMENTATION LD
NETWORK
  dryer(iOn := on)
  ready := ENO;
END_NETWORK
=== model
NETWORK
  (:= ready (FB_DRYER@dryer iOn=on conn:0 eno:1))

#### eno-into-pin — B4: ENO into another box's input pin (Lenze AHWF N1)
=== text
IMPLEMENTATION LD
NETWORK
  MOVE stop => start EN go
  done R= fc(iEN := ENO, iPos := pos);
END_NETWORK
=== model
NETWORK
  (:= R=done (fc iEN=(MOVE stop =>1:start en:go conn:0 eno:1) iPos=pos conn:0 main:0 eno:0))

#### execute-hands-eno — P8: an EXECUTE box with no `;` hands its ENO to the next line
=== text
IMPLEMENTATION LD
NETWORK
  EXECUTE EN go
i := i + 1;
  END_EXECUTE
  done := ENO;
END_NETWORK
=== model
NETWORK
  (:= done (EXECUTE "i := i + 1;" en:go conn:0))

#### eno-feeds-parallel — B4/B8: ENO feeding a parallel (Lenze TrayFiller): the chain's open lines, then the parallel's feed reads the last
=== text
IMPLEMENTATION LD
NETWORK
  rows MUL height => tInt EN go AND descend
  tInt ADD init => tInt EN ENO
  descend R= ENO BRANCH ((elevator GE tInt EN),
                         down) SHORTCIRCUIT;
END_NETWORK
=== model
NETWORK
  (:= R=descend (par sc (ADD tInt init =>1:tInt en:(MUL rows height =>1:tInt en:(AND go descend) conn:0 eno:1) conn:0 eno:1) (GE elevator tInt en:_ conn:0 main:0 eno:0) down))

#### two-enos-into-one-box — P3 (2R.5: stores and runs): each ENO takes the oldest open line not yet taken, left to right
=== text
IMPLEMENTATION LD
NETWORK
  MOVE 1 => A EN c
  MOVE 2 => B EN d
  x := ENO AND ENO;
END_NETWORK
=== model
NETWORK
  (:= x (AND (MOVE 1 =>1:A en:c conn:0 eno:1) (MOVE 2 =>1:B en:d conn:0 eno:1)))

#### eno-mix-by-level — P3: a mix reads by level — the `;` line's ENOs are the last open lines, the lines those read come before
=== text
IMPLEMENTATION LD
NETWORK
  MOVE 1 => R EN c
  MOVE 2 => P EN d
  MOVE 3 => Q EN ENO
  x := ENO AND ENO;
END_NETWORK
=== model
NETWORK
  (:= x (AND (MOVE 2 =>1:P en:d conn:0 eno:1) (MOVE 3 =>1:Q en:(MOVE 1 =>1:R en:c conn:0 eno:1) conn:0 eno:1)))

#### eno-two-chains — P3: two chains into one box, a level at a time
=== text
IMPLEMENTATION LD
NETWORK
  MOVE 1 => A1 EN c
  MOVE 2 => B1 EN d
  MOVE 3 => A EN ENO
  MOVE 4 => B EN ENO
  x := ENO AND ENO;
END_NETWORK
=== model
NETWORK
  (:= x (AND (MOVE 3 =>1:A en:(MOVE 1 =>1:A1 en:c conn:0 eno:1) conn:0 eno:1) (MOVE 4 =>1:B en:(MOVE 2 =>1:B1 en:d conn:0 eno:1) conn:0 eno:1)))

#### eno-in-a-branch — P3: an ENO inside a parallel's brackets takes its open line like any other, left to right
=== text
IMPLEMENTATION LD
NETWORK
  MOVE 1 => A EN c
  lamp := start BRANCH (ENO,
                        b);
END_NETWORK
=== model
NETWORK
  (:= lamp (par seq start (MOVE 1 =>1:A en:c conn:0 eno:1) b))
