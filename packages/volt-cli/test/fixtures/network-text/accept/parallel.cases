#### branch-fed — `feed BRANCH (a, b, …)`: the branches in stored order; the editor's Sequential mode written as nothing
=== text
IMPLEMENTATION LD
NETWORK
  lamp := start BRANCH (a, b AND (speed LE 40), c);
END_NETWORK
=== model
NETWORK
  (:= lamp (par seq start a (AND b (LE speed 40 conn:0)) c))

#### branch-shortcircuit — the old short-circuit mode says so after the list
=== text
IMPLEMENTATION LD
NETWORK
  lamp := start BRANCH (a, b) SHORTCIRCUIT;
END_NETWORK
=== model
NETWORK
  (:= lamp (par sc start a b))

#### branch-unfed — an unfed parallel is `BRANCH (a, b)`, nothing before BRANCH
=== text
IMPLEMENTATION LD
NETWORK
  lamp := BRANCH (a, b);
END_NETWORK
=== model
NETWORK
  (:= lamp (par seq - a b))

#### branch-nested — a parallel in a branch is a slot's value: no brackets
=== text
IMPLEMENTATION LD
NETWORK
  lamp := start BRANCH (a, c BRANCH (b, go));
END_NETWORK
=== model
NETWORK
  (:= lamp (par seq start a (par seq c b go)))

#### branch-as-operand — a parallel as a word's operand stands in brackets
=== text
IMPLEMENTATION LD
NETWORK
  MOVE speed => t ENO EN (run BRANCH (NOT low, speed LE 40 EN low)) AND NOT cleaning;
END_NETWORK
=== model
NETWORK
  (MOVE speed =>1:t en:(AND (par seq run not:low (LE speed 40 en:low conn:0)) not:cleaning) eno:1)

#### branch-word-feed — a feed that is a box is bracketed
=== text
IMPLEMENTATION LD
NETWORK
  x := (s AND sync) BRANCH (a, b);
END_NETWORK
=== model
NETWORK
  (:= x (par seq (AND s sync) a b))

#### branch-negated-feed — `NOT s BRANCH (a, b)` negates the feed
=== text
IMPLEMENTATION LD
NETWORK
  x := NOT s BRANCH (a, b);
END_NETWORK
=== model
NETWORK
  (:= x (par seq not:s a b))

#### branch-as-en-source — EN's source is a slot: a parallel there takes no brackets
=== text
IMPLEMENTATION LD
NETWORK
  MOVE 1 => x ENO EN go BRANCH (a, b);
END_NETWORK
=== model
NETWORK
  (MOVE 1 =>1:x en:(par seq go a b) eno:1)

#### branch-of-enabled-comparisons — enabled comparisons as branches: slots, no brackets
=== text
IMPLEMENTATION LD
NETWORK
  cam := enable BRANCH (pos LE stop EN pos GE start EN, start GT stop EN) SHORTCIRCUIT;
END_NETWORK
=== model
NETWORK
  (:= cam (par sc enable (LE pos stop en:(GE pos start en:_ conn:0) conn:0) (GT start stop en:_ conn:0)))
=== canonical
IMPLEMENTATION LD
NETWORK
  cam := enable BRANCH (pos LE stop EN
                          pos GE start EN,
                        start GT stop EN) SHORTCIRCUIT;
END_NETWORK

#### branch-per-line — a branch holding a chain: the writer puts one branch per line, aligned
=== text
IMPLEMENTATION LD
NETWORK
  lamp := start BRANCH (a,
                        MOVE 1 => t ENO EN
                          MOVE 2 => u ENO EN c,
                        d);
END_NETWORK
=== model
NETWORK
  (:= lamp (par seq start a (MOVE 1 =>1:t en:(MOVE 2 =>1:u en:c conn:0 eno:1) conn:0 eno:1) d))

#### branch-per-line-read-on-one — the same tree on one line reads alike, and comes back laid out
=== text
IMPLEMENTATION LD
NETWORK
  lamp := start BRANCH (a, MOVE 1 => t ENO EN MOVE 2 => u ENO EN c, d);
END_NETWORK
=== model
NETWORK
  (:= lamp (par seq start a (MOVE 1 =>1:t en:(MOVE 2 =>1:u en:c conn:0 eno:1) conn:0 eno:1) d))
=== canonical
IMPLEMENTATION LD
NETWORK
  lamp := start BRANCH (a,
                        MOVE 1 => t ENO EN
                          MOVE 2 => u ENO EN c,
                        d);
END_NETWORK

#### empty-branch — an empty branch (a shorted branch) is nothing between its commas
=== text
IMPLEMENTATION LD
NETWORK
  x := s BRANCH (a, , b);
  y := s BRANCH (a, );
END_NETWORK
=== model
NETWORK
  (:= x (par seq s a _ b))
  (:= y (par seq s a _))

#### eno-feeds-a-branch — a box read through ENO as a parallel's feed is bracketed (10)
=== text
IMPLEMENTATION LD
NETWORK
  x := (MOVE 1 => t ENO EN c) BRANCH (d, e);
END_NETWORK
=== model
NETWORK
  (:= x (par seq (MOVE 1 =>1:t en:c conn:0 eno:1) d e))
