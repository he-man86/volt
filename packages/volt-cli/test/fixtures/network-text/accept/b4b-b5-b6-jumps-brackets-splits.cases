#### jump-coil — B4b: a jump is a coil the rung drives, `JMP Done := a AND b;`
=== text
IMPLEMENTATION LD
NETWORK
  JMP Done := a AND b;
END_NETWORK
NETWORK LABEL: Done
  x := TRUE;
END_NETWORK
=== model
NETWORK
  (jmp Done (AND a b))
NETWORK label:Done
  (:= x TRUE)

#### jump-rail — B4b/P7: on the rail, `JMP Done;`
=== text
IMPLEMENTATION LD
NETWORK
  JMP Done;
END_NETWORK
NETWORK LABEL: Done
  x := TRUE;
END_NETWORK
=== model
NETWORK
  (jmp Done _)
NETWORK label:Done
  (:= x TRUE)

#### return-coil — B4b: a conditional return, `RETURN := NOT xReady;`
=== text
IMPLEMENTATION LD
NETWORK
  RETURN := NOT xReady;
END_NETWORK
=== model
NETWORK
  (ret not:xReady)

#### return-rail — P7: `RETURN;` is the rail
=== text
IMPLEMENTATION LD
NETWORK
  RETURN;
END_NETWORK
=== model
NETWORK
  (ret _)

#### return-true-is-no-rail — P7: `RETURN := TRUE` (a leaf) is not `RETURN;`
=== text
IMPLEMENTATION LD
NETWORK
  RETURN := TRUE;
END_NETWORK
=== model
NETWORK
  (ret TRUE)

#### value-unbracketed — B5: a slot holds one box — a value without outer brackets
=== text
IMPLEMENTATION LD
NETWORK
  q := g175 AND RunAuto;
END_NETWORK
=== model
NETWORK
  (:= q (AND g175 RunAuto))

#### nested-assign — P4 (3): a nested assignment keeps its brackets: `y := (x := v);` is not two coils
=== text
IMPLEMENTATION LD
NETWORK
  y := (x := a AND b);
END_NETWORK
=== model
NETWORK
  (:= y (:= x (AND a b)))

#### multi-coil — two coils on one value: one item, targets in order
=== text
IMPLEMENTATION LD
NETWORK
  tRun := oRun := Request := go;
END_NETWORK
=== model
NETWORK
  (:= tRun oRun Request go)

#### set-reset-chain — S= and R= are coils
=== text
IMPLEMENTATION LD
NETWORK
  a := b S= c R= value;
END_NETWORK
=== model
NETWORK
  (:= a S=b R=c value)

#### coil-on-rail — P12: a coil with an empty source, `FirstCycle R= ;`
=== text
IMPLEMENTATION LD
NETWORK
  FirstCycle R= ;
END_NETWORK
=== model
NETWORK
  (:= R=FirstCycle _)

#### split-defined-and-read — B6: a split is its VarId, defined once before its references, no VAR_TEMP
=== text
IMPLEMENTATION LD
NETWORK
  split175 := TRUE;
  split176 := split175 AND RunAuto;
  a := split176;
  b := split176 AND c;
END_NETWORK
=== model
NETWORK
  (split 175 TRUE)
  (split 176 (AND #175 RunAuto))
  (:= a #176)
  (:= b (AND #176 c))

#### split-typed-feeder — B6: a split's type is its feeder's — nothing written
=== text
IMPLEMENTATION FBD
NETWORK
  split12 := a ADD b;
  x := split12;
END_NETWORK
=== model
NETWORK
  (split 12 (ADD a b conn:0 main:0 eno:0))
  (:= x #12)

#### split-of-rail — B6: a split fed by the left rail in LD
=== text
IMPLEMENTATION LD
NETWORK
  split174 := TRUE;
  MOVE 0 => tInt EN split174;
END_NETWORK
=== model
NETWORK
  (split 174 TRUE)
  (MOVE 0 =>1:tInt en:#174 eno:1)

#### split-variable-backticked — P1: a variable named like a split is backticked
=== text
IMPLEMENTATION LD
NETWORK
  x := `split5`;
END_NETWORK
=== model
NETWORK
  (:= x split5)

#### split-of-eno — B4: ENO used twice is a split CODESYS stores there; its definition reads the open line
=== text
IMPLEMENTATION LD
NETWORK
  split20 := go;
  MOVE 860 => AutoSpeed EN split20
  split21 := ENO;
  StartAuto := split21;
  Lamp := split21;
END_NETWORK
=== model
NETWORK
  (split 20 go)
  (split 21 (MOVE 860 =>1:AutoSpeed en:#20 conn:0 eno:1))
  (:= StartAuto #21)
  (:= Lamp #21)

#### split-beside-a-declaration-of-its-name — B6, P1: the split pattern is reserved, so a split beside a variable of its name is no collision — the bare word is the split, the backticked one the variable (both IDEs build it clean, rcc_network_wire_named_like_variable)
=== scope
name split1
=== text
IMPLEMENTATION LD
NETWORK
  split1 := a;
  x := split1;
  `split1` := split1;
END_NETWORK
=== model
NETWORK
  (split 1 a)
  (:= x #1)
  (:= split1 #1)
