#### move-enabled — EN after the box's outputs, its source after the word; no ENO written = the box has no ENO pin
=== text
%LANGUAGE LD
NETWORK
  MOVE b => a EN c;
END_NETWORK
=== model
NETWORK
  (MOVE b =>0:a en:c)

#### move-enabled-eno — `ENO` after the outputs: the box has its ENO pin, connected to nothing at the top level
=== text
%LANGUAGE LD
NETWORK
  MOVE 0 => x ENO EN c;
END_NETWORK
=== model
NETWORK
  (MOVE 0 =>1:x en:c eno:1)

#### add-enabled-two-targets — the data outputs fill the slots after ENO, in order
=== text
%LANGUAGE LD
NETWORK
  x ADD 5 => x => y ENO EN c;
END_NETWORK
=== model
NETWORK
  (ADD x 5 =>1:x =>2:y en:c eno:1)

#### empty-enable — `EN` with nothing after it: the enable wired to nothing
=== text
%LANGUAGE LD
NETWORK
  x ADD 1 => x ENO EN;
END_NETWORK
=== model
NETWORK
  (ADD x 1 =>1:x en:_ eno:1)

#### en-source-is-a-slot — EN's source runs to the end of its slot: one box, unbracketed
=== text
%LANGUAGE LD
NETWORK
  MOVE 6 => t ENO EN ready AND btn;
  x ADD f(IN := b) => y ENO EN c;
END_NETWORK
=== model
NETWORK
  (MOVE 6 =>1:t en:(AND ready btn) eno:1)
  (ADD x (f IN=b conn:0) =>1:y en:c eno:1)

#### read-through-eno — a box that shows ENO is read through it (X10): `lamp := MOVE 1 => t ENO EN c;`
=== text
%LANGUAGE LD
NETWORK
  lamp := MOVE 1 => t ENO EN c;
END_NETWORK
=== model
NETWORK
  (:= lamp (MOVE 1 =>1:t en:c conn:0 eno:1))

#### enabled-value — EN without ENO: a consumer reads the box's value (measurement 5, 6)
=== text
%LANGUAGE LD
NETWORK
  y := MOVE k EN c;
  sum := a ADD b EN c;
  lamp := a GT 5 EN c;
  res := f(IN := v) EN c;
END_NETWORK
=== model
NETWORK
  (:= y (MOVE k en:c conn:0))
  (:= sum (ADD a b en:c conn:0))
  (:= lamp (GT a 5 en:c conn:0))
  (:= res (f IN=v en:c conn:0))

#### enabled-value-as-operand — an enabled box as another word's operand is bracketed
=== text
%LANGUAGE LD
NETWORK
  x := a AND (b GT 40 EN c);
  y := (MOVE 1 => t ENO EN c) AND (MOVE 2 => u ENO EN d);
END_NETWORK
=== model
NETWORK
  (:= x (AND a (GT b 40 en:c conn:0)))
  (:= y (AND (MOVE 1 =>1:t en:c conn:0 eno:1) (MOVE 2 =>1:u en:d conn:0 eno:1)))

#### enabled-call-in-pin — a pin is a slot: an enabled box there takes no brackets
=== text
%LANGUAGE LD
NETWORK
  done R= fc(iEN := MOVE stop => start ENO EN go, iPos := pos);
END_NETWORK
=== model
NETWORK
  (:= R=done (fc iEN=(MOVE stop =>1:start en:go conn:0 eno:1) iPos=pos conn:0))

#### chain — a box in the EN slot of another runs first; the writer lays the chain out as a staircase
=== text
%LANGUAGE LD
NETWORK
  lamp := MOVE 3 => c ENO EN
            MOVE 2 => b ENO EN
              MOVE 1 => a ENO EN start;
END_NETWORK
=== model
NETWORK
  (:= lamp (MOVE 3 =>1:c en:(MOVE 2 =>1:b en:(MOVE 1 =>1:a en:start conn:0 eno:1) conn:0 eno:1) conn:0 eno:1))

#### chain-top-level — a chain nothing reads: its last box shows its ENO pin, connected to nothing
=== text
%LANGUAGE LD
NETWORK
  MOVE 2 => b ENO EN
    MOVE 1 => a ENO EN start;
END_NETWORK
=== model
NETWORK
  (MOVE 2 =>1:b en:(MOVE 1 =>1:a en:start conn:0 eno:1) eno:1)

#### chain-one-line — layout is the writer's: the chain on one line reads to the same tree
=== text
%LANGUAGE LD
NETWORK
  lamp := MOVE 3 => c ENO EN MOVE 2 => b ENO EN MOVE 1 => a ENO EN start;
END_NETWORK
=== model
NETWORK
  (:= lamp (MOVE 3 =>1:c en:(MOVE 2 =>1:b en:(MOVE 1 =>1:a en:start conn:0 eno:1) conn:0 eno:1) conn:0 eno:1))
=== canonical
%LANGUAGE LD
NETWORK
  lamp := MOVE 3 => c ENO EN
            MOVE 2 => b ENO EN
              MOVE 1 => a ENO EN start;
END_NETWORK

#### chain-odd-indentation — any indentation deeper than the item's first line reads to the same tree
=== text
%LANGUAGE LD
NETWORK
  lamp := MOVE 3 => c ENO EN
     MOVE 2 => b ENO EN
                         MOVE 1 => a ENO EN start;
END_NETWORK
=== model
NETWORK
  (:= lamp (MOVE 3 =>1:c en:(MOVE 2 =>1:b en:(MOVE 1 =>1:a en:start conn:0 eno:1) conn:0 eno:1) conn:0 eno:1))
=== canonical
%LANGUAGE LD
NETWORK
  lamp := MOVE 3 => c ENO EN
            MOVE 2 => b ENO EN
              MOVE 1 => a ENO EN start;
END_NETWORK

#### chain-in-brackets — the staircase inside a bracket
=== text
%LANGUAGE LD
NETWORK
  x := a AND (MOVE 1 => t ENO EN
                MOVE 2 => u ENO EN c);
END_NETWORK
=== model
NETWORK
  (:= x (AND a (MOVE 1 =>1:t en:(MOVE 2 =>1:u en:c conn:0 eno:1) conn:0 eno:1)))

#### en-slot-and-input-box — a box in the EN slot and one in an input: both run before their consumer, the EN slot first (1d)
=== text
%LANGUAGE LD
NETWORK
  MOVE (MOVE 2 => t ENO EN d) => x ENO EN
    MOVE 1 => s ENO EN c;
END_NETWORK
=== model
NETWORK
  (MOVE (MOVE 2 =>1:t en:d conn:0 eno:1) =>1:x en:(MOVE 1 =>1:s en:c conn:0 eno:1) eno:1)

#### split-in-en-slot — a split defined in the EN slot and read by an input, the stored slots (measurement 2)
=== text
%LANGUAGE LD
NETWORK
  y := MOVE split1 => t ENO EN (split1 := a AND b);
END_NETWORK
=== model
NETWORK
  (:= y (MOVE #1 =>1:t en:(split 1 (AND a b)) conn:0 eno:1))

#### eno-into-split — a box read through ENO twice: CODESYS stores a split there
=== text
%LANGUAGE LD
NETWORK
  split21 := MOVE 860 => speed ENO EN go;
  a := split21;
  b := split21;
END_NETWORK
=== model
NETWORK
  (split 21 (MOVE 860 =>1:speed en:go conn:0 eno:1))
  (:= a #21)
  (:= b #21)

#### eno-jump — a jump fed through a box's ENO
=== text
%LANGUAGE LD
NETWORK
  JMP Done := MOVE 1 => x ENO EN c;
END_NETWORK
NETWORK LABEL: Done
  ;
END_NETWORK
=== model
NETWORK
  (jmp Done (MOVE 1 =>1:x en:c conn:0 eno:1))
NETWORK label:Done
  _

#### eno-modifier — a modifier on a box read through ENO is the box's flag (measurement 8)
=== text
%LANGUAGE LD
NETWORK
  lamp := NOT (MOVE 1 => t ENO EN c);
  edge := R_EDGE (MOVE 2 => u ENO EN c);
END_NETWORK
=== model
NETWORK
  (:= lamp not:(MOVE 1 =>1:t en:c conn:0 eno:1))
  (:= edge rise:(MOVE 2 =>1:u en:c conn:0 eno:1))

#### eno-wired-top-level — `ENO => v`: the ENO pin wired to a variable, at the top level (7a: it stores and builds; the LSP warns it never writes v)
=== text
%LANGUAGE LD
NETWORK
  MOVE 7 => x ENO => lamp EN c;
END_NETWORK
=== model
NETWORK
  (MOVE 7 =>ENO:lamp =>1:x en:c eno:1)

#### negated-en-pin — `NOT EN c` negates the EN pin; `EN NOT c` the contact feeding it
=== text
%LANGUAGE LD
NETWORK
  MOVE 5 => y ENO NOT EN c;
  MOVE 5 => z ENO EN NOT c;
END_NETWORK
=== model
NETWORK
  (MOVE 5 =>1:y !en:c eno:1)
  (MOVE 5 =>1:z en:not:c eno:1)

#### fb-call-read-by-name — every FB read by a data output names it, `.Q`
=== scope
instance t1 TON
=== text
%LANGUAGE LD
NETWORK
  x := t1 : TON(IN := a, PT := T#1S).Q;
END_NETWORK
=== model
NETWORK
  (:= x (TON@t1 IN=a PT=T#1S name:Q))

#### fb-call-read-through-declared-eno — an FB that declares ENO, read with nothing after its call: its declared ENO (4a)
=== scope
instance d1 Dryer
=== text
%LANGUAGE LD
NETWORK
  ready := d1 : Dryer(iOn := on);
END_NETWORK
=== model
NETWORK
  (:= ready (Dryer@d1 iOn=on conn:0 eno:1))

#### fb-call-enabled — an FB call with EN and ENO; read through ENO, as an AND operand and as a BRANCH feed (10)
=== scope
instance c1 CTU
instance c2 CTU
=== text
%LANGUAGE LD
NETWORK
  c1 : CTU(CU := a, PV := 10, CV => n) ENO EN go;
  lamp := (c2 : CTU(CU := a, PV := 10, CV => n) ENO EN c) AND d;
END_NETWORK
=== model
NETWORK
  (CTU@c1 CU=a PV=10 =>CV:n en:go eno:1)
  (:= lamp (AND (CTU@c2 CU=a PV=10 =>CV:n en:c conn:0 eno:1) d))

#### fb-call-enabled-read-by-name — an FB with EN and no ENO, read by its output
=== scope
instance t1 TON
=== text
%LANGUAGE LD
NETWORK
  x := t1 : TON(IN := a, PT := T#1S).Q EN c;
END_NETWORK
=== model
NETWORK
  (:= x (TON@t1 IN=a PT=T#1S en:c name:Q))

#### call-enabled — a call keeps its output pins inside its brackets, ENO and EN after them
=== text
%LANGUAGE LD
NETWORK
  LIMIT(MN := 0, IN := v, MX := 100, => y) ENO EN c;
END_NETWORK
=== model
NETWORK
  (LIMIT MN=0 IN=v MX=100 =>1:y en:c eno:1)

#### function-eno-without-en — a function's box shows its ENO without EN, and is read through it (recorded: it builds on both vendors)
=== text
%LANGUAGE LD
NETWORK
  x := f(IN := a) ENO;
  f(IN := b) ENO;
END_NETWORK
=== model
NETWORK
  (:= x (f IN=a conn:0 eno:1))
  (f IN=b eno:1)

#### call-read-through-eno — a call read through its ENO with no output wired (a PROGRAM call's box has none)
=== text
%LANGUAGE LD
NETWORK
  lamp := (Drive() ENO EN TRUE) AND running;
END_NETWORK
=== model
NETWORK
  (:= lamp (AND (Drive en:TRUE conn:0 eno:1) running))
