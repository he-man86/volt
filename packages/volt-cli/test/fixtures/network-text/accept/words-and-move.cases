#### add-coil — an ADD box is its word, between its inputs; a consumer reads its value
=== text
%LANGUAGE FBD
NETWORK
  x := a ADD b;
END_NETWORK
=== model
NETWORK
  (:= x (ADD a b conn:0))

#### every-word — the fourteen words, each one box; a bit operator stores no connection slot
=== text
%LANGUAGE FBD
NETWORK
  b1 := a AND b;
  b2 := a OR b;
  b3 := a XOR b;
  i1 := i ADD j;
  i2 := i SUB j;
  i3 := i MUL j;
  i4 := i DIV j;
  i5 := i MOD j;
  c1 := i GT j;
  c2 := i GE j;
  c3 := i EQ j;
  c4 := i NE j;
  c5 := i LE j;
  c6 := i LT j;
END_NETWORK
=== model
NETWORK
  (:= b1 (AND a b))
  (:= b2 (OR a b))
  (:= b3 (XOR a b))
  (:= i1 (ADD i j conn:0))
  (:= i2 (SUB i j conn:0))
  (:= i3 (MUL i j conn:0))
  (:= i4 (DIV i j conn:0))
  (:= i5 (MOD i j conn:0))
  (:= c1 (GT i j conn:0))
  (:= c2 (GE i j conn:0))
  (:= c3 (EQ i j conn:0))
  (:= c4 (NE i j conn:0))
  (:= c5 (LE i j conn:0))
  (:= c6 (LT i j conn:0))

#### one-word-three-inputs — one word is one box: `a ADD b ADD c` is one ADD with three inputs
=== text
%LANGUAGE FBD
NETWORK
  x := a ADD b ADD c;
END_NETWORK
=== model
NETWORK
  (:= x (ADD a b c conn:0))

#### brackets-separate-boxes — a box that is another word's operand is bracketed
=== text
%LANGUAGE FBD
NETWORK
  x := a ADD (b ADD c);
  y := (a ADD b) MUL c;
  lamp := start AND (a OR b) AND NOT stop;
END_NETWORK
=== model
NETWORK
  (:= x (ADD a (ADD b c conn:0) conn:0))
  (:= y (MUL (ADD a b conn:0) c conn:0))
  (:= lamp (AND start (OR a b) not:stop))

#### and-nine-inputs — AND and OR take as many inputs as drawn
=== text
%LANGUAGE LD
NETWORK
  q := a AND b AND c AND d AND e AND f AND g AND h AND i;
END_NETWORK
=== model
NETWORK
  (:= q (AND a b c d e f g h i))

#### top-level-word-with-output — a box nothing consumes writes its value to an output pin, `a ADD b => x;`
=== text
%LANGUAGE FBD
NETWORK
  a ADD b => x;
END_NETWORK
=== model
NETWORK
  (ADD a b =>0:x)

#### lowercase-word — the word as the box type stores it: `a and b` is a box of type `and`
=== text
%LANGUAGE FBD
NETWORK
  x := a and b;
END_NETWORK
=== model
NETWORK
  (:= x (and a b))

#### empty-operand — an unconnected input is written as nothing between its words, `MUL m MUL 6`
=== text
%LANGUAGE FBD
NETWORK
  x := MUL m MUL 6;
  y := a ADD ADD c;
END_NETWORK
=== model
NETWORK
  (:= x (MUL _ m 6 conn:0))
  (:= y (ADD a _ c conn:0))

#### negated-box — a modifier on a box: the box stands in brackets after it
=== text
%LANGUAGE LD
NETWORK
  x := NOT (a AND b);
  y := R_EDGE (a AND b);
END_NETWORK
=== model
NETWORK
  (:= x not:(AND a b))
  (:= y rise:(AND a b))

#### word-operand-call — a call is an operand of a word without brackets
=== text
%LANGUAGE FBD
NETWORK
  x := a ADD f(IN := b);
END_NETWORK
=== model
NETWORK
  (:= x (ADD a (f IN=b conn:0) conn:0))

#### word-in-pin — a pin is a slot: a box word there takes no brackets
=== scope
instance t1 TON
=== text
%LANGUAGE LD
NETWORK
  q := t1 : TON(IN := a AND b, PT := T#1S).Q;
END_NETWORK
=== model
NETWORK
  (:= q (TON@t1 IN=(AND a b) PT=T#1S name:Q))

#### move-to — MOVE writes its target as an output pin, `MOVE b => a`
=== text
%LANGUAGE FBD
NETWORK
  MOVE b => a;
END_NETWORK
=== model
NETWORK
  (MOVE b =>0:a)

#### move-then-coil — `a := MOVE b;` is a MOVE box, then a coil
=== text
%LANGUAGE FBD
NETWORK
  a := MOVE b;
END_NETWORK
=== model
NETWORK
  (:= a (MOVE b conn:0))

#### coil-no-box — `a := b;` is a coil fed by a leaf
=== text
%LANGUAGE FBD
NETWORK
  a := b;
END_NETWORK
=== model
NETWORK
  (:= a b)

#### move-two-targets — MOVE writes to as many targets as drawn, in slot order
=== text
%LANGUAGE LD
NETWORK
  MOVE 0 => a => b;
END_NETWORK
=== model
NETWORK
  (MOVE 0 =>0:a =>1:b)

#### move-empty-operand — MOVE with its input unconnected, `MOVE => x`
=== text
%LANGUAGE FBD
NETWORK
  MOVE => x;
END_NETWORK
=== model
NETWORK
  (MOVE _ =>0:x)

#### move-operand-bracketed — a box as MOVE's operand stands in brackets
=== text
%LANGUAGE FBD
NETWORK
  MOVE (a ADD b) => x;
END_NETWORK
=== model
NETWORK
  (MOVE (ADD a b conn:0) =>0:x)

#### not-box — the NOT box is its backticked word with its pin, `` `NOT`(a) ``
=== text
%LANGUAGE FBD
NETWORK
  x := `NOT`(a);
END_NETWORK
=== model
NETWORK
  (:= x (NOT a))

#### not-box-empty — the NOT box with its one input unconnected names the pin
=== text
%LANGUAGE FBD
NETWORK
  x := `NOT`(IN := );
END_NETWORK
=== model
NETWORK
  (:= x (NOT _))

#### negated-pin-call-form — a word box with a flagged pin is its backticked call, its pins named
=== text
%LANGUAGE FBD
NETWORK
  x := `AND`(IN1 := a, IN2 := b, NOT IN3 := c);
END_NETWORK
=== model
NETWORK
  (:= x (AND a b !c))

#### rising-pin-call-form — an edge on an operator's pin, before the pin's name
=== text
%LANGUAGE LD
NETWORK
  x := `AND`(R_EDGE IN1 := c, IN2 := one);
END_NETWORK
=== model
NETWORK
  (:= x (AND /c one))

#### edge-and-negation-on-a-pin — `R_EDGE NOT IN := v`: the IDE negates, then detects the edge (N17)
=== scope
instance t1 TON
=== text
%LANGUAGE LD
NETWORK
  t1 : TON(R_EDGE NOT IN := v, PT := T#1S);
END_NETWORK
=== model
NETWORK
  (TON@t1 /!IN=v PT=T#1S)
