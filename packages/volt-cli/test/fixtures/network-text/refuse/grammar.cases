#### mixed-words — one word is one box: two words at one level are refused
=== text
IMPLEMENTATION FBD
NETWORK
  x := a ADD b MUL c;
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION one word is one box

#### word-call-form-where-word-fits — an operator's backticked call where its word holds the box
=== text
IMPLEMENTATION FBD
NETWORK
  x := `ADD`(a, b);
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION in its call form where its word holds it

#### move-call-form-where-word-fits — `` `MOVE`(b, => a) `` where `MOVE b => a` holds the box
=== text
IMPLEMENTATION FBD
NETWORK
  `MOVE`(b, => a);
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION in its call form where its word holds it

#### word-unbacticked-call — a word is no call head: an operator's call form is backticked
=== text
IMPLEMENTATION FBD
NETWORK
  x := ADD(a);
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION a redundant bracket

#### move-inside-word — MOVE as another word's operand stands in brackets
=== text
IMPLEMENTATION FBD
NETWORK
  x := a AND MOVE b;
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION as an operand

#### move-two-operands — MOVE takes one operand
=== text
IMPLEMENTATION FBD
NETWORK
  MOVE a ADD b => x;
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION MOVE takes one operand

#### redundant-coil-bracket — a coil's value is a slot: a box there stands bare
=== text
IMPLEMENTATION LD
NETWORK
  x := (a AND b);
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION a redundant bracket

#### redundant-item-bracket — an item's own assignment is not bracketed
=== text
IMPLEMENTATION LD
NETWORK
  (x := a);
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION a redundant bracket

#### redundant-leaf-bracket — a bracket around a leaf is redundant
=== text
IMPLEMENTATION LD
NETWORK
  x := a AND (b);
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION a redundant bracket

#### redundant-call-bracket — a call carries its own brackets
=== text
IMPLEMENTATION LD
NETWORK
  x := a AND (f(IN := b));
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION a call carries its own brackets

#### redundant-double-bracket — one pair separates one box
=== text
IMPLEMENTATION LD
NETWORK
  x := a AND ((b OR c));
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION a redundant bracket

#### redundant-pin-bracket — a pin is a slot: a box there takes no brackets
=== text
IMPLEMENTATION LD
NETWORK
  q := f(IN := (a AND b));
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION a redundant bracket

#### redundant-en-bracket — EN's source is a slot
=== text
IMPLEMENTATION LD
NETWORK
  MOVE 1 => x ENO EN (a AND b);
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION a redundant bracket

#### redundant-modifier-bracket — after a modifier a leaf or a call stands bare
=== text
IMPLEMENTATION LD
NETWORK
  x := NOT (a);
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION a redundant bracket

#### word-operand-unbracketed-enabled — an enabled box as a word's operand is bracketed: EN after a word belongs to the word's box
=== text
IMPLEMENTATION LD
NETWORK
  x := a AND MOVE 1 => t ENO EN c;
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION as an operand

#### feed-word-unbracketed — a feed that is a box is bracketed before BRANCH
=== text
IMPLEMENTATION LD
NETWORK
  x := s AND sync BRANCH (a, b);
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION a feed that is a box word is bracketed

#### parallel-operand-unbracketed — a parallel as a word's operand is bracketed
=== text
IMPLEMENTATION LD
NETWORK
  x := a AND s BRANCH (b, c);
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION a feed that is a box word is bracketed

#### branch-without-list — BRANCH takes a bracketed list
=== text
IMPLEMENTATION LD
NETWORK
  x := s BRANCH a;
END_NETWORK
=== refused
NETWORK_PARSE bracketed list

#### no-branch — `BRANCH ()` holds none
=== text
IMPLEMENTATION LD
NETWORK
  x := s BRANCH ();
END_NETWORK
=== refused
NETWORK_UNSUPPORTED a parallel with no branch

#### parallel-enabled — a parallel is no box, and has no EN
=== text
IMPLEMENTATION LD
NETWORK
  x := s BRANCH (a, b) EN c;
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION a parallel is no box

#### shortcircuit-on-no-parallel — SHORTCIRCUIT follows a parallel's list
=== text
IMPLEMENTATION LD
NETWORK
  x := a SHORTCIRCUIT;
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION SHORTCIRCUIT after something no parallel

#### en-on-leaf — EN follows a box
=== text
IMPLEMENTATION LD
NETWORK
  x := a EN c;
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION where no box takes it

#### en-inside-call — a call's EN follows its brackets
=== text
IMPLEMENTATION LD
NETWORK
  x := f(IN := a EN c);
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION inside a call's brackets

#### en-pin-in-call — `EN :=` in a call is not the enable
=== text
IMPLEMENTATION LD
NETWORK
  f(EN := c, IN := a);
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION `EN :=` in a call

#### eno-pin-in-call — ENO follows the call
=== text
IMPLEMENTATION LD
NETWORK
  f(IN := a, ENO => x) EN c;
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION `ENO =>` in a call

#### eno-after-en — ENO stands before EN
=== text
IMPLEMENTATION LD
NETWORK
  MOVE 1 => x EN c ENO;
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION ENO after EN

#### arrow-after-en — the outputs come before EN
=== text
IMPLEMENTATION LD
NETWORK
  MOVE b EN c => a;
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION after EN

#### arrow-without-target — a word's `=>` takes a target
=== text
IMPLEMENTATION FBD
NETWORK
  a ADD b =>;
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION with no target

#### modified-call-with-pin-state — a box with EN after a modifier is bracketed
=== text
IMPLEMENTATION LD
NETWORK
  x := NOT f(IN := a) EN c;
END_NETWORK
=== refused
NETWORK_BAD_EXPRESSION a pin state after a modified call

#### modifier-twice — one negation, one edge, the edge first
=== text
