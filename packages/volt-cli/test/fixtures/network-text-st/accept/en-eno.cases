#### move-enabled
=== text
%LANGUAGE LD
%NETWORK
MOVE(EN := c, b, OUT => a);
=== model
NETWORK
  (MOVE b =>0:a en:c)

#### move-enabled-eno
=== text
%LANGUAGE LD
%NETWORK
MOVE(EN := c, 0, OUT => x).ENO;
=== model
NETWORK
  (MOVE 0 =>1:x en:c eno:1)

#### add-enabled-two-targets — the data outputs fill the slots after ENO, in order
=== text
%LANGUAGE LD
%NETWORK
ADD(EN := c, x, 5, OUT => x, OUT => y).ENO;
=== model
NETWORK
  (ADD x 5 =>1:x =>2:y en:c eno:1)

#### empty-enable
=== text
%LANGUAGE LD
%NETWORK
ADD(EN := TRUE, x, 1, OUT => x).ENO;
=== model
NETWORK
  (ADD x 1 =>1:x en:TRUE eno:1)

#### en-source-is-a-slot
=== text
%LANGUAGE LD
%NETWORK
MOVE(EN := ready AND btn, 6, OUT => t).ENO;
ADD(EN := c, x, f(IN := b), OUT => y).ENO;
=== model
NETWORK
  (MOVE 6 =>1:t en:(AND ready btn) eno:1)
  (ADD x (f IN=b conn:0) =>1:y en:c eno:1)

#### read-through-eno
=== text
%LANGUAGE LD
%NETWORK
lamp := MOVE(EN := c, 1, OUT => t).ENO;
=== model
NETWORK
  (:= lamp (MOVE 1 =>1:t en:c conn:0 eno:1))

#### enabled-value — EN without ENO: a consumer reads the box's value (measurement 5, 6)
=== scope
function f IN =>
=== text
%LANGUAGE LD
%NETWORK
y := MOVE(EN := c, k);
sum := ADD(EN := c, a, b);
lamp := GT(EN := c, a, 5);
res := f(EN := c, IN := v);
=== model
NETWORK
  (:= y (MOVE k en:c conn:0))
  (:= sum (ADD a b en:c conn:0))
  (:= lamp (GT a 5 en:c conn:0))
  (:= res (f IN=v en:c conn:0))

#### enabled-value-as-operand
=== text
%LANGUAGE LD
%NETWORK
x := a AND GT(EN := c, b, 40);
y := MOVE(EN := c, 1, OUT => t).ENO AND MOVE(EN := d, 2, OUT => u).ENO;
=== model
NETWORK
  (:= x (AND a (GT b 40 en:c conn:0)))
  (:= y (AND (MOVE 1 =>1:t en:c conn:0 eno:1) (MOVE 2 =>1:u en:d conn:0 eno:1)))

#### enabled-call-in-pin
=== text
%LANGUAGE LD
%NETWORK
done R= fc(iEN := MOVE(EN := go, stop, OUT => start).ENO, iPos := pos);
=== model
NETWORK
  (:= R=done (fc iEN=(MOVE stop =>1:start en:go conn:0 eno:1) iPos=pos conn:0))

#### chain
=== text
%LANGUAGE LD
%NETWORK
lamp := MOVE(EN := MOVE(EN := MOVE(EN := start, 1, OUT => a).ENO, 2, OUT => b).ENO, 3, OUT => c).ENO;
=== model
NETWORK
  (:= lamp (MOVE 3 =>1:c en:(MOVE 2 =>1:b en:(MOVE 1 =>1:a en:start conn:0 eno:1) conn:0 eno:1) conn:0 eno:1))

#### chain-top-level — a chain nothing reads: its last box shows its ENO pin, connected to nothing
=== text
%LANGUAGE LD
%NETWORK
MOVE(EN := MOVE(EN := start, 1, OUT => a).ENO, 2, OUT => b).ENO;
=== model
NETWORK
  (MOVE 2 =>1:b en:(MOVE 1 =>1:a en:start conn:0 eno:1) eno:1)

#### chain-one-line — layout is the writer's: the chain on one line reads to the same tree
=== text
%LANGUAGE LD
%NETWORK
lamp := MOVE(EN := MOVE(EN := MOVE(EN := start, 1, OUT => a).ENO, 2, OUT => b).ENO, 3, OUT => c).ENO;
=== model
NETWORK
  (:= lamp (MOVE 3 =>1:c en:(MOVE 2 =>1:b en:(MOVE 1 =>1:a en:start conn:0 eno:1) conn:0 eno:1) conn:0 eno:1))

#### chain-odd-indentation — any indentation deeper than the item's first line reads to the same tree
=== text
%LANGUAGE LD
%NETWORK
lamp := MOVE(EN := MOVE(EN := MOVE(EN := start, 1, OUT => a).ENO, 2, OUT => b).ENO, 3, OUT => c).ENO;
=== model
NETWORK
  (:= lamp (MOVE 3 =>1:c en:(MOVE 2 =>1:b en:(MOVE 1 =>1:a en:start conn:0 eno:1) conn:0 eno:1) conn:0 eno:1))

#### chain-in-brackets
=== text
%LANGUAGE LD
%NETWORK
x := a AND MOVE(EN := MOVE(EN := c, 2, OUT => u).ENO, 1, OUT => t).ENO;
=== model
NETWORK
  (:= x (AND a (MOVE 1 =>1:t en:(MOVE 2 =>1:u en:c conn:0 eno:1) conn:0 eno:1)))

#### en-slot-and-input-box
=== text
%LANGUAGE LD
%NETWORK
MOVE(EN := MOVE(EN := c, 1, OUT => u).ENO, MOVE(EN := d, 2, OUT => t).ENO, OUT => x).ENO;
=== model
NETWORK
  (MOVE (MOVE 2 =>1:t en:d conn:0 eno:1) =>1:x en:(MOVE 1 =>1:u en:c conn:0 eno:1) eno:1)

#### split-in-en-slot
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
y := MOVE(EN := (w1 := a AND b), w1, OUT => t).ENO;
=== model
NETWORK
  (:= y (MOVE #1 =>1:t en:(split 1 (AND a b)) conn:0 eno:1))

#### eno-into-split
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
w1 := MOVE(EN := go, 860, OUT => speed).ENO;
a := w1;
b := w1;
=== model
NETWORK
  (split 1 (MOVE 860 =>1:speed en:go conn:0 eno:1))
  (:= a #1)
  (:= b #1)

#### eno-jump — a jump fed through a box's ENO
=== text
%LANGUAGE LD
%NETWORK
JMP.Done := MOVE(EN := c, 1, OUT => x).ENO;
%NETWORK
Done:
;
=== model
NETWORK
  (jmp Done (MOVE 1 =>1:x en:c conn:0 eno:1))
NETWORK label:Done
  ``

#### eno-modifier — a modifier on a box read through ENO is the box's flag (measurement 8)
=== text
%LANGUAGE LD
%NETWORK
lamp := NOT(MOVE(EN := c, 1, OUT => t).ENO);
edge := RISING(MOVE(EN := c, 2, OUT => u).ENO);
=== model
NETWORK
  (:= lamp (NOT (MOVE 1 =>1:t en:c conn:0 eno:1)))
  (:= edge rise:(MOVE 2 =>1:u en:c conn:0 eno:1))

#### eno-wired-top-level
=== text
%LANGUAGE LD
%NETWORK
MOVE(EN := c, 7, ENO => lamp, OUT => x).ENO;
=== model
NETWORK
  (MOVE 7 =>ENO:lamp =>1:x en:c eno:1)

#### negated-en-pin
=== text
%LANGUAGE LD
%NETWORK
MOVE(EN := NOT c, 5, OUT => y).ENO;
MOVE(EN := NOT c, 5, OUT => z).ENO;
=== model
NETWORK
  (MOVE 5 =>1:y en:not:c eno:1)
  (MOVE 5 =>1:z en:not:c eno:1)

#### fb-call-read-by-name — an FB with two outputs: its call is closed by the one its consumer reads
=== scope
instance t1 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE LD
%NETWORK
x := t1(IN := a, PT := T#1S).Q;
=== model
NETWORK
  (:= x (TON@t1 IN=a PT=T#1S name:Q))

#### fb-call-read-through-declared-eno — an FB that declares ENO: .ENO is that output, read by name; no ENO shown (1c)
=== scope
instance d1 Dryer
fb Dryer iOn => ENO xReady
=== text
%LANGUAGE LD
%NETWORK
ready := d1(iOn := on).ENO;
=== model
NETWORK
  (:= ready (Dryer@d1 iOn=on name:ENO))

#### fb-call-enabled
=== scope
instance c1 CTU
instance c2 CTU
fb CTU CU RESET PV => Q CV
=== text
%LANGUAGE LD
%NETWORK
c1(EN := go, CU := a, PV := 10, CV => n).ENO;
lamp := c2(EN := c, CU := a, PV := 10, CV => n).ENO AND d;
=== model
NETWORK
  (CTU@c1 CU=a PV=10 =>CV:n en:go eno:1)
  (:= lamp (AND (CTU@c2 CU=a PV=10 =>CV:n en:c conn:0 eno:1) d))

#### fb-call-enabled-read-by-name
=== scope
instance t1 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE LD
%NETWORK
x := t1(EN := c, IN := a, PT := T#1S).Q;
=== model
NETWORK
  (:= x (TON@t1 IN=a PT=T#1S en:c name:Q))

#### call-enabled
=== text
%LANGUAGE LD
%NETWORK
LIMIT(EN := c, MN := 0, IN := v, MX := 100, OUT => y).ENO;
=== model
NETWORK
  (LIMIT MN=0 IN=v MX=100 =>1:y en:c eno:1)

#### function-eno-without-en — a function's box shows its ENO without EN, and is read through it (recorded: it builds on both vendors)
=== scope
function f IN =>
=== text
%LANGUAGE LD
%NETWORK
x := f(IN := a).ENO;
f(IN := b).ENO;
=== model
NETWORK
  (:= x (f IN=a conn:0 eno:1))
  (f IN=b eno:1)

#### call-read-through-eno — a call read through its ENO with no output wired (a PROGRAM call's box has none)
=== scope
program Drive =>
=== text
%LANGUAGE LD
%NETWORK
lamp := Drive(EN := TRUE).ENO AND running;
=== model
NETWORK
  (:= lamp (AND (Drive en:TRUE conn:0 eno:1) running))
