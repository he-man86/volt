#### move-enabled
=== text
%LANGUAGE LD
%NETWORK
MOVE(EN := c, b, OUT => a);
=== model
NETWORK
  (MOVE b =>1:a en:c eno:1)

#### move-enabled-eno
=== text
%LANGUAGE LD
%NETWORK
MOVE(EN := c, 0, OUT => x);
=== model
NETWORK
  (MOVE 0 =>1:x en:c eno:1)

#### empty-enable
=== text
%LANGUAGE LD
%NETWORK
ADD(EN := TRUE, x, 1, OUT => x);
=== model
NETWORK
  (ADD x 1 =>1:x en:TRUE eno:1)

#### en-source-is-a-slot
=== text
%LANGUAGE LD
%NETWORK
MOVE(EN := ready AND btn, 6, OUT => t);
ADD(EN := c, x, f(IN := b), OUT => y);
=== model
NETWORK
  (MOVE 6 =>1:t en:(AND ready btn) eno:1)
  (ADD x (f IN=b conn:0) =>1:y en:c eno:1)

#### read-through-eno
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(MOVE(EN := c, 1, OUT => t), Q => lamp);
=== model
NETWORK
  (:= lamp (MOVE 1 =>1:t en:c conn:0 eno:1))

#### enabled-value — EN without ENO: a consumer reads the box's value (measurement 5, 6)
=== scope
function f IN =>
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(MOVE(EN := c, k).OUT, Q => y);
ASSIGN(ADD(EN := c, a, b).OUT, Q => sum);
ASSIGN(GT(EN := c, a, 5).OUT, Q => lamp);
ASSIGN(f(EN := c, IN := v), Q => res);
=== model
NETWORK
  (:= y (MOVE k en:c conn:0))
  (:= sum (ADD a b en:c conn:0))
  (:= lamp (GT a 5 en:c conn:0))
  (:= res (f IN=v en:c conn:0 eno:1))

#### enabled-value-as-operand
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(a AND GT(EN := c, b, 40).OUT, Q => x);
ASSIGN(MOVE(EN := c, 1, OUT => t) AND MOVE(EN := d, 2, OUT => u), Q => y);
=== model
NETWORK
  (:= x (AND a (GT b 40 en:c conn:0)))
  (:= y (AND (MOVE 1 =>1:t en:c conn:0 eno:1) (MOVE 2 =>1:u en:d conn:0 eno:1)))

#### enabled-call-in-pin
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(fc(iEN := MOVE(EN := go, stop, OUT => start), iPos := pos), Q_RESET => done);
=== model
NETWORK
  (:= R=done (fc iEN=(MOVE stop =>1:start en:go conn:0 eno:1) iPos=pos conn:0))

#### chain
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(MOVE(EN := MOVE(EN := MOVE(EN := start, 1, OUT => a), 2, OUT => b), 3, OUT => c), Q => lamp);
=== model
NETWORK
  (:= lamp (MOVE 3 =>1:c en:(MOVE 2 =>1:b en:(MOVE 1 =>1:a en:start conn:0 eno:1) conn:0 eno:1) conn:0 eno:1))

#### chain-top-level — a chain nothing reads: its last box shows its ENO pin, connected to nothing
=== text
%LANGUAGE LD
%NETWORK
MOVE(EN := MOVE(EN := start, 1, OUT => a), 2, OUT => b);
=== model
NETWORK
  (MOVE 2 =>1:b en:(MOVE 1 =>1:a en:start conn:0 eno:1) eno:1)

#### chain-one-line — layout is the writer's: the chain on one line reads to the same tree
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(MOVE(EN := MOVE(EN := MOVE(EN := start, 1, OUT => a), 2, OUT => b), 3, OUT => c), Q => lamp);
=== model
NETWORK
  (:= lamp (MOVE 3 =>1:c en:(MOVE 2 =>1:b en:(MOVE 1 =>1:a en:start conn:0 eno:1) conn:0 eno:1) conn:0 eno:1))

#### chain-odd-indentation — any indentation deeper than the item's first line reads to the same tree
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(MOVE(EN := MOVE(EN := MOVE(EN := start, 1, OUT => a), 2, OUT => b), 3, OUT => c), Q => lamp);
=== model
NETWORK
  (:= lamp (MOVE 3 =>1:c en:(MOVE 2 =>1:b en:(MOVE 1 =>1:a en:start conn:0 eno:1) conn:0 eno:1) conn:0 eno:1))

#### chain-in-brackets
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(a AND MOVE(EN := MOVE(EN := c, 2, OUT => u), 1, OUT => t), Q => x);
=== model
NETWORK
  (:= x (AND a (MOVE 1 =>1:t en:(MOVE 2 =>1:u en:c conn:0 eno:1) conn:0 eno:1)))

#### en-slot-and-input-box
=== text
%LANGUAGE LD
%NETWORK
MOVE(EN := MOVE(EN := c, 1, OUT => u), MOVE(EN := d, 2, OUT => t), OUT => x);
=== model
NETWORK
  (MOVE (MOVE 2 =>1:t en:d conn:0 eno:1) =>1:x en:(MOVE 1 =>1:u en:c conn:0 eno:1) eno:1)

#### split-in-en-slot
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
ASSIGN(MOVE(EN := (w1 := a AND b), w1, OUT => t), Q => y);
=== model
NETWORK
  (:= y (MOVE #1 =>1:t en:(split 1 (AND a b)) conn:0 eno:1))

#### eno-into-split
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
w1 := MOVE(EN := go, 860, OUT => speed);
ASSIGN(w1, Q => a);
ASSIGN(w1, Q => b);
=== model
NETWORK
  (split 1 (MOVE 860 =>1:speed en:go conn:0 eno:1))
  (:= a #1)
  (:= b #1)

#### eno-jump — a jump fed through a box's ENO
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(MOVE(EN := c, 1, OUT => x), Q => JMP.Done);
%NETWORK
Done:
;
=== model
NETWORK
  (jmp Done (MOVE 1 =>1:x en:c conn:0 eno:1))
NETWORK label:Done
  ``

#### eno-modifier — a modifier on a box read through ENO is the box's flag (measurement 8)
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(NOT(MOVE(EN := c, 1, OUT => t)), Q => lamp);
ASSIGN(RISING(MOVE(EN := c, 2, OUT => u)), Q => edge);
=== model
NETWORK
  (:= lamp (NOT (MOVE 1 =>1:t en:c conn:0 eno:1)))
  (:= edge item:/ (MOVE 2 =>1:u en:c conn:0 eno:1))

#### negated-en-pin
=== text
%LANGUAGE LD
%NETWORK
MOVE(EN := INVERT(c), 5, OUT => y);
MOVE(EN := INVERT(c), 5, OUT => z);
=== model
NETWORK
  (MOVE 5 =>1:y !en:c eno:1)
  (MOVE 5 =>1:z !en:c eno:1)

#### fb-call-read-by-name — an FB with two outputs: its call is closed by the one its consumer reads
=== scope
instance t1 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(t1(IN := a, PT := T#1S), Q => x);
=== model
NETWORK
  (:= x (TON@t1 IN=a PT=T#1S name:Q))

#### fb-call-read-through-declared-eno — an FB that declares ENO: .ENO is that output, read by name; no ENO shown (1c)
=== scope
instance d1 Dryer
fb Dryer iOn => ENO xReady
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(d1(iOn := on), Q => ready);
=== model
NETWORK
  (:= ready (Dryer@d1 iOn=on name:ENO))

#### fb-call-enabled
=== scope
instance c1 CTU
instance c2 CTU
fb CTU CU RESET PV => Q CV
=== text
%LANGUAGE LD
%NETWORK
c1(EN := go, CU := a, PV := 10, CV => n);
ASSIGN(c2(EN := c, CU := a, PV := 10, CV => n) AND d, Q => lamp);
=== model
NETWORK
  (CTU@c1 CU=a PV=10 =>CV:n en:go eno:1)
  (:= lamp (AND (CTU@c2 CU=a PV=10 =>CV:n en:c conn:0 eno:1) d))

#### fb-call-enabled-read-by-name
=== scope
instance t1 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(t1(EN := c, IN := a, PT := T#1S).Q, Q => x);
=== model
NETWORK
  (:= x (TON@t1 IN=a PT=T#1S en:c name:Q))

#### call-enabled
=== text
%LANGUAGE LD
%NETWORK
LIMIT(EN := c, MN := 0, IN := v, MX := 100, OUT => y);
=== model
NETWORK
  (LIMIT MN=0 IN=v MX=100 =>1:y en:c eno:1)

#### function-eno-without-en — a function's box shows its ENO without EN at a root: the text is true, and the build refuses it
=== scope
function f IN =>
=== text
%LANGUAGE LD
%NETWORK
f(IN := b);
=== model
NETWORK
  (f IN=b)

#### call-read-through-eno — a call read through its ENO with no output wired (a PROGRAM call's box has none)
=== scope
program Drive =>
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(Drive(EN := TRUE) AND running, Q => lamp);
=== model
NETWORK
  (:= lamp (AND (Drive en:TRUE conn:0 eno:1) running))

#### operator-eno-value-nowhere-root — rule 7: an operator showing EN whose flow ends is a statement; at a root it shows no ENO
=== text
%LANGUAGE FBD
%NETWORK
MOVE(EN := c, i);
=== model
NETWORK
  (MOVE i en:c)

#### function-out-at-a-root-enabled — a function showing EN with its value wired at a root shows its ENO, the editor's form
=== scope
function f IN =>
=== text
%LANGUAGE FBD
%NETWORK
f(EN := go, IN := i, OUT => k);
=== model
NETWORK
  (f IN=i =>1:k en:go eno:1)

#### fb-enabled-first-output-not-q — an FB showing EN flows its ENO; its first output, DONE here, is read by name
=== scope
instance f1 FB1
fb FB1 IN => DONE BUSY
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(f1(EN := go, IN := a), Q => x);
ASSIGN(f1(EN := go, IN := a).DONE, Q => y);
ASSIGN(f1(EN := go, IN := a).BUSY, Q => z);
ASSIGN(f1(IN := a), Q => u);
=== model
NETWORK
  (:= x (FB1@f1 IN=a en:go conn:0 eno:1))
  (:= y (FB1@f1 IN=a en:go name:DONE))
  (:= z (FB1@f1 IN=a en:go name:BUSY))
  (:= u (FB1@f1 IN=a name:DONE))
