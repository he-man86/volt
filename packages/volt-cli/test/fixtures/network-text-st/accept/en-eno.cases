#### move-enabled
=== text
%LANGUAGE LD
%NETWORK
MOVE_ENONLY(EN := c, b, OUT => a);
=== model
NETWORK
  (MOVE b =>0:a en:c)

#### move-enabled-eno
=== text
%LANGUAGE LD
%NETWORK
MOVE_EN(EN := c, 0, OUT => x);
=== model
NETWORK
  (MOVE 0 =>1:x en:c eno:1)

#### add-enabled-two-targets — the data outputs fill the slots after ENO, in order
=== text
%LANGUAGE LD
%NETWORK
ADD_EN(EN := c, x, 5, OUT => x, OUT => y);
=== model
NETWORK
  (ADD x 5 =>1:x =>2:y en:c eno:1)

#### empty-enable
=== text
%LANGUAGE LD
%NETWORK
ADD_EN(EN := TRUE, x, 1, OUT => x);
=== model
NETWORK
  (ADD x 1 =>1:x en:TRUE eno:1)

#### en-source-is-a-slot
=== text
%LANGUAGE LD
%NETWORK
MOVE_EN(EN := ready AND btn, 6, OUT => t);
ADD_EN(EN := c, x, f(IN := b), OUT => y);
=== model
NETWORK
  (MOVE 6 =>1:t en:(AND ready btn) eno:1)
  (ADD x (f IN=b conn:0) =>1:y en:c eno:1)

#### read-through-eno
=== text
%LANGUAGE LD
%NETWORK
lamp := MOVE_EN(EN := c, 1, OUT => t);
=== model
NETWORK
  (:= lamp (MOVE 1 =>1:t en:c conn:0 eno:1))

#### enabled-value — EN without ENO: a consumer reads the box's value (measurement 5, 6)
=== text
%LANGUAGE LD
%NETWORK
y := MOVE_ENONLY(EN := c, k);
sum := ADD_ENONLY(EN := c, a, b);
lamp := GT_ENONLY(EN := c, a, 5);
res := f_ENONLY(EN := c, IN := v);
=== model
NETWORK
  (:= y (MOVE k en:c conn:0))
  (:= sum (ADD a b en:c conn:0))
  (:= lamp (GT a 5 en:c conn:0))
  (:= res (f IN=v en:c conn:0))

#### enabled-value-as-operand
=== text
%LANGUAGE LD
%NETWORK
x := a AND GT_ENONLY(EN := c, b, 40);
y := MOVE_EN(EN := c, 1, OUT => t) AND MOVE_EN(EN := d, 2, OUT => u);
=== model
NETWORK
  (:= x (AND a (GT b 40 en:c conn:0)))
  (:= y (AND (MOVE 1 =>1:t en:c conn:0 eno:1) (MOVE 2 =>1:u en:d conn:0 eno:1)))

#### enabled-call-in-pin
=== text
%LANGUAGE LD
%NETWORK
done R= fc(iEN := MOVE_EN(EN := go, stop, OUT => start), iPos := pos);
=== model
NETWORK
  (:= R=done (fc iEN=(MOVE stop =>1:start en:go conn:0 eno:1) iPos=pos conn:0))

#### chain
=== text
%LANGUAGE LD
%NETWORK
lamp := MOVE_EN(EN := MOVE_EN(EN := MOVE_EN(EN := start, 1, OUT => a), 2, OUT => b), 3, OUT => c);
=== model
NETWORK
  (:= lamp (MOVE 3 =>1:c en:(MOVE 2 =>1:b en:(MOVE 1 =>1:a en:start conn:0 eno:1) conn:0 eno:1) conn:0 eno:1))

#### chain-top-level — a chain nothing reads: its last box shows its ENO pin, connected to nothing
=== text
%LANGUAGE LD
%NETWORK
MOVE_EN(EN := MOVE_EN(EN := start, 1, OUT => a), 2, OUT => b);
=== model
NETWORK
  (MOVE 2 =>1:b en:(MOVE 1 =>1:a en:start conn:0 eno:1) eno:1)

#### chain-one-line — layout is the writer's: the chain on one line reads to the same tree
=== text
%LANGUAGE LD
%NETWORK
lamp := MOVE_EN(EN := MOVE_EN(EN := MOVE_EN(EN := start, 1, OUT => a), 2, OUT => b), 3, OUT => c);
=== model
NETWORK
  (:= lamp (MOVE 3 =>1:c en:(MOVE 2 =>1:b en:(MOVE 1 =>1:a en:start conn:0 eno:1) conn:0 eno:1) conn:0 eno:1))

#### chain-odd-indentation — any indentation deeper than the item's first line reads to the same tree
=== text
%LANGUAGE LD
%NETWORK
lamp := MOVE_EN(EN := MOVE_EN(EN := MOVE_EN(EN := start, 1, OUT => a), 2, OUT => b), 3, OUT => c);
=== model
NETWORK
  (:= lamp (MOVE 3 =>1:c en:(MOVE 2 =>1:b en:(MOVE 1 =>1:a en:start conn:0 eno:1) conn:0 eno:1) conn:0 eno:1))

#### chain-in-brackets
=== text
%LANGUAGE LD
%NETWORK
x := a AND MOVE_EN(EN := MOVE_EN(EN := c, 2, OUT => u), 1, OUT => t);
=== model
NETWORK
  (:= x (AND a (MOVE 1 =>1:t en:(MOVE 2 =>1:u en:c conn:0 eno:1) conn:0 eno:1)))

#### en-slot-and-input-box
=== text
%LANGUAGE LD
%NETWORK
MOVE_EN(EN := MOVE_EN(EN := c, 1, OUT => u), MOVE_EN(EN := d, 2, OUT => t), OUT => x);
=== model
NETWORK
  (MOVE (MOVE 2 =>1:t en:d conn:0 eno:1) =>1:x en:(MOVE 1 =>1:u en:c conn:0 eno:1) eno:1)

#### split-in-en-slot
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
y := MOVE_EN(EN := (w1 := a AND b), w1, OUT => t);
=== model
NETWORK
  (:= y (MOVE #1 =>1:t en:(split 1 (AND a b)) conn:0 eno:1))

#### eno-into-split
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
w1 := MOVE_EN(EN := go, 860, OUT => speed);
a := w1;
b := w1;
=== model
NETWORK
  (split 1 (MOVE 860 =>1:speed en:go conn:0 eno:1))
  (:= a #1)
  (:= b #1)

#### eno-jump — a jump fed through a box's ENO
=== text
%LANGUAGE LD
%NETWORK
JMP(Done, MOVE_EN(EN := c, 1, OUT => x));
%NETWORK
Done:
;
=== model
NETWORK
  (jmp Done (MOVE 1 =>1:x en:c conn:0 eno:1))
NETWORK label:Done
  ``

#### eno-modifier — a modifier on a box read through ENO is the box's flag (measurement 8)
=== text
%LANGUAGE LD
%NETWORK
lamp := NOT(MOVE_EN(EN := c, 1, OUT => t));
edge := R_EDGE(MOVE_EN(EN := c, 2, OUT => u));
=== model
NETWORK
  (:= lamp (NOT (MOVE 1 =>1:t en:c conn:0 eno:1)))
  (:= edge rise:(MOVE 2 =>1:u en:c conn:0 eno:1))

#### eno-wired-top-level
=== text
%LANGUAGE LD
%NETWORK
MOVE_EN(EN := c, 7, ENO => lamp, OUT => x);
=== model
NETWORK
  (MOVE 7 =>ENO:lamp =>1:x en:c eno:1)

#### negated-en-pin
=== text
%LANGUAGE LD
%NETWORK
MOVE_EN(EN := NOT c, 5, OUT => y);
MOVE_EN(EN := NOT c, 5, OUT => z);
=== model
NETWORK
  (MOVE 5 =>1:y en:not:c eno:1)
  (MOVE 5 =>1:z en:not:c eno:1)

#### fb-call-read-by-name
=== scope
instance t1 TON
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
t1(IN := a, PT := T#1S, Q => w1);
x := w1;
=== model
NETWORK
  (:= x (TON@t1 IN=a PT=T#1S name:Q))

#### fb-call-read-through-declared-eno — an FB that declares ENO, read with nothing after its call: its declared ENO (4a)
=== scope
instance d1 Dryer
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
d1_ENO(iOn := on, ENO => w1);
ready := w1;
=== model
NETWORK
  (:= ready (Dryer@d1 iOn=on conn:0 eno:1))

#### fb-call-enabled
=== scope
instance c1 CTU
instance c2 CTU
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
c1_EN(EN := go, CU := a, PV := 10, CV => n);
c2_EN(EN := c, CU := a, PV := 10, CV => n, ENO => w1);
lamp := w1 AND d;
=== model
NETWORK
  (CTU@c1 CU=a PV=10 =>CV:n en:go eno:1)
  (:= lamp (AND (CTU@c2 CU=a PV=10 =>CV:n en:c conn:0 eno:1) d))

#### fb-call-enabled-read-by-name
=== scope
instance t1 TON
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
t1_ENONLY(EN := c, IN := a, PT := T#1S, Q => w1);
x := w1;
=== model
NETWORK
  (:= x (TON@t1 IN=a PT=T#1S en:c name:Q))

#### call-enabled
=== text
%LANGUAGE LD
%NETWORK
LIMIT_EN(EN := c, MN := 0, IN := v, MX := 100, OUT => y);
=== model
NETWORK
  (LIMIT MN=0 IN=v MX=100 =>1:y en:c eno:1)

#### function-eno-without-en — a function's box shows its ENO without EN, and is read through it (recorded: it builds on both vendors)
=== text
%LANGUAGE LD
%NETWORK
x := f_ENO(IN := a);
f_ENO(IN := b);
=== model
NETWORK
  (:= x (f IN=a conn:0 eno:1))
  (f IN=b eno:1)

#### call-read-through-eno — a call read through its ENO with no output wired (a PROGRAM call's box has none)
=== text
%LANGUAGE LD
%NETWORK
lamp := Drive_EN(EN := TRUE) AND running;
=== model
NETWORK
  (:= lamp (AND (Drive en:TRUE conn:0 eno:1) running))
