#### rail-coil — a coil on the bare rail
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(RAIL(), Q => y);
ASSIGN(TRUE, Q => x);
=== model
NETWORK
  (:= y _)
  (:= x TRUE)

#### rail-pin-en-wire — the rail in every value slot
=== scope
instance t1 TON
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
w1 := RAIL();
ASSIGN(t1(IN := RAIL(), PT := T#1S).Q, Q => y);
ASSIGN(MOVE(EN := RAIL(), w1, OUT => n), Q => x);
=== model
NETWORK
  (split 1 _)
  (:= y (TON@t1 IN=_ PT=T#1S name:Q))
  (:= x (MOVE #1 =>1:n en:_ conn:0 eno:1))

#### value-marks — NOT, RISING and FALLING on a value; stacked, the edge outside
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(RISING(x), Q => a);
ASSIGN(FALLING(x), Q => b);
ASSIGN(RISING(INVERT(x)), Q => c);
ASSIGN(INVERT(x), Q => d);
=== model
NETWORK
  (:= a item:/ x)
  (:= b item:\ x)
  (:= c item:/ not:x)
  (:= d item:! x)

#### pin-marks — a mark before a pin's name is the pin's own
=== scope
instance t1 TON
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(t1(IN := INVERT(a), PT := T#1S).Q, Q => y);
%NETWORK
ASSIGN(t1(IN := RISING(a), PT := T#1S).Q, Q => y);
%NETWORK
ASSIGN(t1(IN := INVERT(a), PT := T#1S).Q, Q => y);
=== model
NETWORK
  (:= y (TON@t1 !IN=a PT=T#1S name:Q))
NETWORK
  (:= y (TON@t1 /IN=a PT=T#1S name:Q))
NETWORK
  (:= y (TON@t1 !IN=a PT=T#1S name:Q))

#### en-marks — a mark before EN is the EN pin's own
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(MOVE(EN := INVERT(c), 1, OUT => n), Q => x);
ASSIGN(MOVE(EN := RISING(c), 2, OUT => n), Q => x);
=== model
NETWORK
  (:= x (MOVE 1 =>1:n !en:c conn:0 eno:1))
  (:= x (MOVE 2 =>1:n /en:c conn:0 eno:1))

#### coil-marks — a mark before a coil is the coil's own
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(a, Q_INVERTED => y);
=== model
NETWORK
  (:= not:y a)

#### chain-mark-outermost — a marked coil leads its chain: every target receives the power flow
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(a, Q_INVERTED => y, Q => x);
=== model
NETWORK
  (:= not:y x a)

#### output-marks — a mark on an output is in its name
=== scope
instance t1 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE FBD
%NETWORK
t1(IN := a, PT := T#1S, Q_INVERTED => x);
=== model
NETWORK
  (TON@t1 IN=a PT=T#1S =>Q:not:x)

#### negated-box-output — NOT before a box read where it stands negates its output; NOT(…) is the NOT box
=== scope
instance t1 TON
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(INVERT(t1(IN := a, PT := T#1S).Q), Q => y);
ASSIGN(INVERT(AND(a, b)), Q => z);
ASSIGN(NOT(AND(a, b)), Q => w);
=== model
NETWORK
  (:= y item:! (TON@t1 IN=a PT=T#1S name:Q))
  (:= z item:! (AND a b))
  (:= w (NOT (AND a b)))

#### unnamed-pin-marks — a mark on a pin the IDE stores unnamed stands before an empty name
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(AND(a, INVERT(b)), Q => x);
%NETWORK
ASSIGN(AND(a, RISING(b)), Q => x);
%NETWORK
ASSIGN(AND(a, FALLING(b)), Q => x);
%NETWORK
ASSIGN(AND(INVERT(a), b, INVERT(c)), Q => x);
%NETWORK
ASSIGN(AND(a, INVERT(b)), Q => x);
=== model
NETWORK
  (:= x (AND a !b))
NETWORK
  (:= x (AND a /b))
NETWORK
  (:= x (AND a \b))
NETWORK
  (:= x (AND !a b !c))
NETWORK
  (:= x (AND a !b))

#### named-operator-pin — an operator pin the IDE stores named keeps its name
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(AND(a, IN2 := INVERT(b)), Q => x);
=== model
NETWORK
  (:= x (AND a !IN2=b))

#### not-before-an-edge — the line into a coil holds a negation outside an edge (NOT(R_TRIG(a)), measured)
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(INVERT(RISING(a)), Q => x);
=== model
NETWORK
  (:= x item:/! a)

#### marked-coil-inside-a-chain — a mark on one coil of several acts on that coil only (measured)
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(a, Q => y, Q_INVERTED => x);
=== model
NETWORK
  (:= y not:x a)

#### not-before-a-wire — a mark on a wire read stands on its receiver: the line into the coil
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
w1 := AND(a, b);
ASSIGN(INVERT(w1), Q => x);
ASSIGN(w1, Q => y);
=== model
NETWORK
  (split 1 (AND a b))
  (:= x item:! #1)
  (:= y #1)

#### edge-over-a-wire — an edge on a wire read stands on its receiver: the line into the coil
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
w1 := AND(a, b);
ASSIGN(RISING(w1), Q => x);
ASSIGN(w1, Q => y);
=== model
NETWORK
  (split 1 (AND a b))
  (:= x item:/ #1)
  (:= y #1)

#### pin-marks-stacked — a stack of marks on a pin: the outer one on the pin, the rest on its value
=== scope
instance t1 TON
=== text
%LANGUAGE FBD
%NETWORK
t1(IN := RISING(INVERT(a)), PT := T#1S);
=== model
NETWORK
  (TON@t1 /IN=not:a PT=T#1S)

#### unnamed-pin-marks-stacked — the same on a pin with no name
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(AND(a, FALLING(INVERT(b))), Q => x);
=== model
NETWORK
  (:= x (AND a \not:b))

#### en-marks-stacked — the same on EN
=== text
%LANGUAGE FBD
%NETWORK
MOVE(EN := RISING(INVERT(c)), 1, OUT => n);
=== model
NETWORK
  (MOVE 1 =>1:n /en:not:c eno:1)

#### item-marks-stacked — an edge outside a negation on the line into a coil: the edge on the line, the negation on the contact
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(RISING(INVERT(a)), Q => y);
=== model
NETWORK
  (:= y item:/ not:a)

#### box-output-pin-marks — a mark on a box output pin is in its name
=== scope
instance t2 FB2
fb FB2 IN => q1 q2
=== text
%LANGUAGE FBD
%NETWORK
t2(IN := a, q1_SET => x, q2_RESET => k);
t2(IN := a, q1_INVERTED => y);
=== model
NETWORK
  (FB2@t2 IN=a =>q1:S=x =>q2:S=not:k)
  (FB2@t2 IN=a =>q1:not:y)

#### marked-output-declared-as-named — an output the callee declares with a suffix is that output, unmarked
=== scope
instance t3 FB3
fb FB3 IN => Q_SET
=== text
%LANGUAGE FBD
%NETWORK
t3(IN := a, Q_SET => x);
=== model
NETWORK
  (FB3@t3 IN=a =>Q_SET:x)
