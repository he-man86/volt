#### jump-coil
=== text
%LANGUAGE LD
%NETWORK
JMP(Done, a AND b);
%NETWORK
Done:
x := TRUE;
=== model
NETWORK
  (jmp Done (AND a b))
NETWORK label:Done
  (:= x TRUE)

#### jump-rail
=== text
%LANGUAGE LD
%NETWORK
JMP Done;
%NETWORK
Done:
x := TRUE;
=== model
NETWORK
  (jmp Done _)
NETWORK label:Done
  (:= x TRUE)

#### return-coil
=== text
%LANGUAGE LD
%NETWORK
RETURN(NOT xReady);
=== model
NETWORK
  (ret not:xReady)

#### return-rail
=== text
%LANGUAGE LD
%NETWORK
RETURN;
=== model
NETWORK
  (ret _)

#### coil-and-jump — a coil and a jump on one value: one item per target, the coil first
=== text
%LANGUAGE LD
%NETWORK
x1 := c;
JMP(Done, c);
x2 := c;
RETURN(c);
%NETWORK
Done:
x := TRUE;
=== model
NETWORK
  (:= x1 c)
  (jmp Done c)
  (:= x2 c)
  (ret c)
NETWORK label:Done
  (:= x TRUE)

#### two-jumps — two jumps on one value: one item per jump
=== text
%LANGUAGE LD
%NETWORK
JMP(L1, c);
JMP(L2, c);
%NETWORK
L1:
x := TRUE;
%NETWORK
L2:
y := TRUE;
=== model
NETWORK
  (jmp L1 c)
  (jmp L2 c)
NETWORK label:L1
  (:= x TRUE)
NETWORK label:L2
  (:= y TRUE)

#### jump-set — a set jump has no spelling: the network is its %UNSUPPORTED line
=== text
%LANGUAGE LD
%NETWORK
%UNSUPPORTED "a coil modifier on a jump" #929f3675
%NETWORK
Done:
x := TRUE;
=== model
NETWORK unsupported:"a coil modifier on a jump" hash:929f3675
NETWORK label:Done
  (:= x TRUE)

#### nested-jump — a jump inside a tree is the function on its value
=== text
%LANGUAGE LD
%NETWORK
y := JMP(Done, c);
%NETWORK
Done:
x := TRUE;
=== model
NETWORK
  (:= y (jmp Done c))
NETWORK label:Done
  (:= x TRUE)

#### nested-assign
=== text
%LANGUAGE LD
%NETWORK
y := (x := a AND b);
=== model
NETWORK
  (:= y (:= x (AND a b)))

#### multi-coil
=== text
%LANGUAGE LD
%NETWORK
y := x := a;
=== model
NETWORK
  (:= y x a)

#### set-reset-chain — S= and R= are coils; on one variable the last stored wins (11)
=== text
%LANGUAGE LD
%NETWORK
a := b S= c R= value;
lamp S= lamp R= c;
lamp R= lamp S= c;
=== model
NETWORK
  (:= a S=b R=c value)
  (:= S=lamp R=lamp c)
  (:= R=lamp S=lamp c)

#### coil-on-rail
=== text
%LANGUAGE LD
%NETWORK
FirstCycle R= TRUE;
=== model
NETWORK
  (:= R=FirstCycle TRUE)

#### negated-coil
=== text
%LANGUAGE LD
%NETWORK
xn := NOT c;
=== model
NETWORK
  (:= xn not:c)

#### edge-coils
=== text
%LANGUAGE LD
%NETWORK
xe := c;
xf := c;
xg := NOT c;
=== model
NETWORK
  (:= xe c)
  (:= xf c)
  (:= xg not:c)

#### negated-empty-value
=== text
%LANGUAGE LD
%NETWORK
x := NOT TRUE;
=== model
NETWORK
  (:= x not:TRUE)

#### split-defined-and-read
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; w2 : ANY; END_VAR
w1 := TRUE;
w2 := w1 AND RunAuto;
a := w2;
b := w2 AND c;
=== model
NETWORK
  (split 1 TRUE)
  (split 2 (AND #1 RunAuto))
  (:= a #2)
  (:= b (AND #2 c))

#### split-of-a-box
=== text
%LANGUAGE FBD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
w1 := ADD(a, b);
x := w1;
=== model
NETWORK
  (split 1 (ADD a b conn:0))
  (:= x #1)

#### split-in-en
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
w1 := TRUE;
MOVE(EN := w1, 0, OUT => t).ENO;
=== model
NETWORK
  (split 1 TRUE)
  (MOVE 0 =>1:t en:#1 eno:1)

#### split-variable-backticked
=== scope
name split1
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
w1 := a;
x := w1;
split1 := w1;
=== model
NETWORK
  (split 1 a)
  (:= x #1)
  (:= split1 #1)

#### split-before-definition
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
x := w1;
w1 := a AND b;
y := w1 AND c;
=== model
NETWORK
  (:= x #1)
  (split 1 (AND a b))
  (:= y (AND #1 c))

#### split-nested-definition
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
x := (w1 := a AND b);
y := w1 AND c;
=== model
NETWORK
  (:= x (split 1 (AND a b)))
  (:= y (AND #1 c))
