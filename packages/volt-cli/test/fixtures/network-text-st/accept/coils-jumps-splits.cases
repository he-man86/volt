#### jump-coil
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(a AND b, Q => JMP.Done);
%NETWORK
Done:
ASSIGN(TRUE, Q => x);
=== model
NETWORK
  (jmp Done (AND a b))
NETWORK label:Done
  (:= x TRUE)

#### jump-rail
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(RAIL(), Q => JMP.Done);
%NETWORK
Done:
ASSIGN(TRUE, Q => x);
=== model
NETWORK
  (jmp Done _)
NETWORK label:Done
  (:= x TRUE)

#### return-coil
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(INVERT(xReady), Q => RETURN);
=== model
NETWORK
  (:= ret item:! xReady)

#### return-rail
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(RAIL(), Q => RETURN);
=== model
NETWORK
  (ret _)

#### coil-and-jump — coils, a jump and the return on one value: one item, its targets in stored order
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(c, Q => x1, Q => JMP.Done, Q => x2, Q => RETURN);
%NETWORK
Done:
ASSIGN(TRUE, Q => x);
=== model
NETWORK
  (:= x1 jmp:Done x2 ret c)
NETWORK label:Done
  (:= x TRUE)

#### coil-and-jump-on-a-box — the value is written once, whatever it holds
=== scope
instance t1 TON
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(t1(IN := c, PT := T#1S).Q, Q => y, Q => JMP.Done);
%NETWORK
Done:
ASSIGN(RAIL(), Q => x);
=== model
NETWORK
  (:= y jmp:Done (TON@t1 IN=c PT=T#1S name:Q))
NETWORK label:Done
  (:= x _)

#### two-jumps — two jumps on one value: one item per jump
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(c, Q => JMP.L1);
ASSIGN(c, Q => JMP.L2);
%NETWORK
L1:
ASSIGN(TRUE, Q => x);
%NETWORK
L2:
ASSIGN(TRUE, Q => y);
=== model
NETWORK
  (jmp L1 c)
  (jmp L2 c)
NETWORK label:L1
  (:= x TRUE)
NETWORK label:L2
  (:= y TRUE)

#### jump-set — a set jump has no spelling: the network is its %UNSUPPORTED line
=== text
%LANGUAGE LD
%NETWORK
%UNSUPPORTED "a coil flag on a jump or a return" #929f3675
%NETWORK
Done:
ASSIGN(TRUE, Q => x);
=== model
NETWORK unsupported:"a coil flag on a jump or a return" hash:929f3675
NETWORK label:Done
  (:= x TRUE)

#### nested-jump — a jump inside a tree is a nested assignment to its target
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(ASSIGN(c, Q => JMP.Done), Q => y);
%NETWORK
Done:
ASSIGN(TRUE, Q => x);
=== model
NETWORK
  (:= y (jmp Done c))
NETWORK label:Done
  (:= x TRUE)

#### nested-assign
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(ASSIGN(a AND b, Q => x), Q => y);
=== model
NETWORK
  (:= y (:= x (AND a b)))

#### multi-coil
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(a, Q => y, Q => x);
=== model
NETWORK
  (:= y x a)

#### set-reset-chain — S= and R= are coils; on one variable the last stored wins (11)
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(value, Q => a, Q_SET => b, Q_RESET => c);
ASSIGN(c, Q_SET => lamp, Q_RESET => lamp);
ASSIGN(c, Q_RESET => lamp, Q_SET => lamp);
=== model
NETWORK
  (:= a S=b R=c value)
  (:= S=lamp R=lamp c)
  (:= R=lamp S=lamp c)

#### coil-on-rail
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(TRUE, Q_RESET => FirstCycle);
=== model
NETWORK
  (:= R=FirstCycle TRUE)

#### negated-coil
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(INVERT(c), Q => xn);
=== model
NETWORK
  (:= xn item:! c)

#### edge-coils
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(c, Q => xe);
ASSIGN(c, Q => xf);
ASSIGN(INVERT(c), Q => xg);
=== model
NETWORK
  (:= xe c)
  (:= xf c)
  (:= xg item:! c)

#### negated-empty-value
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(INVERT(TRUE), Q => x);
=== model
NETWORK
  (:= x item:! TRUE)

#### split-defined-and-read
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; w2 : ANY; END_VAR
w1 := TRUE;
w2 := w1 AND RunAuto;
ASSIGN(w2, Q => a);
ASSIGN(w2 AND c, Q => b);
=== model
NETWORK
  (split 1 TRUE)
  (split 2 (AND #1 RunAuto))
  (:= a #2)
  (:= b (AND #2 c))

#### split-of-a-box
=== text
%LANGUAGE FBD
%NETWORK
VAR w1 : ANY; END_VAR
w1 := ADD(a, b);
ASSIGN(w1, Q => x);
=== model
NETWORK
  (split 1 (ADD a b conn:0))
  (:= x #1)

#### split-in-en
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
w1 := TRUE;
MOVE(EN := w1, 0, OUT => t);
=== model
NETWORK
  (split 1 TRUE)
  (MOVE 0 =>1:t en:#1 eno:1)

#### split-variable-backticked
=== scope
name split1
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
w1 := a;
ASSIGN(w1, Q => x);
ASSIGN(w1, Q => split1);
=== model
NETWORK
  (split 1 a)
  (:= x #1)
  (:= split1 #1)

#### split-before-definition
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
ASSIGN(w1, Q => x);
w1 := a AND b;
ASSIGN(w1 AND c, Q => y);
=== model
NETWORK
  (:= x #1)
  (split 1 (AND a b))
  (:= y (AND #1 c))

#### split-nested-definition
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
ASSIGN((w1 := a AND b), Q => x);
ASSIGN(w1 AND c, Q => y);
=== model
NETWORK
  (:= x (split 1 (AND a b)))
  (:= y (AND #1 c))

#### mixed-marks-in-a-target-list — each target of one ASSIGN holds its own mark, in stored order
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(a, Q_SET => x, Q => y, Q_RESET => z, Q_INVERTED => w);
=== model
NETWORK
  (:= S=x y R=z not:w a)

#### series-coils — a coil drawn in series is an ASSIGN nested in the value
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(ASSIGN(a, Q_INVERTED => x), Q => y);
=== model
NETWORK
  (:= y (:= not:x a))

#### jump-to-no-label — a jump drawn to no label is written as the editor shows it, ???
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(a, Q => JMP.???);
=== model
NETWORK
  (jmp ??? a)

#### inverted-jump-and-return — a negated jump and a negated return
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(a, Q_INVERTED => JMP.l);
ASSIGN(b, Q_INVERTED => RETURN);
%NETWORK
l:
ASSIGN(a, Q => x);
=== model
NETWORK
  (:= not:jmp:l a)
  (:= not:ret b)
NETWORK label:l
  (:= x a)
