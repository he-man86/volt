#### execute-top-level
=== text
%LANGUAGE LD
%NETWORK
EXECUTE('x := 1;');
=== model
NETWORK
  (EXECUTE "x := 1;")

#### execute-enabled
=== text
%LANGUAGE LD
%NETWORK
EXECUTE(EN := TRUE, 'iCount:=icount+1;
');
=== model
NETWORK
  (EXECUTE "iCount:=icount+1;\n" en:TRUE)

#### execute-read-through-eno — an Execute box read through its ENO, its one output
=== text
%LANGUAGE LD
%NETWORK
done := EXECUTE(EN := go, 'i := i + 1;');
=== model
NETWORK
  (:= done (EXECUTE "i := i + 1;" en:go conn:0))

#### execute-in-a-chain
=== text
%LANGUAGE LD
%NETWORK
lamp := MOVE(EN := EXECUTE(EN := go, 'i := i + 1;'), 1, OUT => t).ENO;
=== model
NETWORK
  (:= lamp (MOVE 1 =>1:t en:(EXECUTE "i := i + 1;" en:go conn:0) conn:0 eno:1))

#### execute-as-operand
=== text
%LANGUAGE LD
%NETWORK
x := EXECUTE(EN := go, 'i := 1;') AND d;
y := BRANCH(FEED := EXECUTE(EN := go, 'j := 1;'), d, e);
=== model
NETWORK
  (:= x (AND (EXECUTE "i := 1;" en:go conn:0) d))
  (:= y (par seq (EXECUTE "j := 1;" en:go conn:0) d e))

#### execute-through-a-wire — an Execute box read twice defines a wire, like any box
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
w1 := EXECUTE(EN := go, 'i := 1;');
x := w1;
y := w1 AND d;
=== model
NETWORK
  (split 1 (EXECUTE "i := 1;" en:go conn:0))
  (:= x #1)
  (:= y (AND #1 d))

#### execute-verbatim — a ' in the code is $', a $ is $$, everything else as it stands
=== text
%LANGUAGE LD
%NETWORK
EXECUTE('s := $'a$$Nb$'; // `x`');
=== model
NETWORK
  (EXECUTE "s := 'a$Nb'; // `x`")

#### execute-lines-are-its-code — a line of the code that opens with % or // is the box's ST, no line of the text
=== text
%LANGUAGE LD
%NETWORK
EXECUTE(EN := go, '// count
%QX0.1 := TRUE;
	n := n + 1;');
=== model
NETWORK
  (EXECUTE "// count\n%QX0.1 := TRUE;\n\tn := n + 1;" en:go)

#### execute-empty — an Execute box with no ST is the empty string
=== text
%LANGUAGE LD
%NETWORK
EXECUTE('');
=== model
NETWORK
  (EXECUTE "")

#### layout-free
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; w2 : ANY; END_VAR
w1 := TRUE;
w2 := w1 AND enable AND ready AND NOT stop;
x := f(IN1 := a, IN2 := b);
=== model
NETWORK
  (split 1 TRUE)
  (split 2 (AND #1 enable ready not:stop))
  (:= x (f IN1=a IN2=b conn:0))

#### layout-any-item-indent — an item's first line may stand at any column
=== text
%LANGUAGE LD
%NETWORK
x := a;
y := b AND c;
=== model
NETWORK
  (:= x a)
  (:= y (AND b c))
