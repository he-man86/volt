#### execute-top-level
=== text
%LANGUAGE LD
%NETWORK
%EXECUTE
x := 1;
%END_EXECUTE
=== model
NETWORK
  (EXECUTE "x := 1;")

#### execute-enabled
=== text
%LANGUAGE LD
%NETWORK
%EXECUTE(EN := TRUE)
iCount:=icount+1;

%END_EXECUTE
=== model
NETWORK
  (EXECUTE "iCount:=icount+1;\n" en:TRUE)

#### execute-read-through-eno — an Execute box read through its ENO, its one output
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
%EXECUTE(EN := go, ENO => w1)
i := i + 1;
%END_EXECUTE
done := w1;
=== model
NETWORK
  (:= done (EXECUTE "i := i + 1;" en:go conn:0))

#### execute-in-a-chain
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
%EXECUTE(EN := go, ENO => w1)
i := i + 1;
%END_EXECUTE
lamp := MOVE_EN(EN := w1, 1, OUT => t);
=== model
NETWORK
  (:= lamp (MOVE 1 =>1:t en:(EXECUTE "i := i + 1;" en:go conn:0) conn:0 eno:1))

#### execute-as-operand
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1, w2
%EXECUTE(EN := go, ENO => w1)
i := 1;
%END_EXECUTE
x := w1 AND d;
%EXECUTE(EN := go, ENO => w2)
j := 1;
%END_EXECUTE
y := BRANCH(FEED := w2, d, e);
=== model
NETWORK
  (:= x (AND (EXECUTE "i := 1;" en:go conn:0) d))
  (:= y (par seq (EXECUTE "j := 1;" en:go conn:0) d e))

#### execute-verbatim
=== text
%LANGUAGE LD
%NETWORK
%EXECUTE
s := 'a$Nb'; // `x`
%END_EXECUTE
=== model
NETWORK
  (EXECUTE "s := 'a$Nb'; // `x`")

#### execute-empty — an Execute box with no ST is one empty line
=== text
%LANGUAGE LD
%NETWORK
%EXECUTE

%END_EXECUTE
=== model
NETWORK
  (EXECUTE "")

#### execute-end-indent
=== text
%LANGUAGE LD
%NETWORK
%EXECUTE
x := 1;
%END_EXECUTE
=== model
NETWORK
  (EXECUTE "x := 1;")

#### layout-free
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1, w2
w1 := TRUE;
w2 := w1 AND enable AND ready AND NOT stop;
x := f(IN1 := a, IN2 := b);
=== model
NETWORK
  (split 1 TRUE)
  (split 2 (AND #1 enable ready not:stop))
  (:= x (f IN1=a IN2=b conn:0))

#### layout-any-item-indent — an item's first line may stand at any column
=== text
%LANGUAGE LD
%NETWORK
x := a;
y := b AND c;
=== model
NETWORK
  (:= x a)
  (:= y (AND b c))
