#### execute-read-through-eno — the v2 case execute-layout/execute-read-through-eno, as a pull writes it
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
%EXECUTE(EN := go, ENO => w1)
i := i + 1;
%END_EXECUTE
done := w1;
=== model
NETWORK
  (:= done (EXECUTE "i := i + 1;" en:go conn:0))

#### execute-in-a-chain — the v2 case execute-layout/execute-in-a-chain, as a pull writes it
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
%EXECUTE(EN := go, ENO => w1)
i := i + 1;
%END_EXECUTE
lamp := MOVE_EN(EN := w1, 1, OUT => t);
=== model
NETWORK
  (:= lamp (MOVE 1 =>1:t en:(EXECUTE "i := i + 1;" en:go conn:0) conn:0 eno:1))

#### execute-as-operand — the v2 case execute-layout/execute-as-operand, as a pull writes it
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1, w2
%EXECUTE(EN := go, ENO => w1)
i := 1;
%END_EXECUTE
x := w1 AND d;
%EXECUTE(EN := go, ENO => w2)
j := 1;
%END_EXECUTE
y := BRANCH(FEED := w2, d, e);
=== model
NETWORK
  (:= x (AND (EXECUTE "i := 1;" en:go conn:0) d))
  (:= y (par seq (EXECUTE "j := 1;" en:go conn:0) d e))

