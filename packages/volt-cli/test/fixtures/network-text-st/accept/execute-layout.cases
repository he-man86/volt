#### layout-free — the v2 case execute-layout/layout-free, as a pull writes it
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1, w2
w1 := TRUE;
w2 := w1 AND enable AND ready AND NOT stop;
x := f(IN1 := a, IN2 := b);
=== model
NETWORK
  (split 1 TRUE)
  (split 2 (AND #1 enable ready not:stop))
  (:= x (f IN1=a IN2=b conn:0))

