#### execute-top-level
=== text
%LANGUAGE LD
%NETWORK
EXECUTE('x := 1;');
=== model
NETWORK
  (EXECUTE "x := 1;" eno:1)

#### execute-enabled
=== text
%LANGUAGE LD
%NETWORK
EXECUTE(EN := TRUE, 'iCount:=icount+1;
');
=== model
NETWORK
  (EXECUTE "iCount:=icount+1;\n" en:TRUE eno:1)

#### execute-read-through-eno — an Execute box read through its ENO, its one output
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(EXECUTE(EN := go, 'i := i + 1;'), Q => done);
=== model
NETWORK
  (:= done (EXECUTE "i := i + 1;" en:go conn:0 eno:1))

#### execute-in-a-chain
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(MOVE(EN := EXECUTE(EN := go, 'i := i + 1;'), 1, OUT => t), Q => lamp);
=== model
NETWORK
  (:= lamp (MOVE 1 =>1:t en:(EXECUTE "i := i + 1;" en:go conn:0 eno:1) conn:0 eno:1))

#### execute-as-operand
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(EXECUTE(EN := go, 'i := 1;') AND d, Q => x);
ASSIGN(BRANCH(FEED := EXECUTE(EN := go, 'j := 1;'), d, e), Q => y);
=== model
NETWORK
  (:= x (AND (EXECUTE "i := 1;" en:go conn:0 eno:1) d))
  (:= y (par seq (EXECUTE "j := 1;" en:go conn:0 eno:1) d e))

#### execute-through-a-wire — an Execute box read twice defines a wire, like any box
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
w1 := EXECUTE(EN := go, 'i := 1;');
ASSIGN(w1, Q => x);
ASSIGN(w1 AND d, Q => y);
=== model
NETWORK
  (split 1 (EXECUTE "i := 1;" en:go conn:0 eno:1))
  (:= x #1)
  (:= y (AND #1 d))

#### execute-verbatim — a ' in the code is $', a $ is $$, everything else as it stands
=== text
%LANGUAGE LD
%NETWORK
EXECUTE('s := $'a$$Nb$'; // `x`');
=== model
NETWORK
  (EXECUTE "s := 'a$Nb'; // `x`" eno:1)

#### execute-lines-are-its-code — a line of the code that opens with % or // is the box's ST, no line of the text
=== text
%LANGUAGE LD
%NETWORK
EXECUTE(EN := go, '// count
%QX0.1 := TRUE;
	n := n + 1;');
=== model
NETWORK
  (EXECUTE "// count\n%QX0.1 := TRUE;\n\tn := n + 1;" en:go eno:1)

#### execute-empty — an Execute box with no ST is the empty string
=== text
%LANGUAGE LD
%NETWORK
EXECUTE('');
=== model
NETWORK
  (EXECUTE "" eno:1)

#### execute-en-eno — the Execute box shows EN and ENO as every box does: EN :=, .ENO, each kept on its own
=== text
%LANGUAGE LD
%NETWORK
EXECUTE('a := 1;');
EXECUTE('a := 1;');
EXECUTE(EN := go, 'a := 1;');
EXECUTE(EN := go, 'a := 1;');
=== model
NETWORK
  (EXECUTE "a := 1;" eno:1)
  (EXECUTE "a := 1;" eno:1)
  (EXECUTE "a := 1;" en:go eno:1)
  (EXECUTE "a := 1;" en:go eno:1)

#### layout-free
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; w2 : ANY; END_VAR
w1 := TRUE;
w2 := w1 AND enable AND ready AND INVERT(stop);
ASSIGN(f(IN1 := a, IN2 := b), Q => x);
=== model
NETWORK
  (split 1 TRUE)
  (split 2 (AND #1 enable ready not:stop))
  (:= x (f IN1=a IN2=b conn:0))

#### layout-any-item-indent — an item's first line may stand at any column
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(a, Q => x);
ASSIGN(b AND c, Q => y);
=== model
NETWORK
  (:= x a)
  (:= y (AND b c))
