#### add-coil
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(ADD(a, b), Q => x);
=== model
NETWORK
  (:= x (ADD a b conn:0))

#### every-word
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(AND(a, b), Q => b1);
ASSIGN(OR(a, b), Q => b2);
ASSIGN(XOR(a, b), Q => b3);
ASSIGN(ADD(i, j), Q => i1);
ASSIGN(SUB(i, j), Q => i2);
ASSIGN(MUL(i, j), Q => i3);
ASSIGN(DIV(i, j), Q => i4);
ASSIGN(MOD(i, j), Q => i5);
ASSIGN(GT(i, j), Q => c1);
ASSIGN(GE(i, j), Q => c2);
ASSIGN(EQ(i, j), Q => c3);
ASSIGN(NE(i, j), Q => c4);
ASSIGN(LE(i, j), Q => c5);
ASSIGN(LT(i, j), Q => c6);
=== model
NETWORK
  (:= b1 (AND a b))
  (:= b2 (OR a b))
  (:= b3 (XOR a b))
  (:= i1 (ADD i j conn:0))
  (:= i2 (SUB i j conn:0))
  (:= i3 (MUL i j conn:0))
  (:= i4 (DIV i j conn:0))
  (:= i5 (MOD i j conn:0))
  (:= c1 (GT i j conn:0))
  (:= c2 (GE i j conn:0))
  (:= c3 (EQ i j conn:0))
  (:= c4 (NE i j conn:0))
  (:= c5 (LE i j conn:0))
  (:= c6 (LT i j conn:0))

#### one-word-three-inputs
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(ADD(a, b, c), Q => x);
=== model
NETWORK
  (:= x (ADD a b c conn:0))

#### brackets-separate-boxes
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(ADD(a, ADD(b, c)), Q => x);
ASSIGN(MUL(ADD(a, b), c), Q => y);
ASSIGN(AND(start, OR(a, b), INVERT(stop)), Q => lamp);
=== model
NETWORK
  (:= x (ADD a (ADD b c conn:0) conn:0))
  (:= y (MUL (ADD a b conn:0) c conn:0))
  (:= lamp (AND start (OR a b) !stop))

#### and-nine-inputs — AND and OR take as many inputs as drawn
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(a AND b AND c AND d AND e AND f AND g AND h AND i, Q => q);
=== model
NETWORK
  (:= q (AND a b c d e f g h i))

#### top-level-word-with-output
=== text
%LANGUAGE FBD
%NETWORK
ADD(a, b, OUT => x);
=== model
NETWORK
  (ADD a b =>0:x)

#### lowercase-word
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(and(a, b), Q => x);
=== model
NETWORK
  (:= x (and a b))

#### empty-operand
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(MUL(TRUE, m, 6), Q => x);
ASSIGN(ADD(a, TRUE, c), Q => y);
=== model
NETWORK
  (:= x (MUL TRUE m 6 conn:0))
  (:= y (ADD a TRUE c conn:0))

#### negated-box
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(NOT(a AND b), Q => x);
ASSIGN(RISING(a AND b), Q => y);
=== model
NETWORK
  (:= x (NOT (AND a b)))
  (:= y item:/ (AND a b))

#### word-operand-call
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(ADD(a, f(IN := b)), Q => x);
=== model
NETWORK
  (:= x (ADD a (f IN=b conn:0) conn:0))

#### word-in-pin
=== scope
instance t1 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(t1(IN := a AND b, PT := T#1S), Q => q);
=== model
NETWORK
  (:= q (TON@t1 IN=(AND a b) PT=T#1S name:Q))

#### move-to
=== text
%LANGUAGE FBD
%NETWORK
MOVE(b, OUT => a);
=== model
NETWORK
  (MOVE b =>0:a)

#### move-then-coil
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(MOVE(b), Q => a);
=== model
NETWORK
  (:= a (MOVE b conn:0))

#### coil-no-box
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(b, Q => a);
=== model
NETWORK
  (:= a b)

#### move-empty-operand
=== text
%LANGUAGE FBD
%NETWORK
MOVE(TRUE, OUT => x);
=== model
NETWORK
  (MOVE TRUE =>0:x)

#### move-operand-bracketed
=== text
%LANGUAGE FBD
%NETWORK
MOVE(ADD(a, b), OUT => x);
=== model
NETWORK
  (MOVE (ADD a b conn:0) =>0:x)

#### not-box
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(NOT(a), Q => x);
=== model
NETWORK
  (:= x (NOT a))

#### not-box-empty — the NOT box with its one input unconnected names the pin
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(NOT(TRUE), Q => x);
=== model
NETWORK
  (:= x (NOT TRUE))

#### negated-pin-call-form
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(AND(a, b, INVERT(c)), Q => x);
=== model
NETWORK
  (:= x (AND a b !c))

#### rising-pin-call-form — an edge on an operator's pin, before the pin's name
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(AND(RISING(c), one), Q => x);
=== model
NETWORK
  (:= x (AND /c one))

#### edge-and-negation-on-a-pin
=== scope
instance t1 TON
=== text
%LANGUAGE LD
%NETWORK
t1(IN := RISING(INVERT(v)), PT := T#1S);
=== model
NETWORK
  (TON@t1 /IN=not:v PT=T#1S)
