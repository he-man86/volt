#### every-word — the v2 case words-and-move/every-word, as a pull writes it
=== text
%LANGUAGE FBD
%NETWORK
b1 := AND(a, b);
b2 := OR(a, b);
b3 := XOR(a, b);
i1 := ADD(i, j);
i2 := SUB(i, j);
i3 := MUL(i, j);
i4 := DIV(i, j);
i5 := MOD(i, j);
c1 := GT(i, j);
c2 := GE(i, j);
c3 := EQ(i, j);
c4 := NE(i, j);
c5 := LE(i, j);
c6 := LT(i, j);
=== model
NETWORK
  (:= b1 (AND a b))
  (:= b2 (OR a b))
  (:= b3 (XOR a b))
  (:= i1 (ADD i j conn:0))
  (:= i2 (SUB i j conn:0))
  (:= i3 (MUL i j conn:0))
  (:= i4 (DIV i j conn:0))
  (:= i5 (MOD i j conn:0))
  (:= c1 (GT i j conn:0))
  (:= c2 (GE i j conn:0))
  (:= c3 (EQ i j conn:0))
  (:= c4 (NE i j conn:0))
  (:= c5 (LE i j conn:0))
  (:= c6 (LT i j conn:0))

