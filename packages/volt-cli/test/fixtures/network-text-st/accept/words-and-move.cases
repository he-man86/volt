#### add-coil
=== text
%LANGUAGE FBD
%NETWORK
x := ADD(a, b);
=== model
NETWORK
  (:= x (ADD a b conn:0))

#### every-word
=== text
%LANGUAGE FBD
%NETWORK
b1 := AND(a, b);
b2 := OR(a, b);
b3 := XOR(a, b);
i1 := ADD(i, j);
i2 := SUB(i, j);
i3 := MUL(i, j);
i4 := DIV(i, j);
i5 := MOD(i, j);
c1 := GT(i, j);
c2 := GE(i, j);
c3 := EQ(i, j);
c4 := NE(i, j);
c5 := LE(i, j);
c6 := LT(i, j);
=== model
NETWORK
  (:= b1 (AND a b))
  (:= b2 (OR a b))
  (:= b3 (XOR a b))
  (:= i1 (ADD i j conn:0))
  (:= i2 (SUB i j conn:0))
  (:= i3 (MUL i j conn:0))
  (:= i4 (DIV i j conn:0))
  (:= i5 (MOD i j conn:0))
  (:= c1 (GT i j conn:0))
  (:= c2 (GE i j conn:0))
  (:= c3 (EQ i j conn:0))
  (:= c4 (NE i j conn:0))
  (:= c5 (LE i j conn:0))
  (:= c6 (LT i j conn:0))

#### one-word-three-inputs
=== text
%LANGUAGE FBD
%NETWORK
x := ADD(a, b, c);
=== model
NETWORK
  (:= x (ADD a b c conn:0))

#### brackets-separate-boxes
=== text
%LANGUAGE FBD
%NETWORK
x := ADD(a, ADD(b, c));
y := MUL(ADD(a, b), c);
lamp := AND(start, OR(a, b), NOT stop);
=== model
NETWORK
  (:= x (ADD a (ADD b c conn:0) conn:0))
  (:= y (MUL (ADD a b conn:0) c conn:0))
  (:= lamp (AND start (OR a b) not:stop))

#### and-nine-inputs — AND and OR take as many inputs as drawn
=== text
%LANGUAGE LD
%NETWORK
q := a AND b AND c AND d AND e AND f AND g AND h AND i;
=== model
NETWORK
  (:= q (AND a b c d e f g h i))

#### top-level-word-with-output
=== text
%LANGUAGE FBD
%NETWORK
ADD(a, b, OUT => x);
=== model
NETWORK
  (ADD a b =>0:x)

#### lowercase-word
=== text
%LANGUAGE FBD
%NETWORK
x := and(a, b);
=== model
NETWORK
  (:= x (and a b))

#### empty-operand
=== text
%LANGUAGE FBD
%NETWORK
x := MUL(TRUE, m, 6);
y := ADD(a, TRUE, c);
=== model
NETWORK
  (:= x (MUL TRUE m 6 conn:0))
  (:= y (ADD a TRUE c conn:0))

#### negated-box
=== text
%LANGUAGE LD
%NETWORK
x := NOT(a AND b);
y := R_EDGE(a AND b);
=== model
NETWORK
  (:= x (NOT (AND a b)))
  (:= y rise:(AND a b))

#### word-operand-call
=== text
%LANGUAGE FBD
%NETWORK
x := ADD(a, f(IN := b));
=== model
NETWORK
  (:= x (ADD a (f IN=b conn:0) conn:0))

#### word-in-pin
=== scope
instance t1 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE LD
%NETWORK
q := t1(IN := a AND b, PT := T#1S).Q;
=== model
NETWORK
  (:= q (TON@t1 IN=(AND a b) PT=T#1S name:Q))

#### move-to
=== text
%LANGUAGE FBD
%NETWORK
MOVE(b, OUT => a);
=== model
NETWORK
  (MOVE b =>0:a)

#### move-then-coil
=== text
%LANGUAGE FBD
%NETWORK
a := MOVE(b);
=== model
NETWORK
  (:= a (MOVE b conn:0))

#### coil-no-box
=== text
%LANGUAGE FBD
%NETWORK
a := b;
=== model
NETWORK
  (:= a b)

#### move-two-targets — MOVE writes to as many targets as drawn, in slot order
=== text
%LANGUAGE LD
%NETWORK
MOVE(0, OUT => a, OUT => b);
=== model
NETWORK
  (MOVE 0 =>0:a =>1:b)

#### move-empty-operand
=== text
%LANGUAGE FBD
%NETWORK
MOVE(TRUE, OUT => x);
=== model
NETWORK
  (MOVE TRUE =>0:x)

#### move-operand-bracketed
=== text
%LANGUAGE FBD
%NETWORK
MOVE(ADD(a, b), OUT => x);
=== model
NETWORK
  (MOVE (ADD a b conn:0) =>0:x)

#### not-box
=== text
%LANGUAGE FBD
%NETWORK
x := NOT(a);
=== model
NETWORK
  (:= x (NOT a))

#### not-box-empty — the NOT box with its one input unconnected names the pin
=== text
%LANGUAGE FBD
%NETWORK
x := NOT(TRUE);
=== model
NETWORK
  (:= x (NOT TRUE))

#### negated-pin-call-form
=== text
%LANGUAGE FBD
%NETWORK
x := AND(a, b, NOT c);
=== model
NETWORK
  (:= x (AND a b not:c))

#### rising-pin-call-form — an edge on an operator's pin, before the pin's name
=== text
%LANGUAGE LD
%NETWORK
x := AND(R_EDGE(c), one);
=== model
NETWORK
  (:= x (AND rise:c one))

#### edge-and-negation-on-a-pin
=== scope
instance t1 TON
=== text
%LANGUAGE LD
%NETWORK
t1(IN := R_EDGE(NOT v), PT := T#1S);
=== model
NETWORK
  (TON@t1 IN=rise:not:v PT=T#1S)
