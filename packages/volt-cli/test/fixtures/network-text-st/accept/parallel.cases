#### branch-fed
=== text
%LANGUAGE LD
%NETWORK
lamp := BRANCH(FEED := start, a, b AND LE(speed, 40), c);
=== model
NETWORK
  (:= lamp (par seq start a (AND b (LE speed 40 conn:0)) c))

#### branch-shortcircuit — the old short-circuit mode says so after the list
=== text
%LANGUAGE LD
%NETWORK
lamp := BRANCH_SHORTCIRCUIT(FEED := start, a, b);
=== model
NETWORK
  (:= lamp (par sc start a b))

#### branch-unfed
=== text
%LANGUAGE LD
%NETWORK
lamp := BRANCH(a, b);
=== model
NETWORK
  (:= lamp (par seq - a b))

#### branch-nested
=== text
%LANGUAGE LD
%NETWORK
lamp := BRANCH(FEED := start, a, BRANCH(FEED := c, b, go));
=== model
NETWORK
  (:= lamp (par seq start a (par seq c b go)))

#### branch-as-operand
=== text
%LANGUAGE LD
%NETWORK
MOVE_EN(EN := BRANCH(FEED := run, NOT low, LE_ENONLY(EN := low, speed, 40)) AND NOT cleaning, speed, OUT => t);
=== model
NETWORK
  (MOVE speed =>1:t en:(AND (par seq run not:low (LE speed 40 en:low conn:0)) not:cleaning) eno:1)

#### branch-word-feed
=== text
%LANGUAGE LD
%NETWORK
x := BRANCH(FEED := go AND sync, a, b);
=== model
NETWORK
  (:= x (par seq (AND go sync) a b))

#### branch-negated-feed
=== text
%LANGUAGE LD
%NETWORK
x := BRANCH(FEED := NOT go, a, b);
=== model
NETWORK
  (:= x (par seq not:go a b))

#### branch-as-en-source
=== text
%LANGUAGE LD
%NETWORK
MOVE_EN(EN := BRANCH(FEED := go, a, b), 1, OUT => x);
=== model
NETWORK
  (MOVE 1 =>1:x en:(par seq go a b) eno:1)

#### branch-of-enabled-comparisons
=== text
%LANGUAGE LD
%NETWORK
cam := BRANCH_SHORTCIRCUIT(FEED := enable, LE_ENONLY(EN := GE_ENONLY(EN := TRUE, pos, start), pos, stop), GT_ENONLY(EN := TRUE, start, stop));
=== model
NETWORK
  (:= cam (par sc enable (LE pos stop en:(GE pos start en:TRUE conn:0) conn:0) (GT start stop en:TRUE conn:0)))

#### branch-per-line — a branch holding a chain: the writer puts one branch per line, aligned
=== text
%LANGUAGE LD
%NETWORK
lamp := BRANCH(FEED := start, a, MOVE_EN(EN := MOVE_EN(EN := c, 2, OUT => u), 1, OUT => t), d);
=== model
NETWORK
  (:= lamp (par seq start a (MOVE 1 =>1:t en:(MOVE 2 =>1:u en:c conn:0 eno:1) conn:0 eno:1) d))

#### branch-per-line-read-on-one — the same tree on one line reads alike, and comes back laid out
=== text
%LANGUAGE LD
%NETWORK
lamp := BRANCH(FEED := start, a, MOVE_EN(EN := MOVE_EN(EN := c, 2, OUT => u), 1, OUT => t), d);
=== model
NETWORK
  (:= lamp (par seq start a (MOVE 1 =>1:t en:(MOVE 2 =>1:u en:c conn:0 eno:1) conn:0 eno:1) d))

#### empty-branch — an empty branch (a shorted branch) is nothing between its commas
=== text
%LANGUAGE LD
%NETWORK
x := BRANCH(FEED := go, a, TRUE, b);
y := BRANCH(FEED := go, a, TRUE);
=== model
NETWORK
  (:= x (par seq go a TRUE b))
  (:= y (par seq go a TRUE))

#### eno-feeds-a-branch
=== text
%LANGUAGE LD
%NETWORK
x := BRANCH(FEED := MOVE_EN(EN := c, 1, OUT => t), d, e);
=== model
NETWORK
  (:= x (par seq (MOVE 1 =>1:t en:c conn:0 eno:1) d e))
