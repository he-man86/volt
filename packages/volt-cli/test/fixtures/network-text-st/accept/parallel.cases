#### branch-as-operand — the v2 case parallel/branch-as-operand, as a pull writes it
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
LE_EN(EN := low, speed, 40, OUT => w1);
MOVE_EN(EN := (run AND (NOT low OR w1)) AND NOT cleaning, speed, OUT => t);
=== model
NETWORK
  (MOVE speed =>1:t en:(AND (AND run (OR not:low (LE speed 40 en:low conn:0))) not:cleaning) eno:1)

