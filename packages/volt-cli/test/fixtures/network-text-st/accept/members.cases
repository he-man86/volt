#### extra-unnamed-slot — an output slot the IDE stores holding ??? is written, OUT => ???
=== scope
program p =>
=== text
%LANGUAGE LD
%NETWORK
p(EN := RAIL(), OUT => ???);
=== model
NETWORK
  (p =>1:??? en:_ eno:1)

#### fb-one-output — an FB with one output: its call names none
=== scope
instance r1 R_TRIG
fb R_TRIG CLK => Q
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(AND(r1(CLK := a), b), Q => x);
=== model
NETWORK
  (:= x (AND (R_TRIG@r1 CLK=a name:Q) b))

#### fb-moved-pin — the engineer moved the output pin: the call names the output that chains on
=== scope
instance t1 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(t1(IN := a, PT := T#1S).ET, Q => t);
=== model
NETWORK
  (:= t (TON@t1 IN=a PT=T#1S name:ET))

#### fb-at-a-root — a root with no closer: its outputs are its targets
=== scope
instance t1 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE FBD
%NETWORK
t1(IN := a, PT := T#1S, Q => lamp);
=== model
NETWORK
  (TON@t1 IN=a PT=T#1S =>Q:lamp)

#### root-names-its-main-slot — .NAME at a root names the stored main slot
=== scope
instance c2 CTU
fb CTU CU PV => Q CV
=== text
%LANGUAGE FBD
%NETWORK
c2(CU := a, PV := 5).CV;
=== model
NETWORK
  (CTU@c2 CU=a PV=5 name:CV)

#### root-main-slot-negated — the mark stands around the closed call as on any root
=== scope
instance c2 CTU
fb CTU CU PV => Q CV
=== text
%LANGUAGE FBD
%NETWORK
INVERT(c2(CU := a, PV := 5).CV);
=== model
NETWORK
  not:(CTU@c2 CU=a PV=5 name:CV)

#### root-main-slot-beside-a-pin — slot 0 wired, the main slot past it
=== scope
instance c2 CTU
fb CTU CU PV => Q CV
=== text
%LANGUAGE FBD
%NETWORK
c2(CU := a, PV := 5, Q => x).CV;
=== model
NETWORK
  (CTU@c2 CU=a PV=5 =>Q:x name:CV)

#### root-main-slot-of-a-function — a function's main slot past its value
=== scope
function g IN => Q
=== text
%LANGUAGE FBD
%NETWORK
g(a).Q;
=== model
NETWORK
  (g a conn:1)

#### root-main-slot-unstated-callee — a callee no declaration states is read as written, as a consumed box
=== text
%LANGUAGE FBD
%NETWORK
h(a).X;
=== model
NETWORK
  (h a)

#### function-value-beside-an-output — a function with a VAR_OUTPUT: .OUT names its value
=== scope
function g IN => Q
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(g(a, Q => v), Q => q);
=== model
NETWORK
  (:= q (g a =>Q:v conn:0))

#### function-output-chains — a function read through its VAR_OUTPUT: .Q names it, slot 1 after the value
=== scope
function g IN => Q
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(g(a).Q, Q => q);
=== model
NETWORK
  (:= q (g a conn:1))

#### function-value-and-its-output-read — OUT => in the result slot, the null on the output read: the editor's Set Output
=== scope
function g IN => Q
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(g(a, OUT => v).Q, Q => q);
%NETWORK
g(a, OUT => v).Q;
=== model
NETWORK
  (:= q (g a =>0:v conn:1))
NETWORK
  (g a =>0:v conn:1)

#### declared-en-and-eno — a callee declaring EN and ENO: EN := and .ENO are its own pins, no flag shown
=== scope
instance w1 WSM
fb WSM EN xOn => ENO xBusy
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(w1(EN := TRUE, xOn := a), Q => ok);
=== model
NETWORK
  (:= ok (WSM@w1 EN=TRUE xOn=a name:ENO))

#### fb-shows-en-and-eno — EN := and .ENO on an FB that declares neither: its shown EN and ENO
=== scope
instance t1 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(AND(t1(EN := c, IN := a, PT := T#1S), b), Q => x);
=== model
NETWORK
  (:= x (AND (TON@t1 IN=a PT=T#1S en:c conn:0 eno:1) b))

#### unstated-callee-as-written — a callee no declaration in reach states: .NAME the output named so
=== scope
instance t1 TON
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(t1(IN := a, PT := T#1S).Q, Q => x);
ASSIGN(h(a, b), Q => y);
=== model
NETWORK
  (:= x (TON@t1 IN=a PT=T#1S name:Q))
  (:= y (h a b conn:0))

#### unstated-fb-read-by-no-name — an FB no declaration states, read with nothing named: the push refuses it by name
=== scope
instance t1 TON
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(AND(t1(IN := a, PT := T#1S), b), Q => x);
=== model
NETWORK
  (:= x (AND (TON@t1 IN=a PT=T#1S) b))

#### program-one-output — a program box read by its one VAR_OUTPUT: nothing to name
=== scope
program p IN => Q
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(AND(p(IN := a), b), Q => x);
=== model
NETWORK
  (:= x (AND (p IN=a conn:0) b))

#### program-two-outputs — a program box with two VAR_OUTPUTs: .NAME names the one that chains on
=== scope
program p IN => Q1 Q2
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(p(IN := a).Q2, Q => x);
=== model
NETWORK
  (:= x (p IN=a conn:1))

