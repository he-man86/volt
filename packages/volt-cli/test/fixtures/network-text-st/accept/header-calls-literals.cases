#### reserved-backticked
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(ENO, Q => y);
ASSIGN(c, Q => EN);
ASSIGN(Branch AND ShortCircuit, Q => z);
=== model
NETWORK
  (:= y ENO)
  (:= EN c)
  (:= z (AND Branch ShortCircuit))

#### non-words-are-names
=== text
%LANGUAGE LD
%NETWORK
%UNSUPPORTED "an operand named like an ST keyword" #b2b1dedd
=== model
NETWORK unsupported:"an operand named like an ST keyword" hash:b2b1dedd

#### reserved-pin-names — a pin named like an element of the text is a plain name
=== text
%LANGUAGE LD
%NETWORK
Run(branch := b, en => x);
=== model
NETWORK
  (Run branch=b =>en:x)

#### header-disabled-title
=== text
%LANGUAGE FBD
%NETWORK "x"
%DISABLED
ASSIGN(a, Q => y);
=== model
NETWORK disabled title:"x"
  (:= y a)
