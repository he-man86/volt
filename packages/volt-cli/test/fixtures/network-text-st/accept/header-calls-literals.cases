#### operand-text — an operand holding ST text is OPERAND('<its text>'), ST string escaping
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(OPERAND('INT_TO_WORD(i)'), Q => x);
ASSIGN(ADD(OPERAND('a.b*10'), 1), Q => y);
ASSIGN(INVERT(OPERAND('a OR b')), Q => z);
ASSIGN(OPERAND('s = $'x$''), Q => w);
ASSIGN(RISING(OPERAND('a AND b')), Q => v);
ASSIGN(OPERAND('t = $'$$$$$''), Q => u);
=== model
NETWORK
  (:= x `INT_TO_WORD(i)`)
  (:= y (ADD `a.b*10` 1 conn:0))
  (:= z item:! `a OR b`)
  (:= w `s = 'x'`)
  (:= v item:/ `a AND b`)
  (:= u `t = '$$'`)

#### header-order
=== text
%LANGUAGE LD
%NETWORK "Calc"
%DISABLED
Start:
ASSIGN(a, Q => x);
=== model
NETWORK label:Start disabled title:"Calc"
  (:= x a)

#### title-escapes
=== text
%LANGUAGE LD
%NETWORK "Calc $"A$" $$5 $R$L"
ASSIGN(a, Q => x);
=== model
NETWORK title:"Calc \"A\" $5 \r\n"
  (:= x a)

#### title-other-escapes
=== text
%LANGUAGE LD
%NETWORK "a$R$Lb	c'd"
ASSIGN(a, Q => x);
=== model
NETWORK title:"a\r\nb\tc'd"
  (:= x a)

#### comment-lines
=== text
%LANGUAGE LD
%NETWORK
// first line
//   indented
//
// last
ASSIGN(a, Q => x);
=== model
NETWORK comment:"first line\r\n  indented\r\n\r\nlast"
  (:= x a)

#### comment-trailing-line
=== text
%LANGUAGE LD
%NETWORK
// only
//
ASSIGN(a, Q => x);
=== model
NETWORK comment:"only\r\n"
  (:= x a)

#### comment-escapes
=== text
%LANGUAGE LD
%NETWORK
// cost $$5$Lnext$Rend
ASSIGN(a, Q => x);
=== model
NETWORK comment:"cost $5\nnext\rend"
  (:= x a)

#### empty-network
=== text
%LANGUAGE LD
%NETWORK
=== model
NETWORK

#### empty-item
=== text
%LANGUAGE LD
%NETWORK
;
=== model
NETWORK
  ``

#### unsupported-line
=== text
%LANGUAGE LD
%NETWORK "kept"
%UNSUPPORTED "a flag on a box input pin" #3f9a01c2
=== model
NETWORK title:"kept" unsupported:"a flag on a box input pin" hash:3f9a01c2

#### fb-call-empty-pin
=== scope
instance t2 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(t2(IN := TRUE, PT := e1), Q => output);
=== model
NETWORK
  (:= output (TON@t2 IN=TRUE PT=e1 name:Q))

#### unnamed-instance
=== scope
fb Axis xEnable =>
=== text
%LANGUAGE FBD
%NETWORK
Axis(xEnable := go);
=== model
NETWORK
  (Axis@??? xEnable=go)

#### undeclared-instance — an instance the declarations do not name: the call names its type, which the build judges
=== scope
fb TON IN PT => Q ET
=== text
%LANGUAGE FBD
%NETWORK
TON(IN := go);
=== model
NETWORK
  (TON@??? IN=go)

#### array-element-instance
=== scope
instance fbs[] CTU
=== text
%LANGUAGE LD
%NETWORK
fbs[1](CU := go, PV := 10, CV => n);
=== model
NETWORK
  (CTU@`fbs[1]` CU=go PV=10 =>CV:n)

#### method-call
=== scope
instance fbm FB_M
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(fbm.Visible(on := go), Q => x);
=== model
NETWORK
  (:= x (fbm.Visible on=go conn:0))

#### positional-pins — a pin stored with no name is positional, in slot order
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(LIMIT(0, v, 100), Q => y);
=== model
NETWORK
  (:= y (LIMIT 0 v 100 conn:0))

#### pin-vs-contact
=== scope
instance t1 TON
instance t2 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(t1(IN := INVERT(v), PT := T#1S), Q => q);
ASSIGN(t2(IN := INVERT(v), PT := T#1S), Q => p);
=== model
NETWORK
  (:= q (TON@t1 !IN=v PT=T#1S name:Q))
  (:= p (TON@t2 !IN=v PT=T#1S name:Q))

#### negated-contact
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(a AND INVERT(b), Q => x);
=== model
NETWORK
  (:= x (AND a not:b))

#### edges
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(RISING(x), Q => a);
ASSIGN(FALLING(x), Q => b);
ASSIGN(RISING(INVERT(x)), Q => c);
=== model
NETWORK
  (:= a item:/ x)
  (:= b item:\ x)
  (:= c item:/ not:x)

#### negated-call
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(NOT(f(IN := a)), Q => x);
=== model
NETWORK
  (:= x (NOT (f IN=a conn:0)))

#### literals — a literal is bare
=== text
%LANGUAGE LD
%NETWORK
ASSIGN('Recipes', Q => sName);
ASSIGN(-1, Q => n);
ASSIGN(-1.5, Q => re);
ASSIGN(T#1S, Q => t);
ASSIGN(16#FF, Q => w);
=== model
NETWORK
  (:= sName 'Recipes')
  (:= n -1)
  (:= re -1.5)
  (:= t T#1S)
  (:= w 16#FF)

#### expression-operand
=== text
%LANGUAGE LD
%NETWORK
MOVE(EN := go, DIV(DINT_TO_LREAL(pos), 10), OUT => target);
=== model
NETWORK
  (MOVE (DIV (DINT_TO_LREAL pos conn:0) 10 conn:0) =>1:target en:go eno:1)

#### backtick-escapes
=== text
%LANGUAGE LD
%NETWORK
%UNSUPPORTED "an operand that is no ST expression" #06cb118c
=== model
NETWORK unsupported:"an operand that is no ST expression" hash:06cb118c

