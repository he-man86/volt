#### header-order
=== text
%LANGUAGE LD
%NETWORK "Calc"
%DISABLED
Start:
x := a;
=== model
NETWORK label:Start disabled title:"Calc"
  (:= x a)

#### title-escapes
=== text
%LANGUAGE LD
%NETWORK "Calc $"A$" $$5 $R$L"
x := a;
=== model
NETWORK title:"Calc \"A\" $5 \r\n"
  (:= x a)

#### title-other-escapes
=== text
%LANGUAGE LD
%NETWORK "a$R$Lb	c'd"
x := a;
=== model
NETWORK title:"a\r\nb\tc'd"
  (:= x a)

#### comment-lines
=== text
%LANGUAGE LD
%NETWORK
// first line
//   indented
//
// last
x := a;
=== model
NETWORK comment:"first line\r\n  indented\r\n\r\nlast"
  (:= x a)

#### comment-trailing-line
=== text
%LANGUAGE LD
%NETWORK
// only
//
x := a;
=== model
NETWORK comment:"only\r\n"
  (:= x a)

#### comment-escapes
=== text
%LANGUAGE LD
%NETWORK
// cost $$5$Lnext$Rend
x := a;
=== model
NETWORK comment:"cost $5\nnext\rend"
  (:= x a)

#### empty-network
=== text
%LANGUAGE LD
%NETWORK
=== model
NETWORK

#### empty-item
=== text
%LANGUAGE LD
%NETWORK
;
=== model
NETWORK
  ``

#### unsupported-line
=== text
%LANGUAGE LD
%NETWORK "kept"
%UNSUPPORTED "a flag on a box input pin" #3f9a01c2
=== model
NETWORK title:"kept" unsupported:"a flag on a box input pin" hash:3f9a01c2

#### fb-call-empty-pin
=== scope
instance t2 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE LD
%NETWORK
output := TON(FB := t2, IN := TRUE, PT := e1).Q;
=== model
NETWORK
  (:= output (TON@t2 IN=TRUE PT=e1 name:Q))

#### unnamed-instance
=== scope
fb Axis
=== text
%LANGUAGE FBD
%NETWORK
Axis(FB := ???, xEnable := go);
=== model
NETWORK
  (Axis@??? xEnable=go)

#### undeclared-instance — an instance the declarations do not name: the call names its type, which the build judges
=== scope
fb TON
=== text
%LANGUAGE FBD
%NETWORK
TON(FB := ???, IN := go);
=== model
NETWORK
  (TON@??? IN=go)

#### array-element-instance
=== scope
instance fbs[] CTU
=== text
%LANGUAGE LD
%NETWORK
CTU(FB := fbs[1], CU := go, PV := 10, CV => n);
=== model
NETWORK
  (CTU@`fbs[1]` CU=go PV=10 =>CV:n)

#### method-call
=== scope
instance fbm FB_M
=== text
%LANGUAGE FBD
%NETWORK
x := fbm.Visible(on := go);
=== model
NETWORK
  (:= x (fbm.Visible on=go conn:0))

#### positional-pins — a pin stored with no name is positional, in slot order
=== text
%LANGUAGE FBD
%NETWORK
y := LIMIT(0, v, 100);
=== model
NETWORK
  (:= y (LIMIT 0 v 100 conn:0))

#### pin-vs-contact
=== scope
instance t1 TON
instance t2 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE FBD
%NETWORK
q := TON(FB := t1, IN := NOT v, PT := T#1S).Q;
p := TON(FB := t2, IN := NOT v, PT := T#1S).Q;
=== model
NETWORK
  (:= q (TON@t1 IN=not:v PT=T#1S name:Q))
  (:= p (TON@t2 IN=not:v PT=T#1S name:Q))

#### negated-contact
=== text
%LANGUAGE LD
%NETWORK
x := a AND NOT b;
=== model
NETWORK
  (:= x (AND a not:b))

#### edges
=== text
%LANGUAGE LD
%NETWORK
a := R_EDGE(x);
b := F_EDGE(x);
c := R_EDGE(NOT x);
=== model
NETWORK
  (:= a rise:x)
  (:= b fall:x)
  (:= c rise:not:x)

#### negated-call
=== text
%LANGUAGE FBD
%NETWORK
x := NOT(f(IN := a));
=== model
NETWORK
  (:= x (NOT (f IN=a conn:0)))

#### literals — a literal is bare
=== text
%LANGUAGE LD
%NETWORK
sName := 'Recipes';
n := -1;
re := -1.5;
t := T#1S;
w := 16#FF;
=== model
NETWORK
  (:= sName 'Recipes')
  (:= n -1)
  (:= re -1.5)
  (:= t T#1S)
  (:= w 16#FF)

#### expression-operand
=== text
%LANGUAGE LD
%NETWORK
MOVE(EN := go, DIV(DINT_TO_LREAL(pos), 10), OUT => target).ENO;
=== model
NETWORK
  (MOVE (DIV (DINT_TO_LREAL pos conn:0) 10 conn:0) =>1:target en:go eno:1)

#### backtick-escapes
=== text
%LANGUAGE LD
%NETWORK
%UNSUPPORTED "an operand that is no ST expression" #06cb118c
=== model
NETWORK unsupported:"an operand that is no ST expression" hash:06cb118c

#### empty-text-operand
=== scope
instance ton1 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE LD
%NETWORK
q := TON(FB := ton1, IN := TRUE).Q;
=== model
NETWORK
  (:= q (TON@ton1 IN=TRUE name:Q))

#### reserved-backticked
=== text
%LANGUAGE LD
%NETWORK
y := ENO;
EN := c;
z := Branch AND ShortCircuit;
=== model
NETWORK
  (:= y ENO)
  (:= EN c)
  (:= z (AND Branch ShortCircuit))

#### non-words-are-names
=== text
%LANGUAGE LD
%NETWORK
%UNSUPPORTED "an operand named like an ST keyword" #b2b1dedd
=== model
NETWORK unsupported:"an operand named like an ST keyword" hash:b2b1dedd

#### reserved-pin-and-head-backticked
=== text
%LANGUAGE LD
%NETWORK
Execute(branch := b, en => x);
=== model
NETWORK
  (Execute branch=b =>en:x)

#### header-disabled-title
=== text
%LANGUAGE FBD
%NETWORK "x"
%DISABLED
y := a;
=== model
NETWORK disabled title:"x"
  (:= y a)
