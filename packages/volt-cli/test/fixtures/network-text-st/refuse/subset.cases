%NETWORK
VAR w1 : ANY; END_VAR
%DISABLED
w1 := a AND b;
ASSIGN(w1, Q => x);
ASSIGN(w1, Q => y);
=== refused
network-plain-st a network's % lines stand first

#### unknown-line — a network holds no other % line
=== text
%LANGUAGE LD
%NETWORK
%COLOR red
ASSIGN(a, Q => x);
=== refused
network-plain-st a network holds no such line

#### code-under-unsupported — an UNSUPPORTED network holds nothing else
=== text
