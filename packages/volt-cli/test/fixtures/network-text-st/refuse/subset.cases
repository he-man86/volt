#### for-loop — a network holds no loop
=== text
%LANGUAGE LD
%NETWORK
FOR i := 1 TO 2 DO x := a; END_FOR;
=== refused
network-plain-st cannot hold a FOR

#### while-loop — a network holds no loop
=== text
%LANGUAGE LD
%NETWORK
WHILE a DO x := b; END_WHILE;
=== refused
network-plain-st cannot hold a WHILE

#### repeat-loop — a network holds no loop
=== text
%LANGUAGE LD
%NETWORK
REPEAT x := b; UNTIL a END_REPEAT;
=== refused
network-plain-st cannot hold a REPEAT

#### case-statement — a network holds no CASE
=== text
%LANGUAGE FBD
%NETWORK
CASE i OF 1: x := a; END_CASE;
=== refused
network-plain-st cannot hold a CASE

#### if-with-code — a network holds no IF
=== text
%LANGUAGE LD
%NETWORK
IF a THEN x := b; END_IF;
=== refused
network-plain-st holds no IF

#### if-around-a-jump — a jump on a value is JMP(label, value)
=== text
%LANGUAGE LD
%NETWORK
l:
IF a THEN JMP l; END_IF;
=== refused
network-plain-st a jump on a value is JMP(label, value)

#### jump-label-not-first — JMP(label, value) takes the label first
=== text
%LANGUAGE LD
%NETWORK
l:
JMP(c AND d, l);
=== refused
network-plain-st JMP(label, value)

#### infix-comparison — every box is a call
=== text
%LANGUAGE FBD
%NETWORK
x := i > 3;
=== refused
network-plain-st every box is a call

#### infix-arithmetic — every box is a call
=== text
%LANGUAGE FBD
%NETWORK
n := i + j;
=== refused
network-plain-st every box is a call

#### infix-xor — XOR is a box, not a contact
=== text
%LANGUAGE LD
%NETWORK
x := a XOR b;
=== refused
network-plain-st every box is a call

#### not-before-a-call — the NOT box is NOT(…)
=== text
%LANGUAGE LD
%NETWORK
x := NOT f(a);
=== refused
network-plain-st the NOT box is NOT(

#### block-comment — a network's comment is its // lines
=== text
%LANGUAGE LD
%NETWORK
x := a; (* note *)
=== refused
network-plain-st (* comment

#### comment-after-code — a network's comment stands before its code
=== text
%LANGUAGE LD
%NETWORK
x := a;
// late
y := b;
=== refused
network-plain-st comment after the code starts

#### pragma — a network holds no pragma
=== text
%LANGUAGE LD
%NETWORK
{attribute 'x'}
x := a;
=== refused
network-plain-st a pragma {

#### en-not-first — EN := stands first in a call (after FB :=): it is the box's shown EN
=== text
%LANGUAGE LD
%NETWORK
MOVE(1, EN := c, OUT => x).ENO;
=== refused
network-plain-st stands first

#### output-to-a-wire — a wire is defined by `w := <box>`, its box closed by the output it reads
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
MOVE(EN := c, 1, OUT => w1).ENO;
y := w1;
=== refused
network-plain-st a wire is defined by

#### member-at-a-root — a box at a root hands nothing on: its call is closed by .ENO or by nothing
=== scope
instance t1 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE LD
%NETWORK
TON(FB := t1, IN := a, PT := T#1S).Q;
=== refused
network-plain-st a box at a root hands nothing on

#### wire-declared-in-reach — a wire is never a variable
=== scope
name w1
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
w1 := a AND b;
x := w1;
y := w1;
=== refused
network-plain-st declared in reach

#### wire-named-twice — a wire is named once
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1, w1
w1 := a AND b;
x := w1;
y := w1;
=== refused
network-plain-st is named twice

#### wire-named-by-two-networks — a wire name is one network's in a body
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
w1 := a AND b;
x := w1;
y := w1;
%NETWORK
%WIRES w1
w1 := c;
u := w1;
v := w1;
=== refused
network-plain-st named on an earlier network too

#### wire-not-numbered — a wire is w<n>
=== text
%LANGUAGE LD
%NETWORK
%WIRES split1
split1 := a AND b;
x := split1;
y := split1;
=== refused
network-plain-st a wire is w<n>

#### wire-defined-twice — a wire is defined once
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
w1 := a;
w1 := b;
x := w1;
y := w1;
=== refused
network-plain-st is defined twice

#### wire-beside-a-coil — a wire is defined alone
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
x := w1 := a;
y := w1;
z := w1;
=== refused
network-plain-st a wire is defined alone

#### wire-never-defined — a named wire is defined
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
x := a;
=== refused
network-plain-st is named and never defined

#### wire-of-another-network — a wire is its network's
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
w1 := a AND b;
x := w1;
y := w1;
%NETWORK
z := w1;
=== refused
network-plain-st is read outside its network

#### label-not-first — a network's label is its first statement
=== text
%LANGUAGE LD
%NETWORK
x := a;
l2:
y := b;
=== refused
network-plain-st a label stands first in its network

#### expression-statement — a network holds assignments, calls, jumps and returns
=== text
%LANGUAGE LD
%NETWORK
a;
=== refused
network-plain-st an assignment, a call, a jump or a return

#### disabled-after-wires — the % lines stand in order
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
%DISABLED
w1 := a AND b;
x := w1;
y := w1;
=== refused
network-plain-st in the order %DISABLED, %WIRES

#### unknown-line — a network holds no other % line
=== text
%LANGUAGE LD
%NETWORK
%COLOR red
x := a;
=== refused
network-plain-st a network holds no such line

#### code-under-unsupported — an UNSUPPORTED network holds nothing else
=== text
%LANGUAGE LD
%NETWORK
%UNSUPPORTED "an edge contact" #0011aabb
x := a;
=== refused
network-plain-st holds nothing else

#### unsupported-line-shape — the line is %UNSUPPORTED "<shape>" #<hash>
=== text
%LANGUAGE LD
%NETWORK
%UNSUPPORTED an edge contact
=== refused
network-plain-st the line is %UNSUPPORTED

#### title-not-quoted — a network title is one "…"
=== text
%LANGUAGE LD
%NETWORK Start motor
x := a;
=== refused
network-plain-st a network title is one

#### execute-unclosed — an Execute box closes with %END_EXECUTE
=== text
%LANGUAGE LD
%NETWORK
%EXECUTE(EN := a)
x := 1;
=== refused
network-plain-st %EXECUTE with no %END_EXECUTE

#### execute-wire-read-before-its-box — an Execute box read once stands before the statement that reads it
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
y := w1;
%EXECUTE(EN := a, ENO => w1)
k := 1;
%END_EXECUTE
=== refused
network-plain-st is read before it is defined

#### execute-wire-not-directly-before-its-read — nothing stands between an Execute box read once and the statement that reads it
=== text
%LANGUAGE FBD
%NETWORK
%WIRES w1
%EXECUTE(EN := c, ENO => w1)
k := 1;
%END_EXECUTE
k := MOVE(5);
y := w1;
=== refused
network-plain-st directly before the statement that reads it

#### fb-type-without-instance — an FB box names its instance first: FB := t1, FB := ??? for none
=== scope
fb Axis
=== text
%LANGUAGE FBD
%NETWORK
Axis(xEnable := go);
=== refused
network-plain-st names no instance

#### wire-defined-by-an-execute-box-read-once — one model, one text: an Execute box read once through a wire defines the next wire itself
=== text
%LANGUAGE FBD
%NETWORK
%WIRES w1, w2
%EXECUTE(EN := a, ENO => w1)
k := 1;
%END_EXECUTE
w2 := w1;
x := w2;
y := w2;
=== refused
network-plain-st defines the wire itself

#### enabled-value-as-a-jump-condition — an enabled box other than a comparison is read by its value only as a coil's value
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
l:
JMP(l, AND(EN := c, a, b));
=== refused
network-plain-st comparison operators only

#### enabled-value-into-an-inline-wire — a wire defined inside a box is no coil
=== text
%LANGUAGE FBD
%NETWORK
%WIRES w2
y := MUL((w2 := ADD(EN := c, i, j)), 2);
z := w2;
v := w2;
=== refused
network-plain-st comparison operators only

#### instance-called — an FB box is the call of its type, its instance its first pin
=== scope
instance t1 TON
=== text
%LANGUAGE FBD
%NETWORK
t1(IN := a, PT := T#1S);
=== refused
network-plain-st names an FB instance

#### branch-pin-named — a branch takes its feed as FEED, then its branches positional
=== text
%LANGUAGE LD
%NETWORK
x := BRANCH(FEED := a, b, IN := c);
=== refused
network-plain-st then its branches, positional

#### branch-standing-alone — a branch is a value in a tree
=== text
%LANGUAGE LD
%NETWORK
BRANCH(FEED := a, b, c);
=== refused
network-plain-st is a value in a tree

#### branch-without-branches — a branch holds a branch
=== text
%LANGUAGE LD
%NETWORK
x := BRANCH(FEED := a);
=== refused
network-plain-st holds no branch

#### edge-over-a-wire — an edge is on a contact or a box
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
w1 := AND(a, b);
x := R_EDGE(w1);
y := w1;
=== refused
network-plain-st an edge is on a contact or on a box read where it stands

#### edge-with-two-values — an edge takes one value
=== text
%LANGUAGE LD
%NETWORK
x := F_EDGE(a, b);
=== refused
network-plain-st takes one value, positional

#### element-name-in-reach — the text's own function names name nothing in reach
=== text
%LANGUAGE LD
%NETWORK
x := R_EDGE(a);
=== scope
pou R_EDGE
=== refused
network-plain-st declared in reach

#### member-on-one-output — a box with one output names none: the member has no alternative
=== scope
instance r1 R_TRIG
fb R_TRIG CLK => Q
=== text
%LANGUAGE FBD
%NETWORK
x := R_TRIG(FB := r1, CLK := a).Q;
=== refused
network-plain-st a box with one output names none

#### eno-target-without-eno — ENO => v is a target of the shown ENO, which .ENO states
=== text
%LANGUAGE FBD
%NETWORK
ADD(EN := c, i, 1, ENO => lamp, OUT => x);
=== refused
network-plain-st ENO => v is a target of the shown ENO

#### value-to-a-wire — a box's value reaches a wire as the wire's definition, `w := <box>`
=== text
%LANGUAGE FBD
%NETWORK
%WIRES w1
GT(EN := c, i, 3, OUT => w1);
x := w1;
=== refused
network-plain-st a wire is defined by

#### en-only-value-inside-a-box — only a comparison with EN is read by its value inside a box
=== text
%LANGUAGE FBD
%NETWORK
y := MUL(ADD(EN := c, i, j), 2);
=== refused
network-plain-st comparison operators only

#### en-only-value-through-a-wire-read-in-a-box — every read of an enabled box's value is a coil's value
=== text
%LANGUAGE FBD
%NETWORK
%WIRES w1
w1 := ADD(EN := c, i, j);
x := MUL(w1, 2);
y := w1;
=== refused
network-plain-st comparison operators only

#### member-naming-no-output — .NAME names an output its callee declares
=== scope
instance t1 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE FBD
%NETWORK
x := TON(FB := t1, IN := a, PT := T#1S).Done;
=== refused
network-plain-st names no output of TON

#### several-outputs-no-member — a consumed box whose callee declares several outputs names the one its consumer reads
=== scope
instance t1 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE FBD
%NETWORK
x := TON(FB := t1, IN := a, PT := T#1S);
=== refused
network-plain-st names no output: TON has 2

#### out-on-a-function-without-outputs — .OUT on a function with no VAR_OUTPUT has no alternative
=== scope
function f IN =>
=== text
%LANGUAGE FBD
%NETWORK
x := f(IN := a).OUT;
=== refused
network-plain-st a box with one output names none

#### function-declaring-out — a function declaring VAR_OUTPUT OUT: OUT would name its value and that output both
=== scope
function g IN => OUT
=== text
%LANGUAGE FBD
%NETWORK
x := g(IN := a);
=== refused
network-plain-st declares VAR_OUTPUT OUT

#### instance-not-a-variable — FB := takes the instance: a variable, or ???
=== scope
fb TON IN PT => Q ET
=== text
%LANGUAGE FBD
%NETWORK
x := TON(FB := a AND b, IN := c, PT := T#1S).Q;
=== refused
network-plain-st takes its instance as FB :=

#### array-element-called — an element of an array of FBs is an instance: its box is the call of its type
=== scope
instance fbs[] CTU
=== text
%LANGUAGE LD
%NETWORK
fbs[1](CU := go, PV := 10);
=== refused
network-plain-st names an FB instance

#### operator-member-on-one-output — an IEC operator box (LIMIT) has one output: its call names none
=== text
%LANGUAGE FBD
%NETWORK
x := LIMIT(0, v, 100).OUT;
=== refused
network-plain-st a box with one output names none

#### operator-en-not-first — EN := on an IEC operator box (LIMIT) stands first: it is the shown EN
=== text
%LANGUAGE FBD
%NETWORK
LIMIT(MN := 0, EN := c, IN := v, MX := 100, OUT => y);
=== refused
network-plain-st EN := stands first

#### en-twice — EN := is written once, first
=== text
%LANGUAGE FBD
%NETWORK
MOVE(EN := c, EN := d, a, OUT => x);
=== refused
network-plain-st holds EN := twice

#### instance-of-another-type — an FB box is the call of its instance's declared type
=== scope
instance c1 CTU
fb CTU CU PV => Q CV
fb TON IN PT => Q ET
=== text
%LANGUAGE FBD
%NETWORK
x := TON(FB := c1, IN := a, PT := T#1S).Q;
=== refused
network-plain-st names the instance c1, declared CTU

#### instance-pin-on-an-operator — FB := names an FB box's instance: an operator box has none
=== scope
name x
=== text
%LANGUAGE FBD
%NETWORK
ADD(FB := x, a, b, OUT => y);
=== refused
network-plain-st FB := on a call of ADD, which is no function block

#### instance-pin-on-a-function — FB := names an FB box's instance: a function box has none
=== scope
name x
function g IN => Q
=== text
%LANGUAGE FBD
%NETWORK
g(FB := x, a);
=== refused
network-plain-st FB := on a call of g, which is no function block

#### instance-pin-not-an-instance — FB := names a variable that is no FB instance
=== scope
name x
fb TON IN PT => Q ET
=== text
%LANGUAGE FBD
%NETWORK
TON(FB := x, IN := a, PT := T#1S);
=== refused
network-plain-st x is no FB instance

#### en-value-through-a-member — an enabled function box read by its value or a VAR_OUTPUT inside a box: only .ENO hands on
=== scope
function g IN => Q
=== text
%LANGUAGE FBD
%NETWORK
x := MUL(g(EN := c, a).OUT, 2);
=== refused
network-plain-st comparison operators only

#### execute-closed-by-a-member — an Execute box is no call: its ENO reaches a wire through ENO =>
=== text
%LANGUAGE LD
%NETWORK
%EXECUTE(EN := a).ENO
k := 1;
%END_EXECUTE
=== refused
network-plain-st a member after an Execute box

#### program-several-outputs-no-member — a consumed program box with several outputs names the one its consumer reads
=== scope
program p IN => Q1 Q2
=== text
%LANGUAGE FBD
%NETWORK
x := p(IN := a);
=== refused
network-plain-st names no output: p has 2
