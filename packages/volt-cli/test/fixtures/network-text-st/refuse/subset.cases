#### for-loop — a network holds no loop
=== text
%LANGUAGE LD
%NETWORK
FOR i := 1 TO 2 DO x := a; END_FOR;
=== refused
network-plain-st cannot hold a FOR

#### while-loop — a network holds no loop
=== text
%LANGUAGE LD
%NETWORK
WHILE a DO x := b; END_WHILE;
=== refused
network-plain-st cannot hold a WHILE

#### repeat-loop — a network holds no loop
=== text
%LANGUAGE LD
%NETWORK
REPEAT x := b; UNTIL a END_REPEAT;
=== refused
network-plain-st cannot hold a REPEAT

#### case-statement — a network holds no CASE
=== text
%LANGUAGE FBD
%NETWORK
CASE i OF 1: x := a; END_CASE;
=== refused
network-plain-st cannot hold a CASE

#### if-with-code — a network holds no IF
=== text
%LANGUAGE LD
%NETWORK
IF a THEN x := b; END_IF;
=== refused
network-plain-st holds no IF

#### if-around-a-jump — a jump on a value is JMP(label, value)
=== text
%LANGUAGE LD
%NETWORK
l:
IF a THEN JMP l; END_IF;
=== refused
network-plain-st a jump on a value is JMP(label, value)

#### jump-label-not-first — JMP(label, value) takes the label first
=== text
%LANGUAGE LD
%NETWORK
l:
JMP(c AND d, l);
=== refused
network-plain-st JMP(label, value)

#### infix-comparison — every box is a call
=== text
%LANGUAGE FBD
%NETWORK
x := i > 3;
=== refused
network-plain-st every box is a call

#### infix-arithmetic — every box is a call
=== text
%LANGUAGE FBD
%NETWORK
n := i + j;
=== refused
network-plain-st every box is a call

#### infix-xor — XOR is a box, not a contact
=== text
%LANGUAGE LD
%NETWORK
x := a XOR b;
=== refused
network-plain-st every box is a call

#### not-before-a-call — the NOT box is NOT(…)
=== text
%LANGUAGE LD
%NETWORK
x := NOT f(a);
=== refused
network-plain-st the NOT box is NOT(

#### block-comment — a network's comment is its // lines
=== text
%LANGUAGE LD
%NETWORK
x := a; (* note *)
=== refused
network-plain-st (* comment

#### comment-after-code — a network's comment stands before its code
=== text
%LANGUAGE LD
%NETWORK
x := a;
// late
y := b;
=== refused
network-plain-st comment after the code starts

#### pragma — a network holds no pragma
=== text
%LANGUAGE LD
%NETWORK
{attribute 'x'}
x := a;
=== refused
network-plain-st a pragma {

#### enabled-box-without-en — an enabled box takes EN first
=== text
%LANGUAGE LD
%NETWORK
MOVE_EN(1, OUT => x);
=== refused
network-plain-st takes EN := as its first argument

#### enabled-value-through-out — X_EN returns its ENO; a box with EN read by its value is X_ENONLY
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
MOVE_EN(EN := c, 1, OUT => w1);
y := w1;
=== refused
network-plain-st returns its ENO, and its value reaches no wire

#### return-and-wire — a box read where it stands has no wire
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
y := MOVE_EN(EN := c, 1, OUT => w1);
z := w1;
=== refused
network-plain-st is read by its return and defines the wire

#### wire-declared-in-reach — a wire is never a variable
=== scope
name w1
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
w1 := a AND b;
x := w1;
y := w1;
=== refused
network-plain-st declared in reach

#### wire-named-twice — a wire is named once
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1, w1
w1 := a AND b;
x := w1;
y := w1;
=== refused
network-plain-st is named twice

#### wire-named-by-two-networks — a wire name is one network's in a body
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
w1 := a AND b;
x := w1;
y := w1;
%NETWORK
%WIRES w1
w1 := c;
u := w1;
v := w1;
=== refused
network-plain-st named on an earlier network too

#### wire-not-numbered — a wire is w<n>
=== text
%LANGUAGE LD
%NETWORK
%WIRES split1
split1 := a AND b;
x := split1;
y := split1;
=== refused
network-plain-st a wire is w<n>

#### wire-defined-twice — a wire is defined once
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
w1 := a;
w1 := b;
x := w1;
y := w1;
=== refused
network-plain-st is defined twice

#### wire-beside-a-coil — a wire is defined alone
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
x := w1 := a;
y := w1;
z := w1;
=== refused
network-plain-st a wire is defined alone

#### wire-never-defined — a named wire is defined
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
x := a;
=== refused
network-plain-st is named and never defined

#### wire-of-another-network — a wire is its network's
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
w1 := a AND b;
x := w1;
y := w1;
%NETWORK
z := w1;
=== refused
network-plain-st is read outside its network

#### label-not-first — a network's label is its first statement
=== text
%LANGUAGE LD
%NETWORK
x := a;
l2:
y := b;
=== refused
network-plain-st a label stands first in its network

#### expression-statement — a network holds assignments, calls, jumps and returns
=== text
%LANGUAGE LD
%NETWORK
a;
=== refused
network-plain-st an assignment, a call, a jump or a return

#### disabled-after-wires — the % lines stand in order
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
%DISABLED
w1 := a AND b;
x := w1;
y := w1;
=== refused
network-plain-st in the order %DISABLED, %WIRES

#### unknown-line — a network holds no other % line
=== text
%LANGUAGE LD
%NETWORK
%COLOR red
x := a;
=== refused
network-plain-st a network holds no such line

#### code-under-unsupported — an UNSUPPORTED network holds nothing else
=== text
%LANGUAGE LD
%NETWORK
%UNSUPPORTED "an edge contact" #0011aabb
x := a;
=== refused
network-plain-st holds nothing else

#### unsupported-line-shape — the line is %UNSUPPORTED "<shape>" #<hash>
=== text
%LANGUAGE LD
%NETWORK
%UNSUPPORTED an edge contact
=== refused
network-plain-st the line is %UNSUPPORTED

#### title-not-quoted — a network title is one "…"
=== text
%LANGUAGE LD
%NETWORK Start motor
x := a;
=== refused
network-plain-st a network title is one

#### execute-unclosed — an Execute box closes with %END_EXECUTE
=== text
%LANGUAGE LD
%NETWORK
%EXECUTE(EN := a)
x := 1;
=== refused
network-plain-st %EXECUTE with no %END_EXECUTE

#### call-wire-read-before-its-call — a box read once stands before the statement that reads it
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
y := w1;
t1(IN := a, PT := T#1S, Q => w1);
=== scope
instance t1 TON
=== refused
network-plain-st is read before it is defined

#### call-wire-not-directly-before-its-read — nothing stands between a box read once and the statement that reads it
=== text
%LANGUAGE FBD
%NETWORK
%WIRES w1
MOVE_EN(EN := c, k, OUT => w1);
k := MOVE(5);
y := w1;
=== refused
network-plain-st directly before the statement that reads it

#### function-named-like-an-enabled-box — a POU whose name ends in _EN reads as an enabled box
=== text
%LANGUAGE FBD
%NETWORK
Foo_EN(EN := a);
=== scope
pou Foo_EN
=== refused
network-plain-st reads as an enabled box

#### wire-defined-by-a-box-read-once — one model, one text: a box read once through a wire defines the next wire itself
=== text
%LANGUAGE FBD
%NETWORK
%WIRES w1, w2
t1(IN := a, PT := T#1S, Q => w1);
w2 := w1;
x := w2;
y := w2;
=== scope
instance t1 TON
=== refused
network-plain-st defines the wire itself

#### enabled-value-as-a-jump-condition — an enabled box other than a comparison is read by its value only as a coil's value
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
l:
JMP(l, AND_ENONLY(EN := c, a, b));
=== refused
network-plain-st comparison operators only

#### enabled-value-into-an-inline-wire — a wire defined inside a box is no coil
=== text
%LANGUAGE FBD
%NETWORK
%WIRES w2
y := MUL((w2 := ADD_ENONLY(EN := c, i, j)), 2);
z := w2;
v := w2;
=== refused
network-plain-st comparison operators only

#### variable-named-like-an-enabled-box — X_EN names nothing declared in reach
=== text
%LANGUAGE FBD
%NETWORK
x := foo_EN(EN := a, b);
=== scope
pou foo
name foo_EN
=== refused
network-plain-st reads as an enabled box

#### branch-pin-named — a branch takes its feed as FEED, then its branches positional
=== text
%LANGUAGE LD
%NETWORK
x := BRANCH(FEED := a, b, IN := c);
=== refused
network-plain-st then its branches, positional

#### branch-standing-alone — a branch is a value in a tree
=== text
%LANGUAGE LD
%NETWORK
BRANCH(FEED := a, b, c);
=== refused
network-plain-st is a value in a tree

#### branch-without-branches — a branch holds a branch
=== text
%LANGUAGE LD
%NETWORK
x := BRANCH(FEED := a);
=== refused
network-plain-st holds no branch

#### edge-over-a-wire — an edge is on a contact or a box
=== text
%LANGUAGE LD
%NETWORK
%WIRES w1
w1 := AND(a, b);
x := R_EDGE(w1);
y := w1;
=== refused
network-plain-st an edge is on a contact or on a box read where it stands

#### edge-with-two-values — an edge takes one value
=== text
%LANGUAGE LD
%NETWORK
x := F_EDGE(a, b);
=== refused
network-plain-st takes one value, positional

#### element-name-in-reach — the text's own function names name nothing in reach
=== text
%LANGUAGE LD
%NETWORK
x := R_EDGE(a);
=== scope
pou R_EDGE
=== refused
network-plain-st declared in reach

#### eno-box-named-in-reach — X_ENO names nothing declared in reach
=== text
%LANGUAGE FBD
%NETWORK
x := foo_ENO(b);
=== scope
pou foo
name foo_ENO
=== refused
network-plain-st reads as a box showing ENO

#### en-only-box-with-eno — X_ENONLY shows no ENO
=== text
%LANGUAGE FBD
%NETWORK
ADD_ENONLY(EN := c, i, 1, ENO => lamp, OUT => x);
=== refused
network-plain-st shows no ENO

#### en-only-value-through-out — X_ENONLY returns its value, read where it stands
=== text
%LANGUAGE FBD
%NETWORK
%WIRES w1
GT_ENONLY(EN := c, i, 3, OUT => w1);
x := w1;
=== refused
network-plain-st returns its value

#### en-only-value-inside-a-box — only a comparison with EN is read by its value inside a box
=== text
%LANGUAGE FBD
%NETWORK
y := MUL(ADD_ENONLY(EN := c, i, j), 2);
=== refused
network-plain-st comparison operators only

#### en-only-value-through-a-wire-read-in-a-box — every read of an enabled box's value is a coil's value
=== text
%LANGUAGE FBD
%NETWORK
%WIRES w1
w1 := ADD_ENONLY(EN := c, i, j);
x := MUL(w1, 2);
y := w1;
=== refused
network-plain-st comparison operators only

#### en-only-box-without-en — X_ENONLY takes EN first
=== text
%LANGUAGE FBD
%NETWORK
x := ADD_ENONLY(i, j);
=== refused
network-plain-st takes EN := as its first argument

#### en-only-box-named-in-reach — X_ENONLY names nothing declared in reach
=== text
%LANGUAGE FBD
%NETWORK
x := foo_ENONLY(EN := a, b);
=== scope
pou foo
name foo_ENONLY
=== refused
network-plain-st reads as an enabled box showing no ENO
