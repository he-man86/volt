#### old-form-eno — .ENO is no network text: ENO is the flow of a box showing EN
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(MOVE(EN := go, i, OUT => k).ENO, Q => y);
=== refused
network-plain-st .ENO is no network text

#### mark-on-a-wire-in-a-contact — a contact holds a mark, a wire read none
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
w1 := AND(a, b);
ASSIGN(INVERT(w1) AND c, Q => x);
ASSIGN(w1, Q => y);
=== refused
network-plain-st on a wire, a branch

#### mark-stack-too-deep — a stack deeper than the store holds
=== text
%LANGUAGE FBD
%NETWORK
f(IN := INVERT(INVERT(RISING(a))));
=== refused
network-plain-st a stack of marks deeper than the IDE stores

#### mark-on-an-assign — an ASSIGN holds no mark of its own outside a receiver
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(INVERT(ASSIGN(a, Q => x)) AND b, Q => y);
=== refused
network-plain-st a mark is on a contact, a box, or a receiver

#### assign-output-unknown — an ASSIGN names its targets by Q and its marks
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(a, OUT => y);
=== refused
network-plain-st its outputs are Q, Q_INVERTED, Q_SET and Q_RESET

#### marked-output-ambiguous — rule 9: an output named both ways is refused
=== scope
function f2 IN => Q Q_SET
=== text
%LANGUAGE FBD
%NETWORK
f2(IN := a, Q_SET => x);
=== refused
network-plain-st an output named like a marked output of the same box

