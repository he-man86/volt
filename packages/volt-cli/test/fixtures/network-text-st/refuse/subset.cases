#### operand-plain — a plain operand is written as it stands, never OPERAND
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(OPERAND('a'), Q => x);
=== refused
network-plain-st a plain operand is written as it stands

#### operand-not-a-string — OPERAND takes one string
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(OPERAND(a), Q => x);
=== refused
network-plain-st OPERAND takes one string

#### operand-two-strings — OPERAND takes one string
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(OPERAND('a + 1', 'b'), Q => x);
=== refused
network-plain-st OPERAND takes one string

#### operand-escape — an operand's text spells a ' as $' and a $ as $$, everything else as it stands
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(OPERAND('a$N+ b'), Q => x);
=== refused
network-plain-st the escape '$N'

#### operand-empty — an empty operand is no OPERAND
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(OPERAND(''), Q => x);
=== refused
network-plain-st OPERAND holds no text

#### wires-var-temp — a wire keeps its value across scans, as ST's VAR does
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
w1 := a AND b;
x := w1;
y := w1;
=== refused
network-plain-st are declared VAR w1 : ANY; END_VAR

#### for-loop — a network holds no loop
=== text
%LANGUAGE LD
%NETWORK
FOR i := 1 TO 2 DO x := a; END_FOR;
=== refused
network-plain-st cannot hold a FOR

#### while-loop — a network holds no loop
=== text
%LANGUAGE LD
%NETWORK
WHILE a DO x := b; END_WHILE;
=== refused
network-plain-st cannot hold a WHILE

#### repeat-loop — a network holds no loop
=== text
%LANGUAGE LD
%NETWORK
REPEAT x := b; UNTIL a END_REPEAT;
=== refused
network-plain-st cannot hold a REPEAT

#### case-statement — a network holds no CASE
=== text
%LANGUAGE FBD
%NETWORK
CASE i OF 1: x := a; END_CASE;
=== refused
network-plain-st cannot hold a CASE

#### if-with-code — a network holds no IF
=== text
%LANGUAGE LD
%NETWORK
IF a THEN x := b; END_IF;
=== refused
network-plain-st holds no IF

#### if-around-a-jump — a jump on a value is ASSIGN(value, Q => JMP.label)
=== text
%LANGUAGE LD
%NETWORK
l:
IF a THEN JMP l; END_IF;
=== refused
network-plain-st a jump on a value is ASSIGN(value, Q => JMP.label)

#### jump-as-a-call — a jump is a target of an ASSIGN
=== text
%LANGUAGE LD
%NETWORK
l:
JMP(l, c AND d);
=== refused
network-plain-st a jump or a return is a target of an ASSIGN

#### jump-statement — a jump is a target of an ASSIGN, also on the rail
=== text
%LANGUAGE LD
%NETWORK
l:
JMP l;
=== refused
network-plain-st a jump or a return is a target of an ASSIGN

#### return-statement — the return is a target of an ASSIGN, also on the rail
=== text
%LANGUAGE LD
%NETWORK
RETURN;
=== refused
network-plain-st a jump or a return is a target of an ASSIGN

#### jump-in-a-tree-as-a-call — a jump in a tree is a target of a nested ASSIGN
=== text
%LANGUAGE LD
%NETWORK
l:
ASSIGN(JMP(l, c), Q => y);
=== refused
network-plain-st a jump or a return is a target of an ASSIGN

#### set-jump — a jump or a return is no set or reset coil
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(c, Q_SET => RETURN);
=== refused
network-plain-st a jump or a return is no set or reset coil

#### rail-with-a-value — the rail takes no value
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(RAIL(a), Q => x);
=== refused
network-plain-st the rail RAIL() takes no value

#### mark-on-a-wire — a wire is no ASSIGN target
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
ASSIGN(a, Q_INVERTED => w1);
ASSIGN(w1, Q => x);
=== refused
network-plain-st a wire is defined alone

#### infix-comparison — every box is a call
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(i > 3, Q => x);
=== refused
network-plain-st every box is a call

#### infix-arithmetic — every box is a call
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(i + j, Q => n);
=== refused
network-plain-st every box is a call

#### infix-xor — XOR is a box, not a contact
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(a XOR b, Q => x);
=== refused
network-plain-st every box is a call

#### block-comment — a network's comment is its // lines
=== text
%LANGUAGE LD
%NETWORK
x := a; (* note *)
=== refused
network-plain-st (* comment

#### comment-after-code — a network's comment stands before its code
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(a, Q => x);
// late
ASSIGN(b, Q => y);
=== refused
network-plain-st comment after the code starts

#### pragma — a network holds no pragma
=== text
%LANGUAGE LD
%NETWORK
{attribute 'x'}
x := a;
=== refused
network-plain-st a pragma {

#### en-not-first — EN := stands first in a call: it is the box's shown EN
=== text
%LANGUAGE LD
%NETWORK
MOVE(1, EN := c, OUT => x);
=== refused
network-plain-st stands first

#### output-to-a-wire — a wire is defined by `w := <box>`, its box closed by the output it reads
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
MOVE(EN := c, 1, OUT => w1);
ASSIGN(w1, Q => y);
=== refused
network-plain-st a wire is defined by

#### root-names-its-first-output — no closer is the first output, so .NAME never names it
=== scope
instance t1 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE LD
%NETWORK
t1(IN := a, PT := T#1S).Q;
=== refused
network-plain-st a root with no closer

#### root-names-no-output — an unknown output stays refused by name
=== scope
instance t1 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE LD
%NETWORK
t1(IN := a, PT := T#1S).X;
=== refused
network-plain-st names no output of TON

#### root-names-its-one-output — a root names no first output
=== scope
instance r1 R_TRIG
fb R_TRIG CLK => Q
=== text
%LANGUAGE FBD
%NETWORK
r1(CLK := a).Q;
=== refused
network-plain-st a root with no closer is its first output

#### root-function-names-its-value — a function's value is its first output
=== scope
function g IN => Q
=== text
%LANGUAGE FBD
%NETWORK
g(a).OUT;
=== refused
network-plain-st a root with no closer

#### wire-declared-in-reach — a wire is never a variable
=== scope
name w1
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
w1 := a AND b;
ASSIGN(w1, Q => x);
ASSIGN(w1, Q => y);
=== refused
network-plain-st declared in reach

#### wire-named-twice — a wire is named once
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; w1 : ANY; END_VAR
w1 := a AND b;
ASSIGN(w1, Q => x);
ASSIGN(w1, Q => y);
=== refused
network-plain-st is named twice

#### wire-named-by-two-networks — a wire name is one network's in a body
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
w1 := a AND b;
ASSIGN(w1, Q => x);
ASSIGN(w1, Q => y);
%NETWORK
VAR w1 : ANY; END_VAR
w1 := c;
ASSIGN(w1, Q => u);
ASSIGN(w1, Q => v);
=== refused
network-plain-st named on an earlier network too

#### wire-not-numbered — a wire is w<n>
=== text
%LANGUAGE LD
%NETWORK
VAR split1 : ANY; END_VAR
split1 := a AND b;
ASSIGN(split1, Q => x);
ASSIGN(split1, Q => y);
=== refused
network-plain-st a wire is w<n>

#### wire-defined-twice — a wire is defined once
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
w1 := a;
w1 := b;
ASSIGN(w1, Q => x);
ASSIGN(w1, Q => y);
=== refused
network-plain-st is defined twice

#### wire-beside-a-coil — a wire is defined alone
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
ASSIGN(a, Q => x, Q => w1);
ASSIGN(w1, Q => y);
ASSIGN(w1, Q => z);
=== refused
network-plain-st a wire is defined alone

#### wire-never-defined — a named wire is defined
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
ASSIGN(a, Q => x);
=== refused
network-plain-st is named and never defined

#### wire-of-another-network — a wire is its network's
=== text
%LANGUAGE LD
%NETWORK
VAR w1 : ANY; END_VAR
w1 := a AND b;
ASSIGN(w1, Q => x);
ASSIGN(w1, Q => y);
%NETWORK
ASSIGN(w1, Q => z);
=== refused
network-plain-st is read outside its network

#### label-not-first — a network's label is its first statement
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(a, Q => x);
l2:
ASSIGN(b, Q => y);
=== refused
network-plain-st a label stands first in its network

#### disabled-after-wires — the % lines stand first
=== text
