#### comment-escape — a comment spells $$ $' $L $R, everything else as it stands
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(COMMENT(a, 'x$N'), Q => y);
=== refused
network-plain-st the escape '$N'

#### out-target-twice — the IDE writes no second target of one output: k and m measured on MOVE, ADD, AND and a FUNCTION
=== text
%LANGUAGE FBD
%NETWORK
MOVE(a, OUT => x, OUT => y);
=== refused
network-plain-st the call MOVE wires OUT => twice

#### out-target-twice-behind-eno — the same with EN and ENO shown
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(ADD(EN := c, i, 1, OUT => k, OUT => m), Q => y);
=== refused
network-plain-st the call ADD wires OUT => twice

#### named-output-target-twice — one output, two targets, on an FB as on a call
=== scope
fb Fx IN => q1 q2
instance t2 Fx
=== text
%LANGUAGE FBD
%NETWORK
t2(IN := a, q2 => k, q2 => m);
=== refused
network-plain-st the call t2 wires q2 => twice

#### fb-pin-by-position — an FB's box passes only named pins: t2(a, i) builds and calls t2()
=== scope
fb Fx a n => q1 q2
instance t2 Fx
=== text
%LANGUAGE FBD
%NETWORK
t2(a, i);
=== refused
network-plain-st the call t2 passes a pin by position

#### fb-pin-by-position-read — read as well as called
=== scope
fb Fx a n => q1 q2
instance t2 Fx
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(t2(a, i).q1, Q => x);
=== refused
network-plain-st the call t2 passes a pin by position

#### fb-pin-by-position-mixed — named and positional
=== scope
fb Fx a n => q1 q2
instance t2 Fx
=== text
%LANGUAGE FBD
%NETWORK
t2(a, n := i);
=== refused
network-plain-st the call t2 passes a pin by position

#### fb-pin-by-position-no-signature — an instance is an FB whether or not a declaration states its pins
=== scope
instance t1 TON
=== text
%LANGUAGE FBD
%NETWORK
t1(a);
=== refused
network-plain-st the call t1 passes a pin by position

#### program-pin-by-position — p(a, i) builds and calls p()
=== scope
program p a n => q1 q2
=== text
%LANGUAGE FBD
%NETWORK
p(a, i);
=== refused
network-plain-st the call p passes a pin by position

#### program-pin-by-position-read — x := p(a, i).q1 compiles to x := p.q1, the program not called at all
=== scope
program p a n => q1 q2
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(p(a, i).q1, Q => x);
=== refused
network-plain-st the call p passes a pin by position

#### eno-target-on-an-operator — z is never written (live CODESYS 3.5.21.40)
=== text
%LANGUAGE FBD
%NETWORK
MOVE(EN := c, 7, ENO => z, OUT => x);
=== refused
network-plain-st the IDE never writes a variable on the ENO pin

#### eno-target-on-a-function — neither z nor k is written
=== scope
function f IN => q
=== text
%LANGUAGE FBD
%NETWORK
f(EN := c, IN := a, ENO => z, OUT => k);
=== refused
network-plain-st the IDE never writes a variable on the ENO pin

#### eno-target-on-an-fb — z is never written
=== scope
fb Fx a => q1 q2
instance t2 Fx
=== text
%LANGUAGE FBD
%NETWORK
t2(EN := c, a := a, ENO => z);
=== refused
network-plain-st the IDE never writes a variable on the ENO pin

#### operator-eno-value-nowhere — a comparison read through ENO with its value wired nowhere does not build, and the next pull refused it
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(GT(EN := c, i, j), Q => y);
=== refused
network-plain-st hands on its ENO and wires its value nowhere

#### operator-eno-value-nowhere-and — AND answers an implicit variable no text holds
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(AND(EN := c, a, b), Q => y);
=== refused
network-plain-st hands on its ENO and wires its value nowhere

#### coil-edge — an edge on a coil cannot be drawn: no output names one
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(a, Q_RISING => y);
=== refused
network-plain-st an edge is on the value

#### jump-edge — an edge on a jump cannot be drawn: no output names one
=== text
%LANGUAGE LD
%NETWORK
ASSIGN(a, Q_RISING => JMP.l);
%NETWORK
l:
ASSIGN(a, Q => x);
=== refused
network-plain-st an edge is on the value

#### value-read-and-out-target — the box's reader is written and OUT => is not (live CODESYS 3.5.21.40)
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(ADD(i, j, OUT => m), Q => k);
=== refused
network-plain-st the box ADD is read by its value and wires OUT =>

#### value-read-and-out-target-function
=== scope
function f IN =>
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(f(IN := i, OUT => m), Q => k);
=== refused
network-plain-st the box f is read by its value and wires OUT =>

#### value-read-and-out-target-enabled — an enabled comparison the same
=== text
%LANGUAGE FBD
%NETWORK
ASSIGN(GT(EN := go, i, j, OUT => z).OUT, Q => x);
=== refused
network-plain-st the box GT is read by its value and wires OUT =>

#### function-out-at-a-root — k is not written, and with EN shown and no ENO the IDE faults on the box (live CODESYS 3.5.21.40)
=== scope
function f IN =>
=== text
%LANGUAGE FBD
%NETWORK
f(IN := i, OUT => k);
=== refused
network-plain-st the function box f wires OUT => at a root

