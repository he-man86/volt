#### for-loop — a network holds no loop
=== text
%LANGUAGE LD
%NETWORK
FOR i := 1 TO 2 DO x := a; END_FOR;
=== refused
network-plain-st cannot hold a FOR

#### while-loop — a network holds no loop
=== text
%LANGUAGE LD
%NETWORK
WHILE a DO x := b; END_WHILE;
=== refused
network-plain-st cannot hold a WHILE

#### repeat-loop — a network holds no loop
=== text
%LANGUAGE LD
%NETWORK
REPEAT x := b; UNTIL a END_REPEAT;
=== refused
network-plain-st cannot hold a REPEAT

#### case-statement — a network holds no CASE
=== text
%LANGUAGE FBD
%NETWORK
CASE i OF 1: x := a; END_CASE;
=== refused
network-plain-st cannot hold a CASE

#### if-with-code — a network holds no IF
=== text
%LANGUAGE LD
%NETWORK
IF a THEN x := b; END_IF;
=== refused
network-plain-st holds no IF

#### if-around-a-jump — a jump on a value is JMP.label := value
=== text
%LANGUAGE LD
%NETWORK
l:
IF a THEN JMP l; END_IF;
=== refused
network-plain-st a jump on a value is JMP.label := value

#### jump-as-a-call — a jump is a target, JMP.label := value
=== text
%LANGUAGE LD
%NETWORK
l:
JMP(l, c AND d);
=== refused
network-plain-st a jump or a return is a target: JMP.label := value

#### jump-statement — a jump is a target, also on the rail
=== text
%LANGUAGE LD
%NETWORK
l:
JMP l;
=== refused
network-plain-st a jump or a return is a target: JMP.label := value

#### return-statement — the return is a target, also on the rail
=== text
%LANGUAGE LD
%NETWORK
RETURN;
=== refused
network-plain-st a jump or a return is a target: JMP.label := value

#### jump-in-a-tree-as-a-call — a jump in a tree is a nested target, (JMP.label := value)
=== text
%LANGUAGE LD
%NETWORK
l:
y := JMP(l, c);
=== refused
network-plain-st a jump or a return is a target: JMP.label := value

#### mark-on-a-jump — a jump or a return carries no mark
=== text
%LANGUAGE LD
%NETWORK
l:
NOT JMP.l := c;
=== refused
network-plain-st a mark on the target JMP.l: a jump or a return carries none

#### set-jump — a jump or a return takes :=
=== text
%LANGUAGE LD
%NETWORK
RETURN S= c;
=== refused
network-plain-st RETURN S=: a jump or a return takes :=

#### negated-set-coil — NOT on a set or reset coil names no coil of its own
=== text
%LANGUAGE LD
%NETWORK
NOT y S= a;
=== refused
network-plain-st a negated set or reset coil is no coil of its own

#### marks-in-reverse-order — stacked, the edge stands outside the negation
=== text
%LANGUAGE LD
%NETWORK
NOT RISING y := a;
=== refused
network-plain-st the IDE negates first, so the edge is written outside the negation

#### not-before-an-edge — stacked on a value, the edge stands outside the negation
=== text
%LANGUAGE LD
%NETWORK
x := NOT RISING(a);
=== refused
network-plain-st NOT before an edge: the IDE negates first

#### edge-word-on-a-value — a value's edge is the call RISING(…)
=== text
%LANGUAGE LD
%NETWORK
x := RISING a;
=== refused
network-plain-st a value's edge is the call RISING(…) / FALLING(…)

#### marked-coil-inside-a-chain — a marked coil leads its chain
=== text
%LANGUAGE LD
%NETWORK
y := NOT x := a;
=== refused
network-plain-st a marked coil inside a chain

#### rail-standing-alone — the rail is a value in a tree
=== text
%LANGUAGE LD
%NETWORK
RAIL();
=== refused
network-plain-st a branch, an edge or the rail is a value in a tree

#### rail-with-a-value — the rail takes no value
=== text
%LANGUAGE LD
%NETWORK
x := RAIL(a);
=== refused
network-plain-st the rail RAIL() takes no value

#### mark-on-a-wire — a wire holds no mark
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
NOT w1 := a;
x := w1;
=== refused
network-plain-st a mark on the wire w1

#### infix-comparison — every box is a call
=== text
%LANGUAGE FBD
%NETWORK
x := i > 3;
=== refused
network-plain-st every box is a call

#### infix-arithmetic — every box is a call
=== text
%LANGUAGE FBD
%NETWORK
n := i + j;
=== refused
network-plain-st every box is a call

#### infix-xor — XOR is a box, not a contact
=== text
%LANGUAGE LD
%NETWORK
x := a XOR b;
=== refused
network-plain-st every box is a call

#### not-before-a-wire — NOT marks a contact or a box read where it stands
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
w1 := AND(a, b);
x := NOT w1;
y := w1;
=== refused
network-plain-st NOT marks a contact or a box read where it stands

#### block-comment — a network's comment is its // lines
=== text
%LANGUAGE LD
%NETWORK
x := a; (* note *)
=== refused
network-plain-st (* comment

#### comment-after-code — a network's comment stands before its code
=== text
%LANGUAGE LD
%NETWORK
x := a;
// late
y := b;
=== refused
network-plain-st comment after the code starts

#### pragma — a network holds no pragma
=== text
%LANGUAGE LD
%NETWORK
{attribute 'x'}
x := a;
=== refused
network-plain-st a pragma {

#### en-not-first — EN := stands first in a call: it is the box's shown EN
=== text
%LANGUAGE LD
%NETWORK
MOVE(1, EN := c, OUT => x).ENO;
=== refused
network-plain-st stands first

#### output-to-a-wire — a wire is defined by `w := <box>`, its box closed by the output it reads
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
MOVE(EN := c, 1, OUT => w1).ENO;
y := w1;
=== refused
network-plain-st a wire is defined by

#### member-at-a-root — a box at a root hands nothing on: its call is closed by .ENO or by nothing
=== scope
instance t1 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE LD
%NETWORK
t1(IN := a, PT := T#1S).Q;
=== refused
network-plain-st a box at a root hands nothing on

#### wire-declared-in-reach — a wire is never a variable
=== scope
name w1
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
w1 := a AND b;
x := w1;
y := w1;
=== refused
network-plain-st declared in reach

#### wire-named-twice — a wire is named once
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; w1 : ANY; END_VAR
w1 := a AND b;
x := w1;
y := w1;
=== refused
network-plain-st is named twice

#### wire-named-by-two-networks — a wire name is one network's in a body
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
w1 := a AND b;
x := w1;
y := w1;
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
w1 := c;
u := w1;
v := w1;
=== refused
network-plain-st named on an earlier network too

#### wire-not-numbered — a wire is w<n>
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP split1 : ANY; END_VAR
split1 := a AND b;
x := split1;
y := split1;
=== refused
network-plain-st a wire is w<n>

#### wire-defined-twice — a wire is defined once
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
w1 := a;
w1 := b;
x := w1;
y := w1;
=== refused
network-plain-st is defined twice

#### wire-beside-a-coil — a wire is defined alone
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
x := w1 := a;
y := w1;
z := w1;
=== refused
network-plain-st a wire is defined alone

#### wire-never-defined — a named wire is defined
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
x := a;
=== refused
network-plain-st is named and never defined

#### wire-of-another-network — a wire is its network's
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
w1 := a AND b;
x := w1;
y := w1;
%NETWORK
z := w1;
=== refused
network-plain-st is read outside its network

#### label-not-first — a network's label is its first statement
=== text
%LANGUAGE LD
%NETWORK
x := a;
l2:
y := b;
=== refused
network-plain-st a label stands first in its network

#### expression-statement — a network holds assignments, calls, jumps and returns
=== text
%LANGUAGE LD
%NETWORK
a;
=== refused
network-plain-st an assignment, a call, a jump or a return

#### disabled-after-wires — the % lines stand first
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
%DISABLED
w1 := a AND b;
x := w1;
y := w1;
=== refused
network-plain-st a network's % lines stand first

#### unknown-line — a network holds no other % line
=== text
%LANGUAGE LD
%NETWORK
%COLOR red
x := a;
=== refused
network-plain-st a network holds no such line

#### code-under-unsupported — an UNSUPPORTED network holds nothing else
=== text
%LANGUAGE LD
%NETWORK
%UNSUPPORTED "an edge contact" #0011aabb
x := a;
=== refused
network-plain-st holds nothing else

#### unsupported-line-shape — the line is %UNSUPPORTED "<shape>" #<hash>
=== text
%LANGUAGE LD
%NETWORK
%UNSUPPORTED an edge contact
=== refused
network-plain-st the line is %UNSUPPORTED

#### title-not-quoted — a network title is one "…"
=== text
%LANGUAGE LD
%NETWORK Start motor
x := a;
=== refused
network-plain-st a network title is one

#### execute-without-code — the Execute box takes EN := where it shows EN, then its ST, and nothing else
=== text
%LANGUAGE LD
%NETWORK
EXECUTE(EN := a);
=== refused
network-plain-st the Execute box takes EN := first where it shows EN, then its ST as one string '<ST>'

#### execute-code-pin — the Execute box's ST is one positional string, not a pin
=== text
%LANGUAGE LD
%NETWORK
EXECUTE(EN := a, CODE := 'k := 1;');
=== refused
network-plain-st the Execute box takes EN := first where it shows EN, then its ST as one string '<ST>'

#### execute-declared-in-reach — EXECUTE is the text's Execute box: a POU of that name in reach would give it two meanings
=== scope
pou EXECUTE
=== text
%LANGUAGE LD
%NETWORK
EXECUTE(EN := a, 'k := 1;');
=== refused
network-plain-st which the text reads as its Execute box

#### execute-code-escape — the code spells a ' as $' and a $ as $$, and everything else as it stands
=== text
%LANGUAGE LD
%NETWORK
EXECUTE('s := $Nb;');
=== refused
network-plain-st the escape '$N' in the Execute box's CODE

#### string-across-a-line — only the Execute box's ST spans lines
=== text
%LANGUAGE LD
%NETWORK
x := MOVE('a
b');
=== refused
network-plain-st a string across a line

#### execute-beside-a-variable-named-execute — EXECUTE is the text's own word: anything declared in reach under it is refused, a variable too
=== scope
name Execute
=== text
%LANGUAGE LD
%NETWORK
EXECUTE(EN := a, 'k := 1;');
=== refused
network-plain-st which the text reads as its Execute box

#### execute-code-unclosed — the Execute box's ST not closed runs to the body's end and is refused there
=== text
%LANGUAGE LD
%NETWORK
EXECUTE(EN := a, 'k := 1;
x := a;
=== refused
network-plain-st an unclosed string

#### execute-code-not-last — the Execute box's ST is its last pin
=== text
%LANGUAGE LD
%NETWORK
EXECUTE('k := 1;', EN := a);
=== refused
network-plain-st the Execute box takes EN := first where it shows EN, then its ST as one string '<ST>'

#### execute-eno-pin — the Execute box's ENO is its one output, read where it stands: no ENO => v pin
=== text
%LANGUAGE LD
%NETWORK
EXECUTE(EN := a, 'k := 1;', ENO => v);
=== refused
network-plain-st the Execute box takes EN := first where it shows EN, then its ST as one string '<ST>'

#### execute-code-wstring — the Execute box's ST is a '…' string, never a "…" one
=== text
%LANGUAGE LD
%NETWORK
EXECUTE(EN := a, "k := 1;");
=== refused
network-plain-st the Execute box takes EN := first where it shows EN, then its ST as one string '<ST>'

#### execute-code-wstring-across-a-line — a "…" string spans no line, in the Execute box either
=== text
%LANGUAGE LD
%NETWORK
EXECUTE(EN := a, "k := 1;
n := 2;");
=== refused
network-plain-st a string across a line

#### code-string-of-another-call — a string pin of a call other than the Execute box spans no line
=== scope
pou f
=== text
%LANGUAGE LD
%NETWORK
x := f(CODE := 'a
b');
=== refused
network-plain-st a string across a line

#### a-box-named-execute — a call headed Execute is the Execute box, in any case: a box of that type has no other spelling
=== text
%LANGUAGE FBD
%NETWORK
x := Execute(IN := b);
=== refused
network-plain-st the Execute box takes EN := first where it shows EN, then its ST as one string '<ST>'

#### enabled-value-as-a-jump-condition — an enabled box other than a comparison is read by its value only as a coil's value
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
l:
JMP.l := AND(EN := c, a, b);
=== refused
network-plain-st comparison operators only

#### enabled-value-into-an-inline-wire — a wire defined inside a box is no coil
=== text
%LANGUAGE FBD
%NETWORK
VAR_TEMP w2 : ANY; END_VAR
y := MUL((w2 := ADD(EN := c, i, j)), 2);
z := w2;
v := w2;
=== refused
network-plain-st comparison operators only

#### branch-pin-named — a branch takes its feed as FEED, then its branches positional
=== text
%LANGUAGE LD
%NETWORK
x := BRANCH(FEED := a, b, IN := c);
=== refused
network-plain-st then its branches, positional

#### branch-standing-alone — a branch is a value in a tree
=== text
%LANGUAGE LD
%NETWORK
BRANCH(FEED := a, b, c);
=== refused
network-plain-st is a value in a tree

#### branch-without-branches — a branch holds a branch
=== text
%LANGUAGE LD
%NETWORK
x := BRANCH(FEED := a);
=== refused
network-plain-st holds no branch

#### edge-over-a-wire — an edge is on a contact or a box
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
w1 := AND(a, b);
x := RISING(w1);
y := w1;
=== refused
network-plain-st an edge is on a contact or on a box read where it stands

#### edge-with-two-values — an edge takes one value
=== text
%LANGUAGE LD
%NETWORK
x := FALLING(a, b);
=== refused
network-plain-st takes one value, positional

#### element-name-in-reach — the text's own function names name nothing in reach
=== text
%LANGUAGE LD
%NETWORK
x := RISING(a);
=== scope
pou RISING
=== refused
network-plain-st declared in reach

#### member-on-one-output — a box with one output names none: the member has no alternative
=== scope
instance r1 R_TRIG
fb R_TRIG CLK => Q
=== text
%LANGUAGE FBD
%NETWORK
x := r1(CLK := a).Q;
=== refused
network-plain-st a box with one output names none

#### eno-target-without-eno — ENO => v is a target of the shown ENO, which .ENO states
=== text
%LANGUAGE FBD
%NETWORK
ADD(EN := c, i, 1, ENO => lamp, OUT => x);
=== refused
network-plain-st ENO => v is a target of the shown ENO

#### value-to-a-wire — a box's value reaches a wire as the wire's definition, `w := <box>`
=== text
%LANGUAGE FBD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
GT(EN := c, i, 3, OUT => w1);
x := w1;
=== refused
network-plain-st a wire is defined by

#### en-only-value-inside-a-box — only a comparison with EN is read by its value inside a box
=== text
%LANGUAGE FBD
%NETWORK
y := MUL(ADD(EN := c, i, j), 2);
=== refused
network-plain-st comparison operators only

#### en-only-value-through-a-wire-read-in-a-box — every read of an enabled box's value is a coil's value
=== text
%LANGUAGE FBD
%NETWORK
VAR_TEMP w1 : ANY; END_VAR
w1 := ADD(EN := c, i, j);
x := MUL(w1, 2);
y := w1;
=== refused
network-plain-st comparison operators only

#### member-naming-no-output — .NAME names an output its callee declares
=== scope
instance t1 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE FBD
%NETWORK
x := t1(IN := a, PT := T#1S).Done;
=== refused
network-plain-st names no output of TON

#### several-outputs-no-member — a consumed box whose callee declares several outputs names the one its consumer reads
=== scope
instance t1 TON
fb TON IN PT => Q ET
=== text
%LANGUAGE FBD
%NETWORK
x := t1(IN := a, PT := T#1S);
=== refused
network-plain-st names no output: TON has 2

#### out-on-a-function-without-outputs — .OUT on a function with no VAR_OUTPUT has no alternative
=== scope
function f IN =>
=== text
%LANGUAGE FBD
%NETWORK
x := f(IN := a).OUT;
=== refused
network-plain-st a box with one output names none

#### function-declaring-out — a function declaring VAR_OUTPUT OUT: OUT would name its value and that output both
=== scope
function g IN => OUT
=== text
%LANGUAGE FBD
%NETWORK
x := g(IN := a);
=== refused
network-plain-st declares VAR_OUTPUT OUT

#### operator-member-on-one-output — an IEC operator box (LIMIT) has one output: its call names none
=== text
%LANGUAGE FBD
%NETWORK
x := LIMIT(0, v, 100).OUT;
=== refused
network-plain-st a box with one output names none

#### operator-en-not-first — EN := on an IEC operator box (LIMIT) stands first: it is the shown EN
=== text
%LANGUAGE FBD
%NETWORK
LIMIT(MN := 0, EN := c, IN := v, MX := 100, OUT => y);
=== refused
network-plain-st EN := stands first

#### en-twice — EN := is written once, first
=== text
%LANGUAGE FBD
%NETWORK
MOVE(EN := c, EN := d, a, OUT => x);
=== refused
network-plain-st holds EN := twice

#### en-value-through-a-member — an enabled function box read by its value or a VAR_OUTPUT inside a box: only .ENO hands on
=== scope
function g IN => Q
=== text
%LANGUAGE FBD
%NETWORK
x := MUL(g(EN := c, a).OUT, 2);
=== refused
network-plain-st comparison operators only

#### execute-closed-by-a-member — the Execute box has one output, its ENO: no member closes its call
=== text
%LANGUAGE LD
%NETWORK
x := EXECUTE(EN := a, 'k := 1;').ENO;
=== refused
network-plain-st its one output is its ENO

#### program-several-outputs-no-member — a consumed program box with several outputs names the one its consumer reads
=== scope
program p IN => Q1 Q2
=== text
%LANGUAGE FBD
%NETWORK
x := p(IN := a);
=== refused
network-plain-st names no output: p has 2

#### wires-not-any — a wire is declared : ANY, its type its definition's
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1 : BOOL; END_VAR
w1 := a AND b;
x := w1;
y := w1;
=== refused
network-plain-st a wire is declared : ANY

#### wires-after-the-comment — a network's wires are declared after its % lines, before its comment
=== text
%LANGUAGE LD
%NETWORK
// start
VAR_TEMP w1 : ANY; END_VAR
w1 := a AND b;
x := w1;
y := w1;
=== refused
network-plain-st its wires are declared after its % lines, before its comment

#### wires-across-lines — a network's wires are declared on one line
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP
w1 : ANY;
END_VAR
w1 := a AND b;
x := w1;
y := w1;
=== refused
network-plain-st a network's wires are declared on one line

#### wires-as-a-list — each wire is declared on its own, w1 : ANY; w2 : ANY;
=== text
%LANGUAGE LD
%NETWORK
VAR_TEMP w1, w2 : ANY; END_VAR
w1 := a AND b;
w2 := a OR b;
x := w1 AND w2;
y := w1 OR w2;
=== refused
network-plain-st a network's wires are declared on one line

#### percent-wires — a network holds no other % line
=== text
