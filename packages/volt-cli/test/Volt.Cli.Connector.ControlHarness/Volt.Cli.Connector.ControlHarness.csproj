<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test-support console: runs the REAL ControlServer with a scripted ConnectorView, so the volt-control (TS)
       client can be driven against the actual C# control-plane wire in an e2e (not a mock). Not part of the product
       build; referenced only by packages/volt-control/test/e2e. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VoltControlHarness</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Volt.Cli.Connector.Core\Volt.Cli.Connector.Core.csproj" />
  </ItemGroup>

</Project>
