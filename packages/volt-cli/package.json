{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@volt/cli",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/he-man86/volt"
  },
  "description": "Volt CLI — the single C# toolchain: git-native PLC sync (volt.exe) + the in-IDE bridges (CODESYS/TwinCAT) over Windows named pipes, with shared Core; round-trips FBD/LD graphical bodies as network text. This package.json exists for the TS e2e parity suite (test/e2e).",
  "type": "module",
  "scripts": {
    "build": "dotnet build Volt.sln -c Release --nologo",
    "build:package": "powershell -File scripts/build-cli.ps1",
    "test": "bun test test/unit",
    "test:e2e": "bun test",
    "test:e2e:codesys": "VOLT_VENDOR=codesys bun test test/e2e",
    "test:e2e:twincat": "VOLT_VENDOR=twincat bun test test/e2e",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@volt/control": "workspace:*",
    "typescript": "catalog:"
  }
}
