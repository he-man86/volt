<Project>

  <!--
    Central package versions for the Volt toolchain.

    Every version below was hand-copied into two or three csprojs, so a bump was a multi-file edit that had to be
    done consistently by hand — and the one version that MUST not drift was among them.

    System.Text.Json 8.0.5 is load-bearing, not routine. The in-process CODESYS bridge is net48 and binds this
    assembly by exact identity; PipeHost installs an AssemblyResolve handler specifically so the host process can
    find it. Two projects declaring that version separately is one edit away from a bridge that loads in the IDE
    and then fails to deserialize. One declaration removes that failure mode.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Wire serialization. ONE declaration because the net48 in-proc CODESYS bridge loads this beside itself
         (see above); 10.0.x still ships netstandard2.0 and net462 assets, and PipeHost's resolver matches by
         SIMPLE NAME, not by version, so the bind survives the major. -->
    <PackageVersion Include="System.Text.Json" Version="10.0.12" />

    <!-- netstandard2.0 needs this for ValueTuple; net10.0 has it in the BCL. -->
    <PackageVersion Include="System.ValueTuple" Version="4.6.2" />

    <!-- The CODESYS start script's load path, offline (Volt.Ide.Codesys.Tests/StartScriptLoadTests): the SAME IronPython
         CODESYS SP21 runs scripts in (LacBinaries\GAC_MSIL\IronPython\2.7.12.0), with the standard library the script
         imports (os, shutil). Test-only. -->
    <PackageVersion Include="IronPython" Version="2.7.12" />
    <PackageVersion Include="IronPython.StdLib" Version="2.7.12" />

    <!-- Test tooling — one version across all three test projects. -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
  </ItemGroup>

</Project>
