control: an error        a := zz;                   -> 
      [Error] Cannot convert type 'Unknown type: 'zz'' to type 'BOOL'
      [Error] Identifier 'zz' not defined
control: plain chain     a := b := c;               -> CLEAN
control: S= alone        a S= c;                    -> CLEAN
control: R= alone        a R= c;                    -> CLEAN
:= then S=               a := b S= c;               -> CLEAN
:= then R=               a := b R= c;               -> CLEAN
S= then :=               a S= b := c;               -> CLEAN
S= then R=               a S= b R= c;               -> CLEAN
three targets            a := b S= d R= c;          -> CLEAN
S= with an expression    a := b S= c AND d;         -> CLEAN
done
