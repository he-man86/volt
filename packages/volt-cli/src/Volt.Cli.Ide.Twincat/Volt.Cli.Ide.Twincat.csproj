<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The TwinCAT integration: a standalone net8 worker exe the connector spawns. Holds the BeckhoffDriver
         (attaches to a running XAE over COM) + Program.cs, which serves that driver over the NAMED PIPE. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Volt.Cli.Ide.Twincat</RootNamespace>
    <AssemblyName>VoltBridgeTwincat</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Volt.Cli.Core\Volt.Cli.Core.csproj" />
    <ProjectReference Include="..\Volt.Cli.Transport\Volt.Cli.Transport.csproj" />
  </ItemGroup>
</Project>
