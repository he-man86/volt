<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- netstandard2.0 so it loads in the CODESYS in-proc net48 host too. Wires the pipe transport to the SAME
         Core services the HTTP host used — no IDE logic here. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Volt.Cli.Host</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Volt.Cli.Transport\Volt.Cli.Transport.csproj" />
    <!-- Core holds the transport-agnostic bridge logic (ST/PLCopen/VG, push/fetch/build services). -->
    <ProjectReference Include="..\Volt.Cli.Core\Volt.Cli.Core.csproj" />
  </ItemGroup>
</Project>
