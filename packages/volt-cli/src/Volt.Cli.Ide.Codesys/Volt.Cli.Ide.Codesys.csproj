<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The CODESYS in-proc entry point: a net48 library the IDE's IronPython loads by reflection (like the
         backup's Volt.Bridge.Codesys). Instantiates the REAL CodesysDriver and serves it over the NAMED PIPE. -->
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Volt.Cli.Ide.Codesys</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Volt.Cli.Host\Volt.Cli.Host.csproj" />
    <ProjectReference Include="..\Volt.Cli.Transport\Volt.Cli.Transport.csproj" />
    <!-- Reuse the REAL, shipping CODESYS driver from the backup (read-only reference; not a fork). -->
    <ProjectReference Include="..\..\..\volt-bridge\src\Volt.Bridge.Codesys\Volt.Bridge.Codesys.csproj" />
  </ItemGroup>
</Project>
