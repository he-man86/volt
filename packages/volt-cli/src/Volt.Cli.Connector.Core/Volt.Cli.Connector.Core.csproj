<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The connector's UI-FREE connection model — DetectedProject / IProjectSource / ConnectionManager and the
         pipe-backed vendor sources. Split out of the WinForms shell (Volt.Cli.Connector) so the model is testable
         without a UI and the vendor mechanism lives behind one interface. net8.0 (no -windows): pure logic + the
         pipe wire, no WinForms. Namespace stays `Volt.Cli.Connector` so the shell references it seamlessly. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Volt.Cli.Connector</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Volt.Cli.Transport\Volt.Cli.Transport.csproj" />
  </ItemGroup>
</Project>
