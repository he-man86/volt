<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The TwinCAT integration: a standalone net8 worker exe the connector spawns. Holds the BeckhoffDriver
         (attaches to a running XAE over COM) + Program.cs, which serves that driver over the NAMED PIPE. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Volt.Ide.Twincat</RootNamespace>
    <AssemblyName>VoltBridgeTwincat</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- The driver is internal-by-default and stays that way; its test project is the only consumer.
         Without this, TcItemArchive - the archive round-trip that RELOCATES an item, and so the one place
         a failed move can lose one - has no offline coverage at all. -->
    <InternalsVisibleTo Include="Volt.Ide.Twincat.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Volt.Engine.Host\Volt.Engine.Host.csproj" />
    <ProjectReference Include="..\Volt.Contracts\Volt.Contracts.csproj" />
    <ProjectReference Include="..\Volt.Engine\Volt.Engine.csproj" />
    <ProjectReference Include="..\Volt.Wire\Volt.Wire.csproj" />
  </ItemGroup>
</Project>
