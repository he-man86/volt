<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- netstandard2.0 so the SAME transport loads in CODESYS's net48 in-proc host, the net8 TwinCAT host, and
         the net8 CLI/tests — exactly like Volt.Engine. This is the wire that replaces the HTTP server. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Volt.Cli.Transport</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
</Project>
