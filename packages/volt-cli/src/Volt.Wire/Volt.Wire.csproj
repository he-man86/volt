<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- netstandard2.0 so the SAME transport loads in CODESYS's net48 in-proc host, the net8 TwinCAT host, and
         the net8 CLI/tests — exactly like Volt.Engine. This is the whole wire: NDJSON over a named pipe. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Volt.Wire</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Volt.Contracts\Volt.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Polyfills.cs" Link="Polyfills.cs" />
  </ItemGroup>
</Project>
