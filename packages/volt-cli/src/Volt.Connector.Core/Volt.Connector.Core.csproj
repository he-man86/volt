<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The connector's UI-FREE connection model — DetectedProject / IProjectSource / ConnectionManager and the
         pipe-backed vendor sources. Split out of the WinForms shell (Volt.Connector) so the model is testable
         without a UI and the vendor mechanism lives behind one interface. net10.0 (no -windows): pure logic + the
         pipe wire, no WinForms. Namespace stays `Volt.Connector` so the shell references it seamlessly. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Volt.Connector</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Volt.Contracts\Volt.Contracts.csproj" />
    <ProjectReference Include="..\Volt.Wire\Volt.Wire.csproj" />
    <!-- The pid probe spawns a subprocess, so `TwincatFleet`'s composition needs one seam to be driveable. -->
    <InternalsVisibleTo Include="Volt.Connector.Tests" />
    <!-- The tray shell drives the Updater (internal), which lives here so the test project — which cannot reference
         the net10.0-windows WinForms shell — can serve it a release feed (openspec installer-rebuild 1.1). -->
    <InternalsVisibleTo Include="VoltConnector" />
  </ItemGroup>
</Project>
