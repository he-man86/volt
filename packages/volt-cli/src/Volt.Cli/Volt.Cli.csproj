<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Volt.Cli</RootNamespace>
    <AssemblyName>volt</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Phase 2: evaluate NativeAOT/ReadyToRun cold-start — `volt status` is editor-polled (openspec
         unify-bridge-cli-language task 2.1). -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Volt.Cli.Sync\Volt.Cli.Sync.csproj" />
    <ProjectReference Include="..\Volt.Cli.Transport\Volt.Cli.Transport.csproj" />
    <!-- Reuse Core's wire DTOs so the CLI's pipe client uses the SAME contract as the host (kills the TS zod). -->
    <ProjectReference Include="..\..\..\volt-bridge\src\Volt.Bridge.Core\Volt.Bridge.Core.csproj" />
  </ItemGroup>
</Project>
