<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The single user-facing Volt app: a Windows system-tray supervisor that owns
         every vendor bridge. Bridges run as headless worker PROCESSES it spawns
         (external-attach vendors) or as in-IDE loads it launches (CODESYS). One app,
         one tray icon, many invisible workers. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>VoltConnector</AssemblyName>
    <!-- Deliberately NO reference to any vendor bridge or Volt.Cli.Core: the connector only speaks the WIRE
         (the `health` op over the named pipe) to its workers, so it survives however different the vendor internals
         get (TwinCAT COM vs Siemens Openness vs Allen-Bradley LDSDK). Volt.Cli.Transport is the pipe wire only —
         no vendor code — so referencing it keeps that decoupling. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\volt-cli\src\Volt.Cli.Transport\Volt.Cli.Transport.csproj" />
  </ItemGroup>
  <!-- No update/installer framework dependency: the one installer is Inno Setup (installer/Volt.iss), and the
       connector hosts a dependency-free updater (Updater.cs polls GitHub + re-runs the Setup) + the env hooks
       (VoltEnv.cs). System.Text.Json is part of net8 — nothing else to reference. -->
</Project>
