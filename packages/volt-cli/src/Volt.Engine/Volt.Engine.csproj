<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- netstandard2.0 so this one assembly loads in BOTH CODESYS's net48 IronPython
         host and the net8 TwinCAT/test hosts. No vendor references; pure transform +
         sync + protocol + the IDE-driver interface. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Volt.Engine</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Volt.Engine.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="System.ValueTuple" />
  </ItemGroup>
  <ItemGroup>
    <!-- Wire/BridgePipeHost serves Core's services over the pipe (PipeServer). Transport is the wire-only layer. -->
    <ProjectReference Include="..\Volt.Contracts\Volt.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Polyfills.cs" Link="Polyfills.cs" />
  </ItemGroup>
</Project>
