{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/volt-lsp-codesys",
  "version": "1.15.11",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/opencode"
  },
  "description": "TypeScript-native Language Server for IEC 61131-3 Structured Text, with a first-class VG (Volt Graphical) sublanguage for FBD/LD bodies. Navigation + diagnostics + completion + hover + signature help + semantic tokens, driven by an embedded CODESYS language reference. ST and VG are distinct languages analyzed side by side (CFC/SFC are read-only). Type-checking and code-gen remain the IDE's job.",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "bun": "./src/tests/conformance/index.ts",
      "default": "./dist/tests/conformance/index.js"
    }
  },
  "bin": {
    "volt-lsp-codesys": "./dist/bin.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsgo --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
