INTERFACE IPositionable
EXTENDS __SYSTEM.IQueryInterface

// Move to absolute position with profile data
METHOD PUBLIC MoveAbs : BOOL
VAR_INPUT
	Data : PositionWithProfileType;
END_VAR
END_METHOD

// Move to absolute position
METHOD PUBLIC MoveAbsPos : BOOL
VAR_INPUT
	position				: REAL;
END_VAR
END_METHOD

// Move to relative position with profile data
METHOD PUBLIC MoveRel : BOOL
VAR_INPUT
	Data : PositionWithProfileType;
END_VAR
END_METHOD

// Move to relative position
METHOD PUBLIC MoveRelPos : BOOL
VAR_INPUT
	distance	: REAL;
END_VAR
END_METHOD

// Prepare vel, acc and dec values for later movements
METHOD PUBLIC SetMovementProfileData
VAR_INPUT
	Data		: ProfileType;
END_VAR
END_METHOD

// Prepare vel, acc and dec values for later movements
METHOD PUBLIC SetMovementProfileSeparate
VAR_INPUT
	rVel		: REAL;		// Velocity in %
	rAcc		: REAL;		// Acc in %
	rDec		: REAL;		// Dec in %
END_VAR
END_METHOD

END_INTERFACE
