END_METHOD

METHOD ProgramReset
iProgChangeState	:= 0;
Q.uiRsr_pns			:= 0;
Q.xProdStart		:= FALSE;
Q.xPnsStrobe		:= FALSE;
xCycleStop			:= TRUE;
ProgramSelector		:= 0;
ComBrinkFanuc		:= 0;
END_METHOD

METHOD StartMainProgram : BOOL
VAR_INPUT
	iProgNumber	: UINT;
END_VAR
VAR_INST
	T_TimeOut	: BTON;
END_VAR
// Timeout while starting the Main program
IF T_TimeOut.Set(NOT I.xPrgRunning, 3) THEN
	T_TimeOut.Reset();
	ProgramReset();
END_IF

CASE iProgChangeState OF
0:
	IF I.xCmdEnabled AND NOT I.xSnack THEN									// Check if external commands are allowed
		ProgramSelector		:= 0;
		Q.uiRsr_pns		:= iProgNumber;	// Write the new program number to Fanuc
		Q.xProdStart		:= TRUE;
		xCycleStop			:= TRUE;
		iProgChangeState	:= iProgChangeState + 10;
	END_IF

10: // Stop all active programs first
	IF NOT xCycleStop THEN
		iProgChangeState	:= iProgChangeState + 10;
	END_IF

20:
	Q.xPnsStrobe			:= TRUE;						// Tell Fanuc that the program number should be changed
	IF I.uiAck_sno = Q.uiRsr_pns AND I.xSnack THEN						// Check if the new program number matches the requested number
		iProgChangeState	:= iProgChangeState + 10;
	END_IF

30:
	Q.xProdStart			:= FALSE;						// Start the new program (on falling edge)
	IF I.xPrgRunning THEN
		T_TimeOut.Reset();
		Q.xPnsStrobe		:= FALSE;
		StartMainProgram	:= TRUE;
		iProgChangeState	:= 0;
	END_IF
END_CASE
END_METHOD

METHOD WriteRegisters : BOOL
VAR
END_VAR
VAR_INST
	iWriteRegisterState	: INT;
	iCheckReg			: INT;
	iCurrentReg			: INT;
	rVal				: REAL;
END_VAR
CASE iWriteRegisterState OF
0:
	REPEAT
		iCurrentReg := iCurrentReg + 1;
		iCurrentReg := SEL(iCurrentReg<iMinNoRegisters, SEL(iCurrentReg>iMaxNoRegisters, iCurrentReg, iMinNoRegisters), iMinNoRegisters);
		IF xCheckWriteReg THEN
			xCheckWriteReg R= iCheckReg = iCurrentReg;
		ELSE
			iCheckReg := iCurrentReg;
		END_IF
	UNTIL
		FanucRegisters[iCurrentReg].xEnabled OR iCurrentReg = iMaxNoRegisters			//If no register is used jump out of loop
	END_REPEAT

	IF	FanucRegisters[iCurrentReg].rValue < 2000000
	AND FanucRegisters[iCurrentReg].xEnabled
	THEN
		iWriteRegisterState := iWriteRegisterState + 10;
	END_IF

10:
	IF NOT I.xWriteRegDone THEN
		rVal					:= ABS(FanucRegisters[iCurrentReg].rValue * iFactor);	// Scale absolute value
		Q.uiRegChangeHigh		:= TO_UINT(TRUNC(rVal / 65536));						// High integer with sign bit
		Q.uiRegChangeHigh.15	:= FanucRegisters[iCurrentReg].rValue >= 0;				// Highest bit of the high integer indicates a positive (true) or negative (false) value
		Q.uiRegChangeLow		:= TO_UINT(TO_UDINT(rVal) MOD 65536);					// Low integer
		Q.uiRegChangeFactor		:= TO_UINT(iFactor);
		Q.uiRegChangeNumber		:= TO_UINT(iCurrentReg);
		Q.xWriteReg				:= TRUE;

		iWriteRegisterState	:= iWriteRegisterState + 10;
	END_IF

20:
	IF I.xWriteRegDone THEN
		Q.xWriteReg			:= FALSE;
		iWriteRegisterState	:= 0;
	END_IF
END_CASE
END_METHOD

{attribute 'monitoring':='call'}
PROPERTY PUBLIC ComBrinkFanuc : UINT
SET
uiComBrinkFanuc := ComBrinkFanuc;
END_SET
END_PROPERTY

{attribute 'monitoring':='call'}
PROPERTY PUBLIC ComFanucBrink : UINT
GET
PUBLIC
VAR
END_VAR
ComFanucBrink := uiComFanucBrink;
END_GET
END_PROPERTY

{attribute 'monitoring':='call'}
PROPERTY PUBLIC GateAllowedToOpen : BOOL
GET
PUBLIC
VAR
END_VAR
GateAllowedToOpen	:= I.xAtServicePos		// Fanuc is at service position
					OR NOT I.xInAutoMode	// Fanuc cannot move to service position when not in auto
					OR I.xTpEnabled;		// Fanuc cannot move to service position when TP is enabled
END_GET
END_PROPERTY

{attribute 'monitoring':='call'}
PROPERTY ManualFunction : UINT
GET
VAR_INST
	Tr_ManualFunction : R_TRIG;
END_VAR
Tr_ManualFunction(CLK := uiManualFunction > 0);
ManualFunction := SEL(I.xTpEnabled AND Tr_ManualFunction.Q, 0, uiManualFunction);
END_GET
END_PROPERTY

{attribute 'monitoring':='call'}
PROPERTY PUBLIC ProgramRunning : UINT
GET
ProgramRunning := uiProgramRunning;
END_GET
END_PROPERTY

{attribute 'monitoring':='call'}
PROPERTY PUBLIC ProgramSelector : UINT
GET
ProgramSelector := uiProgramSelector := SEL(ProgramRunning = uiProgramSelector, uiProgramSelector, 0);
END_GET
SET
uiProgramSelector := ProgramSelector;
END_SET
END_PROPERTY
