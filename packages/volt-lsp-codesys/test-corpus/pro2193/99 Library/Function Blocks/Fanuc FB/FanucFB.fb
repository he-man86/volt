{attribute 'symbol' := 'none'}
FUNCTION_BLOCK FanucFB
VAR_INPUT
	ModuleHandler		: L_IMHP.L_IMHP_IModuleHandler;
	arInputs1			: ARRAY[0..7] OF UINT;
	arInputs2			: ARRAY[0..7] OF UINT;
	arInputs3			: ARRAY[0..7] OF UINT;
	arInputs4			: ARRAY[0..7] OF UINT;
	FanucRegisters		: ARRAY[iMinNoRegisters..iMaxNoRegisters] OF Fanuc_Register_Type;
	I					: Fanuc_Input_Type;
	Q					: Fanuc_Output_Type;
	xCheckWriteReg		: BOOL;
	xGateIsClosed		: BOOL;
	xExternalReset		: BOOL;
	SystemState			: Pack_ML.State;	// Information about the current state of the system
	xDisableFanuc		: BOOL;
END_VAR
VAR_OUTPUT
	arOutputs1			: ARRAY[0..7] OF UINT;
	arOutputs2			: ARRAY[0..7] OF UINT;
	arOutputs3			: ARRAY[0..7] OF UINT;
	arOutputs4			: ARRAY[0..7] OF UINT;
	arOutputs5			: ARRAY[0..7] OF UINT;
	arOutputs6			: ARRAY[0..7] OF UINT;
	arOutputs7			: ARRAY[0..7] OF UINT;
	arOutputs8			: ARRAY[0..7] OF UINT;
END_VAR
VAR
	iProgChangeState	: INT;
	xCycleStop			: BOOL;
	uiComFanucBrink		: UINT;
	uiComBrinkFanuc		: UINT;
	uiProgramRunning	: UINT;
	uiProgramSelector	: UINT;
	uiManualFunction	: UINT;
END_VAR
VAR CONSTANT
	iMinNoRegisters		: INT := 100;
	iMaxNoRegisters		: INT := 500;
	iFactor				: INT := 1000;
END_VAR

Cyclic();
Alarms();
IoMapping();
WriteRegisters();

END_FUNCTION_BLOCK

METHOD PROTECTED Alarms
VAR_INST
	SetError					: ARRAY[1..7] OF SetErrorFB;
	Blinker						: BLINK;
END_VAR
SetError[1](
	moduleHandler	:= ModuleHandler,
	textRefId		:= FanucFB_Errors,
	alarmCondition	:= I.xFault AND (NOT I.xFenceOpen OR xGateIsClosed) AND NOT xDisableFanuc,
	alarmDelay		:= 2.0,
	errorId			:= 1,		// Fanuc error signal
	severity		:= enumErrorSeverity.Fault,
	reaction		:= enumErrorReaction.No_reaction,
	active			=> );

SetError[2](
	moduleHandler	:= ModuleHandler,
	textRefId		:= FanucFB_Errors,
	alarmCondition	:= I.xBattAlarm,
	alarmDelay		:= 2.0,
	errorId			:= 2,		// Fanuc battery alarm
	severity		:= enumErrorSeverity.Fault,
	reaction		:= enumErrorReaction.No_reaction,
	active			=> );

SetError[3](
	moduleHandler	:= ModuleHandler,
	textRefId		:= FanucFB_Errors,
	alarmCondition	:= I.xTpEnabled AND NOT xDisableFanuc,
	alarmDelay		:= 2.0,
	errorId			:= 3,		// Fanuc TP enabled
	severity		:= enumErrorSeverity.Fault,
	reaction		:= enumErrorReaction.EndCycle,
	active			=> );

SetError[4](
	moduleHandler	:= ModuleHandler,
	textRefId		:= FanucFB_Errors,
	alarmCondition	:= NOT I.xInAutoMode AND NOT xDisableFanuc,
	alarmDelay		:= 2.0,
	errorId			:= 4,		// Fanuc not in auto mode
	severity		:= enumErrorSeverity.Fault,
	reaction		:= enumErrorReaction.No_reaction,
	active			=> );

SetError[5](
	moduleHandler	:= ModuleHandler,
	textRefId		:= FanucFB_Errors,
	alarmCondition	:= I.xStepFunctionOn AND NOT I.xTpEnabled,
	alarmDelay		:= 2.0,
	errorId			:= 5,		// Fanuc step function is on
	severity		:= enumErrorSeverity.Fault,
	reaction		:= enumErrorReaction.No_reaction,
	active			=> );

SetError[6](
	moduleHandler	:= ModuleHandler,
	textRefId		:= FanucFB_Errors,
	alarmCondition	:= NOT I.xWriteRegDone AND Q.xWriteReg AND NOT xDisableFanuc,
	alarmDelay		:= 10.0,
	errorId			:= 6,		// Fanuc write register error
	severity		:= enumErrorSeverity.Fault,
	reaction		:= enumErrorReaction.No_reaction,
	active			=> );

SetError[7](
	moduleHandler	:= ModuleHandler,
	textRefId		:= FanucFB_Errors,
	alarmCondition	:= I.xIOSimulated AND NOT xDisableFanuc,
	alarmDelay		:= 2.0,
	errorId			:= 7,		// Fanuc IO is simulated
	severity		:= enumErrorSeverity.Fault,
	reaction		:= enumErrorReaction.No_reaction,
	active			=> );

Blinker(		ENABLE := TRUE,	TIMELOW := T#200MS,		TIMEHIGH := T#200MS);

// I.xFault is reset on falling trigger of Q.xFaultReset
Q.xFaultReset	:= Blinker.OUT AND (xExternalReset OR (I.xFenceOpen AND xGateIsClosed));

xCycleStop		R= NOT I.xPrgRunning AND NOT I.xPrgPaused;
Q.xCycleStop	:= Blinker.OUT AND xCycleStop;
END_METHOD

METHOD PROTECTED Cyclic
IF SystemState = PACK_ML.State.Idle THEN
	Q.xStart := NOT (I.xPrgPaused AND NOT I.xFault AND NOT I.xTpEnabled); // Restart paused Fanuc program
END_IF
END_METHOD

METHOD Init : BOOL
xCycleStop		S= I.xPrgRunning OR I.xPrgPaused;
Q.xIMSTP		:= TRUE;
Q.xSFSPD		:= TRUE;
Q.xHold			:= TRUE;
Q.xEnable		:= TRUE;
Q.xFaultReset	:= TRUE;
Init			S= (I.xCmdEnabled AND NOT xCycleStop) OR I.xTpEnabled;
END_METHOD

METHOD PRIVATE IoMapping
VAR_INPUT
END_VAR
(*--------------------------------------------------------------------------------------------
									- INPUTS -
--------------------------------------------------------------------------------------------*)

// User inputs (Fanuc -> Brink)
I.xCmdEnabled			:= arInputs1[0].0;
I.xSystemReady			:= arInputs1[0].1;
