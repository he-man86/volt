		'IMM Euromap Reject',		// 1
		'Cam 1 Reject',				// 2
		'Cam 2 Reject',				// 3
		'Cam 3 Reject',				// 4
		'Cam 4 Reject',				// 5
		'Cam 5 Reject',				// 6
		'Cam 6 Reject',				// 7
		'Cam 7 Reject'				// 8
	];

	{attribute 'symbol' := 'none'}	cavityAliases				: ARRAY[GVL_Constants.CavityStartIndex..GVL_Constants.CavityEndIndex] OF STRING(20);


	// Generated instance path of persistent variable
	CassetteAdjustments.Data: ARRAY [1..CassetteAdjustments.usiNumberOfUnits] OF ARRAY [enumDrawer.Upper..enumDrawer.Lower, 1..GVL_Constants_Magazine.MaxCassettes] OF CassettePosition;
