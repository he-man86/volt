{attribute 'qualified_only'}
{attribute 'symbol' := 'readwrite'}
VAR_GLOBAL PERSISTENT RETAIN
	RecipeVars						: RetainedVarsInRecipeType;
	BrinkRecipeVars					: RetainedVarsInBrinkRecipeType;

	disableBuzzer					: BOOL;					// Permanently disable the buzzer output


	// SUBRANGE not supported by VisiWinNet :(
	usiGlobalSERSpeed				: USINT(*(1..100)*) := 50;	// Limit speed of all drives in the SER robot (0 to 100%)
	usiGlobalBFUSpeed				: USINT(*(1..100)*) := 50;	// Limit speed of all drives in the BFU robot (0 to 100%)


	DisableVacuumWithAirButton		: BOOL := FALSE;
	DisableVacuumPump2				: BOOL;

	{attribute 'symbol' := 'none'}	vacuumPumpRunningTime		: UDINT;				// Total time the vacuumpump has been running.
	{attribute 'symbol' := 'none'}	vacuumPumpNumberOfStarts	: UDINT;				// Total number of times the vacuumpump has been started.
	{attribute 'symbol' := 'none'}	Statistics					: ARRAY[1..ProductionStatsFB.NumberOfStatisticSets] OF ProductionStatsType;

	rejectReasonDescriptions		: ARRAY[1..GVL_Constants.MaxRejectReasonsTotal] OF STRING(40) :=
