// Commands specific for a Magazine Unit
INTERFACE IConveyor_Shared_Stacking_Commands
EXTENDS IConveyor_Shared_Commands

METHOD IncreaseStackIndex
VAR_INPUT
	products : ARRAY[1..GVL_Constants.ZUnitProductsForConveyor] OF ProductType;
END_VAR
END_METHOD

// The area under the stacking unit is free. The Z Unit is allowed to begin a new stack.
{attribute 'monitoring':='call'}
PROPERTY HighestStackIndex : UINT
END_PROPERTY

// The area under the stacking unit is free. The Z Unit is allowed to begin a new stack.
{attribute 'monitoring':='call'}
PROPERTY StackingAllowed : BOOL
END_PROPERTY

END_INTERFACE
