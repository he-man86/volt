	DrawerPlate[DrawerId].CassetteDefinition[8].AdjustmentValve[enumMotorsType.X1]		:= 4;
	DrawerPlate[DrawerId].CassetteDefinition[8].AdjustmentValve[enumMotorsType.X2]		:= 6;
	DrawerPlate[DrawerId].CassetteDefinition[8].AdjustmentValve[enumMotorsType.Y]		:= 5;
	DrawerPlate[DrawerId].CassetteDefinition[8].EnableValve							:= 4;

	DrawerPlate[DrawerId].CassetteDefinition[9].CassetteId							:= 9;
	DrawerPlate[DrawerId].CassetteDefinition[9].CavityId							:= 9;
	DrawerPlate[DrawerId].CassetteDefinition[9].LabelId								:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[9].LabelType							:= enumLabelType.Wrap;
	DrawerPlate[DrawerId].CassetteDefinition[9].LabelOrientation					:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[9].CassetteOrientation					:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[9].AdjustmentValve[enumMotorsType.X1]		:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[9].AdjustmentValve[enumMotorsType.X2]		:= 3;
	DrawerPlate[DrawerId].CassetteDefinition[9].AdjustmentValve[enumMotorsType.Y]		:= 2;
	DrawerPlate[DrawerId].CassetteDefinition[9].EnableValve							:= 5;

	DrawerPlate[DrawerId].CassetteDefinition[10].CassetteId							:= 10;
	DrawerPlate[DrawerId].CassetteDefinition[10].CavityId							:= 10;
	DrawerPlate[DrawerId].CassetteDefinition[10].LabelId							:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[10].LabelType							:= enumLabelType.Wrap;
	DrawerPlate[DrawerId].CassetteDefinition[10].LabelOrientation					:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[10].CassetteOrientation				:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[10].AdjustmentValve[enumMotorsType.X1]		:= 4;
	DrawerPlate[DrawerId].CassetteDefinition[10].AdjustmentValve[enumMotorsType.X2]		:= 6;
	DrawerPlate[DrawerId].CassetteDefinition[10].AdjustmentValve[enumMotorsType.Y]		:= 5;
	DrawerPlate[DrawerId].CassetteDefinition[10].EnableValve						:= 5;

	DrawerPlate[DrawerId].CassetteDefinition[11].CassetteId							:= 11;
	DrawerPlate[DrawerId].CassetteDefinition[11].CavityId							:= 11;
	DrawerPlate[DrawerId].CassetteDefinition[11].LabelId							:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[11].LabelType							:= enumLabelType.Wrap;
	DrawerPlate[DrawerId].CassetteDefinition[11].LabelOrientation					:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[11].CassetteOrientation				:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[11].AdjustmentValve[enumMotorsType.X1]		:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[11].AdjustmentValve[enumMotorsType.X2]		:= 3;
	DrawerPlate[DrawerId].CassetteDefinition[11].AdjustmentValve[enumMotorsType.Y]		:= 2;
	DrawerPlate[DrawerId].CassetteDefinition[11].EnableValve						:= 6;

	DrawerPlate[DrawerId].CassetteDefinition[12].CassetteId							:= 12;
	DrawerPlate[DrawerId].CassetteDefinition[12].CavityId							:= 12;
	DrawerPlate[DrawerId].CassetteDefinition[12].LabelId							:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[12].LabelType							:= enumLabelType.Wrap;
	DrawerPlate[DrawerId].CassetteDefinition[12].LabelOrientation					:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[12].CassetteOrientation				:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[12].AdjustmentValve[enumMotorsType.X1]		:= 4;
	DrawerPlate[DrawerId].CassetteDefinition[12].AdjustmentValve[enumMotorsType.X2]		:= 6;
	DrawerPlate[DrawerId].CassetteDefinition[12].AdjustmentValve[enumMotorsType.Y]		:= 5;
	DrawerPlate[DrawerId].CassetteDefinition[12].EnableValve						:= 6;

	FOR i := 1 TO DrawerPlate[DrawerId].NumberOfCassettes DO

		FOR j := 1 TO UPPER_BOUND(GVL_Constants_Magazine.OrientationTable, 1) DO
			FOR k := enumMovementType.Up TO enumMovementType.Left DO
				IF	(GVL_Constants_Magazine.OrientationTable[j].CassetteOrientation = DrawerPlate[DrawerId].CassetteDefinition[i].CassetteOrientation)
				AND (GVL_Constants_Magazine.OrientationTable[j].LabelOrientation = DrawerPlate[DrawerId].CassetteDefinition[i].LabelOrientation)
				AND (GVL_Constants_Magazine.OrientationTable[j].Movement = k)
				THEN
					DrawerPlate[DrawerId].CassetteDefinition[i].MotorsForMovements[k]		:= GVL_Constants_Magazine.OrientationTable[j].Motor;
					DrawerPlate[DrawerId].CassetteDefinition[i].DirectionsForMovements[k]	:= GVL_Constants_Magazine.OrientationTable[j].Direction;
					IF DrawerPlate[DrawerId].InvertDirectionsForXRaxis
					AND (k = enumMovementType.Up OR k = enumMovementType.Down)
					THEN
						DrawerPlate[DrawerId].CassetteDefinition[i].DirectionsForMovements[k] := GetOppositeDirection(DrawerPlate[DrawerId].CassetteDefinition[i].DirectionsForMovements[k]);
					END_IF
				END_IF
			END_FOR
		END_FOR

	END_FOR

END_FOR
END_METHOD

METHOD PUBLIC CopyActualPositionsToData : BOOL
VAR_INPUT
END_VAR
%FOLDER Commands
Data := ActualCassettePosition;

CopyActualPositionsToData := TRUE;
END_METHOD

METHOD PROTECTED Cyclic
VAR
	drawerId			: enumDrawer;
END_VAR
VAR_INST
	lastSelectedDrawer	: enumDrawer;
END_VAR
JsonBuilder.executeCassetteJson[instanceNo] S= Visu.SelectedDrawer <> lastSelectedDrawer;
lastSelectedDrawer := Visu.SelectedDrawer;

// Always rebuild the json for the visu
IF JsonTimer.Set(NOT JsonBuilder.executeCassetteJson[instanceNo], 1) THEN
	JsonBuilder.executeCassetteJson[instanceNo]	:= TRUE;
	JsonTimer.Reset();
END_IF

CASE activeDrawer OF
	enumDrawer.NoDrawer:					RETURN;
	enumDrawer.Upper..enumDrawer.Lower:		;
	ELSE									LogPlc.Error('Invalid activeDrawer parameter'); RETURN;
END_CASE

IF ConfigError THEN
	LogPlc.Error('The CheckConfig() method detected an error in the configuration');
	RETURN;
END_IF

// Call the cassetteFb's
FOR drawerId := enumDrawer.Upper TO enumDrawer.Lower DO
	FOR CassetteId := 1 TO GVL_Constants_Magazine.MaxCassettes DO
		DrawerPlate[drawerId].CassetteData[CassetteId](
			_ActualPosition := ActualCassettePosition[drawerId, CassetteId],
			_TargetPosition := TargetCassettePosition[drawerId, CassetteId],
			_SwitchCount	:= SwitchCountCassette[drawerId, CassetteId]
		);
	END_FOR
END_FOR

IF Visu.SelectedDrawer = enumDrawer.NoDrawer THEN
	Visu.SelectedDrawer := activeDrawer;
END_IF

ManualFunctions();
Execute();
UpdateCassetteMotorPositions();
END_METHOD

// Command to reset the module (Statemachine to zero state) in case of E-Stop
METHOD PUBLIC EStop : BOOL	// Returns true when drives are in standstill
VAR
	i		: USINT;
END_VAR
%FOLDER Commands
FOR i := 1 TO GVL_Constants_Magazine.MaxEnableValves DO
	Enable[i].Reset();
END_FOR

FOR i := 1 TO GVL_Constants_Magazine.MaxAdjustValves DO
	Adjust[i].Reset();
END_FOR

CASE activeDrawer OF
	enumDrawer.NoDrawer:;
	enumDrawer.Upper..enumDrawer.Lower:		
		StopAdjustingAllCassettes();
END_CASE

Visu.AllCassetteFunction 	:= enumCassetteFunctionAll.None;
Visu.SingleSelectedFunction := enumCassetteFunctionSingle.None;

EStop := SUPER^.EStop();
END_METHOD

// Returns an empty array of MovementProfiles
METHOD PRIVATE EmptyProfileArray : ARRAY[1..GVL_Constants_Magazine.MaxCassettes] OF MovementProfile
%FOLDER Private
END_METHOD

// Manages the multi-step adjustment process for all cassettes in the connected drawer using a state machine.
// Includes homing checks, profile collection, parallel adjustment validation, signal triggering, and position updates.
// Transitions through states to coordinate safe and synchronized cassette movements based on adjustment needs.
METHOD PRIVATE Execute : BOOL
VAR_INST
	State				: USINT;
END_VAR
VAR
	i,j					: USINT;
	_Enable				: BOOL;
	_AdjustX1			: BOOL;
	_AdjustX2			: BOOL;
	_AdjustY			: BOOL;
	LimitActivated		: BOOL;
	result				: BOOL;
	actDrawerPlate		: REFERENCE TO DrawerPlateType;
	ProfileTemp			: MovementProfile;
END_VAR
actDrawerPlate		REF= DrawerPlate[activeDrawer];

CASE State OF
	0:
		// Check the homing states of the cassettes
		FOR i := 1 TO actDrawerPlate.NumberOfCassettes DO
			CheckHomingState(actDrawerPlate.CassetteData[i]);
		END_FOR

		// Check if any adjustment is needed
		IF AnyAdjustmentNeeded AND airPressureOk THEN
			Profiles			:= EmptyProfileArray();
			ProfilesToExecute	:= EmptyProfileArray();
			State				:= 10;
		END_IF

	10:
		// Collect profiles of all cassettes that need adjustment
		FOR i := 1 TO actDrawerPlate.NumberOfCassettes DO
			IF actDrawerPlate.CassetteData[i].AdjustmentNeeded THEN
				// Add the profile for the cassette to the profiles array
				ProfileTemp	:= actDrawerPlate.CassetteData[i].GetAdjustmentProfile(activeDrawer, i);
				AddToProfileArray(ProfileTemp, Profiles);
			END_IF
		END_FOR

		// Check which cassettes can be adjusted together
		AddToProfileArray(Profiles[1], ProfilesToExecute);

		FOR i := 2 TO actDrawerPlate.NumberOfCassettes DO
			IF Profiles[i].Cassette = 0 THEN
				EXIT;
			END_IF
			result := TRUE;
			// Compare with all profiles in the execution array and add to execution array when possible
			FOR j := 1 TO i - 1 DO
				IF NOT ParallelAdjustmentPossible(Profiles[j], Profiles[i]) THEN
					result := FALSE;
					EXIT;
				END_IF
			END_FOR
			IF result OR AllCassettesHoming THEN
				AddToProfileArray(Profiles[i], ProfilesToExecute);
			END_IF
		END_FOR

		Increment.AnyInt(State, 10);

	20:	// Do the adjustments
		IF AdjustOneStep(
				Direction	:= ProfilesToExecute[1].Direction,
				Motors		:= ProfilesToExecute[1].Motors,
				Enable		=> _Enable,
				AdjustX1	=> _AdjustX1,
				AdjustX2	=> _AdjustX2,
				AdjustY		=> _AdjustY
			)
		THEN
			Increment.AnyInt(State, 10);
		END_IF

		FOR i := 1 TO actDrawerPlate.NumberOfCassettes DO
			IF ProfilesToExecute[i].Cassette = 0 THEN
				EXIT;
			END_IF

			Enable[actDrawerPlate.CassetteDefinition[ProfilesToExecute[i].Cassette].EnableValve].SetOrReset(_Enable);
			Adjust[actDrawerPlate.CassetteDefinition[ProfilesToExecute[i].Cassette].AdjustmentValve[enumMotorsType.X1]].SetOrReset(_AdjustX1);
			Adjust[actDrawerPlate.CassetteDefinition[ProfilesToExecute[i].Cassette].AdjustmentValve[enumMotorsType.X2]].SetOrReset(_AdjustX2);
			Adjust[actDrawerPlate.CassetteDefinition[ProfilesToExecute[i].Cassette].AdjustmentValve[enumMotorsType.Y]].SetOrReset(_AdjustY);
		END_FOR

	30: // Update cassette position, decrement Steps and check if more steps are needed
		FOR i := 1 TO actDrawerPlate.NumberOfCassettes DO
			IF ProfilesToExecute[i].Cassette = 0 THEN
				EXIT;
			END_IF

			// Check if cassette came to a limit while moving
			LimitActivated		S= LimitActiveForAdjustment(
										Drawer		:= ProfilesToExecute[i].Drawer,
										Cassette	:= ProfilesToExecute[i].Cassette,
										Adjustment	:= ProfilesToExecute[i].Motors,
										Direction	:= ProfilesToExecute[i].Direction);
		END_FOR
		State	:= 0;
END_CASE
END_METHOD

// Returns the cassetteId for the given cavity/label combination
METHOD PRIVATE GetCassetteNumber : USINT
VAR_INPUT
	Cavity		: USINT;
	Label		: USINT;
END_VAR
VAR
	CassetteId	: USINT;
END_VAR
%FOLDER Private
FOR CassetteId := 1 TO DrawerPlate[1].NumberOfCassettes DO
	IF DrawerPlate[1].CassetteDefinition[CassetteId].CavityId = Cavity AND DrawerPlate[1].CassetteDefinition[CassetteId].LabelId = Label THEN
		GetCassetteNumber := CassetteId;
		EXIT;
	END_IF
END_FOR
END_METHOD

// Inverts the given direction positive to negative and vice versa
METHOD PRIVATE GetOppositeDirection : enumDirection
VAR_INPUT
	Direction : enumDirection;
END_VAR
%FOLDER Private
GetOppositeDirection := SEL(Direction = enumDirection.Negative, enumDirection.Negative, enumDirection.Positive);
END_METHOD

// Defines position changes for each homing step of the cassette axes (X1, X2, Y).
// Each step corresponds to a specific movement pattern required for proper alignment.
// Values are assigned based on the current homing state to guide the cassette through its sequence.
METHOD PRIVATE GetPositionChangeForHomingStep : CassettePosition
VAR_INPUT
	HomingState	: enumCassetteHomingState;
END_VAR
%FOLDER Private
CASE HomingState OF
	enumCassetteHomingState.HomingStep1:
		GetPositionChangeForHomingStep.X1	:= -6;
		GetPositionChangeForHomingStep.X2	:= -6;
		GetPositionChangeForHomingStep.Y	:= 0;

	enumCassetteHomingState.HomingStep2:
		GetPositionChangeForHomingStep.X1	:= 0;
		GetPositionChangeForHomingStep.X2	:= 0;
		GetPositionChangeForHomingStep.Y	:= 100;

	enumCassetteHomingState.HomingStep3:
		GetPositionChangeForHomingStep.X1	:= 100;
		GetPositionChangeForHomingStep.X2	:= 100;
		GetPositionChangeForHomingStep.Y	:= 0;

	enumCassetteHomingState.HomingStep4:
		GetPositionChangeForHomingStep.X1	:= -3;
		GetPositionChangeForHomingStep.X2	:= -3;
		GetPositionChangeForHomingStep.Y	:= 0;

	enumCassetteHomingState.HomingStep5:
		GetPositionChangeForHomingStep.X1	:= 0;
		GetPositionChangeForHomingStep.X2	:= 0;
		GetPositionChangeForHomingStep.Y	:= 6;
END_CASE
END_METHOD

METHOD PROTECTED Initialize
SUPER^.Initialize();

TaskDisableWatchdog();		// Disable the watchdog for this cycle, because Config() call takes about 1 ms.
Config();

ConfigError						:= NOT CheckConfig();

Visu.SingleSelectedFunction		:= enumCassetteFunctionSingle.None;
Visu.AllCassetteFunction		:= enumCassetteFunctionAll.None;
END_METHOD

METHOD PRIVATE InitializeAllCassettes : BOOL
VAR_INPUT
	StopHoming	: BOOL;
END_VAR
VAR
	i			: USINT;
END_VAR
VAR_INST
	localState	: USINT;
END_VAR
%FOLDER Private
CASE localState OF
	0:
		FOR i := 1 TO DrawerPlate[activeDrawer].NumberOfCassettes DO
			DrawerPlate[activeDrawer].CassetteData[i].StartHoming();
		END_FOR
		IF AllCassettesHoming THEN
			localState	:= 1;
		END_IF

	1:
		IF AllCassettesHomed OR StopHoming THEN
			localstate := 0;
			InitializeAllCassettes := NOT StopHoming;
		END_IF
END_CASE
END_METHOD

METHOD PRIVATE InitializeSingleCassette : BOOL
VAR_INPUT
	CassetteId	: USINT;
END_VAR
VAR_INST
	localState	: USINT;
END_VAR
%FOLDER Private
CASE localState OF
	0:
		DrawerPlate[activeDrawer].CassetteData[CassetteId].StartHoming();
		IF DrawerPlate[activeDrawer].CassetteData[CassetteId].HomingState > enumCassetteHomingState.Homed THEN
			localState	:= 1;
		END_IF

	1:
		IF DrawerPlate[activeDrawer].CassetteData[CassetteId].HomingState = enumCassetteHomingState.Homed THEN
			localstate	:= 0;
			InitializeSingleCassette := TRUE;
		ELSIF DrawerPlate[activeDrawer].CassetteData[CassetteId].HomingState < enumCassetteHomingState.Homed THEN
			localstate	:= 0;
		END_IF
END_CASE
END_METHOD

// Checks if movement in the specified direction would exceed the mechanical limits for X1, X2, or Y axes.
// Evaluates which limits are relevant based on the active adjustment motor type.
// Sets a flag if any applicable limit is currently active, preventing further movement.
METHOD PRIVATE LimitActiveForAdjustment : BOOL
VAR_INPUT
	Drawer		: enumDrawer;		// Drawer to check
	Cassette	: USINT;			// Cassette to check
	Adjustment	: enumMotorsType;		// Adjustment to check
	Direction	: enumDirection;	// Direction of the adjustment
END_VAR
VAR
	LimitX1		: BOOL;
	LimitX2		: BOOL;
	LimitY		: BOOL;
	Limited		: BOOL;
END_VAR
%FOLDER Private
// Check if X1 has a positive or negative limit while moving in the corresponding direction
LimitX1 :=	(DrawerPlate[Drawer].CassetteData[Cassette].NegativeLimitReachedX1 AND Direction = enumDirection.Negative)
		OR	(DrawerPlate[Drawer].CassetteData[Cassette].PositiveLimitReachedX1 AND Direction = enumDirection.Positive);

// Check if X2 has a positive or negative limit while moving in the corresponding direction
LimitX2 :=	(DrawerPlate[Drawer].CassetteData[Cassette].NegativeLimitReachedX2 AND Direction = enumDirection.Negative)
		OR	(DrawerPlate[Drawer].CassetteData[Cassette].PositiveLimitReachedX2 AND Direction = enumDirection.Positive);

// Check if Y has a positive or negative limit while moving in the corresponding direction
LimitY  :=	(DrawerPlate[Drawer].CassetteData[Cassette].NegativeLimitReachedY  AND Direction = enumDirection.Negative)
		OR	(DrawerPlate[Drawer].CassetteData[Cassette].PositiveLimitReachedY  AND Direction = enumDirection.Positive);

// Check if the active limits found above do exist in the adjustment
CASE Adjustment OF
	enumMotorsType.X:		Limited := LimitX1 OR LimitX2;
	enumMotorsType.X1:		Limited := LimitX1;
	enumMotorsType.X1Y:		Limited := LimitX1 OR LimitY;
	enumMotorsType.X2:		Limited := LimitX2;
	enumMotorsType.X2Y:		Limited := LimitX2 OR LimitY;
	enumMotorsType.XY:		Limited := LimitX1 OR LimitX2 OR LimitY;
	enumMotorsType.Y:		Limited := LimitY;
END_CASE

LimitActiveForAdjustment := Limited;
END_METHOD

METHOD PRIVATE ManualFunctions : BOOL
VAR
	i				: USINT;
	Movement		: enumMovementType;
END_VAR
VAR_INST
	localState		: USINT;
	result			: ARRAY[1..2] OF BOOL;
	trigger			: RisingTriggerFB;
END_VAR
// ============================================================================
// Cassette Position Control and Adjustment Logic
// ============================================================================
// This code manages individual and collective cassette movements within a drawer
// system, including initialization, positioning, and fine adjustments.
// ============================================================================

// Enable UI buttons only when idle and no function is selected
Visu.EnableButtons := localState = 0 AND Visu.SingleSelectedFunction = enumCassetteFunctionSingle.None;

// Update current drawer display
Visu.CurrentDrawer := activeDrawer;

// Trigger JSON execution when any cassette function is selected or another drawer is selected
JsonBuilder.executeCassetteJson[instanceNo] S= trigger.Rising(CLK := Visu.SingleSelectedFunction > enumCassetteFunctionSingle.None OR Visu.AllCassetteFunction > enumCassetteFunctionAll.None);


// ============================================================================
// Main State Machine
// ============================================================================
CASE localState OF
	// ------------------------------------------------------------------------
	// STATE 0: IDLE - Ready for new commands
	// ------------------------------------------------------------------------
	0:
		// Safety check: Air pressure must be OK to proceed
		IF NOT airPressureOk THEN
			// Air pressure fault - remain in idle state and prevent all operations
			;

		// ----------------------------------------------------------------
		// All Cassettes: Initialize to Center or Data position
		// ----------------------------------------------------------------
		ELSIF Visu.ExecuteFunction AND (Visu.AllCassetteFunction = enumCassetteFunctionAll.InitCenter OR Visu.AllCassetteFunction = enumCassetteFunctionAll.InitData) THEN
			localState := 10;  // Transition to initialization state
			Visu.SingleSelectedFunction := enumCassetteFunctionSingle.None;  // Clear any single cassette selection

		// ----------------------------------------------------------------
		// All Cassettes: Move to Data position (without initialization)
		// ----------------------------------------------------------------
		ELSIF Visu.ExecuteFunction AND Visu.AllCassetteFunction = enumCassetteFunctionAll.Data THEN
			localState := 20;  // Transition to data position state
			Visu.SingleSelectedFunction := enumCassetteFunctionSingle.None;

		// ----------------------------------------------------------------
		// Single Cassette Operations
		// ----------------------------------------------------------------
		ELSIF Visu.SelectedCassette > 0 AND Visu.SelectedCassette <= GVL_Constants_Magazine.MaxCassettes THEN
			CASE Visu.SingleSelectedFunction OF
				// ------------------------------------------------------------
				// Fine positioning adjustments (incremental movements)
				// ------------------------------------------------------------
				enumCassetteFunctionSingle.Left:
					AdjustCassette(activeDrawer, Visu.SelectedCassette, enumMovementType.Left, 1);

				enumCassetteFunctionSingle.Up:
					AdjustCassette(activeDrawer, Visu.SelectedCassette, enumMovementType.Up, 1);

				enumCassetteFunctionSingle.Down:
					AdjustCassette(activeDrawer, Visu.SelectedCassette, enumMovementType.Down, 1);

				enumCassetteFunctionSingle.Right:
					AdjustCassette(activeDrawer, Visu.SelectedCassette, enumMovementType.Right, 1);

				enumCassetteFunctionSingle.RotateCw:
					AdjustCassette(activeDrawer, Visu.SelectedCassette, enumMovementType.RotateCw, 1);

				enumCassetteFunctionSingle.RotateCcw:
					AdjustCassette(activeDrawer, Visu.SelectedCassette, enumMovementType.RotateCcw, 1);

				// ------------------------------------------------------------
				// Initialize single cassette and move to center position
				// ------------------------------------------------------------
				enumCassetteFunctionSingle.InitCenter:
					// Short-circuit evaluation: Initialize first, then move to center
					// result[1] stores the completion state of initialization
					IF (result[1] OR_ELSE (result[1] := InitializeSingleCassette(Visu.SelectedCassette))) AND_THEN MoveSingleCassetteToMiddlePosition(Visu.SelectedCassette) THEN
						result[1] := FALSE;  // Reset completion flag
						Visu.SingleSelectedFunction := enumCassetteFunctionSingle.None;  // Clear function selection
					END_IF

				// ------------------------------------------------------------
				// Initialize single cassette and move to data position
				// ------------------------------------------------------------
				enumCassetteFunctionSingle.InitData:
					// Short-circuit evaluation: Initialize first, then move to data position
					IF (result[1] OR_ELSE (result[1] := InitializeSingleCassette(Visu.SelectedCassette))) AND_THEN MoveSingleCassetteToDataPosition(Visu.SelectedCassette) THEN
						result[1] := FALSE;  // Reset completion flag
						Visu.SingleSelectedFunction := enumCassetteFunctionSingle.None;
					END_IF

				// ------------------------------------------------------------
				// Move single cassette to data position (no initialization)
				// ------------------------------------------------------------
				enumCassetteFunctionSingle.Data:
					IF MoveSingleCassetteToDataPosition(Visu.SelectedCassette) THEN
						Visu.SingleSelectedFunction := enumCassetteFunctionSingle.None;
					END_IF

				// ------------------------------------------------------------
				// Stop adjusting single cassette
				// ------------------------------------------------------------
				enumCassetteFunctionSingle.Stop:
					IF StopAdjustingSingleCassette(Visu.SelectedCassette) THEN
						Visu.ExecuteFunction := FALSE;
						Arrays.Bool_Reset(result);
						Visu.SingleSelectedFunction := enumCassetteFunctionSingle.None;
					END_IF
			END_CASE

			// Clear function selection after basic adjustment movements (Left through RotateCcw)
			// These are one-shot commands that complete immediately
			IF Visu.SingleSelectedFunction <= enumCassetteFunctionSingle.RotateCcw THEN
				Visu.SingleSelectedFunction := enumCassetteFunctionSingle.None;
			END_IF
		END_IF

	// ------------------------------------------------------------------------
	// STATE 10: INITIALIZE ALL CASSETTES
	// ------------------------------------------------------------------------
	10:
		// Execute initialization sequence for all cassettes
		IF InitializeAllCassettes(Visu.AllCassetteFunction = enumCassetteFunctionAll.Stop) THEN
			// Initialization complete - determine next state based on selected function
			IF Visu.AllCassetteFunction = enumCassetteFunctionAll.InitData THEN
				localState := 20;  // Continue to data position
			ELSIF Visu.AllCassetteFunction = enumCassetteFunctionAll.InitCenter THEN
				localState := 30;  // Continue to center position
			END_IF
		END_IF

		// User requested stop
		IF Visu.AllCassetteFunction = enumCassetteFunctionAll.Stop THEN
			IF StopAdjustingAllCassettes() THEN
				Visu.AllCassetteFunction := enumCassetteFunctionAll.None;
				Visu.ExecuteFunction := FALSE;  // Clear execution flag
				localState := 0;  // Return to idle state
			END_IF
		END_IF

	// ------------------------------------------------------------------------
	// STATE 20: MOVE ALL CASSETTES TO DATA POSITION
	// ------------------------------------------------------------------------
	20:
		// User requested stop
		IF Visu.AllCassetteFunction = enumCassetteFunctionAll.Stop THEN
			IF StopAdjustingAllCassettes() THEN
				Visu.AllCassetteFunction := enumCassetteFunctionAll.None;
				Visu.ExecuteFunction := FALSE;  // Clear execution flag
				localState := 0;  // Return to idle state
			END_IF
		END_IF

		// Execute movement to data position for all cassettes
		IF MoveAllCassettesToDataPosition() THEN
			// Movement complete - reset to idle
			Visu.AllCassetteFunction := enumCassetteFunctionAll.None;
			Visu.ExecuteFunction := FALSE;
			localState := 0;
		END_IF

	// ------------------------------------------------------------------------
	// STATE 30: MOVE ALL CASSETTES TO CENTER POSITION
	// ------------------------------------------------------------------------
	30:
		// User requested stop
		IF Visu.AllCassetteFunction = enumCassetteFunctionAll.Stop THEN
			IF StopAdjustingAllCassettes() THEN
				Visu.AllCassetteFunction := enumCassetteFunctionAll.None;
				Visu.ExecuteFunction := FALSE;  // Clear execution flag
				localState := 0;  // Return to idle state
			END_IF
		END_IF

		// Execute movement to center position for all cassettes
		IF MoveAllCassettesToMiddlePosition() THEN
			// Movement complete - reset to idle
			Visu.AllCassetteFunction := enumCassetteFunctionAll.None;
			Visu.ExecuteFunction := FALSE;
			localState := 0;
		END_IF
END_CASE

// ============================================================================
// End of Cassette Control Logic
// ============================================================================
END_METHOD

// Copy all the target positions from the data struct to the setpoints of the cassettes
METHOD PUBLIC MoveAllCassettesToDataPosition : BOOL
VAR
	i	: USINT;
END_VAR
%FOLDER Commands
FOR i := 1 TO DrawerPlate[activeDrawer].NumberOfCassettes DO
	MoveSingleCassetteToDataPosition(i);
END_FOR

MoveAllCassettesToDataPosition := AllCassettesReady;
END_METHOD

// Moves all cassettes to the zero position
METHOD MoveAllCassettesToMiddlePosition : BOOL
VAR
	i : USINT;
END_VAR
%FOLDER Commands
FOR i := 1 TO GVL_Constants_Magazine.MaxCassettes DO
	MoveSingleCassetteToMiddlePosition(i);
END_FOR

MoveAllCassettesToMiddlePosition := AllCassettesReady;
END_METHOD

// Copy the target position from the data struct to the setpoints of the selected cassette
METHOD PUBLIC MoveSingleCassetteToDataPosition : BOOL
VAR_INPUT
	CassetteId	: USINT;
END_VAR
%FOLDER Commands
DrawerPlate[activeDrawer].CassetteData[CassetteId].TargetPositionX1	:= Data[activeDrawer, CassetteId].X1;
DrawerPlate[activeDrawer].CassetteData[CassetteId].TargetPositionX2	:= Data[activeDrawer, CassetteId].X2;
DrawerPlate[activeDrawer].CassetteData[CassetteId].TargetPositionY	:= Data[activeDrawer, CassetteId].Y;

MoveSingleCassetteToDataPosition	:= NOT DrawerPlate[activeDrawer].CassetteData[CassetteId].AdjustmentNeeded;
END_METHOD

// Moves the selected cassette to the zero position
METHOD PUBLIC MoveSingleCassetteToMiddlePosition : BOOL
VAR_INPUT
	CassetteId	: USINT;
END_VAR
%FOLDER Commands
DrawerPlate[activeDrawer].CassetteData[CassetteId].TargetPositionX1	:= 0;
DrawerPlate[activeDrawer].CassetteData[CassetteId].TargetPositionX2	:= 0;
DrawerPlate[activeDrawer].CassetteData[CassetteId].TargetPositionY	:= 0;

MoveSingleCassetteToMiddlePosition	:= NOT DrawerPlate[activeDrawer].CassetteData[CassetteId].AdjustmentNeeded;
END_METHOD

// Determines if two cassettes can be adjusted in parallel based on motor compatibility, direction, and homing state.
// Ensures both cassettes share the same enable valve and adjustment configuration for safe simultaneous movement.
// If any condition fails (motors mismatch, direction conflict, homing active, or valve mismatch), parallel adjustment is disabled.
METHOD PRIVATE ParallelAdjustmentPossible : BOOL
VAR_INPUT
	FirstProfile		: MovementProfile;
	SecondProfile		: MovementProfile;
END_VAR
VAR
	MotorsMatch		: BOOL;
	FirstCassette	: REFERENCE TO CassetteDefinition;
	SecondCassette	: REFERENCE TO CassetteDefinition;
	Homing			: BOOL;
END_VAR
%FOLDER Private
ParallelAdjustmentPossible	:= TRUE;
FirstCassette				REF= DrawerPlate[FirstProfile.Drawer].CassetteDefinition[FirstProfile.Cassette];
SecondCassette				REF= DrawerPlate[SecondProfile.Drawer].CassetteDefinition[SecondProfile.Cassette];
Homing						:= DrawerPlate[FirstProfile.Drawer].CassetteData[FirstProfile.Cassette].HomingState >= enumCassetteHomingState.HomingStep1;
ParallelAdjustmentNotPossibleReason		:= 0;

// Check if motors match. For example: When first profile motor is X1 and second profile motors is XY, both can be adjusted in X1.
CASE FirstProfile.Motors OF
	enumMotorsType.X:		MotorsMatch := SecondProfile.Motors = enumMotorsType.XY OR SecondProfile.Motors = enumMotorsType.X;
	enumMotorsType.X1:		MotorsMatch := SecondProfile.Motors = enumMotorsType.XY OR SecondProfile.Motors = enumMotorsType.X OR SecondProfile.Motors = enumMotorsType.X1Y OR SecondProfile.Motors = enumMotorsType.X1;
	enumMotorsType.X1Y:		MotorsMatch := SecondProfile.Motors = enumMotorsType.XY OR SecondProfile.Motors = enumMotorsType.X1Y;
	enumMotorsType.X2:		MotorsMatch := SecondProfile.Motors = enumMotorsType.XY OR SecondProfile.Motors = enumMotorsType.X OR SecondProfile.Motors = enumMotorsType.X2Y OR SecondProfile.Motors = enumMotorsType.X2;
	enumMotorsType.X2Y:		MotorsMatch := SecondProfile.Motors = enumMotorsType.XY OR SecondProfile.Motors = enumMotorsType.X2Y;
	enumMotorsType.XY:		MotorsMatch := SecondProfile.Motors = enumMotorsType.XY;
	enumMotorsType.Y:		MotorsMatch := SecondProfile.Motors = enumMotorsType.XY OR SecondProfile.Motors = enumMotorsType.Y OR SecondProfile.Motors = enumMotorsType.X1Y OR SecondProfile.Motors = enumMotorsType.X2Y;
END_CASE

// No match found in CASE statement above
ParallelAdjustmentPossible	R= NOT MotorsMatch;

// Directions must be the same when moving together
ParallelAdjustmentPossible	R= FirstProfile.Direction	<> SecondProfile.Direction;
IF NOT ParallelAdjustmentPossible AND ParallelAdjustmentNotPossibleReason = 0 THEN ParallelAdjustmentNotPossibleReason		:= 8; END_IF

// When one of the cassettes is homing, they cannot move together
ParallelAdjustmentPossible	R= (DrawerPlate[FirstProfile.Drawer].CassetteData[FirstProfile.Cassette].HomingState <> DrawerPlate[SecondProfile.Drawer].CassetteData[SecondProfile.Cassette].HomingState);
IF NOT ParallelAdjustmentPossible AND ParallelAdjustmentNotPossibleReason = 0 THEN ParallelAdjustmentNotPossibleReason		:= 9; END_IF

// When Enable is different and also the adjustments are different, simultaneous adjustment is not possible.
ParallelAdjustmentPossible	R= FirstCassette.EnableValve <> SecondCassette.EnableValve AND FirstCassette.AdjustmentValve[enumMotorsType.X1] <> SecondCassette.AdjustmentValve[enumMotorsType.X1];
ParallelAdjustmentPossible	R= FirstCassette.EnableValve <> SecondCassette.EnableValve AND FirstCassette.AdjustmentValve[enumMotorsType.X2] <> SecondCassette.AdjustmentValve[enumMotorsType.X2];
ParallelAdjustmentPossible	R= FirstCassette.EnableValve <> SecondCassette.EnableValve AND FirstCassette.AdjustmentValve[enumMotorsType.Y]  <> SecondCassette.AdjustmentValve[enumMotorsType.Y];
IF NOT ParallelAdjustmentPossible AND ParallelAdjustmentNotPossibleReason = 0 THEN ParallelAdjustmentNotPossibleReason		:= 10; END_IF
END_METHOD

// Call this method when the config should be reloaded, for example after a program change.
METHOD ReloadConfig : BOOL
VAR_INPUT
END_VAR
%FOLDER Commands
_initialized := FALSE;
END_METHOD

// Command to reset the module (Statemachine to zero state)
METHOD PUBLIC Stop : BOOL	// Returns true when drives are in standstill
VAR
END_VAR
%FOLDER Commands
// A Stop command does not have any effect on cassette adjustment.

Stop := SUPER^.Stop();
END_METHOD

// Stop adjusting all cassettes by setting the actual value as target position.
METHOD StopAdjustingAllCassettes : BOOL
VAR
	i	: USINT;
END_VAR
%FOLDER Commands
FOR i := 1 TO DrawerPlate[activeDrawer].NumberOfCassettes DO
	StopAdjustingSingleCassette(i);
END_FOR

StopAdjustingAllCassettes := AllCassettesReady;
END_METHOD

// Stop adjusting a single cassette by setting the actual value as target position.
METHOD StopAdjustingSingleCassette : BOOL
VAR_INPUT
	CassetteId				: USINT;
END_VAR
%FOLDER Commands
IF DrawerPlate[activeDrawer].CassetteData[CassetteId].HomingState > enumCassetteHomingState.Homed THEN
	DrawerPlate[activeDrawer].CassetteData[CassetteId].HomingState := enumCassetteHomingState.StopHoming;
END_IF

DrawerPlate[activeDrawer].CassetteData[CassetteId].TargetPositionX1	:= ActualCassettePosition[activeDrawer, CassetteId].X1;
DrawerPlate[activeDrawer].CassetteData[CassetteId].TargetPositionX2	:= ActualCassettePosition[activeDrawer, CassetteId].X2;
DrawerPlate[activeDrawer].CassetteData[CassetteId].TargetPositionY	:= ActualCassettePosition[activeDrawer, CassetteId].Y;

StopAdjustingSingleCassette	:= NOT DrawerPlate[activeDrawer].CassetteData[CassetteId].AdjustmentNeeded;
END_METHOD

// Detects rising edges on adjustment and enable valve outputs for all cassettes in the connected drawer.
// Increments or decrements the actual motor position based on valve activation and signal transitions.
// Ensures accurate tracking of cassette movement per motor axis (X1, X2, Y) during manual or automatic adjustments.
METHOD PRIVATE UpdateCassetteMotorPositions
VAR_INST
	risingAdjust : ARRAY[1..GVL_Constants_Magazine.MaxAdjustValves] OF RisingTriggerFB;
	risingEnable : ARRAY[1..GVL_Constants_Magazine.MaxEnableValves] OF RisingTriggerFB;
END_VAR
VAR
	i			: USINT;
	Motor		: enumMotorsType;
	adjustOut	: ARRAY[enumMotorsType.X1..enumMotorsType.Y] OF USINT;
	enableOut	: USINT;
END_VAR
FOR i := 1 TO GVL_Constants_Magazine.MaxAdjustValves DO
	IF risingAdjust[i].Rising(CLK := Adjust[i].Map()) THEN
		Increment.AnyInt(SwitchCountAdjust[activeDrawer, i]);
	END_IF
END_FOR

FOR i := 1 TO GVL_Constants_Magazine.MaxEnableValves DO
	IF risingEnable[i].Rising(CLK := Enable[i].Map()) THEN
		Increment.AnyInt(SwitchCountEnable[activeDrawer, i]);
	END_IF
END_FOR

FOR i := 1 TO DrawerPlate[activeDrawer].NumberOfCassettes DO
	enableOut := DrawerPlate[activeDrawer].CassetteDefinition[i].EnableValve;
	FOR Motor := enumMotorsType.X1 TO enumMotorsType.Y DO
		adjustOut[Motor] := DrawerPlate[activeDrawer].CassetteDefinition[i].AdjustmentValve[Motor];
		IF risingAdjust[adjustOut[Motor]].Q AND Enable[enableOut].Map() THEN
			DrawerPlate[activeDrawer].CassetteData[i].AddToActualPosition(Motor, 1);
		END_IF
		IF risingEnable[enableOut].Q AND Adjust[adjustOut[Motor]].Map() THEN
			DrawerPlate[activeDrawer].CassetteData[i].AddToActualPosition(Motor, -1);
		END_IF
	END_FOR
END_FOR
END_METHOD

{attribute 'monitoring':='call'}
PROPERTY AllCassettesHomed : BOOL
%FOLDER Properties
GET
VAR
	CassetteId		: USINT;
END_VAR
AllCassettesHomed			:= TRUE;
FOR CassetteId := 1 TO DrawerPlate[activeDrawer].NumberOfCassettes DO
	IF DrawerPlate[activeDrawer].CassetteData[CassetteId].HomingState <> enumCassetteHomingState.Homed THEN
		AllCassettesHomed	:= FALSE;
		RETURN;
	END_IF
END_FOR
END_GET
END_PROPERTY

{attribute 'monitoring':='call'}
PROPERTY AllCassettesHoming : BOOL
%FOLDER Properties
GET
VAR
	CassetteId		: USINT;
	HomingState		: enumCassetteHomingState;
END_VAR
AllCassettesHoming			:= TRUE;
HomingState					:= DrawerPlate[activeDrawer].CassetteData[1].HomingState;
FOR CassetteId := 1 TO DrawerPlate[activeDrawer].NumberOfCassettes DO
	IF DrawerPlate[activeDrawer].CassetteData[CassetteId].HomingState <> HomingState
	OR DrawerPlate[activeDrawer].CassetteData[CassetteId].HomingState <= enumCassetteHomingState.Homed
	THEN
		AllCassettesHoming	:= FALSE;
		EXIT;
	END_IF
END_FOR
END_GET
END_PROPERTY

{attribute 'monitoring':='call'}
PROPERTY AllCassettesReady : BOOL
%FOLDER Properties
GET
AllCassettesReady	:= NOT AnyAdjustmentNeeded;
END_GET
END_PROPERTY

{attribute 'monitoring':='call'}
PROPERTY AnyAdjustmentNeeded : BOOL
%FOLDER Properties
GET
VAR
	CassetteId	: USINT;
END_VAR
FOR CassetteId := 1 TO DrawerPlate[activeDrawer].NumberOfCassettes DO
	IF DrawerPlate[activeDrawer].CassetteData[CassetteId].AdjustmentNeeded THEN
		AnyAdjustmentNeeded	:= TRUE;
		EXIT;
	END_IF
END_FOR
END_GET
END_PROPERTY

{attribute 'monitoring':='call'}
PROPERTY AnyHomingBusy : BOOL
%FOLDER Properties
GET
VAR
	CassetteId	: USINT;
END_VAR
FOR CassetteId := 1 TO DrawerPlate[activeDrawer].NumberOfCassettes DO
	IF DrawerPlate[activeDrawer].CassetteData[CassetteId].HomingState > enumCassetteHomingState.Homed THEN
		AnyHomingBusy	:= TRUE;
		RETURN;
	END_IF
END_FOR
END_GET
END_PROPERTY

{attribute 'monitoring':='call'}
PROPERTY AnyHomingNeeded : BOOL
%FOLDER Properties
GET
VAR
	CassetteId	: USINT;
END_VAR
FOR CassetteId := 1 TO DrawerPlate[activeDrawer].NumberOfCassettes DO
	IF DrawerPlate[activeDrawer].CassetteData[CassetteId].HomingState = enumCassetteHomingState.NotHomed THEN
		AnyHomingNeeded	:= TRUE;
		EXIT;
	END_IF
END_FOR
END_GET
END_PROPERTY

{attribute 'monitoring':='call'}
PROPERTY AnyNegativeLimitReached : BOOL
%FOLDER Properties
GET
VAR
	CassetteId	: USINT;
END_VAR
FOR CassetteId := 1 TO DrawerPlate[activeDrawer].NumberOfCassettes DO
	IF DrawerPlate[activeDrawer].CassetteData[CassetteId].NegativeLimitReachedX1
	OR DrawerPlate[activeDrawer].CassetteData[CassetteId].NegativeLimitReachedX2
	OR DrawerPlate[activeDrawer].CassetteData[CassetteId].NegativeLimitReachedY
	THEN
		AnyNegativeLimitReached	:= TRUE;
		EXIT;
	END_IF
END_FOR
END_GET
END_PROPERTY

{attribute 'monitoring':='call'}
PROPERTY AnyPositiveLimitReached : BOOL
%FOLDER Properties
GET
VAR
	CassetteId	: USINT;
END_VAR
FOR CassetteId := 1 TO DrawerPlate[activeDrawer].NumberOfCassettes DO
	IF DrawerPlate[activeDrawer].CassetteData[CassetteId].PositiveLimitReachedX1
	OR DrawerPlate[activeDrawer].CassetteData[CassetteId].PositiveLimitReachedX2
	OR DrawerPlate[activeDrawer].CassetteData[CassetteId].PositiveLimitReachedY
	THEN
		AnyPositiveLimitReached	:= TRUE;
		EXIT;
	END_IF
END_FOR
END_GET
END_PROPERTY
