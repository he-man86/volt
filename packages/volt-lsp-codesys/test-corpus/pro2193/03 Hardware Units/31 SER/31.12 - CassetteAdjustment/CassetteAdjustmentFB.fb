	DrawerPlate[DrawerId].CassetteDefinition[6].CavityId							:= 6;
	DrawerPlate[DrawerId].CassetteDefinition[6].LabelId								:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[6].LabelType							:= enumLabelType.Wrap;
	DrawerPlate[DrawerId].CassetteDefinition[6].LabelOrientation					:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[6].CassetteOrientation					:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[6].AdjustmentValve[enumMotorsType.X1]		:= 4;
	DrawerPlate[DrawerId].CassetteDefinition[6].AdjustmentValve[enumMotorsType.X2]		:= 6;
	DrawerPlate[DrawerId].CassetteDefinition[6].AdjustmentValve[enumMotorsType.Y]		:= 5;
	DrawerPlate[DrawerId].CassetteDefinition[6].EnableValve							:= 3;

	DrawerPlate[DrawerId].CassetteDefinition[7].CassetteId							:= 7;
	DrawerPlate[DrawerId].CassetteDefinition[7].CavityId							:= 7;
	DrawerPlate[DrawerId].CassetteDefinition[7].LabelId								:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[7].LabelType							:= enumLabelType.Wrap;
	DrawerPlate[DrawerId].CassetteDefinition[7].LabelOrientation					:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[7].CassetteOrientation					:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[7].AdjustmentValve[enumMotorsType.X1]		:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[7].AdjustmentValve[enumMotorsType.X2]		:= 3;
	DrawerPlate[DrawerId].CassetteDefinition[7].AdjustmentValve[enumMotorsType.Y]		:= 2;
	DrawerPlate[DrawerId].CassetteDefinition[7].EnableValve							:= 4;

	DrawerPlate[DrawerId].CassetteDefinition[8].CassetteId							:= 8;
	DrawerPlate[DrawerId].CassetteDefinition[8].CavityId							:= 8;
	DrawerPlate[DrawerId].CassetteDefinition[8].LabelId								:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[8].LabelType							:= enumLabelType.Wrap;
	DrawerPlate[DrawerId].CassetteDefinition[8].LabelOrientation					:= enumOrientationType.Upright;
