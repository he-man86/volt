{attribute 'symbol' := 'none'}
FUNCTION_BLOCK CassetteAdjustmentFB
EXTENDS ModuleBaseHardwareFB
VAR_INPUT
	activeDrawer				: enumDrawer;	// Active drawer
	airPressureOk				: BOOL;

	{attribute 'symbol' := 'readwrite'}	Enable						: ARRAY[1..GVL_Constants_Magazine.MaxEnableValves] OF ActuatorWithManualControlFB;
	{attribute 'symbol' := 'readwrite'}	Adjust						: ARRAY[1..GVL_Constants_Magazine.MaxAdjustValves] OF ActuatorWithManualControlFB;
END_VAR
VAR_IN_OUT
	Data						: ARRAY[enumDrawer.Upper..enumDrawer.Lower, 1..GVL_Constants_Magazine.MaxCassettes]		OF CassettePosition;
	SwitchCountEnable			: ARRAY[enumDrawer.Upper..enumDrawer.Lower, 1..GVL_Constants_Magazine.MaxEnableValves]	OF UDINT;
	SwitchCountAdjust			: ARRAY[enumDrawer.Upper..enumDrawer.Lower, 1..GVL_Constants_Magazine.MaxAdjustValves]	OF UDINT;
	SwitchCountCassette			: ARRAY[enumDrawer.Upper..enumDrawer.Lower, 1..GVL_Constants_Magazine.MaxCassettes]		OF ARRAY[enumMotorsType.X1..enumMotorsType.Y] OF UDINT;
	ActualCassettePosition		: ARRAY[enumDrawer.Upper..enumDrawer.Lower, 1..GVL_Constants_Magazine.MaxCassettes]		OF CassettePosition;
	TargetCassettePosition		: ARRAY[enumDrawer.Upper..enumDrawer.Lower, 1..GVL_Constants_Magazine.MaxCassettes]		OF CassettePosition;
END_VAR
VAR
	Profiles					: ARRAY[1..GVL_Constants_Magazine.MaxCassettes] OF MovementProfile;	// Array with profiles of cassettes which must be adjusted
	ProfilesToExecute			: ARRAY[1..GVL_Constants_Magazine.MaxCassettes] OF MovementProfile;	// Array with profiles of cassettes that can be adjusted simultaneously

	ConfigError					: BOOL;
	DrawerPlate					: ARRAY[enumDrawer.Upper..enumDrawer.Lower] OF DrawerPlateType;

	CassetteId					: USINT;
	MotorId						: enumMotorsType;

	JsonTimer					: BTON;

	{attribute 'symbol' := 'readwrite'}		Visu					: CassetteAdjustment_Visu_Type;

	ParallelAdjustmentNotPossibleReason			: USINT;
END_VAR
VAR CONSTANT
	PulseTime					: REAL				:= 0.4;
	ReferencePos				: CassettePosition	:= (X1 := 42, X2 := 42, Y := 49);
END_VAR

SUPER^();

END_FUNCTION_BLOCK

// Adds a profile to the first available or matching slot in the profile array.
// If the same drawer and cassette already exist, it overwrites the entry.
// Stops searching once a match or empty slot (Cassette = 0) is found.
METHOD PRIVATE AddToProfileArray
VAR_INPUT
	Profile			: REFERENCE TO MovementProfile;
	ProfileArray	: REFERENCE TO ARRAY[1..GVL_Constants_Magazine.MaxCassettes] OF MovementProfile;
END_VAR
VAR
	i				: USINT;
END_VAR
%FOLDER Private
// Check if profile already exists in array, then overwrite. Else place profile at first empty position in the array.
FOR i := 1 TO GVL_Constants_Magazine.MaxCassettes DO
	IF (Profile.Drawer = ProfileArray[i].Drawer AND Profile.Cassette = ProfileArray[i].Cassette)
	OR ProfileArray[i].Cassette = 0
	THEN
		ProfileArray[i] := Profile;
		RETURN;
	END_IF
END_FOR
END_METHOD

// Calculates position changes for a cassette based on the specified label movement direction or rotation.
// Determines which motors (X or Y) should move and in which direction, or applies differential movement for rotation.
// Updates the cassette's target position with the calculated step values.
METHOD AdjustCassette
VAR_INPUT
	DrawerId				: enumDrawer;
	CassetteId				: USINT;
	LabelMovement			: enumMovementType;
	Steps					: SINT;
END_VAR
VAR
	DirectionForMovement	: enumDirection;
	MotorsForMovement		: enumMotorsType;

	PositionChanges			: CassettePosition;
	i						: USINT;
END_VAR
%FOLDER Commands
IF CassetteId = 0 THEN RETURN; END_IF

CASE LabelMovement OF
	enumMovementType.Up, enumMovementType.Right, enumMovementType.Down, enumMovementType.Left:
		DirectionForMovement	:= DrawerPlate[DrawerId].CassetteDefinition[CassetteId].DirectionsForMovements[LabelMovement];	// Positive or negative
		MotorsForMovement		:= DrawerPlate[DrawerId].CassetteDefinition[CassetteId].MotorsForMovements[LabelMovement];		// X or Y

		IF MotorsForMovement = enumMotorsType.X THEN
			PositionChanges.X1 := PositionChanges.X2 := Steps * (SEL(DirectionForMovement = enumDirection.Positive, - 1, 1));
		ELSIF MotorsForMovement = enumMotorsType.Y THEN
			PositionChanges.Y := Steps * (SEL(DirectionForMovement = enumDirection.Positive, - 1, 1));
		END_IF

	enumMovementType.RotateCw:
		CASE DrawerPlate[DrawerId].CassetteData[CassetteId].LastRotateMotor OF
			enumMotorsType.X2:
				PositionChanges.X1 := (Steps / 2) + Steps MOD 2;
				PositionChanges.X2 := (Steps / 2) * -1;
				DrawerPlate[DrawerId].CassetteData[CassetteId].LastRotateMotor := enumMotorsType.X1;
			enumMotorsType.X1:
				PositionChanges.X1 := Steps / 2;
				PositionChanges.X2 := ((Steps / 2) + Steps MOD 2) * -1;
				DrawerPlate[DrawerId].CassetteData[CassetteId].LastRotateMotor := enumMotorsType.X2;
		END_CASE

	enumMovementType.RotateCcw:
		CASE DrawerPlate[DrawerId].CassetteData[CassetteId].LastRotateMotor OF
			enumMotorsType.X2:
				PositionChanges.X1 := ((Steps / 2) + Steps MOD 2) * -1;
				PositionChanges.X2 := Steps / 2;
				DrawerPlate[DrawerId].CassetteData[CassetteId].LastRotateMotor := enumMotorsType.X1;
			enumMotorsType.X1:
				PositionChanges.X1 := (Steps / 2) * -1;
				PositionChanges.X2 := (Steps / 2)  + Steps MOD 2;
				DrawerPlate[DrawerId].CassetteData[CassetteId].LastRotateMotor := enumMotorsType.X2;
		END_CASE
END_CASE

DrawerPlate[DrawerId].CassetteData[CassetteId].AddToTargetPositions(PositionChanges);
END_METHOD

// Determines the cassetteId based on the given cavity and label and adjusts the cassette
// using the AdjustCassette method
METHOD AdjustLabel
VAR_INPUT
	DrawerId				: enumDrawer;
	Cavity					: USINT;
	Label					: USINT;
	LabelMovement			: enumMovementType;
	Steps					: SINT;
END_VAR
%FOLDER Commands
AdjustCassette(
	DrawerId		:= DrawerId,
	CassetteId		:= GetCassetteNumber(Cavity, Label),
	LabelMovement	:= LabelMovement,
	Steps			:= Steps);
END_METHOD

// Executes a 4-phase pulse sequence to control cassette movement based on direction and motor selection.
// Each state sets specific valve outputs for a defined pulse duration using a timer.
// After completing the sequence, all outputs are reset and a step completion flag is raised.
METHOD PRIVATE AdjustOneStep : BOOL
VAR_INPUT
	Direction		: enumDirection;		// Direction for the movement
	Motors			: enumMotorsType;			// Motors to adjust
END_VAR
VAR_OUTPUT
	Enable			: BOOL;					// Connect the ENABLE output here
	AdjustX1		: BOOL;					// Connect the ADJUSTMENT output for X1 here
	AdjustX2		: BOOL;					// Connect the ADJUSTMENT output for X2 here
	AdjustY			: BOOL;					// Connect the ADJUSTMENT output for Y here
END_VAR
VAR_INST
	Timer			: BTON;
	State			: USINT;
END_VAR
VAR
	MovingPositive	: BOOL;
	MovingNegative	: BOOL;
	MovingX1		: BOOL;
	MovingX2		: BOOL;
	MovingY			: BOOL;
END_VAR
%FOLDER Private
// Write helper booleans for direction and motors which have to move
MovingPositive	:= Direction = enumDirection.Positive;
MovingNegative	:= Direction = enumDirection.Negative;
MovingX1		:= Motors = enumMotorsType.XY OR Motors = enumMotorsType.X OR Motors = enumMotorsType.X1	OR Motors = enumMotorsType.X1Y;
MovingX2		:= Motors = enumMotorsType.XY OR Motors = enumMotorsType.X OR Motors = enumMotorsType.X2	OR Motors = enumMotorsType.X2Y;
MovingY			:= Motors = enumMotorsType.XY OR Motors = enumMotorsType.Y OR Motors = enumMotorsType.X1Y	OR Motors = enumMotorsType.X2Y;

CASE State OF
	0:	// Set first outputs
		Enable		:= MovingPositive;
		AdjustX1	:= MovingX1 AND MovingNegative;
		AdjustX2	:= MovingX2 AND MovingNegative;
		AdjustY		:= MovingY	AND MovingNegative;
		IF Timer.Set(TRUE, PulseTime) THEN
			Timer.Reset();
			Increment.AnyInt(State);
		END_IF

	1:	// Set all outputs
		Enable		:= TRUE;
		AdjustX1	:= MovingX1;
		AdjustX2	:= MovingX2;
		AdjustY		:= MovingY;
		IF Timer.Set(TRUE, PulseTime) THEN
			Timer.Reset();
			Increment.AnyInt(State);
		END_IF

	2:	// Second outputs are set, reset first outputs
		Enable		:= MovingNegative;
		AdjustX1	:= MovingX1 AND MovingPositive;
		AdjustX2	:= MovingX2 AND MovingPositive;
		AdjustY		:= MovingY	AND MovingPositive;
		IF Timer.Set(TRUE, PulseTime) THEN
			Timer.Reset();
			Increment.AnyInt(State);
		END_IF

	3:	// Reset all outputs
		Enable		:= FALSE;
		AdjustX1	:= FALSE;
		AdjustX2	:= FALSE;
		AdjustY		:= FALSE;
		IF Timer.Set(TRUE, PulseTime) THEN
			Timer.Reset();
			State			:= 0;
			AdjustOneStep	:= TRUE;
		END_IF
END_CASE
END_METHOD

METHOD PROTECTED Alarms
VAR_INST
END_VAR
END_METHOD

// Validates cassette configuration for the upper drawer, ensuring all values are within allowed limits.
// Checks for invalid cassette counts, valve indices, and cassette IDs, and ensures no duplicate valve combinations exist.
// Sets `CheckConfig` to FALSE if any configuration error is detected.
METHOD PRIVATE CheckConfig : BOOL
VAR
	i : USINT;
END_VAR
%FOLDER Private
CheckConfig		:= TRUE;

// Check if any non-existing cassette is configured
CheckConfig		R= DrawerPlate[enumDrawer.Upper].NumberOfCassettes > GVL_Constants_Magazine.MaxCassettes;

// Check if any non-existing adjustment valve is configured for X1, X2 or Y
CheckConfig		R= DrawerPlate[enumDrawer.Upper].CassetteDefinition[1].AdjustmentValve[enumMotorsType.X1]	> GVL_Constants_Magazine.MaxAdjustValves;
CheckConfig		R= DrawerPlate[enumDrawer.Upper].CassetteDefinition[1].AdjustmentValve[enumMotorsType.X2]	> GVL_Constants_Magazine.MaxAdjustValves;
CheckConfig		R= DrawerPlate[enumDrawer.Upper].CassetteDefinition[1].AdjustmentValve[enumMotorsType.Y]	> GVL_Constants_Magazine.MaxAdjustValves;

// Check if any non-existing enable valve is configured
CheckConfig		R= DrawerPlate[enumDrawer.Upper].CassetteDefinition[1].EnableValve > GVL_Constants_Magazine.MaxEnableValves;

FOR i := 1 TO DrawerPlate[enumDrawer.Upper].NumberOfCassettes DO
	// Check if cassetteId is between 0 and the configured number of cassettes on this plate
	CheckConfig	R= DrawerPlate[enumDrawer.Upper].CassetteDefinition[i].CassetteId < 1;
	CheckConfig	R= DrawerPlate[enumDrawer.Upper].CassetteDefinition[i].CassetteId > DrawerPlate[enumDrawer.Upper].NumberOfCassettes;
END_FOR

// Check if combination of enable valves and adjustment valves is not used more than once
CheckConfig		R= CombinationUsedMoreThanOnce();
END_METHOD

// Executes the cassette homing sequence by progressing through defined states.
// Starts homing, checks for needed adjustments, and updates positions when homed.
// Adds position changes at each step to guide the cassette to its reference position
METHOD PRIVATE CheckHomingState
VAR_INPUT
	Cassette : REFERENCE TO CassetteFB;
END_VAR
%FOLDER Private
IF Cassette.HomingState = enumCassetteHomingState.StopHoming THEN
	Cassette.TargetPositionX1	:= Cassette.ActualPositionX1;
	Cassette.TargetPositionX2	:= Cassette.ActualPositionX2;
	Cassette.TargetPositionY	:= Cassette.ActualPositionY;

	Cassette.NextHomingState();

// Check if the homing process is starting
ELSIF Cassette.HomingState = enumCassetteHomingState.StartHoming THEN
	// Reset the actual and target positions to zero
	Cassette.ActualPositionX1	:=	0;
	Cassette.ActualPositionX2	:=	0;
	Cassette.ActualPositionY	:=	0;
	Cassette.TargetPositionX1	:=	0;
	Cassette.TargetPositionX2	:=	0;
	Cassette.TargetPositionY	:=	0;
	// Move to the first step of the homing sequence
	Cassette.NextHomingState();
	// Add the position change required for the first homing step to the target positions
	Cassette.AddToTargetPositions(GetPositionChangeForHomingStep(Cassette.HomingState));

// If the homing process is already in progress (at or beyond step 1)
ELSIF Cassette.HomingState >= enumCassetteHomingState.HomingStep1 THEN
	// Check if the current homing step is finished
	IF NOT Cassette.AdjustmentNeeded THEN
		// Move to the next step in the homing sequence
		Cassette.NextHomingState();

		// If the homing process is complete
		IF Cassette.HomingState = enumCassetteHomingState.Homed THEN
			// Set the actual positions to the reference positions
			Cassette.ActualPositionX1	:=	ReferencePos.X1;
			Cassette.ActualPositionX2	:=	ReferencePos.X2;
			Cassette.ActualPositionY	:=	ReferencePos.Y;
			Cassette.TargetPositionX1	:=	ReferencePos.X1;
			Cassette.TargetPositionX2	:=	ReferencePos.X2;
			Cassette.TargetPositionY	:=	ReferencePos.Y;

		// If homing is not yet complete, continue with the next step
		ELSE
			// Add the position change for the current homing step to the target positions
			Cassette.AddToTargetPositions(GetPositionChangeForHomingStep(Cassette.HomingState));
		END_IF
	END_IF
END_IF
END_METHOD

// Checks for duplicate cassette configurations in the upper drawer.
// A duplicate is defined as two cassettes sharing the same enable valve and at least one identical adjustment valve.
// If such a combination is found, the method sets a flag and exits early.
METHOD PRIVATE CombinationUsedMoreThanOnce : BOOL
VAR
	i, j					: USINT;
	CassetteI, CassetteJ	: REFERENCE TO CassetteDefinition;
END_VAR
%FOLDER Private
CombinationUsedMoreThanOnce := FALSE;

FOR i := 1 TO DrawerPlate[enumDrawer.Upper].NumberOfCassettes DO
	CassetteI REF= DrawerPlate[enumDrawer.Upper].CassetteDefinition[i];
	FOR j := i + 1 TO DrawerPlate[enumDrawer.Upper].NumberOfCassettes DO
		CassetteJ REF= DrawerPlate[enumDrawer.Upper].CassetteDefinition[j];
		IF CassetteI.EnableValve = CassetteJ.EnableValve THEN
			IF CassetteI.AdjustmentValve[enumMotorsType.X1]	= CassetteJ.AdjustmentValve[enumMotorsType.X1]
			OR CassetteI.AdjustmentValve[enumMotorsType.X2]	= CassetteJ.AdjustmentValve[enumMotorsType.X2]
			OR CassetteI.AdjustmentValve[enumMotorsType.Y]	= CassetteJ.AdjustmentValve[enumMotorsType.Y]
			THEN
				CombinationUsedMoreThanOnce := TRUE;
				RETURN;
			END_IF
		END_IF
	END_FOR
	IF CombinationUsedMoreThanOnce THEN
		RETURN;
	END_IF
END_FOR
END_METHOD

// Use this method to define how the physical drawer and cassette system is built in the real world.
// For each cassette, configure its ID, cavity, label type/orientation, and valve connections (adjustment and enable).
// Ensure the configuration matches the actual hardware layout to enable correct movement.
METHOD PRIVATE Config
VAR
	DrawerId : enumDrawer;
	i		 : USINT;
	j		 : DINT;
	k		 : enumMovementType;
END_VAR
%FOLDER Config
FOR DrawerId := enumDrawer.Upper TO enumDrawer.Lower DO
	DrawerPlate[DrawerId].NumberOfCassettes											:= 12;
	DrawerPlate[DrawerId].InvertDirectionsForXRaxis									:= FALSE;

	DrawerPlate[DrawerId].CassetteDefinition[1].CassetteId							:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[1].CavityId							:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[1].LabelId								:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[1].LabelType							:= enumLabelType.Wrap;
	DrawerPlate[DrawerId].CassetteDefinition[1].LabelOrientation					:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[1].CassetteOrientation					:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[1].AdjustmentValve[enumMotorsType.X1]		:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[1].AdjustmentValve[enumMotorsType.X2]		:= 3;
	DrawerPlate[DrawerId].CassetteDefinition[1].AdjustmentValve[enumMotorsType.Y]		:= 2;
	DrawerPlate[DrawerId].CassetteDefinition[1].EnableValve							:= 1;

	DrawerPlate[DrawerId].CassetteDefinition[2].CassetteId							:= 2;
	DrawerPlate[DrawerId].CassetteDefinition[2].CavityId							:= 2;
	DrawerPlate[DrawerId].CassetteDefinition[2].LabelId								:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[2].LabelType							:= enumLabelType.Wrap;
	DrawerPlate[DrawerId].CassetteDefinition[2].LabelOrientation					:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[2].CassetteOrientation					:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[2].AdjustmentValve[enumMotorsType.X1]		:= 4;
	DrawerPlate[DrawerId].CassetteDefinition[2].AdjustmentValve[enumMotorsType.X2]		:= 6;
	DrawerPlate[DrawerId].CassetteDefinition[2].AdjustmentValve[enumMotorsType.Y]		:= 5;
	DrawerPlate[DrawerId].CassetteDefinition[2].EnableValve							:= 1;

	DrawerPlate[DrawerId].CassetteDefinition[3].CassetteId							:= 3;
	DrawerPlate[DrawerId].CassetteDefinition[3].CavityId							:= 3;
	DrawerPlate[DrawerId].CassetteDefinition[3].LabelId								:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[3].LabelType							:= enumLabelType.Wrap;
	DrawerPlate[DrawerId].CassetteDefinition[3].LabelOrientation					:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[3].CassetteOrientation					:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[3].AdjustmentValve[enumMotorsType.X1]		:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[3].AdjustmentValve[enumMotorsType.X2]		:= 3;
	DrawerPlate[DrawerId].CassetteDefinition[3].AdjustmentValve[enumMotorsType.Y]		:= 2;
	DrawerPlate[DrawerId].CassetteDefinition[3].EnableValve							:= 2;

	DrawerPlate[DrawerId].CassetteDefinition[4].CassetteId							:= 4;
	DrawerPlate[DrawerId].CassetteDefinition[4].CavityId							:= 4;
	DrawerPlate[DrawerId].CassetteDefinition[4].LabelId								:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[4].LabelType							:= enumLabelType.Wrap;
	DrawerPlate[DrawerId].CassetteDefinition[4].LabelOrientation					:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[4].CassetteOrientation					:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[4].AdjustmentValve[enumMotorsType.X1]		:= 4;
	DrawerPlate[DrawerId].CassetteDefinition[4].AdjustmentValve[enumMotorsType.X2]		:= 6;
	DrawerPlate[DrawerId].CassetteDefinition[4].AdjustmentValve[enumMotorsType.Y]		:= 5;
	DrawerPlate[DrawerId].CassetteDefinition[4].EnableValve							:= 2;

	DrawerPlate[DrawerId].CassetteDefinition[5].CassetteId							:= 5;
	DrawerPlate[DrawerId].CassetteDefinition[5].CavityId							:= 5;
	DrawerPlate[DrawerId].CassetteDefinition[5].LabelId								:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[5].LabelType							:= enumLabelType.Wrap;
	DrawerPlate[DrawerId].CassetteDefinition[5].LabelOrientation					:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[5].CassetteOrientation					:= enumOrientationType.Upright;
	DrawerPlate[DrawerId].CassetteDefinition[5].AdjustmentValve[enumMotorsType.X1]		:= 1;
	DrawerPlate[DrawerId].CassetteDefinition[5].AdjustmentValve[enumMotorsType.X2]		:= 3;
	DrawerPlate[DrawerId].CassetteDefinition[5].AdjustmentValve[enumMotorsType.Y]		:= 2;
	DrawerPlate[DrawerId].CassetteDefinition[5].EnableValve							:= 3;

