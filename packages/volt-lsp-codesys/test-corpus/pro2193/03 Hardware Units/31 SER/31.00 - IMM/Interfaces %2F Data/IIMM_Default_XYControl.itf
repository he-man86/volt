INTERFACE IIMM_Default_XYControl
EXTENDS IIMM_Default

// Start the Ejector/Core pullers program.
METHOD PUBLIC EjectShot : BOOL	// Returns true when the ejectors are in the Front position.
VAR_INPUT
END_VAR
%FOLDER Commands
END_METHOD

// Get product data of all products per mould level
METHOD PUBLIC GetProductData : ARRAY[1..GVL_Constants.MaxProductsInX, 1..GVL_Constants.MaxProductsInY] OF ProductType
VAR_INPUT
	MouldLevel	: UINT(1..GVL_Constants.MaxMouldLevels);
END_VAR
%FOLDER Commands
END_METHOD

// Inhibit (disable) closing of the mould. The Y axis is going in.
METHOD PUBLIC InhibitMouldClosing
%FOLDER Commands
END_METHOD

// Monitor when the Y axis has cleared the mould area. Enable mould closing by IMM.
METHOD PUBLIC ReleaseMouldClosing : BOOL	// Returns true when the Y axis has cleared the mould.
VAR_INPUT
	mouldClosingIsRequired		: BOOL;		// Indicates that another shot is needed to finish production
END_VAR
VAR_OUTPUT
	xMouldClosed				: BOOL;		// True if the mould close command was given to the IMM.
END_VAR
%FOLDER Commands
END_METHOD

// This method returns true as soon as every XYControl called it.
METHOD PUBLIC SynchronizeYUnits : BOOL
VAR_INPUT
	instanceNo : UINT;	// Instance number of the XY module that is synchronizing.
END_VAR
%FOLDER Commands
END_METHOD

// Returns true when the Xi axis is allowed to place labels in the mould cavities
{attribute 'monitoring':='call'}
PROPERTY PUBLIC AllowLabelsInCavities : BOOL
%FOLDER Properties
GET
END_GET
END_PROPERTY

// Returns true when the mould is completely opened
{attribute 'monitoring':='variable'}
PROPERTY PUBLIC RequestFullMouldOpen : BOOL
%FOLDER Properties
GET
END_GET
END_PROPERTY

// Returns true when the Y unit has permission to move into the mould area
{attribute 'monitoring':='variable'}
PROPERTY PUBLIC RequestMouldEntry : BOOL
%FOLDER Properties
GET
END_GET
END_PROPERTY

END_INTERFACE
