// Commands specific for a chain
INTERFACE IChain_Base_TransferOuttake_Commands

METHOD PUBLIC ClearProductCarrier
VAR_INPUT
	position	: UINT(1..Chain_BaseFB.MaxLinks);
END_VAR
END_METHOD

METHOD PUBLIC InExactPosition : BOOL
END_METHOD

METHOD PUBLIC InPosition : BOOL
VAR_INPUT
	hysteresis		: REAL;	// Max allowed difference
END_VAR
END_METHOD

// Increment an int that determens where the Z Unit takes products the next cycle
METHOD PUBLIC IncrementActiveOrderSelect : USINT
END_METHOD

{warning disable C0222} // Disables Precompiler error C0222: Outputs can't be of type REFERENCE TO
METHOD PUBLIC ReturnProduct : REFERENCE TO ProductType
VAR_INPUT
	position	: UINT(1..Chain_BaseFB.MaxLinks);
END_VAR
END_METHOD

// Position where the Z Unit gets products from Chain. 1 is Top positon (17-22). 4 is Bottom position (20-25).
{attribute 'monitoring':='call'}
PROPERTY PUBLIC SelectedZUnitPosition : USINT(1..ZUnits.NumberOfTakeoverPositions)
END_PROPERTY

// TRUE: Z Unit is after Reject unit. FALSE: Reject unit is after Z Unit.
{attribute 'monitoring':='call'}
PROPERTY PUBLIC ZUnitIsAfterReject : BOOL
END_PROPERTY

END_INTERFACE
