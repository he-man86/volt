INTERFACE IConveyor_Shared_Commands
EXTENDS IModuleWithCommandLock

// The Z Unit has just finished stacking and the conveyor is allowed to move the stacks.
{attribute 'monitoring':='call'}
PROPERTY MovingStacksAllowed : BOOL
END_PROPERTY

// The actual stacking height of stack on the conveyor.
{attribute 'monitoring':='call'}
PROPERTY StackIndex : UINT
END_PROPERTY

END_INTERFACE
