<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The single user-facing Volt app: a Windows system-tray supervisor that owns
         every vendor bridge. Bridges run as headless worker PROCESSES it spawns
         (external-attach vendors) or as in-IDE loads it launches (CODESYS). One app,
         one tray icon, many invisible workers. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>VoltConnector</AssemblyName>
    <!-- Deliberately NO reference to any vendor bridge or Volt.Bridge.Core: the
         connector only speaks the HTTP wire (/health) to its workers, so it survives
         however different the vendor internals get (TwinCAT COM vs Siemens Openness
         vs Allen-Bradley LDSDK). -->
  </PropertyGroup>
  <!-- No update/installer framework dependency: the one installer is Inno Setup (installer/Volt.iss), and the
       connector hosts a dependency-free updater (Updater.cs polls GitHub + re-runs the Setup) + the env hooks
       (VoltEnv.cs). System.Net.Http + System.Text.Json are part of net8 — nothing to reference. -->
</Project>
