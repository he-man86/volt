<?xml version='1.0' encoding='utf-8'?>
<Package>
	<Strings>
		<String Id="GeneralName">
			<Neutral>VoltBridge</Neutral>
			<Localized Culture="de">VoltBridge</Localized>
		</String>
		<String Id="GeneralCopyright">
			<Neutral>Copyright (c) 2017 CODESYS Development GmbH This product includes free software developed by others. Click on "More &amp;gt;&amp;gt;" for details.</Neutral>
			<Localized Culture="de">Copyright (c) 2017 CODESYS Development GmbH Dieses Produkt beinhaltet freie Software, die von anderen entwickelt wurde. Klicken Sie auf "Mehr &amp;gt;&amp;gt;" fuer weitere Informationen.</Localized>
		</String>
		<String Id="GeneralDescription">
			<Neutral>The VoltBridge is an Add-on for the CODESYS Development System to synchronize projects on the CODESYS Automation Server and to configure CODESYS Edge Gateways.</Neutral>
			<Localized Culture="de">Der VoltBridge ist ein Add-on für das CODESYS Development System zur Synchronisierung von Projekten auf dem CODESYS Automation Server sowie zur Konfiguration von CODESYS Edge Gateways.</Localized>
		</String>
		<String Id="GeneralLicenseAgreement">
			<Neutral>Html/CODESYS_EULA_Engineering_en.htm</Neutral>
			<Localized Culture="de">Html/CODESYS_EULA_Engineering_de.htm</Localized>
		</String>
		<String Id="ProjectMenuInsertionPath">
			<Neutral>Project::Automation Server</Neutral>
			<Localized Culture="de">Projekt::Automation Server</Localized>
		</String>
		<String Id="EdgeGatewayInsertionPath">
			<Neutral>Tools::Edge Gateway</Neutral>
			<Localized Culture="de">Tools::Edge-Gateway</Localized>
		</String>
		<String Id="ToolsAutomationServerInsertionPath">
			<Neutral>Tools::Automation Server</Neutral>
			<Localized Culture="de">Tools::Automation Server</Localized>
		</String>
		<String Id="OnlineAutomationServerInsertionPath">
			<Neutral>Online</Neutral>
			<Localized Culture="de">Online</Localized>
		</String>
	</Strings>
	<General>
		<Id>e43abc6c-41da-42e9-af56-f632f69f6ca5</Id>
		<Version>1.0.0.0</Version>
		<Name>$GeneralName</Name>
		<Vendor>Volt</Vendor>
		<Copyright>$GeneralCopyright</Copyright>
		<HTML>Html/Index.html</HTML>
		
		<Description>$GeneralDescription</Description>
		<RequiredInstallerVersion>3.4.1.0</RequiredInstallerVersion>
	</General>
	<TargetDirectoryDefinitions />
	  <Components>
    <Component>
      <General>
        <Id>1</Id>
        <Name>$GeneralName</Name>
        <Selectable>True</Selectable>
        <SelectedByDefault>True</SelectedByDefault>
      </General>
      <Items>
        <Folder>
          <TargetFolder>%AP_ROOT%\VoltBridge</TargetFolder>
          <Path>PlugIns</Path>
        </Folder>
        <Folder>
          <TargetFolder>%AP_ROOT%</TargetFolder>
          <Path>ScriptLib</Path>
        </Folder>
      </Items>
      <ProfileSelectionList ActiveProfileOnly="False" Hide="False" />
    </Component>
  </Components>

</Package>