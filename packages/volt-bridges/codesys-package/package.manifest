<?xml version="1.0" encoding="utf-8"?>
<Package>
  <Strings>
    <String Id="GeneralName">
      <Neutral>VoltBridge</Neutral>
    </String>
    <String Id="GeneralDescription">
      <Neutral>Volt IDE Bridge for CODESYS — connects the volt CLI to your CODESYS project via loopback HTTP. Enables git-style pull/push/status against the CODESYS Scripting Engine.</Neutral>
    </String>
    <String Id="GeneralCopyright">
      <Neutral>Copyright (c) 2025 Volt</Neutral>
    </String>
  </Strings>
  <General>
    <Id>{E43ABC6C-41DA-42E9-AF56-F632F69F6CA5}</Id>
    <Version>1.0.0.0</Version>
    <Name>$GeneralName</Name>
    <Vendor>Volt</Vendor>
    <Copyright>$GeneralCopyright</Copyright>
    <Description>$GeneralDescription</Description>
    <RequiredInstallerVersion>3.5.0.0</RequiredInstallerVersion>
  </General>
  <Components>
    <Component>
      <General>
        <Id>1</Id>
        <Name>VoltBridge</Name>
        <Selectable>True</Selectable>
        <SelectedByDefault>True</SelectedByDefault>
      </General>
      <Items>
        <!-- Bridge executables and dependencies -->
        <Folder>
          <TargetFolder>%AP_ROOT%\VoltBridge</TargetFolder>
          <Path>PlugIns</Path>
        </Folder>
        <!-- Scripting Engine stub for type discovery -->
        <Folder>
          <TargetFolder>%AP_ROOT%</TargetFolder>
          <Path>ScriptLib</Path>
        </Folder>
        <!-- Notify user bridge is available -->
        <ExternalCall>
          <Installation>
            <FileName>%AP_ROOT%\VoltBridge\install.bat</FileName>
          </Installation>
          <Annotation>Register VoltBridge</Annotation>
        </ExternalCall>
      </Items>
      <ProfileSelectionList ActiveProfileOnly="False" Hide="False" />
    </Component>
  </Components>
</Package>
