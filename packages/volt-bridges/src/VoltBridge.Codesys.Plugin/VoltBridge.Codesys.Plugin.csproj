<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>VoltBridge.Codesys.Plugin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>VoltBridge.Codesys.Plugin</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VoltBridge.Core\VoltBridge.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- CODESYS Core.dll — ships with every CODESYS installation -->
    <Reference Include="Core">
      <HintPath>$(CODESYS_ROOT)\Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
