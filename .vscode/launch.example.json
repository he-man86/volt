{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "volt-lsp-iec (stdio)",
      "program": "${workspaceFolder}/packages/volt-lsp-iec/dist/src/bin.js",
      "args": ["--stdio"],
      "console": "integratedTerminal"
    },
    {
      "type": "extensionHost",
      "request": "launch",
      "name": "volt-vscode (extension host)",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/volt-vscode"]
    }
  ]
}
